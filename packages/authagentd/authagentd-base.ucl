.include(try=false) "${SRCDIR}/authagentd.ucl"

scripts {
  pre-deinstall = "/usr/libexec/switchboard-pkg-reclaim prepare pkg:authagentd/authagentd-base system.Auth/authagentd"
  post-deinstall = "/usr/libexec/switchboard-pkg-reclaim retire pkg:authagentd/authagentd-base system.Auth/authagentd"
  pre-install = "/usr/libexec/switchboard-pkg-reclaim begin-install pkg:authagentd/authagentd-base system.Auth/authagentd"
  post-install = "/usr/libexec/switchboard-pkg-reclaim install pkg:authagentd/authagentd-base system.Auth/authagentd"
}
