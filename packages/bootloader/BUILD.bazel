load("//tools/build/bazel:bsd_pkg_family.bzl", "bsd_pkg_family")

bsd_pkg_family(
    name = "family",
    family = "bootloader",
    template = "bootloader.ucl",
    sets = ["minimal"],
    subpackages = select({"@platforms//cpu:x86_64": ["dbg"], "//conditions:default": []}) + select({"//tools/build/bazel/config:boot_split_manpages_enabled": ["man"], "//tools/build/bazel/config:package_unsplit_manuals_enabled": ["dev"], "//conditions:default": []}),
    visibility = ["//packages:__pkg__"],
)
