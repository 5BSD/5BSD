.include(try=false) "${SRCDIR}/common.ucl"

scripts {
  post-install = <<EOD
#!/bin/sh
rootdir="${PKG_ROOTDIR}"
[ -n "$rootdir" ] || rootdir=/

# Remove retired policy trees.  Leaving a removed system bundle installed is
# boot-fatal because switchboard intentionally fails closed on invalid system
# policy.  rebootd and kldmgrd moved into Capsule before these bundles vanished.
/bin/rm -rf "$rootdir/System/Applications" \
    "$rootdir/Capabilities/System/Reboot.cap" \
    "$rootdir/Capabilities/System/Kldmgr.cap"
EOD
}

/* Non-secret launch identity inputs are generated before account relocation.
 * The constructor binds both input files and the exact compiler payload. */
annotations: {
    "5bsd.construction" = <<EOD
{"format":1,"actions":[{"name":"service-identities","argv":["/usr/libexec/switchboard-identity-build","/etc/master.passwd","/etc/group","/Capabilities/Config/switchboard/identities.ucl"],"inputs":["/etc/master.passwd","/etc/group"],"outputs":{"/Capabilities/Config/switchboard/identities.ucl":{"type":"file","uid":0,"gid":0,"mode":292,"flags_set":0,"replace":false}}}]}
EOD
}
