load("//tools/build/bazel:bsd_pkg_family.bzl", "bsd_pkg_family")

bsd_pkg_family(
    name = "family",
    family = "libsysctlcmp",
    template = "//release/packages:ucl/libsysctlcmp-all.ucl",
    subpackages = ["dbg", "dev", "man"],
    sets = ["minimal", "minimal-jail"],
    licenses = ["BSD2CLAUSE"],
    license_logic = "multi",
    dependencies = {"libsysctlcmp": ["libservice", "libfidl", "clibs"], "libsysctlcmp-dev": ["libservice-dev", "libfidl-dev", "clibs-dev"]},
    visibility = ["//packages:__pkg__"],
)
