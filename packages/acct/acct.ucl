.include(try=false) "${SRCDIR}/common.ucl"

# Requirements of utx only; these do not assign writers or qualify other tools.
# Paths correspond to libc gen/utxdb.h and pututxline's boot/shutdown/rm paths.
annotations {
    "5bsd.state-requirements" = <<EOD
{
  "format": 1,
  "requirements": [
    {
      "name": "active-sessions",
      "program": "/usr/sbin/utx",
      "path": "/var/run/utx.active",
      "type": "file",
      "lifetime": "boot",
      "purpose": "Boot initializes and shutdown clears active session records; removal updates records"
    },
    {
      "name": "last-login",
      "program": "/usr/sbin/utx",
      "path": "/var/log/utx.lastlogin",
      "type": "file",
      "lifetime": "persistent",
      "purpose": "Boot checks existing last-login format and may truncate an invalid file"
    },
    {
      "name": "session-history",
      "program": "/usr/sbin/utx",
      "path": "/var/log/utx.log",
      "type": "file",
      "lifetime": "persistent",
      "purpose": "Append boot, shutdown and session-removal history"
    }
  ]
}
EOD
}
