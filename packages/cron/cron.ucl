# SPDX-License-Identifier: ISC
.include(try=false) "${SRCDIR}/common.ucl"

# Sources: cron/cron.c open_pidfile, cron/pathnames.h, cron/database.c,
# crontab/crontab.c replace_cmd/delete_cmd/poke_daemon under usr.sbin/cron.
# Requirements do not authorize a writer or classify job tables as ordinary.
# Configured command dependencies, PAM sessions and mail output remain unaudited.
annotations {
    "5bsd.state-requirements" = <<EOD
{
  "format": 1,
  "requirements": [
    {
      "name": "daemon-pid",
      "program": "/usr/sbin/cron",
      "path": "/var/run/cron.pid",
      "type": "file",
      "lifetime": "boot",
      "purpose": "Create, lock and write daemon PID state; remove it if daemonization fails"
    },
    {
      "name": "job-tables-reader",
      "program": "/usr/sbin/cron",
      "path": "/var/cron/tabs",
      "type": "directory",
      "lifetime": "persistent",
      "purpose": "Scan and read per-user scheduled command tables; contents select execution users and commands and require explicit security policy"
    },
    {
      "name": "job-tables-management",
      "program": "/usr/bin/crontab",
      "path": "/var/cron/tabs",
      "type": "directory",
      "lifetime": "persistent",
      "purpose": "Create temporary job tables, atomically replace or delete user tables, and update spool directory timestamps; authorization remains independent of this declaration"
    }
  ]
}
EOD
}
