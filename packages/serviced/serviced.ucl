comment = "5BSD capability-aware service manager daemon"

desc = <<EOD
serviced is the 5BSD capability-aware service manager daemon.  It scans
/Capabilities/System and /Capabilities for .cap bundles, manages service
lifecycles, enforces Capsicum capability delegation via mac_capability(4), and
supports hot-reload.

This package provides the serviced(8) daemon for managing capability-based
services on 5BSD systems.
EOD

scripts {
  post-install = <<EOD
#!/bin/sh
rootdir="${PKG_ROOTDIR}"
[ -n "$rootdir" ] || rootdir=/

# Remove retired policy trees.  Leaving a removed system bundle installed is
# boot-fatal because serviced intentionally fails closed on invalid system
# policy.  rebootd and kldmgrd moved into Authority before these bundles vanished.
/bin/rm -rf "$rootdir/System/Applications" \
    "$rootdir/Capabilities/System/Reboot.cap" \
    "$rootdir/Capabilities/System/Kldmgr.cap"
EOD
}
