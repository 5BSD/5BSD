# SPDX-License-Identifier: ISC
.include(try=false) "${SRCDIR}/common.ucl"

# Source-defined defaults in mountd/pathnames.h, nfsd/nfsd.c,
# rpc.lockd/lockd.c and rpc.statd/statd.c. No runtime authority is assigned.
# Exported data, /etc/exports, debug controls, TLS credentials and deployment
# overrides require separate policy review. Stable state affects protocol
# recovery and must not be assumed safe merely because it resides under /var.
annotations {
    "5bsd.state-requirements" = <<EOD
{
  "format": 1,
  "requirements": [
    {
      "name": "mountd-pid",
      "program": "/usr/sbin/mountd",
      "path": "/var/run/mountd.pid",
      "type": "file",
      "lifetime": "boot",
      "purpose": "Create and lock the daemon PID file; remove it on shutdown"
    },
    {
      "name": "mountd-clients",
      "program": "/usr/sbin/mountd",
      "path": "/var/db/mountdtab",
      "type": "file",
      "lifetime": "persistent",
      "purpose": "Read, append and rewrite the recorded client mount list"
    },
    {
      "name": "nfsd-pid",
      "program": "/usr/sbin/nfsd",
      "path": "/var/run/nfsd.pid",
      "type": "file",
      "lifetime": "boot",
      "purpose": "Create and lock the default PID file; the -P override requires deployment reconciliation"
    },
    {
      "name": "nfsd-stable",
      "program": "/usr/sbin/nfsd",
      "path": "/var/db/nfs-stablerestart",
      "type": "file",
      "lifetime": "persistent",
      "purpose": "Read and update NFSv4 stable restart state used for client recovery"
    },
    {
      "name": "nfsd-stable-backup",
      "program": "/usr/sbin/nfsd",
      "path": "/var/db/nfs-stablerestart.bak",
      "type": "file",
      "lifetime": "persistent",
      "purpose": "Maintain the backup of NFSv4 stable restart state"
    },
    {
      "name": "lockd-local-socket",
      "program": "/usr/sbin/rpc.lockd",
      "path": "/var/run/rpclockd.sock",
      "type": "socket",
      "lifetime": "boot",
      "purpose": "Recreate the local RPC socket when kernel lockd delegates client replies"
    },
    {
      "name": "statd-status",
      "program": "/usr/sbin/rpc.statd",
      "path": "/var/db/statd.status",
      "type": "file",
      "lifetime": "persistent",
      "purpose": "Maintain the memory-mapped status monitor database for restart notification"
    }
  ]
}
EOD
}
