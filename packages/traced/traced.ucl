.include(try=false) "${SRCDIR}/../../release/packages/ucl/traced-all.ucl"

scripts {
  pre-deinstall = "/usr/libexec/switchboard-pkg-reclaim prepare pkg:traced/traced system.Trace/traced"
  post-deinstall = "/usr/libexec/switchboard-pkg-reclaim retire pkg:traced/traced system.Trace/traced"
  pre-install = "/usr/libexec/switchboard-pkg-reclaim begin-install pkg:traced/traced system.Trace/traced"
  post-install = "/usr/libexec/switchboard-pkg-reclaim install pkg:traced/traced system.Trace/traced"
}
