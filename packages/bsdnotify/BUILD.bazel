load("//tools/build/bazel:bsd_pkg_family.bzl", "bsd_pkg_family")

load("//tools/build/bazel:bsd_pkg_dependency.bzl", "bsd_pkg_dependency")
bsd_pkg_dependency(name = "bsdnotify_dependency", package = "bsdnotify", origin = "base/5BSD-bsdnotify",
    version = "//tools/build/bazel/config:package_version", visibility = ["//visibility:public"])

bsd_pkg_family(
    name = "family",
    family = "bsdnotify",
    template = "//release/packages:ucl/bsdnotify-all.ucl",
    template_overrides = {"bsdnotify": "bsdnotify.ucl"},
    sets = ["minimal"],
    dependencies = {"bsdnotify": ["bsdaudit", "libauditcmp", "libchannel", "libfidl", "libnotify", "libservice", "libucl", "switchboard", "switchboardctl"]},
    visibility = ["//packages:__pkg__"],
)
