load("//tools/build/bazel:bsd_pkg_family.bzl", "bsd_pkg_family")

load("//tools/build/bazel:bsd_pkg_dependency.bzl", "bsd_pkg_dependency")
bsd_pkg_dependency(name = "libcapability-tests_dependency", package = "libcapability-tests", origin = "base/5BSD-libcapability-tests",
    version = "//tools/build/bazel/config:package_version", visibility = ["//visibility:public"])

bsd_pkg_family(
    name = "family",
    family = "libcapability-tests",
    template = "libcapability-tests.ucl",
    subpackages = ["dbg"],
    sets = ["tests"],
    dependencies = {"libcapability-tests": ["atf", "kyua", "set-base", "libcapability", "libcapability-dev", "clang"]},
    visibility = ["//packages:__pkg__"],
)
