# SPDX-License-Identifier: BSD-2-Clause
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
load("//tools/build/bazel:bsd_pkg_layout.bzl", "bsd_pkg_layout")
load("//tools/build/bazel:bsd_pkg_manifest.bzl", "bsd_pkg_manifests")
load("//tools/build/bazel:bsd_pkg_create.bzl", "bsd_pkg_create")
_MANIFESTS = ["//usr.sbin/capsule/tests:install_manifest"]
alias(name = "install_archive", actual = "//usr.sbin/capsule/tests:install_archive")
bsd_pkg_layout(
    name = "package_layout", manifests = _MANIFESTS,
    packages = ["capsule-tests", "capsule-tests-dbg"], suffix_tags = ["dbg"],
    dependencies = {"capsule-tests": ["atf", "kyua", "set-base", "capsule", "capsulectl", "clang"], "capsule-tests-dbg": ["capsule-tests"]},
    external_dependencies = ["//packages/atf:atf_dependency", "//packages/kyua:kyua_dependency", "//release/packages:set-base_dependency", "//packages/capsule:capsule_dependency", "//packages/capsulectl:capsulectl_dependency", "//packages/clang:clang_dependency"],
)
bsd_pkg_manifests(
    name = "package_manifests",
    layout = ":package_layout",
    version = "//tools/build/bazel/config:package_version",
    template = "capsule-tests.ucl",
    prefix = "5BSD",
    maintainer = "re@5bsd.org",
    www = "https://github.com/5BSD/5BSD",
    license_logic = "single",
    licenses = ["BSD2CLAUSE"],
    annotations = {"set": "tests"},
    generator = "//release/packages:generate-ucl.lua",
    flua = "@bsd_sdk//toolchain:extra_flua",
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_flua_runtime"],
)

bsd_pkg_create(
    name = "packages",
    manifests = ":package_manifests",
    archive = ":install_archive",
    abi_file = "//usr.sbin/capsule/tests:req_validate_test",
    osversion_header = "//sys/sys:param.h",
    format = "tzst",
    threads = "//tools/build/bazel/config:package_threads",
    epoch = 0,
    pkg = "@bsd_sdk//toolchain:extra_pkg",
    tar = "@bsd_sdk//toolchain:extra_tar",
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_pkg_runtime", "@bsd_sdk//toolchain:extra_tar_runtime"],
)

# SPDX-License-Identifier: BSD-2-Clause

load("//tools/build/bazel:bsd_pkg_dependency.bzl", "bsd_pkg_dependency")
bsd_pkg_dependency(name = "capsule-tests_dependency", package = "capsule-tests", origin = "base/5BSD-capsule-tests",
    version = "//tools/build/bazel/config:package_version", visibility = ["//visibility:public"])
