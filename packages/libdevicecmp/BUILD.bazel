load("//tools/build/bazel:bsd_pkg_family.bzl", "bsd_pkg_family")

bsd_pkg_family(
    name = "family",
    family = "libdevicecmp",
    template = "//release/packages:ucl/libdevicecmp-all.ucl",
    subpackages = ["dbg", "dev"],
    sets = ["minimal", "minimal-jail"],
    licenses = ["BSD2CLAUSE"],
    license_logic = "multi",
    dependencies = {"libdevicecmp": ["libservice", "libfidl", "clibs"], "libdevicecmp-dev": ["libservice-dev", "libfidl-dev", "clibs-dev"]},
    visibility = ["//packages:__pkg__"],
