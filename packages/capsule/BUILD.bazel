# SPDX-License-Identifier: BSD-2-Clause
load("//tools/build/bazel:bsd_pkg_layout.bzl", "bsd_pkg_layout")
load("//tools/build/bazel:bsd_pkg_manifest.bzl", "bsd_pkg_manifests")
load("//tools/build/bazel:bsd_pkg_create.bzl", "bsd_pkg_create")
_MANIFESTS = ["//usr.sbin/capsule:install_capsule", "//usr.sbin/capsule:install_extra"]
alias(name = "install_archive", actual = "//usr.sbin/capsule:runtime_install_archive")
bsd_pkg_layout(
    name = "package_layout", manifests = _MANIFESTS,
    packages = ["capsule", "capsule-dbg"] + select({"//tools/build/bazel/config:split_manpages_enabled": ["capsule-man"], "//conditions:default": []}),
    suffix_tags = ["dbg"],
    dependencies = select({"//tools/build/bazel/config:split_manpages_enabled": {'capsule': ['libcapsulert', 'libcapability', 'switchboard'], 'capsule-dbg': ['capsule'], 'capsule-man': ['capsule']}, "//conditions:default": {'capsule': ['libcapsulert', 'libcapability', 'switchboard'], 'capsule-dbg': ['capsule']}}),
    external_dependencies = ['//packages/libcapsulert:libcapsulert_dependency', '//packages/libcapability:libcapability_dependency', '//packages/switchboard:switchboard_dependency'],
)
bsd_pkg_manifests(
    name = "package_manifests",
    layout = ":package_layout",
    version = "//tools/build/bazel/config:package_version",
    templates = select({"//tools/build/bazel/config:split_manpages_enabled": {"capsule": "capsule.ucl", "capsule-dbg": "common.ucl", "capsule-man": "common.ucl"}, "//conditions:default": {"capsule": "capsule.ucl", "capsule-dbg": "common.ucl"}}),
    template_inputs = ["common.ucl"],
    prefix = "5BSD",
    maintainer = "re@5bsd.org",
    www = "https://github.com/5BSD/5BSD",
    license_logic = "single",
    licenses = ["BSD2CLAUSE"],
    annotations = {"set": "minimal"},
    generator = "//release/packages:generate-ucl.lua",
    flua = "@bsd_sdk//toolchain:extra_flua",
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_flua_runtime"],
)

bsd_pkg_create(
    name = "packages",
    manifests = ":package_manifests",
    archive = ":install_archive",
    abi_file = "//usr.sbin/capsule:capsule",
    osversion_header = "//sys/sys:param.h",
    format = "tzst",
    threads = "//tools/build/bazel/config:package_threads",
    epoch = 0,
    pkg = "@bsd_sdk//toolchain:extra_pkg",
    tar = "@bsd_sdk//toolchain:extra_tar",
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_pkg_runtime", "@bsd_sdk//toolchain:extra_tar_runtime"],
)


load("//tools/build/bazel:bsd_pkg_dependency.bzl", "bsd_pkg_dependency")
bsd_pkg_dependency(name = "capsule_dependency", package = "capsule", origin = "base/5BSD-capsule",
    version = "//tools/build/bazel/config:package_version", visibility = ["//visibility:public"])
