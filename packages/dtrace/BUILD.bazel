load("//tools/build/bazel:bsd_pkg_family.bzl", "bsd_pkg_family")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = ["//cddl/lib/libdtrace:install_manifest", "//cddl/lib/drti:install_manifest", "//cddl/usr.sbin/dtrace:install_manifest", "//cddl/usr.sbin/lockstat:install_manifest", "//cddl/usr.sbin/plockstat:install_manifest", "//share/dtrace:install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)


load("//tools/build/bazel:bsd_pkg_layout.bzl", "bsd_pkg_layout")
load("//tools/build/bazel:bsd_pkg_manifest.bzl", "bsd_pkg_manifests")
load("//tools/build/bazel:bsd_pkg_create.bzl", "bsd_pkg_create")
# Source-owned package membership and development/debug dependencies.
bsd_pkg_layout(
    name = "package_layout",
    manifests = ["//cddl/lib/libdtrace:install_manifest", "//cddl/lib/drti:install_manifest", "//cddl/usr.sbin/dtrace:install_manifest", "//cddl/usr.sbin/lockstat:install_manifest", "//cddl/usr.sbin/plockstat:install_manifest", "//share/dtrace:install_manifest"],
    packages = ["dtrace", "dtrace-dbg", "dtrace-dev"] + select({
        "//tools/build/bazel/config:split_manpages_enabled": ["dtrace-man"],
        "//conditions:default": [],
    }),
    suffix_tags = ["dbg", "dev"],
    dependencies = select({
        "//tools/build/bazel/config:split_manpages_enabled": {
            "dtrace-dbg": ["dtrace"], "dtrace-dev": ["dtrace"], "dtrace-man": ["dtrace"],
        },
        "//conditions:default": {"dtrace-dbg": ["dtrace"], "dtrace-dev": ["dtrace"]},
    }),
)

bsd_pkg_manifests(
    name = "package_manifests",
    layout = ":package_layout",
    version = "//tools/build/bazel/config:package_version",
    templates = select({
        "//tools/build/bazel/config:split_manpages_enabled": {
            "dtrace": "dtrace.ucl", "dtrace-dbg": "dtrace.ucl", "dtrace-dev": "dtrace.ucl",
            "dtrace-man": "dtrace.ucl",
        },
        "//conditions:default": {
            "dtrace": "dtrace.ucl", "dtrace-dbg": "dtrace.ucl", "dtrace-dev": "dtrace.ucl",
        },
    }),
    prefix = "5BSD",
    maintainer = "re@5bsd.org",
    www = "https://github.com/5BSD/5BSD",
    license_logic = "single",
    licenses = ["CDDL-1.0"],
    annotations = {"set": "optional"},
    generator = "//release/packages:generate-ucl.lua",
    flua = "@bsd_sdk//toolchain:extra_flua",
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_flua_runtime"],
)

bsd_pkg_create(
    name = "packages",
    manifests = ":package_manifests",
    archive = ":install_archive",
    abi_file = "//cddl/lib/libdtrace:package_abi",
    osversion_header = "//sys/sys:param.h",
    format = "tzst",
    threads = "//tools/build/bazel/config:package_threads",
    epoch = 0,
    pkg = "@bsd_sdk//toolchain:extra_pkg",
    tar = "@bsd_sdk//toolchain:extra_tar",
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_pkg_runtime", "@bsd_sdk//toolchain:extra_tar_runtime"],
)

load("//tools/build/bazel:bsd_pkg_dependency.bzl", "bsd_pkg_dependency")
bsd_pkg_dependency(name = "dtrace_dependency", package = "dtrace", origin = "base/5BSD-dtrace",
    version = "//tools/build/bazel/config:package_version", visibility = ["//visibility:public"])

bsd_pkg_family(
    name = "family",
    family = "dtrace",
    template = "dtrace.ucl",
    subpackages = ["dbg", "dev", "man"],
    sets = ["optional"],
    licenses = ["CDDL-1.0", "BSD2CLAUSE", "BSD3CLAUSE", "MIT", "APACHE20"],
    license_logic = "multi",
    dependencies = {"dtrace": ["libnghttp2"]},
    visibility = ["//packages:__pkg__"],
)
