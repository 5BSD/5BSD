load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
load("//tools/build/bazel:bsd_pkg_layout.bzl", "bsd_pkg_layout")
load("//tools/build/bazel:bsd_pkg_manifest.bzl", "bsd_pkg_manifests")
load("//tools/build/bazel:bsd_pkg_create.bzl", "bsd_pkg_create")

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_manifest")

# Original component installation repeats these identical debug directories.
# Compose once for both archive and pkgbase ownership, rejecting any conflict.
bsd_install_manifest(
    name = "install_manifest",
    manifests = ["//lib/libbz2:install_manifest", "//usr.bin/bzip2:install_manifest", "//usr.bin/bzip2recover:install_manifest"],
    merge_identical_directories = True,
    visibility = ["//visibility:public"],
)

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

# Package membership and dependencies are source-owned. The shared library
# package has no automatic base dependency, matching the maintained generator.
bsd_pkg_layout(
    name = "package_layout",
    manifests = [":install_manifest"],
    packages = ["bzip2", "bzip2-dbg", "bzip2-dev", "bzip2-lib"] + select({
        "//tools/build/bazel/config:split_manpages_enabled": ["bzip2-man"],
        "//conditions:default": [],
    }),
    suffix_tags = ["dbg", "dev", "lib"],
    dependencies = select({
        "//tools/build/bazel/config:split_manpages_enabled": {
            "bzip2-dbg": ["bzip2"], "bzip2-dev": ["bzip2"], "bzip2-man": ["bzip2"],
        },
        "//conditions:default": {"bzip2-dbg": ["bzip2"], "bzip2-dev": ["bzip2"]},
    }),
)

bsd_pkg_manifests(
    name = "package_manifests",
    layout = ":package_layout",
    version = "//tools/build/bazel/config:package_version",
    templates = select({
        "//tools/build/bazel/config:split_manpages_enabled": {
            "bzip2": "bzip2.ucl", "bzip2-dbg": "bzip2.ucl", "bzip2-dev": "bzip2.ucl",
            "bzip2-lib": "bzip2.ucl", "bzip2-man": "bzip2.ucl",
        },
        "//conditions:default": {
            "bzip2": "bzip2.ucl", "bzip2-dbg": "bzip2.ucl", "bzip2-dev": "bzip2.ucl", "bzip2-lib": "bzip2.ucl",
        },
    }),
    prefix = "5BSD",
    maintainer = "re@5bsd.org",
    www = "https://github.com/5BSD/5BSD",
    license_logic = "single",
    licenses = ["BSD2CLAUSE"],
    annotations = {"set": "minimal,minimal-jail"},
    generator = "//release/packages:generate-ucl.lua",
    flua = "@bsd_sdk//toolchain:extra_flua",
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_flua_runtime"],
)

bsd_pkg_create(
    name = "packages",
    manifests = ":package_manifests",
    archive = ":install_archive",
    abi_file = "//usr.bin/bzip2:bzip2_install",
    osversion_header = "//sys/sys:param.h",
    format = "tzst",
    threads = "//tools/build/bazel/config:package_threads",
    epoch = 0,
    pkg = "@bsd_sdk//toolchain:extra_pkg",
    tar = "@bsd_sdk//toolchain:extra_tar",
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_pkg_runtime", "@bsd_sdk//toolchain:extra_tar_runtime"],
)

# These tests inspect the actual produced packages using execution tools on all
# target ABIs. Only the native test below executes target programs.
load("//tools/build/bazel:bsd_python_test.bzl", "bsd_host_artifact_test", "bsd_python_test")
filegroup(name = "package_index", srcs = [":packages"], output_group = "package_index")
filegroup(name = "layout_metadata", srcs = [":package_layout"], output_group = "metadata")
bsd_host_artifact_test(
    name = "package_contract_test",
    src = "package-contract-test.py",
    data = [":packages", ":package_index", ":layout_metadata", ":install_archive", "@bsd_sdk//toolchain:extra_pkg", "@bsd_sdk//toolchain:extra_tar"],
    args = ["--index", "$(location :package_index)", "--layout", "$(location :layout_metadata)",
            "--archive", "$(location :install_archive)", "--pkg", "$(location @bsd_sdk//toolchain:extra_pkg)",
            "--tar", "$(location @bsd_sdk//toolchain:extra_tar)"],
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_pkg_runtime", "@bsd_sdk//toolchain:extra_tar_runtime"],
    size = "small",
)
bsd_python_test(
    name = "recovery_test",
    src = "recovery-test.py",
    data = ["//usr.bin/bzip2:bzip2", "//usr.bin/bzip2recover:bzip2recover", "//lib/libbz2:bz2_shared"],
    args = ["--program", "$(location //usr.bin/bzip2:bzip2)", "--recover", "$(location //usr.bin/bzip2recover:bzip2recover)",
            "--library", "$(location //lib/libbz2:bz2_shared)"],
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_python_runtime"],
    target_compatible_with = ["@platforms//cpu:x86_64"],
    size = "small",
)
