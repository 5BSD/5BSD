.include(try=false) "${SRCDIR}/../../release/packages/ucl/bsdaudit-all.ucl"

scripts {
  pre-deinstall = "/usr/libexec/switchboard-pkg-reclaim prepare pkg:bsdaudit/bsdaudit system.Audit/bsdaudit"
  post-deinstall = "/usr/libexec/switchboard-pkg-reclaim retire pkg:bsdaudit/bsdaudit system.Audit/bsdaudit"
  pre-install = "/usr/libexec/switchboard-pkg-reclaim begin-install pkg:bsdaudit/bsdaudit system.Audit/bsdaudit"
  post-install = "/usr/libexec/switchboard-pkg-reclaim install pkg:bsdaudit/bsdaudit system.Audit/bsdaudit"
}
