load("//tools/build/bazel:bsd_pkg_family.bzl", "bsd_pkg_family")

load("//tools/build/bazel:bsd_pkg_dependency.bzl", "bsd_pkg_dependency")
bsd_pkg_dependency(name = "capsulectl_dependency", package = "capsulectl", origin = "base/5BSD-capsulectl",
    version = "//tools/build/bazel/config:package_version", visibility = ["//visibility:public"])

