load("//tools/build/bazel:bsd_pkg_family.bzl", "bsd_pkg_family")

load("//tools/build/bazel:bsd_pkg_dependency.bzl", "bsd_pkg_dependency")
bsd_pkg_dependency(name = "libcapbundle_dependency", package = "libcapbundle", origin = "base/5BSD-libcapbundle",
    version = "//tools/build/bazel/config:package_version", visibility = ["//visibility:public"])

bsd_pkg_family(
    name = "family",
    family = "libcapbundle",
    template = "libcapbundle.ucl",
    subpackages = ["dbg", "dev", "man"],
    sets = ["minimal", "minimal-jail"],
    dependencies = {"libcapbundle": ["libcapsulert", "libucl", "libcapimage"]},
    visibility = ["//packages:__pkg__"],
)
