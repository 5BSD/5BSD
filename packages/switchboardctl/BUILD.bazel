load("//tools/build/bazel:bsd_pkg_family.bzl", "bsd_pkg_family")

load("//tools/build/bazel:bsd_pkg_dependency.bzl", "bsd_pkg_dependency")
bsd_pkg_dependency(name = "switchboardctl_dependency", package = "switchboardctl", origin = "base/5BSD-switchboardctl",
    version = "//tools/build/bazel/config:package_version", visibility = ["//visibility:public"])

bsd_pkg_family(
    name = "family",
    family = "switchboardctl",
    template = "switchboardctl.ucl",
    sets = ["minimal"],
    dependencies = {"switchboardctl": ["libcapbundle"]},
    visibility = ["//packages:__pkg__"],
)
