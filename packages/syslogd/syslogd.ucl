.include(try=false) "${SRCDIR}/common.ucl"

# Default endpoint/PID requirements from syslogd/pathnames.h, sys/syslog.h and
# syslogd.c. These declarations grant no authority. -p, -S and -P overrides,
# additional -l sockets and configuration-selected log outputs require separate
# reconciliation; this is not a complete declaration of every deployment.
annotations {
    "5bsd.state-requirements" = <<EOD
{
  "format": 1,
  "requirements": [
    {
      "name": "startup-socket-list",
      "program": "/etc/rc.d/syslogd",
      "path": "/var/run/syslogd.sockets",
      "type": "file",
      "lifetime": "boot",
      "purpose": "Startup script creates the configured chroot socket list before launching the daemon"
    },
    {
      "name": "daemon-pid",
      "program": "/usr/sbin/syslogd",
      "path": "/var/run/syslog.pid",
      "type": "file",
      "lifetime": "boot",
      "purpose": "Create, lock and write the default daemon PID file; remove on shutdown"
    },
    {
      "name": "local-log-socket",
      "program": "/usr/sbin/syslogd",
      "path": "/var/run/log",
      "type": "socket",
      "lifetime": "boot",
      "purpose": "Bind the default local logging socket and recreate it on startup"
    },
    {
      "name": "privileged-log-socket",
      "program": "/usr/sbin/syslogd",
      "path": "/var/run/logpriv",
      "type": "socket",
      "lifetime": "boot",
      "purpose": "Bind the default restricted local logging socket and recreate it on startup"
    }
  ]
}
EOD
}
