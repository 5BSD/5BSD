# SPDX-License-Identifier: BSD-2-Clause
load("//tools/build/bazel:bsd_pkg_family.bzl", "bsd_pkg_family")

load("//tools/build/bazel:bsd_pkg_dependency.bzl", "bsd_pkg_dependency")
bsd_pkg_dependency(name = "clang_dependency", package = "clang", origin = "base/5BSD-clang",
    version = "//tools/build/bazel/config:package_version", visibility = ["//visibility:public"])

bsd_pkg_family(
    name = "family",
    family = "clang",
    template = "clang.ucl",
    subpackages = ["dbg", "dev", "man"],
    sets = ["devel"],
    licenses = ["Apache-2.0 WITH LLVM-exception"],
    dependencies = {"clang": ["lld", "libcompiler_rt-dev"]},
    visibility = ["//packages:__pkg__"],
)
