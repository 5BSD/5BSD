# SPDX-License-Identifier: BSD-2-Clause
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
load("//tools/build/bazel:bsd_pkg_layout.bzl", "bsd_pkg_layout")
load("//tools/build/bazel:bsd_pkg_manifest.bzl", "bsd_pkg_manifests")
load("//tools/build/bazel:bsd_pkg_create.bzl", "bsd_pkg_create")
_MANIFESTS = ["//usr.sbin/switchboard/tests:install_manifest"]
alias(name = "install_archive", actual = "//usr.sbin/switchboard/tests:install_archive")
bsd_pkg_layout(
    name = "package_layout", manifests = _MANIFESTS,
    packages = ["switchboard-tests", "switchboard-tests-dbg"], suffix_tags = ["dbg"],
    dependencies = {'switchboard-tests': ['atf', 'kyua', 'set-base', 'switchboard', 'switchboardctl', 'capsule', 'capsulectl', 'capsule-tests', 'libcapability-tests', 'libcapbundle-tests', 'libcapsulert-tests', 'libservice-tests', 'mac-capability-tests', 'libservice-dev', 'libcapsulert-dev', 'clang', 'dtrace', 'bsdlog', 'bsdnetwork', 'bsdnotify', 'bsdtrace-provider'], 'switchboard-tests-dbg': ['switchboard-tests']},
    external_dependencies = ['//packages/atf:atf_dependency', '//packages/kyua:kyua_dependency', '//release/packages:set-base_dependency', '//packages/switchboard:switchboard_dependency', '//packages/switchboardctl:switchboardctl_dependency', '//packages/capsule:capsule_dependency', '//packages/capsulectl:capsulectl_dependency', '//packages/capsule-tests:capsule-tests_dependency', '//packages/libcapability-tests:libcapability-tests_dependency', '//packages/libcapbundle-tests:libcapbundle-tests_dependency', '//packages/libcapsulert-tests:libcapsulert-tests_dependency', '//packages/libservice-tests:libservice-tests_dependency', '//packages/mac-capability-tests:mac-capability-tests_dependency', '//packages/libservice:libservice-dev_dependency', '//packages/libcapsulert:libcapsulert-dev_dependency', '//packages/clang:clang_dependency', '//packages/dtrace:dtrace_dependency', '//packages/bsdlog:bsdlog_dependency', '//packages/bsdnetwork:bsdnetwork_dependency', '//packages/bsdnotify:bsdnotify_dependency', '//packages/bsdtrace-provider:bsdtrace-provider_dependency'],
)
bsd_pkg_manifests(
    name = "package_manifests",
    layout = ":package_layout",
    version = "//tools/build/bazel/config:package_version",
    template = "switchboard-tests.ucl",
    prefix = "5BSD",
    maintainer = "re@5bsd.org",
    www = "https://github.com/5BSD/5BSD",
    license_logic = "single",
    licenses = ["BSD2CLAUSE"],
    annotations = {"set": "tests"},
    generator = "//release/packages:generate-ucl.lua",
    flua = "@bsd_sdk//toolchain:extra_flua",
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_flua_runtime"],
)

bsd_pkg_create(
    name = "packages",
    manifests = ":package_manifests",
    archive = ":install_archive",
    abi_file = "//usr.sbin/switchboard/tests:scope_registry_test",
    osversion_header = "//sys/sys:param.h",
    format = "tzst",
    threads = "//tools/build/bazel/config:package_threads",
    epoch = 0,
    pkg = "@bsd_sdk//toolchain:extra_pkg",
    tar = "@bsd_sdk//toolchain:extra_tar",
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_pkg_runtime", "@bsd_sdk//toolchain:extra_tar_runtime"],
)
