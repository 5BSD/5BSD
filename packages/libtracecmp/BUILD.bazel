load("//tools/build/bazel:bsd_pkg_family.bzl", "bsd_pkg_family")

bsd_pkg_family(
    name = "family",
    family = "libtracecmp",
    template = "//release/packages:ucl/libtracecmp-all.ucl",
    subpackages = ["dbg", "dev", "man"],
    sets = ["minimal", "minimal-jail"],
    licenses = ["BSD2CLAUSE"],
    license_logic = "multi",
    dependencies = {"libtracecmp": ["libservice", "dtrace", "libfidl", "clibs"], "libtracecmp-dev": ["libservice-dev", "libfidl-dev", "clibs-dev"]},
    visibility = ["//packages:__pkg__"],
)
