    family = "libservice-tests",
    template = "libservice-tests.ucl",
    subpackages = ["dbg"],
    sets = ["tests"],
    dependencies = {"libservice-tests": ["atf", "kyua", "set-base", "libservice", "libservice-dev", "capsule", "capsulectl", "clang"]},
    visibility = ["//packages:__pkg__"],
