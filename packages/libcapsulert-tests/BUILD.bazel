# SPDX-License-Identifier: BSD-2-Clause
load("//tools/build/bazel:bsd_pkg_family.bzl", "bsd_pkg_family")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
load("//tools/build/bazel:bsd_pkg_layout.bzl", "bsd_pkg_layout")
load("//tools/build/bazel:bsd_pkg_manifest.bzl", "bsd_pkg_manifests")
load("//tools/build/bazel:bsd_pkg_create.bzl", "bsd_pkg_create")
_MANIFESTS = ["//lib/libcapsulert/tests:install_claim_parse_test", "//lib/libcapsulert/tests:install_storage_namespace_test", "//lib/libcapsulert/tests:install_extra"]
bsd_install_archive(
    name = "install_archive",
    manifests = _MANIFESTS,
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libcapsulert-tests","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/tests", "/usr/lib/debug/usr/tests/lib", "/usr/lib/debug/usr/tests/lib/libcapsulert"]} | {
        "/usr/tests/lib/libcapsulert": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libcapsulert-tests"]}',
    },
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.tests.dist": "/usr/tests", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
bsd_pkg_layout(
    name = "package_layout", manifests = _MANIFESTS,
    packages = ["libcapsulert-tests", "libcapsulert-tests-dbg"], suffix_tags = ["dbg"],
    dependencies = {"libcapsulert-tests": ["atf", "kyua", "set-base", "libcapsulert"], "libcapsulert-tests-dbg": ["libcapsulert-tests"]},
    external_dependencies = ["//packages/atf:atf_dependency", "//packages/kyua:kyua_dependency", "//release/packages:set-base_dependency", "//packages/libcapsulert:libcapsulert_dependency"],
)
bsd_pkg_manifests(
    name = "package_manifests",
    layout = ":package_layout",
    version = "//tools/build/bazel/config:package_version",
    template = "libcapsulert-tests.ucl",
    prefix = "5BSD",
    maintainer = "re@5bsd.org",
    www = "https://github.com/5BSD/5BSD",
    license_logic = "single",
    licenses = ["BSD2CLAUSE"],
    annotations = {"set": "tests"},
    generator = "//release/packages:generate-ucl.lua",
    flua = "@bsd_sdk//toolchain:extra_flua",
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_flua_runtime"],
)

bsd_pkg_create(
    name = "packages",
    manifests = ":package_manifests",
    archive = ":install_archive",
    abi_file = "//lib/libcapsulert/tests:claim_parse_test",
    osversion_header = "//sys/sys:param.h",
    format = "tzst",
    threads = "//tools/build/bazel/config:package_threads",
    epoch = 0,
    pkg = "@bsd_sdk//toolchain:extra_pkg",
    tar = "@bsd_sdk//toolchain:extra_tar",
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_pkg_runtime", "@bsd_sdk//toolchain:extra_tar_runtime"],
)

load("//tools/build/bazel:bsd_pkg_dependency.bzl", "bsd_pkg_dependency")
bsd_pkg_dependency(name = "libcapsulert-tests_dependency", package = "libcapsulert-tests", origin = "base/5BSD-libcapsulert-tests",
    version = "//tools/build/bazel/config:package_version", visibility = ["//visibility:public"])

bsd_pkg_family(
    name = "family",
    family = "libcapsulert-tests",
    template = "libcapsulert-tests.ucl",
    subpackages = ["dbg"],
    sets = ["tests"],
    dependencies = {"libcapsulert-tests": ["atf", "kyua", "set-base", "libcapsulert"]},
    visibility = ["//packages:__pkg__"],
)
