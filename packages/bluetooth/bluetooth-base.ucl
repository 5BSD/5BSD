.include(try=false) "${SRCDIR}/bluetooth.ucl"

scripts {
  pre-deinstall = "/usr/libexec/switchboard-pkg-reclaim prepare pkg:bluetooth/bluetooth-base org.5bsd.Blued/blued"
  post-deinstall = "/usr/libexec/switchboard-pkg-reclaim retire pkg:bluetooth/bluetooth-base org.5bsd.Blued/blued"
  pre-install = "/usr/libexec/switchboard-pkg-reclaim begin-install pkg:bluetooth/bluetooth-base org.5bsd.Blued/blued"
  post-install = "/usr/libexec/switchboard-pkg-reclaim install pkg:bluetooth/bluetooth-base org.5bsd.Blued/blued"
}
