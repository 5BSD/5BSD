# SPDX-License-Identifier: ISC
.include(try=false) "${SRCDIR}/common.ucl"

# Default daemon PID and terminal accounting; not all configured SSH/PAM state.
annotations {
    "5bsd.state-requirements" = <<EOD
{
  "format": 1,
  "requirements": [
    {
      "name": "daemon-pid",
      "program": "/usr/sbin/sshd",
      "path": "/var/run/sshd.pid",
      "type": "file",
      "lifetime": "boot",
      "purpose": "Write the default listener PID file and remove it on exit or restart; configured PidFile overrides require deployment reconciliation"
    },
    {
      "name": "session-active",
      "program": "/usr/libexec/sshd-session",
      "path": "/var/run/utx.active",
      "type": "file",
      "lifetime": "boot",
      "purpose": "The session monitor records terminal login and logout in the active session database"
    },
    {
      "name": "session-last-login",
      "program": "/usr/libexec/sshd-session",
      "path": "/var/log/utx.lastlogin",
      "type": "file",
      "lifetime": "persistent",
      "purpose": "Read previous login information and record terminal login through the utmpx backend"
    },
    {
      "name": "session-history",
      "program": "/usr/libexec/sshd-session",
      "path": "/var/log/utx.log",
      "type": "file",
      "lifetime": "persistent",
      "purpose": "Append terminal login and logout history through the utmpx backend"
    }
  ]
}
EOD
}
