load("//tools/build/bazel:bsd_pkg_family.bzl", "bsd_pkg_family")
bsd_pkg_family(
    name = "family", family = "toolchain", template = "toolchain.ucl",
    subpackages = ["dbg", "dev", "man"],
    sets = ['devel'],
    dependencies = select({"//tools/build/bazel/config:llvm_binutils_enabled": {"toolchain": ["clang"]}, "//conditions:default": {}}),
    visibility = ["//packages:__pkg__"],
)
