.include(try=false) "${SRCDIR}/../../release/packages/ucl/bsdlog-all.ucl"

scripts {
  pre-deinstall = "/usr/libexec/switchboard-pkg-reclaim prepare pkg:bsdlog/bsdlog system.Log/bsdlog"
  post-deinstall = "/usr/libexec/switchboard-pkg-reclaim retire pkg:bsdlog/bsdlog system.Log/bsdlog"
  pre-install = "/usr/libexec/switchboard-pkg-reclaim begin-install pkg:bsdlog/bsdlog system.Log/bsdlog"
  post-install = "/usr/libexec/switchboard-pkg-reclaim install pkg:bsdlog/bsdlog system.Log/bsdlog"
}
