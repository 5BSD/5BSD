def root_header_installation():
    public_header_installation(name = "root_headers_install", directory = "",
        files = {header: header for header in _HEADERS} | {
            "//contrib/libc-vis:vis.h": "vis.h",
            "//sys/dev/dttransport:dttransport.h": "dttransport.h",
        })
    for name, directory, source in [
        ("iconv", "", "iconv.h"),
        ("hesiod", "", "hesiod.h"),
        ("legacy_gss", "", "gssapi.h"),
        ("legacy_gss_nested", "gssapi", "gssapi/gssapi.h"),
    ]:
        condition = "legacy_gss" if name == "legacy_gss_nested" else name
        public_header_installation(name = name + "_headers_install", directory = directory,
            files = {source: source.split("/")[-1]},
            enabled = "//tools/build/bazel/config:includes_" + condition + "_enabled")
    bsd_install_archive_set(name = "root_header_installation_archives",
        archives = [":" + name + "_headers_install_archive" for name in [
            "root", "iconv", "hesiod", "legacy_gss", "legacy_gss_nested",
        ]], visibility = ["//visibility:public"])
