load("//tools/build/bazel:bsd_relocatable_link.bzl", "bsd_relocatable_link")
load("//tools/build/bazel:bsd_crunchide.bzl", "bsd_crunchide")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_binary", "cc_import")
load("//tools/build/bazel:bsd_crunchgen.bzl", "bsd_crunchgen")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_objects")
load(":catalog.bzl", "ALIASES", "OBJECT_NAMES", "PROGRAMS")
# Bounded default selection: reject changed catalog-affecting settings rather
# than silently generating a stale program/object table. Full option composition
# and application variants belong to the later complete rescue aggregate.
bsd_crunchgen(name = "default_dispatch", executable_name = "rescue", programs = PROGRAMS, emit_stubs = True,
    aliases = ALIASES, object_names = OBJECT_NAMES, required_configuration = {'//tools/build/bazel/config:crypt': 'true', '//tools/build/bazel/config:inet6': 'true', '//tools/build/bazel/config:inet_support': 'true', '//tools/build/bazel/config:inet6_support': 'true', '//tools/build/bazel/config:pf': 'true', '//tools/build/bazel/config:zfs': 'true', '//tools/build/bazel/config:openssl': 'true', '//tools/build/bazel/config:tcsh': 'true', '//tools/build/bazel/config:vi': 'true', '//tools/build/bazel/config:iscsi': 'true', '//tools/build/bazel/config:dtrace': 'true', '//tools/build/bazel/config:nis': 'false', '//tools/build/bazel/config:hesiod': 'false'},
    visibility = ["//visibility:public"])
filegroup(name = "dispatch_metadata", srcs = [":default_dispatch"], output_group = "metadata", visibility = ["//visibility:public"])
filegroup(name = "entry_stubs", srcs = [":default_dispatch"], output_group = "stubs", visibility = ["//visibility:public"])
cc_library(name = "dispatcher_objects", srcs = [":default_dispatch"],
    features = ["-bsd_ssp", "-bsd_debug_info"],
    copts = ['-pipe', '-fno-common', '-std=gnu17', '-Wno-format-zero-length', '-Wsystem-headers', '-Werror', '-Wall', '-Wno-format-y2k', '-W', '-Wno-unused-parameter', '-Wstrict-prototypes', '-Wmissing-prototypes', '-Wpointer-arith', '-Wreturn-type', '-Wcast-qual', '-Wwrite-strings', '-Wswitch', '-Wshadow', '-Wunused-parameter', '-Wcast-align', '-Wchar-subscripts', '-Wnested-externs', '-Wold-style-definition', '-Wno-pointer-sign', '-Wdate-time', '-Wmissing-variable-declarations', '-Wthread-safety', '-Wno-empty-body', '-Wno-string-plus-int', '-Wno-unused-const-variable', '-Wno-error=unused-but-set-parameter', '-Wno-error=cast-function-type-mismatch', '-Qunused-arguments'],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
bsd_component_objects(name = "dispatcher_compiler_outputs", group = ":dispatcher_objects", pic = False,
    visibility = ["//visibility:public"])
# No full rescue executable/install/package is declared before application objects,
# crunchide transforms and the complete static library/link contract exist.

# Supported combined-object stage, bounded to twenty-seven real applications.
_CORE_PROGRAMS = [p for p in PROGRAMS if p in ['cat', 'chflags', 'chmod', 'cp', 'echo', 'ed', 'expr', 'getfacl', 'hostname', 'ln', 'mkdir', 'mv', 'pwd', 'realpath', 'rm', 'rmdir', 'sleep', 'test', 'head', 'date', 'chio', 'kenv', 'setfacl', 'stty', 'kill', 'sync', 'dd']]
_CORE_OBJECTS = {p: "//" + ("usr.bin/head" if p == "head" else "bin/" + p) + ":rescue_compiler_outputs" for p in _CORE_PROGRAMS}
bsd_crunchgen(name = "core_dispatch", executable_name = "rescue_core", programs = _CORE_PROGRAMS,
    object_names = {p: OBJECT_NAMES[p] for p in _CORE_PROGRAMS},
    aliases = {p: ALIASES[p] for p in _CORE_PROGRAMS if p in ALIASES}, emit_stubs = True,
    required_configuration = {"//tools/build/bazel/config:dtrace": "true"})
filegroup(name = "core_metadata", srcs = [":core_dispatch"], output_group = "metadata")
[filegroup(name = p + "_entry_source", srcs = [":core_dispatch"], output_group = "stub_" + p) for p in _CORE_PROGRAMS]
# Original generated-Make stub recipe uses the parent no-SSP/no-debug policy.
# Its repeated equivalent -O2 flags use the ordinary toolchain optimization mode.
[cc_library(name = p + "_entry_objects", srcs = [":" + p + "_entry_source"],
    features = ["-bsd_ssp", "-bsd_debug_info"], copts = ['-pipe', '-fno-common', '-std=gnu17', '-Wno-format-zero-length', '-Wsystem-headers', '-Werror', '-Wall', '-Wno-format-y2k', '-W', '-Wno-unused-parameter', '-Wstrict-prototypes', '-Wmissing-prototypes', '-Wpointer-arith', '-Wreturn-type', '-Wcast-qual', '-Wwrite-strings', '-Wswitch', '-Wshadow', '-Wunused-parameter', '-Wcast-align', '-Wchar-subscripts', '-Wnested-externs', '-Wold-style-definition', '-Wno-pointer-sign', '-Wdate-time', '-Wmissing-variable-declarations', '-Wthread-safety', '-Wno-empty-body', '-Wno-string-plus-int', '-Wno-unused-const-variable', '-Wno-error=unused-but-set-parameter', '-Wno-error=cast-function-type-mismatch', '-Qunused-arguments', '-Wl,--allow-multiple-definition', '-Wl,-znow', '-Wl,-zrelro', '-static', '-pipe', '-fno-common'],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]) for p in _CORE_PROGRAMS]
[bsd_component_objects(name = p + "_entry_compiler_output", group = ":" + p + "_entry_objects", pic = False) for p in _CORE_PROGRAMS]
# These object-only links have no library lookup. Original driver --sysroot/-L
# search roots are unused; actual emitted linker behavior is checked against Make.
[bsd_relocatable_link(name = p + "_unhidden", objects = [":" + p + "_entry_compiler_output", _CORE_OBJECTS[p]],
    output = p + ".lo", linker = "@bsd_sdk//toolchain:bin/ld.lld",
    runtime = ["@bsd_sdk//toolchain:link_inputs"],
    linkopts = ["--eh-frame-hdr", "-Bstatic", "--allow-multiple-definition", "-znow", "-zrelro"]) for p in _CORE_PROGRAMS]
[bsd_crunchide(name = p + "_crunched", input_object = ":" + p + "_unhidden", program_name = p,
    keep_symbols = ["_crunched_" + p + "_stub"]) for p in _CORE_PROGRAMS]
[filegroup(name = p + "_crunched_original", srcs = [":" + p + "_crunched"], output_group = "original_name") for p in _CORE_PROGRAMS]
filegroup(name = "crunchide_execution_tool", srcs = [":cat_crunched"], output_group = "execution_tool")

# Bounded real twenty-seven-program executable, with native static libc and startup.
# This does not replace the complete original rescue selection/install target.
cc_library(name = "core_dispatcher_objects", srcs = [":core_dispatch"],
    features = ["-bsd_ssp", "-bsd_debug_info"],
    copts = ['-pipe', '-fno-common', '-std=gnu17', '-Wno-format-zero-length', '-Wsystem-headers', '-Werror', '-Wall', '-Wno-format-y2k', '-W', '-Wno-unused-parameter', '-Wstrict-prototypes', '-Wmissing-prototypes', '-Wpointer-arith', '-Wreturn-type', '-Wcast-qual', '-Wwrite-strings', '-Wswitch', '-Wshadow', '-Wunused-parameter', '-Wcast-align', '-Wchar-subscripts', '-Wnested-externs', '-Wold-style-definition', '-Wno-pointer-sign', '-Wdate-time', '-Wmissing-variable-declarations', '-Wthread-safety', '-Wno-empty-body', '-Wno-string-plus-int', '-Wno-unused-const-variable', '-Wno-error=unused-but-set-parameter', '-Wno-error=cast-function-type-mismatch', '-Qunused-arguments'],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
bsd_component_objects(name = "core_dispatcher_compiler_output", group = ":core_dispatcher_objects", pic = False)
# Preserve ordinary Make -lutil lazy archive extraction before libc.
cc_import(name = "core_util_static_link", static_library = "//lib/libutil:static_archive",
    deps = ["//lib/libc:static_link_objects"])
cc_binary(name = "rescue_core", srcs = [":core_dispatcher_compiler_output"] + [":" + p + "_crunched" for p in _CORE_PROGRAMS],
    deps = [":core_util_static_link"],
    features = ["fully_static_link"], linkstatic = True,
    linkopts = ["-nodefaultlibs", "-Wl,--allow-multiple-definition", "-Wl,-znow", "-Wl,-zrelro",
        "@$(location //lib/csu/amd64:startup_link_flags)"],
    additional_linker_inputs = ["//lib/csu/amd64:startup", "//lib/csu/amd64:startup_link_flags"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
load("//tools/build/bazel:bsd_python_test.bzl", "bsd_python_test")
bsd_python_test(name = "core_runtime_test", src = "core-runtime-test.py", data = [":rescue_core"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
