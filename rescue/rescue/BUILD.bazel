[filegroup(name = p + "_entry_source", srcs = [":core_dispatch"], output_group = "stub_" + crunchgen_identifier(p)) for p in _CORE_PROGRAMS]
# Original generated-Make stub recipe uses the parent no-SSP/no-debug policy.
# Its repeated equivalent -O2 flags use the ordinary toolchain optimization mode.
[cc_library(name = p + "_entry_objects", srcs = [":" + p + "_entry_source"],
    features = ["-bsd_ssp", "-bsd_debug_info"], copts = ['-pipe', '-fno-common', '-std=gnu17', '-Wno-format-zero-length', '-Wsystem-headers', '-Werror', '-Wall', '-Wno-format-y2k', '-W', '-Wno-unused-parameter', '-Wstrict-prototypes', '-Wmissing-prototypes', '-Wpointer-arith', '-Wreturn-type', '-Wcast-qual', '-Wwrite-strings', '-Wswitch', '-Wshadow', '-Wunused-parameter', '-Wcast-align', '-Wchar-subscripts', '-Wnested-externs', '-Wold-style-definition', '-Wno-pointer-sign', '-Wdate-time', '-Wmissing-variable-declarations', '-Wthread-safety', '-Wno-empty-body', '-Wno-string-plus-int', '-Wno-unused-const-variable', '-Wno-error=unused-but-set-parameter', '-Wno-error=cast-function-type-mismatch', '-Qunused-arguments', '-Wl,--allow-multiple-definition', '-Wl,-znow', '-Wl,-zrelro', '-static', '-pipe', '-fno-common'],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]) for p in _CORE_PROGRAMS]
[bsd_component_objects(name = p + "_entry_compiler_output", group = ":" + p + "_entry_objects", pic = False) for p in _CORE_PROGRAMS]
# These object-only links have no library lookup. Original driver --sysroot/-L
# search roots are unused; actual emitted linker behavior is checked against Make.
[bsd_relocatable_link(name = p + "_unhidden", objects = [":" + p + "_entry_compiler_output", _CORE_OBJECTS[p]],
    output = p + ".lo", linker = "@bsd_sdk//toolchain:bin/ld.lld",
    runtime = ["@bsd_sdk//toolchain:link_inputs"],
    linkopts = ["--eh-frame-hdr", "-Bstatic", "--allow-multiple-definition", "-znow", "-zrelro"]) for p in _CORE_PROGRAMS]
[bsd_crunchide(name = p + "_crunched", input_object = ":" + p + "_unhidden", program_name = p,
    keep_symbols = ["_crunched_" + crunchgen_identifier(p) + "_stub"]) for p in _CORE_PROGRAMS]
[filegroup(name = p + "_crunched_original", srcs = [":" + p + "_crunched"], output_group = "original_name") for p in _CORE_PROGRAMS]
filegroup(name = "crunchide_execution_tool", srcs = [":cat_crunched"], output_group = "execution_tool")

# Bounded real ninety-one-program executable, with native static libc and startup.
