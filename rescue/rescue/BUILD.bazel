# Installed rescue/package composition remains a separate qualification gate.

# Supported combined-object stage, covering the 103 default applications.
_CORE_PROGRAMS = PROGRAMS
_CORE_OWNERS = {p: "usr.bin/" + p for p in ["head", "tail", "tee", "id"]}
_CORE_OWNERS.update({p: "usr.sbin/" + p for p in ["chroot", "chown"]})
_CORE_OWNERS.update({p: "sbin/" + p for p in ['kldload', 'kldunload', 'kldstat', 'kldconfig', 'dmesg', 'rcorder', 'mknod', 'devfs', 'mount_cd9660', 'mount_nullfs', 'mount_unionfs', 'swapon', 'mdconfig']})
_CORE_OWNERS.update({p: "sbin/" + p for p in ['clri', 'fsirand', 'dumpfs', 'tunefs', 'newfs', 'fsck', 'newfs_msdos', 'umount']})
_CORE_OWNERS.update({'sed': 'usr.bin/sed', 'gzip': 'usr.bin/gzip', 'bzip2': 'usr.bin/bzip2', 'mt': 'usr.bin/mt', 'md5': 'sbin/md5', 'ldconfig': 'sbin/ldconfig', 'sysctl': 'sbin/sysctl', 'fsck_msdosfs': 'sbin/fsck_msdosfs'})
_CORE_OWNERS.update({'xz': 'usr.bin/xz', 'zstd': 'usr.bin/zstd', 'less': 'usr.bin/less', 'rtsol': 'sbin/rtsol', 'mount_msdosfs': 'sbin/mount_msdosfs', 'route': 'sbin/route'})
_CORE_OWNERS.update({'reboot': 'sbin/reboot', 'shutdown': 'sbin/shutdown', 'dumpon': 'sbin/dumpon', 'savecore': 'sbin/savecore', 'mount': 'sbin/mount', 'mdmfs': 'sbin/mdmfs', 'nos-tun': 'sbin/nos-tun', 'nc': 'usr.bin/nc', 'fetch': 'usr.bin/fetch'})
_CORE_OWNERS.update({'dump': 'sbin/dump', 'restore': 'sbin/restore', 'fsck_ffs': 'sbin/fsck_ffs', 'fsdb': 'sbin/fsdb', 'mount_nfs': 'sbin/mount_nfs'})
_CORE_OWNERS.update({'init': 'sbin/init', 'ping': 'sbin/ping', 'dhclient': 'sbin/dhclient', 'iscsictl': 'usr.bin/iscsictl', 'iscsid': 'usr.sbin/iscsid', 'tar': 'usr.bin/tar'})
_CORE_OWNERS.update({'sh': 'bin/sh', 'csh': 'bin/csh', 'vi': 'usr.bin/vi'})
_CORE_OWNERS.update({'camcontrol': 'sbin/camcontrol', 'geom': 'sbin/geom', 'pfctl': 'sbin/pfctl', 'ifconfig': 'sbin/ifconfig'})
_CORE_OWNERS.update({'bectl': 'sbin/bectl', 'zfsbootcfg': 'sbin/zfsbootcfg', 'zfs': 'cddl/sbin/zfs', 'zpool': 'cddl/sbin/zpool', 'zdb': 'cddl/usr.sbin/zdb'})
_CORE_OBJECTS = {p: "//" + _CORE_OWNERS.get(p, "bin/" + p) + ":rescue_compiler_outputs" for p in _CORE_PROGRAMS}
load(":assembly.bzl", "rescue_dispatcher", "rescue_binary")
rescue_dispatcher(name = "core_dispatch", executable_name = "rescue_core", emit_stubs = True, objects = _CORE_OBJECTS)
rescue_dispatcher(name = "rescue_dispatch", executable_name = "rescue", objects = _CORE_OBJECTS)
filegroup(name = "rescue_metadata", srcs = [":rescue_dispatch"], output_group = "metadata")
filegroup(name = "core_metadata", srcs = [":core_dispatch"], output_group = "metadata")
[filegroup(name = p + "_entry_source", srcs = [":core_dispatch"], output_group = "stub_" + crunchgen_identifier(p)) for p in _CORE_PROGRAMS]
# Original generated-Make stub recipe uses the parent no-SSP/no-debug policy.
# Its repeated equivalent -O2 flags use the ordinary toolchain optimization mode.
[cc_library(name = p + "_entry_objects", srcs = [":" + p + "_entry_source"],
    features = ["-bsd_ssp", "-bsd_debug_info"], copts = ['-pipe', '-fno-common', '-std=gnu17', '-Wno-format-zero-length', '-Wsystem-headers', '-Werror', '-Wall', '-Wno-format-y2k', '-W', '-Wno-unused-parameter', '-Wstrict-prototypes', '-Wmissing-prototypes', '-Wpointer-arith', '-Wreturn-type', '-Wcast-qual', '-Wwrite-strings', '-Wswitch', '-Wshadow', '-Wunused-parameter', '-Wcast-align', '-Wchar-subscripts', '-Wnested-externs', '-Wold-style-definition', '-Wno-pointer-sign', '-Wdate-time', '-Wmissing-variable-declarations', '-Wthread-safety', '-Wno-empty-body', '-Wno-string-plus-int', '-Wno-unused-const-variable', '-Wno-error=unused-but-set-parameter', '-Wno-error=cast-function-type-mismatch', '-Qunused-arguments', '-Wl,--allow-multiple-definition', '-Wl,-znow', '-Wl,-zrelro', '-static', '-pipe', '-fno-common'],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]) for p in _CORE_PROGRAMS]
[bsd_component_objects(name = p + "_entry_compiler_output", group = ":" + p + "_entry_objects", pic = False) for p in _CORE_PROGRAMS]
# These object-only links have no library lookup. Original driver --sysroot/-L
# search roots are unused; actual emitted linker behavior is checked against Make.
[bsd_relocatable_link(name = p + "_unhidden", objects = [":" + p + "_entry_compiler_output"], application = _CORE_OBJECTS[p],
    output = p + ".lo", linker = "@bsd_sdk//toolchain:bin/ld.lld",
    runtime = ["@bsd_sdk//toolchain:link_inputs"],
    linkopts = ["--eh-frame-hdr", "-Bstatic", "--allow-multiple-definition", "-znow", "-zrelro"]) for p in _CORE_PROGRAMS]
[bsd_crunchide(name = p + "_crunched", input_object = ":" + p + "_unhidden", program_name = p,
    keep_symbols = ["_crunched_" + crunchgen_identifier(p) + "_stub"]) for p in _CORE_PROGRAMS]
[filegroup(name = p + "_crunched_original", srcs = [":" + p + "_crunched"], output_group = "original_name") for p in _CORE_PROGRAMS]
filegroup(name = "crunchide_execution_tool", srcs = [":cat_crunched"], output_group = "execution_tool")

# Bounded 103-program executable, with native static libc and startup.
# This does not replace the complete original rescue selection/install target.
_PARENT_COPTS = ['-pipe', '-fno-common', '-std=gnu17', '-Wno-format-zero-length', '-Wsystem-headers', '-Werror', '-Wall', '-Wno-format-y2k', '-W', '-Wno-unused-parameter', '-Wstrict-prototypes', '-Wmissing-prototypes', '-Wpointer-arith', '-Wreturn-type', '-Wcast-qual', '-Wwrite-strings', '-Wswitch', '-Wshadow', '-Wunused-parameter', '-Wcast-align', '-Wchar-subscripts', '-Wnested-externs', '-Wold-style-definition', '-Wno-pointer-sign', '-Wdate-time', '-Wmissing-variable-declarations', '-Wthread-safety', '-Wno-empty-body', '-Wno-string-plus-int', '-Wno-unused-const-variable', '-Wno-error=unused-but-set-parameter', '-Wno-error=cast-function-type-mismatch', '-Qunused-arguments']
cc_library(name = "core_dispatcher_objects", srcs = [":core_dispatch"],
    features = ["-bsd_ssp", "-bsd_debug_info"],
    copts = _PARENT_COPTS,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
bsd_component_objects(name = "core_dispatcher_compiler_output", group = ":core_dispatcher_objects", pic = False)
# Selected archives follow original CRUNCH_LIBS order. Each cc_import preserves
# lazy extraction; provider/header CcInfo does not become an accidental own input.
_CORE_ARCHIVES = [
    ("crypt", "//lib/libcrypt:static_archive"),
    ("edit", "//lib/libedit:static_archive"),
    ("jail", "//lib/libjail:static_archive"),
    ("kvm", "//lib/libkvm:static_archive"),
    ("elf", "//lib/libelf:static_archive"),
    ("tinfo", "//lib/ncurses/tinfo:static_archive"),
    ("util", "//lib/libutil:static_archive"),
    ("xo", "//lib/libxo/libxo:static_archive"),
    ("80211", "//lib/lib80211:static_archive"),
    ("alias", "//lib/libalias/libalias:static_archive"),
    ("cam", "//lib/libcam:static_archive"),
    ("ncurses", "//lib/ncurses/ncurses:static_archive"),
    ("devstat", "//lib/libdevstat:static_archive"),
    ("ipsec", "//lib/libipsec:static_archive"),
    ("lzma", "//lib/liblzma:static_archive"),
    ("avl", "//cddl/lib/libavl:static_archive"),
    ("pthread", "//lib/libthr:static_archive"),
    ("umem", "//cddl/lib/libumem:static_archive"),
    ("spl", "//cddl/lib/libspl:static_archive"),
    ("rt", "//lib/librt:static_archive"),
    ("geom", "//lib/libgeom:static_archive"),
    ("bsdxml", "//lib/libexpat:static_archive"),
    ("kiconv", "//lib/libkiconv:static_archive"),
    ("mt", "//lib/libmt:static_archive"),
    ("sbuf", "//lib/libsbuf:static_archive"),
    ("ufs", "//lib/libufs:static_archive"),
    ("z", "//lib/libz:static_archive"),
    ("bz2", "//lib/libbz2:static_archive"),
    ("zstd", "//lib/libzstd:static_archive"),
    ("fetch", "//lib/libfetch:static_archive"),
    ("archive", "//lib/libarchive:static_archive"),
    ("ssl", "//secure/lib/libssl:static_archive"),
    ("crypto", "//secure/lib/libcrypto:static_archive"),
    ("md", "//lib/libmd:md"),
    ("ifconfig", "//lib/libifconfig:static_archive"),
    ("m", "//lib/msun:static_archive"),
    ("iscsiutil", "//lib/libiscsiutil:static_archive"),
]
[cc_import(name = "core_" + name + "_static_link", static_library = archive,
    deps = select({"//tools/build/bazel/config:zfs_enabled": [":core_avl_static_link"], "//conditions:default": [":core_pthread_static_link"]}) if name == "lzma" else
        select({"//tools/build/bazel/config:zfs_enabled": [":core_umem_static_link"], "//conditions:default": [":core_geom_static_link"]}) if name == "pthread" else
        select({"//tools/build/bazel/config:iscsi_enabled": [":core_iscsiutil_static_link"], "//conditions:default": ["//lib/libc:static_link_objects"]}) if name == "m" else
        select({"//tools/build/bazel/config:openssl_enabled": [":core_ssl_static_link"], "//conditions:default": [":core_md_static_link"]}) if name == "archive" else
        ([":core_" + _CORE_ARCHIVES[index + 1][0] + "_static_link"] if index + 1 < len(_CORE_ARCHIVES) else ["//lib/libc:static_link_objects"]))
 for index, (name, archive) in enumerate(_CORE_ARCHIVES)]
# Direct helper overrides precede archive searching, as in original CRUNCH_LIBS.
# An archive would lose the original unconditional replacement semantics.
rescue_binary(name = "rescue_core", dispatcher = ":core_dispatcher_compiler_output",
    crunched_objects = selected_program_values({p: ":" + p + "_crunched" for p in _CORE_PROGRAMS}))
# The installed dispatcher has its own correct EXECNAME and shares application
# stubs, crunched objects, helper replacements and the exact static link policy.
cc_library(name = "rescue_dispatcher_objects", srcs = [":rescue_dispatch"],
    features = ["-bsd_ssp", "-bsd_debug_info"], copts = _PARENT_COPTS,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
bsd_component_objects(name = "rescue_dispatcher_compiler_output", group = ":rescue_dispatcher_objects", pic = False)
rescue_binary(name = "rescue", dispatcher = ":rescue_dispatcher_compiler_output",
    crunched_objects = selected_program_values({p: ":" + p + "_crunched" for p in _CORE_PROGRAMS}),
    visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_python_test.bzl", "bsd_python_test")
bsd_python_test(name = "core_runtime_test", src = "core-runtime-test.py", data = [":rescue_core"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])

# This small integration suite follows explicit configured metadata and is usable
# when optional programs are disabled; the broad default suite remains separate.
bsd_python_test(name = "configuration_runtime_test", src = "configuration-runtime-test.py",
    args = select({"//tools/build/bazel/config:dtrace_enabled": ["--dtrace=yes"], "//conditions:default": ["--dtrace=no"]}),
    data = [":rescue_core", ":core_metadata"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])

selects.config_setting_group(name = "installed_ping6", match_all = [
    ":ping_enabled", "//tools/build/bazel/config:inet6_support_enabled",
])
load(":installation.bzl", "rescue_installation")
rescue_installation(name = "install_manifest", binary = ":rescue")
load("//tools/build/bazel:bsd_script_installation.bzl", "script_install_archive")
script_install_archive(name = "install_archive")
filegroup(name = "installation_metadata", srcs = [":install_manifest"], output_group = "manifest")
bsd_python_test(name = "installation_runtime_test", src = "installation-runtime-test.py",
    data = [":install_archive", ":installation_metadata", ":rescue_metadata"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])

filegroup(name = "package_abi", srcs = [":install_manifest_stripped"], visibility = ["//packages/rescue:__pkg__"])
