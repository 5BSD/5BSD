# No full rescue executable/install/package is declared before application objects,
# crunchide transforms and the complete static library/link contract exist.

# Supported combined-object stage, bounded to ninety-one real applications.
_CORE_PROGRAMS = [p for p in PROGRAMS if p in ['cat', 'chflags', 'chmod', 'cp', 'echo', 'ed', 'expr', 'getfacl', 'hostname', 'ln', 'mkdir', 'mv', 'pwd', 'realpath', 'rm', 'rmdir', 'sleep', 'test', 'head', 'date', 'chio', 'kenv', 'setfacl', 'stty', 'kill', 'sync', 'dd', 'ls', 'df', 'ps', 'pkill', 'tail', 'tee', 'id', 'chroot', 'chown', 'kldload', 'kldunload', 'kldstat', 'kldconfig', 'dmesg', 'rcorder', 'mknod', 'devfs', 'mount_cd9660', 'mount_nullfs', 'mount_unionfs', 'swapon', 'mdconfig', 'clri', 'fsirand', 'dumpfs', 'tunefs', 'newfs', 'fsck', 'newfs_msdos', 'umount', 'sed', 'gzip', 'bzip2', 'mt', 'md5', 'ldconfig', 'sysctl', 'fsck_msdosfs', 'xz', 'zstd', 'less', 'rtsol', 'mount_msdosfs', 'route', 'reboot', 'shutdown', 'dumpon', 'savecore', 'mount', 'mdmfs', 'nos-tun', 'nc', 'fetch', 'dump', 'restore', 'fsck_ffs', 'fsdb', 'mount_nfs', 'init', 'ping', 'dhclient', 'iscsictl', 'iscsid', 'tar']]
_CORE_OWNERS = {p: "usr.bin/" + p for p in ["head", "tail", "tee", "id"]}
_CORE_OWNERS.update({p: "usr.sbin/" + p for p in ["chroot", "chown"]})
_CORE_OWNERS.update({p: "sbin/" + p for p in ['kldload', 'kldunload', 'kldstat', 'kldconfig', 'dmesg', 'rcorder', 'mknod', 'devfs', 'mount_cd9660', 'mount_nullfs', 'mount_unionfs', 'swapon', 'mdconfig']})
_CORE_OWNERS.update({p: "sbin/" + p for p in ['clri', 'fsirand', 'dumpfs', 'tunefs', 'newfs', 'fsck', 'newfs_msdos', 'umount']})
_CORE_OWNERS.update({'sed': 'usr.bin/sed', 'gzip': 'usr.bin/gzip', 'bzip2': 'usr.bin/bzip2', 'mt': 'usr.bin/mt', 'md5': 'sbin/md5', 'ldconfig': 'sbin/ldconfig', 'sysctl': 'sbin/sysctl', 'fsck_msdosfs': 'sbin/fsck_msdosfs'})
_CORE_OWNERS.update({'xz': 'usr.bin/xz', 'zstd': 'usr.bin/zstd', 'less': 'usr.bin/less', 'rtsol': 'sbin/rtsol', 'mount_msdosfs': 'sbin/mount_msdosfs', 'route': 'sbin/route'})
_CORE_OWNERS.update({'reboot': 'sbin/reboot', 'shutdown': 'sbin/shutdown', 'dumpon': 'sbin/dumpon', 'savecore': 'sbin/savecore', 'mount': 'sbin/mount', 'mdmfs': 'sbin/mdmfs', 'nos-tun': 'sbin/nos-tun', 'nc': 'usr.bin/nc', 'fetch': 'usr.bin/fetch'})
_CORE_OWNERS.update({'dump': 'sbin/dump', 'restore': 'sbin/restore', 'fsck_ffs': 'sbin/fsck_ffs', 'fsdb': 'sbin/fsdb', 'mount_nfs': 'sbin/mount_nfs'})
_CORE_OWNERS.update({'init': 'sbin/init', 'ping': 'sbin/ping', 'dhclient': 'sbin/dhclient', 'iscsictl': 'usr.bin/iscsictl', 'iscsid': 'usr.sbin/iscsid', 'tar': 'usr.bin/tar'})
_CORE_OBJECTS = {p: "//" + _CORE_OWNERS.get(p, "bin/" + p) + ":rescue_compiler_outputs" for p in _CORE_PROGRAMS}
[config_setting(name = name, flag_values = {
    "//tools/build/bazel/config:inet_support": v4,
    "//tools/build/bazel/config:inet6_support": v6,
}) for name, v4, v6 in [("ping_dual_stack", "true", "true"), ("ping_ipv4_only", "true", "false"), ("ping_ipv6_only", "false", "true")]]
bsd_crunchgen(name = "core_dispatch", executable_name = "rescue_core", programs = _CORE_PROGRAMS,
    object_names = select({
        "//tools/build/bazel/config:netlink_support_enabled": {p: OBJECT_NAMES[p] for p in _CORE_PROGRAMS if p != "ping"},
        "//conditions:default": {p: (["route.o", "show.o"] if p == "route" else OBJECT_NAMES[p]) for p in _CORE_PROGRAMS if p != "ping"},
    }) | select({
        ":ping_dual_stack": {"ping": ["main.o", "ping.o", "utils.o", "ping6.o"]},
        ":ping_ipv4_only": {"ping": ["main.o", "ping.o", "utils.o"]},
        ":ping_ipv6_only": {"ping": ["main.o", "ping6.o"]},
        "//conditions:default": {"ping": ["main.o"]},
    }),
    aliases = {p: ALIASES[p] for p in _CORE_PROGRAMS if p in ALIASES and p != "ping"} | select({
        "//tools/build/bazel/config:inet6_support_enabled": {"ping": ["ping6"]}, "//conditions:default": {},
    }), emit_stubs = True,
    required_configuration = {"//tools/build/bazel/config:dtrace": "true"})
