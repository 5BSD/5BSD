load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools/build/bazel:bsd_lex_yacc.bzl", "bsd_lex", "bsd_yacc")
bsd_yacc(name = "parser", src = "manifest_parser.y", output = "manifest_parser.c",
    header = "manifest_parser.h", yacc = "//usr.bin/yacc:yacc")
filegroup(name = "parser_source", srcs = [":parser"], output_group = "source", visibility = ["//sbin/veriexec/tests:__pkg__"])
filegroup(name = "parser_header", srcs = [":parser"], output_group = "header")
bsd_lex(name = "lexer", src = "manifest_lexer.l", output = "manifest_lexer.c",
    lex = "//usr.bin/lex:lex", m4 = "//usr.bin/m4:m4", visibility = ["//sbin/veriexec/tests:__pkg__"])
cc_library(name = "headers", hdrs = ["veriexec.h", ":parser_header"], strip_include_prefix = ".",
    visibility = ["//sbin/veriexec/tests:__pkg__"])
cc_binary(
    name = "veriexec",
    srcs = ["veriexec.c", ":parser_source", ":lexer"],
    deps = [":headers", "//lib/libveriexec:veriexec", "//lib/libsecureboot:secureboot", "//lib/libbearssl:bearssl"],
    linkstatic = True,
    features = ["fully_static_link"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
)
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "veriexec", manual = "veriexec.8",
    package = "utilities", bindir = "/sbin", man_section = "8")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "program_install_archive", manifests = [":install_manifest"],
    directories = {"/usr/lib/debug/sbin": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}'},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])

bsd_install_archive(name = "install_archive", visibility = ["//sbin:__pkg__"], manifests = [":install_manifest"] + select({
        "//tools/build/bazel/config:tests_enabled": ["//sbin/veriexec/tests:install_manifest"], "//conditions:default": []}),
    directories = {"/usr/lib/debug/sbin": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}'} | select({
        "//tools/build/bazel/config:tests_enabled": {"/usr/tests/sbin/veriexec": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests"]}'} |
            {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/tests", "/usr/lib/debug/usr/tests/sbin", "/usr/lib/debug/usr/tests/sbin/veriexec"]},
        "//conditions:default": {}}),
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib", "//etc/mtree:BSD.tests.dist": "/usr/tests"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])
