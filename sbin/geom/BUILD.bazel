load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load(":configuration.bzl", "geom_configuration")
geom_configuration(name = "configuration", path = "//tools/build/bazel/config:geom_class_dir")
cc_library(name = "headers", hdrs = ["core/geom.h"], strip_include_prefix = "core", visibility = ["//visibility:public"])
cc_library(name = "misc_headers", hdrs = ["misc/subr.h"], strip_include_prefix = ".", visibility = ["//visibility:public"])
_SOURCES = ["core/geom.c", "misc/subr.c"]
cc_binary(name = "geom", srcs = _SOURCES + [":configuration"],
    deps = [":headers", ":misc_headers", "//lib/libgeom:geom", "//lib/libutil:util", "//lib/libxo/libxo:xo"],
    dynamic_deps = ["//lib/libgeom:geom_shared", "//lib/libutil:util_shared", "//lib/libxo/libxo:xo_shared"],
    copts = ["-fPIE", "-include", "$(location :configuration)"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_link")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
# Class manuals belong to lib/geom plugins; only executable links live here.
load("//lib/geom:classes.bzl", "GEOM_CLASSES", "GEOM_OPENSSL_CLASSES", "geom_class_labels")
[bsd_install_link(name = "alias_" + cls, destination = "/sbin/g" + cls,
    target = "/sbin/geom", kind = "hardlink", owner = "root", group = "wheel", mode = "0555", install_tags = ["package=geom"])
 for cls in GEOM_CLASSES + GEOM_OPENSSL_CLASSES]
utility_installation(name = "install_manifest", program = "geom", manual = "core/geom.8", package = "geom", bindir = "/sbin", man_section = "8",
    extra_entries = geom_class_labels(":alias_{cls}"))
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "program_install_archive", visibility = ["//sbin:__pkg__"], manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=geom","dbg"]}'
        for d in ["/usr/lib/debug/sbin"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])

exports_files(["misc/subr.c"], visibility = ["//lib/geom:__subpackages__"])
cc_library(name = "plugin_headers", hdrs = ["core/geom.h", "misc/subr.h"], strip_include_prefix = ".", visibility = ["//lib/geom:__subpackages__"])

load("//tools/build/bazel:bsd_rescue_application.bzl", "rescue_application")
rescue_application(srcs = _SOURCES + ["//lib/geom/label:geom_label.c", "//lib/geom/part:geom_part.c"],
    object_names = ['geom.o', 'subr.o', 'geom_label.o', 'geom_part.o'], deps = [':headers', ':misc_headers', ':plugin_headers', '//lib/libgeom:headers', '//lib/libutil:headers', '//contrib/libxo:headers', '//sys/geom/label:headers'],
    defines = ["STATIC_GEOM_CLASSES", "'GEOM_CLASS_DIR=\"\"'"], warns = 2)
