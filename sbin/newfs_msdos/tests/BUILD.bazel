load("//tools/build/bazel:bsd_compare_test.bzl", "bsd_filter_fixture")
bsd_filter_fixture(name = "adapted_body", src = "//contrib/netbsd-tests/sbin/newfs_msdos:t_create.sh", output = "create.sh",
    tool = "@bsd_sdk//toolchain:sed", arguments = ["-e", "s/fsck_msdos/fsck_msdosfs/"],
    runtime = ["@bsd_sdk//toolchain:sed_runtime"], redirect = "@bsd_sdk//toolchain:stdout_redirect")
load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
CASES = ['validfat32']
[bsd_atf_test(
    name = "native_" + case,
    case_name = case,
    body = ":adapted_body",
    subr = "//libexec/atf/atf-sh:shell_library",
    runtime_bin = ['//sbin/newfs_msdos:newfs_msdos', '//sbin/fsck_msdosfs:fsck_msdosfs', '//bin/sh:sh', '//libexec/atf/atf-sh:atf-sh', '//libexec/atf/atf-check:atf-check', '//usr.bin/dirname:dirname', '//usr.bin/tr:tr'],
    runtime_lib = ['//lib/atf/libatf-c:atf_c_shared', '//lib/atf/libatf-c++:atf_cxx_shared', '//lib/libc++:cxx_shared', '//lib/libcxxrt:cxxrt_shared', '//lib/msun:m_shared', '//lib/libedit:edit_shared', '//lib/ncurses/tinfo:tinfo_shared', '@bsd_sdk//toolchain:sysroot/lib/libc.so.7', '@bsd_sdk//toolchain:sysroot/lib/libsys.so.7', '@bsd_sdk//toolchain:sysroot/lib/libgcc_s.so.1', '//lib/libutil:util_shared'],
    runner = "//tools/build/bazel:atf_runner",
    size = "medium",
) for case in CASES]
test_suite(name = "tests", tests = [":native_" + case for case in CASES], visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_script_wrapper")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
bsd_script_wrapper(name = "create", body = ":adapted_body", interpreter = "/usr/libexec/atf-sh",
    cat = "@bsd_sdk//toolchain:cat", cat_runtime = ["@bsd_sdk//toolchain:cat_runtime"], redirect = "@bsd_sdk//toolchain:stdout_redirect")
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["create"], interfaces = {"create": "atf"})
[bsd_install_file(name = target, src = source, destination = "/usr/tests/sbin/newfs_msdos/" + filename,
    owner = "root", group = "wheel", mode = mode, install_tags = ["package=tests"])
 for target, source, filename, mode in [("install_shell", ":create", "create", "0555"), ("install_kyuafile", ":kyuafile", "Kyuafile", "0444")]]
bsd_install_manifest(name = "install_manifest", entries = [":install_shell", ":install_kyuafile"], visibility = ["//sbin/newfs_msdos:__pkg__"])
