# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
_SOURCES = (
['init.c', 'pathnames.h']
)
load("//tools/build/bazel:bsd_asm_payload.bzl", "bsd_asm_payload")
bsd_asm_payload(name = "seed_object", src = "reroot_seed.embed.s", payloads = ["//sbin/reroot_seed:embed_payload"])
cc_binary(name = "init", srcs = _SOURCES + [":seed_object"],
    deps = ["//lib/libutil:util", "//lib/libcrypt:crypt"], dynamic_deps = ["//lib/libutil:util_shared", "//lib/libcrypt:crypt_shared"],
    local_defines = ["DEBUGSHELL", "SECURE", "LOGIN_CAP", "COMPAT_SYSV_INIT"], copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "init", manual = "init.8",
    package = "runtime", bindir = "/sbin", man_section = "8", binary_flags = "schg", extra_entries = [":ttys_install"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "program_install_archive", visibility = ["//sbin:__pkg__"], manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime","dbg"]}'
        for d in ["/usr/lib/debug/sbin"]} | {"/etc": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities"]}'},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file")
bsd_install_file(name = "ttys_install", src = "ttys", destination = "/etc/ttys", owner = "root", group = "wheel", mode = "0644", install_tags = ["package=runtime", "config"])

load("//tools/build/bazel:bsd_rescue_application.bzl", "rescue_application")
rescue_application(srcs = _SOURCES,
    object_names = ['init.o'],
    deps = ['//lib/libutil:headers'],
    defines = ["DEBUGSHELL", "SECURE", "LOGIN_CAP", "COMPAT_SYSV_INIT"])
