# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_import")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_header", "bsd_dtrace_cc_objects")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
bsd_dtrace_header(
    name = "provider", source = "dhcplife_provider.d", output = "dhcplife_provider.h",
    flags = ["-C", "-x", "nolibs"], object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:dtrace", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti",
    runtime_libraries = ['//cddl/lib/libdtrace:dtrace_shared', '//cddl/lib/libctf:ctf_shared', '//lib/libelf:elf_shared', '//lib/libproc:proc_shared', '//cddl/lib/libspl:spl_shared', '//lib/libxo/libxo:xo_shared', '//lib/libutil:util_shared', '//lib/libprocstat:procstat_shared', '//lib/librtld_db:rtld_db_shared', '//lib/libcxxrt:cxxrt_shared', '//lib/libz:z_shared', '//lib/libkvm:kvm_shared'],
    tool_inputs = [ "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"], static_anchor = True,
)
cc_library(name = "provider_headers", hdrs = [":provider"], strip_include_prefix = ".")

cc_library(name = "objects", srcs = ["dhclient.c", "clparse.c", "alloc.c", "dispatch.c", "hash.c", "bpf.c", "options.c", "tree.c", "conflex.c", "errwarn.c", "inet.c", "packet.c", "convert.c", "tables.c", "parse.c", "privsep.c", "inet6.c", "dhcp.h", "dhcpd.h", "dhctoken.h", "privsep.h", "tree.h", "dhcplife_trace.h"],
    deps = ["//lib/libutil:util", "//lib/libcasper/libcasper:casper", "//lib/libcasper/services/cap_syslog:cap_syslog"] + select({_TRACE: [":provider_headers"], "//conditions:default": []}),
    local_defines = ["WITH_CASPER"] + select({_TRACE: ["WITH_COVERAGE_DTRACE"], "//conditions:default": []}) + select({"//tools/build/bazel/config:inet6_support_enabled": ["INET6"], "//conditions:default": []}) + select({"//tools/build/bazel/config:netlink_support_enabled": [], "//conditions:default": ["WITHOUT_NETLINK"]}),
    copts = ["-fPIE"], target_compatible_with = _PLATFORM)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider", provider_object = "dhcplife_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group) for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"], deps = [":provider_link"] + ["//lib/libutil:util", "//lib/libcasper/libcasper:casper", "//lib/libcasper/services/cap_syslog:cap_syslog"])
cc_binary(name = "dhclient", deps = select({_TRACE: [":traced"], "//conditions:default": [":objects"]}),
    dynamic_deps = ["//lib/libutil:util_shared", "//lib/libcasper/libcasper:casper_shared", "//lib/libcasper/services/cap_syslog:cap_syslog_shared"],
    linkopts = ["-pie"], target_compatible_with = _PLATFORM + select({"//tools/build/bazel/config:casper_enabled": [], "//conditions:default": ["@platforms//:incompatible"]}), visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "dhclient", manual = "dhclient.8",
    package = "dhclient", bindir = "/sbin", man_section = "8", extra_entries = [":config", ":script"] + [":man_" + str(i) for i in range(4)])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "program_install_archive", manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=dhclient","dbg"]}'
        for d in ["/usr/lib/debug/sbin"]} | {"/sbin": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=dhclient"]}'},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_compress")
bsd_install_file(name = "config", src = "dhclient.conf", destination = "/etc/dhclient.conf", owner = "root", group = "wheel", mode = "0644", install_tags = ["package=dhclient", "config"])
bsd_install_file(name = "script", src = "dhclient-script", destination = "/sbin/dhclient-script", owner = "root", group = "wheel", mode = "0555", install_tags = ["package=dhclient"])
_MANUALS = ["dhclient.conf.5", "dhclient.leases.5", "dhcp-options.5", "dhclient-script.8"]
[bsd_compress(name = "gzip_" + str(i), src = filename, output = filename + ".gz", arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"]) for i, filename in enumerate(_MANUALS)]
[bsd_install_file(name = "man_" + str(i), src = ":gzip_" + str(i), destination = "/usr/share/man/man" + filename[-1] + "/" + filename + ".gz", owner = "root", group = "wheel", mode = "0444", install_tags = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=dhclient-man"], "//conditions:default": ["package=dhclient"]})) for i, filename in enumerate(_MANUALS)]

# The maintained plain test exercises the production option parser directly.
filegroup(name = "option_test_sources", srcs = ["alloc.c", "convert.c", "hash.c", "options.c", "tables.c", "parse.c", "conflex.c", "tree.c"], visibility = ["//sbin/dhclient/tests:__pkg__"])
cc_library(name = "test_headers", hdrs = ["dhcp.h", "dhcpd.h", "dhctoken.h", "privsep.h", "tree.h", "dhcplife_trace.h"], strip_include_prefix = ".", visibility = ["//sbin/dhclient/tests:__pkg__"])

bsd_install_archive(name = "install_archive", manifests = [":install_manifest"] + select({"//tools/build/bazel/config:tests_enabled": ["//sbin/dhclient/tests:install_option", "//sbin/dhclient/tests:install_extra"], "//conditions:default": []}),
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=dhclient","dbg"]}'
        for d in ["/usr/lib/debug/sbin"]} | {"/sbin": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=dhclient"]}'} | select({"//tools/build/bazel/config:tests_enabled": {"/usr/tests/sbin/dhclient": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests"]}'}, "//conditions:default": {}}) | select({"//tools/build/bazel/config:tests_enabled": {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/tests"]} | {"/usr/lib/debug/usr/tests/sbin": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests"]}', "/usr/lib/debug/usr/tests/sbin/dhclient": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests","dbg"]}'}, "//conditions:default": {}}),
    mtree_specs = {"//etc/mtree:BSD.tests.dist": "/usr/tests", "//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])
