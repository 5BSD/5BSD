load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "option_objects", srcs = ["//sbin/dhclient:option_test_sources", "fake.c", "option-domain-search.c"],
    deps = ["//sbin/dhclient:test_headers", "//lib/libutil:util"], copts = ["-fPIE"], target_compatible_with = _PLATFORM)
cc_binary(name = "option-domain-search_test", deps = [":option_objects"], dynamic_deps = ["//lib/libutil:util_shared"],
    linkopts = ["-pie"], target_compatible_with = _PLATFORM)
# Only the test execution binary receives runfiles library search paths.
cc_test(name = "option_domain_search", deps = [":option_objects"], dynamic_deps = ["//lib/libutil:util_shared"],
    linkstatic = True, features = ["bsd_test_runtime_paths"], linkopts = ["-pie"], size = "small", target_compatible_with = _PLATFORM)
test_suite(name = "tests", tests = [":option_domain_search"], visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_script_wrapper")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
# PCP requires root, VNET/netgraph, and an ISC DHCP server. Preserve its
# installation and exclusivity; it is not part of the host-safe test suite.
bsd_script_wrapper(name = "pcp", body = "pcp.sh", interpreter = "/usr/libexec/atf-sh",
    cat = "@bsd_sdk//toolchain:cat", cat_runtime = ["@bsd_sdk//toolchain:cat_runtime"], redirect = "@bsd_sdk//toolchain:stdout_redirect")
utility_installation(name = "install_option", program = "option-domain-search_test", manual = "", package = "tests", bindir = "/usr/tests/sbin/dhclient")
bsd_install_file(name = "install_pcp", src = ":pcp", destination = "/usr/tests/sbin/dhclient/pcp", owner = "root", group = "wheel", mode = "0555", install_tags = ["package=tests"])
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["option-domain-search_test", "pcp"], interfaces = {"option-domain-search_test": "plain", "pcp": "atf"}, metadata = {"pcp": '{"is_exclusive":true}'})
bsd_install_file(name = "install_kyuafile", src = ":kyuafile", destination = "/usr/tests/sbin/dhclient/Kyuafile", owner = "root", group = "wheel", mode = "0444", install_tags = ["package=tests"])
bsd_install_manifest(name = "install_extra", entries = [":install_pcp", ":install_kyuafile"], visibility = ["//sbin/dhclient:__pkg__"])
