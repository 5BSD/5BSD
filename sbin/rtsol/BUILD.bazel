load("@rules_cc//cc:defs.bzl", "cc_binary")
_PROGRAM_SOURCES = ["//usr.sbin/rtsold:cap_llflags.c", "//usr.sbin/rtsold:cap_script.c", "//usr.sbin/rtsold:cap_sendmsg.c", "//usr.sbin/rtsold:dump.c", "//usr.sbin/rtsold:if.c", "//usr.sbin/rtsold:rtsol.c", "//usr.sbin/rtsold:rtsold.c", "//usr.sbin/rtsold:rtsock.c"]
cc_binary(name = "rtsol", srcs = _PROGRAM_SOURCES,
    deps = ["//usr.sbin/rtsold:headers", "//lib/libutil:util", "//lib/libcasper/libcasper:headers", "//lib/libcasper/services/cap_syslog:headers"] + select({"//tools/build/bazel/config:casper_enabled": ["//lib/libcasper/services/cap_syslog:cap_syslog", "//lib/libcasper/libcasper:casper", "//lib/libnv:nv"], "//conditions:default": []}),
    dynamic_deps = ["//lib/libutil:util_shared"] + select({"//tools/build/bazel/config:casper_enabled": ["//lib/libcasper/services/cap_syslog:cap_syslog_shared", "//lib/libcasper/libcasper:casper_shared", "//lib/libnv:nv_shared"], "//conditions:default": []}),
    local_defines = select({"//tools/build/bazel/config:casper_enabled": ["WITH_CASPER"], "//conditions:default": []}),
    copts = ["-fPIE"], linkopts = ["-pie"],
    # Normal system builds require CASPER in share/mk/src.opts.mk.
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"] + select({"//tools/build/bazel/config:casper_enabled": [], "//conditions:default": ["@platforms//:incompatible"]}),
    visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "rtsol", manual = "",
    package = "runtime", bindir = "/sbin", man_section = "8")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "program_install_archive", visibility = ["//sbin:__pkg__"], manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime","dbg"]}'
        for d in ["/usr/lib/debug/sbin"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])

load("//tools/build/bazel:bsd_rescue_application.bzl", "rescue_application")
rescue_application(srcs = _PROGRAM_SOURCES,
    object_names = ['cap_llflags.o', 'cap_script.o', 'cap_sendmsg.o', 'dump.o', 'if.o', 'rtsol.o', 'rtsold.o', 'rtsock.o'], deps = ['//usr.sbin/rtsold:headers', '//lib/libutil:headers', '//lib/libcasper/libcasper:headers', '//lib/libcasper/services/cap_syslog:headers'], warns = 6, defines = [])
