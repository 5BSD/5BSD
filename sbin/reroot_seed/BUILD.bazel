load("@rules_cc//cc:defs.bzl", "cc_binary")
# Internal static payload embedded into init; never installed as a standalone tool.
cc_binary(name = "reroot_seed", srcs = ["reroot_seed.c"], linkstatic = True,
    features = ["fully_static_link"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_debug_split")
# Make's INTERNALPROG payload keeps symbols but removes debug sections.
bsd_debug_split(name = "embed_payload", src = ":reroot_seed", binary_name = "payload/reroot_seed", debug_name = "payload/reroot_seed.debug",
    objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy", objcopy_inputs = "@bsd_sdk//toolchain:objcopy_inputs", visibility = ["//sbin/init:__pkg__"])
filegroup(name = "payload_debug", srcs = [":embed_payload"], output_group = "debug_files", visibility = ["//visibility:public"])
