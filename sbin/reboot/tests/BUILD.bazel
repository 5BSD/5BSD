load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
# Keep the maintained Make test's wrappers: never invoke host lifecycle actions.
cc_binary(name = "reboot_test", srcs = ["reboot_test.c"],
    deps = ["//sbin/reboot:test_source", "//lib/atf/libatf-c:atf_c"],
    dynamic_deps = ["//lib/atf/libatf-c:atf_c_shared"],
    copts = ["-fPIE"], linkopts = ["-pie"] + ["-Wl,--wrap=" + symbol for symbol in
        ["reboot", "kill", "sync", "sleep", "execl", "geteuid", "pututxline", "sysctlbyname"]],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
_CASES = ["synced_fallback", "accepted_shutdown", "legacy_fallback", "protected_fallback", "fast_shutdown", "quick_shutdown"]
[bsd_atf_test(name = "native_" + case, case_name = case, interface = "program", body = ":reboot_test",
    runtime_lib = ["//lib/atf/libatf-c:atf_c_shared", "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"],
    runner = "//tools/build/bazel:atf_runner", size = "small") for case in _CASES]
test_suite(name = "tests", tests = [":native_" + case for case in _CASES], visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
utility_installation(name = "install_test", program = "reboot_test", manual = "", package = "runtime-tests", bindir = "/usr/tests/sbin/reboot")
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["reboot_test"], interfaces = {"reboot_test": "atf"})
bsd_install_file(name = "install_kyuafile", src = ":kyuafile", destination = "/usr/tests/sbin/reboot/Kyuafile", owner = "root", group = "wheel", mode = "0444", install_tags = ["package=runtime-tests"])
bsd_install_manifest(name = "install_extra", entries = [":install_kyuafile"], visibility = ["//sbin/reboot:__pkg__"])
