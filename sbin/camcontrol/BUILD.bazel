load("@rules_cc//cc:defs.bzl", "cc_binary")
_SOURCES = (
['camcontrol.c', 'attrib.c', 'depop.c', 'epc.c', 'fwdownload.c', 'modeedit.c', 'persist.c', 'progress.c', 'timestamp.c', 'util.c', 'zone.c', '//sbin/nvmecontrol:identify_ext.c', '//sbin/nvmecontrol:nc_util.c', '//sys/dev/nvme:nvme_util.c'] + glob(["*.h"])
)
cc_binary(
    name = "camcontrol",
    srcs = _SOURCES,
    deps = ['//lib/libcam:cam', '//lib/libnvmf:nvmf_pie', '//lib/libnv:nv', '//lib/libsbuf:sbuf', '//lib/libutil:util'] + ["//sbin/nvmecontrol:headers"],
    dynamic_deps = ['//lib/libcam:cam_shared', '//lib/libnv:nv_shared', '//lib/libsbuf:sbuf_shared', '//lib/libutil:util_shared'],
    copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
)
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "camcontrol", manual = "camcontrol.8", package = "runtime", bindir = "/sbin", man_section = "8")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive", visibility = ["//sbin:__pkg__"],
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

load("//tools/build/bazel:bsd_rescue_application.bzl", "rescue_application")
rescue_application(srcs = _SOURCES, object_names = ['camcontrol.o', 'attrib.o', 'depop.o', 'epc.o', 'fwdownload.o', 'modeedit.o', 'persist.o', 'progress.o', 'timestamp.o', 'util.o', 'zone.o', 'identify_ext.o', 'nc_util.o', 'nvme_util.o'],
    deps = ['//lib/libcam:headers', '//lib/libnvmf:headers', '//lib/libutil:headers', '//sbin/nvmecontrol:headers'], archives = ['//lib/libnvmf:static_archive', '//lib/libnv:static_archive'])
