# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = "pflogd", srcs = ["pflogd_5bsd.c", "pflogd_5bsd.h", "//contrib/openbsd-pf/sbin/pflogd:pflogd.c", "//contrib/openbsd-pf/sbin/pflogd:privsep.c", "//contrib/openbsd-pf/sbin/pflogd:privsep_fdpass.c"],
    deps = ["//lib/libpcap:pcap", "//lib/libpcap:config_header", "//contrib/libpcap:headers", "//contrib/openbsd-pf/sbin/pflogd:headers", "//sys/netpfil/openbsd-pf/user:util_headers"],
    dynamic_deps = ["//lib/libpcap:pcap_shared"],
    copts = ["-fPIE", "-include", "$(location pflogd_5bsd.h)", "-include", "config.h"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "pflogd", manual = "//contrib/openbsd-pf/sbin/pflogd:pflogd.8",
    package = "pf", bindir = "/sbin", man_section = "8")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "program_install_archive", visibility = ["//sbin:__pkg__"], manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=pf","dbg"]}'
        for d in ["/usr/lib/debug/sbin"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])
