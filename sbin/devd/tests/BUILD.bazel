# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
# Requires a live devd and creates md devices; execution belongs in a VM.
cc_binary(
    name = "client_test",
    srcs = ["client_test.c"],
    deps = ["//lib/atf/libatf-c:atf_c"],
    dynamic_deps = ["//lib/atf/libatf-c:atf_c_shared"],
    copts = ["-fPIE"],
    linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
)
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
utility_installation(name = "install_manifest", program = "client_test", manual = "", package = "tests", bindir = "/usr/tests/sbin/devd")
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["client_test"], interfaces = {"client_test": "atf"},
    metadata = {"client_test": '{"required_files":"/var/run/devd.pid","required_programs":"devd","required_user":"root","timeout":15}'})
bsd_install_file(name = "kyuafile_file", src = ":kyuafile", destination = "/usr/tests/sbin/devd/Kyuafile", owner = "root", group = "wheel", mode = "0444", install_tags = ["package=tests"])
bsd_install_manifest(name = "install_extra", entries = [":kyuafile_file"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//sbin:__subpackages__"],
    manifests = [":install_manifest", ":install_extra"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/tests", "/usr/lib/debug/usr/tests/sbin"]} | {"/usr/lib/debug/usr/tests/sbin/devd": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests","dbg"]}', "/usr/tests/sbin/devd": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests"]}'},
    mtree_specs = {
        "//etc/mtree:BSD.tests.dist": "/usr/tests",
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

