# NVMe configuration is also consumed by the NVMe package archive.
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest")
bsd_install_file(name = "nvme_config", src = "nvmf.conf", destination = "/etc/devd/nvmf.conf",
    owner = "root", group = "wheel", mode = "0644", install_tags = ["package=nvme-tools", "config"])
bsd_install_manifest(name = "nvme_install_manifest", entries = [":nvme_config"], visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_import")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_header", "bsd_dtrace_cc_objects")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
bsd_dtrace_header(
    name = "provider", source = "devd_provider.d", output = "devd_provider.h",
    flags = ["-C", "-x", "nolibs"], object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:dtrace", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti",
    runtime_libraries = ['//cddl/lib/libdtrace:dtrace_shared', '//cddl/lib/libctf:ctf_shared', '//lib/libelf:elf_shared', '//lib/libproc:proc_shared', '//cddl/lib/libspl:spl_shared', '//lib/libxo/libxo:xo_shared', '//lib/libutil:util_shared', '//lib/libprocstat:procstat_shared', '//lib/librtld_db:rtld_db_shared', '//lib/libcxxrt:cxxrt_shared', '//lib/libz:z_shared', '//lib/libkvm:kvm_shared'],
    tool_inputs = [ "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"], static_anchor = False,
)
cc_library(name = "provider_headers", hdrs = [":provider"], strip_include_prefix = ".")

load("//tools/build/bazel:bsd_lex_yacc.bzl", "bsd_lex", "bsd_yacc")
bsd_yacc(name = "parser", src = "parse.y", output = "parse.c", header = "y.tab.h", report = "parse.output", yacc = "//usr.bin/yacc:yacc")
filegroup(name = "parser_source", srcs = [":parser"], output_group = "source")
filegroup(name = "parser_header", srcs = [":parser"], output_group = "header")
bsd_lex(name = "lexer", src = "token.l", output = "token.c", lex = "//usr.bin/lex:lex", m4 = "//usr.bin/m4:m4")
cc_library(name = "headers", hdrs = ["devd.h", ":parser_header"], strip_include_prefix = ".")

cc_library(name = "objects", srcs = ["devd.cc", "devd.hh", "devd_probes.h", ":parser_source", ":lexer"],
    deps = [":headers", "//lib/libutil:util", "//lib/libc++:cxx", "//lib/libcxxrt:cxxrt", "//lib/msun:m"] + select({_TRACE: [":provider_headers"], "//conditions:default": []}),
    local_defines = select({_TRACE: ["WITH_DTRACE"], "//conditions:default": []}),
    copts = ["-fPIE", "-nostdinc++"], target_compatible_with = _PLATFORM)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider", provider_object = "devd_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group) for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"], deps = [":provider_link"] + [":headers", "//lib/libutil:util", "//lib/libc++:cxx", "//lib/libcxxrt:cxxrt", "//lib/msun:m"])
cc_binary(name = "devd", deps = select({_TRACE: [":traced"], "//conditions:default": [":objects"]}),
    dynamic_deps = ["//lib/libutil:util_shared", "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared"],
    linkopts = ["-pie"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
