# NVMe configuration is also consumed by the NVMe package archive.
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest")
bsd_install_file(name = "nvme_config", src = "nvmf.conf", destination = "/etc/devd/nvmf.conf",
    owner = "root", group = "wheel", mode = "0644", install_tags = ["package=nvme-tools", "config"])
bsd_install_manifest(name = "nvme_install_manifest", entries = [":nvme_config"], visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_import")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_header", "bsd_dtrace_cc_objects")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
bsd_dtrace_header(
    name = "provider", source = "devd_provider.d", output = "devd_provider.h",
    flags = ["-C", "-x", "nolibs"], object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:bootstrap", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti",
    runtime_libraries = ["//cddl/usr.sbin/dtrace:bootstrap_runtime"],
    tool_inputs = [ "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"], static_anchor = False,
)
cc_library(name = "provider_headers", hdrs = [":provider"], strip_include_prefix = ".")

load("//tools/build/bazel:bsd_lex_yacc.bzl", "bsd_lex", "bsd_yacc")
bsd_yacc(name = "parser", src = "parse.y", output = "parse.c", header = "y.tab.h", report = "parse.output", yacc = "//usr.bin/yacc:yacc")
filegroup(name = "parser_source", srcs = [":parser"], output_group = "source")
filegroup(name = "parser_header", srcs = [":parser"], output_group = "header")
bsd_lex(name = "lexer", src = "token.l", output = "token.c", lex = "//usr.bin/lex:lex", m4 = "//usr.bin/m4:m4")
cc_library(name = "headers", hdrs = ["devd.h", ":parser_header"], strip_include_prefix = ".")

cc_library(name = "objects", srcs = ["devd.cc", "devd.hh", "devd_probes.h", ":parser_source", ":lexer"],
    deps = [":headers", "//lib/libutil:util", "//lib/libc++:cxx", "//lib/libcxxrt:cxxrt", "//lib/msun:m"] + select({_TRACE: [":provider_headers"], "//conditions:default": []}),
    local_defines = select({_TRACE: ["WITH_DTRACE"], "//conditions:default": []}),
    copts = ["-fPIE", "-nostdinc++"], target_compatible_with = _PLATFORM)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider", provider_object = "devd_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group) for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"], deps = [":provider_link"] + [":headers", "//lib/libutil:util", "//lib/libc++:cxx", "//lib/libcxxrt:cxxrt", "//lib/msun:m"])
cc_binary(name = "devd", deps = select({_TRACE: [":traced"], "//conditions:default": [":objects"]}),
    dynamic_deps = ["//lib/libutil:util_shared", "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared"],
    linkopts = ["-pie"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install.bzl", "bsd_compress")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
bsd_compress(name = "config_manual", src = "devd.conf.5", output = "devd.conf.5.gz", arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(name = "config_manual_file", src = ":config_manual", destination = "/usr/share/man/man5/devd.conf.5.gz", owner = "root", group = "wheel", mode = "0444", install_tags = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=devd-man"], "//conditions:default": ["package=devd"]}))
utility_installation(name = "install_manifest", program = "devd", manual = "devd.8", package = "devd", bindir = "/sbin", man_section = "8", extra_entries = [":config_manual_file"])
# Platform matches the executable's currently supported amd64 target.
# power_profile.conf is architecture-selected by Make, independent of MK_ACPI.
_CONFIGS = [
    ("devd.conf", "/etc/devd.conf", "devd", ""),
    ("devmatch.conf", "/etc/devd/devmatch.conf", "devd", ""),
    ("growfs_postboot.conf", "/etc/devd/growfs_postboot.conf", "devd", ""),
    ("dhclient.conf", "/etc/devd/dhclient.conf", "dhclient", ""),
    ("moused.conf", "/etc/devd/moused.conf", "console-tools", ""),
    ("syscons.conf", "/etc/devd/syscons.conf", "console-tools", ""),
    ("power_profile.conf", "/etc/devd/power_profile.conf", "acpi", ""),
    ("asus.conf", "/etc/devd/asus.conf", "devd", "acpi"),
    ("autofs.conf", "/etc/devd/autofs.conf", "autofs", "autofs"),
    ("bluetooth.conf", "/etc/devd/bluetooth.conf", "bluetooth", "bluetooth"),
    ("hyperv.conf", "/etc/devd/hyperv.conf", "hyperv-tools", "hyperv"),
    ("snd.conf", "/etc/devd/snd.conf", "sound", "sound"),
    ("uath.conf", "/etc/devd/uath.conf", "devd", "usb"),
    ("ulpt.conf", "/etc/devd/ulpt.conf", "devd", "usb"),
    ("zfs.conf", "/etc/devd/zfs.conf", "devd", "zfs"),
]
[bsd_install_file(name = "config_" + src, src = src, destination = dest, owner = "root", group = "wheel", mode = "0644", install_tags = ["package=" + pkg, "config"]) for src, dest, pkg, option in _CONFIGS]
_CONFIG_ENTRIES = [":nvme_config"]
_CONFIG_ENTRIES = _CONFIG_ENTRIES + [":config_" + src for src, dest, pkg, option in _CONFIGS if option == '']
_CONFIG_ENTRIES = _CONFIG_ENTRIES + select({"//tools/build/bazel/config:acpi_enabled": [":config_" + src for src, dest, pkg, option in _CONFIGS if option == 'acpi'], "//conditions:default": []})
_CONFIG_ENTRIES = _CONFIG_ENTRIES + select({"//tools/build/bazel/config:autofs_enabled": [":config_" + src for src, dest, pkg, option in _CONFIGS if option == 'autofs'], "//conditions:default": []})
_CONFIG_ENTRIES = _CONFIG_ENTRIES + select({"//tools/build/bazel/config:bluetooth_enabled": [":config_" + src for src, dest, pkg, option in _CONFIGS if option == 'bluetooth'], "//conditions:default": []})
_CONFIG_ENTRIES = _CONFIG_ENTRIES + select({"//tools/build/bazel/config:hyperv_enabled": [":config_" + src for src, dest, pkg, option in _CONFIGS if option == 'hyperv'], "//conditions:default": []})
_CONFIG_ENTRIES = _CONFIG_ENTRIES + select({"//tools/build/bazel/config:sound_enabled": [":config_" + src for src, dest, pkg, option in _CONFIGS if option == 'sound'], "//conditions:default": []})
_CONFIG_ENTRIES = _CONFIG_ENTRIES + select({"//tools/build/bazel/config:usb_enabled": [":config_" + src for src, dest, pkg, option in _CONFIGS if option == 'usb'], "//conditions:default": []})
_CONFIG_ENTRIES = _CONFIG_ENTRIES + select({"//tools/build/bazel/config:zfs_enabled": [":config_" + src for src, dest, pkg, option in _CONFIGS if option == 'zfs'], "//conditions:default": []})
bsd_install_manifest(name = "config_manifest", entries = _CONFIG_ENTRIES)
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//sbin:__pkg__"],
    target_compatible_with = _PLATFORM,
    manifests = [":install_manifest", ":config_manifest"],
    directories = {"/usr/lib/debug/sbin": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=devd","dbg"]}'} | {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities"]}' for d in ["/etc", "/etc/devd"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
