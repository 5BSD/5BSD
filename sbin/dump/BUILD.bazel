load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
_SOURCES = ['itime.c', 'main.c', 'optr.c', 'dumprmt.c', 'tape.c', 'traverse.c', 'unctime.c', 'cache.c', 'dump.h', 'pathnames.h']
cc_binary(name = "dump", srcs = _SOURCES,
    deps = ["//lib/libufs:ufs"],
    dynamic_deps = ["//lib/libufs:ufs_shared"], local_defines = ["RDUMP"],
    copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "dump", manual = "dump.8",
    package = "ufs", bindir = "/sbin", man_section = "8", aliases = ["rdump"], extra_entries = [":dumpdates_install"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "program_install_archive", visibility = ["//sbin:__pkg__"], manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=ufs","dbg"]}'
        for d in ["/usr/lib/debug/sbin"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])

cc_library(name = "remote_headers", hdrs = ["dump.h", "pathnames.h"], strip_include_prefix = ".", visibility = ["//sbin/restore:__pkg__"])
exports_files(["dumprmt.c"], visibility = ["//sbin/restore:__pkg__"])
load("@bazel_skylib//rules:write_file.bzl", "write_file")
# Make installs an empty /dev/null payload as a package configuration file.
write_file(name = "dumpdates", out = "dumpdates.empty", content = [])
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file")
bsd_install_file(name = "dumpdates_install", src = ":dumpdates", destination = "/etc/dumpdates", owner = "root", group = "operator", mode = "0664", install_tags = ["package=ufs", "config"])

load("//tools/build/bazel:bsd_rescue_application.bzl", "rescue_application")
rescue_application(srcs = _SOURCES,
    object_names = ['itime.o', 'main.o', 'optr.o', 'dumprmt.o', 'tape.o', 'traverse.o', 'unctime.o', 'cache.o'], deps = ['//lib/libufs:headers'], warns = 2, defines = ['RDUMP'])
