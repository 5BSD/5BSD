# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = "ddb", srcs = ["ddb.c", "ddb_capture.c", "ddb_script.c", "ddb.h"],
    deps = ["//lib/libkvm:kvm"], dynamic_deps = ["//lib/libkvm:kvm_shared"],
    copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "ddb", manual = "ddb.8",
    package = "runtime", bindir = "/sbin", man_section = "8", extra_entries = [":configuration"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "program_install_archive", visibility = ["//sbin:__pkg__"], manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime","dbg"]}'
        for d in ["/usr/lib/debug/sbin"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file")
bsd_install_file(name = "configuration", src = "ddb.conf", destination = "/etc/ddb.conf", owner = "root", group = "wheel", mode = "0644", install_tags = ["package=runtime", "config"])
