load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = "hastctl", srcs = ['hastctl.c', '//sbin/hastd:activemap.c', '//sbin/hastd:ebuf.c', '//sbin/hastd:hast_checksum.c', '//sbin/hastd:hast_compression.c', '//sbin/hastd:hast_proto.c', '//sbin/hastd:lzf.c', '//sbin/hastd:metadata.c', '//sbin/hastd:nv.c', '//sbin/hastd:pjdlog.c', '//sbin/hastd:proto.c', '//sbin/hastd:proto_common.c', '//sbin/hastd:proto_uds.c', '//sbin/hastd:subr.c', '//sbin/hastd:parser_source', '//sbin/hastd:lexer'],
    deps = ['//lib/libmd:md_link', '//lib/libutil:util', '//lib/libz:z'] + ["//sbin/hastd:headers"], dynamic_deps = ['//lib/libmd:md_shared', '//lib/libutil:util_shared', '//lib/libz:z_shared'],
    local_defines = ['HAVE_CAPSICUM', 'INET', 'YY_NO_UNPUT', 'YY_NO_INPUT'] + select({"//tools/build/bazel/config:inet6_support_enabled": ["INET6"], "//conditions:default": []}),
    copts = ["-fPIE"], linkopts = ["-pie"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "hastctl", manual = "hastctl.8",
    package = "hast", bindir = "/sbin", man_section = "8")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "program_install_archive", manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=hast","dbg"]}'
        for d in ["/usr/lib/debug/sbin"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])
