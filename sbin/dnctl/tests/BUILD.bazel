load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
cc_binary(name = "flow_abi_test", srcs = ["flow_abi_test.c"], deps = ["//lib/atf/libatf-c:atf_c"],
    dynamic_deps = ["//lib/atf/libatf-c:atf_c_shared"], copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
bsd_atf_test(name = "native_flow_layout", case_name = "flow_layout", interface = "program", body = ":flow_abi_test",
    runtime_lib = ["//lib/atf/libatf-c:atf_c_shared", "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"], runner = "//tools/build/bazel:atf_runner", size = "small")
_CASES = ["syntax", "rejects", "config_file"]
# Maintained shell cases use -n; do_cmd returns before creating a control socket.
[bsd_atf_test(name = "native_" + case, case_name = case, body = "dnctl_test.sh",
    subr = "//libexec/atf/atf-sh:shell_library",
    runtime_bin = ["//bin/sh:sh", "//libexec/atf/atf-sh:atf-sh", "//libexec/atf/atf-check:atf-check", "//sbin/dnctl:dnctl", "//bin/cat:cat", "//usr.bin/dirname:dirname"],
    runtime_lib = ["//lib/atf/libatf-c:atf_c_shared", "//lib/atf/libatf-c++:atf_cxx_shared", "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared", "//lib/libedit:edit_shared", "//lib/ncurses/tinfo:tinfo_shared", "//lib/libutil:util_shared", "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7", "@bsd_sdk//toolchain:sysroot/lib/libgcc_s.so.1"],
    runner = "//tools/build/bazel:atf_runner", size = "small") for case in _CASES]
test_suite(name = "tests", tests = [":native_flow_layout"] + [":native_" + case for case in _CASES], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_script_wrapper")
bsd_script_wrapper(name = "dnctl_test", body = "dnctl_test.sh", interpreter = "/usr/libexec/atf-sh", cat = "@bsd_sdk//toolchain:cat", cat_runtime = ["@bsd_sdk//toolchain:cat_runtime"], redirect = "@bsd_sdk//toolchain:stdout_redirect")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
utility_installation(name = "install_test", program = "flow_abi_test", manual = "", package = "tests", bindir = "/usr/tests/sbin/dnctl")
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["dnctl_test", "flow_abi_test"], interfaces = {"dnctl_test": "atf", "flow_abi_test": "atf"})
bsd_install_file(name = "install_kyuafile", src = ":kyuafile", destination = "/usr/tests/sbin/dnctl/Kyuafile", owner = "root", group = "wheel", mode = "0444", install_tags = ["package=tests"])
bsd_install_manifest(name = "install_extra", entries = [":install_kyuafile", ":install_shell"], visibility = ["//sbin/dnctl:__pkg__"])

bsd_install_file(name = "install_shell", src = ":dnctl_test", destination = "/usr/tests/sbin/dnctl/dnctl_test", owner = "root", group = "wheel", mode = "0555", install_tags = ["package=tests"])
