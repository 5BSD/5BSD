load(":crypto_sources_amd64.bzl", "AMD64_CRYPTO_SOURCES", "AMD64_ASM_SOURCES")
exports_files([label.split(":", 1)[1] for label in AMD64_CRYPTO_SOURCES + AMD64_ASM_SOURCES if label.startswith("//crypto/openssl:")],
    visibility = ["//secure/lib/libcrypto:__subpackages__", "//secure/lib/libssl:__pkg__", "//secure/usr.bin/openssl:__pkg__"])

load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "headers", hdrs = glob(["include/openssl/*.h"]),
    includes = ["include"], visibility = ["//visibility:public"])
cc_library(name = "internal_headers",
    hdrs = glob(["crypto/**/*.h", "providers/**/*.h", "include/internal/**/*.h", "include/crypto/**/*.h"]),
    textual_hdrs = glob(["providers/**/*.inc", "crypto/LPdir_*.c"]) + [
        "crypto/des/ncbc_enc.c", "providers/implementations/macs/blake2_mac_impl.c"],
    includes = [".", "providers/common/include", "providers/fips/include",
        "providers/implementations/include", "crypto", "crypto/ec/curve448",
        "crypto/ec/curve448/arch_32", "crypto/modes"],
    visibility = ["//secure/lib/libcrypto:__subpackages__", "//secure/lib/libssl:__pkg__", "//secure/usr.bin/openssl:__pkg__"])

load(":module_sources_amd64.bzl", "MODULE_SOURCES")
exports_files(depset([label.split(":", 1)[1] for group in MODULE_SOURCES.values() for label in group
    if label.startswith("//crypto/openssl:") and label not in AMD64_CRYPTO_SOURCES + AMD64_ASM_SOURCES]).to_list(),
    visibility = ["//secure/lib/libcrypto:__subpackages__", "//secure/lib/libssl:__pkg__", "//secure/usr.bin/openssl:__pkg__"])
cc_library(name = "engine_headers", hdrs = glob(["engines/*.h"]),
    textual_hdrs = glob(["engines/*_err.c"]) + ["crypto/aes/aes_core.c"], includes = ["engines"],
    visibility = ["//secure/lib/libcrypto/engines:__pkg__"])

load(":ssl_cli_sources.bzl", "SSL_SOURCES", "CLI_SOURCES")
_PREVIOUS_SOURCES = AMD64_CRYPTO_SOURCES + AMD64_ASM_SOURCES + [label for group in MODULE_SOURCES.values() for label in group]
exports_files(depset([label.split(":", 1)[1] for label in SSL_SOURCES + CLI_SOURCES
    if label not in _PREVIOUS_SOURCES]).to_list(),
    visibility = ["//secure/lib/libssl:__pkg__", "//secure/usr.bin/openssl:__pkg__"])
cc_library(name = "ssl_headers", hdrs = glob(["ssl/**/*.h"]), includes = ["ssl"],
    visibility = ["//secure/lib/libssl:__pkg__"])
cc_library(name = "app_headers", hdrs = glob(["apps/**/*.h"]), includes = ["apps/include"],
    visibility = ["//secure/usr.bin/openssl:__pkg__"])

load(":install_headers.bzl", "INSTALL_HEADERS")
exports_files([label.split(":", 1)[1] for _, label in INSTALL_HEADERS] +
    ["exporters/libcrypto.pc", "exporters/libssl.pc", "exporters/openssl.pc"],
    visibility = ["//secure/lib/libcrypto:__pkg__", "//secure/lib/libssl:__pkg__"])

exports_files(["apps/openssl.cnf"], visibility = ["//secure/usr.bin/openssl:__pkg__"])

# Core cross-architecture additions; preserve existing module/SSL/CLI exports.
exports_files([
    "crypto/armcap.c",
    "crypto/camellia/camellia.c",
    "crypto/camellia/cmll_cbc.c",
    "crypto/chacha/chacha_enc.c",
    "crypto/rc4/rc4_enc.c",
    "crypto/rc4/rc4_skey.c",
    "crypto/whrlpool/wp_block.c"
],
    visibility = ["//secure/lib/libcrypto:__pkg__"])

load(":crypto_sources_selected.bzl", "CORE_HEADER_FILES", "CORE_TEXTUAL_FILES")
# Exact union of original core consumed source headers/textual fragments.
# Include search roots are the original ordered -I flags on the core objects;
# this declaration adds no system/include roots or public-header propagation.
cc_library(name = "core_compilation_headers", hdrs = CORE_HEADER_FILES,
    textual_hdrs = CORE_TEXTUAL_FILES, visibility = ["//secure/lib/libcrypto:__pkg__"])
