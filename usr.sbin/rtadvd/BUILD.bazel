load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
cc_library(name = "client_headers", hdrs = ["pathnames.h", "rtadvd.h", "if.h", "control.h", "control_client.h", "timer.h", "timer_subr.h"], strip_include_prefix = ".", visibility = ["//usr.sbin/rtadvctl:__pkg__"])
cc_library(name = "headers", hdrs = ["advcap.h", "config.h", "control_server.h", "rrenum.h"], strip_include_prefix = ".", deps = [":client_headers"])
exports_files(["control.c", "control_client.c", "if.c", "timer_subr.c"], visibility = ["//usr.sbin/rtadvctl:__pkg__"])
cc_binary(name = "rtadvd", srcs = ['rtadvd.c', 'rrenum.c', 'advcap.c', 'if.c', 'config.c', 'timer.c', 'timer_subr.c', 'control.c', 'control_server.c'], deps = ['//lib/libutil:util', ':headers'], dynamic_deps = ['//lib/libutil:util_shared'], copts = ["-fPIE"], linkopts = ["-pie"], linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_install.bzl", "bsd_compress", "bsd_install_file")
bsd_compress(name = "manual5", src = "rtadvd.conf.5", output = "rtadvd.conf.5.gz", arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(manual = True, name = "install_manual5", src = ":manual5", destination = "/usr/share/man/man5/rtadvd.conf.5.gz", owner = "root", group = "wheel", mode = "0444", install_tags = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=utilities-man"], "//conditions:default": ["package=utilities"]}))
utility_installation(name = "install_manifest", program = "rtadvd", manual = "rtadvd.8", package = "utilities", bindir = "/usr/sbin", man_section = "8", aliases = [], extra_entries = [":install_manual5"])
bsd_install_archive(name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
