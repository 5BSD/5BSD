activation { boot = true; ipc = ["system.Trace"]; }
program = "Trace";
# Born in capability mode: serviced delivers /dev as a directory descriptor so
# the provider opens /dev/dtrace with openat(2), never a global path.
directories = ["/dev"];
restart = "on-failure";
user = "root";

limits { nofile = 1024; nproc = 64; core = 0; }
umask = "0077";
