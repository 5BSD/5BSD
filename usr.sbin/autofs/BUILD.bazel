bsd_compress(name = "automount_manual_gz", src = "automount.8", output = "automount.8.gz", arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(manual = True, name = "automount_manual", src = ":automount_manual_gz", destination = "/usr/share/man/man8/automount.8.gz", owner = "root", group = "wheel", mode = "0444", install_tags = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=autofs-man"], "//conditions:default": ["package=autofs"]}))
