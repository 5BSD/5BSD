# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load(":generation.bzl", "snmp_tree")
snmp_tree(name = "generated", source = "//contrib/bsnmp/snmpd:tree.def", includes = ["//contrib/bsnmp/lib:tc.def"],
    symbols = ["snmpMIB", "begemotSnmpdModuleTable", "begemotSnmpd", "begemotTrapSinkTable", "sysUpTime", "snmpTrapOID", "coldStart", "authenticationFailure", "begemotSnmpdTransUdp", "begemotSnmpdTransLsock", "begemotSnmpdLocalPortTable", "freeBSD", "freeBSDVersion", "begemotSnmpdTransInet"],
    generator = "//usr.sbin/bsnmpd/gensnmptree:gensnmptree", driver = "generate.py",
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib"])
filegroup(name = "tree_source", srcs = [":generated"], output_group = "source")
filegroup(name = "tree_headers", srcs = [":generated"], output_group = "headers")
cc_library(name = "generated_headers", hdrs = [":tree_headers"], strip_include_prefix = "generated")
_WRAP = "//tools/build/bazel/config:tcp_wrappers_enabled"
cc_binary(name = "bsnmpd", srcs = [":tree_source"] + ["//contrib/bsnmp/snmpd:" + source for source in ["main.c", "action.c", "config.c", "export.c", "trap.c", "trans_lsock.c", "trans_inet.c"]],
    deps = [":generated_headers", "//contrib/bsnmp/snmpd:headers", "//lib/libbegemot:begemot", "//lib/libbsnmp/libbsnmp:bsnmp"] + select({_WRAP: ["//lib/libwrap:wrap"], "//conditions:default": []}),
    dynamic_deps = ["//lib/libbegemot:begemot_shared", "//lib/libbsnmp/libbsnmp:bsnmp_shared"] + select({_WRAP: ["//lib/libwrap:wrap_shared"], "//conditions:default": []}),
    local_defines = ["USE_LIBBEGEMOT", "HAVE_STDINT_H", "HAVE_INTTYPES_H", "HAVE_ERR_H", "HAVE_STRLCPY"] + select({"//tools/build/bazel/config:openssl_enabled": ["HAVE_LIBCRYPTO"], "//conditions:default": []}) + select({_WRAP: ["USE_TCPWRAPPERS"], "//conditions:default": []}),
    copts = ["-fPIE"], linkopts = ["-pie", "-Wl,-export-dynamic"], linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])

load(":installation.bzl", "daemon_installation")
daemon_installation()
