load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
cc_binary(name = "blacklistd", srcs = ["//contrib/blocklist:bin/blacklistd.c", "//contrib/blocklist:bin/conf.c", "//contrib/blocklist:bin/run.c", "//contrib/blocklist:bin/state.c", "//contrib/blocklist:bin/support.c", "//contrib/blocklist:bin/old_internal.c", "//contrib/blocklist:port/sockaddr_snprintf.c", "//contrib/blocklist:port/pidfile.c", "//contrib/blocklist:port/strtoi.c", "//contrib/blocklist:port/popenve.c", "//contrib/blocklist:port/vsyslog_r.c"],
    deps = ["//contrib/blocklist:program_headers", "//lib/libblocklist:blocklist", "//lib/libutil:util"],
    dynamic_deps = ["//lib/libblocklist:blocklist_shared", "//lib/libutil:util_shared"],
    local_defines = ["_PATH_BLCONTROL=\\\"/usr/libexec/blacklistd-helper\\\"", "_PATH_BLCONF=\\\"/etc/blacklistd.conf\\\"", "HAVE_CONFIG_H", "HAVE_DB_H", "HAVE_LIBUTIL_H", "HAVE_CLOCK_GETTIME", "HAVE_FGETLN", "HAVE_FPARSELN", "HAVE_GETPROGNAME", "HAVE_STRLCAT", "HAVE_STRLCPY", "HAVE_STRUCT_SOCKADDR_SA_LEN", "HAVE_SYS_CDEFS_H"], copts = ["-fPIE"], linkopts = ["-pie"], linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_compress")
bsd_install_file(name = "configuration", src = "blacklistd.conf", destination = "/etc/blacklistd.conf", owner = "root", group = "wheel", mode = "0644", install_tags = ["package=blocklist", "config"])
bsd_compress(name = "config_manual_gz", src = "//contrib/blocklist:bin/blacklistd.conf.5", output = "blacklistd.conf.5.gz", arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(name = "config_manual", src = ":config_manual_gz", destination = "/usr/share/man/man5/blacklistd.conf.5.gz", owner = "root", group = "wheel", mode = "0444", install_tags = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=blocklist-man"], "//conditions:default": ["package=blocklist"]}))
utility_installation(name = "install_manifest", program = "blacklistd", manual = "//contrib/blocklist:bin/blacklistd.8", package = "blocklist", bindir = "/usr/sbin", man_section = "8", extra_entries = [":configuration", ":config_manual"])
bsd_install_archive(name = "install_archive",
    manifests = [":install_manifest"],
    directories = {"/etc": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities"]}'} | {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=blocklist","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
