load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_script_wrapper")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
bsd_script_wrapper(name = "certctl_test", body = "certctl_test.sh",
    interpreter = "/usr/libexec/atf-sh", cat = "@bsd_sdk//toolchain:cat",
    cat_runtime = ["@bsd_sdk//toolchain:cat_runtime"], redirect = "@bsd_sdk//toolchain:stdout_redirect")
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["certctl_test"], interfaces = {"certctl_test": "atf"})
bsd_install_file(name = "install_shell", src = ":certctl_test",
    destination = "/usr/tests/usr.sbin/certctl/certctl_test", owner = "root", group = "wheel",
    mode = "0555", install_tags = ["package=tests"])
bsd_install_file(name = "install_kyuafile", src = ":kyuafile",
    destination = "/usr/tests/usr.sbin/certctl/Kyuafile", owner = "root", group = "wheel",
    mode = "0444", install_tags = ["package=tests"])
[bsd_install_file(name = name, src = file, destination = "/usr/tests/usr.sbin/certctl/" + file,
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=tests"])
 for name, file in [("install_subr", "certctl.subr"), ("install_failures", "failure_test.py")]]
bsd_install_manifest(name = "install_manifest", entries = [":install_shell", ":install_kyuafile", ":install_subr", ":install_failures"], visibility = ["//visibility:public"])
