load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
load("//tools/build/bazel:bsd_script_output.bzl", "bsd_script_output")
bsd_script_output(name = "skeleton", script = "mkskel.sh", src = "crunched_main.c", input_mode = "argument", output = "crunched_skel.c", shell_flags = ["-e"],
    shell = "@bsd_sdk//toolchain:sh", path_tools = {"@bsd_sdk//toolchain:cat": "cat", "@bsd_sdk//toolchain:sed": "sed"},
    runtime = ["@bsd_sdk//toolchain:sh_runtime", "@bsd_sdk//toolchain:cat_runtime", "@bsd_sdk//toolchain:sed_runtime"], redirect = "@bsd_sdk//toolchain:stdout_redirect")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_selected_objects")
cc_library(name = "objects", srcs = ["crunchgen.c", ":skeleton"], local_defines = ["PIC"],
    copts = ['-pipe', '-fno-common', '-std=gnu17', '-Wno-format-zero-length', '-Wsystem-headers', '-Werror', '-Wall', '-Wno-format-y2k', '-W', '-Wno-unused-parameter', '-Wstrict-prototypes', '-Wmissing-prototypes', '-Wpointer-arith', '-Wreturn-type', '-Wcast-qual', '-Wwrite-strings', '-Wswitch', '-Wshadow', '-Wunused-parameter', '-Wcast-align', '-Wchar-subscripts', '-Wnested-externs', '-Wold-style-definition', '-Wno-pointer-sign', '-Wdate-time', '-Wmissing-variable-declarations', '-Wthread-safety', '-Wno-empty-body', '-Wno-string-plus-int', '-Wno-unused-const-variable', '-Wno-error=unused-but-set-parameter', '-Wno-error=cast-function-type-mismatch', '-Qunused-arguments', '-fPIE'],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
bsd_component_selected_objects(name = "compiler_outputs", group = ":objects", pic = False,
    object_names = ["crunchgen.o", "crunched_skel.o"], visibility = ["//visibility:public"])
cc_binary(name = "crunchgen", srcs = [":compiler_outputs"], linkopts = ["-pie"], linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
utility_installation(name = "install_manifest", program = "crunchgen", manual = "crunchgen.1", package = "toolchain", bindir = "/usr/bin", man_section = "1", aliases = [], extra_entries = [])
bsd_install_archive(name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=toolchain","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/bin"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
