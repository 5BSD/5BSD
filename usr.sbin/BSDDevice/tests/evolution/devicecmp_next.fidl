// SPDX-License-Identifier: BSD-2-Clause
// Schema-evolution fixture for system.Device.  At bsd:1 this is exactly
// lib/libdevicecmp/devicecmp.fidl (tools/build/fuchsia/test-bindings.py checks
// it); bsd:2 adds a method, as a future provider release would.  The peer
// built from bsd:2 is paired with the real bsd:1 client and provider.
@available(platform="bsd", added=1)
library bsd.device.v1;

using zx;

type ProtocolInfo = struct { wire_version uint32; };
// A single /dev leaf: no '/', no leading '.', no NUL; at most 255 bytes.
alias DeviceName = string:255;
// Rights are a DEVICECMP_RIGHT_* mask (READ 0x1, WRITE 0x2, IOCTL 0x4,
// MMAP 0x8, SEEK 0x10, EVENT 0x20).  The provider intersects the request with
// the policy maximum; unknown bits are never granted.
type OpenRequest = struct {
    name DeviceName;
    rights uint32;
};
// The delivered descriptor keeps exactly the narrowed Capsicum rights (and
// ioctl whitelist) the provider applied; it may be transferred no further.
type Opened = resource struct {
    device zx.Handle;
    rights uint32;
};
type ListRequest = struct { cursor uint32; };
type DeviceEntry = struct {
    name DeviceName;
    // Policy-maximum rights for this label and device.
    rights uint32;
    // 0x1: a per-device ioctl whitelist narrows a delivered IOCTL right.
    flags uint32;
};
type DevicePage = struct {
    entries vector<DeviceEntry>:32;
    // 0 on the final page; otherwise the cursor for the next List.
    next_cursor uint32;
};
closed protocol Device {
    strict GetProtocolInfo() -> (ProtocolInfo);
    // Errors are errno values (EACCES: not granted; EINVAL: bad name).
    strict Open(OpenRequest) -> (Opened) error uint32;
    strict List(ListRequest) -> (DevicePage) error uint32;
    // Added in the next revision; unknown to wire-major-1 peers.
    @available(added=2)
    strict Probe() -> (ProtocolInfo);
};
