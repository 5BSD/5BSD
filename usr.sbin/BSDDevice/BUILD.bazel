# Sources shipped with the libservice worker-authority contract test.
exports_files(['bsddevice.c'], visibility = ["//usr.sbin/BSDDevice/tests:__pkg__", "//lib/libservice/tests:__pkg__"])

# Source fixtures shipped with Switchboard contract tests.
exports_files(['capbundle/device.ucl'], visibility = ["//usr.sbin/switchboard/tests:__pkg__"])

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_import")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_header", "bsd_dtrace_cc_objects")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
bsd_dtrace_header(
    name = "provider", source = "bsddevice_provider.d", output = "bsddevice_provider.h",
    flags = ["-C", "-x", "nolibs"], object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:bootstrap", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti",
    runtime_libraries = ["//cddl/usr.sbin/dtrace:bootstrap_runtime"],
    tool_inputs = [ "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"], static_anchor = False,
)
cc_library(name = "provider_headers", hdrs = [":provider"], strip_include_prefix = ".")

cc_library(name = "objects", srcs = ["bsddevice.c", "policy.c", "policy.h", "bsddevice_probes.h", "trace_pressure.h", "bsddevice_test.h"],
    deps = ['//lib/libchannel:channel', '//lib/libdevicecmp:devicecmp', '//lib/libservice:service', '//lib/libucl:ucl', '//lib/libfidl:fidl', '//lib/libdevicecmp:generated_headers'] + select({_TRACE: [":provider_headers"], "//conditions:default": []}),
    local_defines = select({_TRACE: ["WITH_DTRACE"], "//conditions:default": []}),
    copts = ["-fPIE"], target_compatible_with = _PLATFORM)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider", provider_object = "bsddevice_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group) for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"], deps = [":provider_link"] + ['//lib/libchannel:channel', '//lib/libdevicecmp:devicecmp', '//lib/libservice:service', '//lib/libucl:ucl', '//lib/libfidl:fidl', '//lib/libdevicecmp:generated_headers'])
load("//tools/build/bazel:bsd_capimage.bzl", "bsd_capimage_policy")
bsd_capimage_policy(name = "policy_assembly", src = "capbundle/device.ucl")
cc_binary(name = "BSDDevice", srcs = [":policy_assembly"], deps = select({_TRACE: [":traced"], "//conditions:default": [":objects"]}),
    dynamic_deps = ['//lib/libchannel:channel_shared', '//lib/libdevicecmp:devicecmp_shared', '//lib/libservice:service_shared', '//lib/libucl:ucl_shared', '//lib/libfidl:fidl_shared'],
    linkopts = ["-pie", "-Wl,-z,now"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
_BUNDLE = "/Capabilities/System/Device.cap"
_UNIT = _BUNDLE + "/Units/bsddevice.unit"
utility_installation(name = "program_install", keep_sections = [".5bsd.policy"], program = "BSDDevice", manual = "BSDDevice.8",
    package = "bsddevice", bindir = _UNIT + "/bin", man_section = "8")
[bsd_install_file(name = name, src = src, destination = dest, owner = "root", group = "wheel",
    mode = mode, install_tags = tags)
 for name, src, dest, mode, tags in [
    ("bundle_install", "capbundle/Bundle.ucl", _BUNDLE + "/Bundle.ucl", "0444", ["package=bsddevice"]),
    ("unit_install", "capbundle/device.ucl", _UNIT + "/Unit.ucl", "0444", ["package=bsddevice"]),
    ("config_install", "capbundle/device.conf", _UNIT + "/Config/device.conf", "0644", ["package=bsddevice", "config"]),
 ]]
bsd_install_manifest(name = "bundle_install_manifest", entries = [":bundle_install", ":unit_install", ":config_install"])
bsd_install_archive(name = "daemon_install_archive",
    manifests = [":program_install", ":bundle_install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bsddevice"]}'
        for d in [_BUNDLE, _BUNDLE + "/Units", _UNIT, _UNIT + "/bin", _UNIT + "/Config"]} |
        {"/usr/lib/debug" + d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bsddevice","dbg"]}'
         for d in ["/Capabilities", "/Capabilities/System", _BUNDLE, _BUNDLE + "/Units", _UNIT, _UNIT + "/bin"]},
    mtree_specs = {"//etc/mtree:BSD.tests.dist": "/usr/tests", "//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])


exports_files(["policy.c", "capbundle/device.conf"], visibility = ["//usr.sbin/BSDDevice/tests:__pkg__"])
cc_library(name = "policy_headers", hdrs = ["policy.h"], strip_include_prefix = ".",
    deps = ["//lib/libdevicecmp:headers"], visibility = ["//usr.sbin/BSDDevice/tests:__pkg__"])

cc_library(name = "test_headers", hdrs = ["bsddevice_test.h", "bsddevice_probes.h", "trace_pressure.h"],
    textual_hdrs = ["bsddevice.c"], strip_include_prefix = ".", deps = [":policy_headers"],
    visibility = ["//usr.sbin/BSDDevice/tests:__pkg__"])

load("//usr.sbin/BSDDevice/tests:installation.bzl", TEST_MANIFESTS = "MANIFESTS", TEST_DIRECTORIES = "DIRECTORIES")
bsd_install_archive(name = "install_archive",
    manifests = [":program_install", ":bundle_install_manifest"] + select({"//tools/build/bazel/config:tests_enabled": TEST_MANIFESTS, "//conditions:default": []}),
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bsddevice"]}'
        for d in [_BUNDLE, _BUNDLE + "/Units", _UNIT, _UNIT + "/bin", _UNIT + "/Config"]} |
        {"/usr/lib/debug" + d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bsddevice","dbg"]}'
         for d in ["/Capabilities", "/Capabilities/System", _BUNDLE, _BUNDLE + "/Units", _UNIT, _UNIT + "/bin"]} | select({"//tools/build/bazel/config:tests_enabled": TEST_DIRECTORIES, "//conditions:default": {}}),
    mtree_specs = {"//etc/mtree:BSD.tests.dist": "/usr/tests", "//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])
