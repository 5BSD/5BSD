load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_script_wrapper")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
bsd_script_wrapper(name = "sysconf_test", body = "sysconf_test.sh", interpreter = "/usr/libexec/atf-sh", cat = "@bsd_sdk//toolchain:cat", cat_runtime = ["@bsd_sdk//toolchain:cat_runtime"], redirect = "@bsd_sdk//toolchain:stdout_redirect")
bsd_install_file(name = "install_shell", src = ":sysconf_test", destination = "/usr/tests/usr.sbin/sysconf/sysconf_test", owner = "root", group = "wheel", mode = "0555", install_tags = ["package=tests"])
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["sysconf_test"], interfaces = {"sysconf_test": "atf"})
bsd_install_file(name = "install_kyuafile", src = ":kyuafile", destination = "/usr/tests/usr.sbin/sysconf/Kyuafile", owner = "root", group = "wheel", mode = "0444", install_tags = ["package=tests"])
bsd_install_manifest(name = "install_manifest", entries = [":install_shell", ":install_kyuafile"], visibility = ["//visibility:public"])
