load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
cc_library(name = "headers", hdrs = ["sysconf_priv.h"], strip_include_prefix = ".", deps = ["//lib/libbsdconf:headers"])
cc_binary(name = "sysconf", srcs = ["sysconf.c", "sysconf_edit_assign.c", "sysconf_edit_make.c", "sysconf_edit_write.c", "sysconf_print.c", "sysconf_query_desc.c", "sysconf_query_sysctl.c", "sysconf_query_value.c", "sysconf_resolve.c", "sysconf_scan.c"], deps = [":headers", "//lib/libbsdconf:bsdconf", "//lib/libjail:jail"], dynamic_deps = ["//lib/libbsdconf:bsdconf_shared", "//lib/libjail:jail_shared"], copts = ["-fPIE"], linkopts = ["-pie"], linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_compress")
_MANUALS = ["sysconf-generic", "sysconf-loader", "sysconf-make", "sysconf-rc", "sysconf-src", "sysconf-sysctl", "sysconf-targets"]
[bsd_compress(name = n + "_compressed", src = n + ".8", output = n + ".8.gz", arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"]) for n in _MANUALS]
[bsd_install_file(name = n + "_manual", src = ":" + n + "_compressed", destination = "/usr/share/man/man8/" + n + ".8.gz", owner = "root", group = "wheel", mode = "0444", install_tags = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=utilities-man"], "//conditions:default": ["package=utilities"]})) for n in _MANUALS]
utility_installation(name = "install_manifest", program = "sysconf", manual = "sysconf.8", package = "utilities", bindir = "/usr/sbin", man_section = "8", aliases = [], extra_entries = [":" + n + "_manual" for n in _MANUALS])
bsd_install_archive(name = "install_archive",
    manifests = [":install_manifest"] + select({"//tools/build/bazel/config:tests_enabled": ["//usr.sbin/sysconf/tests:install_manifest"], "//conditions:default": []}),
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]},

    mtree_specs = {"//etc/mtree:BSD.tests.dist": "/usr/tests", "//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
