activation { boot = true; ipc = ["system.Audit"]; }
management = "core";
protect = ["ptrace", "signal", "wait", "sigkill", "sigcont", "sched",
    "core", "ktrace"];
program = "BSDAudit";
restart = "on-failure";
user = "root";

# The broker fans out to many subscribers, so a roomier descriptor ceiling.
limits { nofile = 2048; nproc = 64; core = 0; }
umask = "0077";
