# Complete manifest for a service that implements one interface and consumes
# another service-scoped component.
# The selected providers must implement job lifetime; this is not a claim that
# the initial FileSystemCmp scratch provider implements persistent storage.
schema = "org.5bsd.serviced.service";
schema_version = "1.0.0";
bundle_id = "org.example.indexer";
version = "5.0.0";
author = "Example Storage Team";

program = "indexer";
provides = [
    "org.example.indexer"
];
requires = ["org.5bsd.system.accounting"];
implements = [{
    interface = "org.example.cmp.index";
    version = "2.1.0";
}];
arguments = ["serve", "--no-daemon"];
environment {
    INDEX_FORMAT = "v3";
    METRICS = "enabled";
}
user = "indexer";
group = "indexer";
on_demand = false;
restart = "on-failure";
stop_timeout = 60;
max_failures = 10;

capabilities {
    services = ["accounting", "identity"];
}

components {
    index_store {
        interface = "org.5bsd.cmp.filesystem";
        version = "1.0.0";
        lifetime = "job";
        sharing = "exclusive";
        options {
            namespace = "index";
            durable = true;
            sync = "metadata";
            quota_bytes = 1099511627776;
            snapshots = 8;
        }
    }

    telemetry_network {
        interface = "org.5bsd.cmp.network";
        version = "1.0.0";
        lifetime = "job";
        sharing = "exclusive";
        required = false;
        options {
            outbound_only = true;
            destinations = ["192.0.2.40:4317", "[2001:db8::40]:4317"];
            tcp = true;
            udp = false;
        }
    }
}
