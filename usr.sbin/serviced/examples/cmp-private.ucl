# Complete consumer manifest: one private FileSystemCmp and NetworkCmp.
schema = "org.5bsd.serviced.service";
schema_version = "1.0.0";
bundle_id = "org.example.private-web";
version = "2.3.1";
author = "Example Operations";

program = "private-web";
provides = ["org.example.private-web"];
requires = ["org.5bsd.system.identity"];
arguments = ["--foreground", "--workers=4"];
environment {
    LOG_LEVEL = "info";
    TMP_POLICY = "component";
}
# user/group omitted: pkgbase supplies capability:capability and serviced
# validates and uses that default without editing the account databases.
on_demand = false;
restart = "on-failure";
stop_timeout = 20;
max_failures = 6;

# Direct isolation claims remain explicit and separate from component APIs.
capabilities {
    files = [{
        path = "/etc/ssl/cert.pem";
        actions = ["read", "stat"];
    }];
}

components {
    filesystem {
        interface = "org.5bsd.cmp.filesystem";
        version = "1.0.0";
        # lifetime=process, sharing=exclusive, and required=true are defaults;
        # servicectl verify --effective displays them.
        options {
            max_bytes = 67108864;
            max_objects = 4096;
            max_file_bytes = 16777216;
        }
    }

    network {
        interface = "org.5bsd.cmp.network";
        version = "1.0.0";
        # The base provider currently advertises DNS.  Applications check
        # HELLO feature bits before using future TCP/UDP/ring operations.
        options {}
    }
}
