# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools/build/bazel:bsd_kyua.bzl", "bsd_kyua_test")
# Compile the actual provider with Make's testing wrappers, without DTrace.
[cc_binary(name = name, srcs = [name + ".c", "//usr.sbin/BSDVM:bsdvm.c"],
    deps = ["//usr.sbin/BSDVM:test_headers", "//lib/libcapsulert:vm_protocol_headers",
        "//lib/libvmcmp:vmcmp", "//lib/libvmcmp:generated_headers", "//lib/libservice:service",
        "//lib/libchannel:channel", "//lib/libfidl:fidl", "//lib/libthr:thr", "//lib/atf/libatf-c:atf_c"] + (["//sys/dev/mac_capability:channel_headers", "//sys/dev/mac_capability:ioctl_headers"] if name == "provider_test" else []),
    local_defines = ["VMD_TESTING"], linkstatic = True, linkopts = ["-static"])
 for name in ["registry_test", "provider_test"]]
[bsd_kyua_test(name = name + "_run", program = ":" + name, interface = "atf",
    case_timeout = 120 if name == "provider_test" else 300,
    tags = ["manual", "requires-matching-kernel"] if name == "provider_test" else [],
    suite = "FreeBSD", kyua = "@bsd_sdk//toolchain:extra_kyua", clean_environment = True,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_kyua_runtime"],
    size = "medium", visibility = ["//visibility:public"])
 for name in ["registry_test", "provider_test"]]

[cc_binary(name = name, srcs = [name + ".c"] + (["evolution_test_provider.c"] if name == "evolution_test" else []),
    deps = ["//usr.sbin/BSDVM:test_headers", "//lib/libcapsulert:vm_protocol_headers", "//lib/libvmcmp:vmcmp", "//lib/libvmcmp:generated_headers", "//lib/libservice:service", "//lib/libchannel:channel", "//lib/libfidl:fidl", "//lib/libthr:thr"] + ["//lib/atf/libatf-c:atf_c"] + (["//lib/libvmcmp:client_source_headers"] if name == "evolution_test" else []),
    local_defines = ["VMD_TESTING"], linkstatic = True, linkopts = ["-static"])
 for name in ["lifecycle_test", "serve_test", "evolution_test"]]

load("//tools/build/bazel:bsd_fidl.bzl", "bsd_fidl_ir", "bsd_fidl_bindings")
bsd_fidl_ir(name = "next_ir", schemas = ["//lib/libfidl/tests:zx.fidl", "evolution/vmcmp_next.fidl"], available = "bsd:2",
    compiler = "//tools/build/fuchsia/fidlc:fidlc",
    runtime_libraries = ["//lib/libmd:md_shared", "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared",
        "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7", "@bsd_sdk//toolchain:sysroot/lib/libgcc_s.so.1"])
bsd_fidl_bindings(name = "next_bindings", ir = ":next_ir",
    generator = "//tools/build/fuchsia:fidlgen-build.py", modules = ["//tools/build/fuchsia:binding_modules"],
    templates = ["@fuchsia_runtime_src//:binding_templates"],
    sources = ["fidl/bsd.vm.v1/" + name for name in ["cpp/natural_types.cc", "cpp/common_types.cc", "c/bsd.cc"]],
    headers = ["fidl/bsd.vm.v1/" + name for name in ["cpp/markers.h", "cpp/common_types.h", "cpp/natural_types.h", "cpp/bsd.h", "c/bsd.h", "c/bridge.h"]],
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib"])


filegroup(name = "next_sources", srcs = [":next_bindings"], output_group = "sources")
filegroup(name = "next_header_files", srcs = [":next_bindings"], output_group = "headers")
cc_library(name = "next_headers", hdrs = [":next_header_files"], strip_include_prefix = "next_bindings")
# Make links all three generated objects directly into this standalone peer.
cc_library(name = "next_codec", srcs = [":next_sources"],
    deps = [":next_headers", "//lib/libfidl:headers", "//contrib/llvm-project/libcxx/include:headers"],
    copts = ["-std=c++20", "-nostdinc++"], linkstatic = True, alwayslink = True)
# The newer peer must never inherit the production bsd:1 generated headers.
cc_binary(name = "next_peer", srcs = ["evolution/next_peer.c"],
    deps = [":next_headers", ":next_codec", "//lib/libfidl:fidl", "//lib/libchannel:channel", "//lib/libc++:cxx"],
    linkopts = ["-static"], linkstatic = True)

cc_binary(name = "latency_bench", srcs = ["latency_bench.c", "latency_bench_provider.c"],
    deps = ["//usr.sbin/BSDVM:test_headers", "//lib/libcapsulert:vm_protocol_headers", "//lib/libvmcmp:vmcmp", "//lib/libvmcmp:generated_headers", "//lib/libservice:service", "//lib/libchannel:channel", "//lib/libfidl:fidl", "//lib/libthr:thr"] + ["//lib/libvmcmp:client_source_headers", "//tools/build/fuchsia:daemon_bench_headers"],
    dynamic_deps = ["//lib/libvmcmp:vmcmp_shared", "//lib/libservice:service_shared", "//lib/libchannel:channel_shared", "//lib/libfidl:fidl_shared", "//lib/libthr:thr_shared"],
    local_defines = ["VMD_TESTING"], copts = ["-fPIE"], linkopts = ["-pie"])
[bsd_kyua_test(name = name + "_run", program = ":" + name, interface = "atf",
    case_timeout = 120 if name == "evolution_test" else 300,
    suite_files = {":next_peer": "next_peer"} if name == "evolution_test" else {},
    tags = ["manual", "requires-matching-kernel"],
    suite = "FreeBSD", kyua = "@bsd_sdk//toolchain:extra_kyua", clean_environment = True,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_kyua_runtime"],
    size = "medium", visibility = ["//visibility:public"])
 for name in ["lifecycle_test", "serve_test", "evolution_test"]]

load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
load(":installation.bzl", "TESTDIR", "ATF_PROGRAMS", "BINARIES")
[utility_installation(name = "install_" + p, program = p, manual = "",
    package = "waspnest-tests", bindir = TESTDIR) for p in BINARIES]
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ATF_PROGRAMS,
    interfaces = {p: "atf" for p in ATF_PROGRAMS},
    metadata = {n: '{"timeout":"120"}' for n in ["evolution_test", "provider_test"]})
_FILES = [(":kyuafile", TESTDIR + "/Kyuafile")] + [
    ("//contrib/fuchsia:" + n, "/usr/share/licenses/waspnest-tests/fuchsia/" + n) for n in ["LICENSE", "PATENTS"]]
[bsd_install_file(name = "install_file_" + str(i), src = source, destination = dest,
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=waspnest-tests"])
 for i, (source, dest) in enumerate(_FILES)]
bsd_install_manifest(name = "install_extra", entries = [":install_file_" + str(i) for i in range(len(_FILES))],
    visibility = ["//usr.sbin/BSDVM:__pkg__"])
