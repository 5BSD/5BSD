load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
load("//tools/build/bazel:bsd_python_test.bzl", "bsd_python_test")

# Make's x86 parent selects this under MK_APM; the explicit leaf always builds.
# Actual WARNS=6 policy, including Make's repeated PIC/PIE compile semantics.
cc_binary(name = "apm", srcs = ["apm.c"],
    copts = ["-DPIC", "-pipe", "-fno-common", "-fPIE", "-std=gnu17",
        "-Wno-format-zero-length", "-Wsystem-headers", "-Werror", "-Wall",
        "-Wno-format-y2k", "-W", "-Wno-unused-parameter", "-Wstrict-prototypes",
        "-Wmissing-prototypes", "-Wpointer-arith", "-Wreturn-type", "-Wcast-qual",
        "-Wwrite-strings", "-Wswitch", "-Wshadow", "-Wunused-parameter", "-Wcast-align",
        "-Wchar-subscripts", "-Wnested-externs", "-Wold-style-definition",
        "-Wno-pointer-sign", "-Wdate-time", "-Wmissing-variable-declarations",
        "-Wthread-safety", "-Wno-empty-body", "-Wno-string-plus-int",
        "-Wno-unused-const-variable", "-Wno-error=unused-but-set-parameter",
        "-Wno-error=cast-function-type-mismatch", "-Qunused-arguments"],
    linkopts = ["-pie"], linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
utility_installation(name = "install_manifest", program = "apm", manual = "apm.8",
    package = "apm", bindir = "/usr/sbin", man_section = "8")
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"],
    directories = {path: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=apm","dbg"]}' for path in [
        "/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", epoch = 0,
    mtree = "@bsd_sdk//toolchain:extra_mtree", python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
bsd_python_test(name = "safe_cli_test", src = "safe_cli_test.py", data = [":apm",
    "//lib/libc:c_shared", "//lib/libsys:sys_shared"])
