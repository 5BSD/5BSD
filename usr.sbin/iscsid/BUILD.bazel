# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = "iscsid", srcs = ['discovery.c', 'iscsid.c', 'login.c', 'iscsid.h'],
    deps = ['//sys/dev/iscsi:user_headers', '//lib/libiscsiutil:iscsiutil_pie', '//lib/libutil:util'],
    dynamic_deps = ['//lib/libutil:util_shared', '//lib/libmd:md_shared'],
    local_defines = ["ICL_KERNEL_PROXY"],
    copts = ["-fPIE", "-DPIC"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "iscsid", manual = "iscsid.8", man_section = "8", package = "iscsi", bindir = "/usr/sbin")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=iscsi","dbg"]}'
        for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", epoch = 0,
    mtree = "@bsd_sdk//toolchain:extra_mtree", python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
    visibility = ["//visibility:public"])


load("//tools/build/bazel:bsd_python_test.bzl", "bsd_python_test")
bsd_python_test(name = "help_test", src = "help-test.py", data = [":iscsid"],
    runtime = ['@bsd_sdk//toolchain:python_stdlib', '//lib/libutil:util_shared', '//lib/libmd:md_shared'],
    visibility = ["//visibility:public"])
