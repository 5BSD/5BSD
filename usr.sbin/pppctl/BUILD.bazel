load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
load("//tools/build/bazel:bsd_python_test.bzl", "bsd_python_test")
cc_binary(name = "pppctl", srcs = ["pppctl.c"],
    deps = ["//lib/libedit:edit", "//lib/libthr:thr"], dynamic_deps = ["//lib/libedit:edit_shared", "//lib/libthr:thr_shared"],
    copts = ["-std=gnu17", "-fPIE", "-DPIC", "-pipe", "-fno-common", "-Qunused-arguments", "-Wno-format-zero-length", "-Wsystem-headers"] +
        select({"//tools/build/bazel/config:werror_enabled": ["-Werror"], "//conditions:default": []}) + [
        "-Wall", "-Wno-format-y2k", "-Wno-uninitialized", "-Wno-pointer-sign", "-Wdate-time", "-Wno-empty-body",
        "-Wno-string-plus-int", "-Wno-unused-const-variable", "-Wno-error=unused-but-set-parameter", "-Wno-error=cast-function-type-mismatch",
        "-Wno-tautological-compare", "-Wno-unused-value", "-Wno-parentheses-equality", "-Wno-unused-function",
        "-Wno-enum-conversion", "-Wno-unused-local-typedef", "-Wno-address-of-packed-member", "-Wno-switch", "-Wno-switch-enum", "-Wno-knr-promoted-parameter"],
    linkopts = ["-pie"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
utility_installation(name = "install_manifest", program = "pppctl", manual = "pppctl.8", package = "ppp", bindir = "/usr/sbin", man_section = "8")
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=ppp","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", epoch = 0,
    mtree = "@bsd_sdk//toolchain:extra_mtree", python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
bsd_python_test(name = "usage_test", src = "usage_test.py", data = [":pppctl", "//lib/libedit:edit_shared", "//lib/ncurses/tinfo:tinfo_shared", "//lib/libthr:thr_shared", "//lib/libc:c_shared", "//lib/libsys:sys_shared"])
