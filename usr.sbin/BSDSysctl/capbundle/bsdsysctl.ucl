activation { boot = true; ipc = ["system.Sysctl"]; }
management = "core";
protect = ["ptrace", "signal", "wait", "sigkill", "sigcont", "sched",
    "core", "ktrace"];
program = "BSDSysctl";
restart = "on-failure";
user = "root";

# bsdsysctl cannot enter capability mode: the workers must keep unrestricted
# sysctl(3) access, and the kernel confines capmode sysctl to CTLFLAG_CAPRD/CAPWR
# nodes (so even kern.ostype returns EPERM under a sandbox).  It is therefore a
# ambient-authority provider — switchboard takes its SVC_OP_READY as the readiness
# boundary instead of kernel-observed capability-mode entry.  Access is bounded
# by the per-label sysctl policy (sysctl.conf), not by a sandbox.
ambient = true;

# Per-OID sysctl isolation (docs/capability-sysctl-isolation.md, Phase 2).  The
# "sysctl" gate plus a non-empty `isolate` list makes switchboard ask Capsule
# to mint a SYSCTL token scoped to exactly these OIDs; bsdsysctl authorizes the
# delivered token (service_provider_authorize_capabilities) and becomes the sole
# writer outside Capsule of them.  Any OTHER privileged process's direct
# __sysctl(2) write to an isolated OID is denied by the kernel — it must go
# through system.Sysctl SET, brokered per the per-label sysctl.conf ACL.  Every
# sysctl NOT listed here stays directly writable (normal PRIV_SYSCTL_WRITE).
# Extend this list to bring more tunables under the broker.
capabilities {
	system = ["sysctl"];
	isolate = ["kern.maxfiles"];
}

limits { nofile = 1024; nproc = 128; core = 0; }
umask = "0077";
