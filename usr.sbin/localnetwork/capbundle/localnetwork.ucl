activation { boot = true; ipc = ["system.Network"]; }
program = "Network";
restart = "on-failure";
user = "capability";

limits { nofile = 1024; nproc = 128; core = 0; }
umask = "0077";

# Privileged (capmode exception): localnetwork is the network broker.  It uses
# Casper cap_net (cap_init at startup) and performs socket/bind/connect/resolve,
# none of which a born-in-capmode process can do.  Networking is a kernel-
# facility bridge like storage; the per-label network policy is the boundary.
privileged = true;
