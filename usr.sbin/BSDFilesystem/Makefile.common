# Shared production and controlled-crash fixture build dependencies.
CFLAGS+= -I${SRCTOP}/usr.sbin/BSDFilesystem
CFLAGS+= -I${FIDLGEN.filesystemcmp} -I${FIDLGEN.oes_broker}
CFLAGS+= -I${SRCTOP}/lib/libfidl/include -I${SRCTOP}/lib/libcapsulert
CFLAGS+= -I${SRCTOP}/lib/libtrustedzfs -I${SRCTOP}/lib/libcapreclaim
CFLAGS+= -I${SRCTOP}/lib/liblogcmp -I${SRCTOP}/lib/libservice
CFLAGS+= -I${SRCTOP}/lib/libchannel -I${SRCTOP}/sys -I${SRCTOP}/lib/liboes
CFLAGS+= -I${SRCTOP}/contrib/libucl/include
LIBADD= capsulert trustedzfs ucl nvpair service channel md capreclaim logcmp \
    filesystemcmp oes fidl_bsd
FIDL_BINDINGS+= filesystemcmp oes_broker
FIDL_SCHEMAS.filesystemcmp= lib/libfidl/tests/zx.fidl lib/libfilesystemcmp/filesystemcmp.fidl
FIDL_LIBRARY.filesystemcmp= bsd.filesystem.v1
FIDL_SCHEMAS.oes_broker= lib/libfidl/tests/zx.fidl lib/liboes/oes_broker.fidl
FIDL_LIBRARY.oes_broker= bsd.oes.v1
.include "${SRCTOP}/lib/libfidl/fidl-bindings.mk"
