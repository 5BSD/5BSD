# Sources shipped with the libservice worker-authority contract test.


# Source fixtures shipped with Switchboard contract tests.
exports_files(['capbundle/bsdfilesystem.ucl'], visibility = ["//usr.sbin/switchboard/tests:__pkg__", "//usr.sbin/BSDFilesystem/tests:__pkg__"])

exports_files(["bsdfilesystem.ucl"], visibility = ["//usr.sbin/BSDNetwork/tests:__pkg__", "//usr.sbin/BSDFilesystem/tests:__pkg__"])

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_import")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_header", "bsd_dtrace_cc_objects")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
bsd_dtrace_header(
    name = "provider", source = "bsdfilesystem_provider.d", output = "bsdfilesystem_provider.h",
    flags = ["-C", "-x", "nolibs"], object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:bootstrap", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti",
    runtime_libraries = ["//cddl/usr.sbin/dtrace:bootstrap_runtime"],
    tool_inputs = [ "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"], static_anchor = False,
)
cc_library(name = "provider_headers", hdrs = [":provider"], strip_include_prefix = ".")

cc_library(name = "nvpair_link", implementation_deps = ["//cddl/lib/libnvpair:nvpair"], visibility = ["//usr.sbin/BSDFilesystem/tests:__pkg__"])

# nvwalk.c uses the maintained narrow nvpair ABI declarations. Keep the SPL
# compilation environment out of ordinary BSD daemon translation units.
cc_library(name = "objects", srcs = ["bsdfilesystem.c", "layout.c", "nvwalk.c", "request.c", "oes_factory.c", "oes_session.c", "bsdfilesystem.h", "oes_factory.h", "bsdfilesystem_probes.h"],
    deps = ['//lib/libcapsulert:capsulert', '//lib/libtrustedzfs:trustedzfs', '//lib/libucl:ucl', ':nvpair_link', '//lib/libservice:service', '//lib/libchannel:channel', '//lib/libmd:md_link', '//lib/libcapreclaim:capreclaim', '//lib/liblogcmp:logcmp', '//lib/libfilesystemcmp:filesystemcmp', '//lib/liboes:oes', '//lib/libfidl:fidl', '//lib/libfilesystemcmp:generated_headers', '//lib/liboes:generated_headers', '//lib/liboes:broker_protocol_headers', '//sys/dev/hid:vhid_header', '//sys/dev/mac_capability:isolation_headers'] + select({_TRACE: [":provider_headers"], "//conditions:default": []}),
    local_defines = select({_TRACE: ["WITH_DTRACE"], "//conditions:default": []}),
    copts = ["-fPIE"], target_compatible_with = _PLATFORM)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider", provider_object = "bsdfilesystem_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group) for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"], deps = [":provider_link"] + ['//lib/libcapsulert:capsulert', '//lib/libtrustedzfs:trustedzfs', '//lib/libucl:ucl', ':nvpair_link', '//lib/libservice:service', '//lib/libchannel:channel', '//lib/libmd:md_link', '//lib/libcapreclaim:capreclaim', '//lib/liblogcmp:logcmp', '//lib/libfilesystemcmp:filesystemcmp', '//lib/liboes:oes', '//lib/libfidl:fidl', '//lib/libfilesystemcmp:generated_headers', '//lib/liboes:generated_headers', '//lib/liboes:broker_protocol_headers', '//sys/dev/hid:vhid_header', '//sys/dev/mac_capability:isolation_headers'])

load("//tools/build/bazel:bsd_capimage.bzl", "bsd_capimage_policy")
bsd_capimage_policy(name = "policy_assembly", src = "capbundle/bsdfilesystem.ucl")
cc_binary(name = "BSDFilesystem", srcs = [":policy_assembly"], deps = select({_TRACE: [":traced"], "//conditions:default": [":objects"]}),
    dynamic_deps = ['//lib/libcapsulert:capsulert_shared', '//lib/libtrustedzfs:trustedzfs_shared', '//lib/libucl:ucl_shared', '//cddl/lib/libnvpair:nvpair_shared', '//lib/libservice:service_shared', '//lib/libchannel:channel_shared', '//lib/libmd:md_shared', '//lib/libcapreclaim:capreclaim_shared', '//lib/liblogcmp:logcmp_shared', '//lib/libfilesystemcmp:filesystemcmp_shared', '//lib/liboes:oes_shared', '//lib/libfidl:fidl_shared'],
    linkopts = ["-pie", "-Wl,-z,now"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])


load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_compress")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
_BUNDLE = "/Capabilities/System/Filesystem.cap"
_UNIT = _BUNDLE + "/Units/bsdfilesystem.unit"
utility_installation(name = "program_install", keep_sections = [".5bsd.policy"], program = "BSDFilesystem", manual = "BSDFilesystem.8",
    package = "runtime", bindir = _UNIT + "/bin", man_section = "8")
[bsd_install_file(name = name, src = src, destination = dest, owner = "root", group = "wheel",
    mode = mode, install_tags = tags)
 for name, src, dest, mode, tags in [
    ("bundle_install", "capbundle/Bundle.ucl", _BUNDLE + "/Bundle.ucl", "0444", ["package=runtime"]),
    ("unit_install", "capbundle/bsdfilesystem.ucl", _UNIT + "/Unit.ucl", "0444", ["package=runtime"]),
    ("config_install", "bsdfilesystem.ucl", "/Capabilities/Config/bsdfilesystem.ucl", "0644", ["package=runtime", "config"]),
 ]]
bsd_compress(name = "tzfs_manual", src = "tzfs.conf.5", output = "tzfs.conf.5.gz",
    arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect",
    runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(name = "tzfs_manual_install", src = ":tzfs_manual", destination = "/usr/share/man/man5/tzfs.conf.5.gz",
    owner = "root", group = "wheel", mode = "0444",
    install_tags = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=runtime-man"], "//conditions:default": ["package=runtime"]}))
bsd_install_manifest(name = "bundle_install_manifest", entries = [":bundle_install", ":unit_install", ":config_install", ":tzfs_manual_install"])
bsd_install_archive(name = "daemon_install_archive",
    manifests = [":program_install", ":bundle_install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities"]}'
        for d in ["/Capabilities/Config", "/usr/share/tzfs"]} | {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime"]}'
        for d in [_BUNDLE, _BUNDLE + "/Units", _UNIT, _UNIT + "/bin", _UNIT + "/Config"]} |
        {"/usr/lib/debug" + d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime","dbg"]}'
         for d in ["/Capabilities", "/Capabilities/System", _BUNDLE, _BUNDLE + "/Units", _UNIT, _UNIT + "/bin"]},
    mtree_specs = {"//etc/mtree:BSD.tests.dist": "/usr/tests", "//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])

cc_library(name = "test_headers", hdrs = ["bsdfilesystem.h"], strip_include_prefix = ".",
    deps = ["//lib/libcapsulert:headers"], visibility = ["//usr.sbin/BSDFilesystem/tests:__pkg__"])

exports_files(["oes_factory.c", "oes_session.c"], visibility = ["//usr.sbin/BSDFilesystem/tests:__pkg__"])
cc_library(name = "oes_test_headers", hdrs = ["oes_factory.h"], textual_hdrs = ["oes_factory.c", "oes_session.c"],
    deps = ["//lib/libservice:headers", "//lib/liboes:broker_protocol_headers", "//lib/liboes:generated_headers"],
    strip_include_prefix = ".", visibility = ["//usr.sbin/BSDFilesystem/tests:__pkg__"])

exports_files(["request.c", "layout.c", "nvwalk.c"], visibility = ["//usr.sbin/BSDFilesystem/tests:__pkg__", "//lib/libservice/tests:__pkg__"])
cc_library(name = "request_test_headers", hdrs = ["bsdfilesystem_probes.h"], textual_hdrs = ["request.c", "layout.c"],
    deps = [":test_headers", ":oes_test_headers", "//lib/libfilesystemcmp:generated_headers",
        "//sys/dev/hid:vhid_header", "//sys/dev/mac_capability:isolation_headers"],
    strip_include_prefix = ".", visibility = ["//usr.sbin/BSDFilesystem/tests:__pkg__"])

load("//usr.sbin/BSDFilesystem/tests:installation.bzl", TEST_MANIFESTS = "MANIFESTS", TEST_DIRECTORIES = "DIRECTORIES")
bsd_install_archive(name = "install_archive",
    manifests = [":program_install", ":bundle_install_manifest"] + select({"//tools/build/bazel/config:tests_enabled": TEST_MANIFESTS, "//conditions:default": []}),
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities"]}'
        for d in ["/Capabilities/Config", "/usr/share/tzfs"]} | {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime"]}'
        for d in [_BUNDLE, _BUNDLE + "/Units", _UNIT, _UNIT + "/bin", _UNIT + "/Config"]} |
        {"/usr/lib/debug" + d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime","dbg"]}'
         for d in ["/Capabilities", "/Capabilities/System", _BUNDLE, _BUNDLE + "/Units", _UNIT, _UNIT + "/bin"]} | select({"//tools/build/bazel/config:tests_enabled": TEST_DIRECTORIES, "//conditions:default": {}}),
    mtree_specs = {"//etc/mtree:BSD.tests.dist": "/usr/tests", "//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])
