load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# The Make PIE executable links the internal libpmcstat_pie archive.
cc_binary(
    name = "pmcstat",
    srcs = [
        "pmcstat.c",
        "pmcstat_log.c",
        "pmcpl_callgraph.c",
        "pmcpl_gprof.c",
        "pmcpl_annotate.c",
        "pmcpl_annotate_cg.c",
        "pmcpl_calltree.c",
        "pmcstat.h",
        "pmcstat_log.h",
        "pmcstat_top.h",
        "pmcpl_callgraph.h",
        "pmcpl_gprof.h",
        "pmcpl_annotate.h",
        "pmcpl_annotate_cg.h",
        "pmcpl_calltree.h",
    ],
    deps = [
        "//lib/libpmc:public_headers",
        "//lib/libpmcstat:headers",
        "//lib/libkvm:kvm",
        "//lib/libpmc:pmc",
        "//lib/msun:m",
        "//lib/ncurses/tinfo:tinfo",
        "//lib/ncurses/ncurses:ncurses",
        "//lib/libpmcstat:pmcstat_pie",
        "//lib/libelf:elf",
        "//lib/libc++:cxx",
        "//lib/libcxxrt:cxxrt",
    ],
    dynamic_deps = [
        "//lib/libkvm:kvm_shared",
        "//lib/libpmc:pmc_shared",
        "//lib/msun:m_shared",
        "//lib/ncurses/tinfo:tinfo_shared",
        "//lib/ncurses/ncurses:ncurses_shared",
        "//lib/libelf:elf_shared",
        "//lib/libc++:cxx_shared",
        "//lib/libcxxrt:cxxrt_shared",
    ],
    copts = ["-fPIE"],
    linkopts = ["-pie"], target_compatible_with = ["@platforms//os:freebsd"],
    visibility = ["//visibility:public"],
)
utility_installation(name = "install_manifest", program = "pmcstat", manual = "pmcstat.8",
    package = "pmc", bindir = "/usr/sbin", man_section = "8")
bsd_install_archive(
    name = "install_archive", manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=pmc","dbg"]}'
        for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"],
)
