# system.Trace requires the client software attribute system.trace.client.
# Tracing exposes kernel and process state, so approved clients must expose
# deliberate operations and validate their inputs. UNIX UID alone does not
# grant endpoint access. See docs/book/src/plane/attributes.md.
activation {
    boot = true;
    ipc = [ { name = "system.Trace"; requires = ["system.trace.client"]; } ];
}
control = "system";
protect = ["ptrace", "signal", "wait", "sigkill", "sigcont", "sched", "core", "ktrace"];
program = "BSDTrace";
# Born in capability mode: switchboard delivers /dev as a directory descriptor so
# the provider opens /dev/dtrace with openat(2), never a global path.
directories = ["/dev"];
restart = "on-failure";
user = "root";

limits { nofile = 1024; nproc = 64; core = 0; }
umask = "0077";
