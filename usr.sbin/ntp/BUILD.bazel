load("@rules_cc//cc:defs.bzl", "cc_library")
load("@bazel_skylib//rules:common_settings.bzl", "int_flag", "string_flag")
# A fresh Make object tree emits serial 1. Rebuild identity is explicit in Bazel.
int_flag(name = "version_serial", build_setting_default = 1, visibility = ["//visibility:public"])
string_flag(name = "version_cset", build_setting_default = "", visibility = ["//visibility:public"])
cc_library(name = "config_headers", hdrs = ["config.h"], strip_include_prefix = ".",
    visibility = ["//usr.sbin/ntp:__subpackages__"])

load("//tools/build/bazel:bsd_python_test.bzl", "bsd_python_test")
bsd_python_test(name = "version_inputs_test", src = "version-inputs-test.py",
    data = ["ntp_version.py"], visibility = ["//visibility:public"])

exports_files(["scripts/mkver", "ntp_version.py", "client-help-test.py", "remaining-client-options-test.py"], visibility = ["//usr.sbin/ntp:__subpackages__"])

# The directory's maintained Make subgraph owns these seven installed programs;
# the four private libraries do not add installation payloads.
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
load("//contrib/ntp:documentation.bzl", "DOC_DIRECTORIES")
bsd_install_manifest(name = "install_manifest",
    manifests = ["//usr.sbin/ntp/" + program + ":install_manifest"
        for program in ["ntpd", "ntpdc", "ntpq", "ntpdate", "ntptime", "ntp-keygen", "sntp"]] +
        ["//usr.sbin/ntp/doc:install_manifest"], visibility = ["//visibility:public"])
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=ntp","dbg"]}'
        for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/bin", "/usr/lib/debug/usr/sbin"]} |
        {"/etc": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities"]}',
         "/etc/ntp": '{"owner":"root","group":"wheel","mode":"0700","tags":["package=utilities"]}'} |
        select({"//tools/build/bazel/config:html_enabled": DOC_DIRECTORIES, "//conditions:default": {}}),
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", epoch = 0,
    mtree = "@bsd_sdk//toolchain:extra_mtree", python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
    visibility = ["//visibility:public"])
