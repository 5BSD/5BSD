# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_import")
load("//contrib/ntp:sources.bzl", "NTPD_SOURCES")
load("//usr.sbin/ntp:common.bzl", "PLATFORM", "OPENSSL", "common_defines", "common_headers")
load("//usr.sbin/ntp:ntp_version.bzl", "ntp_version")
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_header", "bsd_dtrace_cc_objects")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
_LIBRARIES = (["//usr.sbin/ntp/libparse:parse_pie", "//usr.sbin/ntp/libntp:ntp_pie",
    "//lib/msun:m", "//lib/libmd:md_link", "//usr.sbin/ntp/libopts:opts_pie"] +
    select({OPENSSL: ["//secure/lib/libcrypto:crypto"], "//conditions:default": []}) + ["//lib/libthr:thr"])
_SHARED = (["//lib/msun:m_shared", "//lib/libmd:md_shared"] +
    select({OPENSSL: ["//secure/lib/libcrypto:crypto_shared"], "//conditions:default": []}) + ["//lib/libthr:thr_shared"])
ntp_version(name = "version", program = "ntpd")
bsd_dtrace_header(name = "provider", source = "timediscipline_provider.d", output = "timediscipline_provider.h",
    flags = ["-C", "-x", "nolibs"], static_anchor = True, object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:bootstrap", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti", runtime_libraries = ["//cddl/usr.sbin/dtrace:bootstrap_runtime"],
    tool_inputs = ["@bsd_sdk//toolchain:compile_inputs", "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"])
cc_library(name = "provider_header", hdrs = [":provider"], strip_include_prefix = ".")
cc_library(name = "objects", srcs = ["//contrib/ntp:" + p for p in NTPD_SOURCES] + [":version"],
    textual_hdrs = ["//contrib/ntp:jsmn_fragment"],
    deps = common_headers() + ["//contrib/ntp:ntpd_headers"] + _LIBRARIES +
        select({_TRACE: [":provider_header"], "//conditions:default": []}),
    local_defines = common_defines() + select({_TRACE: ["WITH_COVERAGE_DTRACE"], "//conditions:default": []}),
    copts = ["-fPIE", "-DPIC"], alwayslink = True, target_compatible_with = PLATFORM)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider",
    provider_object = "timediscipline_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group)
 for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"],
    alwayslink = True, deps = [":provider_link"] + _LIBRARIES)
cc_binary(name = "ntpd", deps = select({_TRACE: [":traced"], "//conditions:default": [":objects"]}),
    dynamic_deps = _SHARED, linkopts = ["-pie"], target_compatible_with = PLATFORM,
    visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file")
bsd_install_file(name = "config", src = "ntp.conf", destination = "/etc/ntp.conf",
    owner = "root", group = "wheel", mode = "0644", install_tags = ["package=ntp", "config"])
bsd_install_file(name = "leaps", src = "leap-seconds", destination = "/etc/ntp/leap-seconds",
    owner = "root", group = "wheel", mode = "0644", install_tags = ["package=ntp"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "ntpd", manual = None,
    package = "ntp", bindir = "/usr/sbin", extra_entries = [":config", ":leaps"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=ntp","dbg"]}'
        for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]} |
        {"/etc": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities"]}',
         "/etc/ntp": '{"owner":"root","group":"wheel","mode":"0700","tags":["package=utilities"]}'},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", epoch = 0,
    mtree = "@bsd_sdk//toolchain:extra_mtree", python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
    visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_python_test.bzl", "bsd_python_test")
bsd_python_test(name = "options_test", src = "options-test.py", data = [":ntpd", ":version"],
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "//lib/msun:m_shared",
        "//lib/libmd:md_shared", "//lib/libthr:thr_shared"] +
        select({OPENSSL: ["//secure/lib/libcrypto:crypto_shared"], "//conditions:default": []}),
    visibility = ["//visibility:public"])
