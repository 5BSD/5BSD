load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//usr.sbin/ntp:common.bzl", "PLATFORM", "OPENSSL", "common_defines", "common_headers")
cc_binary(name = 'sntp',
    srcs = ['//contrib/ntp:sntp/crypto.c', '//contrib/ntp:sntp/kod_management.c', '//contrib/ntp:sntp/log.c', '//contrib/ntp:sntp/main.c', '//contrib/ntp:sntp/networking.c', '//contrib/ntp:sntp/sntp-opts.c', '//contrib/ntp:sntp/sntp.c', '//contrib/ntp:sntp/utilities.c'],
    # List archive dependencies before shared math/digest roots so rules_cc's
    # dependency ordering retains Make's m-before-md dynamic dependency order.
    deps = common_headers() + ['//contrib/ntp:sntp_headers', '//usr.sbin/ntp/libopts:opts_pie', '//usr.sbin/ntp/libntp:ntp_pie', '//usr.sbin/ntp/libntpevent:ntpevent_pie', '//lib/msun:m', '//lib/libmd:md_link'] +
        select({OPENSSL: ["//secure/lib/libcrypto:crypto"], "//conditions:default": []}) + ["//lib/libthr:thr"],
    dynamic_deps = ['//lib/msun:m_shared', '//lib/libmd:md_shared'] + select({OPENSSL: ["//secure/lib/libcrypto:crypto_shared"], "//conditions:default": []}) + ["//lib/libthr:thr_shared"],
    local_defines = common_defines(), copts = ["-fPIE", "-DPIC"], linkopts = ["-pie"],
    target_compatible_with = PLATFORM, visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "sntp", manual = None, package = "ntp", bindir = "/usr/sbin")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=ntp","dbg"]}'
        for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", epoch = 0,
    mtree = "@bsd_sdk//toolchain:extra_mtree", python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
    visibility = ["//visibility:public"])



load("//tools/build/bazel:bsd_python_test.bzl", "bsd_python_test")
bsd_python_test(name = "options_test", src = "//usr.sbin/ntp:remaining-client-options-test.py",
    data = [":sntp", "//usr.sbin/ntp/libntp:version"],
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "//lib/msun:m_shared",
        "//lib/libmd:md_shared", "//lib/libthr:thr_shared"] +
        select({OPENSSL: ["//secure/lib/libcrypto:crypto_shared"], "//conditions:default": []}),
    visibility = ["//visibility:public"])
