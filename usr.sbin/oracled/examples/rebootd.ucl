# Reboot/shutdown manager — controls reboot(2) via capability token.
# Only useful when the system gate "reboot" is claimed in oracled.conf
# (embedded profile).
#
# On desktop and server profiles (reboot ungated), this service has
# no token and processes can reboot directly.

bundle_id = "org.5bsd.systemcontrol";
version = "1.0";
author = "5BSD";

program = "rebootd";
provides = ["org.5bsd.system.reboot"];
on_demand = false;
restart = "on-failure";

capabilities {
    system = ["reboot"];
}
