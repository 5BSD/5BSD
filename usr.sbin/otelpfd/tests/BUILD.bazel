load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_script_wrapper")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
_WRAP_ALLOC = ["-Wl,--wrap=malloc", "-Wl,--wrap=calloc", "-Wl,--wrap=realloc", "-Wl,--wrap=strdup", "-Wl,--wrap=strndup"]
_OE = ["//lib/libotelexport:otelexport_pie", "//lib/libz:z", "//secure/lib/libssl:ssl", "//secure/lib/libcrypto:crypto", "//lib/libucl:ucl", "//lib/libnghttp2:nghttp2"]
_OE_SHARED = ["//lib/libz:z_shared", "//secure/lib/libssl:ssl_shared", "//secure/lib/libcrypto:crypto_shared", "//lib/libucl:ucl_shared", "//lib/libnghttp2:nghttp2_shared"]
_BASE_RUNTIME = ["//lib/atf/libatf-c:atf_c_shared", "//lib/libc:c_shared", "//lib/libsys:sys_shared"]
# usr.sbin/otelpfd/tests/Makefile (PACKAGE otel-tests): pfstat_test (with
# ../pfstat.c, LIBADD otelexport), otelpfd_test.sh and mkpfstatus.
# Explicit final libthr dependency preserves Make's deferred pthread link order.
cc_binary(name = "pfstat_test", srcs = ["pfstat_test.c", "//usr.sbin/otelpfd:pfstat.c"],
    deps = ["//usr.sbin/otelpfd:headers", "//lib/libotelexport:headers", "//lib/atf/libatf-c:atf_c"] + _OE + ["//lib/libthr:thr"],
    dynamic_deps = ["//lib/atf/libatf-c:atf_c_shared"] + _OE_SHARED + ["//lib/libthr:thr_shared"],
    copts = ["-fPIE"], linkopts = ["-pie"], linkstatic = True, target_compatible_with = _PLATFORM)
cc_binary(name = "mkpfstatus", srcs = ["mkpfstatus.c"], deps = ["//usr.sbin/otelpfd:headers", "//lib/libotelexport:headers"],
    copts = ["-fPIE"], linkopts = ["-pie"], linkstatic = True, target_compatible_with = _PLATFORM)
_DIR = "/usr/tests/usr.sbin/otelpfd"
_PACKAGE = "otel-tests"
[utility_installation(name = "install_" + name, program = name, manual = None, package = _PACKAGE, bindir = _DIR) for name in ["mkpfstatus", "pfstat_test"]]
bsd_script_wrapper(name = "otelpfd_test", body = "otelpfd_test.sh", interpreter = "/usr/libexec/atf-sh", cat = "@bsd_sdk//toolchain:cat", cat_runtime = ["@bsd_sdk//toolchain:cat_runtime"], redirect = "@bsd_sdk//toolchain:stdout_redirect")
bsd_install_file(name = "install_otelpfd_test", src = ":otelpfd_test", destination = _DIR + "/otelpfd_test", owner = "root", group = "wheel", mode = "0555", install_tags = ["package=" + _PACKAGE])
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["otelpfd_test", "pfstat_test"], interfaces = {n: "atf" for n in ["otelpfd_test", "pfstat_test"]})
bsd_install_file(name = "install_kyuafile", src = ":kyuafile", destination = _DIR + "/Kyuafile", owner = "root", group = "wheel", mode = "0444", install_tags = ["package=" + _PACKAGE])
bsd_install_manifest(name = "install_manifest", entries = [":install_otelpfd_test", ":install_kyuafile"], manifests = [":install_" + name for name in ["mkpfstatus", "pfstat_test"]], visibility = ["//visibility:public"])

CASES = ["conversion", "stopped", "exporter_failure", "since_ahead"]
[bsd_atf_test(name = "pfstat_test_" + case, case_name = case, interface = "program", body = ":pfstat_test",
    loader = "//libexec/rtld-elf:rtld_binary", runtime_lib = _BASE_RUNTIME + _OE_SHARED + ["//lib/libthr:thr_shared", "//lib/msun:m_shared"],
    runner = "//tools/build/bazel:atf_runner", body_timeout_seconds = 60, size = "small") for case in CASES]
test_suite(name = "native_tests", tests = [":pfstat_test_" + case for case in CASES], visibility = ["//visibility:public"])
