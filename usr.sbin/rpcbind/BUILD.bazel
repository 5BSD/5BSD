load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = "rpcbind", srcs = ["check_bound.c", "rpcb_stat.c", "rpcb_svc_4.c", "rpcbind.c", "pmap_svc.c", "rpcb_svc.c", "rpcb_svc_com.c", "security.c", "warmstart.c", "util.c", "rpcbind.h"], local_defines = ["PORTMAP"] + select({"//tools/build/bazel/config:inet6_support_enabled": ["INET6"], "//conditions:default": []}) + select({"//tools/build/bazel/config:rpcbind_warmstart_support_enabled": ["WARMSTART"], "//conditions:default": []}) + select({"//tools/build/bazel/config:tcp_wrappers_enabled": ["LIBWRAP"], "//conditions:default": []}), deps = ["//lib/libutil:util"] + select({"//tools/build/bazel/config:tcp_wrappers_enabled": ["//lib/libwrap:wrap"], "//conditions:default": []}), dynamic_deps = ["//lib/libutil:util_shared"] + select({"//tools/build/bazel/config:tcp_wrappers_enabled": ["//lib/libwrap:wrap_shared"], "//conditions:default": []}), copts = ["-fPIE"], linkopts = ["-pie"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "rpcbind", manual = "rpcbind.8", package = "utilities", bindir = "/usr/sbin", man_section = "8")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive", visibility = ["//usr.sbin:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)




load("@rules_cc//cc:defs.bzl", "cc_library")
exports_files(["util.c"], visibility = ["//usr.sbin/rpcbind/tests:__pkg__"])
cc_library(name = "headers", hdrs = ["rpcbind.h"], strip_include_prefix = ".", visibility = ["//usr.sbin/rpcbind/tests:__pkg__"])
