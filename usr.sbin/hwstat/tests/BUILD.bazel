utility_installation(name = "install_sampling_test", program = "sampling_test", manual = None, package = "hwstat-tests", bindir = "/usr/tests/usr.sbin/hwstat")
cc_library(name = "metrics_test_headers", textual_hdrs = ['//usr.sbin/hwstat:metrics.c'], deps = ["//usr.sbin/hwstat:headers", "//lib/libotelexport:headers"])
cc_binary(name = "metrics_test", srcs = ['metrics_test.c'], deps = ['//lib/atf/libatf-c:atf_c', ':metrics_test_headers'], dynamic_deps = ['//lib/atf/libatf-c:atf_c_shared'], copts = ["-fPIE"], linkopts = ["-pie"], linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
