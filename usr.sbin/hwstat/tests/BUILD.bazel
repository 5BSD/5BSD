utility_installation(name = "install_rapl_test", program = "rapl_test", manual = None, package = "hwstat-tests", bindir = "/usr/tests/usr.sbin/hwstat")
cc_library(name = "sensors_test_headers", textual_hdrs = ['//usr.sbin/hwstat:sensors.c'], deps = ["//usr.sbin/hwstat:headers", "//lib/libotelexport:headers"])
