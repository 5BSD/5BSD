load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
cc_library(name = "headers", hdrs = ["hwstat.h"], strip_include_prefix = ".", visibility = ["//usr.sbin/hwstat/tests:__pkg__"])
exports_files(["main.c", "rapl.c", "sensors.c", "metrics.c", "format.c"], visibility = ["//usr.sbin/hwstat/tests:__pkg__"])
# Dependencies in Make's NEEDED order (libotelexport's z ssl crypto ucl nghttp2,
# then m); explicit final libthr preserves Make's deferred pthread link order.
cc_binary(name = "hwstat", srcs = ["main.c", "rapl.c", "sensors.c", "metrics.c", "format.c"], deps = [":headers", "//lib/libotelexport:headers"] + ['//lib/libotelexport:otelexport_pie', '//lib/libz:z', '//secure/lib/libssl:ssl', '//secure/lib/libcrypto:crypto', '//lib/libucl:ucl', '//lib/libnghttp2:nghttp2', '//lib/msun:m', '//lib/libthr:thr'], dynamic_deps = ['//lib/libz:z_shared', '//secure/lib/libssl:ssl_shared', '//secure/lib/libcrypto:crypto_shared', '//lib/libucl:ucl_shared', '//lib/libnghttp2:nghttp2_shared', '//lib/msun:m_shared', '//lib/libthr:thr_shared'], copts = ["-fPIE"], linkopts = ["-pie"], linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
utility_installation(name = "install_manifest", program = "hwstat", manual = "hwstat.8", package = "hwstat", bindir = "/usr/sbin", man_section = "8", aliases = [], extra_entries = [])
bsd_install_archive(name = "install_archive",
    manifests = [":install_manifest"] + select({"//tools/build/bazel/config:tests_enabled": ["//usr.sbin/hwstat/tests:install_manifest"] + ["//usr.sbin/hwstat/tests:install_" + n for n in ["exec_timing_test", "metrics_test", "rapl_test", "sampling_test", "sensors_test"]], "//conditions:default": []}),
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=hwstat","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]} | select({"//tools/build/bazel/config:tests_enabled": {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=hwstat-tests","dbg"]}' for d in ["/usr/lib/debug/usr/tests", "/usr/lib/debug/usr/tests/usr.sbin", "/usr/lib/debug/usr/tests/usr.sbin/hwstat"]} | {"/usr/tests/usr.sbin/hwstat": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=hwstat-tests"]}'}, "//conditions:default": {}}),
    mtree_specs = {"//etc/mtree:BSD.tests.dist": "/usr/tests", "//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
