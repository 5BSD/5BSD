load("//tools/build/bazel:bsd_nis.bzl", "nis_runtime_deps", "nis_runtime_linkopts")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_import")
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_spec", "bsd_dtrace_cc_objects")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_link")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
bsd_dtrace_spec(name = "provider", source = "inetd_provider.d", output = "inetd_provider.o",
    flags = ["-C", "-x", "nolibs"], static_anchor = False, object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:bootstrap", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti",
    runtime_libraries = ["//cddl/usr.sbin/dtrace:bootstrap_runtime"],
    tool_inputs = [ "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"])

_WRAP = "//tools/build/bazel/config:tcp_wrappers_enabled"
_LIBRARIES = ["//lib/libutil:util"] + select({_WRAP: ["//lib/libwrap:wrap"], "//conditions:default": []}) + ["//lib/libipsec:ipsec"]
cc_library(name = "headers", hdrs = ["inetd.h", "inetd_probes.h", "pathnames.h"], strip_include_prefix = ".")
cc_library(name = "objects", srcs = ["inetd.c", "builtins.c"], deps = [":headers"] + _LIBRARIES,
    local_defines = ["LOGIN_CAP", "IPSEC"] + select({_WRAP: ["LIBWRAP"], "//conditions:default": []}) + select({"//tools/build/bazel/config:inet6_support_enabled": ["INET6"], "//conditions:default": []}) + select({_TRACE: ["WITH_DTRACE"], "//conditions:default": []}),
    copts = ["-fPIE"], target_compatible_with = _PLATFORM)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider",
    provider_object = "inetd_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group) for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"], deps = [":provider_link"] + _LIBRARIES)
cc_binary(name = "inetd", deps = select({_TRACE: [":traced"], "//conditions:default": [":objects"]}) + nis_runtime_deps(),
    dynamic_deps = ["//lib/libutil:util_shared"] + select({_WRAP: ["//lib/libwrap:wrap_shared"], "//conditions:default": []}) + ["//lib/libipsec:ipsec_shared"], linkopts = ["-pie"] + nis_runtime_linkopts(), target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_install_file(name = "extra", src = "inetd.conf", destination = "/etc/inetd.conf", owner = "root", group = "wheel", mode = "0644", install_tags = ["package=inetd", "config"])
bsd_install_link(manual = True, name = "config_manual", destination = "/usr/share/man/man5/inetd.conf.5.gz", target = "/usr/share/man/man8/inetd.8.gz", kind = "hardlink", owner = "root", group = "wheel", mode = "0444", install_tags = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=inetd-man"], "//conditions:default": ["package=inetd"]}))
utility_installation(name = "install_manifest", program = "inetd", manual = "inetd.8", man_section = "8", package = "inetd", bindir = "/usr/sbin", extra_entries = [":extra", ":config_manual"])
bsd_install_archive(name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=inetd","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]} | {"/etc": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities"]}'},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
