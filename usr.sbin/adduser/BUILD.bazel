load("//tools/build/bazel:bsd_script_installation.bzl", "script_installation", "script_install_archive")
script_installation(name = "install_manifest", scripts = {"adduser.sh": "/usr/sbin/adduser", "rmuser.sh": "/usr/sbin/rmuser"},
    manuals = ["adduser.conf.5", "adduser.8", "rmuser.8"], package = "utilities", files = {})
script_install_archive(name = "production_install_archive")
alias(name = "install_archive", actual = ":production_install_archive", visibility = ["//visibility:public"])
