load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
cc_binary(name = "alternate_test", srcs = ["alternate_test.c"],
    deps = ["//lib/atf/libatf-c:atf_c"], dynamic_deps = ["//lib/atf/libatf-c:atf_c_shared"],
    copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
CASES = ["explicit_shell_policy", "directory_alias_updates", "in_place_input_metadata", "alternate_uid_update", "alternate_duplicate_uid", "malformed_update_retains_database"]
[bsd_atf_test(
    name = "native_" + case,
    case_name = case,
    interface = "program",
    body = ":alternate_test",
    loader = "//libexec/rtld-elf:rtld_binary",
    config_files = {"//usr.sbin/pwd_mkdb:pwd_mkdb": "pwd_mkdb", "//libexec/rtld-elf:rtld_binary": "pwd_mkdb_loader"},
    runtime_lib = ["//lib/atf/libatf-c:atf_c_shared", "//lib/libc:c_shared", "//lib/libsys:sys_shared"],
    runner = "//tools/build/bazel:atf_runner",
    size = "small",
) for case in CASES]
test_suite(name = "tests", tests = [":native_" + case for case in CASES], visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_kyuafile")
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["alternate_test"], interfaces = {"alternate_test": "atf"})
bsd_install_file(name = "install_kyuafile", src = ":kyuafile", destination = "/usr/tests/usr.sbin/pwd_mkdb/Kyuafile",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=runtime-tests"])
utility_installation(name = "install_manifest", program = "alternate_test", manual = None,
    package = "runtime-tests", bindir = "/usr/tests/usr.sbin/pwd_mkdb", extra_entries = [":install_kyuafile"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {
        "/usr/lib/debug/usr": "{\"owner\":\"root\",\"group\":\"wheel\",\"mode\":\"0755\",\"tags\":[\"package=runtime-tests\",\"dbg\"]}",
        "/usr/lib/debug/usr/tests": "{\"owner\":\"root\",\"group\":\"wheel\",\"mode\":\"0755\",\"tags\":[\"package=runtime-tests\",\"dbg\"]}",
        "/usr/lib/debug/usr/tests/usr.sbin": "{\"owner\":\"root\",\"group\":\"wheel\",\"mode\":\"0755\",\"tags\":[\"package=runtime-tests\",\"dbg\"]}",
        "/usr/lib/debug/usr/tests/usr.sbin/pwd_mkdb": "{\"owner\":\"root\",\"group\":\"wheel\",\"mode\":\"0755\",\"tags\":[\"package=runtime-tests\",\"dbg\"]}",
        "/usr/tests/usr.sbin/pwd_mkdb": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime-tests"]}',
    },
    mtree_specs = {
        "//etc/mtree:BSD.tests.dist": "/usr/tests",
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
