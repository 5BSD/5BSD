# Runtime program requirements are explicit fixture inputs, never host PATH fallback.
_REQUIRED_PROGRAMS = ["[", "awk", "basename", "cat", "chmod", "chown", "cmp", "cp", "cut", "dd", "df", "diff", "dirname", "du", "dumpfs", "echo", "find", "grep", "head", "id", "install", "jot", "kldstat", "ln", "ls", "makefs", "md5", "mdconfig", "mkdir", "mkfifo", "mktemp", "mount", "mount_cd9660", "mount_msdosfs", "mtree", "newfs", "pwd_mkdb", "rm", "rmdir", "sed", "seq", "sh", "sort", "stat", "strings", "su", "sync", "tail", "tar", "test", "touch", "tr", "truncate", "tunefs", "umount", "uname", "uniq", "wc", "zdb", "zfs", "zpool", "zsh"]
write_file(name = "runtime_suite_inventory", out = "runtime_suite_inventory.json",
    content = select({"//tools/build/bazel/config:zfs_enabled": [json.encode({"format": 1, "required_programs": _REQUIRED_PROGRAMS, "suites": _RUNTIME_SUITES})],
        "//conditions:default": [json.encode({"format": 1, "required_programs": _REQUIRED_PROGRAMS, "suites": {name: value for name, value in _RUNTIME_SUITES.items() if name != "makefs_zfs_tests"}})]}),
    visibility = ["//tools/build/bazel:__pkg__"])
exports_files(["makefs_cd9660_tests.sh", "makefs_ffs_tests.sh", "makefs_msdos_tests.sh", "makefs_zfs_tests.sh"], visibility = ["//tools/build/bazel:__pkg__"])

load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
# Runtime argv[0] alias; the production package retains its maintained hardlink.
copy_file(name = "bracket_runtime", src = "//bin/test:test", out = "[", is_executable = True, visibility = ["//tools/build/bazel:__pkg__"])
