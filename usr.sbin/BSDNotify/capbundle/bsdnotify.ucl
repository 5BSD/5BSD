# Two endpoints (docs/book/src/plane/attributes.md, "bsdnotify"):
#   system.Notify        open tier, subject to discovery visibility
#   system.Notify.System requires the client software attribute
#                        system.notify.system (SwitchBoard enforces admission;
#                        the daemon selects its tier from the endpoint name)
activation {
	boot = true;
	ipc = [
		"system.Notify",
		{ name = "system.Notify.System"; requires = ["system.notify.system"]; },
	];
}
control = "system";
protect = ["ptrace", "signal", "wait", "sigkill", "sigcont", "sched", "core", "ktrace"];
program = "BSDNotify";
# Notifications are user-facing, so ordinary clients can discover the open
# endpoint in the user domain. Visibility does not grant software attributes.
visible = ["user"];
restart = "on-failure";
user = "capability";

limits { nofile = 1024; nproc = 64; core = 0; }
umask = "0077";
