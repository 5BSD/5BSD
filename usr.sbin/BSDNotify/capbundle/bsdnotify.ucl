# Two endpoints (docs/ipc-anointments-design.md, "bsdnotify"):
#   system.Notify        open tier, resolvable by every session
#   system.Notify.System gated tier, only for callers anointed with
#                        system.notify.system (switchboard enforces reach;
#                        the daemon picks the tier from the endpoint name)
activation {
	boot = true;
	ipc = [
		"system.Notify",
		{ name = "system.Notify.System"; requires = ["system.notify.system"]; },
	];
}
management = "system";
protect = ["ptrace", "signal", "wait", "sigkill", "sigcont", "sched", "core", "ktrace"];
program = "BSDNotify";
# Notifications are user-facing: a login session must reach system.Notify, so
# its name is resolvable through narrowed USER-domain lookup channels (formerly
# switchboard's hardcoded user-allow-list).
resolvable_by = ["user"];
restart = "on-failure";
user = "capability";

limits { nofile = 1024; nproc = 64; core = 0; }
umask = "0077";
