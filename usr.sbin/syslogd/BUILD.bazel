load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_import")
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_spec", "bsd_dtrace_cc_objects")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_compress")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

_TRACE = "//tools/build/bazel/config:dtrace_enabled"
_CASPER = "//tools/build/bazel/config:casper_enabled"
_PLATFORM = ["@platforms//os:freebsd"]
_LIBRARIES = ["//lib/libutil:util"] + select({
    _CASPER: ["//lib/libcasper/services/cap_net:cap_net", "//lib/libcasper/libcasper:casper", "//lib/libnv:nv"],
    "//conditions:default": [],
})
_SHARED = ["//lib/libutil:util_shared"] + select({
    _CASPER: ["//lib/libcasper/services/cap_net:cap_net_shared", "//lib/libcasper/libcasper:casper_shared", "//lib/libnv:nv_shared"],
    "//conditions:default": [],
})

bsd_dtrace_spec(
    name = "provider", source = "syslogd_provider.d", output = "syslogd_provider.o",
    flags = ["-C", "-x", "nolibs"], static_anchor = False, object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:bootstrap", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti", runtime_libraries = ["//cddl/usr.sbin/dtrace:bootstrap_runtime"],
    tool_inputs = ["@bsd_sdk//toolchain:compile_inputs", "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"],
)
cc_library(name = "headers", hdrs = ["syslogd.h", "syslogd_cap.h", "syslogd_probes.h", "pathnames.h"],
    strip_include_prefix = ".", deps = ["//lib/libcasper/services/cap_net:headers"])
cc_library(
    name = "objects",
    srcs = ["syslogd.c", "//usr.bin/wall:ttymsg.c"] + select({
        _CASPER: ["syslogd_cap.c", "syslogd_cap_config.c", "syslogd_cap_log.c"],
        "//conditions:default": [],
    }),
    deps = [":headers", "//usr.bin/wall:ttymsg_header"] + _LIBRARIES,
    local_defines = select({_TRACE: ["WITH_DTRACE"], "//conditions:default": []}) +
        select({_CASPER: ["WITH_CASPER"], "//conditions:default": []}) +
        select({"//tools/build/bazel/config:inet_support_enabled": ["INET"], "//conditions:default": []}) +
        select({"//tools/build/bazel/config:inet6_support_enabled": ["INET6"], "//conditions:default": []}),
    copts = ["-fPIE"], alwayslink = True, target_compatible_with = _PLATFORM,
)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider",
    provider_object = "syslogd_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group)
 for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"],
    alwayslink = True, deps = [":provider_link"] + _LIBRARIES)
cc_binary(name = "syslogd", deps = select({_TRACE: [":traced"], "//conditions:default": [":objects"]}),
    dynamic_deps = _SHARED, linkopts = ["-pie"], target_compatible_with = _PLATFORM,
    visibility = ["//visibility:public"])

bsd_install_file(name = "syslog_config", src = "syslog.conf", destination = "/etc/syslog.conf",
    owner = "root", group = "wheel", mode = "0644", install_tags = ["package=syslogd", "config"])
[bsd_install_file(name = p + "_config", src = p + ".conf", destination = "/etc/syslog.d/" + p + ".conf",
    owner = "root", group = "wheel", mode = "0644", install_tags = ["package=" + package, "config"])
 for p, package in [("lpr", "lp"), ("ppp", "ppp")]]
bsd_compress(name = "manual5", src = "syslog.conf.5", output = "syslog.conf.5.gz", arguments = ["-cn"],
    compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect",
    runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(manual = True, name = "config_manual", src = ":manual5", destination = "/usr/share/man/man5/syslog.conf.5.gz",
    owner = "root", group = "wheel", mode = "0444", install_tags = select({
        "//tools/build/bazel/config:split_manpages_enabled": ["package=syslogd-man"],
        "//conditions:default": ["package=syslogd"],
    }))
utility_installation(name = "install_manifest", program = "syslogd", manual = "syslogd.8",
    package = "syslogd", bindir = "/usr/sbin", man_section = "8",
    extra_entries = [":syslog_config", ":config_manual"] +
        select({"//tools/build/bazel/config:lpr_enabled": [":lpr_config"], "//conditions:default": []}) +
        select({"//tools/build/bazel/config:ppp_enabled": [":ppp_config"], "//conditions:default": []}))
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"] + select({
        "//tools/build/bazel/config:tests_enabled": ["//usr.sbin/syslogd/tests:install_manifest"],
        "//conditions:default": [],
    }),
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=syslogd","dbg"]}'
        for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]} |
        {"/etc": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities"]}',
         "/etc/syslog.d": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities"]}'} |
        select({"//tools/build/bazel/config:tests_enabled": {
            "/usr/tests/usr.sbin/syslogd": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests"]}',
        }, "//conditions:default": {}}),
    mtree_specs = {"//etc/mtree:BSD.tests.dist": "/usr/tests", "//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"],
)
