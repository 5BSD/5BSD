# serviced unit for the storage substrate (tzfsd), the [TZFS] broker that owns
# the pool, the /Capabilities layout and the flavor templates.  Launched and
# supervised by serviced like every other daemon (docs/capability-authority-
# model.md, P4a) — PID 1 no longer spawns it.
#
# No `ipc`: tzfsd is reached over its own endpoint, not a serviced-brokered
# name, so readiness is the cap_enter() (NOTE_CAPMODE) boundary serviced already
# observes.  boot = true because nothing looks the service up to trigger an
# on-demand launch; it must come up on its own.  user = root because the ZFS
# control device (/dev/zfs) and dataset provisioning require it (tzfsd drops into
# its own capability sandbox once that name-based work is done).
activation { boot = true; }
program = "tzfsd";
restart = "on-failure";
user = "root";

limits { nofile = 4096; nproc = 128; core = 0; }
umask = "0022";
