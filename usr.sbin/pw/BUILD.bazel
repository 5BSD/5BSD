# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = "pw", srcs = ["pw.c", "pw_conf.c", "pw_user.c", "pw_group.c", "pw_log.c", "pw_nis.c", "pw_vpw.c", "grupd.c", "pwupd.c", "psdate.c", "bitmap.c", "cpdir.c", "rm_r.c", "strtounum.c", "pw_utils.c", "psdate.h", "bitmap.h", "pw.h", "pwupd.h"],
    deps = ["//lib/libcrypt:crypt", "//lib/libutil:util"],
    dynamic_deps = ["//lib/libcrypt:crypt_shared", "//lib/libutil:util_shared"],
    copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install.bzl", "bsd_compress", "bsd_install_file")
bsd_compress(name = "config_manual", src = "pw.conf.5", output = "pw.conf.5.gz", arguments = ["-cn"],
    compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect",
    runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(name = "config_manual_file", src = ":config_manual", destination = "/usr/share/man/man5/pw.conf.5.gz",
    owner = "root", group = "wheel", mode = "0444", install_tags = select({
        "//tools/build/bazel/config:split_manpages_enabled": ["package=runtime-man"], "//conditions:default": ["package=runtime"]}))
utility_installation(name = "install_manifest", program = "pw", manual = "pw.8", man_section = "8",
    package = "runtime", bindir = "/usr/sbin", extra_entries = [":config_manual_file"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "test_headers", hdrs = ["pw.h", "pwupd.h"], strip_include_prefix = ".", visibility = ["//usr.sbin/pw/tests:__pkg__"])
exports_files(["pw_utils.c", "strtounum.c"], visibility = ["//usr.sbin/pw/tests:__pkg__"])
