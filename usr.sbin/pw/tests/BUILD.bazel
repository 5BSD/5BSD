exports_files(["crypt.c"], visibility = ["//libexec/nuageinit/tests:__pkg__"])

load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
cc_binary(name = "pw_unit_test", srcs = ["pw_unit_test.c", "//usr.sbin/pw:pw_utils.c", "//usr.sbin/pw:strtounum.c"],
    deps = ["//usr.sbin/pw:test_headers", "//lib/libutil:util", "//lib/atf/libatf-c:atf_c"],
    dynamic_deps = ["//lib/libutil:util_shared", "//lib/atf/libatf-c:atf_c_shared"],
    copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
_CASES = ["checkfd_dash", "checkfd_zero", "checkfd_valid", "checkfd_max", "checkfd_invalid", "checkfd_negative", "checkfd_overflow"]
[bsd_atf_test(name = case, case_name = case, interface = "program", body = ":pw_unit_test",
    loader = "//libexec/rtld-elf:rtld_binary",
    runtime_lib = ["//lib/libc:c_shared", "//lib/libsys:sys_shared", "//lib/libutil:util_shared", "//lib/atf/libatf-c:atf_c_shared"],
    runner = "//tools/build/bazel:atf_runner", size = "small") for case in _CASES]
test_suite(name = "unit_tests", tests = [":" + case for case in _CASES], visibility = ["//visibility:public"])
