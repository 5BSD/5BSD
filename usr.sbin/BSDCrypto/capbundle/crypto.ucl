# [CRYPTO] is the local authority-replacement provider for DTYPE_CRYPTO.
activation { boot = true; ipc = ["system.Crypto"]; }
management = "system";
protect = ["ptrace", "signal", "wait", "sigkill", "sigcont", "sched", "core", "ktrace"];
program = "BSDCrypto";
# Born in capability mode: switchboard delivers /dev as a directory descriptor so
# the provider opens /dev/crypto with openat(2), never a global path.
# /Capabilities/{System,Apps}: the key-reclaim child reconciles the kernel
# keystore's owners against the installed bundles through these delivered
# descriptors (it is born in capability mode too; System/ gates readiness).
directories = ["/dev", "/Capabilities/System", "/Capabilities/Apps", "/Capabilities/Run/live"];
restart = "on-failure";
# cryptodev snapshots PRIV_DRIVER when the control descriptor is opened.
# Keep the kernel gate intact: this factory opens it as root, then applies
# NOPRIVS and serves clients through owner-scoped, confined workers.
# It remains born in capability mode; no global-namespace exception is needed.
user = "root";

# RLIMIT_NPROC counts every process with the same real UID, including system
# daemons. Leave room for those processes after the factory drops privileges.
limits { nofile = 512; nproc = 1024; core = 0; }
umask = "0077";
# The DTYPE_CRYPTO provider needs /dev/crypto (from the cryptodev module).  It
# self-serves that module at startup via service_ensure_extension(3) over
# system.SystemExtension (sysextd), so no manifest kmod declaration is needed and
# neither PID 1 nor switchboard loads modules on its behalf.
