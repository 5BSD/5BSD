# [CRYPTO] is the local authority-replacement provider for DTYPE_CRYPTO.
activation { boot = true; ipc = ["system.Crypto"]; }
# The cross-owner control supervisor is part of the Core trusted base.
control = "core";
protect = ["ptrace", "signal", "wait", "sigkill", "sigcont", "sched", "core", "ktrace"];
program = "BSDCrypto";
# Capsule boot policy supplies the bounded crypto-control descriptor.
# /Capabilities/{System,Apps}: the key-reclaim child reconciles the kernel
# keystore's owners against the installed bundles through these delivered
# descriptors (it is born in capability mode too; System/ gates readiness).
directories = [ "/Capabilities/System", "/Capabilities/Apps", "/Capabilities/Run/live"];
restart = "on-failure";
# User identity does not grant Crypto control authority.
user = "root";

# RLIMIT_NPROC counts every process with the same real UID, including system
# daemons. Leave room for those processes after the factory drops privileges.
limits { nofile = 512; nproc = 1024; core = 0; }
umask = "0077";
# cryptodev must be built in or authenticated at boot; no self-loading fallback.
