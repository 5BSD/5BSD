# This parent owns nvram(8), including on architectures without nvram(8) binary.
bsd_compress(name = "nvram_manual_gz", src = "nvram/nvram.8", output = "nvram.8.gz",
    arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip",
    redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(name = "nvram_manual", src = ":nvram_manual_gz",
    destination = "/usr/share/man/man8/nvram.8.gz", owner = "root", group = "wheel", mode = "0444",
    install_tags = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=utilities-man"],
        "//conditions:default": ["package=utilities"]}))
bsd_install_manifest(name = "manual_manifest", entries = [":nvram_manual"])
script_install_archive(name = "manual_install_archive", manifest = ":manual_manifest")

# Missing optional subtrees and installed tests remain explicit migration work.
# Reject their selection rather than silently omitting their Make-owned outputs.
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
_PLATFORM = _PLATFORM + select({"//tools/build/bazel/config:sendmail_enabled": ["@platforms//:incompatible"], "//conditions:default": []})
_PLATFORM = _PLATFORM + select({"//tools/build/bazel/config:tests_enabled": ["@platforms//:incompatible"], "//conditions:default": []})
bsd_install_archive_set(name = "production_installation_archives", archives = _ARCHIVES,
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

# Construction also preserves selected internal libraries without inventing
# installed payloads. Select the typed installation sibling for metadata capture.
filegroup(name = "production_programs", srcs = [":production_installation_archives"] + select({
    "//tools/build/bazel/config:lpr_enabled": ["//usr.sbin/lpr:build_libraries"], "//conditions:default": [],
}), target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
