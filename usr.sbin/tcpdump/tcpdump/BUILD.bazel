    'ofp_map.c',
    'print-udpencap.c',
    'print-carp.c',
    'print-nhrp.c',
    'print-wg.c',
    'print-802_11.c',
    'print-iapp.c',
    'print-mpls.c',
    'print-slow.c',
    'print-usbpcap.c',
    'gmt2local.c',
    'savestr.c',
    'setsignal.c',
    'in_cksum.c',
    'bpf_dump.c',
]
cc_binary(name = "tcpdump", srcs = ["//contrib/openbsd-pf/usr.sbin/tcpdump:" + source for source in _SOURCES] + ["privsep_5bsd.c"] +
    ["//contrib/openbsd-pf/usr.sbin/tcpdump:" + source for source in ["print-pflog.c", "print-pfsync.c", "pf_print_state.c"]] +
    ["//contrib/openbsd-pf/sys/net:pf_osfp.c", "//contrib/openbsd-pf/usr.sbin/tcpdump:pfctl_osfp.c"],
    deps = [":headers", "//lib/libpcap:pcap", "//secure/lib/libcrypto:crypto"],
    dynamic_deps = ["//lib/libpcap:pcap_shared", "//secure/lib/libcrypto:crypto_shared"],
    local_defines = ["FAKE_PF_KERNEL", "CSLIP", "PPP", "HAVE_FDDI", "ETHER_SERVICE", "HAVE_ETHER_NTOHOST"] + select({"//tools/build/bazel/config:inet6_support_enabled": ["INET6"], "//conditions:default": []}),
    copts = ["-fPIE", "-DPIC", "-std=gnu17", "-include", "lib/libpcap/config.h", "-include", "usr.sbin/tcpdump/tcpdump/openbsd_compat.h",
        "-Wno-pointer-sign", "-Wno-sign-compare", "-Wno-incompatible-pointer-types-discards-qualifiers", "-Wno-address-of-packed-member", "-Wno-unused-but-set-variable", "-Wno-deprecated-declarations"],
    linkopts = ["-pie"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "tcpdump", manual = "//contrib/openbsd-pf/usr.sbin/tcpdump:tcpdump.8", man_section = "8", package = "utilities", bindir = "/usr/sbin")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", epoch = 0,
    mtree = "@bsd_sdk//toolchain:extra_mtree", python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_python_test.bzl", "bsd_python_test")
filegroup(name = "test_program_runtime", testonly = True, srcs = ["//lib/libc:c_shared", "//lib/libsys:sys_shared", "@bsd_sdk//toolchain:sysroot/lib/libgcc_s.so.1"] + ["//lib/libpcap:pcap_shared", "//secure/lib/libcrypto:crypto_shared", "//lib/libthr:thr_shared"] +
        select({"//tools/build/bazel/config:ofed_enabled": ["//lib/ofed/libibverbs:ibverbs_shared", "//lib/ofed/libbnxtre:bnxtre_shared", "//lib/ofed/libmlx5:mlx5_shared"], "//conditions:default": []}))
bsd_python_test(name = "offline_test", src = "offline-test.py", data = [":tcpdump"] + [":test_program_runtime"],
    runtime = ["@bsd_sdk//toolchain:python_stdlib"],
    args = ["--program-runtime", "$(locations :test_program_runtime)"],
    visibility = ["//visibility:public"])
