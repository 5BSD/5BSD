load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
exports_files(["logctl.c"], visibility = ["//usr.sbin/logctl/tests:__pkg__"])
cc_binary(name = "logctl", srcs = ["logctl.c", "//usr.sbin/BSDLog:config.c"], deps = ["//usr.sbin/BSDLog:config_headers", "//lib/liblogcmp:logcmp", "//lib/libucl:ucl"], dynamic_deps = ["//lib/liblogcmp:logcmp_shared", "//lib/libucl:ucl_shared"], copts = ["-fPIE"], linkopts = ["-pie"], linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
utility_installation(name = "install_manifest", program = "logctl", manual = "logctl.8", package = "bsdlog", bindir = "/usr/sbin", man_section = "8", aliases = [], extra_entries = [])
bsd_install_archive(name = "install_archive",
    manifests = [":install_manifest"] + select({"//tools/build/bazel/config:tests_enabled": ["//usr.sbin/logctl/tests:install_manifest", "//usr.sbin/logctl/tests:install_real", "//usr.sbin/logctl/tests:install_fake"], "//conditions:default": []}),
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bsdlog","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]} | select({"//tools/build/bazel/config:tests_enabled": {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bsdlog-tests","dbg"]}' for d in ["/usr/lib/debug/usr/tests", "/usr/lib/debug/usr/tests/usr.sbin", "/usr/lib/debug/usr/tests/usr.sbin/logctl"]} | {"/usr/tests/usr.sbin/logctl": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bsdlog-tests"]}'}, "//conditions:default": {}}),
    mtree_specs = {"//etc/mtree:BSD.tests.dist": "/usr/tests", "//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
