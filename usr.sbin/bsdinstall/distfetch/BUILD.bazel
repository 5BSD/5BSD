load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
cc_binary(name = "distfetch", srcs = ['distfetch.c'], deps = ['//lib/libfetch:fetch', '//lib/libbsddialog:bsddialog', '//usr.sbin/bsdinstall/include:headers'], dynamic_deps = ['//lib/libfetch:fetch_shared', '//lib/libbsddialog:bsddialog_shared'], copts = ["-fPIE"], linkopts = ["-pie"], linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
utility_installation(name = "install_manifest", program = "distfetch", manual = None, package = "bsdinstall", bindir = "/usr/libexec/bsdinstall", man_section = "8", aliases = [], extra_entries = [])
bsd_install_archive(name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bsdinstall","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/libexec", "/usr/lib/debug/usr/libexec/bsdinstall"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
