load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
cc_binary(name = "partedit", srcs = ['diskmenu.c', 'partedit.c', 'gpart_ops.c', 'partedit_x86.c', 'part_wizard.c', 'scripted.c', 'diskmenu.h', 'partedit.h'], deps = ['//lib/libgeom:geom', '//lib/libutil:util', '//lib/libbsddialog:bsddialog', '//usr.sbin/bsdinstall/include:headers'], dynamic_deps = ['//lib/libgeom:geom_shared', '//lib/libutil:util_shared', '//lib/libbsddialog:bsddialog_shared'], copts = ["-fPIE"], linkopts = ["-pie"], linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_install.bzl", "bsd_compress", "bsd_install_file", "bsd_install_link")
bsd_compress(name = "manual", src = "sade.8", output = "sade.8.gz", arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(manual = True, name = "manual_file", src = ":manual", destination = "/usr/share/man/man8/sade.8.gz", owner = "root", group = "wheel", mode = "0444", install_tags = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=bsdinstall-man"], "//conditions:default": ["package=bsdinstall"]}))
[bsd_install_link(name = alias, destination = "/usr/libexec/bsdinstall/" + alias, target = "/usr/libexec/bsdinstall/partedit", kind = "hardlink", owner = "root", group = "wheel", mode = "0555", install_tags = ["package=bsdinstall"]) for alias in ["autopart", "scriptedpart"]]
bsd_install_link(name = "sade", destination = "/usr/sbin/sade", target = "../libexec/bsdinstall/partedit", kind = "symlink", owner = "root", group = "wheel", mode = "0755", install_tags = ["package=bsdinstall"])
utility_installation(name = "install_manifest", program = "partedit", manual = None, package = "bsdinstall", bindir = "/usr/libexec/bsdinstall", man_section = "8", aliases = [], extra_entries = [":manual_file", ":autopart", ":scriptedpart", ":sade"])
bsd_install_archive(name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bsdinstall","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/libexec", "/usr/lib/debug/usr/libexec/bsdinstall"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
