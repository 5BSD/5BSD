#!/bin/sh
#-
# SPDX-License-Identifier: BSD-2-Clause
#
# Configure the principal-to-capability policy in a newly installed system.

set -f

BSDCFG_SHARE="/usr/share/bsdconfig"
. $BSDCFG_SHARE/common.subr || exit 1

: ${BSDDIALOG_OK=0}
: ${BSDINSTALL_CHROOT=/mnt}
: ${BSDINSTALL_TMPETC=/tmp/bsdinstall_etc}

policy_dir="$BSDINSTALL_CHROOT/Capabilities/Config"
policy_file="$policy_dir/principal-policy.ucl"
passwd_file="$BSDINSTALL_CHROOT/etc/master.passwd"
group_file="$BSDINSTALL_CHROOT/etc/group"
users_state="$BSDINSTALL_TMPETC/capability-policy.users"
groups_state="$BSDINSTALL_TMPETC/capability-policy.groups"
manage_state="$BSDINSTALL_TMPETC/capability-policy.manage"
compat_state="$BSDINSTALL_TMPETC/capability-policy.compat"

fail()
{
	if [ "${BSDINSTALL_CAPABILITY_POLICY_NONINTERACTIVE:-}" = yes ]; then
		echo "capabilitypolicy: $*" >&2
	else
		bsddialog --backtitle "$OSNAME Installer" \
		    --title "Invalid Capability Policy" \
		    --msgbox "$*" 0 0
	fi
	return 1
}

append_unique()
{
	local list="$1" value="$2"

	case " $list " in
	*" $value "*)	printf '%s' "$list" ;;
	*)		printf '%s%s%s' "$list" "${list:+ }" "$value" ;;
	esac
}

lookup_user_uid()
{
	local value="$1"

	case "$value" in
	""|*[!A-Za-z0-9_.-]*)
		return 1
		;;
	*[!0-9]*)
		awk -F: -v name="$value" '$1 == name { print $3; found=1; exit }
		    END { if (!found) exit 1 }' "$passwd_file"
		;;
	*)
		awk -F: -v uid="$value" '$3 == uid { print $3; found=1; exit }
		    END { if (!found) exit 1 }' "$passwd_file"
		;;
	esac
}

lookup_group_name()
{
	local value="$1"

	case "$value" in
	""|*[!A-Za-z0-9_.-]*)
		return 1
		;;
	esac
	awk -F: -v name="$value" '$1 == name { print $1; found=1; exit }
	    END { if (!found) exit 1 }' "$group_file"
}

write_policy()
{
	local user_input="$1" group_input="$2" manage_input="$3" compat="$4"
	local entry uid group uids="" groups="" managers="" tmp separator

	case "$compat" in
	yes) uids="0"; groups="wheel" ;;
	no) ;;
	*) fail "Compatibility must be yes or no."; return 1 ;;
	esac

	[ -r "$passwd_file" ] || {
		fail "The installed user database is unavailable."
		return 1
	}
	[ -r "$group_file" ] || {
		fail "The installed group database is unavailable."
		return 1
	}

	user_input=$(printf '%s' "$user_input" | tr ',' ' ')
	group_input=$(printf '%s' "$group_input" | tr ',' ' ')
	for entry in $user_input; do
		uid=$(lookup_user_uid "$entry") || {
			fail "User or UID '$entry' does not exist in the installed system."
			return 1
		}
		uids=$(append_unique "$uids" "$uid")
	done
	manage_input=$(printf '%s' "$manage_input" | tr ',' ' ')
	for entry in $manage_input; do
		uid=$(lookup_user_uid "$entry") || {
			fail "User or UID '$entry' does not exist in the installed system."
			return 1
		}
		managers=$(append_unique "$managers" "$uid")
	done
	for entry in $group_input; do
		group=$(lookup_group_name "$entry") || {
			fail "Group '$entry' does not exist in the installed system."
			return 1
		}
		groups=$(append_unique "$groups" "$group")
	done

	umask 022
	mkdir -p "$policy_dir" || return 1
	tmp=$(mktemp "$policy_file.new.XXXXXXXX") || return 1
	trap 'rm -f "$tmp"' EXIT HUP INT TERM
	{
		echo "# Principal-to-capability policy generated by the 5BSD Installer."
		echo "# Full-access principals receive all anointments and provider ADMIN."
		echo "# CORE services remain unmanageable at runtime, including by administrators."
		echo "principals {"
		if [ -n "$uids$groups" ]; then
			echo "    admin {"
			printf '        uids = ['
			separator=
			for uid in $uids; do
				printf '%s %s' "$separator" "$uid"
				separator=,
			done
			echo " ];"
			printf '        groups = ['
			separator=
			for group in $groups; do
				printf '%s \"%s\"' "$separator" "$group"
				separator=,
			done
			echo " ];"
			echo '        anointments = [ "*" ];'
			echo "        admin_rights = true;"
			echo "    }"
		fi
		if [ -n "$managers" ]; then
			echo "    management {"
			printf '        uids = ['
			separator=
			for uid in $managers; do
				printf '%s %s' "$separator" "$uid"
				separator=,
			done
			echo " ];"
			echo '        anointments = [ "system.switchboard.admin" ];'
			echo '        admin_rights = false;'
			echo "    }"
		fi
		echo "    default {"
		echo "        anointments = [];"
		echo "    }"
		echo "}"
	} > "$tmp" || return 1
	chmod 0644 "$tmp" || return 1
	mv -f "$tmp" "$policy_file" || return 1
	trap - EXIT HUP INT TERM

	mkdir -p "$BSDINSTALL_TMPETC" || return 1
	printf '%s\n' "$1" > "$users_state"
	printf '%s\n' "$2" > "$groups_state"
	printf '%s\n' "$3" > "$manage_state"
	printf '%s\n' "$4" > "$compat_state"
}

if [ "${BSDINSTALL_CAPABILITY_POLICY_NONINTERACTIVE:-}" = yes ]; then
	write_policy "${BSDINSTALL_CAPABILITY_ADMIN_USERS:-}" \
	    "${BSDINSTALL_CAPABILITY_ADMIN_GROUPS:-}" \
	    "${BSDINSTALL_CAPABILITY_MANAGE_USERS:-}" \
	    "${BSDINSTALL_CAPABILITY_COMPAT:-yes}"
	exit $?
fi

# Offer accounts from the target database, never from the installer host.
# Numeric tags avoid interpolating account names into policy syntax.
select_accounts()
{
	local title="$1" description="$2" selected="$3" name uid rest state seen=""

	set --
	while IFS=: read -r name rest uid rest; do
		case "$name" in ""|*[!A-Za-z0-9_.-]*) continue ;; esac
		case "$uid" in ""|*[!0-9]*) continue ;; esac
		# Aliases such as root/toor are one policy principal, not two tags.
		case " $seen " in *" $uid "*) continue ;; esac
		seen="$seen $uid"
		state=off
		case " $selected " in *" $uid "*|*" $name "*) state=on ;; esac
		set -- "$@" "$uid" "$name (UID $uid)" "$state"
	done < "$passwd_file"
	bsddialog --backtitle "$OSNAME Installer" --title "$title" \
	    --checklist "$description" 0 0 0 "$@"
}

users=$(cat "$users_state" 2>/dev/null)
manage=$(cat "$manage_state" 2>/dev/null)
compat=$(cat "$compat_state" 2>/dev/null)
: ${compat:=yes}

bsddialog --backtitle "$OSNAME Installer" \
    --title "Capability Permissions" --msgbox \
    "Choose capability permissions after creating accounts. Accounts sharing a UID share capability grants and appear once. Ordinary UNIX file permissions and root's UNIX privileges are unchanged.

Administrators can manage SYSTEM daemons using the system.switchboard.admin anointment. This alone does not grant access to other protected endpoints.

Full access (*) grants every anointment, provider ADMIN, and the ability to establish sessions as other users. CORE daemons cannot be managed at runtime by anyone, including root and system administrators.

These choices do not create an owner recovery key or protect boot selection. Custom endpoint grants can be configured in principal-policy.ucl before booting the installed system." 0 0 || exit 0

while :; do
	exec 5>&1
	compat=$(bsddialog --backtitle "$OSNAME Installer" \
	    --title "Root and Wheel Capability Access" --default-item "$compat" \
	    --menu "Should root and all wheel members receive full capability access? Select no to grant permissions only to the accounts selected next. A root UID alone then grants no capability authority." \
	    0 0 0 yes "Compatibility: root and wheel have full access" \
	    no "Explicit grants: no automatic root or wheel access" 2>&1 1>&5)
	result=$?
	exec 5>&-
	[ "$result" -eq "$BSDDIALOG_OK" ] || exit 0

	exec 5>&1
	users=$(select_accounts "Full Capability Access" \
	    "Select accounts to receive all anointments (*), provider ADMIN, and session impersonation authority. Leave all unchecked to add no full-access accounts." \
	    "$users" 2>&1 1>&5)
	result=$?
	exec 5>&-
	[ "$result" -eq "$BSDDIALOG_OK" ] || continue
	# bsddialog quotes checklist tags by default. Tags are decimal UIDs only.
	users=$(printf '%s' "$users" | tr -d '\"')

	exec 5>&1
	manage=$(select_accounts "SYSTEM Service Management" \
	    "Select accounts that may start, stop, and configure SYSTEM services, but cannot manage CORE daemons. This grants system.switchboard.admin without provider ADMIN. Full-access accounts already have this permission." \
	    "$manage" 2>&1 1>&5)
	result=$?
	exec 5>&-
	[ "$result" -eq "$BSDDIALOG_OK" ] || continue
	manage=$(printf '%s' "$manage" | tr -d '\"')

	if [ "$compat" = no ] && [ -z "$users$manage" ]; then
		bsddialog --backtitle "$OSNAME Installer" --title "No Capability Grants" \
		    --yesno "No account will receive protected endpoint access or SYSTEM management authority. Ordinary UNIX access remains. Continue with an empty capability policy?" 0 0 || continue
	fi
	write_policy "$users" "" "$manage" "$compat" && exit 0
done
