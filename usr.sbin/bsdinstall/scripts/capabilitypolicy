#!/bin/sh
#-
# SPDX-License-Identifier: BSD-2-Clause
#
# Configure the principal-to-capability policy in a newly installed system.

BSDCFG_SHARE="/usr/share/bsdconfig"
. $BSDCFG_SHARE/common.subr || exit 1

: ${BSDDIALOG_OK=0}
: ${BSDINSTALL_CHROOT=/mnt}
: ${BSDINSTALL_TMPETC=/tmp/bsdinstall_etc}

policy_dir="$BSDINSTALL_CHROOT/Capabilities/Config"
policy_file="$policy_dir/principal-policy.ucl"
passwd_file="$BSDINSTALL_CHROOT/etc/master.passwd"
group_file="$BSDINSTALL_CHROOT/etc/group"
users_state="$BSDINSTALL_TMPETC/capability-policy.users"
groups_state="$BSDINSTALL_TMPETC/capability-policy.groups"

fail()
{
	if [ "${BSDINSTALL_CAPABILITY_POLICY_NONINTERACTIVE:-}" = yes ]; then
		echo "capabilitypolicy: $*" >&2
	else
		bsddialog --backtitle "$OSNAME Installer" \
		    --title "Invalid Capability Administrator" \
		    --msgbox "$*" 0 0
	fi
	return 1
}

append_unique()
{
	local list="$1" value="$2"

	case " $list " in
	*" $value "*)	printf '%s' "$list" ;;
	*)		printf '%s%s%s' "$list" "${list:+ }" "$value" ;;
	esac
}

lookup_user_uid()
{
	local value="$1"

	case "$value" in
	""|*[!A-Za-z0-9_.-]*)
		return 1
		;;
	*[!0-9]*)
		awk -F: -v name="$value" '$1 == name { print $3; found=1; exit }
		    END { if (!found) exit 1 }' "$passwd_file"
		;;
	*)
		awk -F: -v uid="$value" '$3 == uid { print $3; found=1; exit }
		    END { if (!found) exit 1 }' "$passwd_file"
		;;
	esac
}

lookup_group_name()
{
	local value="$1"

	case "$value" in
	""|*[!A-Za-z0-9_.-]*)
		return 1
		;;
	esac
	awk -F: -v name="$value" '$1 == name { print $1; found=1; exit }
	    END { if (!found) exit 1 }' "$group_file"
}

write_policy()
{
	local user_input="$1" group_input="$2"
	local entry uid group uids="0" groups="wheel" tmp separator

	[ -r "$passwd_file" ] || fail "The installed user database is unavailable."
	[ -r "$group_file" ] || fail "The installed group database is unavailable."

	user_input=$(printf '%s' "$user_input" | tr ',' ' ')
	group_input=$(printf '%s' "$group_input" | tr ',' ' ')
	for entry in $user_input; do
		uid=$(lookup_user_uid "$entry") || {
			fail "User or UID '$entry' does not exist in the installed system."
			return 1
		}
		uids=$(append_unique "$uids" "$uid")
	done
	for entry in $group_input; do
		group=$(lookup_group_name "$entry") || {
			fail "Group '$entry' does not exist in the installed system."
			return 1
		}
		groups=$(append_unique "$groups" "$group")
	done

	umask 022
	mkdir -p "$policy_dir" || return 1
	tmp="$policy_file.new.$$"
	trap 'rm -f "$tmp"' EXIT HUP INT TERM
	{
		echo "# Principal-to-capability policy generated by the 5BSD Installer."
		echo "# Listed principals receive a full-discovery SYSTEM session."
		echo "admin {"
		printf '    uids = ['
		separator=
		for uid in $uids; do
			printf '%s %s' "$separator" "$uid"
			separator=,
		done
		echo " ];"
		printf '    groups = ['
		separator=
		for group in $groups; do
			printf '%s \"%s\"' "$separator" "$group"
			separator=,
		done
		echo " ];"
		echo "}"
	} > "$tmp" || return 1
	chmod 0644 "$tmp" || return 1
	mv -f "$tmp" "$policy_file" || return 1
	trap - EXIT HUP INT TERM

	mkdir -p "$BSDINSTALL_TMPETC" || return 1
	printf '%s\n' "$1" > "$users_state"
	printf '%s\n' "$2" > "$groups_state"
}

if [ "${BSDINSTALL_CAPABILITY_POLICY_NONINTERACTIVE:-}" = yes ]; then
	write_policy "${BSDINSTALL_CAPABILITY_ADMIN_USERS:-}" \
	    "${BSDINSTALL_CAPABILITY_ADMIN_GROUPS:-}"
	exit $?
fi

users=$(cat "$users_state" 2>/dev/null)
groups=$(cat "$groups_state" 2>/dev/null)

bsddialog --backtitle "$OSNAME Installer" \
    --title "Capability Administrator Policy" --msgbox \
    "The default 5BSD policy is permissive: root remains a powerful compatibility administrator, and root plus every member of wheel receive a full-discovery SYSTEM capability session. Add entries only for trusted system administrators. Ordinary users receive restricted USER sessions.\n\nA hardened deployment can make UID 0 insufficient for protected operations, but durable root resistance also requires verified system storage and separate recovery authority. Leave additional entries empty and see Security > Rootless Hardening in the 5BSD Handbook." 0 0

while :; do
	exec 5>&1
	users=$(bsddialog --backtitle "$OSNAME Installer" \
	    --title "Additional Capability Administrator Users" \
	    --ok-label "Continue" --cancel-label "Keep Current" \
	    --inputbox "Enter additional usernames or numeric UIDs, separated by spaces or commas. Root is always included by this installer profile." \
	    0 0 "$users" 2>&1 1>&5)
	result=$?
	exec 5>&-
	[ $result -eq $BSDDIALOG_OK ] || exit 0

	exec 5>&1
	groups=$(bsddialog --backtitle "$OSNAME Installer" \
	    --title "Additional Capability Administrator Groups" \
	    --ok-label "Save Policy" --cancel-label "Back" \
	    --inputbox "Enter additional group names, separated by spaces or commas. The wheel group is always included by this installer profile." \
	    0 0 "$groups" 2>&1 1>&5)
	result=$?
	exec 5>&-
	[ $result -eq $BSDDIALOG_OK ] || continue

	write_policy "$users" "$groups" && exit 0
done
