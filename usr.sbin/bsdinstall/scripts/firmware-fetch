#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
set -eu
: ${BSDINSTALL_CHROOT:=/mnt}
: ${BSDINSTALL_FIRMWARE_REPO:=5BSD-hardware}
: ${BSDINSTALL_HARDWARE_MEDIA:=/usr/5bsd-packages/hardware}
: ${BSDINSTALL_HARDWARE_INSTALL:=/usr/libexec/fwget/hardware-install}

# Scripted installs select the same packages as the interactive checklist.
# Detection failure must not silently produce an installation without firmware.
if [ "${1:-}" = --auto ]; then
	[ "$#" -eq 1 ] || exit 1
	selected=$(chroot "${BSDINSTALL_CHROOT}" fwget -q -n)
	set -- ${selected}
fi

# Keep an offline repository on the target so fwget also works after reboot.
# Do not fall back to FreeBSD's module repository on a missing package.
if [ -f "${BSDINSTALL_HARDWARE_MEDIA}/hardware.json" ]; then
	dest="${BSDINSTALL_CHROOT%/}/usr/5bsd-packages/hardware"
	mkdir -p "${dest}" "${BSDINSTALL_CHROOT%/}/etc/pkg"
	cp -R "${BSDINSTALL_HARDWARE_MEDIA}/." "${dest}/"
	cat >"${BSDINSTALL_CHROOT%/}/etc/pkg/5BSD-hardware.conf" <<-'EOF'
	5BSD-hardware: {
	  url: "file:///usr/5bsd-packages/hardware",
	  enabled: yes
	}
	EOF
fi

[ "$#" -gt 0 ] || exit 0

if ! FWGET_ROOT="${BSDINSTALL_CHROOT}" \
    FWGET_REPOSITORY="${BSDINSTALL_FIRMWARE_REPO}" \
    "${BSDINSTALL_HARDWARE_INSTALL}" "$@"; then
	printf ' %s' "$@"
	printf '\n'
	exit 1
fi

# The config step assembles rc.conf from these fragments. Preserve any other
# modules selected by earlier fragments when rc.conf is sourced.
if [ -n "${BSDINSTALL_TMPETC:-}" ]; then
	for name in "$@"; do
		case "${name}" in
		gpu-firmware-intel-*) module=i915kms ;;
		gpu-firmware-amd-*) module=amdgpu ;;
		gpu-firmware-radeon-*) module=radeonkms ;;
		*) continue ;;
		esac
		fragment="${BSDINSTALL_TMPETC}/rc.conf.hardware"
		line='kld_list="${kld_list} '"${module}"'"'
		if [ ! -f "${fragment}" ] || ! grep -qFx "${line}" "${fragment}"; then
			printf '%s\n' "${line}" >>"${fragment}"
		fi
	done
fi
