# tzfs-flavors: OS-image flavor catalog for tzfsd(8).
#
# Installed as a drop-in under /Capabilities/Config/tzfsd.d/ by the tzfs-flavors
# package.  tzfsd(8) itself is a storage/capability broker and deliberately
# knows nothing about any particular operating system; this fragment is how
# OS-image flavors are contributed to it as *data*, so distro curation stays
# decoupled from the broker and can be versioned or removed on its own.
#
# Each flavor names a baked ZFS send-stream artifact -- produced at build time
# by tzfs-flavor-linux(8) / tzfs-flavor-freebsd(8) -- that tzfsd receives into
# its templates on first start and then clones, copy-on-write, per request.
# A flavor whose artifact is absent is simply not offered (tzfsd logs a notice
# and moves on), so installing this catalog before the artifacts are produced
# is harmless.
flavors {
    linux {
        build = "baked"
        source = "/usr/share/tzfs/rocky9.zfs.zst"
        default = true
    }
    freebsd {
        build = "baked"
        source = "/usr/share/tzfs/freebsd.zfs.zst"
    }
}
