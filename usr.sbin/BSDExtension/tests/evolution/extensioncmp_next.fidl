// SPDX-License-Identifier: BSD-2-Clause
// Schema-evolution fixture for system.SystemExtension.  At bsd:1 this is
// exactly lib/libextensioncmp/extensioncmp.fidl
// (tools/build/fuchsia/test-bindings.py checks it); bsd:2 adds a method, as a
// future provider release would.  The peer built from bsd:2 is paired with the
// real bsd:1 client and provider.
@available(platform="bsd", added=1)
library bsd.extension.v1;

type ProtocolInfo = struct { wire_version uint32; };
// A kernel module name: no '/', not "." or "..", no NUL.
alias ModuleName = string:63;
type Module = struct { name ModuleName; };
type LoadState = struct { loaded bool; };
type ModuleList = struct {
    // The allow-listed names (EOVERFLOW when more than 32 are configured).
    modules vector<Module>:32;
};
// An empty cursor starts a Next enumeration.
type Cursor = struct { name string:63; };
type ModuleInfo = struct {
    name ModuleName;
    // SYSEXT_STATE_* bits: 0x1 allowed, 0x2 enabled, 0x4 loaded (only
    // reported for an allowed module), 0x8 override, 0x10 ready.
    flags uint32;
};
// A read-only cursor over the broker's recent load decisions: 0 starts at
// the oldest retained decision.
type DecisionCursor = struct { after uint64; };
type LoadDecision = struct {
    // Increasing per broker start; the first decision is 1.
    sequence uint64;
    // Wall-clock seconds since the Epoch.
    time int64;
    module ModuleName;
    // The requester's switchboard client label.
    client string:63;
    // SYSEXT_OP_* of the request (1 Ensure, 10 Restore).
    operation uint32;
    // SYSEXT_DECISION_*: 1 loaded, 2 already present, 3 not permitted,
    // 4 client limited to hardware drivers, 5 administrator deny override,
    // 6 permitted but the load failed (error holds the errno).
    result uint32;
    error uint32;
};
closed protocol SystemExtension {
    strict GetProtocolInfo() -> (ProtocolInfo);
    // Errors are errno values (EPERM: not allow-listed, or not ADMIN for the
    // policy methods; EINVAL: bad name).
    strict Ensure(Module) -> () error uint32;
    strict Stat(Module) -> (LoadState) error uint32;
    strict List() -> (ModuleList) error uint32;
    // ADMIN: reload the configured policy file.
    strict Reload() -> () error uint32;
    // ADMIN: durable policy overrides; Enable and Disable affect future
    // restoration, Restore loads every enabled module now.
    strict Allow(Module) -> () error uint32;
    strict Deny(Module) -> () error uint32;
    strict Reset(Module) -> () error uint32;
    strict Enable(Module) -> () error uint32;
    strict Disable(Module) -> () error uint32;
    strict Restore() -> () error uint32;
    // One policy entry; Next returns the first entry lexically after the
    // cursor, ENOENT at the end.
    strict Info(Module) -> (ModuleInfo) error uint32;
    strict Next(Cursor) -> (ModuleInfo) error uint32;
    // Added in the next revision; unknown to wire-major-1 peers.
    @available(added=2)
    strict Probe() -> (ProtocolInfo);
};
// system.SystemExtension.Status: the read-only view switchboard gives UID 0
// login sessions (root-query.ucl).  It has no method that loads a module or
// changes policy; Info and Next behave as on SystemExtension.
closed protocol SystemExtensionStatus {
    strict GetProtocolInfo() -> (ProtocolInfo);
    strict Info(Module) -> (ModuleInfo) error uint32;
    strict Next(Cursor) -> (ModuleInfo) error uint32;
    // The oldest retained decision with a sequence after the cursor; ENOENT
    // when there is none.  The broker keeps the most recent 64.
    strict NextDecision(DecisionCursor) -> (LoadDecision) error uint32;
};
