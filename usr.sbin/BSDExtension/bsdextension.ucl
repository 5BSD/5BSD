# bsdextension(8) configuration — the kernel-module allow-list (default-deny).
#
# bsdextension loads kernel modules ("system extensions") on behalf of SYSTEM-domain
# clients.  The domain gate decides who may REACH bsdextension; this allow-list
# decides WHICH modules may load.  A module whose name is not listed is refused
# with EPERM and logged, no matter which client asks.
#
# This is required startup policy. The executable contains no module grants.
# Select the permitted modules here; the array is the complete base grant set.
# Missing or malformed policy stops startup. Failed reloads keep the last
# accepted policy. An empty array explicitly denies all module requests.
# Each entry must be a single, safe module name (no "/", not "." or "..").
#
allowed_extensions = [
    "cryptodev",   # bsdcrypto: /dev/crypto (OCF) for the crypto provider
    "vhid",        # blued: virtual-HID transport for the Bluetooth stack
    "zfs",         # bsdfilesystem: ZFS backing /Capabilities storage
    "linux64",     # sysextctl: Linux application runtime
    "vmm",         # WASPNest virtual machine monitor
    "fdescfs",     # Linux /dev/fd (linrdlnk)
    "linprocfs",   # Linux /proc
    "linsysfs",    # Linux /sys
    "drm",         # graphics core
    "i915kms",     # Intel graphics
    "amdgpu",      # AMD graphics
    "radeonkms",   # older Radeon graphics
    "cpuctl",      # hwstat: Intel/AMD CPU identification and energy MSRs
    "coretemp",    # hwstat: Intel temperature
    "amdsmn",      # amdtemp: AMD System Management Network
    "amdtemp",     # hwstat: AMD temperature
    "dummynet",    # rc.d/dummynet: pf dnpipe/dnqueue traffic shaping
    "pf",          # rc.d/pf, pflog, pfsync: packet filter when not preloaded
]
