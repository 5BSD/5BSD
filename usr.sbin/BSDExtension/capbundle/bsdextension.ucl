# switchboard unit for the system-extension broker (bsdextension), which owns kernel-
# module loading.  Launched and supervised by switchboard like every other daemon
# (docs/capability-authority-model.md) — PID 1 no longer loads modules.
#
# bsdextension is a socket-free service_provider: it exposes the well-known name
# system.SystemExtension and serves each client on its own mac_capability
# channel, so a SYSTEM-domain consumer requests a module by name (service_open)
# exactly like every other capability-plane daemon.
#
# boot = true because early consumers (storage, networking) may need a module
# before the general service population comes up.  PID 1 owns /dev/mac_capability,
# so bsdextension does not open it: it declares the kldload system gate below and
# switchboard delivers a matching system token (capsule claims the gate under
# its nonce).  service_provider_authorize_capabilities(3) authorizes that
# token, adding bsdextension's nonce to the gate's authorized set.  Read-only module
# queries (kldfind/kldstat) are not gated at all, so no kldstat declaration is
# needed.
#
# BSDExtension is born in capability mode as the unprivileged capability user.
# kldload(2)/kldunload(2) are capmode-enabled but run priv_check(PRIV_KLD_LOAD/
# UNLOAD), which the capability user fails; instead BSDExtension holds the
# SYS_GATE_KLDLOAD (+ KLDUNLOAD) "system" gate (minted by Capsule from this
# veriexec-verified declaration, delivered by switchboard, authorized via
# service_provider_authorize_capabilities) and performs the load/unload THROUGH
# the gate (service_system_kldload/kldunload -> kern_kldload_gated), whose held
# claim replaces the privilege.  The kernel resolves the module path in kernel
# context (a UIO_SYSSPACE namei, exempt from the capmode userspace-path
# restriction), so the sandbox is never loosened (the raw syscall stays
# priv-checked).  Read-only queries (kldfind/kldstat) are capmode-enabled and
# ungated, so no kldstat declaration is needed.
activation { boot = true; ipc = ["system.SystemExtension"]; }
# Container model: bsdextension reconciles the modules it loaded on bundles' behalf
# against the installed-or-running bundles (docs/book/src/plane/containers-and-storage.md);
# the live set is read from these delivered directories, never opened by path.
# BSDEXTENSION_RECLAIM_INTERVAL (environment { ... }) sets the timer/grace seconds.
directories = ["/Capabilities/System", "/Capabilities/Apps", "/Capabilities/Run/live"];
control = "core";
protect = ["ptrace", "signal", "wait", "sigkill", "sigcont", "sched",
    "core", "ktrace"];
program = "BSDExtension";
restart = "on-failure";
user = "capability";

capabilities {
    system = ["kldload", "kldunload"];
}

limits { nofile = 1024; nproc = 128; core = 0; }
umask = "0022";
