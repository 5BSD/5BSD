load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_script_wrapper")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
bsd_script_wrapper(name = "bsd_build_test", body = "bsd_build_test.sh",
    interpreter = "/usr/libexec/atf-sh", cat = "@bsd_sdk//toolchain:cat",
    cat_runtime = ["@bsd_sdk//toolchain:cat_runtime"], redirect = "@bsd_sdk//toolchain:stdout_redirect")
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["bsd_build_test"], interfaces = {"bsd_build_test": "atf"})
bsd_install_file(name = "install_shell", src = ":bsd_build_test",
    destination = "/usr/tests/usr.sbin/bsd-build/bsd_build_test", owner = "root", group = "wheel",
    mode = "0555", install_tags = ["package=bsd-build-tests"])
bsd_install_file(name = "install_kyuafile", src = ":kyuafile",
    destination = "/usr/tests/usr.sbin/bsd-build/Kyuafile", owner = "root", group = "wheel",
    mode = "0444", install_tags = ["package=bsd-build-tests"])
