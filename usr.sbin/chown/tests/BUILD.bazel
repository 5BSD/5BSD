load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
CASES = ['RH_flag', 'RL_flag', 'RP_flag', 'f_flag', 'h_flag', 'v_flag', 'x_flag']
[bsd_atf_test(
    name = "native_" + case,
    case_name = case,
    body = "chown_test.sh",
    cleanup = case in ["f_flag", "x_flag"],
    subr = "//libexec/atf/atf-sh:shell_library",
    runtime_bin = ['//usr.bin/diff:diff', '//usr.bin/tr:tr', '//bin/sh:sh', '//libexec/atf/atf-sh:atf-sh', '//libexec/atf/atf-check:atf-check', '//bin/chflags:chflags', '//usr.bin/stat:stat', '//usr.bin/touch:touch', '//bin/rm:rm', '//bin/mkdir:mkdir', '//bin/ln:ln', '//usr.bin/dirname:dirname', '//usr.bin/basename:basename', '//bin/cat:cat', '//usr.bin/grep:grep', '//usr.bin/sed:sed', '//usr.sbin/chown:chown', '//bin/df:df', '//usr.bin/tail:tail', '//usr.bin/cut:cut', '//usr.bin/truncate:truncate', '//sbin/mdconfig:mdconfig', '//sbin/newfs:newfs', '//sbin/mount:mount', '//sbin/umount:umount'],
    runtime_lib = ['//lib/atf/libatf-c:atf_c_shared', '//lib/atf/libatf-c++:atf_cxx_shared', '//lib/libc++:cxx_shared', '//lib/libcxxrt:cxxrt_shared', '//lib/msun:m_shared', '//lib/libedit:edit_shared', '//lib/ncurses/tinfo:tinfo_shared', '@bsd_sdk//toolchain:sysroot/lib/libc.so.7', '@bsd_sdk//toolchain:sysroot/lib/libsys.so.7', '@bsd_sdk//toolchain:sysroot/lib/libgcc_s.so.1', '//lib/libutil:util_shared', '//lib/libkvm:kvm_shared', '//lib/libelf:elf_shared', '//lib/libjail:jail_shared', '//lib/libregex:regex_shared', '//lib/libmd:md_shared', '//lib/libxo/libxo:xo_shared', '//lib/libnv:nv_shared', '//lib/libcasper/libcasper:casper_shared', '//lib/libcasper/services/cap_fileargs:cap_fileargs_shared', '//lib/libgeom:geom_shared', '//lib/libufs:ufs_shared', '//lib/libexpat:bsdxml_shared', '//lib/libsbuf:sbuf_shared'],
    runner = "//tools/build/bazel:atf_runner",
    size = "small",
) for case in CASES]
test_suite(name = "tests", tests = [":native_" + case for case in CASES], visibility = ["//visibility:public"])
