load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

_CASPER = "//tools/build/bazel/config:casper_enabled"
cc_binary(
    name = "traceroute6", srcs = ["//usr.sbin/traceroute:as.c", "traceroute6.c"],
    deps = ["//usr.sbin/traceroute:as_header", "//lib/libcasper/services/cap_dns:headers"] +
        select({_CASPER: ["//lib/libcasper/libcasper:casper", "//lib/libcasper/services/cap_dns:cap_dns"], "//conditions:default": []}) + ["//lib/libipsec:ipsec"],
    dynamic_deps = select({_CASPER: ["//lib/libcasper/libcasper:casper_shared", "//lib/libcasper/services/cap_dns:cap_dns_shared"], "//conditions:default": []}) +
        ["//lib/libipsec:ipsec_shared"],
    local_defines = ["IPSEC", "HAVE_POLL"] + select({_CASPER: ["WITH_CASPER"], "//conditions:default": []}),
    copts = ["-fPIE"], linkopts = ["-pie"], target_compatible_with = ["@platforms//os:freebsd"],
    visibility = ["//visibility:public"],
)
utility_installation(name = "install_manifest", program = "traceroute6", manual = "traceroute6.8",
    package = "runtime", bindir = "/usr/sbin", man_section = "8", binary_mode = "4555")
bsd_install_archive(
    name = "install_archive", manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime","dbg"]}'
        for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"],
)
