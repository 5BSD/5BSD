# Sources shipped with the libservice worker-authority contract test.
exports_files(['logcmp.c', 'storage.c'], visibility = ["//lib/libservice/tests:__pkg__", "//usr.sbin/BSDLog/tests:__pkg__"])

# Source fixtures shipped with Switchboard contract tests.
exports_files(['capbundle/bsdlog.ucl'], visibility = ["//usr.sbin/switchboard/tests:__pkg__"])

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_import")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_header", "bsd_dtrace_cc_objects")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
bsd_dtrace_header(
    name = "provider", source = "bsdlog_provider.d", output = "bsdlog_provider.h",
    flags = ["-C", "-x", "nolibs"], object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:dtrace", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti",
    runtime_libraries = ['//cddl/lib/libdtrace:dtrace_shared', '//cddl/lib/libctf:ctf_shared', '//lib/libelf:elf_shared', '//lib/libproc:proc_shared', '//cddl/lib/libspl:spl_shared', '//lib/libxo/libxo:xo_shared', '//lib/libutil:util_shared', '//lib/libprocstat:procstat_shared', '//lib/librtld_db:rtld_db_shared', '//lib/libcxxrt:cxxrt_shared', '//lib/libz:z_shared', '//lib/libkvm:kvm_shared'],
    tool_inputs = [ "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"], static_anchor = False,
)
cc_library(name = "provider_headers", hdrs = [":provider"], strip_include_prefix = ".")

cc_library(name = "objects", srcs = ["logcmp.c", "session.c", "config.c", "store.c", "storage.c", "config.h", "store.h", "session.h", "storage.h", "logcmp_test.h", "bsdlog_probes.h"],
    deps = ['//lib/libauditcmp:auditcmp', '//lib/libcapreclaim:capreclaim', '//lib/libchannel:channel', '//lib/libfidl:fidl', '//lib/libfilesystemcmp:filesystemcmp', '//lib/liblogcmp:logcmp', '//lib/libmd:md_link', '//lib/libservice:service', '//lib/libshmring:shmring', '//lib/libucl:ucl', '//lib/libthr:thr', '//lib/liblogcmp:generated_headers', '//lib/liblogcmp:wakeup_headers'] + select({_TRACE: [":provider_headers"], "//conditions:default": []}),
    local_defines = select({_TRACE: ["WITH_DTRACE"], "//conditions:default": []}),
    copts = ["-fPIE"], target_compatible_with = _PLATFORM)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider", provider_object = "bsdlog_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group) for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"], deps = [":provider_link"] + ['//lib/libauditcmp:auditcmp', '//lib/libcapreclaim:capreclaim', '//lib/libchannel:channel', '//lib/libfidl:fidl', '//lib/libfilesystemcmp:filesystemcmp', '//lib/liblogcmp:logcmp', '//lib/libmd:md_link', '//lib/libservice:service', '//lib/libshmring:shmring', '//lib/libucl:ucl', '//lib/libthr:thr'])
load("//tools/build/bazel:bsd_capimage.bzl", "bsd_capimage_policy")
bsd_capimage_policy(name = "policy_assembly", src = "capbundle/bsdlog.ucl")
cc_binary(name = "BSDLog", srcs = [":policy_assembly"], deps = select({_TRACE: [":traced"], "//conditions:default": [":objects"]}),
    dynamic_deps = ['//lib/libauditcmp:auditcmp_shared', '//lib/libcapreclaim:capreclaim_shared', '//lib/libchannel:channel_shared', '//lib/libfidl:fidl_shared', '//lib/libfilesystemcmp:filesystemcmp_shared', '//lib/liblogcmp:logcmp_shared', '//lib/libmd:md_shared', '//lib/libservice:service_shared', '//lib/libshmring:shmring_shared', '//lib/libucl:ucl_shared', '//lib/libthr:thr_shared'],
    linkopts = ["-pie"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
_BUNDLE = "/Capabilities/System/Log.cap"
_UNIT = _BUNDLE + "/Units/bsdlog.unit"
utility_installation(name = "program_install", keep_sections = [".5bsd.policy"], program = "BSDLog", manual = "BSDLog.8",
    package = "bsdlog", bindir = _UNIT + "/bin", man_section = "8")
[bsd_install_file(name = name, src = src, destination = dest, owner = "root", group = "wheel",
    mode = mode, install_tags = tags)
 for name, src, dest, mode, tags in [
    ("bundle_install", "capbundle/Bundle.ucl", _BUNDLE + "/Bundle.ucl", "0444", ["package=bsdlog"]),
    ("unit_install", "capbundle/bsdlog.ucl", _UNIT + "/Unit.ucl", "0444", ["package=bsdlog"]),
    ("config_install", "capbundle/bsdlog.conf", _UNIT + "/Config/bsdlog.conf", "0644", ["package=bsdlog", "config"]),
 ]]
bsd_install_manifest(name = "bundle_install_manifest", entries = [":bundle_install", ":unit_install", ":config_install"])
load("//usr.sbin/BSDLog/tests:installation.bzl", TEST_DIRECTORIES = "DIRECTORIES", TEST_MANIFESTS = "MANIFESTS")
[bsd_install_archive(name = name,
    manifests = [":program_install", ":bundle_install_manifest"] + (select({"//tools/build/bazel/config:tests_enabled": TEST_MANIFESTS, "//conditions:default": []}) if include_tests else []),
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bsdlog"]}'
        for d in [_BUNDLE, _BUNDLE + "/Units", _UNIT, _UNIT + "/bin", _UNIT + "/Config"]} |
        {"/usr/lib/debug" + d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bsdlog","dbg"]}'
         for d in ["/Capabilities", "/Capabilities/System", _BUNDLE, _BUNDLE + "/Units", _UNIT, _UNIT + "/bin"]} | (select({"//tools/build/bazel/config:tests_enabled": TEST_DIRECTORIES, "//conditions:default": {}}) if include_tests else {}),
    mtree_specs = {"//etc/mtree:BSD.tests.dist": "/usr/tests", "//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"]) for name, include_tests in [("daemon_install_archive", False), ("install_archive", True)]]

exports_files(["session.c", "store.c"], visibility = ["//usr.sbin/BSDLog/tests:__pkg__"])
cc_library(name = "test_headers", hdrs = ["config.h", "store.h", "session.h", "storage.h", "logcmp_test.h", "bsdlog_probes.h"],
    textual_hdrs = ["store.c", "storage.c", "logcmp.c", "session.c"], strip_include_prefix = ".",
    deps = ["//lib/liblogcmp:headers", "//lib/libshmring:headers"],
    visibility = ["//usr.sbin/BSDLog/tests:__pkg__"])

exports_files(["BSDLog.8", "bsdlog_provider.d", "capbundle/bsdlog.conf"], visibility = ["//usr.sbin/BSDLog/tests:__pkg__"])

# Operator tool uses the same strict parser as the daemon.
exports_files(["config.c"], visibility = ["//usr.sbin/BSDLog/tests:__pkg__", "//usr.sbin/logctl:__pkg__", "//usr.sbin/logctl/tests:__pkg__"])
cc_library(name = "config_headers", hdrs = ["config.h", "store.h"], strip_include_prefix = ".", deps = ["//lib/liblogcmp:headers"], visibility = ["//usr.sbin/logctl:__pkg__", "//usr.sbin/logctl/tests:__pkg__"])
