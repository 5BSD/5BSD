load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools/build/bazel:bsd_rpcgen.bzl", "bsd_rpcgen")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_rpcgen(name = "generate_svc_c", source = "//sys/kgssapi:gssd.x", output = "gssd_svc.c", mode = "-m", flags = ["-L", "-C", "-M"], cpp_flags = ["-E", "-x", "c", "-nostdinc"], rpcgen = "//usr.bin/rpcgen:rpcgen", cpp = "@bsd_sdk//toolchain:bin/cpp", compiler_inputs = "@bsd_sdk//toolchain:compile_inputs", runtime = ["@bsd_sdk//toolchain:cpp_runtime"])
bsd_rpcgen(name = "generate_xdr_c", source = "//sys/kgssapi:gssd.x", output = "gssd_xdr.c", mode = "-c", flags = ["-L", "-C", "-M"], cpp_flags = ["-E", "-x", "c", "-nostdinc"], rpcgen = "//usr.bin/rpcgen:rpcgen", cpp = "@bsd_sdk//toolchain:bin/cpp", compiler_inputs = "@bsd_sdk//toolchain:compile_inputs", runtime = ["@bsd_sdk//toolchain:cpp_runtime"])
bsd_rpcgen(name = "generate_h", source = "//sys/kgssapi:gssd.x", output = "gssd.h", mode = "-h", flags = ["-L", "-C", "-M"], cpp_flags = ["-E", "-x", "c", "-nostdinc"], rpcgen = "//usr.bin/rpcgen:rpcgen", cpp = "@bsd_sdk//toolchain:bin/cpp", compiler_inputs = "@bsd_sdk//toolchain:compile_inputs", runtime = ["@bsd_sdk//toolchain:cpp_runtime"])
cc_library(name = "generated_headers", hdrs = [":gssd.h"], includes = ["."])
# The current native Kerberos graph implements MIT; reject other selections.
cc_binary(name = "gssd", srcs = ["gssd.c", ":gssd_svc.c", ":gssd_xdr.c", "//sys/kgssapi:gssd_prot.c"],
    deps = [":generated_headers"] + ['//krb5/lib/gssapi:gssapi_krb5', '//krb5/lib/krb5:krb5', '//krb5/lib/crypto:k5crypto', '//krb5/util/profile:krb5profile_pie', '//krb5/util/support:krb5support'],
    dynamic_deps = ['//krb5/lib/gssapi:gssapi_krb5_shared', '//krb5/lib/krb5:krb5_shared', '//krb5/lib/crypto:k5crypto_shared', '//krb5/util/support:krb5support_shared'],
    local_defines = ["MK_MITKRB5=yes"], copts = ["-fPIE"], linkopts = ["-pie"], linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"] + select({"//tools/build/bazel/config:mitkrb5_enabled": [], "//conditions:default": ["@platforms//:incompatible"]}), visibility = ["//visibility:public"])
utility_installation(name = "install_manifest", program = "gssd", manual = "gssd.8", package = "gssd", bindir = "/usr/sbin", man_section = "8")
bsd_install_archive(name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=gssd","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
