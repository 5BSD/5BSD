[cc_binary(name = program + suffix, srcs = [program + ".c"],
    deps = ["//lib/atf/libatf-c:atf_c", "//usr.sbin/capsule:" + ("release_test_includes" if program == "system_release_test" else "test_headers")],
    dynamic_deps = ["//lib/atf/libatf-c:atf_c_shared"],
    copts = ["-fPIE"] + (["-ffunction-sections", "-fdata-sections"] if program == "system_release_test" else []),
    linkopts = ["-pie"] + (["-Wl,--gc-sections"] if program == "system_release_test" else []) + (["-Wl,--disable-new-dtags,-rpath,$ORIGIN"] if suffix else []),
    visibility = ["//visibility:public"])
 for program in ["system_release_test", "capsule_ambient_test"] for suffix in ["", "_kyua"]]
[bsd_kyua_test(name = program + "_" + case, case_name = case, interface = "atf", program = ":" + program + "_kyua",
    case_timeout = 60, clean_environment = True, size = "small",
