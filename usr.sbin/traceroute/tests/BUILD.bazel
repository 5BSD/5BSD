load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_script_wrapper")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")

bsd_script_wrapper(name = "traceroute_test", body = "traceroute_test.sh", interpreter = "/usr/libexec/atf-sh",
    cat = "@bsd_sdk//toolchain:cat", cat_runtime = ["@bsd_sdk//toolchain:cat_runtime"],
    redirect = "@bsd_sdk//toolchain:stdout_redirect")
# Cases create routed VNET jails and raw sockets. Preserve the maintained
# installed-system requirements instead of substituting host traceroute.
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["traceroute_test"],
    interfaces = {"traceroute_test": "atf"},
    metadata = {"traceroute_test": '{"execenv":"jail","execenv_jail_params":"vnet allow.raw_sockets"}'})
[bsd_install_file(name = "install_" + name, src = ":" + source,
    destination = "/usr/tests/usr.sbin/traceroute/" + dest, owner = "root", group = "wheel", mode = mode,
    install_tags = ["package=tests"])
 for name, source, dest, mode in [("shell", "traceroute_test", "traceroute_test", "0555"), ("kyuafile", "kyuafile", "Kyuafile", "0444")]]
bsd_install_manifest(name = "install_manifest", entries = [":install_shell", ":install_kyuafile"],
    visibility = ["//visibility:public"])
