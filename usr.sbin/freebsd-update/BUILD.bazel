load("//tools/build/bazel:bsd_script_installation.bzl", "script_installation", "script_install_archive")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_install_directory")
script_installation(name = "program_manifest", scripts = {"freebsd-update.sh": "/usr/sbin/freebsd-update"},
    manuals = ["freebsd-update.8"], package = "utilities")
bsd_install_file(name = "configuration", src = "freebsd-update.conf", destination = "/etc/freebsd-update.conf",
    owner = "root", group = "wheel", mode = "0644", install_tags = ["package=utilities", "config"])
bsd_install_directory(name = "configuration_directory", destination = "/etc", owner = "root", group = "wheel", mode = "0755", install_tags = ["package=utilities"])
bsd_install_manifest(name = "configuration_manifest", entries = [":configuration_directory", ":configuration"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "install_archive", manifests = [":program_manifest", ":configuration_manifest"],
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
