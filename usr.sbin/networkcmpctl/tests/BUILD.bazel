load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_script_wrapper")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
cc_library(name = "fake_inputs", textual_hdrs = ["//usr.sbin/networkcmpctl:networkcmpctl.c"], deps = ["//lib/libnetworkcmp:headers"])
cc_binary(name = "networkcmpctl_test_bin", srcs = ["//usr.sbin/networkcmpctl:networkcmpctl.c"], deps = ["//lib/libnetworkcmp:networkcmp"], linkopts = ["-static"], linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
cc_binary(name = "networkcmpctl_success_bin", srcs = ["networkcmpctl_success_impl.c", "fake_networkcmp.c"], deps = [":fake_inputs"], linkopts = ["-static"], linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
utility_installation(name = "install_real", program = "networkcmpctl_test_bin", manual = None, package = "bsdnetwork-tests", bindir = "/usr/tests/usr.sbin/networkcmpctl")
utility_installation(name = "install_fake", program = "networkcmpctl_success_bin", manual = None, package = "bsdnetwork-tests", bindir = "/usr/tests/usr.sbin/networkcmpctl")
bsd_script_wrapper(name = "networkcmpctl_test", body = "networkcmpctl_test.sh", interpreter = "/usr/libexec/atf-sh", cat = "@bsd_sdk//toolchain:cat", cat_runtime = ["@bsd_sdk//toolchain:cat_runtime"], redirect = "@bsd_sdk//toolchain:stdout_redirect")
bsd_install_file(name = "install_shell", src = ":networkcmpctl_test", destination = "/usr/tests/usr.sbin/networkcmpctl/networkcmpctl_test", owner = "root", group = "wheel", mode = "0555", install_tags = ["package=bsdnetwork-tests"])
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["networkcmpctl_test"], interfaces = {"networkcmpctl_test": "atf"})
bsd_install_file(name = "install_kyuafile", src = ":kyuafile", destination = "/usr/tests/usr.sbin/networkcmpctl/Kyuafile", owner = "root", group = "wheel", mode = "0444", install_tags = ["package=bsdnetwork-tests"])
bsd_install_manifest(name = "install_manifest", entries = [":install_shell", ":install_kyuafile"], visibility = ["//visibility:public"])
