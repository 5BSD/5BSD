# Four endpoints in one provider (PF and State have separate protocols):
#   system.Network        SYSTEM-only broker for services and applications
#   system.Network.Admin  requires the software attribute system.network.admin,
#                         held by networkcmpctl, so the approved shell tool
#                         reaches the broker by its own identity
activation {
	boot = true;
	ipc = [
		"system.Network",
		{ name = "system.Network.Admin"; requires = ["system.network.admin"]; },
		{ name = "system.Network.PF"; requires = ["system.network.pf.read"]; },
		{ name = "system.Network.State"; requires = ["system.network.observe"]; },
	];
}
control = "system";
protect = ["ptrace", "signal", "wait", "sigkill", "sigcont", "sched", "core", "ktrace"];
program = "BSDNetwork";
restart = "on-failure";
user = "capability";

limits { nofile = 1024; nproc = 128; core = 0; }
umask = "0077";

# Born in capability mode: Casper cap_net is retired.  socket(2)/connect(2) are
# legal in capability mode, and the in-process resolver obtains resolv.conf,
# hosts and services on demand through the filesystem provider
# (service_open_isolated, granted by bsdfilesystem's open policy) -- so no pre-capmode
# window is needed.  The per-label network policy remains the boundary.
