load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools/build/bazel:bsd_lex_yacc.bzl", "bsd_lex", "bsd_yacc")
load("//tools/build/bazel:bsd_script_output.bzl", "bsd_script_output")

bsd_yacc(name = "parser", src = "config.y", output = "config.c", header = "y.tab.h", yacc = "//usr.bin/yacc:yacc")
filegroup(name = "parser_source", srcs = [":parser"], output_group = "source")
filegroup(name = "parser_header", srcs = [":parser"], output_group = "header")
bsd_lex(name = "lexer", src = "lang.l", output = "lang.c", lex = "//usr.bin/lex:lex", m4 = "//usr.bin/m4:m4")
bsd_script_output(name = "kernconf", src = "kernconf.tmpl", script = "kernconf.sh", output = "kernconf.c",
    path_tools = {"//usr.bin/file2c:file2c": "file2c"}, shell = "@bsd_sdk//toolchain:sh",
    redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:sh_runtime"])
cc_library(name = "headers", hdrs = ["config.h", "configvers.h", ":parser_header"], strip_include_prefix = ".")
cc_binary(name = "config", srcs = ["main.cc", "mkmakefile.cc", "mkheaders.c", "mkoptions.cc", ":parser_source", ":lexer", ":kernconf"],
    deps = [":headers", "//lib/libc++:cxx", "//lib/libcxxrt:cxxrt", "//lib/msun:m"],
    dynamic_deps = ["//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared"],
    copts = ["-fPIE", "-nostdinc++"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install.bzl", "bsd_compress", "bsd_install_file")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
bsd_compress(name = "format_manual", src = "config.5", output = "config.5.gz", arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip",
    redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(manual = True, name = "install_format_manual", src = ":format_manual", destination = "/usr/share/man/man5/config.5.gz",
    owner = "root", group = "wheel", mode = "0444", install_tags = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=toolchain-man"], "//conditions:default": ["package=toolchain"]}))
utility_installation(name = "install_manifest", program = "config", manual = "config.8", man_section = "8", package = "toolchain", bindir = "/usr/sbin", extra_entries = [":install_format_manual"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive", visibility = ["//usr.sbin:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=toolchain","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
