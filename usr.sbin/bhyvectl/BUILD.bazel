load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
_SNAPSHOT = "//tools/build/bazel/config:bhyve_snapshot_enabled"
cc_library(name = "headers", hdrs = ["bhyvectl.h"], strip_include_prefix = ".")
cc_binary(name = "bhyvectl", srcs = ["bhyvectl.c", "amd64/bhyvectl_machdep.c"],
    deps = ["//lib/libvmmapi:vmmapi", "//lib/libutil:util", "//lib/libnv:nv", ":headers", "//usr.sbin/bhyve:ipc_headers", "//sys/amd64/vmm/amd:bhyvectl_headers", "//sys/amd64/vmm/intel:bhyvectl_headers"] + select({_SNAPSHOT: ["//usr.sbin/bhyve:snapshot_headers"], "//conditions:default": []}),
    dynamic_deps = ["//lib/libvmmapi:vmmapi_shared", "//lib/libutil:util_shared", "//lib/libnv:nv_shared"],
    local_defines = select({_SNAPSHOT: ["BHYVE_SNAPSHOT"], "//conditions:default": []}),
    copts = ["-fPIE"], linkopts = ["-pie"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "bhyvectl", manual = "bhyvectl.8", package = "bhyve", bindir = "/usr/sbin", man_section = "8")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//visibility:public"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bhyve","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
