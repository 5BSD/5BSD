schema = "org.5bsd.serviced.service";
schema_version = "1.0.0";
bundle_id = "org.5bsd.system.kldmgr";
version = "1.0.0";
author = "5BSD";

program = "kldmgrd";
provides = ["org.5bsd.system.kldmgr"];
restart = "on-failure";
user = "root";

capabilities {
    system = ["kldload", "kldunload", "kldstat"];
}
