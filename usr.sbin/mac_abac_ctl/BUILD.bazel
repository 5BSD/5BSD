load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_import")
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_spec", "bsd_dtrace_cc_objects")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
bsd_dtrace_spec(name = "provider", source = "diagnostics_provider.d", output = "diagnostics_provider.o",
    flags = ["-C", "-x", "nolibs"], static_anchor = False, object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:bootstrap", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti",
    runtime_libraries = ["//cddl/usr.sbin/dtrace:bootstrap_runtime"],
    tool_inputs = [ "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"])

_LIBRARIES = ['//lib/libucl:ucl']
cc_library(name = "headers", hdrs = ['mac_abac_ctl.h', 'diagnostics.h'], strip_include_prefix = ".", deps = ['//sys/security/mac_abac:abi_headers', '//usr.sbin/mac_abacd:parser_headers'])
cc_library(name = "objects", srcs = ['mac_abac_ctl.c', 'mac_abac_ctl_label.c', 'mac_abac_ctl_rule.c', 'mac_abac_ctl_set.c', '//usr.sbin/mac_abacd:parse_line.c', '//usr.sbin/mac_abacd:parse_ucl.c'], deps = [":headers"] + _LIBRARIES,
    local_defines = select({_TRACE: ["WITH_DTRACE"], "//conditions:default": []}),
    copts = ["-fPIE"], target_compatible_with = _PLATFORM)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider",
    provider_object = "diagnostics_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group) for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"], deps = [":provider_link"] + _LIBRARIES)
cc_binary(name = "mac_abac_ctl", deps = select({_TRACE: [":traced"], "//conditions:default": [":objects"]}),
    dynamic_deps = ['//lib/libucl:ucl_shared'], linkopts = ["-pie"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_install_file(name = "extra", src = "//sys/security/mac_abac:mac_abac.h", destination = "/usr/include/security/mac_abac/mac_abac.h", owner = "root", group = "wheel", mode = "0444", install_tags = ["package=mac-abac", "dev"])
utility_installation(name = "install_manifest", program = "mac_abac_ctl", manual = None, package = "mac-abac", bindir = "/usr/sbin", extra_entries = [":extra"])
bsd_install_archive(name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=mac-abac","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]} | {"/usr/include/security/mac_abac": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=mac-abac"]}'},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.include.dist": "/usr/include", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
