load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
# otelconf (usr.sbin/otelconf/Makefile): PACKAGE otel, -I lib/libotelexport, LIBADD otelexport;
# installs otel.conf(5) and the CONFS/DEFAULTS configuration files.
exports_files(["otelconf.c", "otel.conf", "otel.conf.defaults"], visibility = ["//usr.sbin/otelconf/tests:__pkg__"])
# Explicit final libthr dependency preserves Make's deferred pthread link order.
cc_binary(name = "otelconf", srcs = ["otelconf.c"], deps = ["//lib/libotelexport:headers", "//lib/libotelexport:otelexport_pie", "//lib/libz:z", "//secure/lib/libssl:ssl", "//secure/lib/libcrypto:crypto", "//lib/libucl:ucl", "//lib/libnghttp2:nghttp2", "//lib/libthr:thr"],
    dynamic_deps = ["//lib/libz:z_shared", "//secure/lib/libssl:ssl_shared", "//secure/lib/libcrypto:crypto_shared", "//lib/libucl:ucl_shared", "//lib/libnghttp2:nghttp2_shared", "//lib/libthr:thr_shared"],
    copts = ["-fPIE"], linkopts = ["-pie"], linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_compress")
# CONFGROUPS CONFS DEFAULTS (installconfig): /etc/otel.conf and /etc/defaults/otel.conf.
bsd_install_file(name = "configuration", src = "otel.conf", destination = "/etc/otel.conf", owner = "root", group = "wheel", mode = "0644", install_tags = ["package=otel", "config"])
bsd_install_file(name = "defaults", src = "otel.conf.defaults", destination = "/etc/defaults/otel.conf", owner = "root", group = "wheel", mode = "0644", install_tags = ["package=otel", "config"])
bsd_compress(name = "config_manual_gz", src = "otel.conf.5", output = "otel.conf.5.gz", arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(manual = True, name = "config_manual", src = ":config_manual_gz", destination = "/usr/share/man/man5/otel.conf.5.gz", owner = "root", group = "wheel", mode = "0444", install_tags = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=otel-man"], "//conditions:default": ["package=otel"]}))
utility_installation(name = "install_manifest", program = "otelconf", manual = "otelconf.8", package = "otel", bindir = "/usr/sbin", man_section = "8", extra_entries = [":configuration", ":defaults", ":config_manual"])
bsd_install_archive(name = "install_archive",
    manifests = [":install_manifest"] + select({"//tools/build/bazel/config:tests_enabled": ["//usr.sbin/otelconf/tests:install_manifest"], "//conditions:default": []}),
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=otel","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]} | {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities"]}' for d in ["/etc", "/etc/defaults"]} | select({"//tools/build/bazel/config:tests_enabled": {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=otel-tests","dbg"]}' for d in ['/usr/lib/debug/usr/tests', '/usr/lib/debug/usr/tests/usr.sbin', '/usr/lib/debug/usr/tests/usr.sbin/otelconf']} | {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=otel-tests"]}' for d in ['/usr/tests/usr.sbin/otelconf']}, "//conditions:default": {}}),
    mtree_specs = {"//etc/mtree:BSD.tests.dist": "/usr/tests", "//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
