# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = "ctladm", srcs = ['ctladm.c', 'util.c', 'ctladm.h', '//sys/cam:ctl/ctl_util.c', '//sys/cam:ctl/ctl_nvme_all.c', '//sys/cam:ctl/ctl_scsi_all.c'],
    deps = ['//sys/cam:headers', '//lib/libcam:cam', '//lib/libsbuf:sbuf', '//lib/libexpat:bsdxml', '//lib/libutil:util', '//lib/libnv:nv'],
    dynamic_deps = ['//lib/libcam:cam_shared', '//lib/libsbuf:sbuf_shared', '//lib/libexpat:bsdxml_shared', '//lib/libutil:util_shared', '//lib/libnv:nv_shared'],
    local_defines = select({"//tools/build/bazel/config:iscsi_enabled": ["WANT_ISCSI"], "//conditions:default": []}),
    copts = ["-fPIE", "-DPIC"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "ctladm", manual = "ctladm.8", man_section = "8", package = "ctl", bindir = "/usr/sbin")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"] + select({"//tools/build/bazel/config:tests_enabled": ["//usr.sbin/ctladm/tests:install_manifest"], "//conditions:default": []}),
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=ctl","dbg"]}'
        for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]} |
        select({"//tools/build/bazel/config:tests_enabled": {"/usr/tests/usr.sbin/ctladm": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests"]}'}, "//conditions:default": {}}),
    mtree_specs = {"//etc/mtree:BSD.tests.dist": "/usr/tests", "//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", epoch = 0,
    mtree = "@bsd_sdk//toolchain:extra_mtree", python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
    visibility = ["//visibility:public"])


load("//tools/build/bazel:bsd_python_test.bzl", "bsd_python_test")
filegroup(name = "test_program_runtime", testonly = True, srcs = ["//lib/libc:c_shared", "//lib/libsys:sys_shared", "@bsd_sdk//toolchain:sysroot/lib/libgcc_s.so.1"] + ['//lib/libcam:cam_shared', '//lib/libsbuf:sbuf_shared', '//lib/libexpat:bsdxml_shared', '//lib/libutil:util_shared', '//lib/libnv:nv_shared'])
bsd_python_test(name = "help_test", src = "help-test.py", data = [":ctladm"] + [":test_program_runtime"],
    runtime = ["@bsd_sdk//toolchain:python_stdlib"],
    args = ["--program-runtime", "$(locations :test_program_runtime)"],
    visibility = ["//visibility:public"])
