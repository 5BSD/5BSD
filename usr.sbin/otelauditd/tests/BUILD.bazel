load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_script_wrapper")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
_WRAP_ALLOC = ["-Wl,--wrap=malloc", "-Wl,--wrap=calloc", "-Wl,--wrap=realloc", "-Wl,--wrap=strdup", "-Wl,--wrap=strndup"]
_OE = ["//lib/libotelexport:otelexport_pie", "//lib/libz:z", "//secure/lib/libssl:ssl", "//secure/lib/libcrypto:crypto", "//lib/libucl:ucl", "//lib/libnghttp2:nghttp2"]
_OE_SHARED = ["//lib/libz:z_shared", "//secure/lib/libssl:ssl_shared", "//secure/lib/libcrypto:crypto_shared", "//lib/libucl:ucl_shared", "//lib/libnghttp2:nghttp2_shared"]
_BASE_RUNTIME = ["//lib/atf/libatf-c:atf_c_shared", "//lib/libc:c_shared", "//lib/libsys:sys_shared"]
# usr.sbin/otelauditd/tests/Makefile (PACKAGE otel-tests): auditrec_test (with
# ../auditrec.c and bsmgen.c, LIBADD otelexport bsm), mkaudittrail (bsmgen.c,
# LIBADD bsm), otelauditd_test.sh and the auditdrops.c fixture source.
cc_library(name = "bsmgen_headers", hdrs = ["bsmgen.h"], strip_include_prefix = ".")
cc_binary(name = "auditrec_test", srcs = ["auditrec_test.c", "//usr.sbin/otelauditd:auditrec.c", "bsmgen.c"],
    deps = [":bsmgen_headers", "//usr.sbin/otelauditd:headers", "//lib/libotelexport:headers", "//lib/atf/libatf-c:atf_c"] + _OE + ["//lib/libbsm:bsm", "//lib/libthr:thr"],
    dynamic_deps = ["//lib/atf/libatf-c:atf_c_shared"] + _OE_SHARED + ["//lib/libbsm:bsm_shared", "//lib/libthr:thr_shared"],
    copts = ["-fPIE"], linkopts = ["-pie"], linkstatic = True, target_compatible_with = _PLATFORM)
cc_binary(name = "mkaudittrail", srcs = ["mkaudittrail.c", "bsmgen.c"], deps = [":bsmgen_headers", "//lib/libbsm:bsm"], dynamic_deps = ["//lib/libbsm:bsm_shared"],
    copts = ["-fPIE"], linkopts = ["-pie"], linkstatic = True, target_compatible_with = _PLATFORM)
_DIR = "/usr/tests/usr.sbin/otelauditd"
_PACKAGE = "otel-tests"
[utility_installation(name = "install_" + name, program = name, manual = None, package = _PACKAGE, bindir = _DIR) for name in ["mkaudittrail", "auditrec_test"]]
bsd_script_wrapper(name = "otelauditd_test", body = "otelauditd_test.sh", interpreter = "/usr/libexec/atf-sh", cat = "@bsd_sdk//toolchain:cat", cat_runtime = ["@bsd_sdk//toolchain:cat_runtime"], redirect = "@bsd_sdk//toolchain:stdout_redirect")
bsd_install_file(name = "install_otelauditd_test", src = ":otelauditd_test", destination = _DIR + "/otelauditd_test", owner = "root", group = "wheel", mode = "0555", install_tags = ["package=" + _PACKAGE])
bsd_install_file(name = "install_file_0", src = "auditdrops.c", destination = _DIR + "/auditdrops.c", owner = "root", group = "wheel", mode = "0444", install_tags = ["package=" + _PACKAGE])
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["auditrec_test", "otelauditd_test"], interfaces = {n: "atf" for n in ["auditrec_test", "otelauditd_test"]})
bsd_install_file(name = "install_kyuafile", src = ":kyuafile", destination = _DIR + "/Kyuafile", owner = "root", group = "wheel", mode = "0444", install_tags = ["package=" + _PACKAGE])
bsd_install_manifest(name = "install_manifest", entries = [":install_otelauditd_test", ":install_file_0", ":install_kyuafile"], manifests = [":install_" + name for name in ["mkaudittrail", "auditrec_test"]], visibility = ["//visibility:public"])

CASES = ["event_table", "convert_trail", "malformed", "truncated_body", "severity", "record_len"]
[bsd_atf_test(name = "auditrec_test_" + case, case_name = case, interface = "program", body = ":auditrec_test",
    loader = "//libexec/rtld-elf:rtld_binary", runtime_lib = _BASE_RUNTIME + _OE_SHARED + ["//lib/libbsm:bsm_shared", "//lib/libthr:thr_shared", "//lib/msun:m_shared"],
    runner = "//tools/build/bazel:atf_runner", body_timeout_seconds = 60, size = "small") for case in CASES]
test_suite(name = "native_tests", tests = [":auditrec_test_" + case for case in CASES], visibility = ["//visibility:public"])
