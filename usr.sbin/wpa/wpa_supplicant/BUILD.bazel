load("//tools/build/bazel:bsd_install.bzl", "bsd_compress", "bsd_install_file")
_EXAMPLES = "//tools/build/bazel/config:examples_enabled"
_MAN_TAGS = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=wpa-man"], "//conditions:default": ["package=wpa"]})
bsd_compress(name = "config_manual", src = "wpa_supplicant.conf.5", output = "install_manifest/wpa_supplicant.conf.5.gz", arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(name = "config_manual_entry", src = ":config_manual", destination = "/usr/share/man/man5/wpa_supplicant.conf.5.gz", owner = "root", group = "wheel", mode = "0444", install_tags = _MAN_TAGS)
bsd_install_file(name = "example_0", src = "//contrib/wpa:wpa_supplicant/wpa_supplicant.conf", destination = "/usr/share/examples/etc/wpa_supplicant.conf", owner = "root", group = "wheel", mode = "0444", install_tags = ["package=wpa"])
utility_installation(name = "install_manifest", program = "wpa_supplicant", manual = "wpa_supplicant.8", package = "wpa", bindir = "/usr/sbin", man_section = "8", extra_entries = [":config_manual_entry"] + select({_EXAMPLES: [":example_0"], "//conditions:default": []}))
_DEBUG_DIRS = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=wpa","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]}
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"],
    directories = select({_EXAMPLES: (_DEBUG_DIRS | {"/usr/share/examples/etc": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=wpa"]}'}), "//conditions:default": _DEBUG_DIRS}),
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", epoch = 0,
    mtree = "@bsd_sdk//toolchain:extra_mtree", python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
bsd_python_test(name = "safe_cli_test", src = "safe_cli_test.py", data = [":wpa_supplicant", "//lib/libc:c_shared", "//lib/libsys:sys_shared", "//lib/libutil:util_shared", "//lib/libpcap:pcap_shared", "//lib/libthr:thr_shared"] + select({OPENSSL: ["//secure/lib/libssl:ssl_shared", "//secure/lib/libcrypto:crypto_shared"], "//conditions:default": []}) + select({"//tools/build/bazel/config:ofed_enabled": ["//lib/ofed/libibverbs:ibverbs_shared", "//lib/ofed/libbnxtre:bnxtre_shared", "//lib/ofed/libmlx5:mlx5_shared"], "//conditions:default": []}))
