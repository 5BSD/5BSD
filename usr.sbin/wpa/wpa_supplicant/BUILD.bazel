_LIBS = select({OPENSSL: ["//secure/lib/libssl:ssl", "//secure/lib/libcrypto:crypto"], "//conditions:default": []}) + ['//lib/libpcap:pcap', '//lib/libutil:util', '//usr.sbin/wpa/src/drivers:wpadrivers_pie', '//usr.sbin/wpa/src/eapol_supp:wpaeapol_supp_pie', '//usr.sbin/wpa/src/eap_server:wpaeap_server_pie', '//usr.sbin/wpa/src/eap_peer:wpaeap_peer_pie', '//usr.sbin/wpa/src/eap_common:wpaeap_common_pie', '//usr.sbin/wpa/src/l2_packet:wpal2_packet_pie', '//usr.sbin/wpa/src/rsn_supp:wparsn_supp_pie', '//usr.sbin/wpa/src/tls:wpatls_pie', '//usr.sbin/wpa/src/wps:wpawps_pie', '//usr.sbin/wpa/src/pasn:wpapasn_pie', '//usr.sbin/wpa/src/common:wpacommon_pie', '//usr.sbin/wpa/src/crypto:wpacrypto_pie', '//usr.sbin/wpa/src/utils:wpautils_pie']
