    copts = ["-fpie", "-DPIC", "-fPIE"] + inc_flags() + crypto_flags() + ["-DCONFIG_BACKEND_FILE"] + select({EAPOL: ['-DEAP_GTC', '-DEAP_LEAP', '-DEAP_MD5', '-DEAP_MSCHAPv2', '-DEAP_OTP', '-DEAP_PEAP', '-DEAP_PSK', '-DEAP_TLS', '-DEAP_TTLS', '-DEAP_WSC', '-DIEEE8021X_EAPOL'], "//conditions:default": []}) + inc_flags() + compiler_flags(),
