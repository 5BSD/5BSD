load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
load("//tools/build/bazel:bsd_python_test.bzl", "bsd_python_test")
load("//usr.sbin/wpa:common.bzl", "OPENSSL", "INET6", "PLATFORM", "inc_flags", "crypto_flags", "compiler_flags")
_LIBS = select({OPENSSL: ["//secure/lib/libssl:ssl", "//secure/lib/libcrypto:crypto"], "//conditions:default": []}) + ['//lib/libpcap:pcap', '//lib/libutil:util', '//usr.sbin/wpa/src/drivers:wpadrivers_pie', '//usr.sbin/wpa/src/ap:wpaap_pie', '//usr.sbin/wpa/src/l2_packet:wpal2_packet_pie', '//usr.sbin/wpa/src/eap_server:wpaeap_server_pie', '//usr.sbin/wpa/src/eapol_auth:wpaeapol_auth_pie', '//usr.sbin/wpa/src/eap_common:wpaeap_common_pie', '//usr.sbin/wpa/src/radius:wparadius_pie', '//usr.sbin/wpa/src/tls:wpatls_pie', '//usr.sbin/wpa/src/wps:wpawps_pie', '//usr.sbin/wpa/src/common:wpacommon_pie', '//usr.sbin/wpa/src/crypto:wpacrypto_pie', '//usr.sbin/wpa/src/utils:wpautils_pie', '//usr.sbin/wpa/src/pasn:wpapasn_pie']
_DYNAMIC = select({OPENSSL: ["//secure/lib/libssl:ssl_shared", "//secure/lib/libcrypto:crypto_shared"], "//conditions:default": []}) + ["//lib/libpcap:pcap_shared", "//lib/libutil:util_shared"]
cc_binary(name = "hostapd", srcs = ['//contrib/wpa:hostapd/config_file.c', '//contrib/wpa:hostapd/ctrl_iface.c', '//contrib/wpa:src/drivers/driver_bsd.c', '//contrib/wpa:hostapd/eap_register.c', '//contrib/wpa:hostapd/main.c'],
    deps = ["//contrib/wpa:hostapd_headers"] + _LIBS, dynamic_deps = _DYNAMIC,
    # bsd.init.mk re-includes ../Makefile.inc after the explicit include.
    # Preserve that real second macro/warning group, without reapplying crypto.
    copts = ["-fpie", "-DPIC", "-fPIE"] + inc_flags() + crypto_flags() + ["-DHOSTAPD", "-DCONFIG_L2_FREEBSD", "-DCONFIG_DNET_PCAP"] + select({INET6: ["-DCONFIG_IPV6"], "//conditions:default": []}) + inc_flags() + compiler_flags(),
    linkopts = ["-pie"], target_compatible_with = PLATFORM, visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_install.bzl", "bsd_compress", "bsd_install_file")
_EXAMPLES = "//tools/build/bazel/config:examples_enabled"
_MAN_TAGS = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=hostapd-man"], "//conditions:default": ["package=hostapd"]})
bsd_compress(name = "config_manual", src = "hostapd.conf.5", output = "install_manifest/hostapd.conf.5.gz", arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(manual = True, name = "config_manual_entry", src = ":config_manual", destination = "/usr/share/man/man5/hostapd.conf.5.gz", owner = "root", group = "wheel", mode = "0444", install_tags = _MAN_TAGS)
bsd_install_file(name = "example_0", src = "//contrib/wpa:hostapd/hostapd.conf", destination = "/usr/share/examples/hostapd/hostapd.conf", owner = "root", group = "wheel", mode = "0444", install_tags = ["package=hostapd"])
bsd_install_file(name = "example_1", src = "//contrib/wpa:hostapd/hostapd.eap_user", destination = "/usr/share/examples/hostapd/hostapd.eap_user", owner = "root", group = "wheel", mode = "0444", install_tags = ["package=hostapd"])
bsd_install_file(name = "example_2", src = "//contrib/wpa:hostapd/hostapd.wpa_psk", destination = "/usr/share/examples/hostapd/hostapd.wpa_psk", owner = "root", group = "wheel", mode = "0444", install_tags = ["package=hostapd"])
utility_installation(name = "install_manifest", program = "hostapd", manual = "hostapd.8", package = "hostapd", bindir = "/usr/sbin", man_section = "8", extra_entries = [":config_manual_entry"] + select({_EXAMPLES: [":example_0", ":example_1", ":example_2"], "//conditions:default": []}))
_DEBUG_DIRS = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=hostapd","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]}
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"],
    directories = select({_EXAMPLES: (_DEBUG_DIRS | {"/usr/share/examples/hostapd": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=hostapd"]}'}), "//conditions:default": _DEBUG_DIRS}),
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", epoch = 0,
    mtree = "@bsd_sdk//toolchain:extra_mtree", python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
bsd_python_test(name = "safe_cli_test", src = "safe_cli_test.py", data = [":hostapd", "//lib/libc:c_shared", "//lib/libsys:sys_shared", "//lib/libutil:util_shared", "//lib/libpcap:pcap_shared", "//lib/libthr:thr_shared"] + select({OPENSSL: ["//secure/lib/libssl:ssl_shared", "//secure/lib/libcrypto:crypto_shared"], "//conditions:default": []}) + select({"//tools/build/bazel/config:ofed_enabled": ["//lib/ofed/libibverbs:ibverbs_shared", "//lib/ofed/libbnxtre:bnxtre_shared", "//lib/ofed/libmlx5:mlx5_shared"], "//conditions:default": []}), visibility = ["//usr.sbin/wpa:__pkg__"])
