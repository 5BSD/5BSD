load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
cc_binary(name = "blocklistctl", srcs = ["//contrib/blocklist:bin/blocklistctl.c", "//contrib/blocklist:bin/conf.c", "//contrib/blocklist:bin/state.c", "//contrib/blocklist:bin/support.c", "//contrib/blocklist:bin/internal.c", "//contrib/blocklist:port/sockaddr_snprintf.c", "//contrib/blocklist:port/pidfile.c", "//contrib/blocklist:port/strtoi.c", "//contrib/blocklist:port/popenve.c"],
    deps = ["//contrib/blocklist:program_headers", "//lib/libblocklist:blocklist", "//lib/libutil:util"],
