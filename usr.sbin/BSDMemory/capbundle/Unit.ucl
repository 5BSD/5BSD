activation { boot = true; }
control = "system";
program = "BSDMemory";
restart = "on-failure";
oom_protect = true;
user = "capability";
attributes = ["system.notify.system"];
protect = ["ptrace", "signal", "wait", "sigkill", "sigcont", "sched", "core", "ktrace"];
limits { nofile = 64; nproc = 4; core = 0; }
umask = "0077";
