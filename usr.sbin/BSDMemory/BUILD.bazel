load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_import")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_header", "bsd_dtrace_cc_objects")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
bsd_dtrace_header(
    name = "provider", source = "bsdmemory_provider.d", output = "bsdmemory_provider.h",
    flags = ["-C", "-x", "nolibs"], object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:bootstrap", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti",
    runtime_libraries = ["//cddl/usr.sbin/dtrace:bootstrap_runtime"],
    tool_inputs = [ "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"], static_anchor = False,
)
cc_library(name = "provider_headers", hdrs = [":provider"], strip_include_prefix = ".")

cc_library(name = "objects", srcs = ["BSDMemory.c", "pressure.c", "pressure.h", "bsdmemory_probes.h", "trace_pressure.h"],
    deps = ['//lib/libnotify:notify', '//lib/libservice:service', '//lib/libsysctlcmp:sysctlcmp'] + select({_TRACE: [":provider_headers"], "//conditions:default": []}),
    local_defines = select({_TRACE: ["WITH_DTRACE"], "//conditions:default": []}),
    copts = ["-fPIE"], target_compatible_with = _PLATFORM)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider", provider_object = "bsdmemory_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group) for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"], deps = [":provider_link"] + ['//lib/libnotify:notify', '//lib/libservice:service', '//lib/libsysctlcmp:sysctlcmp'])
load("//tools/build/bazel:bsd_capimage.bzl", "bsd_capimage_policy")
bsd_capimage_policy(name = "policy_assembly", src = "//usr.sbin/BSDMemory/capbundle:Unit.ucl")
cc_binary(name = "BSDMemory", srcs = [":policy_assembly"], deps = select({_TRACE: [":traced"], "//conditions:default": [":objects"]}),
    dynamic_deps = ['//lib/libnotify:notify_shared', '//lib/libservice:service_shared', '//lib/libsysctlcmp:sysctlcmp_shared'],
    linkopts = ["-pie", "-Wl,-z,now"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])



exports_files(["pressure.c"], visibility = ["//usr.sbin/BSDMemory/tests:__pkg__"])
cc_library(name = "test_headers", hdrs = ["pressure.h", "bsdmemory_probes.h", "trace_pressure.h"],
    textual_hdrs = ["BSDMemory.c"], strip_include_prefix = ".", deps = ["//lib/libnotify:headers"],
    visibility = ["//usr.sbin/BSDMemory/tests:__pkg__"])

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
_BUNDLE = "/Capabilities/System/Memory.cap"
_UNIT = _BUNDLE + "/Units/bsdmemory.unit"
utility_installation(name = "program_install", keep_sections = [".5bsd.policy"], program = "BSDMemory", manual = "BSDMemory.8",
    package = "bsdmemory", bindir = _UNIT + "/bin", man_section = "8")
[bsd_install_file(name = name, src = src, destination = dest, owner = "root", group = "wheel",
    mode = "0444", install_tags = ["package=bsdmemory"])
 for name, src, dest in [
    ("bundle_install", "//usr.sbin/BSDMemory/capbundle:Bundle.ucl", _BUNDLE + "/Bundle.ucl"),
    ("unit_install", "//usr.sbin/BSDMemory/capbundle:Unit.ucl", _UNIT + "/Unit.ucl"),
 ]]
bsd_install_manifest(name = "bundle_install_manifest", entries = [":bundle_install", ":unit_install"])
load("//usr.sbin/BSDMemory/tests:installation.bzl", TEST_DIRECTORIES = "DIRECTORIES", TEST_MANIFESTS = "MANIFESTS")
[bsd_install_archive(name = name,
    manifests = [":program_install", ":bundle_install_manifest"] + (select({"//tools/build/bazel/config:tests_enabled": TEST_MANIFESTS, "//conditions:default": []}) if include_tests else []),
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bsdmemory"]}'
        for d in [_BUNDLE, _BUNDLE + "/Units", _UNIT, _UNIT + "/bin"]} |
        {"/usr/lib/debug" + d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bsdmemory","dbg"]}'
         for d in ["/Capabilities", "/Capabilities/System", _BUNDLE, _BUNDLE + "/Units", _UNIT, _UNIT + "/bin"]} | (select({"//tools/build/bazel/config:tests_enabled": TEST_DIRECTORIES, "//conditions:default": {}}) if include_tests else {}),
    mtree_specs = {"//etc/mtree:BSD.tests.dist": "/usr/tests", "//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"]) for name, include_tests in [("daemon_install_archive", False), ("install_archive", True)]]
