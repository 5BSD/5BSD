# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = "mtree", srcs = ['//contrib/mtree:compare.c', '//contrib/mtree:crc.c', '//contrib/mtree:create.c', '//contrib/mtree:excludes.c', '//contrib/mtree:getid.c', '//contrib/mtree:misc.c', '//contrib/mtree:mtree.c', '//contrib/mtree:only.c', '//contrib/mtree:spec.c', '//contrib/mtree:specspec.c', '//contrib/mtree:verify.c', '//contrib/mknod:pack_dev.c'],
    deps = ["//contrib/mtree:install_headers", "//contrib/mknod:headers", "//lib/libnetbsd:netbsd_pie", "//lib/libmd:md_link", "//lib/libutil:util"],
    dynamic_deps = ["//lib/libmd:md_shared", "//lib/libutil:util_shared"], copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_install.bzl", "bsd_compress", "bsd_install_file")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
bsd_compress(name = "format_manual", src = "mtree.5", output = "mtree.5.gz", arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip",
    redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(manual = True, name = "install_format_manual", src = ":format_manual", destination = "/usr/share/man/man5/mtree.5.gz",
    owner = "root", group = "wheel", mode = "0444", install_tags = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=mtree-man"], "//conditions:default": ["package=mtree"]}))
utility_installation(name = "install_manifest", program = "mtree", manual = "//contrib/mtree:mtree.8", man_section = "8", package = "mtree", bindir = "/usr/sbin", aliases = ["nmtree"], extra_entries = [":install_format_manual"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive", visibility = ["//usr.sbin:__pkg__"],
    manifests = [":install_manifest"] + select({"//tools/build/bazel/config:tests_enabled": ["//usr.sbin/nmtree/tests:install_manifest"], "//conditions:default": []}),
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=mtree","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]} | select({"//tools/build/bazel/config:tests_enabled": {"/usr/tests/usr.sbin/nmtree": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests"]}'}, "//conditions:default": {}}),
    mtree_specs = {
        "//etc/mtree:BSD.tests.dist": "/usr/tests",
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
