# switchboard unit for the system-extension broker (sysextd), which owns kernel-
# module loading.  Launched and supervised by switchboard like every other daemon
# (docs/capability-authority-model.md) — PID 1 no longer loads modules.
#
# sysextd is a socket-free service_provider: it exposes the well-known name
# system.SystemExtension and serves each client on its own mac_capability
# channel, so a SYSTEM-domain consumer requests a module by name (service_open)
# exactly like every other capability-plane daemon.
#
# boot = true because early consumers (storage, networking) may need a module
# before the general service population comes up.  PID 1 owns /dev/mac_capability,
# so sysextd does not open it: it declares the kldload system gate below and
# switchboard delivers a matching system token (capsule claims the gate under
# its nonce).  service_provider_authorize_capabilities(3) authorizes that
# token, adding sysextd's nonce to the gate's authorized set.  Read-only module
# queries (kldfind/kldstat) are not gated at all, so no kldstat declaration is
# needed.
#
# user = root: kldload(2) performs a base priv_check(PRIV_KLD_LOAD)
# before the mac_capability gate, so the loader must run privileged.  Root alone
# is NOT sufficient — the gate denies even root unless it holds an authorized
# token — so the delivered system capability below is what actually permits the
# load; root only satisfies the classical privilege check underneath it.
activation { boot = true; ipc = ["system.SystemExtension"]; }
# Container model: sysextd reconciles the modules it loaded on bundles' behalf
# against the installed-or-running bundles (docs/capability-container-model.md);
# the live set is read from these delivered directories, never opened by path.
# SYSEXTD_RECLAIM_INTERVAL (environment { ... }) sets the timer/grace seconds.
directories = ["/Capabilities/System", "/Capabilities/Apps", "/Capabilities/Run/live"];
management = "core";
protect = ["ptrace", "signal", "wait", "sigkill", "sigcont", "sched",
    "core", "ktrace"];
program = "sysextd";
restart = "on-failure";
user = "root";

# sysextd cannot enter capability mode (kldload needs the global module path and
# PRIV_KLD_LOAD), so it is an ambient provider: switchboard takes its SVC_OP_READY
# as the readiness boundary instead of kernel-observed capability-mode entry.
ambient = true;

capabilities {
    system = ["kldload"];
}

limits { nofile = 1024; nproc = 128; core = 0; }
umask = "0022";
