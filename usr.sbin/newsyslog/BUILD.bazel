# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_import")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_header", "bsd_dtrace_cc_objects")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
bsd_dtrace_header(
    name = "provider", source = "logrotate_provider.d", output = "logrotate_provider.h",
    flags = ["-C", "-x", "nolibs"], object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:dtrace", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti",
    runtime_libraries = ['//cddl/lib/libdtrace:dtrace_shared', '//cddl/lib/libctf:ctf_shared', '//lib/libelf:elf_shared', '//lib/libproc:proc_shared', '//cddl/lib/libspl:spl_shared', '//lib/libxo/libxo:xo_shared', '//lib/libutil:util_shared', '//lib/libprocstat:procstat_shared', '//lib/librtld_db:rtld_db_shared', '//lib/libcxxrt:cxxrt_shared', '//lib/libz:z_shared', '//lib/libkvm:kvm_shared'],
    tool_inputs = [ "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"], static_anchor = True,
)
cc_library(name = "provider_headers", hdrs = [":provider"], strip_include_prefix = ".")

cc_library(name = "headers", hdrs = ["extern.h", "pathnames.h", "logrotate_trace.h"], strip_include_prefix = ".")
cc_library(name = "objects", srcs = ["newsyslog.c", "ptimes.c"], deps = [":headers", "//lib/libsbuf:sbuf", "//lib/libutil:util"] + select({_TRACE: [":provider_headers"], "//conditions:default": []}), local_defines = select({_TRACE: ["WITH_COVERAGE_DTRACE"], "//conditions:default": []}), copts = ["-fPIE"], target_compatible_with = _PLATFORM)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider", provider_object = "logrotate_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group) for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"], deps = [":provider_link"] + ["//lib/libsbuf:sbuf", "//lib/libutil:util"])
cc_binary(name = "newsyslog", deps = select({_TRACE: [":traced"], "//conditions:default": [":objects"]}),
    dynamic_deps = ["//lib/libsbuf:sbuf_shared", "//lib/libutil:util_shared"],
    linkopts = ["-pie"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_compress")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_file(name = "config", src = "newsyslog.conf", destination = "/etc/newsyslog.conf", owner = "root", group = "wheel", mode = "0644", install_tags = ["package=newsyslog", "config"])
bsd_compress(name = "manual5", src = "newsyslog.conf.5", output = "newsyslog.conf.5.gz", arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(name = "install_manual5", src = ":manual5", destination = "/usr/share/man/man5/newsyslog.conf.5.gz", owner = "root", group = "wheel", mode = "0444", install_tags = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=newsyslog-man"], "//conditions:default": ["package=newsyslog"]}))
utility_installation(name = "install_manifest", program = "newsyslog", manual = "newsyslog.8", package = "newsyslog", bindir = "/usr/sbin", man_section = "8", extra_entries = [":config", ":install_manual5"])
bsd_install_archive(name = "install_archive",
    manifests = [":install_manifest", "//usr.sbin/newsyslog/newsyslog.conf.d:install_manifest"] + select({"//tools/build/bazel/config:tests_enabled": ["//usr.sbin/newsyslog/tests:install_manifest"], "//conditions:default": []}),
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=newsyslog","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]} | {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities"]}' for d in ["/etc", "/etc/newsyslog.conf.d"]},
    mtree_specs = {"//etc/mtree:BSD.tests.dist": "/usr/tests", "//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
