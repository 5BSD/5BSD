load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
cc_binary(name = "moused", srcs = ["moused.c", "quirks.c", "util.c", "util-evdev.c", "util-list.c", "event-names.h", "quirks.h", "util.h", "util-evdev.h", "util-list.h"], deps = ["//lib/msun:m", "//lib/libutil:util"], dynamic_deps = ["//lib/msun:m_shared", "//lib/libutil:util_shared"], copts = ["-fPIE"], linkopts = ["-pie"], linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_compress")
bsd_install_file(name = "config", src = "moused.conf", destination = "/etc/moused.conf", owner = "root", group = "wheel", mode = "0644", install_tags = ["package=console-tools", "config"])
bsd_install_file(name = "quirks", src = "quirks/5-generic-touchpad.quirks", destination = "/usr/share/moused/5-generic-touchpad.quirks", owner = "root", group = "wheel", mode = "0444", install_tags = ["package=console-tools"])
bsd_compress(name = "config_manual", src = "moused.conf.5", output = "moused.conf.5.gz", arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(manual = True, name = "config_manual_file", src = ":config_manual", destination = "/usr/share/man/man5/moused.conf.5.gz", owner = "root", group = "wheel", mode = "0444", install_tags = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=console-tools-man"], "//conditions:default": ["package=console-tools"]}))
utility_installation(name = "install_manifest", program = "moused", manual = "moused.8", package = "console-tools", bindir = "/usr/sbin", man_section = "8", aliases = [], extra_entries = [":config", ":quirks", ":config_manual_file"])
bsd_install_archive(name = "install_archive",
    manifests = [":install_manifest"],
    directories = {"/etc": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities"]}', "/usr/share/moused": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=console-tools"]}'} | {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=console-tools","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
