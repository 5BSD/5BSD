load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive_set")
# Mirrors the maintained mouse-service subtree selection.
_PROGRAMS = ["moused", "msconvd"]
bsd_install_archive_set(name = "installation_archives",
    archives = ["//usr.sbin/moused/" + name + ":install_archive" for name in _PROGRAMS],
    visibility = ["//visibility:public"])
