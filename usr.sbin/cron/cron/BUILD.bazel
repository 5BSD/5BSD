# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_import")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_header", "bsd_dtrace_cc_objects")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
bsd_dtrace_header(
    name = "provider", source = "cron_provider.d", output = "cron_provider.h",
    flags = ["-C", "-x", "nolibs"], object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:dtrace", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti",
    runtime_libraries = ['//cddl/lib/libdtrace:dtrace_shared', '//cddl/lib/libctf:ctf_shared', '//lib/libelf:elf_shared', '//lib/libproc:proc_shared', '//cddl/lib/libspl:spl_shared', '//lib/libxo/libxo:xo_shared', '//lib/libutil:util_shared', '//lib/libprocstat:procstat_shared', '//lib/librtld_db:rtld_db_shared', '//lib/libcxxrt:cxxrt_shared', '//lib/libz:z_shared', '//lib/libkvm:kvm_shared'],
    tool_inputs = [ "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"], static_anchor = True,
)
cc_library(name = "provider_headers", hdrs = [":provider"], strip_include_prefix = ".")

cc_library(name = "headers", hdrs = ["cron.h", "config.h", "externs.h", "macros.h", "pathnames.h", "globals.h", "structs.h", "funcs.h", "cron_trace.h", "cron_probes.h"], strip_include_prefix = ".", visibility = ["//usr.sbin/cron:__subpackages__"])
cc_library(name = "objects", srcs = ["cron.c", "database.c", "do_command.c", "job.c", "user.c", "popen.c"], deps = [":headers"] + ["//usr.sbin/cron/lib:cron_pie", "//lib/libpam/libpam:pam", "//lib/libutil:util"] + select({_TRACE: [":provider_headers"], "//conditions:default": []}),
    local_defines = ["LOGIN_CAP", "PAM"] + select({_TRACE: ["WITH_DTRACE"], "//conditions:default": []}), copts = ["-fPIE"], target_compatible_with = _PLATFORM)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider", provider_object = "cron_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group) for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"], deps = [":provider_link"] + ["//usr.sbin/cron/lib:cron_pie", "//lib/libpam/libpam:pam", "//lib/libutil:util"])
cc_binary(name = "cron", deps = select({_TRACE: [":traced"], "//conditions:default": [":objects"]}),
    dynamic_deps = ["//lib/libpam/libpam:pam_shared", "//lib/libutil:util_shared"],
    linkopts = ["-pie"], target_compatible_with = _PLATFORM + select({"//tools/build/bazel/config:casper_enabled": [], "//conditions:default": ["@platforms//:incompatible"]}), visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file")
bsd_install_file(name = "config", src = "crontab", destination = "/etc/crontab", owner = "root", group = "wheel", mode = "0644", install_tags = ["package=cron", "config"])
utility_installation(name = "install_manifest", program = "cron", manual = "cron.8", package = "cron", bindir = "/usr/sbin", man_section = "8", extra_entries = [":config"])
