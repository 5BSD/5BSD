load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive_set")
# Mirrors the maintained Hyper-V daemon subtree selection.
_PROGRAMS = ["kvp", "vss"]
bsd_install_archive_set(name = "installation_archives",
    archives = ["//usr.sbin/hyperv/tools/" + name + ":install_archive" for name in _PROGRAMS],
    visibility = ["//visibility:public"])
