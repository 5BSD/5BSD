load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive_set")
# Mirrors the maintained ACPI subtree selection.
_PROGRAMS = ["acpiconf", "acpidb", "acpidump", "einj", "iasl"]
bsd_install_archive_set(name = "installation_archives",
    archives = ["//usr.sbin/acpi/" + name + ":install_archive" for name in _PROGRAMS],
    visibility = ["//visibility:public"])
