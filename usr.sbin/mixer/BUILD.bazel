# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = 'mixer', srcs = ['mixer.c'],
    deps = ['//lib/libmixer:mixer'], dynamic_deps = ['//lib/libmixer:mixer_shared'],
    copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = 'mixer', manual = 'mixer.8', package = 'sound', man_section = '8', bindir = '/usr/sbin')
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"] + select({
        "//tools/build/bazel/config:tests_enabled": ["//usr.sbin/mixer/tests:install_manifest"],
        "//conditions:default": [],
    }),
    directories = select({
        "//tools/build/bazel/config:tests_enabled": {directory: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=sound","dbg"]}' for directory in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]} | {
            "/usr/tests/usr.sbin/mixer": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests"]}',
        },
        "//conditions:default": {directory: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=sound","dbg"]}' for directory in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]},
    }),
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
        "//etc/mtree:BSD.tests.dist": "/usr/tests",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
