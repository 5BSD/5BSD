# [CRYPTO] is the local authority-replacement provider for DTYPE_CRYPTO.
activation { boot = true; ipc = ["org.5bsd.CryptoCmp"]; }
restart = "on-failure";
user = "capability";
# The DTYPE_CRYPTO provider needs /dev/crypto; ensure cryptodev is loaded
# before launch (serviced loads required modules via authorityd's kld authority).
kmod_requires = ["cryptodev"];
