schema = "org.5bsd.serviced.service";
schema_version = "1.0.0";
bundle_id = "org.5bsd.CryptoCmp";
version = "3.1.0";
author = "5BSD";

# [CRYPTO] is the local authority-replacement provider for DTYPE_CRYPTO.
program = "localcrypto";
provides = ["org.5bsd.CryptoCmp"];
restart = "on-failure";
user = "capability";
