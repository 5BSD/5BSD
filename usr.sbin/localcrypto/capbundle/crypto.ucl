# [CRYPTO] is the local authority-replacement provider for DTYPE_CRYPTO.
activation { boot = true; ipc = ["system.Crypto"]; }
program = "Crypto";
restart = "on-failure";
user = "capability";

limits { nofile = 512; nproc = 64; core = 0; }
umask = "0077";
# The DTYPE_CRYPTO provider needs /dev/crypto (from the cryptodev module).  It
# self-serves that module at startup via service_ensure_extension(3) over
# system.SystemExtension (sysextd), so no manifest kmod declaration is needed and
# neither PID 1 nor serviced loads modules on its behalf.
