load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive_set")
# Mirrors the maintained FIFO log subtree selection.
_PROGRAMS = ["fifolog_create", "fifolog_reader", "fifolog_writer"]
bsd_install_archive_set(name = "installation_archives",
    archives = ["//usr.sbin/fifolog/" + name + ":install_archive" for name in _PROGRAMS],
    visibility = ["//visibility:public"])
