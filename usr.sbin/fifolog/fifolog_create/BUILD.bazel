load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
cc_binary(name = "fifolog_create", srcs = ["fifolog_create.c"], deps = ["//lib/libutil:util", "//usr.sbin/fifolog/lib:fifolog_pie"], dynamic_deps = ["//lib/libutil:util_shared", "//lib/libz:z_shared"], copts = ["-fPIE"], linkopts = ["-pie"], linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_install.bzl", "bsd_compress", "bsd_install_file", "bsd_install_link")
_MAN_TAGS = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=utilities-man"], "//conditions:default": ["package=utilities"]})
bsd_compress(name = "manual", src = "fifolog.1", output = "fifolog.1.gz", arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(manual = True, name = "manual_file", src = ":manual", destination = "/usr/share/man/man1/fifolog.1.gz", owner = "root", group = "wheel", mode = "0444", install_tags = _MAN_TAGS)
[bsd_install_link(manual = True, name = "manual_" + tool, destination = "/usr/share/man/man1/fifolog_" + tool + ".1.gz", target = "/usr/share/man/man1/fifolog.1.gz", kind = "hardlink", owner = "root", group = "wheel", mode = "0444", install_tags = _MAN_TAGS) for tool in ["create", "reader", "writer"]]
utility_installation(name = "install_manifest", program = "fifolog_create", manual = None, package = "utilities", bindir = "/usr/sbin", man_section = "8", aliases = [], extra_entries = [":manual_file", ":manual_create", ":manual_reader", ":manual_writer"])
bsd_install_archive(name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
