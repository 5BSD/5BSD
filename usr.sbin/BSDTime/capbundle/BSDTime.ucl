activation { boot = true; ipc = ["system.Time"]; }
control = "core";
protect = ["ptrace", "signal", "wait", "sigkill", "sigcont", "sched",
    "core", "ktrace"];
program = "BSDTime";
restart = "on-failure";
user = "capability";

# BSDTime is born in capability mode.  Stepping/slewing the clock
# (clock_settime(2)/adjtime(2)) is refused at the syscall boundary in capability
# mode, so BSDTime holds a SYS_GATE_SETTIME "system" gate token (delegated by
# switchboard, authorized via service_provider_authorize_capabilities) and
# performs the step/slew THROUGH the gate (service_system_settime/adjtime), which
# the kernel executes in kernel context after verifying the held claim.  The gate
# claim replaces PRIV_SETTIMEOFDAY; the raw syscalls stay refused, so the sandbox
# is never loosened.  Reads (CLOCK_REALTIME) are unprivileged; writes are bounded
# by the per-label policy (time.conf), default-deny.  Runs as the unprivileged
# capability user — the token, not uid, is the authority.
capabilities { system = ["settime"]; }

limits { nofile = 256; nproc = 64; core = 0; }
umask = "0077";
