load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_import")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_header", "bsd_dtrace_cc_objects")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
bsd_dtrace_header(
    name = "provider", source = "bsdnamespace_provider.d", output = "bsdnamespace_provider.h",
    flags = ["-C", "-x", "nolibs"], object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:bootstrap", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti",
    runtime_libraries = ["//cddl/usr.sbin/dtrace:bootstrap_runtime"],
    tool_inputs = [ "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"], static_anchor = False,
)
cc_library(name = "provider_headers", hdrs = [":provider"], strip_include_prefix = ".")

cc_library(name = "objects", srcs = ["bsdnamespace.c", "reclaim.c", "bsdnamespace_reclaim.h", "bsdnamespace_test.h", "bsdnamespace_probes.h"],
    deps = ['//lib/libnamespacecmp:namespacecmp', '//lib/libfilesystemcmp:filesystemcmp', '//lib/libservice:service', '//lib/libchannel:channel', '//lib/libjail:jail', '//lib/libmd:md_link', '//lib/libcapreclaim:capreclaim', '//lib/liblogcmp:logcmp', '//lib/libsysctlcmp:sysctlcmp', '//lib/libfidl:fidl', '//lib/libthr:thr', '//lib/libnamespacecmp:generated_headers', '//lib/libcapsulert:namespace_protocol_headers'] + select({_TRACE: [":provider_headers"], "//conditions:default": []}),
    local_defines = select({_TRACE: ["WITH_DTRACE"], "//conditions:default": []}),
    copts = ["-fPIE"], target_compatible_with = _PLATFORM)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider", provider_object = "bsdnamespace_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group) for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"], deps = [":provider_link"] + ['//lib/libnamespacecmp:namespacecmp', '//lib/libfilesystemcmp:filesystemcmp', '//lib/libservice:service', '//lib/libchannel:channel', '//lib/libjail:jail', '//lib/libmd:md_link', '//lib/libcapreclaim:capreclaim', '//lib/liblogcmp:logcmp', '//lib/libsysctlcmp:sysctlcmp', '//lib/libfidl:fidl', '//lib/libthr:thr', '//lib/libnamespacecmp:generated_headers', '//lib/libcapsulert:namespace_protocol_headers'])
load("//tools/build/bazel:bsd_capimage.bzl", "bsd_capimage_policy")
bsd_capimage_policy(name = "policy_assembly", src = "//usr.sbin/BSDNamespace/capbundle:bsdnamespace.ucl")
cc_binary(name = "BSDNamespace", srcs = [":policy_assembly"], deps = select({_TRACE: [":traced"], "//conditions:default": [":objects"]}),
    dynamic_deps = ['//lib/libnamespacecmp:namespacecmp_shared', '//lib/libfilesystemcmp:filesystemcmp_shared', '//lib/libservice:service_shared', '//lib/libchannel:channel_shared', '//lib/libjail:jail_shared', '//lib/libmd:md_shared', '//lib/libcapreclaim:capreclaim_shared', '//lib/liblogcmp:logcmp_shared', '//lib/libsysctlcmp:sysctlcmp_shared', '//lib/libfidl:fidl_shared', '//lib/libthr:thr_shared'],
    linkopts = ["-pie", "-Wl,-z,now"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
_BUNDLE = "/Capabilities/System/Namespace.cap"
_UNIT = _BUNDLE + "/Units/bsdnamespace.unit"
utility_installation(name = "program_install", keep_sections = [".5bsd.policy"], program = "BSDNamespace", manual = "BSDNamespace.8",
    package = "runtime", bindir = _UNIT + "/bin", man_section = "8")
[bsd_install_file(name = name, src = src, destination = dest, owner = "root", group = "wheel",
    mode = "0444", install_tags = ["package=runtime"])
 for name, src, dest in [
    ("bundle_install", "//usr.sbin/BSDNamespace/capbundle:Bundle.ucl", _BUNDLE + "/Bundle.ucl"),
    ("unit_install", "//usr.sbin/BSDNamespace/capbundle:bsdnamespace.ucl", _UNIT + "/Unit.ucl"),
 ]]
bsd_install_manifest(name = "bundle_install_manifest", entries = [":bundle_install", ":unit_install"])
bsd_install_archive(name = "daemon_install_archive", visibility = ["//usr.sbin:__pkg__"],
    manifests = [":program_install", ":bundle_install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime"]}'
        for d in [_BUNDLE, _BUNDLE + "/Units", _UNIT, _UNIT + "/bin"]} |
        {"/usr/lib/debug" + d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime","dbg"]}'
         for d in ["/Capabilities", "/Capabilities/System", _BUNDLE, _BUNDLE + "/Units", _UNIT, _UNIT + "/bin"]},
    mtree_specs = {"//etc/mtree:BSD.tests.dist": "/usr/tests", "//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])


exports_files(["bsdnamespace.c", "reclaim.c"], visibility = ["//usr.sbin/BSDNamespace/tests:__pkg__"])
cc_library(name = "test_headers", hdrs = ["bsdnamespace_test.h", "bsdnamespace_reclaim.h", "bsdnamespace_probes.h"],
    textual_hdrs = ["bsdnamespace.c"], strip_include_prefix = ".",
    deps = ["//lib/libcapsulert:namespace_protocol_headers"], visibility = ["//usr.sbin/BSDNamespace/tests:__pkg__"])

load("//usr.sbin/BSDNamespace/tests:installation.bzl", TEST_MANIFESTS = "MANIFESTS", TEST_DIRECTORIES = "DIRECTORIES")
bsd_install_archive(name = "install_archive",
    manifests = [":program_install", ":bundle_install_manifest"] + select({"//tools/build/bazel/config:tests_enabled": TEST_MANIFESTS, "//conditions:default": []}),
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime"]}'
        for d in [_BUNDLE, _BUNDLE + "/Units", _UNIT, _UNIT + "/bin"]} |
        {"/usr/lib/debug" + d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime","dbg"]}'
         for d in ["/Capabilities", "/Capabilities/System", _BUNDLE, _BUNDLE + "/Units", _UNIT, _UNIT + "/bin"]} | select({"//tools/build/bazel/config:tests_enabled": TEST_DIRECTORIES, "//conditions:default": {}}),
    mtree_specs = {"//etc/mtree:BSD.tests.dist": "/usr/tests", "//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])
