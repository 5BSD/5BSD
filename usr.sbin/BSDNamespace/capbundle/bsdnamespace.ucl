# switchboard unit for the namespace (jail) broker (bsdnamespace), which owns jail
# construction (jail_set(2)).  Launched and supervised by switchboard like every
# other daemon (docs/capsule-switchboard-layering-cleanup.md, Phase 3) — PID 1
# no longer creates jails, and switchboard never brokers one.
#
# bsdnamespace is a socket-free service_provider exposing system.Namespace.  It is
# pure consumer self-service: a jailed program's library resolves bsdnamespace by name
# (service_enter_namespace(3)), bsdnamespace creates the jail rooted at the requested
# path and returns its owning descriptor, and the program jail_attach_jd(2)s
# itself.  No boot activation: the first consumer that self-jails pulls bsdnamespace up
# on demand, exactly like storage and module loading.
#
# BSDNamespace is born in capability mode as the unprivileged capability user.
# jail_set(2)/jail_get(2) are not capsicum-enabled and jail_set needs the classic
# PRIV_JAIL_SET privilege plus a global-namespace path lookup; instead BSDNamespace
# holds the SYS_GATE_JAIL "system" gate (minted by Capsule from the capabilities
# block below, delivered by switchboard) and performs every jail create/get/remove
# THROUGH the gate (service_system_jail_set/get -> kern_jail_set_gated/kern_jail_get),
# whose held claim replaces PRIV_JAIL_SET and whose jail-root namei runs in kernel
# context (UIO_SYSSPACE, exempt from the capmode userspace-path restriction).
# bsdnamespace's jails are scoped by the caller's unforgeable channel label
# (self-jailing is self-confinement).
activation { ipc = ["system.Namespace"]; }
# Container model: bsdnamespace reconciles the persistent jails it created against
# the installed-or-running bundles (docs/capability-container-model.md); the
# live set is read from these delivered directories, never opened by path.
directories = ["/Capabilities/System", "/Capabilities/Apps", "/Capabilities/Run/live"];
management = "system";
protect = ["ptrace", "signal", "wait", "sigkill", "sigcont", "sched", "core", "ktrace"];
program = "BSDNamespace";
restart = "on-failure";
user = "capability";
capabilities {
    system = ["jail"];
}

limits { nofile = 1024; nproc = 128; core = 0; }
umask = "0022";
