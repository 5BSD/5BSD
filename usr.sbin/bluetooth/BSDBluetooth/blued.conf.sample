# blued.conf - Bluetooth Low Energy daemon configuration
# See blued(8) for details.  UCL format.

# Compatibility profile.
#
# Some behaviours have two defensible answers: one that is correct by the
# Bluetooth specification, and one that interoperates with BlueZ (Linux),
# which does not always follow it.  Rather than one knob per split, name an
# intent here and blued sets the whole family coherently.  Any individual knob
# named elsewhere in this file, or on the command line, still wins.
#
#   "default"  what blued has always shipped, and what it ships today:
#              specification behaviour everywhere it is free, and BlueZ's
#              Database Hash order, because changing that invalidates the
#              hash cached by every already-paired Linux peer.  DEFAULT.
#   "spec"     strict specification conformance -- what a SIG qualification
#              run wants.  Costs Linux interoperability on the Database Hash.
#   "bluez"    match BlueZ where BlueZ and the specification differ -- what a
#              fleet of Linux peers wants.  Costs conformance on the ATT
#              error code for an unencrypted link.
#
# The profile selects, today:
#
#   knob                       default    spec       bluez
#   database_hash_byte_order   bluez      reversed   bluez
#   att_error_selection        spec       spec       bluez
#
# The "spec" and "bluez" Database Hash answers are mutually exclusive: no
# setting satisfies both GATT/SR/GAS/BV-02-C and a deployed Linux peer.
# Equivalent command line flag: blued -P default | -P spec | -P bluez.
# compatibility_profile = "default";

general {
    # loglevel: 0=quiet, 1=info, 2=debug/trace
    loglevel = 1;

    # Bond database path
    bonddb = "/var/db/blued/bonds";

    # BTSnoop packet log (Wireshark-compatible)
    # logfile = "/var/log/blued.pcap";

    # BLE peripheral advertised name (default: FreeBSD-BLE)
    # peripheral_name = "MyDevice";
}

# Adapter list: "auto" discovers all ubt* adapters
# Or specify explicitly: adapters = ["ubt0", "ubt1"];
adapters = ["auto"];

security {
    # SMP I/O capability: none, display_only, display_yesno,
    #   keyboard_only, keyboard_display
    io_capability = "keyboard_display";

    # Request bonding (persist keys).  When false the Bonding bit is
    # cleared in the SMP AuthReq and pairing does not store long-term keys.
    # Default: true (current behaviour).
    bondable = true;

    # Require MITM-authenticated pairing (sets the MITM bit in AuthReq).
    # When false, Just Works (unauthenticated) associations are offered.
    # Default: true (current behaviour).
    # mitm = true;

    # LE Secure Connections mode: off | on | only
    #   off  = advertise legacy only
    #   on   = advertise SC, allow legacy fallback (default, current behaviour)
    #   only = advertise SC and reject legacy pairing
    sc = "on";

    # Advertise Keypress Notifications during Passkey Entry (Core Spec Vol 3
    # Part H 3.5.8).  Default: true (current behaviour).
    # keypress = true;

    # Key-distribution mask: which keys are exchanged during bonding, a
    # comma list of enc (LTK), id (IRK), sign (CSRK), link (BR/EDR link
    # key), or "none".
    # Default: "enc,id,sign,link" (mask 0x0f -- the full set, matching the
    # SMP library seed).  Drop "sign" to stop distributing/requesting a CSRK
    # (ATT Signed Writes then never become available for the peer).
    # key_dist = "enc,id,sign,link";

    # Minimum pairing security floor: none | enc | auth | sc.  A pairing that
    # cannot reach this level is rejected.  Default: auth.
    # min_pairing_security = "auth";

    # Minimum encryption key size for legacy pairing (7-16, default 16).
    # SC always requires 16 regardless.  Lower values improve compat
    # with older peripherals.
    # min_key_size = 16;
}

# GATT server behaviour.
gatt {
    # Byte order in which the GATT Database Hash characteristic (0x2B2A) is
    # PUBLISHED on the wire and in which a peer's published hash is READ.
    # The hash itself is always AES-CMAC(k=0, m) over the attribute
    # concatenation (Core Spec Vol 3 Part G 7.3.1); only the order of the 16
    # octets in the characteristic value changes.  The specification does not
    # settle that order, and the two live answers are mutually exclusive:
    #
    #   "bluez"     transmit the raw AES-CMAC output, most significant octet
    #               first, exactly as Appendix B prints it.  This is what
    #               BlueZ does (it performs no swap on either the server or
    #               the client side), so it is what every Linux peer expects.
    #               DEFAULT -- changing it invalidates the cached Database
    #               Hash of every already-paired Linux peer, which silently
    #               breaks GATT robust caching against them.
    #               Synonyms: "cmac", "msb_first", "linux".
    #
    #   "reversed"  transmit the same 128-bit value least significant octet
    #               first.  Table 7.8 types the value uint128 and Vol 3 Part G
    #               2.4 makes characteristic values little-endian unless
    #               otherwise defined; Zephyr swaps for exactly this reason.
    #               This is what the Bluetooth SIG qualification test
    #               GATT/SR/GAS/BV-02-C expects -- set it for a PTS
    #               qualification run.
    #               Synonyms: "little_endian", "lsb_first", "pts", "zephyr".
    #
    # Equivalent command line flag: blued -H bluez | -H reversed.
    # Bonds are unaffected: the hash is stored internally, and in the bond
    # database, in computation order regardless of this setting.
    # database_hash_byte_order = "bluez";

    # Which ATT error a denied service request gets on an UNENCRYPTED link.
    #
    #   "spec"   Core Spec Vol 3 Part C 10.3.1 / Table 10.2: the error is
    #            chosen by whether a key (LTK or STK) EXISTS for the peer --
    #            0x05 Insufficient Authentication means "you have no key, go
    #            and pair", 0x0F Insufficient Encryption means "you have a
    #            key, go and encrypt".  Zephyr and NimBLE implement this.
    #            DEFAULT.
    #   "bluez"  choose from the attribute's permission bits instead: an
    #            authentication-required attribute yields 0x05, an
    #            encryption-required one yields 0x0F, whatever the peer's key
    #            state.  This is what BlueZ src/shared/gatt-server.c does; it
    #            diverges from the specification, and it is offered for peers
    #            written against that behaviour.
    #
    # Set here it overrides the compatibility profile for this behaviour
    # alone.
    # att_error_selection = "spec";
}

features {
    eatt = true;
    privacy = true;
    reconnect = true;
    reconnect_max_delay = 60;

    # RPA (Resolvable Private Address) rotation timeout in seconds.
    # Valid range: 1-3600.  Default: 900 (15 minutes).
    # rpa_timeout = 900;

    # Peer privacy mode applied to resolving-list entries:
    #   "device"  = accept both RPAs and the peer identity address (default)
    #   "network" = accept resolvable private addresses only
    # privacy_mode = "device";

    # Enable peripheral (advertiser) mode (default: no)
    # peripheral_mode = false;

    # Enable scan (observer) mode on startup (default: no)
    # scan_mode = false;

}

# Per-device overrides
# devices {
#     "aa:bb:cc:dd:ee:ff" {
#         type = "random";
#         reconnect = true;
#     }
# }

# Custom GATT services (peripheral mode).
# Each "service" block adds a service to the GATT database.
#
# UUID format:
#   "0xNNNN"                                — 16-bit Bluetooth SIG UUID
#   "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"  — 128-bit vendor UUID
#
# Characteristic properties (comma-separated):
#   read, write, write_no_rsp, notify, indicate, auth_signed_write
#
# Characteristic permissions (comma-separated):
#   read, write, read_encrypt, write_encrypt, read_authen, write_authen
#
# Value: hex string (e.g., "0100" = 2 bytes {0x01, 0x00}), or "" for empty.
# If properties include notify or indicate, a CCCD descriptor is auto-added.

# service "Custom Sensor" {
#     uuid = "0xFFE0"
#     characteristic "Sensor Data" {
#         uuid = "0xFFE1"
#         properties = "read,notify"
#         permissions = "read"
#         value = "00"
#     }
#     characteristic "Control Point" {
#         uuid = "0xFFE2"
#         properties = "write"
#         permissions = "write_encrypt"
#         value = ""
#     }
# }

# service "Custom 128-bit" {
#     uuid = "12345678-1234-1234-1234-123456789abc"
#     characteristic "Data" {
#         uuid = "12345678-1234-1234-1234-123456789abd"
#         properties = "read,write"
#         permissions = "read,write"
#         value = "0000"
#     }
# }

# A characteristic may carry non-CCCD "descriptor" blocks, and a service may
# declare "include" blocks referencing another service's handle range.  (The
# CCCD is still auto-added from notify/indicate; author only other descriptors
# here, e.g. Characteristic User Description 0x2901, Report Reference 0x2908.)
# service "Battery" {
#     uuid = "0x180F"
#     include {
#         start = 16          # handle range of the included service
#         end   = 32
#         uuid  = "0x1801"    # optional included-service UUID
#     }
#     characteristic "Battery Level" {
#         uuid = "0x2A19"
#         properties = "read,notify"
#         permissions = "read"
#         value = "64"
#         descriptor {
#             uuid = "0x2901"         # Characteristic User Description
#             permissions = "read"
#             value = "4C6576656C"    # "Level"
#         }
#     }
# }
