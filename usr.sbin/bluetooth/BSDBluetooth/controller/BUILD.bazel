load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_capimage.bzl", "bsd_capimage_policy")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_capimage_policy(name = "policy_assembly", src = "controller.ucl")
cc_binary(name = "BSDBluetoothController", srcs = ["controller.c", "controller_protocol.h", ":policy_assembly"], deps = ["//lib/libbluetooth:bluetooth", "//lib/libservice:service", "//lib/libchannel:channel"], dynamic_deps = ["//lib/libbluetooth:bluetooth_shared", "//lib/libservice:service_shared", "//lib/libchannel:channel_shared"], copts = ["-fPIE"], linkopts = ["-pie"], linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
_BUNDLE = "/Capabilities/System/Bluetooth.cap"
_UNIT = _BUNDLE + "/Units/controller.unit"
bsd_install_file(name = "unit_manifest", src = "controller.ucl", destination = _UNIT + "/Unit.ucl", owner = "root", group = "wheel", mode = "0444", install_tags = ["package=bluetooth"])
utility_installation(name = "install_manifest", program = "BSDBluetoothController", manual = None, package = "bluetooth", bindir = _UNIT + "/bin", keep_sections = [".5bsd.policy"], extra_entries = [":unit_manifest"])
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bluetooth"]}' for d in [_BUNDLE, _BUNDLE + "/Units", _UNIT, _UNIT + "/bin"]} |
        {"/usr/lib/debug" + d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bluetooth","dbg"]}' for d in ["/Capabilities", "/Capabilities/System", _BUNDLE, _BUNDLE + "/Units", _UNIT, _UNIT + "/bin"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
