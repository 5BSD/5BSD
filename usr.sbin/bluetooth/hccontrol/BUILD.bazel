load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
cc_binary(name = "hccontrol", srcs = ["send_recv.c", "link_policy.c", "link_control.c", "le.c", "host_controller_baseband.c", "info.c", "status.c", "node.c", "hccontrol.c", "util.c", "adv_data.c", "hccontrol.h"], deps = ["//lib/libbluetooth:bluetooth"], dynamic_deps = ["//lib/libbluetooth:bluetooth_shared"], copts = ["-fPIE"], linkopts = ["-pie"], linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
