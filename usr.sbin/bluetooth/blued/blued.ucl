bundle_id = "org.5bsd.blued";
version = "1.0";
author = "5BSD";
program = "blued";

restart = "on-failure";
stop_timeout = 10;
max_failures = 10;

capabilities {
    network = [{
        domain = "bluetooth";
        protocol = "any";
        address = "*";
        direction = "any";
    }];
    paths = ["/dev/vhid"];
}
