activation { ipc = ["system.Bluetooth"]; }
program = "Bluetooth";

restart = "on-failure";
stop_timeout = 10;
max_failures = 10;
kmod_requires = ["vhid"];

storage = [{
    name = "state";
    scope = "unit";
    flavor = "native";
    lifetime = "persistent";
    rights = "mount";
}];

capabilities {
    network = [{
        domain = "bluetooth";
        protocol = "any";
        address = "*";
        direction = "any";
    }];
    paths = ["/dev/vhid"];
}
