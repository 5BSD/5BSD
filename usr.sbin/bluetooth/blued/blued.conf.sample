# blued.conf - Bluetooth Low Energy daemon configuration
# See blued(8) for details.  UCL format.

general {
    # loglevel: 0=quiet, 1=info, 2=debug/trace
    loglevel = 1;

    # Bond database path
    bonddb = "/var/db/blued/bonds";

    # BTSnoop packet log (Wireshark-compatible)
    # logfile = "/var/log/blued.pcap";

    # BLE peripheral advertised name (default: FreeBSD-BLE)
    # peripheral_name = "MyDevice";
}

# Adapter list: "auto" discovers all ubt* adapters
# Or specify explicitly: adapters = ["ubt0", "ubt1"];
adapters = ["auto"];

security {
    # SMP I/O capability: none, display_only, display_yesno,
    #   keyboard_only, keyboard_display
    io_capability = "keyboard_display";

    # Request bonding (persist keys).  When false the Bonding bit is
    # cleared in the SMP AuthReq and pairing does not store long-term keys.
    # Default: true (current behaviour).
    bondable = true;

    # Require MITM-authenticated pairing (sets the MITM bit in AuthReq).
    # When false, Just Works (unauthenticated) associations are offered.
    # Default: true (current behaviour).
    # mitm = true;

    # LE Secure Connections mode: off | on | only
    #   off  = advertise legacy only
    #   on   = advertise SC, allow legacy fallback (default, current behaviour)
    #   only = advertise SC and reject legacy pairing
    sc = "on";

    # Advertise Keypress Notifications during Passkey Entry (Core Spec Vol 3
    # Part H 3.5.8).  Default: true (current behaviour).
    # keypress = true;

    # Key-distribution mask: which keys are exchanged during bonding, a
    # comma list of enc (LTK), id (IRK), sign (CSRK), link (BR/EDR link
    # key), or "none".
    # Default: "enc,id,link" (mask 0x0b; note: this does NOT include sign/CSRK).
    # key_dist = "enc,id,link"; # add "sign" only for peers that need CSRK

    # Minimum pairing security floor: none | enc | auth | sc.  A pairing that
    # cannot reach this level is rejected.  Default: auth.
    # min_pairing_security = "auth";

    # Minimum encryption key size for legacy pairing (7-16, default 16).
    # SC always requires 16 regardless.  Lower values improve compat
    # with older peripherals.
    # min_key_size = 16;
}

features {
    eatt = true;
    privacy = true;
    reconnect = true;
    reconnect_max_delay = 60;

    # RPA (Resolvable Private Address) rotation timeout in seconds.
    # Valid range: 1-3600.  Default: 900 (15 minutes).
    # rpa_timeout = 900;

    # Peer privacy mode applied to resolving-list entries:
    #   "device"  = accept both RPAs and the peer identity address (default)
    #   "network" = accept resolvable private addresses only
    # privacy_mode = "device";

    # Enable peripheral (advertiser) mode (default: no)
    # peripheral_mode = false;

    # Enable scan (observer) mode on startup (default: no)
    # scan_mode = false;

}

# Per-device overrides
# devices {
#     "aa:bb:cc:dd:ee:ff" {
#         type = "random";
#         reconnect = true;
#     }
# }

# Custom GATT services (peripheral mode).
# Each "service" block adds a service to the GATT database.
#
# UUID format:
#   "0xNNNN"                                — 16-bit Bluetooth SIG UUID
#   "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"  — 128-bit vendor UUID
#
# Characteristic properties (comma-separated):
#   read, write, write_no_rsp, notify, indicate, auth_signed_write
#
# Characteristic permissions (comma-separated):
#   read, write, read_encrypt, write_encrypt, read_authen, write_authen
#
# Value: hex string (e.g., "0100" = 2 bytes {0x01, 0x00}), or "" for empty.
# If properties include notify or indicate, a CCCD descriptor is auto-added.

# service "Custom Sensor" {
#     uuid = "0xFFE0"
#     characteristic "Sensor Data" {
#         uuid = "0xFFE1"
#         properties = "read,notify"
#         permissions = "read"
#         value = "00"
#     }
#     characteristic "Control Point" {
#         uuid = "0xFFE2"
#         properties = "write"
#         permissions = "write_encrypt"
#         value = ""
#     }
# }

# service "Custom 128-bit" {
#     uuid = "12345678-1234-1234-1234-123456789abc"
#     characteristic "Data" {
#         uuid = "12345678-1234-1234-1234-123456789abd"
#         properties = "read,write"
#         permissions = "read,write"
#         value = "0000"
#     }
# }
