load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_compress", "bsd_install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_file(name = "script", src = "bluetooth-config.sh", destination = "/usr/sbin/bluetooth-config", owner = "root", group = "wheel", mode = "0555", install_tags = ["package=bluetooth"])
bsd_compress(name = "manual_gz", src = "bluetooth-config.8", output = "bluetooth-config.8.gz", arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(manual = True, name = "manual", src = ":manual_gz", destination = "/usr/share/man/man8/bluetooth-config.8.gz", owner = "root", group = "wheel", mode = "0444", install_tags = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=bluetooth-man"], "//conditions:default": ["package=bluetooth"]}))
bsd_install_manifest(name = "install_manifest", entries = [":script", ":manual"], visibility = ["//visibility:public"])
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"], directories = {"/usr/sbin": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bluetooth"]}'},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
