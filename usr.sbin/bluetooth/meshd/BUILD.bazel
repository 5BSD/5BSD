load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_import")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_header", "bsd_dtrace_cc_objects")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
bsd_dtrace_header(
    name = "provider", source = "meshd_provider.d", output = "meshd_provider.h",
    flags = ["-C", "-x", "nolibs"], object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:bootstrap", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti",
    runtime_libraries = ["//cddl/usr.sbin/dtrace:bootstrap_runtime"],
    tool_inputs = [ "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"], static_anchor = True,
)
cc_library(name = "provider_headers", hdrs = [":provider"], strip_include_prefix = ".")

cc_library(name = "headers", hdrs = ["meshd.h", "meshd_models.h", "meshd_persist.h", "meshd_bearer_blued.h", "meshd_probes.h"], strip_include_prefix = ".")
cc_library(name = "objects", srcs = ["meshd.c", "meshd_node.c", "meshd_models.c", "meshd_config.c", "meshd_ctl.c", "meshd_persist.c", "meshd_cfgclient.c", "meshd_bearer_blued.c", "meshd_pbgatt.c", "meshd_proxy_gatt.c"], deps = [":headers", "//lib/libble:mesh_protocol_headers", "//lib/libmesh:blemesh", "//lib/libbluetooth:bluetooth", "//secure/lib/libcrypto:crypto"] + select({_TRACE: [":provider_headers"], "//conditions:default": []}), local_defines = select({_TRACE: ["MESHD_DTRACE_PROBES"], "//conditions:default": []}), copts = ["-fPIE"], target_compatible_with = _PLATFORM)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider", provider_object = "meshd_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group) for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"], deps = [":provider_link"] + ["//lib/libmesh:blemesh", "//lib/libbluetooth:bluetooth", "//secure/lib/libcrypto:crypto"])
cc_binary(name = "meshd", deps = select({_TRACE: [":traced"], "//conditions:default": [":objects"]}),
    dynamic_deps = ["//lib/libmesh:blemesh_shared", "//lib/libbluetooth:bluetooth_shared", "//secure/lib/libcrypto:crypto_shared"],
    linkopts = ["-pie"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_file(name = "sample_config", src = "meshd.conf.sample", destination = "/usr/share/examples/meshd/meshd.conf.sample", owner = "root", group = "wheel", mode = "0644", install_tags = ["package=bluetooth", "config"])
utility_installation(name = "install_manifest", program = "meshd", manual = "meshd.8", package = "bluetooth", bindir = "/usr/sbin", man_section = "8", extra_entries = [":sample_config"])
bsd_install_archive(name = "install_archive",
    manifests = [":install_manifest"],
    directories = {"/usr/share/examples/meshd": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities"]}'} | {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bluetooth","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
