load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
load("//tools/build/bazel:bsd_lex_yacc.bzl", "bsd_lex", "bsd_yacc")
bsd_lex(name = "lexer", src = "lexer.l", output = "lexer.c", lex = "//usr.bin/lex:lex", m4 = "//usr.bin/m4:m4")
bsd_yacc(name = "parser", src = "parser.y", output = "parser.c", header = "parser.h", report = "parser.output", yacc = "//usr.bin/yacc:yacc")
filegroup(name = "parser_source", srcs = [":parser"], output_group = "source")
filegroup(name = "parser_header", srcs = [":parser"], output_group = "header")
cc_library(name = "headers", hdrs = ["hcsecd.h", ":parser_header"], includes = ["."])
cc_binary(name = "hcsecd", srcs = ["hcsecd.c", ":lexer", ":parser_source"], deps = [":headers", "//lib/libbluetooth:bluetooth"], dynamic_deps = ["//lib/libbluetooth:bluetooth_shared"], copts = ["-fPIE"], linkopts = ["-pie"], linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_compress")
bsd_install_file(name = "config", src = "hcsecd.conf", destination = "/etc/bluetooth/hcsecd.conf", owner = "root", group = "wheel", mode = "0600", install_tags = ["package=bluetooth", "config"])
bsd_compress(name = "config_manual_gz", src = "hcsecd.conf.5", output = "hcsecd.conf.5.gz", arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(name = "config_manual", src = ":config_manual_gz", destination = "/usr/share/man/man5/hcsecd.conf.5.gz", owner = "root", group = "wheel", mode = "0444", install_tags = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=bluetooth-man"], "//conditions:default": ["package=bluetooth"]}))
utility_installation(name = "install_manifest", program = "hcsecd", manual = "hcsecd.8", package = "bluetooth", bindir = "/usr/sbin", man_section = "8", aliases = [], extra_entries = [":config", ":config_manual"])
bsd_install_archive(name = "install_archive",
    manifests = [":install_manifest"],
    directories = {"/etc/bluetooth": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities"]}'} | {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bluetooth","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
