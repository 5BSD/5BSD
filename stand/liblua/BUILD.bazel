load("@rules_cc//cc:defs.bzl", "cc_library")
load(":library.bzl", "loader_lua_library")
load("//tools/build/bazel:bsd_architecture_headers.bzl", "bsd_architecture_headers")
load(":config.bzl", "loader_lua_paths")
loader_lua_paths(name = "configured_paths")
# The loader ABI is separate from ordinary userland on every architecture.
_COMPAT = ["@platforms//os:freebsd"] + select({
    "@platforms//cpu:x86_64": [], "@platforms//cpu:aarch64": [], "@platforms//cpu:riscv64": [],
    "//conditions:default": ["@platforms//:incompatible"],
})
bsd_architecture_headers(name = "architecture_headers", headers = select({
    "@platforms//cpu:x86_64": {"//sys/amd64/include:standalone_lua_headers": "machine", "//sys/x86/include:standalone_lua_headers": "x86"},
    "@platforms//cpu:aarch64": {"//sys/arm64/include:standalone_lua_headers": "machine"},
    "@platforms//cpu:riscv64": {"//sys/riscv/include:standalone_lua_headers": "machine"},
    "//conditions:default": {},
}))
_ARCH_CFLAGS = select({
    "@platforms//cpu:x86_64": ["-mno-mmx", "-mno-sse", "-mno-avx", "-mno-avx2", "-msoft-float", "-fPIC", "-mno-red-zone", "-mno-relax", "-ffunction-sections", "-fdata-sections", "-Oz"],
    "@platforms//cpu:aarch64": ["-mgeneral-regs-only", "-ffixed-x18", "-fPIC", "-mno-relax"],
    "@platforms//cpu:riscv64": ["-march=rv64imac", "-mabi=lp64", "-fPIC", "-mno-relax", "-mcmodel=medium"],
    "//conditions:default": [],
})
_CFLAGS = ['-O2', '-pipe', '-fno-common', '-nostdinc', '-Istand/libsa', '-D_STANDALONE', '-Isys', '-Ddouble=jagged-little-pill', '-Dfloat=floaty-mcfloatface', '-Istand/libsa/geli', '-ffreestanding', '-Icontrib/lua/src', '-Istand/common', '-Istand/liblua', '-ffreestanding', '-nostdlib', '-DLUA_USE_POSIX', '-fno-stack-protector', '-D__BSD_VISIBLE', '-Istand/include', '-Istand/liblua', '-Icontrib/lua/src', '-Istand/common', '-g', '-gz=zlib', '-std=gnu17', '-Wno-format-zero-length', '-Wsystem-headers', '-Werror', '-Wno-pointer-sign', '-Wdate-time', '-Wno-empty-body', '-Wno-string-plus-int', '-Wno-unused-const-variable', '-Wno-error=unused-but-set-parameter', '-Wno-error=cast-function-type-mismatch', '-Wno-tautological-compare', '-Wno-unused-value', '-Wno-parentheses-equality', '-Wno-unused-function', '-Wno-enum-conversion', '-Wno-unused-local-typedef', '-Wno-address-of-packed-member', '-Wno-switch', '-Wno-switch-enum', '-Wno-knr-promoted-parameter', '-Wno-parentheses', '-Qunused-arguments'] + _ARCH_CFLAGS + select({
    "//tools/build/bazel/config:loader_geli_enabled": ["-DLOADER_GELI_SUPPORT"], "//conditions:default": []}) + select({
    "//tools/build/bazel/config:loader_disk_enabled": ["-DLOADER_DISK_SUPPORT"], "//conditions:default": []})
_VERIFY_CFLAGS = select({
    "//tools/build/bazel/config:veriexec_enabled": ["-DLOADER_VERIEXEC"], "//conditions:default": []}) + select({
    "//tools/build/bazel/config:loader_veriexec_vectx_enabled": ["-DLOADER_VERIEXEC_VECTX"], "//conditions:default": []}) + select({
    "//tools/build/bazel/config:loader_veriexec_pass_manifest_enabled": ["-DLOADER_VERIEXEC_PASS_MANIFEST"], "//conditions:default": []})
_BASE_DEPS = [":configured_paths", ":architecture_headers", "//stand/libsa:standalone_headers", "//contrib/lua/src:standalone_headers",
    "//stand/common:standalone_lua_headers", "//sys/sys:standalone_lua_headers",
    "//sys/teken:standalone_lua_headers", "//contrib/pnglite:standalone_lua_headers",
    "//sys/crypto/sha2:standalone_lua_headers"]
_DEPS = _BASE_DEPS + select({
    "//tools/build/bazel/config:veriexec_enabled": ["//lib/libsecureboot:standalone_verify_header"], "//conditions:default": []})
_FEATURES = ["-opt", "-bsd_ssp", "-bsd_riscv_userland_abi"]
loader_lua_library(name = "static_archive", prefix = "", copts = _CFLAGS + _VERIFY_CFLAGS,
    deps = _DEPS, features = _FEATURES, compatible = _COMPAT)
# EFI policy is local to this private context; it never changes shared BIOS inputs.
_EFI_CFLAGS = _CFLAGS + ["-Wformat"] + select({
    "@platforms//cpu:x86_64": ["-fshort-wchar"], "@platforms//cpu:aarch64": ["-fshort-wchar"],
    "//conditions:default": [],
}) + select({
    "//tools/build/bazel/config:efi_loader_veriexec_enabled": ["-DLOADER_VERIEXEC", "-DLOADER_VERITY_SUPPORT"], "//conditions:default": [],
}) + select({
    "//tools/build/bazel/config:efi_loader_veriexec_vectx_enabled": ["-DLOADER_VERIEXEC_VECTX"], "//conditions:default": [],
}) + select({
    "//tools/build/bazel/config:efi_loader_veriexec_pass_manifest_enabled": ["-DLOADER_VERIEXEC_PASS_MANIFEST"], "//conditions:default": [],
})
_EFI_DEPS = _BASE_DEPS + select({
    "//tools/build/bazel/config:efi_loader_veriexec_enabled": ["//lib/libsecureboot:standalone_verify_header"], "//conditions:default": [],
})
loader_lua_library(name = "efi_static_archive", prefix = "efi_", copts = _EFI_CFLAGS,
    deps = _EFI_DEPS, features = _FEATURES, compatible = _COMPAT)

# Compile-time ABI check is outside the installed/internal archive.
cc_library(name = "configuration_contract", srcs = ["configuration-contract.c"],
    hdrs = ["lstd.h", "luaconf.local.h"], copts = _CFLAGS + _VERIFY_CFLAGS, deps = _DEPS,
    features = _FEATURES, testonly = True, linkstatic = True,
    target_compatible_with = _COMPAT)
load("//tools/build/bazel:bsd_python_test.bzl", "bsd_host_artifact_test")
filegroup(name = "inspection_tools", srcs = ["@bsd_sdk//toolchain:archive_inputs",
    "@bsd_sdk//toolchain:bin/llvm-nm", "@bsd_sdk//toolchain:llvm-nm_runtime"])
bsd_host_artifact_test(name = "archive_test", src = "archive-test.py",
    data = [":static_archive", ":configuration_contract", ":inspection_tools",
        "@bsd_sdk//toolchain:bin/llvm-ar", "@bsd_sdk//toolchain:bin/llvm-nm"],
    args = ["--verification"] + select({
        "//tools/build/bazel/config:veriexec_enabled": ["yes"], "//conditions:default": ["no"],
    }) + ["--verity", "no", "--machine"] + select({
        "@platforms//cpu:x86_64": ["62"], "@platforms//cpu:aarch64": ["183"],
        "@platforms//cpu:riscv64": ["243"], "//conditions:default": ["0"],
    }) + ["--archive", "$(location :static_archive)",
        "--ar", "$(location @bsd_sdk//toolchain:bin/llvm-ar)",
        "--nm", "$(location @bsd_sdk//toolchain:bin/llvm-nm)",
        "--tool-inputs", "$(locations :inspection_tools)"],
    visibility = ["//visibility:public"], size = "small",
    target_compatible_with = _COMPAT)

cc_library(name = "efi_configuration_contract", srcs = ["configuration-contract.c"],
    hdrs = ["lstd.h", "luaconf.local.h"], copts = _EFI_CFLAGS + ["-DLOADER_LUA_EFI"],
    deps = _EFI_DEPS, features = _FEATURES, testonly = True, linkstatic = True,
    target_compatible_with = _COMPAT)
bsd_host_artifact_test(name = "efi_archive_test", src = "archive-test.py",
    data = [":efi_static_archive", ":efi_configuration_contract", ":inspection_tools",
        "@bsd_sdk//toolchain:bin/llvm-ar", "@bsd_sdk//toolchain:bin/llvm-nm"],
    args = select({
        "//tools/build/bazel/config:efi_loader_veriexec_enabled": ["--verification", "yes", "--verity", "yes"],
        "//conditions:default": ["--verification", "no", "--verity", "no"],
    }) + ["--machine"] + select({
        "@platforms//cpu:x86_64": ["62"], "@platforms//cpu:aarch64": ["183"],
        "@platforms//cpu:riscv64": ["243"], "//conditions:default": ["0"],
    }) + ["--archive", "$(location :efi_static_archive)",
        "--ar", "$(location @bsd_sdk//toolchain:bin/llvm-ar)",
        "--nm", "$(location @bsd_sdk//toolchain:bin/llvm-nm)",
        "--tool-inputs", "$(locations :inspection_tools)"],
    visibility = ["//visibility:public"], size = "small", target_compatible_with = _COMPAT)

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

bsd_source_headers(name = "efi_loader_entry_headers", hdrs = ['lerrno.h', 'lstd.h', 'luaconf.local.h', 'lutils.h'], visibility = ["//stand/efi/loader:__pkg__"])

exports_files(["config.bzl"], visibility = ["//stand/efi/loader:__pkg__"])
