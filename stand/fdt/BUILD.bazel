load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")
bsd_source_headers(name = "loader_fdt_headers", hdrs = ['fdt_platform.h'], visibility = ["//stand/fdt:__pkg__", "//stand/efi/fdt:__pkg__"])

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load("//tools/build/bazel:bsd_architecture_headers.bzl", "bsd_architecture_headers")
_COMPAT = ["@platforms//os:freebsd"] + select({"@platforms//cpu:x86_64": [], "@platforms//cpu:aarch64": [], "@platforms//cpu:riscv64": [], "//conditions:default": ["@platforms//:incompatible"]})
bsd_architecture_headers(name = "architecture_headers", headers = select({
    "@platforms//cpu:x86_64": {"//sys/amd64/include:loader_fdt_headers": "machine", "//sys/x86/include:loader_fdt_headers": "x86"},
    "@platforms//cpu:aarch64": {"//sys/arm64/include:loader_fdt_headers": "machine"},
    "@platforms//cpu:riscv64": {"//sys/riscv/include:loader_fdt_headers": "machine"}, "//conditions:default": {},
}))
_ARCH = select({
    "@platforms//cpu:x86_64": ["-mno-mmx", "-mno-sse", "-mno-avx", "-mno-avx2", "-msoft-float", "-fPIC", "-mno-red-zone", "-mno-relax", "-ffunction-sections", "-fdata-sections", "-Oz"],
    "@platforms//cpu:aarch64": ["-mgeneral-regs-only", "-ffixed-x18", "-fPIC", "-mno-relax"],
    "@platforms//cpu:riscv64": ["-march=rv64imac", "-mabi=lp64", "-fPIC", "-mno-relax", "-mcmodel=medium"], "//conditions:default": [],
})
_FEATURES = ["-opt", "-bsd_ssp", "-bsd_riscv_userland_abi"]
_CFLAGS = ['-O2', '-pipe', '-fno-common', '-nostdinc', '-Istand/libsa', '-D_STANDALONE', '-Isys', '-Ddouble=jagged-little-pill', '-Dfloat=floaty-mcfloatface', '-Istand/libsa/geli', '-ffreestanding', '-Isys/contrib/libfdt/', '-Istand/common', '-Wformat', '-Wall', '-g', '-gz=zlib', '-std=gnu17', '-Wno-format-zero-length', '-Wsystem-headers', '-Werror', '-Wno-pointer-sign', '-Wdate-time', '-Wno-empty-body', '-Wno-string-plus-int', '-Wno-unused-const-variable', '-Wno-error=unused-but-set-parameter', '-Wno-error=cast-function-type-mismatch', '-Wno-tautological-compare', '-Wno-unused-value', '-Wno-parentheses-equality', '-Wno-unused-function', '-Wno-enum-conversion', '-Wno-unused-local-typedef', '-Wno-address-of-packed-member', '-Wno-switch', '-Wno-switch-enum', '-Wno-knr-promoted-parameter', '-Wno-parentheses', '-Qunused-arguments'] + _ARCH
_CFLAGS = _CFLAGS + select({"//tools/build/bazel/config:loader_geli_enabled": ["-DLOADER_GELI_SUPPORT"], "//conditions:default": []})
_CFLAGS = _CFLAGS + select({"//tools/build/bazel/config:loader_disk_enabled": ["-DLOADER_DISK_SUPPORT"], "//conditions:default": []})
_CFLAGS = _CFLAGS + select({"//tools/build/bazel/config:veriexec_enabled": ["-DLOADER_VERIEXEC"], "//conditions:default": []})
_CFLAGS = _CFLAGS + select({"//tools/build/bazel/config:loader_veriexec_vectx_enabled": ["-DLOADER_VERIEXEC_VECTX"], "//conditions:default": []})
_CFLAGS = _CFLAGS + select({"//tools/build/bazel/config:loader_veriexec_pass_manifest_enabled": ["-DLOADER_VERIEXEC_PASS_MANIFEST"], "//conditions:default": []})
_DEPS = ['//stand/common:loader_fdt_headers', '//stand/efi/include:loader_fdt_headers', '//stand/fdt:loader_fdt_headers', '//sys/contrib/edk2/Include:loader_fdt_headers', '//sys/contrib/libfdt:loader_fdt_headers', '//sys/sys:loader_fdt_headers', ':architecture_headers', '//stand/libsa:standalone_headers'] + select({"//tools/build/bazel/config:veriexec_enabled": ["//lib/libsecureboot:standalone_verify_header"], "//conditions:default": []})
_VENDOR = ['fdt.c', 'fdt_ro.c', 'fdt_wip.c', 'fdt_sw.c', 'fdt_rw.c', 'fdt_strerror.c', 'fdt_empty_tree.c', 'fdt_addresses.c', 'fdt_overlay.c']
cc_library(name = "vendor", srcs = ["//sys/contrib/libfdt:" + name for name in _VENDOR],
    copts = _CFLAGS, deps = _DEPS, features = _FEATURES, linkstatic = True, target_compatible_with = _COMPAT)
cc_library(name = "loader_command", srcs = ["fdt_loader_cmd.c"], copts = _CFLAGS,
    deps = _DEPS, features = _FEATURES, linkstatic = True, target_compatible_with = _COMPAT)
bsd_component_archive(name = "static_archive", groups = [":vendor", ":loader_command"],
    object_order = [name[:-2] + ".o" for name in _VENDOR] + ["fdt_loader_cmd.o"], visibility = ["//visibility:public"])


load("//tools/build/bazel:bsd_python_test.bzl", "bsd_host_artifact_test")
filegroup(name = "inspection_tools", srcs = ["@bsd_sdk//toolchain:archive_inputs", "@bsd_sdk//toolchain:bin/llvm-nm", "@bsd_sdk//toolchain:llvm-nm_runtime"])
bsd_host_artifact_test(name = "archive_test", src = "archive-test.py",
    data = [":static_archive", ":inspection_tools", "@bsd_sdk//toolchain:bin/llvm-ar", "@bsd_sdk//toolchain:bin/llvm-nm"],
    args = ["--machine"] + select({"@platforms//cpu:x86_64": ["62"], "@platforms//cpu:aarch64": ["183"], "@platforms//cpu:riscv64": ["243"], "//conditions:default": ["0"]}) +
        ["--archive", "$(location :static_archive)", "--ar", "$(location @bsd_sdk//toolchain:bin/llvm-ar)", "--nm", "$(location @bsd_sdk//toolchain:bin/llvm-nm)", "--tool-inputs", "$(locations :inspection_tools)"],
    visibility = ["//visibility:public"], size = "small", target_compatible_with = _COMPAT)

load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_program_test.bzl", "bsd_program_test")
cc_binary(name = "runtime_program", srcs = ["runtime-test.c", ":static_archive"],
    deps = ["//sys/contrib/libfdt:headers"], testonly = True,
    copts = ["-std=gnu17", "-Werror=implicit-function-declaration"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
bsd_program_test(name = "runtime_test", program = ":runtime_program", interface = "plain",
    runner = "//tools/build/bazel:program_test_runner",
    runtime_lib = ["//lib/libc:c_shared", "//lib/libsys:sys_shared", "@bsd_sdk//toolchain:sysroot/lib/libgcc_s.so.1"],
    visibility = ["//visibility:public"], size = "small",
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])

exports_files(["help.fdt"], visibility = ["//stand/efi/loader:__pkg__", "//tools/build/bazel:__pkg__"])

bsd_source_headers(name = 'efi_loader_aarch64_headers', hdrs = ['fdt_platform.h'], visibility = ["//stand/efi/loader:__pkg__"])

bsd_source_headers(name = 'efi_loader_riscv64_headers', hdrs = ['fdt_platform.h'], visibility = ["//stand/efi/loader:__pkg__"])

bsd_source_headers(name = 'efi_loader_simp_aarch64_headers', hdrs = ['fdt_platform.h'], visibility = ["//stand/efi/loader_simp:__pkg__"])

bsd_source_headers(name = 'efi_loader_4th_aarch64_headers', hdrs = ['fdt_platform.h'], visibility = ["//stand/efi/loader_4th:__pkg__"])

bsd_source_headers(name = 'efi_loader_simp_riscv64_headers', hdrs = ['fdt_platform.h'], visibility = ["//stand/efi/loader_simp:__pkg__"])

bsd_source_headers(name = 'efi_loader_4th_riscv64_headers', hdrs = ['fdt_platform.h'], visibility = ["//stand/efi/loader_4th:__pkg__"])
