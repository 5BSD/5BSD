def cross_loader_profiles(interpreter, package):
    if interpreter not in ["lua", "4th", "simp"]:
        fail("unsupported EFI interpreter")
    result = {}
    for arch, base in _CROSS.items():
        machine = "arm64" if arch == "aarch64" else "riscv"
        interpreter_flags = {
            "lua": ["-Icontrib/lua/src", "-Istand/common", "-Istand/liblua"],
            "4th": ["-Istand/ficl", "-Istand/ficl/" + ("aarch64" if arch == "aarch64" else "riscv"),
                "-Istand/common", "-DBF_DICTSIZE=30000", "-DLOADER_VERIEXEC", "-Ilib/libsecureboot/h"],
            "simp": [],
        }[interpreter]
        profile = dict(base)
        profile["flags"] = base["before_local"] + ["-I" + package, "-I" + package + "/arch/" + machine] + base["after_local"] + interpreter_flags + base["after_interpreter"]
        if interpreter != "lua":
            replacement = "interp_forth" if interpreter == "4th" else "interp_simple"
            rows = []
            for name, source, flags in base["rows"]:
                if name == "interp_lua":
                    name, source, flags = replacement, "//stand/common:" + replacement + ".c", [value for value in flags if value != "-Ilibexec/flua/lfs"]
                elif name == "vers":
                    source = ":version_forth_configured" if interpreter == "4th" else ":version_configured"
                if source.startswith(":"):
                    source = "//stand/efi/loader" + source
                elif not source.startswith("//"):
                    source = "//stand/efi/loader:" + source
                rows.append((name, source, flags))
            profile["rows"] = rows
            profile["order"] = [replacement + ".o" if value == "interp_lua.o" else value for value in base["order"]]
            profile["deps"] = _VARIANT_DEPS[arch][interpreter]
            profile["architecture_headers"] = {"//sys/" + machine + "/include:efi_loader_" + interpreter + "_" + arch + "_headers": "machine"}
            profile["archives"] = (["//stand/efi/ficlefi:static_archive"] if interpreter == "4th" else []) + base["archives"][1:]
            profile["script"] = "//stand/efi/loader:" + base["script"]
            profile["help"] = "//stand/efi/loader:help_fdt"
        result[arch] = profile
    return result


def cross_lua_profiles():
    return cross_loader_profiles("lua", "stand/efi/loader")
