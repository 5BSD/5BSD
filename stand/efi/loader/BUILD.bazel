load("//tools/build/bazel:bsd_loader_generated.bzl", "bsd_loader_font", "bsd_loader_help")
bsd_loader_font(name = "console_font", src = "//contrib/terminus:ter-u16b.bdf",
    output = "8x16.c", visibility = ["//visibility:public"])
# Final loader profiles select the relevant variant. Preserve Make's FDT-first
# source order; the shared helper adds no separator bytes between inputs.
bsd_loader_help(name = "help_common", srcs = ["//stand/common:help.common"],
    output = "loader.help.efi", visibility = ["//visibility:public"])
bsd_loader_help(name = "help_fdt", srcs = ["//stand/fdt:help.fdt", "//stand/common:help.common"],
    output = "loader.help.efi", visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_loader_generated.bzl", "bsd_loader_version")
_VERSION_MACHINE = select({
    "@platforms//cpu:x86_32": "amd64-ia32",
    "@platforms//cpu:x86_64": "amd64", "@platforms//cpu:aarch64": "arm64",
    "@platforms//cpu:riscv64": "riscv", "//conditions:default": "",
})
_VERSION_COMPAT = ["@platforms//os:freebsd"] + select({
    "@platforms//cpu:x86_32": [],
    "@platforms//cpu:x86_64": [], "@platforms//cpu:aarch64": [],
    "@platforms//cpu:riscv64": [], "//conditions:default": ["@platforms//:incompatible"],
})
bsd_loader_version(name = "version_reproducible", version = "version", output = "vers.c",
    description = "EFI loader", machine = _VERSION_MACHINE, reproducible = True,
    target_compatible_with = _VERSION_COMPAT, visibility = ["//visibility:public"])
bsd_loader_version(name = "version_configured", version = "version", output = "vers.c",
    description = "EFI loader", machine = _VERSION_MACHINE,
    reproducible = select({"//tools/build/bazel/config:reproducible_build_enabled": True,
        "//conditions:default": False}),
    metadata = "//tools/build/bazel/config:loader_version_metadata",
    target_compatible_with = _VERSION_COMPAT, visibility = ["//visibility:public"])

bsd_source_headers(name = "efi_loader_entry_headers", hdrs = ['arch/amd64/multiboot2.h', 'decompress.h', 'framebuffer.h', 'loader_efi.h'], visibility = ["//stand/efi/loader:__pkg__"])

load(":entry.bzl", "efi_loader_entry")
efi_loader_entry()

bsd_loader_version(name = "version_forth_configured", version = "version.veriexec", output = "vers.c",
    description = "EFI loader", machine = _VERSION_MACHINE,
    reproducible = select({"//tools/build/bazel/config:reproducible_build_enabled": True,
        "//conditions:default": False}), metadata = "//tools/build/bazel/config:loader_version_metadata",
    target_compatible_with = _VERSION_COMPAT, visibility = ["//visibility:public"])

