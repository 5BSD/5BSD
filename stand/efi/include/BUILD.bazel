load("@rules_cc//cc:defs.bzl", "cc_library")
# _STANDALONE is not enabled for the userland efivar consumer.
cc_library(name = "efichar_header", hdrs = ["efichar.h"], strip_include_prefix = ".",
    visibility = ["//lib/libefivar:__pkg__", "//usr.sbin/efibootmgr:__pkg__", "//usr.sbin/efivar:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")
bsd_source_headers(name = "libefi_headers", hdrs = ['efi.h', 'efi_driver_utils.h', 'efichar.h', 'eficonsctl.h', 'efilib.h', 'efizfs.h'], visibility = ["//stand/efi/libefi:__pkg__"])

bsd_source_headers(name = "loader_fdt_headers", hdrs = ['efi.h', 'efilib.h'], visibility = ["//stand/fdt:__pkg__", "//stand/efi/fdt:__pkg__"])

bsd_source_headers(name = "standalone_sa_efi_headers", hdrs = ['efi.h', 'efilib.h'], visibility = ["//stand/libsa:__pkg__"])

bsd_source_headers(name = "efi_loader_entry_headers", hdrs = ['efi.h', 'efichar.h', 'eficonsctl.h', 'efilib.h', 'efipciio.h', 'efizfs.h', 'ipxe_download.h'], visibility = ["//stand/efi/loader:__pkg__"])
