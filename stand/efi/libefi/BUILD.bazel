    "@platforms//cpu:riscv64": {"//sys/riscv/include:libefi_headers": "machine"}, "//conditions:default": {},
}))
_CFLAGS = ['-O2', '-pipe', '-fno-common', '-Wformat', '-nostdinc', '-Istand/libsa', '-D_STANDALONE', '-Isys', '-Ddouble=jagged-little-pill', '-Dfloat=floaty-mcfloatface', '-Istand/libsa/geli', '-ffreestanding', '-Ilib/libsecureboot/h', '-Istand/efi/include', '-Isys/contrib/edk2/Include', '-Istand/libsa/zfs', '-Isys/cddl/boot/zfs', '-Isys/cddl/contrib/opensolaris/uts/common', '-Istand/common', '-D__printf__=__freebsd_kprintf__', '-DTERM_EMU', '-Ilib/libsecureboot/h', '-g', '-gz=zlib', '-std=gnu17', '-Wno-format-zero-length', '-Wsystem-headers', '-Werror', '-Wno-pointer-sign', '-Wdate-time', '-Wno-empty-body', '-Wno-string-plus-int', '-Wno-unused-const-variable', '-Wno-error=unused-but-set-parameter', '-Wno-error=cast-function-type-mismatch', '-Wno-tautological-compare', '-Wno-unused-value', '-Wno-parentheses-equality', '-Wno-unused-function', '-Wno-enum-conversion', '-Wno-unused-local-typedef', '-Wno-address-of-packed-member', '-Wno-switch', '-Wno-switch-enum', '-Wno-knr-promoted-parameter', '-Wno-parentheses', '-Qunused-arguments'] + select({
    "@platforms//cpu:x86_64": ["-fshort-wchar", "-mno-mmx", "-mno-sse", "-mno-avx", "-mno-avx2", "-msoft-float", "-fPIC", "-mno-red-zone", "-mno-relax", "-ffunction-sections", "-fdata-sections", "-Oz"],
    "@platforms//cpu:x86_32": ["-fshort-wchar", "-malign-double", "-m32", "-mno-mmx", "-mno-sse", "-mno-avx", "-mno-avx2", "-msoft-float", "-march=i386", "-fPIC", "-mno-red-zone", "-mno-relax", "-ffunction-sections", "-fdata-sections", "-Oz", "-Istand/efi/include/i386"],
    "@platforms//cpu:aarch64": ["-fshort-wchar", "-mgeneral-regs-only", "-ffixed-x18", "-fPIC", "-mno-relax"],
    "@platforms//cpu:riscv64": ["-march=rv64imac", "-mabi=lp64", "-fPIC", "-mno-relax", "-mcmodel=medium"], "//conditions:default": [],
})
_CFLAGS = _CFLAGS + select({"//tools/build/bazel/config:loader_geli_enabled": ["-DLOADER_GELI_SUPPORT"], "//conditions:default": []})
_CFLAGS = _CFLAGS + select({"//tools/build/bazel/config:loader_disk_enabled": ["-DLOADER_DISK_SUPPORT"], "//conditions:default": []})
_CFLAGS = _CFLAGS + select({"//tools/build/bazel/config:loader_net_enabled": ["-DLOADER_NET_SUPPORT"], "//conditions:default": []})
_CFLAGS = _CFLAGS + select({"//tools/build/bazel/config:loader_md_enabled": ["-DLOADER_MD_SUPPORT"], "//conditions:default": []})
_CFLAGS = _CFLAGS + select({"//tools/build/bazel/config:loader_zfs_enabled": ["-DEFI_ZFS_BOOT"], "//conditions:default": []})
_CFLAGS = _CFLAGS + select({"//tools/build/bazel/config:efi_loader_veriexec_enabled": ["-DLOADER_VERIEXEC"], "//conditions:default": []})
