[cc_library(name = source[:-2], srcs = [source], copts = _CFLAGS +
    (["-Wno-format"] if source in ["efinet.c", "efipart.c", "env.c"] else []) +
    (["-Isys/teken", "-Icontrib/pnglite", "-Istand/efi/loader"] if source == "efi_console.c" else []),
    deps = _DEPS, features = _FEATURES, linkstatic = True, target_compatible_with = _COMPAT) for source in _COMMON]
cc_library(name = "terminal", srcs = ["//sys/teken:teken.c"],
    copts = _CFLAGS + ["-Isys/teken"], deps = _DEPS + ["//sys/teken:device_io_state_headers"],
    features = _FEATURES, linkstatic = True, target_compatible_with = _COMPAT)
cc_library(name = "clock", srcs = select({"@platforms//cpu:x86_64": ["time.c"], "@platforms//cpu:x86_32": ["time.c"], "@platforms//cpu:aarch64": ["time_arm64.c"], "@platforms//cpu:riscv64": ["time_event.c"], "//conditions:default": []}),
    copts = _CFLAGS, deps = _DEPS, features = _FEATURES, linkstatic = True, target_compatible_with = _COMPAT)
bsd_component_archive(name = "static_archive", groups = [":" + source[:-2] for source in _COMMON] + [":terminal", ":clock"],
    object_order = [source[:-2] + ".o" for source in _COMMON] + ["teken.o"] + select({"@platforms//cpu:x86_64": ["time.o"], "@platforms//cpu:x86_32": ["time.o"], "@platforms//cpu:aarch64": ["time_arm64.o"], "@platforms//cpu:riscv64": ["time_event.o"], "//conditions:default": []}),
    visibility = ["//visibility:public"])
cc_library(name = "abi_contract", srcs = ["abi-contract.c"], copts = _CFLAGS, deps = _DEPS,
    features = _FEATURES, testonly = True, linkstatic = True, target_compatible_with = _COMPAT)
load("//tools/build/bazel:bsd_python_test.bzl", "bsd_host_artifact_test")
filegroup(name = "inspection_tools", srcs = ["@bsd_sdk//toolchain:archive_inputs",
    "@bsd_sdk//toolchain:bin/llvm-nm", "@bsd_sdk//toolchain:llvm-nm_runtime",
    "@bsd_sdk//toolchain:bin/awk", "@bsd_sdk//toolchain:awk_runtime"])
bsd_host_artifact_test(name = "archive_test", src = "archive-test.py",
    data = [":static_archive", ":abi_contract", ":inspection_tools", "//sys/teken:state_header",
        "//sys/teken:gensequences", "//sys/teken:sequences", "@bsd_sdk//toolchain:bin/llvm-ar",
        "@bsd_sdk//toolchain:bin/llvm-nm", "@bsd_sdk//toolchain:bin/awk"],
    args = ["--machine"] + select({"@platforms//cpu:x86_64": ["62"], "@platforms//cpu:aarch64": ["183"], "@platforms//cpu:riscv64": ["243"], "//conditions:default": ["0"]}) +
        ["--clock"] + select({"@platforms//cpu:x86_64": ["time.o"], "@platforms//cpu:x86_32": ["time.o"], "@platforms//cpu:aarch64": ["time_arm64.o"], "@platforms//cpu:riscv64": ["time_event.o"], "//conditions:default": ["unsupported"]}) +
        ["--zfs"] + select({"//tools/build/bazel/config:loader_zfs_enabled": ["yes"], "//conditions:default": ["no"]}) +
        ["--archive", "$(location :static_archive)", "--ar", "$(location @bsd_sdk//toolchain:bin/llvm-ar)",
        "--nm", "$(location @bsd_sdk//toolchain:bin/llvm-nm)", "--awk", "$(location @bsd_sdk//toolchain:bin/awk)",
        "--generator", "$(location //sys/teken:gensequences)", "--sequences", "$(location //sys/teken:sequences)",
        "--state-header", "$(location //sys/teken:state_header)", "--tool-inputs", "$(locations :inspection_tools)"],
    size = "small", visibility = ["//visibility:public"], target_compatible_with = _COMPAT)

