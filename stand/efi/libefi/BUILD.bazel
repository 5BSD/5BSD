bsd_freestanding_artifact(name = "i386_abi_contract", src = ":abi_contract", architecture = "i386", testonly = True)
bsd_host_artifact_test(name = "archive_i386_test", src = "archive-test.py",
    data = [":i386_archive", ":i386_abi_contract", ":inspection_tools", "//sys/teken:state_header",
        "//sys/teken:gensequences", "//sys/teken:sequences", "@bsd_sdk//toolchain:bin/llvm-ar",
        "@bsd_sdk//toolchain:bin/llvm-nm", "@bsd_sdk//toolchain:bin/awk"],
    args = ["--machine", "3", "--clock", "time.o", "--zfs"] + select({
