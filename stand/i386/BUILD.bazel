exports_files(["boot.ldscript"], visibility = ["//stand/i386:__subpackages__"])
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
load("//tools/build/bazel:bsd_python_test.bzl", "bsd_python_test")
_LEGACY_IMAGES = ["//stand/i386/" + name + ":" + name for name in ["boot0", "boot0sio", "mbr", "pmbr", "cdboot"]] + ["//stand/i386/btx/btx:btx", "//stand/i386/btx/btxldr:btxldr"]
filegroup(name = "legacy_boot_images", srcs = _LEGACY_IMAGES, visibility = ["//visibility:public"])
bsd_install_manifest(name = "legacy_install_manifest",
    manifests = ["//stand/i386/" + name + ":install_manifest" for name in ["boot0", "boot0sio", "mbr", "pmbr", "cdboot"]], visibility = ["//visibility:public"])
bsd_install_archive(name = "legacy_install_archive", manifests = [":legacy_install_manifest"],
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0, python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
bsd_python_test(name = "legacy_boot_test", src = "legacy_boot_test.py", data = _LEGACY_IMAGES + [
    "//stand/i386/" + name + ":compiler_object" for name in ["boot0", "boot0sio", "mbr", "pmbr", "cdboot", "btx/btx", "btx/btxldr"]],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
