# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "bootargs_header", hdrs = ["bootargs.h"],
    visibility = ["//stand/i386/btx/lib:__pkg__", "//stand/i386/btx/btx:__pkg__", "//stand/i386/btx/btxldr:__pkg__", "//stand/i386/cdboot:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

bsd_source_headers(name = "bios_libi386_headers", hdrs = ['edd.h'], visibility = ["//stand/i386/libi386:__pkg__"])

bsd_source_headers(name = "bios_loader_headers", hdrs = ['bootargs.h', 'drv.h'], visibility = ["//stand/i386/loader:__pkg__"])

exports_files(["boot_config.bzl"], visibility = ["//stand/i386:__subpackages__"])

bsd_source_headers(name = "gpt_boot_headers", hdrs = ['bootargs.h', 'cons.h', 'drv.h', 'edd.h'], visibility = ['//stand/i386/gptboot:__pkg__', '//stand/i386/isoboot:__pkg__'])

filegroup(name = "gpt_boot_cons_source", srcs = ["cons.c"], visibility = ['//stand/i386/gptboot:__pkg__', '//stand/i386/isoboot:__pkg__'])

filegroup(name = "gpt_boot_drv_source", srcs = ["drv.c"], visibility = ['//stand/i386/gptboot:__pkg__', '//stand/i386/isoboot:__pkg__'])

load(":boot_config.bzl", "boot_image_inspection")
boot_image_inspection(name = "gpt_iso_policy", visibility = ["//tools/build/bazel:__pkg__"])

bsd_source_headers(name = "gpt_zfs_headers", hdrs = ['bootargs.h', 'cons.h'], visibility = ['//stand/i386/gptzfsboot:__pkg__'])

filegroup(name = "gpt_zfs_cons_source", srcs = ["cons.c"], visibility = ['//stand/i386/gptzfsboot:__pkg__'])

bsd_source_headers(name = "pxe_headers", hdrs = ["bootargs.h"], visibility = ["//stand/i386/pxeldr:__pkg__"])
