# Legacy BIOS assembly uses the standalone i386 toolchain.
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_object")
load("//tools/build/bazel:bsd_boot_image.bzl", "bsd_boot_link")
load("//tools/build/bazel:bsd_freestanding_artifact.bzl", "bsd_freestanding_artifact")
_COMPAT = ["@platforms//os:freebsd", "@platforms//cpu:x86_32"]
cc_library(name = "objects", srcs = ["pmbr.S"],
    copts = ['-O2', '-pipe', '-fno-common', '-Istand/i386/btx/lib', '-nostdinc', '-Istand/libsa', '-D_STANDALONE', '-Isys', '-Ddouble=jagged-little-pill', '-Dfloat=floaty-mcfloatface', '-ffunction-sections', '-fdata-sections', '-DLOADER_GELI_SUPPORT', '-Istand/libsa/geli', '-DLOADER_DISK_SUPPORT', '-m32', '-ffreestanding', '-mno-mmx', '-mno-sse', '-mno-avx', '-mno-avx2', '-msoft-float', '-march=i386', '-mno-relax', '-I.', '-Iinclude', '-std=gnu17', '-Wno-format-zero-length', '-Wsystem-headers', '-Werror', '-Wno-pointer-sign', '-Wdate-time', '-Wno-empty-body', '-Wno-string-plus-int', '-Wno-unused-const-variable', '-Wno-error=unused-but-set-parameter', '-Wno-error=cast-function-type-mismatch', '-Wno-tautological-compare', '-Wno-unused-value', '-Wno-parentheses-equality', '-Wno-unused-function', '-Wno-enum-conversion', '-Wno-unused-local-typedef', '-Wno-address-of-packed-member', '-Wno-switch', '-Wno-switch-enum', '-Wno-knr-promoted-parameter', '-Wno-parentheses', '-Oz', '-Qunused-arguments', '-Wa,-defsym,FLAGS=0'],
    features = ["-opt", "-bsd_debug_info", "-bsd_ssp", "-bsd_riscv_userland_abi"],
    linkstatic = True, target_compatible_with = _COMPAT)
bsd_component_object(name = "native_object", group = ":objects", out = "pmbr.o",
    target_compatible_with = _COMPAT)
bsd_boot_link(name = "native_image", objects = [":native_object"], output = "pmbr",
    script = "//stand/i386:boot.ldscript",
    linkopts = ["-m", "elf_i386_fbsd", "-e", "start", "--defsym", "ORG=0x600",
        "-N", "-S", "--oformat", "binary", "--build-id=none", "-z", "now", "-z", "relro", "--no-rosegment"],
    target_compatible_with = _COMPAT)
bsd_freestanding_artifact(name = "pmbr", src = ":native_image", architecture = "i386",
    visibility = ["//visibility:public"])
bsd_freestanding_artifact(name = "compiler_object", src = ":native_object", architecture = "i386",
    visibility = ["//stand/i386:__pkg__"])

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest")
bsd_install_file(name = "install_binary", src = ":pmbr", destination = "/boot/pmbr",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=bootloader"])
bsd_install_manifest(name = "install_manifest", entries = [':install_binary'], visibility = ["//stand/i386:__pkg__"])
