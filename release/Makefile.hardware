# SPDX-License-Identifier: BSD-2-Clause
# Native hardware packaging: unprivileged ports staging, no host installation.
PORTSDIR?= /usr/ports
HARDWARE_PYTHON?= python3.12
PKG_CMD?= /usr/local/sbin/pkg-static
KERNCONF?= GENERIC
REPODIR?= ${MAKEOBJDIRPREFIX:U/usr/obj}${.CURDIR}/repo
HARDWARE_ABI!= ${PKG_CMD} config ABI
BASE_REPOSITORY?= ${REPODIR}/${HARDWARE_ABI}/latest-built
HARDWARE_REPO?= ${BASE_REPOSITORY:tA}.hardware
COMPLETE_REPOSITORY?= ${BASE_REPOSITORY:tA}.complete
KERNBUILDDIR?= ${MAKEOBJDIRPREFIX:U/usr/obj}${.CURDIR}/${MACHINE}.${MACHINE_ARCH}/sys/${KERNCONF}
HARDWARE_PORT_LIST?= ${.CURDIR}/release/tools/hardware-ports.${MACHINE_ARCH}
# make(1) treats ':' in WRKDIRPREFIX as a dependency separator, so keep port
# work out of the ABI-named repository directory.
HARDWARE_WORKDIR?= ${MAKEOBJDIRPREFIX:U/usr/obj}${.CURDIR}/hardware-work/${BASE_REPOSITORY:tA:T}
DISTDIR?= ${PORTSDIR}/distfiles
# Publication requires a world built WITH_MALLOC_PRODUCTION; development
# worlds keep the debug malloc(3) default.  ALLOW_DEBUG_MALLOC=yes turns the
# refusal into a warning for test publications only.
LIBC_OBJDIR?= ${OBJTOP}/lib/libc
MALLOC_PRODUCTION_CHECK= sh ${.CURDIR}/release/scripts/check-malloc-production.sh \
	    ${ALLOW_DEBUG_MALLOC:U:tl:Myes:S/yes/-a/}

# Read-only: the world in the object tree must use production malloc(3).
malloc-production-check: .PHONY
	@${MALLOC_PRODUCTION_CHECK} -o ${LIBC_OBJDIR:Q}

hardware-packages hardware-packages-check: .PHONY
	${HARDWARE_PYTHON} ${.CURDIR}/release/scripts/native-hardware.py \
	    --base ${BASE_REPOSITORY:Q} --kernel-build ${KERNBUILDDIR:Q} \
	    --ports ${PORTSDIR:Q} --profile ${HARDWARE_PORT_LIST:Q} \
	    --work ${HARDWARE_WORKDIR:Q} --output ${HARDWARE_REPO:Q} \
	    --distfiles ${DISTDIR:Q} --pkg ${PKG_CMD:Q} \
	    ${.TARGET:Mhardware-packages-check:S/hardware-packages-check/--check/}

publish-packages: .PHONY
	@${MALLOC_PRODUCTION_CHECK} -r ${BASE_REPOSITORY:Q}
	${HARDWARE_PYTHON} ${.CURDIR}/release/scripts/hardware-packages.py publish \
	    --repository ${HARDWARE_REPO:Q} --base-repository ${BASE_REPOSITORY:Q} \
	    --output ${COMPLETE_REPOSITORY:Q} --pkg ${PKG_CMD:Q} \
	    ${HARDWARE_SIGNING_KEY:D--signing-key ${HARDWARE_SIGNING_KEY:Q}}

.ORDER: hardware-packages publish-packages

system-packages: .PHONY
	${MAKE} -C ${.CURDIR} malloc-production-check
	${MAKE} -C ${.CURDIR} packages
	${MAKE} -C ${.CURDIR} hardware-packages
	${MAKE} -C ${.CURDIR} publish-packages
