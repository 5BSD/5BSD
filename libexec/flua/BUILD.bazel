load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
cc_library(name = "module_headers", hdrs = ["modules/lposix.h"], strip_include_prefix = "modules")
cc_binary(name = "flua", srcs = ["//contrib/lua/src:lua.c", "linit_flua.c", "modules/lposix.c", "bootstrap.h"],
    deps = [":module_headers", "//lib/liblua:lua_pie", "//lib/libedit:edit",
        "//contrib/libedit:readline_compat_headers", "//lib/libedit/readline:history_compat_headers"],
    dynamic_deps = ["//lib/libedit:edit_shared", "//lib/msun:m_shared"],
    local_defines = ["LUA_USE_READLINE", "LUA_PROGNAME=\\\"flua\\\""],
    copts = ["-fPIE"], linkopts = ["-pie", "-Wl,-E"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "flua", manual = "flua.1", package = "flua", bindir = "/usr/libexec")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=flua","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/libexec"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

cc_library(name = "bootstrap_headers", hdrs = ["bootstrap.h"], strip_include_prefix = ".",
    visibility = ["//libexec/flua:__subpackages__"])

# Interpreter and all modules from the non-bootstrap Make configuration.
bsd_install_archive(
    name = "complete_install_archive",
    visibility = ["//libexec:__pkg__"],
    manifests = [":install_manifest", "//libexec/flua/lfbsd:install_manifest", "//libexec/flua/lfs:install_manifest", "//libexec/flua/libhash:install_manifest", "//libexec/flua/libjail:install_manifest", "//libexec/flua/libucl:install_manifest", "//libexec/flua/liblyaml:install_manifest", "//libexec/flua/libfreebsd/kenv:install_manifest", "//libexec/flua/libfreebsd/sys/linker:install_manifest"],
    directories = {
    "/usr/lib/debug/usr": "{\"owner\":\"root\",\"group\":\"wheel\",\"mode\":\"0755\",\"tags\":[\"package=flua\",\"dbg\"]}",
    "/usr/lib/debug/usr/libexec": "{\"owner\":\"root\",\"group\":\"wheel\",\"mode\":\"0755\",\"tags\":[\"package=flua\",\"dbg\"]}",
    "/usr/lib/debug/usr/lib": "{\"owner\":\"root\",\"group\":\"wheel\",\"mode\":\"0755\",\"tags\":[\"package=flua\",\"dbg\"]}",
    "/usr/lib/debug/usr/lib/flua": "{\"owner\":\"root\",\"group\":\"wheel\",\"mode\":\"0755\",\"tags\":[\"package=flua\",\"dbg\"]}",
    "/usr/lib/debug/usr/lib/flua/freebsd": "{\"owner\":\"root\",\"group\":\"wheel\",\"mode\":\"0755\",\"tags\":[\"package=flua\",\"dbg\"]}",
    "/usr/lib/debug/usr/lib/flua/freebsd/sys": "{\"owner\":\"root\",\"group\":\"wheel\",\"mode\":\"0755\",\"tags\":[\"package=flua\",\"dbg\"]}",
    "/usr/share/flua/lyaml": "{\"owner\":\"root\",\"group\":\"wheel\",\"mode\":\"0755\",\"tags\":[\"package=flua\"]}"
},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
