# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
cc_library(name = "objects", srcs = ["lhash.c", "lhash.h"],
    deps = ["//contrib/lua/src:headers", "//libexec/flua:bootstrap_headers", "//lib/libmd:md_link"],
    linkstatic = True)
# Lua API symbols resolve from the interpreter; do not embed another Lua runtime.
cc_shared_library(name = "module", deps = [":objects"], shared_lib_name = "hash.so",
    dynamic_deps = ["//lib/libmd:md_shared"],
    user_link_flags = ["-Wl,-soname,hash.so", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
load("//libexec/flua:module_installation.bzl", "module_installation")
load("//tools/build/bazel:bsd_install.bzl", "bsd_compress", "bsd_install_file")
bsd_compress(name = "manual", src = "hash.3lua", output = "hash.3lua.gz", arguments = ["-cn"],
    compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect",
    runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(name = "manual_file", src = ":manual", destination = "/usr/share/man/man3lua/hash.3lua.gz",
    owner = "root", group = "wheel", mode = "0444", install_tags = select({
        "//tools/build/bazel/config:split_manpages_enabled": ["package=flua-man"],
        "//conditions:default": ["package=flua-dev"]}))
module_installation(name = "install_manifest", module = "hash.so", extra_entries = [":manual_file"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=flua","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib", "/usr/lib/debug/usr/lib/flua"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

exports_files(['lhash.c', 'lhash.h'], visibility = ["//stand/liblua:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

bsd_source_headers(name = 'kboot_loader_headers', hdrs = ['lhash.h'], visibility = ["//stand/kboot/kboot:__pkg__"])
