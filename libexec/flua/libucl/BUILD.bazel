# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
cc_library(name = "objects", srcs = ["//contrib/libucl:lua/lua_ucl.c"],
    deps = ["//contrib/lua/src:headers", "//libexec/flua:bootstrap_headers", "//lib/libucl:ucl", "//contrib/libucl:lua_headers", "//contrib/libucl:source_headers", "//contrib/libucl:uthash_headers"],
    linkstatic = True)
# Lua API symbols resolve from the interpreter; do not embed another Lua runtime.
cc_shared_library(name = "module", deps = [":objects"], shared_lib_name = "ucl.so",
    dynamic_deps = ["//lib/libucl:ucl_shared"],
    user_link_flags = ["-Wl,-soname,ucl.so", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
load("//libexec/flua:module_installation.bzl", "module_installation")
module_installation(name = "install_manifest", module = "ucl.so")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=flua","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib", "/usr/lib/debug/usr/lib/flua"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
