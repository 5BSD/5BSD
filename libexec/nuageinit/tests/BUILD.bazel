# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")
load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_script_wrapper")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
cc_binary(name = "crypt", srcs = ["//usr.sbin/pw/tests:crypt.c"], deps = ["//lib/libcrypt:crypt"],
    dynamic_deps = ["//lib/libcrypt:crypt_shared"], copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
utility_installation(name = "crypt_install", program = "crypt", manual = None, package = "tests", bindir = "/usr/tests/libexec/nuageinit")
_SCRIPTS = ["nuage", "utils", "nuageinit"]
_FIXTURES = ["addgroup", "addsshkey", "adduser", "adduser_passwd", "dirname", "err", "sethostname", "settimezone", "warn", "addfile", "decode_base64", "addsudo", "adddoas", "update_sshd_config"]
[bsd_script_wrapper(name = n, body = n + ".sh", interpreter = "/usr/libexec/atf-sh",
    cat = "@bsd_sdk//toolchain:cat", cat_runtime = ["@bsd_sdk//toolchain:cat_runtime"], redirect = "@bsd_sdk//toolchain:stdout_redirect") for n in _SCRIPTS]
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = sorted(_SCRIPTS), interfaces = {n: "atf" for n in _SCRIPTS})
[bsd_install_file(name = n + "_script", src = ":" + n, destination = "/usr/tests/libexec/nuageinit/" + n,
    owner = "root", group = "wheel", mode = "0555", install_tags = ["package=tests"]) for n in _SCRIPTS]
[bsd_install_file(name = n + "_fixture", src = n + ".lua", destination = "/usr/tests/libexec/nuageinit/" + n + ".lua",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=tests"]) for n in _FIXTURES]
bsd_install_file(name = "install_kyuafile", src = ":kyuafile", destination = "/usr/tests/libexec/nuageinit/Kyuafile",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=tests"])
bsd_install_manifest(name = "install_manifest", entries = [":" + n + "_script" for n in _SCRIPTS] + [":" + n + "_fixture" for n in _FIXTURES] + [":install_kyuafile"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//libexec:__pkg__"],
    manifests = [":install_manifest", ":crypt_install"],
    directories = {
        "/usr/lib/debug/usr": "{\"owner\":\"root\",\"group\":\"wheel\",\"mode\":\"0755\",\"tags\":[\"package=tests\",\"dbg\"]}",
        "/usr/lib/debug/usr/tests": "{\"owner\":\"root\",\"group\":\"wheel\",\"mode\":\"0755\",\"tags\":[\"package=tests\",\"dbg\"]}",
        "/usr/lib/debug/usr/tests/libexec": "{\"owner\":\"root\",\"group\":\"wheel\",\"mode\":\"0755\",\"tags\":[\"package=tests\",\"dbg\"]}",
        "/usr/lib/debug/usr/tests/libexec/nuageinit": "{\"owner\":\"root\",\"group\":\"wheel\",\"mode\":\"0755\",\"tags\":[\"package=tests\",\"dbg\"]}",
        "/usr/tests/libexec/nuageinit": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests"]}',
    },
    mtree_specs = {
        "//etc/mtree:BSD.tests.dist": "/usr/tests",
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

# Execute existing self-checking fixtures; installed ATF suites remain separate.
_RUNTIME = ["//lib/libc:c_shared", "//lib/libsys:sys_shared", "//lib/libedit:edit_shared", "//lib/ncurses/tinfo:tinfo_shared", "//lib/msun:m_shared"]
[cc_test(name = "lua_" + case, srcs = ["//libexec/flua/tests:runner.c"],
    linkopts = ["-static"], linkstatic = True,
    args = ["$(rootpath //libexec/rtld-elf:rtld_binary)", "$(rootpath //libexec/flua:flua)",
        "$(rootpath :native_fixture.lua)", case, "--temp-env=NUAGE_FAKE_ROOTDIR"] +
        ["$(rootpath " + label + ")" for label in _RUNTIME] +
        ["--", "lfs", "$(rootpath //libexec/flua/lfs:module)", "nuage", "$(rootpath //libexec/nuageinit:nuage.lua)",
         "fixture", "$(rootpath :" + case + ".lua)"],
    data = _RUNTIME + ["//libexec/rtld-elf:rtld_binary", "//libexec/flua:flua", "//libexec/flua/lfs:module",
        "//libexec/nuageinit:nuage.lua", "native_fixture.lua", case + ".lua"],
    size = "small", target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
 for case in ["dirname", "addfile", "decode_base64", "sethostname", "update_sshd_config"]]
