# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
cc_binary(name = "tcpd", srcs = ["//contrib/tcp_wrappers:tcpd.c", "//contrib/tcp_wrappers:patchlevel.h"],
    deps = ["//lib/libwrap:wrap"], dynamic_deps = ["//lib/libwrap:wrap_shared"],
    local_defines = ["REAL_DAEMON_DIR=\\\"/usr/libexec\\\"", "SEVERITY=LOG_INFO", "RFC931_TIMEOUT=10", "HOSTS_DENY=\\\"/etc/hosts.deny\\\"", "HOSTS_ALLOW=\\\"/etc/hosts.allow\\\"", "FACILITY=LOG_DAEMON"] +
        select({"//tools/build/bazel/config:inet6_support_enabled": ["INET6"], "//conditions:default": []}), copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "tcpd", manual = "//contrib/tcp_wrappers:tcpd.8", man_section = "8", package = "tcpd", bindir = "/usr/libexec")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tcpd","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/libexec"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
