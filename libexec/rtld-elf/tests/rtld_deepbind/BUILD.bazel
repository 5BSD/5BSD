load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_binary")
load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
load(":fixtures.bzl", "fixture_alias")
# Keep these outputs beside the test executable, matching its installed layout
# and preserving the maintained $ORIGIN lookup without changing test sources.
[cc_library(name = name, linkstatic = True, srcs = ["//libexec/rtld-elf/tests/libval:libval.c"])
 for name in ["val", "val2"]]
[cc_shared_library(name = name + "_shared", deps = [":" + name], shared_lib_name = "lib" + name + ".so.0",
    user_link_flags = ["-Wl,-soname,lib" + name + ".so.0"])
 for name in ["val", "val2"]]
cc_library(name = "deep", linkstatic = True, srcs = ["//libexec/rtld-elf/tests/libdeep:libdeep.c"], deps = [":val2"])
cc_shared_library(name = "deep_shared", deps = [":deep"], dynamic_deps = [":val2_shared"],
    shared_lib_name = "libdeep.so.0", user_link_flags = ["-Wl,-soname,libdeep.so.0", "-Wl,-rpath,$ORIGIN"])
fixture_alias(name = "deep_alias", src = ":deep_shared", out = "libdeep.so")
cc_binary(name = "rtld_deepbind", srcs = ["rtld_deepbind.c"],
    deps = [":val", "//lib/atf/libatf-c:atf_c"],
    dynamic_deps = [":val_shared", "//lib/atf/libatf-c:atf_c_shared"],
    copts = ["-fPIE"], linkopts = ["-pie", "-Wl,-rpath,$$ORIGIN"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
bsd_atf_test(name = "deepbind_simple", body = ":rtld_deepbind", case_name = "deepbind_simple", interface = "program",
    loader = "//libexec/rtld-elf:rtld_binary",
    runtime_lib = ["//lib/libc:c_shared", "//lib/libsys:sys_shared", "//lib/atf/libatf-c:atf_c_shared"],
    data = [":val_shared", ":val2_shared", ":deep_shared", ":deep_alias"],
    runner = "//tools/build/bazel:atf_runner", size = "small")

load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_link", "bsd_install_manifest", "bsd_kyuafile")
_TESTDIR = "/usr/tests/libexec/rtld-elf/rtld_deepbind"
[bsd_install_link(name = "install_" + name + "_link", destination = _TESTDIR + "/lib" + name + ".so",
    target = "lib" + name + ".so.0", kind = "symlink", owner = "root", group = "wheel",
    mode = "0755", install_tags = ["package=tests"])
 for name in ["val", "val2", "deep"]]
[utility_installation(name = "install_" + name, program = "lib" + name + ".so.0",
    binary = ":" + name + "_shared", binary_mode = "0444", manual = "",
    package = "tests", bindir = _TESTDIR, extra_entries = [":install_" + name + "_link"])
 for name in ["val", "val2", "deep"]]
utility_installation(name = "install_program", program = "rtld_deepbind",
    manual = "", package = "tests", bindir = _TESTDIR)
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["rtld_deepbind"],
    interfaces = {"rtld_deepbind": "atf"})
bsd_install_file(name = "install_kyuafile", src = ":kyuafile",
    destination = _TESTDIR + "/Kyuafile", owner = "root", group = "wheel",
    mode = "0444", install_tags = ["package=tests"])
bsd_install_manifest(name = "install_metadata", entries = [":install_kyuafile"],
    visibility = ["//libexec/rtld-elf/tests:__pkg__"])
