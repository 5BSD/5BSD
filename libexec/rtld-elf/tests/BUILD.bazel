load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
_RUNTIME = ["//lib/libc:c_shared", "//lib/libsys:sys_shared", "//lib/atf/libatf-c:atf_c_shared", "//lib/msun:m_shared"]
_PROGRAMS = [("set_var_test", "set_var_library_path_fds"), ("dlopen_hash_test", "dlopen_hash")]
[cc_binary(name = program, srcs = [program + ".c"],
    deps = ["//lib/atf/libatf-c:atf_c"], dynamic_deps = ["//lib/atf/libatf-c:atf_c_shared"],
    copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
 for program, _ in _PROGRAMS]
[bsd_atf_test(name = case, interface = "program", body = ":" + program, case_name = case,
    loader = "//libexec/rtld-elf:rtld_binary", runtime_lib = _RUNTIME,
    data = ["//libexec/rtld-elf/tests/libpythagoras:pythagoras_shared"],
    runner = "//tools/build/bazel:atf_runner", size = "small")
 for program, case in _PROGRAMS]
