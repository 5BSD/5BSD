#
# protoc plugin that generates the upb reflection definitions
# (NAME.upbdefs.c and .h: the descriptors, for upb_DefPool) for C consumers
# linking libupb.
# lib/protobuf/protoc-gen.mk runs it through protoc --plugin; buildworld
# builds the bootstrap copy in the bootstrap-tools stage.  The plugin reads
# the CodeGeneratorRequest with upb itself (upstream's checked-in bootstrap
# plugin.upb* in upb_generator/cmake).

.include <src.opts.mk>

PROTOBUF=	${SRCTOP}/contrib/protobuf
ABSL=		${SRCTOP}/contrib/abseil-cpp

PACKAGE=	protobuf
PROG_CXX=	protoc-gen-upbdefs
.include "${SRCTOP}/lib/protobuf/protobuf.dirs.mk"
BINDIR=		${PROTOC_PLUGINDIR}
MAN=
CXXSTD=		c++17
WARNS?=		1

.PATH:		${PROTOBUF}

# BEGIN generated by the import (contrib/protobuf/README.5BSD)
SRCS+=	src/google/protobuf/compiler/code_generator_lite.cc
SRCS+=	src/google/protobuf/port.cc
SRCS+=	upb_generator/common.cc
SRCS+=	upb_generator/common/names.cc
SRCS+=	upb_generator/file_layout.cc
SRCS+=	upb_generator/minitable/names.cc
SRCS+=	upb_generator/minitable/names_internal.cc
SRCS+=	upb_generator/reflection/generator.cc
SRCS+=	upb_generator/reflection/names.cc
# END generated
SRCS+=	upb_generator/cmake/google/protobuf/compiler/plugin.upb_minitable.c

CFLAGS+=	-I${PROTOBUF}/upb_generator/cmake -I${PROTOBUF}/src \
		-I${PROTOBUF} -I${PROTOBUF}/upb/reflection/cmake
CXXFLAGS+=	-I${ABSL}

LIBADD=		upb absl

.include <bsd.prog.mk>
