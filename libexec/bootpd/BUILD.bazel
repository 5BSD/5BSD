# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
cc_library(name = "headers", hdrs = ["bootp.h", "bootpd.h", "bptypes.h", "dovend.h", "getether.h", "getif.h", "hash.h", "hwaddr.h", "lookup.h", "patchlevel.h", "readfile.h", "report.h", "tzone.h"], strip_include_prefix = ".")
cc_binary(name = "bootpd", srcs = ["bootpd.c", "dovend.c", "readfile.c", "hash.c", "dumptab.c", "lookup.c", "getif.c", "hwaddr.c", "report.c", "tzone.c", "rtmsg.c"],
    deps = [":headers"],
    local_defines = ["ETC_ETHERS", "SYSLOG", "DEBUG", "VEND_CMU"],
    copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
cc_binary(name = "bootpgw", srcs = ["bootpgw/bootpgw.c", "getif.c", "hwaddr.c", "report.c", "rtmsg.c"],
    deps = [":headers"],
    local_defines = [],
    copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
cc_binary(name = "bootpef", srcs = ["tools/bootpef/bootpef.c", "dovend.c", "readfile.c", "hash.c", "dumptab.c", "lookup.c", "hwaddr.c", "report.c", "tzone.c", "rtmsg.c"],
    deps = [":headers"],
    local_defines = [],
    copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
cc_binary(name = "bootptest", srcs = ["tools/bootptest/bootptest.c", "tools/bootptest/bootptest.h", "getether.c", "getif.c", "tools/bootptest/print-bootp.c", "report.c"],
    deps = [":headers"],
    local_defines = [],
    copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_bootpd", program = "bootpd", manual = "bootpd.8", package = "utilities", bindir = "/usr/libexec", man_section = "8", manual_aliases = ["bootpgw"])
utility_installation(name = "install_bootpgw", program = "bootpgw", manual = "", package = "utilities", bindir = "/usr/libexec", man_section = "8")
utility_installation(name = "install_bootpef", program = "bootpef", manual = "tools/bootpef/bootpef.8", package = "utilities", bindir = "/usr/sbin", man_section = "8")
utility_installation(name = "install_bootptest", program = "bootptest", manual = "tools/bootptest/bootptest.8", package = "utilities", bindir = "/usr/sbin", man_section = "8")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_compress")
bsd_compress(name = "bootptab_manual", src = "bootptab.5", output = "bootptab.5.gz", arguments = ["-cn"],
    compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect",
    runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(name = "install_bootptab_manual", src = ":bootptab_manual", destination = "/usr/share/man/man5/bootptab.5.gz",
    owner = "root", group = "wheel", mode = "0444", install_tags = select({
        "//tools/build/bazel/config:split_manpages_enabled": ["package=utilities-man"],
        "//conditions:default": ["package=utilities"]}))
bsd_install_manifest(name = "install_extra", entries = [":install_bootptab_manual"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_bootpd", ":install_bootpgw", ":install_bootpef", ":install_bootptest", ":install_extra"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/libexec", "/usr/lib/debug/usr/sbin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
