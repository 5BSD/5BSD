load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = "getty", srcs = ["main.c", "init.c", "subr.c", "chat.c",
    "extern.h", "gettytab.h", "pathnames.h"],
    deps = ["//lib/libutil:util"], dynamic_deps = ["//lib/libutil:util_shared"],
    copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_compress")
utility_installation(name = "install_program", program = "getty", manual = "getty.8",
    man_section = "8", package = "runtime", bindir = "/usr/libexec")
bsd_install_file(name = "install_config", src = "gettytab", destination = "/etc/gettytab",
    owner = "root", group = "wheel", mode = "0644", install_tags = ["package=runtime", "config"])
[bsd_compress(name = "manual_" + name, src = name + ".5", output = name + ".5.gz",
    arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip",
    redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
 for name in ["gettytab", "ttys"]]
[bsd_install_file(name = "install_" + name, src = ":manual_" + name,
    destination = "/usr/share/man/man5/" + name + ".5.gz", owner = "root", group = "wheel", mode = "0444",
    install_tags = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=runtime-man"],
        "//conditions:default": ["package=runtime"]})) for name in ["gettytab", "ttys"]]
bsd_install_manifest(name = "install_extra", entries = [":install_config", ":install_gettytab", ":install_ttys"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "install_archive", manifests = [":install_program", ":install_extra"],
    directories = {path: json.encode({"owner": "root", "group": "wheel", "mode": "0755", "tags": tags})
        for path, tags in [("/etc", ["package=utilities"]),
            ("/usr/lib/debug/usr", ["package=runtime", "dbg"]),
            ("/usr/lib/debug/usr/libexec", ["package=runtime", "dbg"])]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
    visibility = ["//visibility:public"])
