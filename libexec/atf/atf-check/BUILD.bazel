load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = "atf-check", srcs = ["//contrib/atf:atf-sh/atf-check.cpp"],
    deps = ["//contrib/atf:cxx_private_headers", "//lib/atf/libatf-c++:atf_cxx", "//lib/atf/libatf-c:atf_c", "//lib/libc++:cxx", "//lib/libcxxrt:cxxrt", "//lib/msun:m"],
    dynamic_deps = ["//lib/atf/libatf-c++:atf_cxx_shared", "//lib/atf/libatf-c:atf_c_shared", "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared"],
    local_defines = ['HAVE_CONFIG_H', 'ATF_SHELL=\\"/bin/sh\\"'], copts = ["-std=gnu++20", "-nostdinc++", "-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "atf-check", manual = "//contrib/atf:atf-sh/atf-check.1", package = "atf", bindir = "/usr/libexec")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {'/usr/lib/debug/usr': '{"owner":"root","group":"wheel","mode":"0755","tags":["package=atf","dbg"]}', '/usr/lib/debug/usr/libexec': '{"owner":"root","group":"wheel","mode":"0755","tags":["package=atf","dbg"]}'},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
