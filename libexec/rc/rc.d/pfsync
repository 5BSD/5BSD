#!/bin/sh
#
#

# PROVIDE: pfsync
# REQUIRE: FILESYSTEMS netif
# KEYWORD: nojailvnet

. /etc/rc.subr

name="pfsync"
desc="Packet filter state table sychronisation interface"
rcvar="pfsync_enable"
start_precmd="pfsync_prestart"
start_cmd="pfsync_start"
stop_cmd="pfsync_stop"
# Vendor PF includes the pfsync interface in pf.ko (or the kernel).
# Late kldload(2) is reserved to the SystemExtension broker; a pf preloaded
# from loader.conf (the default) is claimed through it.

pfsync_prestart()
{
	case "$pfsync_syncdev" in
	'')
		warn "pfsync_syncdev is not set."
		return 1
		;;
	esac
	load_kld -b pf
}

pfsync_start()
{
	local _syncpeer

	echo "Enabling pfsync."
	if [ -n "${pfsync_syncpeer}" ]; then
		_syncpeer="syncpeer ${pfsync_syncpeer}"
	fi
	ifconfig pfsync0 >/dev/null 2>&1 || ifconfig pfsync0 create
	ifconfig pfsync0 $_syncpeer syncdev $pfsync_syncdev $pfsync_ifconfig up
}

pfsync_stop()
{
	echo "Disabling pfsync."
	ifconfig pfsync0 -syncdev -syncpeer down
}

load_rc_config $name

# doesn't make sense to run in a svcj: config setting
pfsync_svcj="NO"

run_rc_command "$1"
