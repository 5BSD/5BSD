#!/bin/sh
#
#

# PROVIDE: os-release
# REQUIRE: mountcritremote FILESYSTEMS
# BEFORE:  LOGIN

. /etc/rc.subr

name="osrelease"
desc="os-release update"
rcvar="osrelease_enable"
start_cmd="osrelease_start"
stop_cmd=":"

load_rc_config $name

: ${osrelease_file:=/var/run/os-release}
: ${osrelease_perms:=444}
: ${osrelease_home_url:="https://github.com/5BSD/5BSD"}
: ${osrelease_documentation_url:="https://github.com/5BSD/5BSD"}
: ${osrelease_support_url:="https://github.com/5BSD/5BSD"}
: ${osrelease_bug_report_url:="https://github.com/5BSD/5BSD"}

osrelease_start()
{
	local _version _version_id _status t

	startmsg -n "Updating ${osrelease_file} "
	if ! _version=$(freebsd-version -u); then
		warn "Unable to obtain the installed system version"
		return 1
	fi
	_version_id=${_version%%[^0-9.]*}
	if ! t=$(mktemp -t os-release); then
		warn "Unable to create temporary os-release metadata"
		return 1
	fi
	cat > "$t" <<-__EOF__
		NAME=5BSD
		VERSION="$_version"
		VERSION_ID="$_version_id"
		ID=5bsd
		ID_LIKE=freebsd
		ANSI_COLOR="0;31"
		PRETTY_NAME="5BSD $_version"
		HOME_URL="${osrelease_home_url}"
		DOCUMENTATION_URL="${osrelease_documentation_url}"
		SUPPORT_URL="${osrelease_support_url}"
		BUG_REPORT_URL="${osrelease_bug_report_url}"
__EOF__
	_status=$?
	if [ "$_status" -eq 0 ]; then
		install -C -o root -g wheel -m "${osrelease_perms}" "$t" "${osrelease_file}" ||
		    _status=$?
	fi
	if ! rm -f "$t"; then
		warn "Unable to remove temporary os-release metadata"
		[ "$_status" -ne 0 ] || _status=1
	fi
	if [ "$_status" -ne 0 ]; then
		warn "Unable to update ${osrelease_file}"
		return "$_status"
	fi
	startmsg 'done.'
}

# doesn't make sense to run in a svcj: config setting
osrelease_svcj="NO"

run_rc_command "$1"
