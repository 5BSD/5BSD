#!/bin/sh
#
#

# PROVIDE: root
# REQUIRE: fsck
# KEYWORD: nojail

. /etc/rc.subr

name="root"
desc="Mount root filesystem read/write"
start_cmd="root_start"
stop_cmd=":"

root_start()
{
	local integrity

	# Protected mounts and boot selection belong to the authenticated PID 1
	# policy. Do not remount root, tear down those mounts, or edit nextboot.
	# -i permits kernels without this policy; other query failures abort.
	integrity=$(${SYSCTL} -i -n security.mac.system_integrity.enforcing) || {
		echo 'Cannot determine root integrity protection, startup aborted'
		stop_boot true
		return 1
	}
	case "${integrity}" in
	1)
		return 0
		;;
	0|"")
		;;
	*)
		echo 'Invalid root integrity protection status, startup aborted'
		stop_boot true
		return 1
		;;
	esac

	# root normally must be read/write, but if this is a BOOTP NFS
	# diskless boot it does not have to be.
	#
	case ${root_rw_mount} in
	[Nn][Oo] | '')
		;;
	*)
		if ! mount -uw /; then
			echo 'Mounting root filesystem rw failed, startup aborted'
			stop_boot true
		fi
		;;
	esac

	umount -a >/dev/null 2>&1

	# If we booted a special kernel remove the record
	# so we will boot the default kernel next time.
	if [ -x /sbin/nextboot ]; then
		/sbin/nextboot -D > /dev/null 2>&1
	fi
}

load_rc_config $name

# doesn't make sense to run in a svcj: mounting / config setting
root_svcj="NO"

run_rc_command "$1"
