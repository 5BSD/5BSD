#!/bin/sh
#

# PROVIDE: oracled
# REQUIRE: FILESYSTEMS devd syslogd
# BEFORE: SERVERS
# KEYWORD: shutdown

. /etc/rc.subr

name="oracled"
desc="Oracle capability-world service manager"
rcvar="oracled_enable"
command="/usr/sbin/${name}"
pidfile="/var/run/${name}.pid"

stop_cmd="${name}_stop"
status_cmd="${name}_status"

oracled_stop()
{
	local _pid _i

	if [ -S /var/run/oracled.sock ]; then
		echo "Stopping ${name} via oraclectl."
		/usr/sbin/oraclectl shutdown || true
		# Wait for the daemon to exit (up to 10 seconds).
		_i=0
		while [ $_i -lt 100 ]; do
			if [ ! -f "${pidfile}" ]; then
				return 0
			fi
			_pid=$(cat "${pidfile}" 2>/dev/null)
			if [ -z "$_pid" ] || ! kill -0 "$_pid" 2>/dev/null; then
				rm -f "${pidfile}"
				return 0
			fi
			_i=$((_i + 1))
			sleep 0.1
		done
		echo "${name} did not exit, sending SIGKILL."
	fi
	# Fallback: signal-based stop.
	if [ -f "${pidfile}" ]; then
		_pid=$(cat "${pidfile}" 2>/dev/null)
		if [ -n "$_pid" ]; then
			kill -KILL "$_pid" 2>/dev/null
			rm -f "${pidfile}"
		fi
	fi
}

oracled_status()
{
	local _pid

	if [ -S /var/run/oracled.sock ]; then
		/usr/sbin/oraclectl status && return 0
	fi
	# Fallback: pidfile check with liveness verification.
	if [ -f "${pidfile}" ]; then
		_pid=$(cat "${pidfile}" 2>/dev/null)
		if [ -n "$_pid" ] && kill -0 "$_pid" 2>/dev/null; then
			echo "${name} is running as pid ${_pid}."
			return 0
		fi
		echo "${name} is not running (stale pidfile)."
		return 1
	fi
	echo "${name} is not running."
	return 1
}

load_rc_config $name

: ${oracled_enable:="YES"}
: ${oracled_flags:=""}

run_rc_command "$1"
