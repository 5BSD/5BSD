#!/bin/sh
#

# PROVIDE: oracled
# REQUIRE: FILESYSTEMS devd syslogd
# BEFORE: SERVERS
# KEYWORD: shutdown

. /etc/rc.subr

name="oracled"
desc="Oracle capability-world service manager"
rcvar="oracled_enable"
command="/usr/sbin/${name}"
pidfile="/var/run/${name}.pid"
extra_commands="reload"

stop_cmd="${name}_stop"
status_cmd="${name}_status"
reload_cmd="${name}_reload"

oracled_stop()
{
	local _i

	if [ ! -S /var/run/oracled.sock ]; then
		echo "${name}: control socket unavailable; refusing ambient signal fallback." >&2
		return 1
	fi

	echo "Stopping ${name} via oraclectl."
	/usr/sbin/oraclectl shutdown || return 1
	_i=0
	while [ -f "${pidfile}" ] && [ $_i -lt 100 ]; do
		_i=$((_i + 1))
		sleep 0.1
	done
	if [ -f "${pidfile}" ]; then
		echo "${name}: shutdown timed out; a procdesc supervisor is required for forced termination." >&2
		return 1
	fi
	return 0
}

oracled_reload()
{

	/usr/sbin/oraclectl reload
}

oracled_status()
{
	local _pid

	if [ -S /var/run/oracled.sock ]; then
		/usr/sbin/oraclectl status && return 0
	fi
	# Ambient kill(2), including signal 0, is intentionally denied.
	if [ -f "${pidfile}" ]; then
		_pid=$(cat "${pidfile}" 2>/dev/null)
		echo "${name} has pidfile for pid ${_pid:-unknown}, but its control socket is unavailable."
		return 2
	fi
	echo "${name} is not running."
	return 1
}

load_rc_config $name

: ${oracled_enable:="YES"}
: ${oracled_flags:=""}

run_rc_command "$1"
