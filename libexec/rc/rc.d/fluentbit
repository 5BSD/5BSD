#!/bin/sh
#
# PROVIDE: fluentbit
# REQUIRE: NETWORKING syslogd
# BEFORE: otel_hwstat otelpfd otelauditd otel_dtrace
# KEYWORD: shutdown
#
# Local OpenTelemetry agent: Fluent Bit receives OTLP from the base
# emitters on agent.listen, tails agent.tail, buffers under the spool
# directory and forwards to agent.upstream (otel.conf(5)).
#
# NOTE: written against the documented Fluent Bit 5.1 command line and
# YAML configuration.  It has not been run against the real binary; it
# refuses to start until fluent-bit is part of the base system.

. /etc/rc.subr

name="fluentbit"
desc="Local OpenTelemetry agent (Fluent Bit)"
rcvar="fluentbit_enable"

load_rc_config $name

# An empty per-service switch follows the OpenTelemetry master switch.
: ${otel_enable:="NO"}
[ -n "${fluentbit_enable}" ] || fluentbit_enable="${otel_enable}"
: ${fluentbit_bin:="/usr/sbin/fluent-bit"}
: ${fluentbit_runas="_otel"}
: ${fluentbit_config:=""}
: ${otel_rundir:="/var/run/otel"}
: ${otelconf_program:="/usr/sbin/otelconf"}

pidfile="${otel_rundir}/${name}.pid"
command="/usr/sbin/daemon"
extra_commands="configtest"
configtest_cmd="fluentbit_configtest"
start_precmd="fluentbit_prestart"

# Produce the configuration in ${_fb_config}: the administrator's own
# file, or one generated from otel.conf.
fluentbit_config_prepare()
{
	if [ ! -x "${fluentbit_bin}" ]; then
		warn "${fluentbit_bin} is not installed; the Fluent Bit" \
		    "import into the base system is pending"
		return 1
	fi
	install -d -m 0755 "${otel_rundir}" || return 1
	if [ -n "${fluentbit_config}" ]; then
		_fb_config="${fluentbit_config}"
	else
		${otelconf_program} check -eq || return 1
		_fb_config="${otel_rundir}/fluent-bit.yaml"
		${otelconf_program} fluentbit -o "${_fb_config}" \
		    ${fluentbit_runas:+-u "${fluentbit_runas}"} || return 1
		_fb_spool="$(${otelconf_program} get spool.directory)" ||
		    return 1
		install -d -m 0750 ${fluentbit_runas:+-o "${fluentbit_runas}"} \
		    ${fluentbit_runas:+-g "${fluentbit_runas}"} \
		    "${_fb_spool}" "${_fb_spool}/fluent-bit" || return 1
	fi
	# Fluent Bit validates the configuration without starting.
	${fluentbit_bin} --dry-run -c "${_fb_config}" >/dev/null || {
		warn "${_fb_config}: rejected by fluent-bit --dry-run"
		return 1
	}
}

fluentbit_configtest()
{
	fluentbit_config_prepare && echo "${name}: ${_fb_config}: OK"
}

fluentbit_prestart()
{
	fluentbit_config_prepare || return 1
	command_args="-f -S -T ${name} -P ${pidfile} -r -R 5 \
${fluentbit_runas:+-u ${fluentbit_runas}} ${fluentbit_bin} \
-c ${_fb_config} ${rc_flags}"
	rc_flags=""
}

run_rc_command "$1"
