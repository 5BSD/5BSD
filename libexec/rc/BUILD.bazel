load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest")
# Maintained rc payload groups; service scripts in rc.d have separate targets.
_CONFIG = ["hostid.subr", "network.subr", "rc", "rc.initdiskless", "rc.subr", "rc.shutdown"]
_EXEC_CONFIG = ["netstart", "pccard_ether", "rc.resume", "rc.suspend"]
_HELPERS = ["debug.sh", "hooks.sh", "safe_eval.sh"]
[bsd_install_file(name = name + "_file", src = name, destination = "/etc/" + name,
    owner = "root", group = "wheel", mode = "0644", install_tags = ["package=rc", "config"])
 for name in _CONFIG]
[bsd_install_file(name = name + "_file", src = name, destination = "/etc/" + name,
    owner = "root", group = "wheel", mode = "0755", install_tags = ["package=rc", "config"])
 for name in _EXEC_CONFIG]
[bsd_install_file(name = name + "_file", src = name, destination = "/libexec/" + name,
    owner = "root", group = "wheel", mode = "0755", install_tags = ["package=rc"])
 for name in _HELPERS]
bsd_install_file(name = "defaults_file", src = "rc.conf", destination = "/etc/defaults/rc.conf",
    owner = "root", group = "wheel", mode = "0644", install_tags = ["package=rc", "config"])
bsd_install_manifest(name = "install_manifest",
    entries = [":" + name + "_file" for name in _CONFIG + _EXEC_CONFIG + _HELPERS] + [":defaults_file"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities"]}' for d in ["/etc", "/etc/defaults"]} | {"/libexec": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=rc"]}'},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

exports_files(["safe_eval.sh"], visibility = ["//libexec/rc/tests:__pkg__"])
