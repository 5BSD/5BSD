load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_script_wrapper")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
_SCRIPTS = ["firstboot_integrity_test", "rc_subr_test", "safe_eval_test", "svcj_test", "sysext_startup_test", "hostid_test", "root_integrity_test", "sshd_startup_test", "syslogd_startup_test", "osrelease_startup_test", "motd_startup_test"]
[bsd_script_wrapper(name = n, body = n + ".sh", interpreter = "/usr/libexec/atf-sh",
    cat = "@bsd_sdk//toolchain:cat", cat_runtime = ["@bsd_sdk//toolchain:cat_runtime"],
    redirect = "@bsd_sdk//toolchain:stdout_redirect") for n in _SCRIPTS]
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = sorted(_SCRIPTS), interfaces = {n: "atf" for n in _SCRIPTS})
[bsd_install_file(name = n + "_file", src = ":" + n, destination = "/usr/tests/libexec/rc/" + n,
    owner = "root", group = "wheel", mode = "0555", install_tags = ["package=tests"]) for n in _SCRIPTS]
bsd_install_file(name = "kyuafile_file", src = ":kyuafile", destination = "/usr/tests/libexec/rc/Kyuafile",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=tests"])
bsd_install_manifest(name = "install_manifest", entries = [":" + n + "_file" for n in _SCRIPTS] + [":kyuafile_file"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {"/usr/tests/libexec/rc": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests"]}'},
    mtree_specs = {
        "//etc/mtree:BSD.tests.dist": "/usr/tests",
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
[bsd_atf_test(
    name = case,
    case_name = case,
    body = "safe_eval_test.sh",
    config_files = {"//libexec/rc:safe_eval.sh": "safe_eval"},
    data = ["//libexec/rtld-elf:rtld_binary"],
    subr = "//libexec/atf/atf-sh:shell_library",
    runtime_bin = ["//usr.bin/mktemp:mktemp", "//usr.bin/tr:tr", "//bin/mkdir:mkdir", "//bin/sh:sh", "//libexec/atf/atf-sh:atf-sh", "//libexec/atf/atf-check:atf-check", "//bin/cat:cat", "//bin/rm:rm", "//usr.bin/dirname:dirname", "//usr.bin/basename:basename", "//usr.bin/grep:grep", "//usr.bin/sed:sed", "//usr.bin/diff:diff"],
    runtime_lib = ["//lib/libc:c_shared", "//lib/libsys:sys_shared", "//lib/atf/libatf-c:atf_c_shared", "//lib/atf/libatf-c++:atf_cxx_shared", "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared", "//lib/libedit:edit_shared", "//lib/ncurses/tinfo:tinfo_shared", "@bsd_sdk//toolchain:sysroot/lib/libgcc_s.so.1", "//lib/libregex:regex_shared"],
    runner = "//tools/build/bazel:atf_runner",
    size = "small",
) for case in ["safe_set_reject", "safe_set_xtras"]]

[bsd_atf_test(
    name = "osrelease_" + case,
    case_name = case,
    body = "osrelease_startup_test.sh",
    config_files = {"//libexec/rc/rc.d:os-release": "rc_script"},
    data = ["//libexec/rtld-elf:rtld_binary"],
    subr = "//libexec/atf/atf-sh:shell_library",
    runtime_bin = ["//bin/cp:cp", "//bin/test:test", "//usr.bin/env:env", "//usr.bin/mktemp:mktemp", "//usr.bin/tr:tr", "//bin/mkdir:mkdir", "//bin/sh:sh", "//libexec/atf/atf-sh:atf-sh", "//libexec/atf/atf-check:atf-check", "//bin/cat:cat", "//bin/rm:rm", "//usr.bin/dirname:dirname", "//usr.bin/basename:basename", "//usr.bin/grep:grep", "//usr.bin/sed:sed", "//usr.bin/diff:diff"],
    runtime_lib = ["//lib/libutil:util_shared", "//lib/libc:c_shared", "//lib/libsys:sys_shared", "//lib/atf/libatf-c:atf_c_shared", "//lib/atf/libatf-c++:atf_cxx_shared", "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared", "//lib/libedit:edit_shared", "//lib/ncurses/tinfo:tinfo_shared", "@bsd_sdk//toolchain:sysroot/lib/libgcc_s.so.1", "//lib/libregex:regex_shared"],
    runner = "//tools/build/bazel:atf_runner",
    size = "small",
) for case in ["installed_metadata", "denied_install", "failed_inputs"]]
