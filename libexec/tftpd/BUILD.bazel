load("//tools/build/bazel:bsd_nis.bzl", "nis_runtime_deps", "nis_runtime_linkopts")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load(":sources.bzl", "TFTP_SOURCES")
exports_files([n.split(":")[1] for n in TFTP_SOURCES], visibility = ["//usr.bin/tftp:__pkg__"])
cc_library(name = "headers", hdrs = ["tftp-file.h", "tftp-io.h", "tftp-options.h", "tftp-transfer.h", "tftp-utils.h"],
    strip_include_prefix = ".", visibility = ["//usr.bin/tftp:__pkg__"])
cc_binary(name = "tftpd", srcs = ["tftpd.c"] + TFTP_SOURCES,
    deps = [":headers"] + select({"//tools/build/bazel/config:tcp_wrappers_enabled": ["//lib/libwrap:wrap"], "//conditions:default": []}) + nis_runtime_deps(),
    dynamic_deps = select({"//tools/build/bazel/config:tcp_wrappers_enabled": ["//lib/libwrap:wrap_shared"], "//conditions:default": []}),
    local_defines = select({"//tools/build/bazel/config:tcp_wrappers_enabled": ["LIBWRAP"], "//conditions:default": []}),
    copts = ["-fPIE"], linkopts = ["-pie"] + nis_runtime_linkopts(),
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "tftpd", manual = "tftpd.8", man_section = "8", package = "utilities", bindir = "/usr/libexec")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//libexec:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/libexec"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

bsd_install_archive(
    name = "test_install_archive",
    visibility = ["//libexec:__pkg__"],
    manifests = ["//libexec/tftpd/tests:install_program", "//libexec/tftpd/tests:install_metadata"],
    directories = {'/usr/tests/libexec/tftpd': '{"owner": "root", "group": "wheel", "mode": "0755", "tags": ["package=tests"]}', '/usr/lib/debug/usr': '{"owner": "root", "group": "wheel", "mode": "0755", "tags": ["package=tests", "dbg"]}', '/usr/lib/debug/usr/tests': '{"owner": "root", "group": "wheel", "mode": "0755", "tags": ["package=tests", "dbg"]}', '/usr/lib/debug/usr/tests/libexec': '{"owner": "root", "group": "wheel", "mode": "0755", "tags": ["package=tests", "dbg"]}', '/usr/lib/debug/usr/tests/libexec/tftpd': '{"owner": "root", "group": "wheel", "mode": "0755", "tags": ["package=tests", "dbg"]}'},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.tests.dist": "/usr/tests",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
