load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_kyua.bzl", "bsd_kyua_test")

# ATF-C remains a declared SDK bootstrap library until its native migration.
cc_binary(
    name = "libdiff_test",
    srcs = ["libdiff_test.c"],
    deps = ["//lib/libdiff:diff"],
    linkstatic = True,
    linkopts = ["-Wl,-Bstatic", "-lprivateatf-c", "-Wl,-Bdynamic"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
)
bsd_kyua_test(
    name = "libdiff",
    program = ":libdiff_test",
    interface = "atf",
    kyua = "@bsd_sdk//toolchain:extra_kyua",
    runtime = ["@bsd_sdk//toolchain:extra_kyua_runtime"],
    clean_environment = True,
)

load("//tools/build/bazel:bsd_install.bzl", "bsd_kyuafile", "bsd_install_file", "bsd_install_manifest")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

bsd_kyuafile(
    name = "installed_kyuafile",
    suite = "FreeBSD",
    names = ["libdiff_test"],
    interfaces = {"libdiff_test": "atf"},
)
bsd_install_file(
    name = "kyuafile_install",
    src = ":installed_kyuafile",
    destination = "/usr/tests/lib/libdiff/Kyuafile",
    owner = "root",
    group = "wheel",
    mode = "0444",
    install_tags = ["package=tests"],
)
bsd_install_manifest(name = "kyuafile_manifest", entries = [":kyuafile_install"])
utility_installation(
    name = "install_manifest",
    program = "libdiff_test",
    manual = None,
    package = "tests",
    bindir = "/usr/tests/lib/libdiff",
)
# Explicit component directories supplement the maintained mtree inventory.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest", ":kyuafile_manifest"],
    directories = {
        "/usr/lib/debug/usr": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests","dbg"]}',
        "/usr/lib/debug/usr/tests": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests","dbg"]}',
        "/usr/lib/debug/usr/tests/lib": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests","dbg"]}',
        "/usr/lib/debug/usr/tests/lib/libdiff": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests","dbg"]}',
    },
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
        "//etc/mtree:BSD.tests.dist": "/usr/tests",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
    visibility = ["//visibility:public"],
)
