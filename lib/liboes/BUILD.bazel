load("//tools/build/bazel:bsd_fidl.bzl", "bsd_fidl_ir", "bsd_fidl_bindings")
exports_files(["oes_broker.fidl"])
bsd_fidl_ir(name = "oes_ir", schemas = ["//lib/libfidl/tests:zx.fidl", "oes_broker.fidl"], available = "bsd:1",
    compiler = "//tools/build/fuchsia/fidlc:fidlc",
    runtime_libraries = ["//lib/libmd:md_shared", "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared",
        "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7", "@bsd_sdk//toolchain:sysroot/lib/libgcc_s.so.1"])
bsd_fidl_bindings(name = "oes_bindings", ir = ":oes_ir",
    generator = "//tools/build/fuchsia:fidlgen-build.py", modules = ["//tools/build/fuchsia:binding_modules"],
    templates = ["@fuchsia_runtime_src//:binding_templates"],
    sources = ["fidl/bsd.oes.v1/" + name for name in ["cpp/natural_types.cc", "cpp/common_types.cc", "c/bsd.cc"]],
    headers = ["fidl/bsd.oes.v1/" + name for name in ["cpp/markers.h", "cpp/common_types.h", "cpp/natural_types.h", "cpp/bsd.h", "c/bsd.h", "c/bridge.h"]],
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib"])

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_import")
filegroup(name = "binding_sources", srcs = [":oes_bindings"], output_group = "sources")
filegroup(name = "binding_headers", srcs = [":oes_bindings"], output_group = "headers")
cc_library(name = "generated_headers", hdrs = [":binding_headers"], strip_include_prefix = "oes_bindings", visibility = ["//lib/liboes/tests:__pkg__", "//usr.sbin/BSDFilesystem:__pkg__", "//usr.sbin/BSDFilesystem/tests:__pkg__"])
# Make builds ordinary non-PIC static objects; shared linkage uses the PIC variant.
# cc_shared_library consumes the separately compiled PIC variant.
cc_library(name = "generated_bindings", srcs = [":binding_sources"],
    deps = [":generated_headers", "//lib/libfidl:headers", "//contrib/llvm-project/libcxx/include:headers"], copts = ["-std=c++20", "-nostdinc++"], linkstatic = True, visibility = ["//lib/liboes/tests:__pkg__", "//usr.sbin/BSDFilesystem/tests:__pkg__"])

load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_header", "bsd_dtrace_cc_objects")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
_SECTION_TRACE = "//tools/build/bazel/config:experimental_dtrace_section_archives_enabled"
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "headers", hdrs = ["liboes.h"], deps = ["//sys/security/oes:headers"], strip_include_prefix = ".", visibility = ["//visibility:public"])
bsd_dtrace_header(name = "provider", source = "diagnostics_provider.d", output = "diagnostics_provider.h",
    flags = ["-C", "-x", "nolibs"], static_anchor = False, object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:bootstrap", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti",
    runtime_libraries = ["//cddl/usr.sbin/dtrace:bootstrap_runtime"],
    tool_inputs = [ "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"])
cc_library(name = "provider_headers", hdrs = [":provider"], strip_include_prefix = ".")
cc_library(name = "objects", srcs = ["liboes.c", "broker.c", "oes_broker_protocol.h", "diagnostics.h"], deps = [":headers", ":generated_headers", "//lib/libservice:headers", "//lib/libfidl:headers"] + select({_TRACE: [":provider_headers"], "//conditions:default": []}), local_defines = select({_TRACE: ["WITH_DTRACE"], "//conditions:default": []}), linkstatic = True, target_compatible_with = _PLATFORM)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider",
    provider_object = "diagnostics_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner",
    archive_members = True, archive_runner = "//tools/build/bazel:dtrace_archive_member")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group)
 for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider",
               "regular_archive_objects", "pic_archive_objects"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"], deps = [":provider_link"])
cc_import(name = "section_traced", objects = [":regular_archive_objects"],
    pic_objects = [":pic_archive_objects"])
cc_library(name = "oes", deps = select({_SECTION_TRACE: [":section_traced"], _TRACE: [":traced"], "//conditions:default": [":objects"]}) + [":headers", ":generated_bindings", "//lib/libservice:service", "//lib/libfidl:fidl", "//lib/libc++:cxx", "//lib/libcxxrt:cxxrt"], linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = select({_SECTION_TRACE: [":section_traced"], _TRACE: [":traced", ":provider_link"], "//conditions:default": [":objects"]}) + [":generated_bindings"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_shared_library(name = "oes_shared", deps = [":oes"],
    dynamic_deps = ["//lib/libservice:service_shared", "//lib/libfidl:fidl_shared", "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared"],
    shared_lib_name = "liboes.so.1", user_link_flags = ["-Wl,-soname,liboes.so.1", "-Wl,--fatal-warnings,--warn-shared-textrel"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Library-only payload; maintained test installation is added separately.
bsd_install_archive(
    name = "library_install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=oes"]}' for d in ["/usr/share/licenses/liboes", "/usr/share/licenses/liboes/fuchsia"]} | {"/usr/share/fidl": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=oes"]}'} | {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=oes","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)





cc_library(name = "test_source_headers", hdrs = ["diagnostics.h", "oes_broker_protocol.h"], textual_hdrs = ["liboes.c", "broker.c"],
    deps = [":headers", ":generated_headers", "//lib/libservice:headers", "//lib/libfidl:headers"], strip_include_prefix = ".",
    visibility = ["//lib/liboes/tests:__pkg__"])

load("//lib/liboes/tests:installation.bzl", TEST_MANIFESTS = "MANIFESTS", TEST_DIRECTORIES = "DIRECTORIES")
bsd_install_archive(
    name = "install_archive",
    visibility = ["//lib:__pkg__"],
    manifests = [":install_manifest"] + select({"//tools/build/bazel/config:tests_enabled": TEST_MANIFESTS, "//conditions:default": []}),
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=oes"]}' for d in ["/usr/share/licenses/liboes", "/usr/share/licenses/liboes/fuchsia"]} | {"/usr/share/fidl": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=oes"]}'} | {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=oes","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]} | select({"//tools/build/bazel/config:tests_enabled": TEST_DIRECTORIES, "//conditions:default": {}}),
    mtree_specs = {
        "//etc/mtree:BSD.tests.dist": "/usr/tests",
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

cc_library(name = "broker_protocol_headers", hdrs = ["oes_broker_protocol.h"], deps = [":headers", ":generated_headers", "//lib/libfidl:headers"], strip_include_prefix = ".", visibility = ["//usr.sbin/BSDFilesystem:__pkg__", "//usr.sbin/BSDFilesystem/tests:__pkg__"])
