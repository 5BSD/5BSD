# SPDX-License-Identifier: BSD-2-Clause
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive_set")
exports_files(["production.bzl"])
exports_files(["service-tests.bzl"], visibility = ["//lib/libcasper:__subpackages__"])
_PRODUCTION = [
    "//lib/libcasper/libcasper:production_install_archive",
    "//lib/libcasper/services:production_installation_archives",
]
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
bsd_install_archive_set(name = "production_installation_archives", archives = _PRODUCTION,
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
# The original complete test contribution is composed separately from production.
bsd_install_archive_set(name = "installation_archives", archives = [
    "//lib/libcasper/libcasper:production_install_archive", "//lib/libcasper/services:installation_archives",
] + select({"//tools/build/bazel/config:tests_enabled": ["//lib/libcasper/tests:install_archive"], "//conditions:default": []}),
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
