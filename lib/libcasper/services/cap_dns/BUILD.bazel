load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_spec", "bsd_dtrace_cc_objects")

cc_library(
    name = "headers",
    hdrs = ["cap_dns.h"],
    strip_include_prefix = "/lib/libcasper/services/cap_dns",
    include_prefix = "casper",
    deps = ["//lib/libcasper/libcasper:headers"],
    visibility = ["//visibility:public"],
)
cc_library(
    name = "objects",
    srcs = ["cap_dns.c", "cap_dns_probes.h"],
    deps = [":headers", "//lib/libnv:nv", "//lib/libcasper/libcasper:headers"],
    local_defines = ["WITH_CASPER"] + select({
        "//tools/build/bazel/config:dtrace_enabled": ["WITH_DTRACE"],
        "//conditions:default": [],
    }),
    target_compatible_with = ["@platforms//os:freebsd"],
)
bsd_dtrace_spec(
    name = "provider",
    source = "cap_dns_provider.d",
    output = "cap_dns_provider.o",
    flags = ["-C", "-x", "nolibs"],
    object_path_mode = "relative",
    dtrace = "@bsd_sdk//toolchain:extra_dtrace",
    cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld",
    objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//tools/build/bazel:dtrace_runtime_object",
    tool_inputs = ["@bsd_sdk//toolchain:extra_dtrace_runtime", "@bsd_sdk//toolchain:compile_inputs",
                   "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"],
)
bsd_dtrace_cc_objects(
    name = "traced_objects",
    library = ":objects",
    provider = ":provider",
    provider_object = "cap_dns_provider",
    copy_runner = "//tools/build/bazel:dtrace_copy_runner",
)
filegroup(name = "regular_objects", srcs = [":traced_objects"], output_group = "regular_objects")
filegroup(name = "pic_objects", srcs = [":traced_objects"], output_group = "pic_objects")
filegroup(name = "regular_provider", srcs = [":traced_objects"], output_group = "regular_provider")
filegroup(name = "pic_provider", srcs = [":traced_objects"], output_group = "pic_provider")
# Registration constructors must survive static archive selection. Keep only
# the provider always-linked; ordinary library objects remain demand-linked.
cc_import(
    name = "provider_link",
    objects = [":regular_provider"],
    pic_objects = [":pic_provider"],
    alwayslink = True,
)
cc_import(
    name = "traced_library",
    objects = [":regular_objects"],
    pic_objects = [":pic_objects"],
    deps = [":headers", ":provider_link", "//lib/libnv:nv"],
    target_compatible_with = ["@platforms//os:freebsd"],
    visibility = ["//visibility:public"],
)
alias(
    name = "cap_dns",
    actual = select({
        "//tools/build/bazel/config:dtrace_enabled": ":traced_library",
        "//conditions:default": ":objects",
    }),
    visibility = ["//visibility:public"],
)
cc_shared_library(
    name = "cap_dns_shared",
    deps = [":cap_dns"],
    dynamic_deps = ["//lib/libnv:nv_shared"],
    shared_lib_name = "libcap_dns.so.2",
    user_link_flags = ["-Wl,-soname,libcap_dns.so.2", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = ["@platforms//os:freebsd"],
    visibility = ["//visibility:public"],
)

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    # src.opts.mk declares CASPER required; reject unsupported profiles.
    target_compatible_with = select({"//tools/build/bazel/config:casper_enabled": [], "//conditions:default": ["@platforms//:incompatible"]}),
    manifests = [":install_manifest"] + select({"//tools/build/bazel/config:tests_enabled": ["//lib/libcasper/services/cap_dns/tests:install_manifest"], "//conditions:default": []}),
    directories = select({"//tools/build/bazel/config:tests_enabled": {'/usr/lib/debug/lib': '{"owner": "root", "group": "wheel", "mode": "0755", "tags": ["package=libcasper", "dbg"]}', '/usr/tests/lib/libcasper/services/cap_dns': '{"owner": "root", "group": "wheel", "mode": "0755", "tags": ["package=tests"]}', '/usr/lib/debug/usr': '{"owner": "root", "group": "wheel", "mode": "0755", "tags": ["package=tests", "dbg"]}', '/usr/lib/debug/usr/tests': '{"owner": "root", "group": "wheel", "mode": "0755", "tags": ["package=tests", "dbg"]}', '/usr/lib/debug/usr/tests/lib': '{"owner": "root", "group": "wheel", "mode": "0755", "tags": ["package=tests", "dbg"]}', '/usr/lib/debug/usr/tests/lib/libcasper': '{"owner": "root", "group": "wheel", "mode": "0755", "tags": ["package=tests", "dbg"]}', '/usr/lib/debug/usr/tests/lib/libcasper/services': '{"owner": "root", "group": "wheel", "mode": "0755", "tags": ["package=tests", "dbg"]}', '/usr/lib/debug/usr/tests/lib/libcasper/services/cap_dns': '{"owner": "root", "group": "wheel", "mode": "0755", "tags": ["package=tests", "dbg"]}'}, "//conditions:default": {'/usr/lib/debug/lib': '{"owner": "root", "group": "wheel", "mode": "0755", "tags": ["package=libcasper", "dbg"]}'}}),
    mtree_specs = {
        "//etc/mtree:BSD.tests.dist": "/usr/tests",
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

load("//lib/libcasper:production.bzl", "casper_production_archive")
casper_production_archive(name = "production_install_archive")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive_set")
bsd_install_archive_set(name = "installation_archives", archives = [":production_install_archive"] + select({"//tools/build/bazel/config:tests_enabled": ["//lib/libcasper/services/cap_dns/tests:installation_archives"], "//conditions:default": []}), visibility = ["//visibility:public"])
