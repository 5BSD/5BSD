load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_import")
load("//tools/build/bazel:bsd_link_sequence.bzl", "bsd_link_sequence")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive_set")
load("//tools/build/bazel:bsd_test_installation.bzl", "bsd_test_install_archive")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//lib/libc:test_policy.bzl", "libc_test_copts")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"] + select({
    "//tools/build/bazel/config:casper_enabled": [], "//conditions:default": ["@platforms//:incompatible"],
})
_DIRECTORY = "/usr/tests/lib/libcasper/services/cap_fileargs"

# src.opts.mk requires CASPER. An unsupported disabled profile is rejected,
# rather than silently running these authority checks against unrestricted stubs.
cc_import(name = "atf_interface", shared_library = "//lib/atf/libatf-c:atf_c_shared", deps = ["//contrib/atf:c_headers"])
cc_import(name = "casper_interface", shared_library = "//lib/libcasper/libcasper:casper_shared", deps = ["//lib/libcasper/libcasper:headers"])
cc_import(name = "fileargs_interface", shared_library = "//lib/libcasper/services/cap_fileargs:cap_fileargs_shared", deps = ["//lib/libcasper/services/cap_fileargs:headers"])
cc_import(name = "nv_interface", shared_library = "//lib/libnv:nv_shared", deps = ["//sys/sys:nv_headers"])
bsd_link_sequence(name = "fileargs_link", deps = [":atf_interface", ":casper_interface", ":fileargs_interface", ":nv_interface", "//tests:suite_macros", "//lib/libc:shared_abi_interface"])
cc_binary(name = "fileargs_test", srcs = ["fileargs_test.c"], deps = [":fileargs_link"],
    copts = libc_test_copts(3), defines = ["PIC", "WITH_CASPER"],
    linkopts = ["-pie", "-nodefaultlibs"], target_compatible_with = _PLATFORM)
utility_installation(name = "fileargs_test_install", program = "fileargs_test", manual = None, package = "tests", bindir = _DIRECTORY)
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["fileargs_test"], interfaces = {"fileargs_test": "atf"})
bsd_install_file(name = "kyuafile_entry", src = ":kyuafile", destination = _DIRECTORY + "/Kyuafile",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=tests"])
bsd_install_manifest(name = "install_manifest", manifests = [":fileargs_test_install"], entries = [":kyuafile_entry"], visibility = ["//visibility:public"])
bsd_test_install_archive(name = "install_archive", directory = _DIRECTORY, manifests = [":install_manifest"], debug = True)
bsd_install_archive_set(name = "installation_archives", archives = [":install_archive"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
_CASES = ['fileargs__open_create',
 'fileargs__open_read',
 'fileargs__open_write',
 'fileargs__open_with_casper',
 'fileargs__fopen_create',
 'fileargs__fopen_read',
 'fileargs__fopen_write',
 'fileargs__lstat',
 'fileargs__realpath',
 'fileargs__open_lstat',
 'fileargs__open_realpath']
_RUNTIME = ["//lib/libc:c_shared", "//lib/libsys:sys_shared", "//lib/atf/libatf-c:atf_c_shared", "//lib/libnv:nv_shared", "//lib/libcasper/libcasper:casper_shared", "//lib/libcasper/services/cap_fileargs:cap_fileargs_shared"]
[bsd_atf_test(name = case + "_runtime", body = ":fileargs_test_install_stripped", case_name = case, interface = "program",
    runtime_lib = _RUNTIME, cleanup = True, body_timeout_seconds = 300, cleanup_timeout_seconds = 300,
    runner = "//tools/build/bazel:atf_runner", test_environment = {"DTRACE_DOF_INIT_DISABLE": "1"},
    tags = ["external", "no-remote"], target_compatible_with = _PLATFORM, size = "small", timeout = "long")
 for case in _CASES]
test_suite(name = "runtime_tests", tests = [":" + case + "_runtime" for case in _CASES])
