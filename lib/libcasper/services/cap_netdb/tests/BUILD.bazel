# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
# Maintained ATF program; installed runtime requirements remain in its metadata.
cc_binary(name = "netdb_test", srcs = ["netdb_test.c"],
    deps = ["//lib/libcasper/libcasper:casper", "//lib/libcasper/services/cap_netdb:cap_netdb", "//lib/libnv:nv", "//lib/atf/libatf-c:atf_c"],
    dynamic_deps = ["//lib/libcasper/libcasper:casper_shared", "//lib/libcasper/services/cap_netdb:cap_netdb_shared", "//lib/libnv:nv_shared", "//lib/atf/libatf-c:atf_c_shared"],
    local_defines = ["WITH_CASPER"], copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd"],
    visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_kyuafile")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["netdb_test"], interfaces = {"netdb_test": "atf"})
bsd_install_file(name = "install_kyuafile", src = ":kyuafile",
    destination = "/usr/tests/lib/libcasper/services/cap_netdb/Kyuafile", owner = "root", group = "wheel",
    mode = "0444", install_tags = ["package=tests"])
utility_installation(name = "install_manifest", program = "netdb_test", manual = None,
    package = "tests", bindir = "/usr/tests/lib/libcasper/services/cap_netdb",
    extra_entries = [":install_kyuafile"])

load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
# libc reads the execution system's /etc/protocols; this is a system-runtime
# test, not a hermetic database fixture. No external network is required.
bsd_atf_test(name = "native_getprotobyname", case_name = "cap_netdb__getprotobyname",
    interface = "program", body = ":netdb_test",
    runtime_lib = ["//lib/libcasper/libcasper:casper_shared",
        "//lib/libcasper/services/cap_netdb:cap_netdb_shared", "//lib/libnv:nv_shared",
        "//lib/atf/libatf-c:atf_c_shared", "@bsd_sdk//toolchain:sysroot/lib/libc.so.7",
        "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"],
    runner = "//tools/build/bazel:atf_runner", size = "small")
test_suite(name = "tests", tests = [":native_getprotobyname"], visibility = ["//visibility:public"])
