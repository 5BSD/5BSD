load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive_set")
_SERVICES = ['cap_dns', 'cap_fileargs', 'cap_grp', 'cap_net', 'cap_netdb', 'cap_pwd', 'cap_sysctl', 'cap_syslog']
bsd_install_archive_set(name = "production_installation_archives",
    archives = ["//lib/libcasper/services/" + service + ":production_install_archive" for service in _SERVICES],
    visibility = ["//lib/libcasper:__pkg__"])
bsd_install_archive_set(name = "installation_archives",
    archives = ["//lib/libcasper/services/" + service + ":installation_archives" for service in _SERVICES] + select({
        "//tools/build/bazel/config:tests_enabled": ["//lib/libcasper/services/tests:install_archive"], "//conditions:default": [],
    }), visibility = ["//lib/libcasper:__pkg__"])
