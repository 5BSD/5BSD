load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load("//tools/build/bazel:configured_version_map.bzl", "bsd_configured_version_map")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "rt", srcs = ["aio.c", "mq.c", "sigev_thread.c", "timer.c", "sigev_thread.h"],
    implementation_deps = ["//lib/libc/include:rt_private_headers"],
    deps = ["//lib/libthr:thr"],
    copts = ["-fexceptions", "-Wall"],
    linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":rt"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_configured_version_map(
    name = "version_map",
    symbol_maps = ["Symbol.map"],
    versions = "//lib/libc:Versions.def",
    generator = "//share/mk:version_gen.awk",
    # This symbol inventory has no includes or target-dependent conditionals.
    cpp_flags = ["-P", "-nostdinc", "-undef"],
    compiler = "@bsd_sdk//toolchain:bin/clang",
    compiler_inputs = "@bsd_sdk//toolchain:compile_inputs",
    cat = "@bsd_sdk//toolchain:cat",
    cat_runtime = "@bsd_sdk//toolchain:cat_runtime",
    awk = "@bsd_sdk//toolchain:awk",
    awk_runtime = "@bsd_sdk//toolchain:awk_runtime",
    redirect = "@bsd_sdk//toolchain:stdout_redirect",
)

cc_shared_library(name = "rt_shared", deps = [":rt"], shared_lib_name = "librt.so.1",
    dynamic_deps = ["//lib/libthr:thr_shared"],
    additional_linker_inputs = [":version_map"],
    user_link_flags = ["-Wl,-soname,librt.so.1", "-Wl,--version-script=$(location :version_map),--no-undefined-version", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//lib:__pkg__"],
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)


load("@rules_cc//cc:defs.bzl", "cc_import", "cc_binary")
load("//tools/build/bazel:bsd_compare_test.bzl", "bsd_compare_test")
cc_import(name = "archive_link", static_library = ":static_archive", deps = ["//lib/libthr:thr"])
# "static" qualifies the librt archive, with shared native libthr as in Make's
# ordinary pthread linkage. Fully static libc/libthr qualification is separate.
[cc_binary(name = "timer_" + variant + "_program", srcs = ["timer_test.c"],
    deps = [":archive_link"] if variant == "static" else [":rt"],
    dynamic_deps = ["//lib/libthr:thr_shared"] + ([":rt_shared"] if variant == "shared" else []),
    linkstatic = variant == "static", target_compatible_with = _PLATFORM)
 for variant in ["static", "shared"]]
[bsd_compare_test(name = "timer_" + variant, program = ":timer_" + variant + "_program",
    expected = "timer_empty.out", expected_stderr = "timer_empty.out",
    runtime_lib = ["//lib/libthr:thr_shared", "@bsd_sdk//toolchain:sysroot/lib/libc.so.7",
                   "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"] + ([":rt_shared"] if variant == "shared" else []),
    runner = "//tools/build/bazel:byte_compare_runner", size = "small")
 for variant in ["static", "shared"]]

# Explicitly qualify a fully static executable separately from archive linkage.
cc_binary(name = "timer_fully_static_program", srcs = ["timer_test.c"],
    deps = [":archive_link"], linkstatic = True, features = ["fully_static_link"],
    target_compatible_with = _PLATFORM)
bsd_compare_test(name = "timer_fully_static", program = ":timer_fully_static_program",
    expected = "timer_empty.out", expected_stderr = "timer_empty.out",
    runner = "//tools/build/bazel:byte_compare_runner", size = "small")
