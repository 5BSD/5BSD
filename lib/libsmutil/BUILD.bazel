load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
_SOURCES = ['//contrib/sendmail:libsmutil/debug.c', '//contrib/sendmail:libsmutil/err.c', '//contrib/sendmail:libsmutil/lockfile.c', '//contrib/sendmail:libsmutil/safefile.c', '//contrib/sendmail:libsmutil/snprintf.c', '//contrib/sendmail:libsmutil/cf.c']
[cc_library(name = "smutil" + suffix, srcs = _SOURCES, deps = ["//lib/libsm:headers"],
    local_defines = ['NEWDB', 'NIS', 'MAP_REGEX', 'NOT_SENDMAIL'] + select({"//tools/build/bazel/config:openssl_enabled": ["STARTTLS"], "//conditions:default": []}),
    copts = ["-Wno-deprecated-non-prototype"] + (["-fpie"] if suffix else []),
    linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"]) for suffix in ["", "_pie"]]
# Internal archives: no installed package payload.
bsd_component_archive(name = "static_archive", groups = [":smutil"], visibility = ["//visibility:public"])
bsd_component_archive(name = "pie_archive", groups = [":smutil_pie"], visibility = ["//visibility:public"])
