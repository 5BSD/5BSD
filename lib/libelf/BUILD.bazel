load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load(":sources.bzl", "ELF_SOURCES")
load(":generate.bzl", "libelf_generate")
_GENERATED = ["libelf_convert", "libelf_fsize", "libelf_msize"]
[
    libelf_generate(name = name, output = name + ".c",
        template = "//contrib/elftoolchain:libelf/" + name + ".m4",
        types = "//contrib/elftoolchain:libelf/elf_types.m4",
        m4 = "@bsd_sdk//toolchain:extra_m4", redirect = "@bsd_sdk//toolchain:stdout_redirect",
        runtime = ["@bsd_sdk//toolchain:extra_m4_runtime"])
    for name in _GENERATED
]
cc_library(name = "elf", srcs = ELF_SOURCES + [":" + name for name in _GENERATED],
    deps = ["//contrib/elftoolchain:elf_headers"], implementation_deps = ["//contrib/elftoolchain:elf_internal_headers"],
    linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":elf"], visibility = ["//visibility:public"])
cc_shared_library(name = "elf_shared", deps = [":elf"], shared_lib_name = "libelf.so.2",
    additional_linker_inputs = ["//contrib/elftoolchain:libelf/Version.map"],
    user_link_flags = ["-Wl,-soname,libelf.so.2", "-Wl,--version-script=$(location //contrib/elftoolchain:libelf/Version.map)", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_import", "cc_test")
cc_import(name = "archive_link", static_library = ":static_archive")
cc_test(name = "roundtrip_static", srcs = ["roundtrip_test.c"],
    deps = [":archive_link", "//contrib/elftoolchain:elf_headers"], linkstatic = True, size = "small")
cc_test(name = "roundtrip_shared", srcs = ["roundtrip_test.c"],
    deps = [":elf"], dynamic_deps = [":elf_shared"], features = ["bsd_test_runtime_paths"], size = "small")

load(":installation.bzl", "elf_installation")
elf_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)