load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
cc_library(name = "config", hdrs = ["config.h"], strip_include_prefix = ".")
cc_library(name = "blocks", srcs = ["//contrib/llvm-project/compiler-rt/lib/BlocksRuntime:data.c", "//contrib/llvm-project/compiler-rt/lib/BlocksRuntime:runtime.c"],
    deps = [":config", "//contrib/llvm-project/compiler-rt/lib/BlocksRuntime:headers"], linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":blocks"], visibility = ["//visibility:public"])
cc_shared_library(name = "blocks_shared", deps = [":blocks"], shared_lib_name = "libBlocksRuntime.so.0",
    user_link_flags = ["-Wl,-soname,libBlocksRuntime.so.0", "-Wl,--fatal-warnings,--warn-shared-textrel"], visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//visibility:public"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libblocksruntime","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

load("@rules_cc//cc:defs.bzl", "cc_test")
[cc_test(
    name = "runtime_" + linkage,
    srcs = ["runtime_test.c"],
    copts = ["-fblocks"],
    deps = [":blocks"],
    dynamic_deps = [":blocks_shared"] if linkage == "shared" else [],
    features = ["bsd_test_runtime_paths"] if linkage == "shared" else [],
    linkstatic = True,
    size = "small",
) for linkage in ["static", "shared"]]
