# SPDX-License-Identifier: BSD-2-Clause
load("//tools/build/bazel:bsd_test_installation.bzl", "bsd_library_installation_archives")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_import", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_spec", "bsd_dtrace_cc_objects")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
_SECTION_TRACE = "//tools/build/bazel/config:experimental_dtrace_section_archives_enabled"
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "headers", hdrs = ["channel.h"], deps = ["//sys/sys:cap_authority_header"], strip_include_prefix = ".", visibility = ["//visibility:public"])
bsd_dtrace_spec(name = "provider", source = "channel_provider.d", output = "channel_provider.o",
    flags = ["-C", "-x", "nolibs"], static_anchor = False, object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:bootstrap", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti",
    runtime_libraries = ["//cddl/usr.sbin/dtrace:bootstrap_runtime"],
    tool_inputs = [ "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"])
cc_library(name = "objects", srcs = ["channel.c", "channel_call.c", "channel_syscall.c", "channel_internal.h", "channel_probes.h", "trace_pressure.h"], deps = [":headers"],
    implementation_deps = ["//sys/dev/mac_capability:ioctl_headers"],
    local_defines = select({_TRACE: ["WITH_DTRACE"], "//conditions:default": []}),
    linkstatic = True, target_compatible_with = _PLATFORM)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider",
    provider_object = "channel_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner",
    archive_members = True, archive_runner = "//tools/build/bazel:dtrace_archive_member")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group)
 for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider",
               "regular_archive_objects", "pic_archive_objects"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"], deps = [":provider_link"])
cc_import(name = "section_traced", objects = [":regular_archive_objects"],
    pic_objects = [":pic_archive_objects"])
cc_library(name = "channel", deps = [":headers"] + select({_SECTION_TRACE: [":section_traced"], _TRACE: [":traced"], "//conditions:default": [":objects"]}),
    linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = select({_SECTION_TRACE: [":section_traced"], _TRACE: [":traced", ":provider_link"], "//conditions:default": [":objects"]}),
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_shared_library(name = "channel_shared", deps = [":channel"], shared_lib_name = "libchannel.so.1",
    user_link_flags = ["-Wl,-soname,libchannel.so.1", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Library payload only; the maintained test installation is not yet migrated.
bsd_install_archive(
    name = "library_install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libchannel","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_library_installation_archives(
    name = "installation_archives", production_name = "install_archive", test_name = "tests_install_archive",
    production_manifests = [":install_manifest"],
    test_manifests = select({"//tools/build/bazel/config:tests_enabled": ["//lib/libchannel/tests:install_channel_test", "//lib/libchannel/tests:install_call_bench", "//lib/libchannel/tests:install_ipc_soak", "//lib/libchannel/tests:install_extra"], "//conditions:default": []}),
    production_directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libchannel","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    test_directories = select({"//tools/build/bazel/config:tests_enabled": {
        "/usr/tests/lib/libchannel": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libchannel-tests"]}',
        "/usr/lib/debug/usr": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libchannel-tests","dbg"]}',
        "/usr/lib/debug/usr/tests": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libchannel-tests","dbg"]}',
        "/usr/lib/debug/usr/tests/lib": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libchannel-tests","dbg"]}',
        "/usr/lib/debug/usr/tests/lib/libchannel": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libchannel-tests","dbg"]}',
    }, "//conditions:default": {}}),
    visibility = ["//lib:__pkg__"],
    mtree_specs = {
        "//etc/mtree:BSD.tests.dist": "/usr/tests",
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

filegroup(name = "package_abi", srcs = [":install_manifest_stripped"], visibility = ["//packages/libchannel:__pkg__"])
