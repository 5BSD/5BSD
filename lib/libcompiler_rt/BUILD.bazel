load("@rules_cc//cc:defs.bzl", "cc_library", "cc_import", "cc_test")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")

# Native Clang builtins with explicit per-architecture source/variant ownership.
# No product action evaluates Make or substitutes another architecture.
load(":sources.bzl", "AMD64_BUILTIN_SOURCES", "AARCH64_BUILTIN_SOURCES")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")

# Match the declared logical source identity used by Make's CRTSRC inputs,
# including overflow-abort diagnostics. This does not rewrite compiled objects.
_BUILTIN_COPTS = ["-fpic", "-fvisibility=hidden", "-fno-stack-protector"] + [
    "-ffile-prefix-map=" + prefix + "contrib/llvm-project/compiler-rt/lib/builtins/=/usr/src/contrib/llvm-project/compiler-rt/lib/builtins/"
    for prefix in ["", "./"]
]

_PLATFORM = ["@platforms//os:freebsd"] + select({
    "@platforms//cpu:x86_64": [],
    "@platforms//cpu:aarch64": [],
    "//conditions:default": ["@platforms//:incompatible"],
})


cc_library(name = "objects",
    srcs = select({
        "@platforms//cpu:x86_64": ["//contrib/llvm-project/compiler-rt/lib/builtins:" + n for n in AMD64_BUILTIN_SOURCES],
        "@platforms//cpu:aarch64": ["//contrib/llvm-project/compiler-rt/lib/builtins:" + n for n in AARCH64_BUILTIN_SOURCES],
        "//conditions:default": [],
    }),
    implementation_deps = ["//contrib/llvm-project/compiler-rt/lib/builtins:headers",
        "//contrib/llvm-project/libunwind/include:headers"],
    # compiler-rt is installed as a single static archive of position-independent
    # objects, including when linked into libsys/libc shared libraries.
    copts = _BUILTIN_COPTS,
    local_defines = ["VISIBILITY_HIDDEN", "COMPILER_RT_HAS_FLOAT16", "COMPILER_RT_HAS_BFLOAT16"],
    linkstatic = True,
    target_compatible_with = _PLATFORM,
)
# One compiler action per LSE specialization, with the original object identity.
_LSE = [(pattern, size, model) for pattern in ["cas", "swp", "ldadd", "ldclr", "ldeor", "ldset"]
        for size in [1, 2, 4, 8, 16] for model in [1, 2, 3, 4, 5]
        if pattern == "cas" or size != 16]
_LSE_NAMES = ["outline_atomic_" + pattern + str(size) + "_" + str(model)
              for pattern, size, model in _LSE]
[copy_file(name = name + "_source", src = "//contrib/llvm-project/compiler-rt/lib/builtins:aarch64/lse.S",
    out = name + ".S", allow_symlink = True) for name in _LSE_NAMES]
[cc_library(name = "outline_atomic_" + pattern + str(size) + "_" + str(model) + "_objects",
    srcs = [":outline_atomic_" + pattern + str(size) + "_" + str(model) + "_source"],
    implementation_deps = ["//contrib/llvm-project/compiler-rt/lib/builtins:headers"],
    copts = _BUILTIN_COPTS,
    local_defines = ["VISIBILITY_HIDDEN", "COMPILER_RT_HAS_FLOAT16", "COMPILER_RT_HAS_BFLOAT16",
        "L_" + pattern, "SIZE=" + str(size), "MODEL=" + str(model)],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:aarch64"])
 for pattern, size, model in _LSE]
bsd_component_archive(name = "static_archive", groups = [":objects"] + select({
    "@platforms//cpu:aarch64": [":" + name + "_objects" for name in _LSE_NAMES],
    "//conditions:default": [],
}), member_order = select({
    "@platforms//cpu:aarch64": [name.split("/")[-1].rsplit(".", 1)[0] + ".o" for name in AARCH64_BUILTIN_SOURCES] + [name + ".o" for name in _LSE_NAMES],
    "//conditions:default": [],
}), visibility = ["//visibility:public"])
# Preserve ordinary -fpic archive selection for all consumers, including DSOs.
# BSD links private hidden runtime builtins into each DSO that needs them.
# They are not exported from libsys for libc (or other DSOs) to reuse.
cc_import(name = "compiler_rt", static_library = ":static_archive",
    tags = ["LINKABLE_MORE_THAN_ONCE"], visibility = ["//visibility:public"])
cc_test(name = "builtins_test", srcs = ["//tools/build/bazel:tests/compiler_rt_runtime.c"],
    deps = [":compiler_rt"], linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], size = "small")

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_link", "bsd_install_manifest")
bsd_install_file(name = "archive_install", src = ":static_archive", destination = "/usr/lib/libcompiler_rt.a",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=libcompiler_rt", "dev"])
bsd_install_link(name = "gcc_compat_link", destination = "/usr/lib/libgcc.a", target = "libcompiler_rt.a",
    kind = "symlink", owner = "root", group = "wheel", mode = "0755", install_tags = ["package=libcompiler_rt", "dev"])
bsd_install_manifest(name = "install_manifest", entries = [":archive_install", ":gcc_compat_link"], visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"],

    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
    visibility = ["//visibility:public"])
