# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_test", "cc_library", "cc_binary")
load("//tools/build/bazel:bsd_secureboot_headers.bzl", "bsd_secureboot_headers")

bsd_secureboot_headers(
    name = "generated",
    policy = "headers-policy.json",
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib"],
)

cc_library(name = "headers", hdrs = [":generated"], strip_include_prefix = "generated")

cc_test(
    name = "headers_test",
    srcs = ["headers_test.c"],
    deps = [":headers"],
    linkstatic = True,
    size = "small",
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
)

# Public upstream BearSSL test root in PEM form; never a production default.
exports_files(["trust-policy.json", "bearssl-root.pem"], visibility = ["//visibility:public"])
cc_test(
    name = "trust_init_test",
    srcs = ["trust_init_test.c"],
    deps = ["//lib/libsecureboot:secureboot"],
    linkstatic = True,
    size = "small",
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
)

load("//tools/build/bazel:bsd_program_test.bzl", "bsd_program_test")
cc_binary(name = "trust_init_shared_program", srcs = ["trust_init_test.c"],
    deps = ["//lib/libsecureboot:secureboot"],
    dynamic_deps = ["//lib/libsecureboot:secureboot_shared", "//lib/libbearssl:bearssl_shared"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
bsd_program_test(name = "trust_init_shared_test", program = ":trust_init_shared_program",
    runner = "//tools/build/bazel:program_test_runner", size = "small",
    runtime_lib = ["//lib/libsecureboot:secureboot_shared", "//lib/libbearssl:bearssl_shared",
        "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"])

[cc_test(name = "selftest_" + mode, srcs = ["selftest_failure_test.c"],
    deps = ["//lib/libsecureboot:selftest_source", "//lib/libsecureboot:secureboot"],
    copts = ["-include", "secureboot_config.h"], args = [mode],
    linkstatic = True, size = "small",
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
    for mode in ["clean", "bad256", "bad384"]]
