load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_import", "cc_binary")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
cc_library(name = "bsm", srcs = ['//contrib/openbsm:libbsm/bsm_audit.c',
 '//contrib/openbsm:libbsm/bsm_class.c',
 '//contrib/openbsm:libbsm/bsm_control.c',
 '//contrib/openbsm:libbsm/bsm_domain.c',
 '//contrib/openbsm:libbsm/bsm_errno.c',
 '//contrib/openbsm:libbsm/bsm_event.c',
 '//contrib/openbsm:libbsm/bsm_fcntl.c',
 '//contrib/openbsm:libbsm/bsm_flags.c',
 '//contrib/openbsm:libbsm/bsm_io.c',
 '//contrib/openbsm:libbsm/bsm_mask.c',
 '//contrib/openbsm:libbsm/bsm_notify.c',
 '//contrib/openbsm:libbsm/bsm_socket_type.c',
 '//contrib/openbsm:libbsm/bsm_token.c',
 '//contrib/openbsm:libbsm/bsm_user.c',
 '//contrib/openbsm:libbsm/bsm_wrappers.c'], deps = ["//contrib/openbsm:headers"], linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":bsm"], visibility = ["//visibility:public"])
cc_shared_library(name = "bsm_shared", deps = [":bsm"], shared_lib_name = "libbsm.so.3", user_link_flags = ["-Wl,-z,defs", "-Wl,-soname,libbsm.so.3"], visibility = ["//visibility:public"])
cc_import(name = "archive_link", static_library = ":static_archive")
# Vendor format fixture generator, not an installed system program.
cc_binary(name = "token_generator", srcs = ["//contrib/openbsm:test/bsm/generate.c"], deps = [":archive_link", "//contrib/openbsm:headers"], copts = ["-UNDEBUG"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=audit","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
