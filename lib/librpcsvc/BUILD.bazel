load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//include/rpcsvc:protocols.bzl", "RPCSVC_PROTOCOLS")
load("//tools/build/bazel:bsd_rpcgen.bzl", "bsd_rpcgen")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
[bsd_rpcgen(name = n + "_generate", source = "//include/rpcsvc:" + n + ".x",
    output = n + "_xdr.c", mode = "-c", flags = ["-C"],
    cpp_flags = ["-E", "-x", "c", "-nostdinc"],
    rpcgen = "//usr.bin/rpcgen:rpcgen", cpp = "@bsd_sdk//toolchain:bin/cpp",
    compiler_inputs = "@bsd_sdk//toolchain:compile_inputs", runtime = ["@bsd_sdk//toolchain:cpp_runtime"])
 for n in RPCSVC_PROTOCOLS]
[cc_library(
    name = "rpcsvc" + suffix,
    srcs = [":" + n + "_xdr.c" for n in RPCSVC_PROTOCOLS] +
        ["secretkey.c", "xcrypt.c", "rnusers.c", "rstat.c", "rwall.c"] +
        select({"//tools/build/bazel/config:nis_enabled": ["yp_passwd.c", "yp_update.c"], "//conditions:default": []}),
    deps = ["//lib/libc:shared_link_objects"],
    implementation_deps = ["//include/rpcsvc:library_protocol_headers", "//include/rpcsvc:library_local_headers"],
    local_defines = ["YP"],
    copts = flags,
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
) for suffix, flags in [("", []), ("_pie", ["-fPIE", "-DPIC"])]]
bsd_component_archive(name = "static_archive", groups = [":rpcsvc"], visibility = ["//visibility:public"])
bsd_component_archive(name = "pie_archive", groups = [":rpcsvc_pie"], visibility = ["//visibility:public"])

cc_shared_library(name = "rpcsvc_shared", deps = [":rpcsvc"],
    dynamic_deps = ["//lib/libc:c_shared"], shared_lib_name = "librpcsvc.so.5",
    user_link_flags = ["-nodefaultlibs", "-Wl,-z,defs", "-Wl,-soname,librpcsvc.so.5", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
