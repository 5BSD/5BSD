load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load("//tools/build/bazel:bsd_install.bzl", "bsd_compress", "bsd_install_file", "bsd_install_manifest")
cc_library(name = "headers", hdrs = ["libutil++.hh"], strip_include_prefix = ".",
    deps = ["//lib/libutil:headers", "//contrib/llvm-project/libcxx/include:headers"], visibility = ["//visibility:public"])
cc_library(name = "utilpp", srcs = ["stringf.cc"], deps = [":headers", "//lib/libc++:cxx"],
    copts = ["-std=gnu++17", "-nostdinc++"], linkstatic = True, visibility = ["//visibility:public"])
cc_library(name = "utilpp_pie", srcs = ["stringf.cc"], deps = [":headers", "//lib/libc++:cxx"],
    copts = ["-std=gnu++17", "-nostdinc++", "-fpie"], linkstatic = True, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":utilpp"], visibility = ["//visibility:public"])
bsd_component_archive(name = "pie_archive", groups = [":utilpp_pie"], visibility = ["//visibility:public"])
# INTERNALLIB archives/headers are not installed. Make still installs the manuals.
_MANUALS = ["FILE_up", "addrinfo_up", "fd_up", "malloc_up", "nvlist_up", "pidfile", "stringf"]
_MAN_TAGS = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=utilities-man"], "//conditions:default": ["package=utilities-dev"]})
[bsd_compress(name = "manual_" + page, src = "freebsd__" + page + ".3", output = "manuals/freebsd__" + page + ".3.gz",
    arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect",
    runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"]) for page in _MANUALS]
[bsd_install_file(manual = True, name = "install_" + page, src = ":manual_" + page,
    destination = "/usr/share/man/man3/freebsd::" + page + ".3.gz", owner = "root", group = "wheel", mode = "0444", install_tags = _MAN_TAGS) for page in _MANUALS]
bsd_install_manifest(name = "install_manifest", entries = [":install_" + page for page in _MANUALS])

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"] + select({"//tools/build/bazel/config:tests_enabled": ["//lib/libutil++/tests:install_manifest"], "//conditions:default": []}),
    directories = select({"//tools/build/bazel/config:tests_enabled": {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/tests", "/usr/lib/debug/usr/tests/lib", "/usr/lib/debug/usr/tests/lib/libutil++"]} | {"/usr/tests/lib/libutil++": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests"]}'}, "//conditions:default": {}}),
    mtree_specs = {"//etc/mtree:BSD.tests.dist": "/usr/tests", "//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.include.dist": "/usr/include", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
