load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_import")
load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
cc_import(name = "sdk_unwind", shared_library = "@bsd_sdk//toolchain:sysroot/lib/libgcc_s.so.1")
_CASES = {"stringf": ["basic", "va_list"], "up": ["FILE_up"], "pidfile": ["basic"]}
_SHARED = ["//lib/atf/libatf-c++:atf_cxx_shared", "//lib/atf/libatf-c:atf_c_shared",
    "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared",
    "//lib/libc:c_shared", "//lib/libsys:sys_shared"]
[cc_binary(name = program + "_test", srcs = [program + "_test.cc"],
    deps = ["//lib/libutil++:utilpp_pie", "//lib/atf/libatf-c++:atf_cxx", "//lib/libc:shared_link_interface", ":sdk_unwind"] + (["//lib/libutil:util"] if program == "pidfile" else []),
    dynamic_deps = _SHARED + (["//lib/libutil:util_shared"] if program == "pidfile" else []),
    copts = ["-std=gnu++17", "-nostdinc++", "-fPIE"], linkopts = ["-pie", "-nodefaultlibs"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
 for program in _CASES]
[bsd_atf_test(name = program + "_" + case, body = ":" + program + "_test", case_name = case,
    interface = "program", runtime_lib = _SHARED + ["@bsd_sdk//toolchain:sysroot/lib/libgcc_s.so.1"] + (["//lib/libutil:util_shared"] if program == "pidfile" else []),
    runner = "//tools/build/bazel:atf_runner", size = "small")
 for program, cases in _CASES.items() for case in cases]
test_suite(name = "tests", tests = [":" + program + "_" + case for program, cases in _CASES.items() for case in cases], visibility = ["//visibility:public"])
