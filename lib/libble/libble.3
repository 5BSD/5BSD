.Dd June 27, 2026
.Dt LIBBLE 3
.Os
.Sh NAME
.Nm libble ,
.Nm ble_open ,
.Nm ble_close ,
.Nm ble_scan ,
.Nm ble_connect ,
.Nm ble_discover ,
.Nm ble_read ,
.Nm ble_write ,
.Nm ble_subscribe
.Nd BLE client library for the blued daemon
.Sh LIBRARY
.Lb libble
.Sh SYNOPSIS
.In ble.h
.Ft ble_ctx_t *
.Fn ble_open "const char *sock_path"
.Ft void
.Fn ble_close "ble_ctx_t *ctx"
.Ft int
.Fn ble_fd "ble_ctx_t *ctx"
.Ft int
.Fn ble_process "ble_ctx_t *ctx"
.Ft int
.Fn ble_scan "ble_ctx_t *ctx" "ble_scan_cb cb" "void *arg"
.Ft int
.Fn ble_connect "ble_ctx_t *ctx" "const ble_addr_t *addr" "ble_connect_cb cb" "void *arg"
.Ft int
.Fn ble_disconnect "ble_ctx_t *ctx" "const ble_addr_t *addr"
.Ft int
.Fn ble_discover "ble_ctx_t *ctx" "const ble_addr_t *addr" "ble_discover_cb cb" "void *arg"
.Ft int
.Fn ble_read "ble_ctx_t *ctx" "const ble_addr_t *addr" "uint16_t handle" "ble_read_cb cb" "void *arg"
.Ft int
.Fn ble_write "ble_ctx_t *ctx" "const ble_addr_t *addr" "uint16_t handle" "const uint8_t *value" "uint16_t len"
.Ft int
.Fn ble_subscribe "ble_ctx_t *ctx" "const ble_addr_t *addr" "uint16_t handle" "ble_notify_cb cb" "void *arg"
.Ft int
.Fn ble_add_service "ble_ctx_t *ctx" "const ble_uuid_t *uuid" "uint16_t *out_handle"
