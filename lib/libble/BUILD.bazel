load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
cc_library(name = "headers", hdrs = ["ble.h"], strip_include_prefix = ".", visibility = ["//visibility:public"])
# These daemon protocol contracts are build inputs, not installed public headers.
cc_library(name = "ble", srcs = ["ble.c", "blued_plane.h", "ipc_proto.h"],
    deps = [":headers", "//lib/libbluetooth:bluetooth", "//lib/libservice:service"],
    linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":ble"], visibility = ["//visibility:public"])
cc_shared_library(name = "ble_shared", deps = [":ble"],
    dynamic_deps = ["//lib/libbluetooth:bluetooth_shared", "//lib/libservice:service_shared"],
    shared_lib_name = "libble.so.1", user_link_flags = ["-Wl,-soname,libble.so.1", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bluetooth","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

cc_library(name = "mesh_protocol_headers", hdrs = ["ipc_proto.h"], strip_include_prefix = ".", visibility = ["//usr.sbin/bluetooth/meshd:__pkg__"])
