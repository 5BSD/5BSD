# SPDX-License-Identifier: BSD-2-Clause
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive_set")
_PRODUCTION = ["//lib/atf/libatf-c:install_archive", "//lib/atf/libatf-c++:install_archive"]
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
bsd_install_archive_set(name = "production_installation_archives", archives = _PRODUCTION,
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
# Original MK_TESTS traversal: each library test subtree and tests/test-programs.
_TESTS = ["//lib/atf/libatf-c/tests:installation_archives", "//lib/atf/libatf-c++/tests:installation_archives", "//lib/atf/tests:installation_archives"]
bsd_install_archive_set(name = "installation_archives", archives = _PRODUCTION + select({
    "//tools/build/bazel/config:tests_enabled": _TESTS,
    "//conditions:default": [],
}), target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
