load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
cc_library(
    name = "atf_c",
    srcs = ['//contrib/atf:atf-c/build.c', '//contrib/atf:atf-c/check.c', '//contrib/atf:atf-c/detail/dynstr.c', '//contrib/atf:atf-c/detail/env.c', '//contrib/atf:atf-c/error.c', '//contrib/atf:atf-c/detail/fs.c', '//contrib/atf:atf-c/detail/list.c', '//contrib/atf:atf-c/detail/map.c', '//contrib/atf:atf-c/detail/process.c', '//contrib/atf:atf-c/detail/sanity.c', '//contrib/atf:atf-c/detail/text.c', '//contrib/atf:atf-c/detail/user.c', '//contrib/atf:atf-c/utils.c', '//contrib/atf:atf-c/tc.c', '//contrib/atf:atf-c/tp.c', '//contrib/atf:atf-c/detail/tp_main.c'],
    deps = ["//contrib/atf:c_headers"],
    implementation_deps = ["//contrib/atf:c_private_headers"],
    local_defines = ['HAVE_CONFIG_H', 'ATF_BUILD_CC=\\"cc\\"', 'ATF_BUILD_CFLAGS=\\"-Wall\\"', 'ATF_BUILD_CPP=\\"cpp\\"', 'ATF_BUILD_CPPFLAGS=\\"\\"', 'ATF_BUILD_CXX=\\"c++\\"', 'ATF_BUILD_CXXFLAGS=\\"-Wall\\"'],
    linkstatic = True,
    visibility = ["//visibility:public"],
)
bsd_component_archive(name = "static_archive", groups = [":atf_c"], visibility = ["//visibility:public"])
cc_shared_library(name = "atf_c_shared", deps = [":atf_c"], shared_lib_name = "libprivateatf-c.so.1",
    user_link_flags = ["-Wl,-soname,libprivateatf-c.so.1", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {
        "/usr/lib/debug/usr": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=atf","dbg"]}',
        "/usr/lib/debug/usr/lib": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=atf","dbg"]}',
    },
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
