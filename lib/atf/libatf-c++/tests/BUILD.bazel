load(":tests.bzl", "RUNTIME_LIBRARIES", "original_cpp_tests")
load("//tools/build/bazel:bsd_kyua.bzl", "bsd_kyua_test")
original_cpp_tests()
# Preserve the existing qualification labels, sharing actual compilation objects
# with the original no-RPATH installed programs in the detail package.
[alias(name = n + "_test", actual = "//lib/atf/libatf-c++/tests/detail:" + n + "_test_runtime") for n in ["env", "exceptions", "text"]]
[bsd_kyua_test(name = n, program = ":" + n + "_test", interface = "atf",
    kyua = "@bsd_sdk//toolchain:extra_kyua", clean_environment = True, case_timeout = 300, size = "small", timeout = "long",
    test_environment = {"DTRACE_DOF_INIT_DISABLE": "1"}, tags = ["external", "no-remote"],
    runtime = ["@bsd_sdk//toolchain:extra_kyua_runtime", "@bsd_sdk//toolchain:python_stdlib", "//tools/build/bazel:libmd_environment.py"],
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime_checker = "//tools/build/bazel:elf-runtime-check.py", runtime_libraries = RUNTIME_LIBRARIES)
 for n in ["env", "exceptions", "text"]]
