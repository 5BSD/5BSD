load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:configured_version_map.bzl", "bsd_configured_version_map")
cc_library(
    name = "configuration", hdrs = ["config.h"], strip_include_prefix = "/lib/liblzma",
    visibility = ["//usr.bin/xz:__pkg__", "//usr.bin/xzdec:__pkg__", "//usr.bin/lzmainfo:__pkg__"],
)
