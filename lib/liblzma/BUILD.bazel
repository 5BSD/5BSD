load("//tools/build/bazel:bsd_pkgconfig.bzl", "bsd_header_pkgconfig")
load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_debug_split", "bsd_strip_binary")
load(":installation.bzl", "lzma_installation")
bsd_header_pkgconfig(
    name = "pkgconfig", template = "//contrib/xz:src/liblzma/liblzma.pc.in",
    header = "//contrib/xz:src/liblzma/api/lzma/version.h",
    version_patterns = ["^#define LZMA_VERSION_MAJOR ([0-9]+)$", "^#define LZMA_VERSION_MINOR ([0-9]+)$", "^#define LZMA_VERSION_PATCH ([0-9]+)$"],
    version_field = "PACKAGE_VERSION", output = "liblzma.pc",
    substitutions = {"prefix": "/usr", "exec_prefix": "/usr", "libdir": "/usr/lib",
        "includedir": "/usr/include", "LIBS": "-pthread -lmd", "PTHREAD_CFLAGS": "",
        "PACKAGE_URL": "https://tukaani.org/xz/"},
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib"],
)
bsd_debug_split(
    name = "debug", src = ":lzma_shared", binary_name = "install/liblzma.so.5", debug_name = "install/liblzma.so.5.debug",
    objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy", objcopy_inputs = "@bsd_sdk//toolchain:objcopy_inputs",
)
bsd_strip_binary(
    name = "stripped", src = ":debug", output = "stripped/liblzma.so.5",
    strip = "@bsd_sdk//toolchain:bin/llvm-strip", strip_inputs = "@bsd_sdk//toolchain:strip_inputs",
)
lzma_installation(name = "install_manifest")

