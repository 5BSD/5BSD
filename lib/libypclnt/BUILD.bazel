load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load("//tools/build/bazel:bsd_rpcgen.bzl", "bsd_rpcgen")
# Schemas have no preprocessor includes; emitted C includes use the SDK.
_RPC = [
    ("yp", "//include/rpcsvc:yp.x", [("yp.h", "-h"), ("yp_clnt.c", "-l")]),
    ("yppasswd", "//include/rpcsvc:yppasswd.x", [("yppasswd.h", "-h"), ("yppasswd_xdr.c", "-c"), ("yppasswd_clnt.c", "-l")]),
    ("private", "//usr.sbin/rpc.yppasswdd:yppasswd_private.x", [("yppasswd_private.h", "-h"), ("yppasswd_private_clnt.c", "-l"), ("yppasswd_private_xdr.c", "-c")]),
]
[bsd_rpcgen(name = output + "_generate", source = schema, output = output, mode = mode,
    flags = ["-C"], cpp_flags = ["-E", "-x", "c", "-nostdinc"],
    rpcgen = "//usr.bin/rpcgen:rpcgen", cpp = "@bsd_sdk//toolchain:bin/cpp",
    compiler_inputs = "@bsd_sdk//toolchain:compile_inputs", runtime = ["@bsd_sdk//toolchain:cpp_runtime"])
 for _, schema, outputs in _RPC for output, mode in outputs]
cc_library(name = "headers", hdrs = ["ypclnt.h"], strip_include_prefix = ".", visibility = ["//visibility:public"])
cc_library(name = "rpc_headers", hdrs = [":" + output for _, _, outputs in _RPC for output, mode in outputs if mode == "-h"], strip_include_prefix = ".")
cc_library(name = "ypclnt", srcs = ["ypclnt_connect.c", "ypclnt_error.c", "ypclnt_free.c", "ypclnt_new.c", "ypclnt_passwd.c"] + [":" + output for _, _, outputs in _RPC for output, mode in outputs if mode != "-h"],
    deps = [":headers"], implementation_deps = [":rpc_headers"], linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":ypclnt"], visibility = ["//visibility:public"])
cc_shared_library(name = "ypclnt_shared", deps = [":ypclnt"], shared_lib_name = "libypclnt.so.4",
    user_link_flags = ["-Wl,-z,defs", "-Wl,-soname,libypclnt.so.4", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=yp","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
