# Native Clang SDK only; these production parents are not cross-ABI accepted.
selects.config_setting_group(name = "llvm_libraries", match_any = [
    "//tools/build/bazel/config:clang_enabled", "//tools/build/bazel/config:lld_enabled",
    "//tools/build/bazel/config:lldb_enabled", "//tools/build/bazel/config:llvm_binutils_enabled",
])
config_setting(name = "blacklist_libraries", flag_values = {
    "//tools/build/bazel/config:blacklist": "true", "//tools/build/bazel/config:blocklist": "true",
})
config_setting(name = "bluetooth_libraries", flag_values = {
    "//tools/build/bazel/config:bluetooth": "true", "//tools/build/bazel/config:netgraph": "true",
})
config_setting(name = "heimdal_libraries", flag_values = {
    "//tools/build/bazel/config:kerberos": "true", "//tools/build/bazel/config:mitkrb5": "false",
    "//tools/build/bazel/config:openssl": "true", "//tools/build/bazel/config:crypt": "true",
})
config_setting(name = "radius_libraries", flag_values = {"//tools/build/bazel/config:radius_support": "true"})
