    "//conditions:default": [],
})

# Existing children contain incomplete installed-test and other-ABI closures.
# Do not silently present a production-only subset as full installation.
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"] + select({
    "//tools/build/bazel/config:tests_enabled": ["@platforms//:incompatible"],
    "//conditions:default": [],
})
bsd_install_archive_set(name = "production_installation_archives", archives = _ARCHIVES,
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
filegroup(name = "production_libraries", srcs = [":production_installation_archives"] + _BUILD_ONLY,
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
# A full installed test hierarchy is not provided by these production targets.
