// SPDX-License-Identifier: BSD-2-Clause
// system.Network, system.Network.Admin, system.Network.State and
// system.Network.PF (BSDNetwork).  The library name, ordinals and layouts
// are a stable contract for wire major 1; incompatible changes need a new
// major.  Additions within the major are versioned under the platform
// "bsd" (@available(added=N); lib/libfidl/README "Versioning").
// Identity never travels in a payload: the provider decides every request
// from the accepted session's label, its immutable per-label policy and the
// endpoint the session was admitted on.
@available(platform="bsd", added=1)
library bsd.network.v1;

using zx;

type ProtocolInfo = struct { wire_version uint32; };

// One IPv4 or IPv6 transport endpoint.  family is 1 (IPv4: address bytes
// 0..3, the rest and scope_id zero) or 2 (IPv6); prefix must be zero; port
// is in host byte order.
type Endpoint = struct {
    family uint8;
    prefix uint8;
    port uint16;
    scope_id uint32;
    address array<uint8, 16>;
};

// The session's policy: NETWORKCMP_FEATURE_* bits and the resolve ceiling
// (0 without the DNS feature, otherwise 1..32).
type Limits = struct {
    features uint32;
    max_resolve_results uint32;
};

type ConnectRequest = struct {
    endpoint Endpoint;
    // Bounds a TCP handshake (ETIMEDOUT); 0 is a blocking connect.
    timeout_ms uint32;
};
type UdpRequest = struct { endpoint Endpoint; };
// A connected, rights-limited socket owned by the caller.
type Connected = resource struct { socket zx.Handle; };

// backlog 0 selects SOMAXCONN.
type ListenRequest = struct { backlog uint16; };
// A listening loopback socket narrowed to accept, and its OS-assigned port.
type Listener = resource struct {
    socket zx.Handle;
    port uint16;
};

// host and service are getaddrinfo(3) arguments without terminators; either
// may be empty, not both.  family 0..2, socket_type 0 (any), 1 (stream) or
// 2 (datagram), flags NETWORKCMP_RESOLVE_F_*, max_results 1..32.
type ResolveRequest = struct {
    host string:253;
    service string:32;
    family uint32;
    socket_type uint32;
    flags uint32;
    max_results uint32;
};
type ResolveResult = struct {
    endpoint Endpoint;
    socket_type uint32;
    protocol uint32;
};
type Resolved = struct {
    results vector<ResolveResult>:32;
    canonname string:253;
    // Conservative remaining lifetime, including CNAMEs and cache age.
    ttl_seconds uint32;
};

// The connection broker (system.Network; system.Network.Admin is the same
// protocol behind the system.network.admin attribute).  It never proxies
// data.  All errors are errno values.
closed protocol Network {
    strict GetProtocolInfo() -> (ProtocolInfo);
    strict GetLimits() -> (Limits);
    strict Resolve(ResolveRequest) -> (Resolved) error uint32;
    strict Connect(ConnectRequest) -> (Connected) error uint32;
    strict Udp(UdpRequest) -> (Connected) error uint32;
    strict Listen(ListenRequest) -> (Listener) error uint32;
};

// One network interface (no addresses or counters).
type Interface = struct {
    index uint32;
    // Native IFF_* interface and driver flags.
    flags uint32;
    mtu uint32;
    // 0 unknown, 1 down, 2 up.
    link_state uint8;
    name string:15;
};
// timeout_ms bounds a later watch (EAGAIN); UINT32_MAX waits indefinitely.
type WatchRequest = struct { timeout_ms uint32; };
type Snapshot = struct {
    epoch uint64;
    generation uint64;
    // Positive errno when the sampler has no current data (no interfaces).
    source_error int32;
    interfaces vector<Interface>:256;
};

// system.Network.State: the interface table as a coalescing watch.  The
// first Watch returns at once; later calls return on change.
closed protocol NetworkState {
    strict GetProtocolInfo() -> (ProtocolInfo);
    strict Watch(WatchRequest) -> (Snapshot) error uint32;
};

// One read-only pf(4) descriptor reporting the state table of the client's
// own vnet.  The descriptor keeps the rights the provider set -- exactly
// CAP_READ, CAP_FSTAT and CAP_IOCTL with DIOCGETSTATES the only admitted
// ioctl, no fcntls, one transfer -- so it is an untyped zx.Handle
// (SAME_RIGHTS): the backend's explicit READ mapping narrows a descriptor to
// CAP_READ alone, which would defeat the ioctl.  The client library checks
// those rights on receipt.
type PfStates = resource struct { pf zx.Handle; };

// system.Network.PF, admitted only to clients anointed with
// system.network.pf.read.  A session delivers one descriptor: a second
// OpenStates fails with EALREADY, and the session ends five seconds after
// it was accepted.  OpenStates errors are errno values (EPERM when the
// client cannot be bound to its vnet, the /dev/pf open error otherwise); on
// error no descriptor is delivered.
closed protocol NetworkPf {
    strict GetProtocolInfo() -> (ProtocolInfo);
    strict OpenStates() -> (PfStates) error uint32;
};
