.Sh LIBRARY
.Li libnetworkcmp
.Pq Fl lnetworkcmp
.Sh SYNOPSIS
.In networkcmp.h
.Ft int
.Fn networkcmp_client_open "struct networkcmp_client **client"
.Ft int
