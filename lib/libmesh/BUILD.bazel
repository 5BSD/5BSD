load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_import")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_spec", "bsd_dtrace_cc_objects")
load(":sources.bzl", "SOURCES", "PUBLIC_HEADERS")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "headers", hdrs = PUBLIC_HEADERS, strip_include_prefix = ".", visibility = ["//visibility:public"])
bsd_dtrace_spec(name = "provider", source = "mesh_provider.d", output = "mesh_provider.o",
    flags = ["-C", "-x", "nolibs"], static_anchor = True, object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:dtrace", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti",
    runtime_libraries = ["//cddl/lib/libdtrace:dtrace_shared", "//cddl/lib/libctf:ctf_shared", "//lib/libelf:elf_shared", "//lib/libproc:proc_shared", "//cddl/lib/libspl:spl_shared", "//lib/libxo/libxo:xo_shared", "//lib/libutil:util_shared", "//lib/libprocstat:procstat_shared", "//lib/librtld_db:rtld_db_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/libz:z_shared", "//lib/libkvm:kvm_shared"],
    tool_inputs = [ "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"])
cc_library(name = "objects", srcs = SOURCES,
    deps = [":headers", "//secure/lib/libcrypto:crypto"],
    local_defines = select({_TRACE: ["MESH_DTRACE_PROBES"], "//conditions:default": []}),
    linkstatic = True, target_compatible_with = _PLATFORM)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider",
    provider_object = "mesh_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group)
 for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"], deps = [":provider_link"])
# Source headers retain the provider anchor; preserve Make's provider member.
cc_library(name = "blemesh", deps = select({_TRACE: [":traced"], "//conditions:default": [":objects"]}) + [":headers", "//secure/lib/libcrypto:crypto"],
    linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = select({_TRACE: [":traced", ":provider_link"], "//conditions:default": [":objects"]}), target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_shared_library(name = "blemesh_shared", deps = [":blemesh"],
    dynamic_deps = ["//secure/lib/libcrypto:crypto_shared"],
    shared_lib_name = "libblemesh.so.1", additional_linker_inputs = ["Version.map"],
    user_link_flags = ["-Wl,-soname,libblemesh.so.1", "-Wl,--version-script=$(location Version.map),--no-undefined-version", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bluetooth","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
