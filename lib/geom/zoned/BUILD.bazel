load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
# Plugin references to the frontend/libgeom intentionally remain dynamic imports,
# matching the maintained Make plugin ABI rather than embedding another libgeom.
cc_library(name = "objects", srcs = ["geom_zoned.c", "//sbin/geom:misc/subr.c"],
    deps = ["//sbin/geom:plugin_headers", "//sys/geom/zoned:headers", "//lib/libgeom:headers"],
    linkstatic = True, target_compatible_with = _PLATFORM)
cc_shared_library(name = "geom_zoned", deps = [":objects"], shared_lib_name = "geom_zoned.so",
    user_link_flags = ["-Wl,-soname,geom_zoned.so", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load("//lib/geom:plugin_installation.bzl", "plugin_installation")
plugin_installation(name = "install_manifest", cls = "zoned", binary = ":geom_zoned")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "install_archive", visibility = ["//lib/geom:__pkg__"], supplemental_mtree = "//tools/build/bazel/config:geom_directory_policy", manifests = [":install_manifest"],
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])
