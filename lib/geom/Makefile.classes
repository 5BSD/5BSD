.if !defined(COMPAT_libcompat)
GEOM_CLASS_DIR?=/lib/geom
.else
GEOM_CLASS_DIR?=/usr/lib${COMPAT_libcompat}/geom
.endif

GEOM_CLASSES=	label
.if ${MK_OPENSSL} != "no"
GEOM_CLASSES+=	eli
.endif
GEOM_CLASSES+=	mirror
GEOM_CLASSES+=	multipath
GEOM_CLASSES+=	nop
GEOM_CLASSES+=	part
GEOM_CLASSES+=	raid
GEOM_CLASSES+=	zoned
