load(":classes.bzl", "geom_class_labels")
exports_files(["plugin_installation.bzl", "classes.bzl", "empty.mtree"])

filegroup(
    name = "plugins",
    srcs = geom_class_labels("//lib/geom/{cls}:geom_{cls}"),
    visibility = ["//visibility:public"],
)

# Preserve each archive's request/directory metadata for world composition.
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive_set")
bsd_install_archive_set(
    name = "installation_archives",
    archives = geom_class_labels("//lib/geom/{cls}:install_archive"),
    visibility = ["//visibility:public"],
)
