load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_kyua.bzl", "bsd_kyua_test")
[cc_binary(name = name, srcs = [name + ".c"] + (["//lib/libsysctlcmp:sysctlcmp_legacy.c"] if name == "sysctlcmp_test" else []),
    deps = ["//lib/libsysctlcmp:sysctlcmp", "//lib/libsysctlcmp:generated_headers", "//lib/libfidl:fidl",
        "//lib/libchannel:channel", "//lib/libservice:service", "//lib/atf/libatf-c:atf_c"],
    linkstatic = True, linkopts = ["-static"])
 for name in ["sysctlcmp_test", "client_strings_test"]]
[bsd_kyua_test(name = name + "_run", program = ":" + name, interface = "atf", suite = "FreeBSD",
    kyua = "@bsd_sdk//toolchain:extra_kyua", clean_environment = True,
    case_timeout = 120 if name == "client_strings_test" else 60,
    test_metadata = '{"required_user":"root"}' if name == "client_strings_test" else '{}',
    tags = ["manual", "requires-matching-kernel"] if name == "client_strings_test" else [],
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_kyua_runtime"],
    size = "medium", visibility = ["//visibility:public"])
 for name in ["sysctlcmp_test", "client_strings_test"]]

load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
[utility_installation(name = "install_" + name, program = name, manual = "",
    package = "libsysctlcmp-tests", bindir = "/usr/tests/lib/libsysctlcmp")
 for name in ["client_strings_test", "sysctlcmp_test"]]
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["client_strings_test", "sysctlcmp_test"],
    interfaces = {n: "atf" for n in ["client_strings_test", "sysctlcmp_test"]},
    metadata = {"client_strings_test": '{"required_user":"root","timeout":"120"}'})
[bsd_install_file(name = name, src = src, destination = dest, owner = "root", group = "wheel",
    mode = "0444", install_tags = ["package=libsysctlcmp-tests"])
 for name, src, dest in [
    ("install_kyuafile", ":kyuafile", "/usr/tests/lib/libsysctlcmp/Kyuafile"),
    ("install_license", "//contrib/fuchsia:LICENSE", "/usr/share/licenses/libsysctlcmp-tests/fuchsia/LICENSE"),
    ("install_patents", "//contrib/fuchsia:PATENTS", "/usr/share/licenses/libsysctlcmp-tests/fuchsia/PATENTS"),
 ]]
bsd_install_manifest(name = "install_extra", entries = [":install_kyuafile", ":install_license", ":install_patents"],
    visibility = ["//lib/libsysctlcmp:__pkg__"])
