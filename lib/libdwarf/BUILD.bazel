load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load("//tools/build/bazel:bsd_m4.bzl", "bsd_m4")
load(":sources.bzl", "DWARF_SOURCES", "DWARF_GENERATED")
[
    bsd_m4(name = name, output = name + ".c",
        src = "//contrib/elftoolchain:libdwarf/" + name + ".m4",
        includes = ["//contrib/elftoolchain:libdwarf/dwarf_pro_nametbl.m4" if name.startswith("dwarf_pro_") else "//contrib/elftoolchain:libdwarf/dwarf_nametbl.m4"],
        m4 = "@bsd_sdk//toolchain:extra_m4", redirect = "@bsd_sdk//toolchain:stdout_redirect",
        runtime = ["@bsd_sdk//toolchain:extra_m4_runtime"])
    for name in DWARF_GENERATED
]
cc_library(name = "dwarf", srcs = DWARF_SOURCES + [":" + name for name in DWARF_GENERATED],
    deps = ["//contrib/elftoolchain:dwarf_headers", "//lib/libelf:elf", "//lib/libz:z"],
    implementation_deps = ["//contrib/elftoolchain:dwarf_internal_headers"],
    linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":dwarf"], visibility = ["//visibility:public"])
cc_shared_library(name = "dwarf_shared", deps = [":dwarf"], shared_lib_name = "libdwarf.so.4",
    dynamic_deps = ["//lib/libelf:elf_shared", "//lib/libz:z_shared"],
    user_link_flags = ["-Wl,-soname,libdwarf.so.4", "-Wl,--fatal-warnings,--warn-shared-textrel"], visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_import", "cc_test")
cc_binary(name = "fixture", srcs = ["fixture.c"], copts = ["-g", "-gdwarf-4", "-O0"], testonly = True)
cc_binary(name = "fixture_compressed", srcs = ["fixture.c"], copts = ["-g", "-gdwarf-4", "-O0"],
    linkopts = ["-Wl,--compress-debug-sections=zlib"], testonly = True)
cc_import(name = "archive_link", static_library = ":static_archive")
cc_test(name = "lines_static", srcs = ["line_test.c"],
    deps = [":archive_link", "//contrib/elftoolchain:dwarf_headers", "//lib/libelf:elf", "//lib/libz:z"],
    data = [":fixture", ":fixture_compressed"], args = ["$(rootpath :fixture)", "$(rootpath :fixture_compressed)"],
    linkstatic = True, size = "small", target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
cc_test(name = "lines_shared", srcs = ["line_test.c"], deps = [":dwarf"],
    dynamic_deps = [":dwarf_shared", "//lib/libelf:elf_shared", "//lib/libz:z_shared"],
    features = ["bsd_test_runtime_paths"],
    data = [":fixture", ":fixture_compressed"], args = ["$(rootpath :fixture)", "$(rootpath :fixture_compressed)"],
    size = "small", target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])

load(":installation.bzl", "dwarf_installation")
dwarf_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
filegroup(name = "package_abi", srcs = [":install_manifest_stripped"], visibility = ["//packages/libdwarf:__pkg__"])
