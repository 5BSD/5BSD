load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(
    name = "headers",
    hdrs = ["lib80211_regdomain.h", "lib80211_ioctl.h"],
    strip_include_prefix = ".",
    visibility = ["//visibility:public"],
)
cc_library(
    name = "80211",
    srcs = ["lib80211_regdomain.c", "lib80211_ioctl.c"],
    deps = [":headers", "//lib/libsbuf:sbuf", "//lib/libexpat:bsdxml"],
    linkstatic = True,
    target_compatible_with = _PLATFORM,
    visibility = ["//visibility:public"],
)
bsd_component_archive(
    name = "static_archive",
    groups = [":80211"],
    target_compatible_with = _PLATFORM,
    visibility = ["//visibility:public"],
)
cc_shared_library(
    name = "80211_shared",
    deps = [":80211"],
    dynamic_deps = ["//lib/libsbuf:sbuf_shared", "//lib/libexpat:bsdxml_shared"],
    shared_lib_name = "lib80211.so.1",
    user_link_flags = ["-Wl,-soname,lib80211.so.1", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = _PLATFORM,
    visibility = ["//visibility:public"],
)

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime","dbg"]}' for d in ["/usr/lib/debug/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

# Pure parser tests use the packaged database through declared runfiles.
[cc_test(
    name = "regdomain_" + linkage,
    srcs = ["tests/regdomain_test.c"],
    deps = [":80211"],
    dynamic_deps = [":80211_shared", "//lib/libsbuf:sbuf_shared", "//lib/libexpat:bsdxml_shared"] if linkage == "shared" else [],
    features = ["bsd_test_runtime_paths"],
    data = ["regdomain.xml"],
    args = ["$(rootpath :regdomain.xml)"],
    linkstatic = True,
    size = "small",
    target_compatible_with = _PLATFORM,
) for linkage in ["static", "shared"]]
