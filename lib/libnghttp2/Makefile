# nghttp2 (contrib/nghttp2), the HTTP/2 framing library, as a private
# shared library, libprivatenghttp2.so.  Only the library is imported
# (as the www/libnghttp2 port's --enable-lib-only); libotelexport uses its
# client side for OTLP/gRPC.  config.h is hand-written for FreeBSD;
# nghttp2/nghttp2ver.h is the upstream template with the version filled in
# (contrib/nghttp2/README.5BSD), so in-tree consumers need only
# -I${SRCTOP}/contrib/nghttp2/lib/includes -I${SRCTOP}/lib/libnghttp2.

.include <src.opts.mk>

NGHTTP2=	${SRCTOP}/contrib/nghttp2

PACKAGE=	libnghttp2
LIB=		nghttp2
PRIVATELIB=	true
# libtool -version-info 43:5:29 (configure.ac): libnghttp2.so.14
SHLIB_MAJOR=	14

.PATH:		${NGHTTP2}

# BEGIN generated by the import (contrib/nghttp2/README.5BSD)
SRCS+=	lib/nghttp2_alpn.c
SRCS+=	lib/nghttp2_buf.c
SRCS+=	lib/nghttp2_callbacks.c
SRCS+=	lib/nghttp2_debug.c
SRCS+=	lib/nghttp2_extpri.c
SRCS+=	lib/nghttp2_frame.c
SRCS+=	lib/nghttp2_hd.c
SRCS+=	lib/nghttp2_hd_huffman.c
SRCS+=	lib/nghttp2_hd_huffman_data.c
SRCS+=	lib/nghttp2_helper.c
SRCS+=	lib/nghttp2_http.c
SRCS+=	lib/nghttp2_map.c
SRCS+=	lib/nghttp2_mem.c
SRCS+=	lib/nghttp2_option.c
SRCS+=	lib/nghttp2_outbound_item.c
SRCS+=	lib/nghttp2_pq.c
SRCS+=	lib/nghttp2_priority_spec.c
SRCS+=	lib/nghttp2_queue.c
SRCS+=	lib/nghttp2_ratelim.c
SRCS+=	lib/nghttp2_rcbuf.c
SRCS+=	lib/nghttp2_session.c
SRCS+=	lib/nghttp2_stream.c
SRCS+=	lib/nghttp2_submit.c
SRCS+=	lib/nghttp2_time.c
SRCS+=	lib/nghttp2_version.c
SRCS+=	lib/sfparse.c
# END generated

CFLAGS+=	-DHAVE_CONFIG_H -DBUILDING_NGHTTP2 \
		-I${.CURDIR} \
		-I${NGHTTP2}/lib/includes -I${NGHTTP2}/lib \
		-fvisibility=hidden
WARNS?=		3

INCSGROUPS=	NGHTTP2_INCS
NGHTTP2_INCSDIR= ${INCLUDEDIR}/private/nghttp2
NGHTTP2_INCS=	${NGHTTP2}/lib/includes/nghttp2/nghttp2.h \
		nghttp2/nghttp2ver.h

FILESGROUPS+=	NGHTTP2_LICENSES
NGHTTP2_LICENSES= ${NGHTTP2}/COPYING
NGHTTP2_LICENSESDIR= /usr/share/licenses/nghttp2

.include <bsd.lib.mk>
