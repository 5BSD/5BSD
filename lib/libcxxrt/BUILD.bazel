load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load(":sources.bzl", "CXXRT_SOURCES")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
# This target is amd64/LP64 only. Other ABIs need their own map selection.
expand_template(name = "version_map", template = "Version.map", out = "Version-64.map",
    substitutions = {"%%NEW_DELETE_TYPE%%": "long"}, target_compatible_with = _PLATFORM)
cc_library(name = "cxxrt", srcs = CXXRT_SOURCES, implementation_deps = ["//contrib/libcxxrt:headers"],
    copts = ["-nostdinc++"], linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":cxxrt"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_shared_library(name = "cxxrt_shared", deps = [":cxxrt"], shared_lib_name = "libcxxrt.so.1",
    additional_linker_inputs = [":version_map"], user_link_flags = ["-Wl,-soname,libcxxrt.so.1", "-Wl,--version-script=$(location :version_map),--no-undefined-version", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_import", "cc_test")
cc_import(name = "archive_link", static_library = ":static_archive")
[
    cc_test(name = "demangle_" + variant, srcs = ["demangle_test.c"],
        deps = [":archive_link"] if variant == "static" else [":cxxrt"],
        dynamic_deps = [] if variant == "static" else [":cxxrt_shared"],
        features = [] if variant == "static" else ["bsd_test_runtime_paths"],
        linkstatic = variant == "static", size = "small", target_compatible_with = _PLATFORM)
    for variant in ["static", "shared"]
]

load(":installation.bzl", "libcxxrt_installation")
libcxxrt_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {"/usr/lib/debug/lib": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=clibs","dbg"]}'},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
