load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "bsddialog", srcs = ['//contrib/bsddialog/lib:barbox.c', '//contrib/bsddialog/lib:datebox.c', '//contrib/bsddialog/lib:formbox.c', '//contrib/bsddialog/lib:lib_util.c', '//contrib/bsddialog/lib:lib_util.h', '//contrib/bsddialog/lib:libbsddialog.c', '//contrib/bsddialog/lib:menubox.c', '//contrib/bsddialog/lib:messagebox.c', '//contrib/bsddialog/lib:slider.c', '//contrib/bsddialog/lib:textbox.c', '//contrib/bsddialog/lib:theme.c', '//contrib/bsddialog/lib:timebox.c'], deps = ['//contrib/bsddialog/lib:headers', '//lib/ncurses/ncurses:ncurses', '//lib/ncurses/tinfo:tinfo'], local_defines = ["_XOPEN_SOURCE_EXTENDED"], linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":bsddialog"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_shared_library(name = "bsddialog_shared", deps = [":bsddialog"], dynamic_deps = ["//lib/ncurses/ncurses:ncurses_shared", "//lib/ncurses/tinfo:tinfo_shared"],
    shared_lib_name = "libprivatebsddialog.so.0", user_link_flags = ["-Wl,-soname,libprivatebsddialog.so.0", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//lib:__pkg__"],
    manifests = [":install_manifest"],
    directories = {directory: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for directory in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
