bsd_component_sources(name = "source_inventory", groups = [":objects"], visibility = ["//visibility:public"])
cc_shared_library(name = "runtime_shared", deps = [":objects"],
    shared_lib_name = "libclang_rt.asan-x86_64.so",
    user_link_flags = ["-Wl,-soname,libclang_rt.asan-x86_64.so", "-Wl,-x,--fatal-warnings,--warn-shared-textrel", "-lgcc_s"],
    visibility = ["//visibility:public"])
bsd_debug_split(name = "debug_split", src = ":runtime_shared",
    binary_name = "split/libclang_rt.asan-x86_64.so", debug_name = "split/libclang_rt.asan-x86_64.so.debug",
    objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy", objcopy_inputs = "@bsd_sdk//toolchain:objcopy_inputs")
bsd_strip_binary(name = "stripped", src = ":debug_split", output = "stripped/libclang_rt.asan-x86_64.so",
    strip = "@bsd_sdk//toolchain:bin/llvm-strip", strip_inputs = "@bsd_sdk//toolchain:strip_inputs")
filegroup(name = "debug_file", srcs = [":debug_split"], output_group = "debug_files")
bsd_install_file(name = "library_file", src = ":stripped",
    destination = "/usr/lib/clang/21/lib/freebsd/libclang_rt.asan-x86_64.so",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=clang"])
bsd_install_file(name = "symbols_file", src = ":debug_file",
    destination = "/usr/lib/debug/usr/lib/clang/21/lib/freebsd/libclang_rt.asan-x86_64.so.debug",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=clang", "dbg"])
bsd_install_manifest(name = "install_manifest", entries = [":library_file", ":symbols_file"], visibility = ["//visibility:public"])
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"],
    directories = {d: json.encode(dict(owner = "root", group = "wheel", mode = "0755", tags = ["package=clang", "dbg"])) for d in [
        "/usr/lib/debug/usr", "/usr/lib/debug/usr/lib", "/usr/lib/debug/usr/lib/clang", "/usr/lib/debug/usr/lib/clang/21", "/usr/lib/debug/usr/lib/clang/21/lib", "/usr/lib/debug/usr/lib/clang/21/lib/freebsd"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
    visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")
cc_import(name = "runtime_link", shared_library = ":runtime_shared")
cc_binary(name = "instrumented_probe", srcs = ["//lib/libclang_rt/asan:runtime_probe.c"],
    copts = ["-fsanitize=address", "-fno-omit-frame-pointer"],
    deps = [":runtime_link"], linkstatic = True,
    linkopts = ["-Wl,--export-dynamic", "-Wl,--no-as-needed", "-lpthread", "-lrt", "-lexecinfo"],
    testonly = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
cc_binary(name = "instrumented_tls_probe", srcs = ["//lib/libclang_rt/asan:runtime_probe.c"],
    local_defines = ["PROBE_TLS"],
    copts = ["-fsanitize=address", "-fno-omit-frame-pointer"],
    deps = [":runtime_link"], linkstatic = True,
    linkopts = ["-Wl,--export-dynamic", "-Wl,--no-as-needed", "-lpthread", "-lrt", "-lexecinfo"],
    testonly = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
_RUNTIME_LIBS = [":runtime_shared", "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared"] + [
    "@bsd_sdk//toolchain:sysroot/" + name for name in [
        "lib/libc.so.7", "lib/libsys.so.7", "lib/libthr.so.3", "lib/librt.so.1",
        "lib/libgcc_s.so.1", "lib/libelf.so.2", "usr/lib/libexecinfo.so.1",
    ]]
cc_test(name = "runtime_test", srcs = ["//lib/libclang_rt/asan:runtime_test.c"],
    data = [":instrumented_probe"] + _RUNTIME_LIBS,
    args = ["$(location :instrumented_probe)"] + ["$(location " + lib + ")" for lib in _RUNTIME_LIBS],
    linkopts = ["-static"], linkstatic = True, size = "small",
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])

cc_test(name = "tls_runtime_test", srcs = ["//lib/libclang_rt/asan:runtime_test.c"],
    data = [":instrumented_tls_probe"] + _RUNTIME_LIBS,
    args = ["$(location :instrumented_tls_probe)"] + ["$(location " + lib + ")" for lib in _RUNTIME_LIBS],
    linkopts = ["-static"], linkstatic = True, size = "small",
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
