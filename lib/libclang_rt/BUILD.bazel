exports_files(["runtime.bzl"])

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Complete maintained amd64 runtime selection. Other architectures require
# their own source/availability qualification before using this aggregate.
_AMD64_COMPONENTS = [
    "asan",
    "asan-preinit",
    "asan_cxx",
    "asan_dynamic",
    "asan_static",
    "cfi",
    "cfi_diag",
    "dd",
    "fuzzer",
    "fuzzer_interceptors",
    "fuzzer_no_main",
    "include",
    "msan",
    "msan_cxx",
    "profile",
    "safestack",
    "stats",
    "stats_client",
    "tsan",
    "tsan_cxx",
    "ubsan_minimal",
    "ubsan_standalone",
    "ubsan_standalone_cxx",
    "xray",
    "xray-basic",
    "xray-fdr",
    "xray-profiling",
]
bsd_install_manifest(name = "install_manifest",
    manifests = ["//lib/libclang_rt/" + component + ":install_manifest" for component in _AMD64_COMPONENTS],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
_DEBUG_DIRECTORIES = [
    "/usr/lib/debug/usr", "/usr/lib/debug/usr/lib", "/usr/lib/debug/usr/lib/clang",
    "/usr/lib/debug/usr/lib/clang/21", "/usr/lib/debug/usr/lib/clang/21/lib",
    "/usr/lib/debug/usr/lib/clang/21/lib/freebsd",
]
_DIRECTORIES = {path: json.encode(dict(owner = "root", group = "wheel", mode = "0755", tags = ["package=clang", "dbg"])) for path in _DEBUG_DIRECTORIES}
_DIRECTORIES["/usr/lib/clang/21/share"] = json.encode(dict(owner = "root", group = "wheel", mode = "0755", tags = ["package=clang"]))
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"],
    directories = _DIRECTORIES,
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.include.dist": "/usr/include", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
