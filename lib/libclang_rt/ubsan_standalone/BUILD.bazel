load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_import", "cc_test")
cc_import(name = "runtime", static_library = ":static_archive", alwayslink = True)
cc_binary(name = "instrumented_probe", srcs = ["runtime_probe.c"],
    copts = ["-fsanitize=signed-integer-overflow"],
    deps = [":runtime"], linkstatic = True,
    linkopts = ["-Wl,--export-dynamic", "-Wl,--no-as-needed", "-lpthread", "-lrt", "-lm", "-lexecinfo"],
    testonly = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
_RUNTIME_LIBS = ["@bsd_sdk//toolchain:sysroot/" + name for name in [
    "lib/libc.so.7", "lib/libsys.so.7", "lib/libthr.so.3", "lib/librt.so.1", "lib/libm.so.5",
    "lib/libgcc_s.so.1", "lib/libelf.so.2", "usr/lib/libexecinfo.so.1",
]]
cc_test(name = "runtime_test", srcs = ["runtime_test.c"],
    data = [":instrumented_probe"] + _RUNTIME_LIBS,
    args = ["$(location :instrumented_probe)"] + ["$(location " + lib + ")" for lib in _RUNTIME_LIBS],
    linkopts = ["-static"], linkstatic = True, size = "small",
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
