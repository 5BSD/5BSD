# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
cc_library(name = "headers", hdrs = ["efivar.h", "efivar-dp.h"], strip_include_prefix = ".", visibility = ["//visibility:public"])
cc_library(name = "efivar", srcs = ["efivar.c", "//stand/efi/libefi:efichar.c", "efivar-dp-format.c", "efivar-dp-parse.c", "efivar-dp-xlate.c", "efiutil.c", "uefi-guid.c", "uefi-dputil.c", "uefi-dplib.h"],
    deps = [":headers"],
    implementation_deps = ["//stand/efi/include:efichar_header", "//sys/contrib/edk2/Include:efivar_headers", "//lib/libgeom:headers"],
    copts = ["-fno-strict-aliasing"], linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":efivar"], visibility = ["//visibility:public"])
# Match Make: GEOM symbols remain unresolved here and are supplied by consumers.
cc_shared_library(name = "efivar_shared", deps = [":efivar"], shared_lib_name = "libefivar.so.1",
    user_link_flags = ["-Wl,-soname,libefivar.so.1", "-Wl,--fatal-warnings,--warn-shared-textrel"], visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//visibility:public"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=efi-tools","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
