load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load("//tools/build/bazel:bsd_lex_yacc.bzl", "bsd_lex", "bsd_yacc")
load("//tools/build/bazel:bsd_template.bzl", "bsd_template")
load(":sources.bzl", "SOURCES")
# Preserve Make's .lex -> .l input name without invoking Make.
bsd_template(name = "lexer_input", template = "//contrib/unbound:util/configlexer.lex", output = "configlexer.l", substitutions = {})
bsd_lex(name = "lexer", src = ":lexer_input", output = "configlexer.c", flags = ["-Pub_c_"], lex = "//usr.bin/lex:lex", m4 = "//usr.bin/m4:m4")
bsd_yacc(name = "parser", src = "//contrib/unbound:util/configparser.y", output = "configparser.c", header = "configparser.h", flags = ["-pub_c_"], yacc = "//usr.bin/yacc:yacc")
filegroup(name = "parser_source", srcs = [":parser"], output_group = "source")
filegroup(name = "parser_header", srcs = [":parser"], output_group = "header")
cc_library(name = "config_headers", hdrs = ["config.h", ":parser_header"], includes = ["."])
cc_library(name = "unbound", srcs = SOURCES[:5] + [":lexer", ":parser_source"] + SOURCES[5:],
    deps = [":config_headers", "//contrib/unbound:headers", "//contrib/ldns:headers", "//secure/lib/libssl:ssl", "//secure/lib/libcrypto:crypto", "//lib/libthr:thr"],
    local_defines = ["OPENSSL_API_COMPAT=0x10100000L"],
    copts = ["-Wno-thread-safety-analysis"],
    linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":unbound"], visibility = ["//visibility:public"])

cc_shared_library(name = "unbound_shared", deps = [":unbound"],
    dynamic_deps = ["//secure/lib/libssl:ssl_shared", "//secure/lib/libcrypto:crypto_shared", "//lib/libthr:thr_shared"],
    shared_lib_name = "libprivateunbound.so.5", user_link_flags = ["-Wl,-soname,libprivateunbound.so.5", "-Wl,--fatal-warnings,--warn-shared-textrel"], visibility = ["//visibility:public"])
load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=local-unbound","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

load("@rules_cc//cc:defs.bzl", "cc_test")
cc_test(name = "runtime_test", srcs = ["runtime_test.c"],
    deps = [":unbound", "//lib/libc:shared_link_interface"],
    dynamic_deps = [":unbound_shared", "//secure/lib/libssl:ssl_shared", "//secure/lib/libcrypto:crypto_shared", "//lib/libthr:thr_shared", "//lib/libc:c_shared", "//lib/libsys:sys_shared"],
    copts = ["-UNDEBUG"], linkopts = ["-nodefaultlibs"], features = ["bsd_test_runtime_paths"],
    data = [":unbound_shared", "runtime-valid.conf", "runtime-invalid.conf"],
    args = ["$(rootpath :unbound_shared)", "$(rootpath runtime-valid.conf)", "$(rootpath runtime-invalid.conf)"],
    size = "small", timeout = "moderate", target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
