load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
cc_binary(name = "basic_dispatch_test", srcs = ["basic_dispatch_test.c"],
    deps = ["//lib/libpam/libpam:pam", "//lib/atf/libatf-c:atf_c"],
    dynamic_deps = ["//lib/libpam/libpam:pam_shared", "//lib/atf/libatf-c:atf_c_shared"],
    copts = ["-fPIE"], linkopts = ["-pie"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
[bsd_atf_test(name = "native_dispatch_" + case, case_name = case, interface = "program", body = ":basic_dispatch_test",
    config_files = {"//lib/libpam/modules/pam_deny:pam_deny": "deny_module", "//lib/libpam/modules/pam_permit:pam_permit": "permit_module"},
    runtime_lib = ["//lib/libpam/libpam:pam_shared", "//lib/atf/libatf-c:atf_c_shared",
        "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"],
    runner = "//tools/build/bazel:atf_runner", size = "small") for case in ["permit", "deny", "required_deny"]]
test_suite(name = "basic_dispatch_tests", tests = [":native_dispatch_" + case for case in ["permit", "deny", "required_deny"]], visibility = ["//visibility:public"])

[cc_binary(name = name + "_pam_test", srcs = [name + "_pam_test.c"],
    deps = ["//lib/libpam/libpam:pam", "//lib/atf/libatf-c:atf_c"] + (["//lib/libcrypt:crypt"] if name == "password_hash" else []),
    dynamic_deps = ["//lib/libpam/libpam:pam_shared", "//lib/atf/libatf-c:atf_c_shared"] + (["//lib/libcrypt:crypt_shared"] if name == "password_hash" else []),
    copts = ["-fPIE"], linkopts = ["-pie", "-Wl,--export-dynamic"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
 for name in ["password_hash", "account_resolution"]]
[bsd_atf_test(name = "native_" + name, case_name = case, interface = "program", body = ":" + name + "_pam_test",
    config_files = {"//lib/libpam/modules/pam_unix:pam_unix": "module"},
    runtime_lib = ["//lib/libpam/libpam:pam_shared", "//lib/libcrypt:crypt_shared", "//lib/libmd:md_shared", "//lib/libutil:util_shared", "//lib/atf/libatf-c:atf_c_shared",
        "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"] + select({"//tools/build/bazel/config:nis_enabled": ["//lib/libypclnt:ypclnt_shared"], "//conditions:default": []}),
    runner = "//tools/build/bazel:atf_runner", size = "small")
 for name, case in [("password_hash", "password_hashes"), ("account_resolution", "account_resolution")]]
test_suite(name = "unix_tests", tests = [":native_password_hash", ":native_account_resolution"], visibility = ["//visibility:public"])

# Load actual native Kerberos PAM modules with an invalid local configuration.
cc_binary(name = "kerberos_config_pam_test", srcs = ["kerberos_config_pam_test.c"],
    deps = ["//lib/libpam/libpam:pam", "//lib/atf/libatf-c:atf_c"],
    dynamic_deps = ["//lib/libpam/libpam:pam_shared", "//lib/atf/libatf-c:atf_c_shared"],
    copts = ["-fPIE"], linkopts = ["-pie"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
[bsd_atf_test(name = "native_" + module + "_config", case_name = "malformed_config", interface = "program", body = ":kerberos_config_pam_test",
    config_files = {"//lib/libpam/modules/" + module + ":" + module: "module"},
    runtime_lib = ["//lib/libpam/libpam:pam_shared", "//lib/atf/libatf-c:atf_c_shared",
        "//krb5/lib/krb5:krb5_shared", "//krb5/lib/crypto:k5crypto_shared", "//krb5/util/et:com_err_shared", "//krb5/util/support:krb5support_shared", "//secure/lib/libcrypto:crypto_shared",
        "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7", "@bsd_sdk//toolchain:sysroot/lib/libthr.so.3"],
    runner = "//tools/build/bazel:atf_runner", size = "small") for module in ["pam_ksu", "pam_krb5"]]
test_suite(name = "kerberos_config_tests", tests = [":native_pam_ksu_config", ":native_pam_krb5_config"], visibility = ["//visibility:public"])
