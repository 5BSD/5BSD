# Standard versioned policy inputs for explicit isolated qualification.
exports_files(["su", "system", "other"], visibility = ["//tools/build/bazel:__pkg__"])

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

_CORE = [
    "README", "imap", "login", "other", "passwd", "pop3", "sddm-greeter",
    "sshd", "su", "system", "xdm",
]
[bsd_install_file(
        name = name + "_file",
        src = name,
        destination = "/etc/pam.d/" + name,
        owner = "root",
        group = "wheel",
        mode = "0444" if name == "README" else "0644",
        install_tags = ["package=" + ("cron" if name == "cron" else "at" if name == "atrun" else "pam"), "config"],
) for name in _CORE + ["cron", "atrun", "ftp", "ftpd"]]
bsd_install_manifest(
    name = "install_manifest",
    entries = select({
        "//tools/build/bazel/config:at_enabled": [":atrun_file"],
        "//conditions:default": [],
    }) + [":" + name + "_file" for name in _CORE + ["cron"]] + select({
        "//tools/build/bazel/config:ftp_enabled": [":ftp_file", ":ftpd_file"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {"/etc/pam.d": json.encode({"owner": "root", "group": "wheel", "mode": "0755", "tags": ["package=utilities"]})},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/"},
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
    visibility = ["//visibility:public"],
)
