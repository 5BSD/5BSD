load("@rules_cc//cc:defs.bzl", "cc_library", "cc_import", "cc_shared_library")
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_header", "bsd_dtrace_cc_objects")
load(":sources.bzl", "PAM_SOURCES")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
bsd_dtrace_header(
    name = "provider", source = "pamchain_provider.d", output = "pamchain_provider.h",
    flags = ["-C", "-x", "nolibs"], object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:bootstrap", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti",
    runtime_libraries = ["//cddl/usr.sbin/dtrace:bootstrap_runtime"],
    tool_inputs = [ "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"], static_anchor = True,
)
cc_library(name = "provider_headers", hdrs = [":provider"], strip_include_prefix = ".")
cc_library(name = "objects", srcs = PAM_SOURCES,
    deps = ["//contrib/openpam:headers"], implementation_deps = ["//contrib/openpam:private_headers"] + select({_TRACE: [":provider_headers"], "//conditions:default": []}),
    local_defines = ['LOCALBASE=\\"/usr/local\\"', "LIB_MAJ=6", "OPENPAM_DEBUG", "HAVE_DLFUNC=1", "HAVE_FDLOPEN=1", "HAVE_FPURGE=1", "HAVE_STRLCAT=1", "HAVE_STRLCPY=1"] + select({_TRACE: ["WITH_COVERAGE_DTRACE"], "//conditions:default": []}),
    linkstatic = True, target_compatible_with = _PLATFORM)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider", provider_object = "pamchain_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group) for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"], deps = [":provider_link"])
cc_library(name = "pam", deps = ["//contrib/openpam:headers"] + select({_TRACE: [":traced"], "//conditions:default": [":objects"]}),
    linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_shared_library(name = "pam_shared", deps = [":pam"], shared_lib_name = "libpam.so.6",
    user_link_flags = ["-Wl,-soname,libpam.so.6", "-Wl,--fatal-warnings,--warn-shared-textrel"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "pam_installation")
pam_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

cc_library(name = "module_headers", hdrs = ["security/pam_mod_misc.h"], strip_include_prefix = ".", visibility = ["//visibility:public"])
