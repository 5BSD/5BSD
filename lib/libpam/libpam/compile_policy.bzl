def pam_warnings(level):
    if level not in _WARNINGS:
        fail("unsupported PAM warning level: " + str(level))
    flags = _WARNINGS[level]
    return flags[:1] + select({"//tools/build/bazel/config:werror_enabled": ["-Werror"], "//conditions:default": []}) + flags[1:]
