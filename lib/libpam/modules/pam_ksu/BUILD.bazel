load("//lib/libpam/modules:module.bzl", "pam_module")
pam_module(
    name = "pam_ksu",
    srcs = ["pam_ksu.c", "pam_ksu_probes.h"],
    provider = "pam_ksu_provider.d",
    deps = ["//krb5/lib/krb5:krb5", "//crypto/krb5/src/include:internal_headers", "//lib/libpam/libpam:module_headers"],
    dynamic_deps = ["//krb5/lib/krb5:krb5_shared"],
    copts = ["-include", "k5-int.h"],
    local_defines = ["MK_MITKRB5=yes"],
    package = "kerberos",
)
