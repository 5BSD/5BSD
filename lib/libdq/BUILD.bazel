load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "headers", hdrs = ["libdq.h"], deps = ["//sys/dev/dq:headers"], strip_include_prefix = ".",
    visibility = ["//visibility:public"])
# Make installs ordinary objects in libdq.a and uses -fpic for shared objects.
# Let rules_cc select each variant; target-wide PIC would also change the archive.
cc_library(name = "dq", srcs = ["libdq.c", "libdq_serve.c", "libdq_tree.c"], features = ["bsd_small_pic"],
    deps = [":headers", "//lib/libcapability:capability", "//lib/libthr:thr"],
    linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":dq"], target_compatible_with = _PLATFORM,
    visibility = ["//visibility:public"])
cc_shared_library(name = "dq_shared", deps = [":dq"],
    dynamic_deps = ["//lib/libcapability:capability_shared", "//lib/libthr:thr_shared"],
    shared_lib_name = "libdq.so.1", user_link_flags = ["-Wl,-soname,libdq.so.1", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Library-only payload; the kernel tests live under //tests/sys/dq and are
# packaged as dq-tests from there.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//lib:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=dq","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
