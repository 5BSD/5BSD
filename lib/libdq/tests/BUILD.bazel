#
# Native runs of the libdq tests.  The walker cases need nothing; the
# dq_serve_file() cases fail without /dev/dq.  Installation (the dq-tests
# package, /usr/tests/lib/libdq) is the make build's; lib/libdq's install
# archive does not yet carry a test manifest.  libdq_link_test is make-only:
# it checks the installed libdq.so.1 through dlopen(3), which a static
# native run cannot exercise.
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
cc_binary(name = "libdq_test", srcs = ["libdq_test.c"],
    deps = ["//lib/libdq:dq", "//lib/libthr:thr", "//lib/atf/libatf-c:atf_c",
        "//tests/sys/dq/libdqtest:support"],
    linkopts = ["-static"], linkstatic = True, visibility = ["//visibility:public"])
_CASES = ["walk_padded_records", "accessor_bounds", "errno_allow_lists", "serve_each_op", "serve_locks",
    "async_accessors", "serve_mmap_writeback", "resolve_accessor"]
[bsd_atf_test(name = case, case_name = case, body = ":libdq_test", interface = "program",
    runner = "//tools/build/bazel:atf_runner", body_timeout_seconds = 60,
    size = "small", timeout = "moderate") for case in _CASES]
test_suite(name = "native_tests", tests = [":" + case for case in _CASES], visibility = ["//visibility:public"])
