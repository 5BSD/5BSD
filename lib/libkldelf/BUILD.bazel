load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
cc_library(name = "headers", hdrs = ["kldelf.h"], strip_include_prefix = ".", deps = ["//lib/libelf:elf"], visibility = ["//visibility:public"])
# Relocation backends register through linker sets, with no ordinary references.
# Preserve every registration in static consumers as well as the shared library.
[cc_library(name = "kldelf" + suffix, srcs = ['ef.c', 'ef_obj.c', 'elf.c', 'ef_aarch64.c', 'ef_arm.c', 'ef_amd64.c', 'ef_i386.c', 'ef_powerpc.c', 'ef_riscv.c'], deps = [":headers"],
    copts = ["-fPIE"] if suffix else [], alwayslink = True, linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
 for suffix in ["", "_pie"]]
bsd_component_archive(name = "static_archive", groups = [":kldelf"], visibility = ["//visibility:public"])
cc_shared_library(name = "kldelf_shared", deps = [":kldelf"], dynamic_deps = ["//lib/libelf:elf_shared"],
    shared_lib_name = "libprivatekldelf.so.5", user_link_flags = ["-Wl,-soname,libprivatekldelf.so.5", "-Wl,-z,defs"], visibility = ["//visibility:public"])
load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//lib:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

