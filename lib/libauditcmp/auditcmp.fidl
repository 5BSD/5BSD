// SPDX-License-Identifier: BSD-2-Clause
// system.Audit (BSDAudit).  The library name, ordinals and layouts are a
// stable contract for wire major 1; incompatible changes need a new major.
// The provider records every submission under the session's channel label
// (the providing service), never under a payload-supplied identity; subject
// names the client the provider acted for.
library bsd.audit.v1;

type ProtocolInfo = struct { wire_version uint32; };
// Subjects and operations: [A-Za-z0-9._/-]{1,64}.
type SubmitRequest = struct {
    // The audited operation's result: 0 or an errno value.
    error int32;
    subject string:64;
    operation string:64;
};
type AuditStats = struct {
    submitted uint64;
    rejected uint64;
};
closed protocol Audit {
    strict GetProtocolInfo() -> (ProtocolInfo);
    // Errors are errno values (EINVAL malformed record, EAGAIN rate limit,
    // or the audit backend's error).
    strict Submit(SubmitRequest) -> () error uint32;
    strict Stats() -> (AuditStats);
};
