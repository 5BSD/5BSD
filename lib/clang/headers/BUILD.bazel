    "arm_bf16.h": ["arm_bf16.td", "-gen-arm-bf16", "arm_neon_inputs"],
    "arm_cde.h": ["arm_cde.td", "-gen-arm-cde-header", "arm_cde_inputs"],
    "arm_fp16.h": ["arm_fp16.td", "-gen-arm-fp16", "arm_fp16_inputs"],
