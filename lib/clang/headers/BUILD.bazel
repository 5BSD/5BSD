[bsd_tablegen(name = name, src = "//contrib/llvm-project/clang/include:clang/Basic/" + config[0],
    includes = ["//contrib/llvm-project/clang/include:" + config[2]],
    include_dirs = ["contrib/llvm-project/clang/include/clang/Basic"],
    flags = [config[1]], output = "generated/" + name,
    tool = "//usr.bin/clang/clang-tblgen:bootstrap",
) for name, config in _GENERATED.items()]
filegroup(name = "generated_headers", srcs = [":" + name for name in _GENERATED], visibility = ["//visibility:public"])

[bsd_install_file(name = "header_" + name.replace("/", "_"),
    src = ":" + name if name in _GENERATED else "//contrib/llvm-project/clang/lib/Headers:" + name,
    destination = "/usr/lib/clang/21/include/" + name,
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=clang", "dev"],
) for name in _SOURCE_HEADERS + _CONFLICTING_HEADERS + _GENERATED.keys()]
bsd_install_manifest(name = "install_manifest",
    entries = [":header_" + name.replace("/", "_") for name in _SOURCE_HEADERS + _GENERATED.keys()] +
        select({"//tools/build/bazel/config:install_conflicting_clang_headers_enabled": [":header_" + name.replace("/", "_") for name in _CONFLICTING_HEADERS], "//conditions:default": []}),
    visibility = ["//visibility:public"])
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"],
    visibility = ["//lib/clang:__pkg__"],
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.include.dist": "/usr/include"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])
