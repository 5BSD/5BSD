exports_files(["freebsd_cc_version.h"], visibility = ["//contrib/llvm-project/clang/lib/Basic:__pkg__"])

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
_COMPILER_MANIFESTS = ["//usr.bin/clang/clang:install_manifest", "//lib/clang/headers:install_manifest", "//lib/clang/libllvm:install_manifest", "//lib/clang/libclang:install_manifest"]
# Compiler driver, resource headers and private libraries; system runtime and
# linker packages remain separate dependencies of an installed toolchain.
bsd_install_archive(name = "compiler_install_archive",
    manifests = _COMPILER_MANIFESTS,
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.include.dist": "/usr/include", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])

# Compiler/linker and maintained utilities; debugger, extras and system runtime
# remain separate. Optional formatting follows its library configuration.
bsd_install_archive(name = "compiler_tools_install_archive",
    manifests = _COMPILER_MANIFESTS + ["//usr.bin/clang/lld:install_manifest", "//usr.bin/clang/toolchain:install_manifest", "//usr.bin/clang/clang-scan-deps:install_manifest", "//usr.bin/clang/llvm-profdata:install_manifest"] + select({"//tools/build/bazel/config:clang_format_or_extras_enabled": ["//usr.bin/clang/clang-format:install_manifest"], "//conditions:default": []}),
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.include.dist": "/usr/include", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])

load("@rules_cc//cc:defs.bzl", "cc_test")
cc_test(name = "utilities_test", srcs = ["llvm_utilities_test.c", "tool_test.h"],
    data = ["//usr.bin/clang/clang:clang", "//usr.bin/clang/llvm-nm:llvm-nm", "//usr.bin/clang/llvm-cxxfilt:llvm-cxxfilt", "//usr.bin/clang/llvm-size:llvm-size", "//usr.bin/clang/llvm-strings:llvm-strings", "//usr.bin/clang/llvm-readobj:llvm-readobj", "//usr.bin/clang/llvm-symbolizer:llvm-symbolizer", "//usr.bin/clang/lld:ld.lld", "//usr.bin/clang/llvm-objcopy:llvm-objcopy", "//usr.bin/clang/llvm-objdump:llvm-objdump"],
    args = ["$(location //usr.bin/clang/clang:clang)", "$(location //usr.bin/clang/llvm-nm:llvm-nm)", "$(location //usr.bin/clang/llvm-cxxfilt:llvm-cxxfilt)", "$(location //usr.bin/clang/llvm-size:llvm-size)", "$(location //usr.bin/clang/llvm-strings:llvm-strings)", "$(location //usr.bin/clang/llvm-readobj:llvm-readobj)", "$(location //usr.bin/clang/llvm-symbolizer:llvm-symbolizer)", "$(location //usr.bin/clang/lld:ld.lld)", "$(location //usr.bin/clang/llvm-objcopy:llvm-objcopy)", "$(location //usr.bin/clang/llvm-objdump:llvm-objdump)"],
    linkopts = ["-static"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])

cc_test(name = "profiles_test", srcs = ["llvm_profiles_test.c", "tool_test.h"],
    data = ["//usr.bin/clang/clang:coverage_probe", "//usr.bin/clang/llvm-profdata:llvm-profdata", "//usr.bin/clang/llvm-cov:llvm-cov"],
    args = ["$(location //usr.bin/clang/clang:coverage_probe)", "$(location //usr.bin/clang/llvm-profdata:llvm-profdata)", "$(location //usr.bin/clang/llvm-cov:llvm-cov)"],
    linkopts = ["-static"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])

cc_test(name = "clang_tools_test", srcs = ["clang_tools_test.c", "tool_test.h"],
    data = ["//usr.bin/clang/clang:clang", "//usr.bin/clang/clang-scan-deps:clang-scan-deps", "//usr.bin/clang/clang-format:clang-format"],
    args = ["$(location //usr.bin/clang/clang:clang)", "$(location //usr.bin/clang/clang-scan-deps:clang-scan-deps)", "$(location //usr.bin/clang/clang-format:clang-format)"],
    linkopts = ["-static"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"] + select({"//tools/build/bazel/config:clang_format_or_extras_enabled": [], "//conditions:default": ["@platforms//:incompatible"]}), visibility = ["//visibility:public"])

# Debugger package components in maintained selected-world order. Their private
# Clang/LLVM runtime packages remain explicit separate dependency components.
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive_set")
_DEBUGGER_COMPONENTS = ["//lib/clang/liblldb", "//usr.bin/clang/lldb", "//usr.bin/clang/lldb-server"]
filegroup(name = "debugger_products", srcs = select({
    "//tools/build/bazel/config:lldb_enabled": ["//lib/clang/liblldb:lldb_shared", "//usr.bin/clang/lldb:lldb", "//usr.bin/clang/lldb-server:lldb-server"],
    "//conditions:default": [],
}), visibility = ["//visibility:public"])
# Preserve each component's directory/package-tag context; do not flatten them.
bsd_install_archive_set(name = "debugger_installation_archives", archives = select({
    "//tools/build/bazel/config:lldb_enabled": [c + ":install_archive" for c in _DEBUGGER_COMPONENTS],
    "//conditions:default": [],
}), visibility = ["//visibility:public"])
test_suite(name = "debugger_safe_tests", tests = [
    "//lib/clang/liblldb:api_smoke_test", "//usr.bin/clang/lldb:safe_cli_test", "//usr.bin/clang/lldb-server:safe_cli_test",
], visibility = ["//visibility:public"])

load("@bazel_skylib//lib:selects.bzl", "selects")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive_set")
selects.config_setting_group(name = "clang_or_lldb", match_any = [
    "//tools/build/bazel/config:clang_enabled", "//tools/build/bazel/config:lldb_enabled"])
# Exact lib/clang/Makefile shared-library profile: llvm always, clang + resource
# headers for CLANG or LLDB, debugger library for LLDB. No tool executables here.
bsd_install_archive_set(name = "production_installation_archives",
    archives = ["//lib/clang/libllvm:install_archive"] + select({
        ":clang_or_lldb": ["//lib/clang/libclang:install_archive", "//lib/clang/headers:install_archive"],
        "//conditions:default": [],
    }) + select({"//tools/build/bazel/config:lldb_enabled": ["//lib/clang/liblldb:install_archive"], "//conditions:default": []}),
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
