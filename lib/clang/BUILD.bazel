exports_files(["freebsd_cc_version.h"], visibility = ["//contrib/llvm-project/clang/lib/Basic:__pkg__"])

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
# Compiler driver, resource headers and private libraries; system runtime and
# linker packages remain separate dependencies of an installed toolchain.
bsd_install_archive(name = "compiler_install_archive",
    manifests = ["//usr.bin/clang/clang:install_manifest", "//lib/clang/headers:install_manifest", "//lib/clang/libllvm:install_manifest", "//lib/clang/libclang:install_manifest"],
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.include.dist": "/usr/include", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])

load("@rules_cc//cc:defs.bzl", "cc_test")
cc_test(name = "utilities_test", srcs = ["llvm_utilities_test.c"],
    data = ["//usr.bin/clang/clang:clang", "//usr.bin/clang/llvm-nm:llvm-nm", "//usr.bin/clang/llvm-cxxfilt:llvm-cxxfilt", "//usr.bin/clang/llvm-size:llvm-size", "//usr.bin/clang/llvm-strings:llvm-strings", "//usr.bin/clang/llvm-readobj:llvm-readobj", "//usr.bin/clang/llvm-symbolizer:llvm-symbolizer", "//usr.bin/clang/lld:ld.lld"],
    args = ["$(location //usr.bin/clang/clang:clang)", "$(location //usr.bin/clang/llvm-nm:llvm-nm)", "$(location //usr.bin/clang/llvm-cxxfilt:llvm-cxxfilt)", "$(location //usr.bin/clang/llvm-size:llvm-size)", "$(location //usr.bin/clang/llvm-strings:llvm-strings)", "$(location //usr.bin/clang/llvm-readobj:llvm-readobj)", "$(location //usr.bin/clang/llvm-symbolizer:llvm-symbolizer)", "$(location //usr.bin/clang/lld:ld.lld)"],
    linkopts = ["-static"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
