load("@rules_cc//cc:defs.bzl", "cc_library")
# Maintained FreeBSD LLVM configuration; not configure results from the host.
cc_library(
    name = "headers",
    hdrs = glob(["llvm/**/*.h", "llvm/**/*.def"]),
    includes = ["."],
    visibility = ["//visibility:public"],
)

cc_library(name = "clang_headers", hdrs = ["VCSVersion.inc"] + glob(["clang/**/*.h", "clang/**/*.inc"]), includes = ["."], visibility = ["//visibility:public"])

cc_library(name = "lld_headers", hdrs = ["VCSVersion.inc", "lld/Common/Version.inc"], includes = ["."], visibility = ["//contrib/llvm-project/lld:__pkg__"])
