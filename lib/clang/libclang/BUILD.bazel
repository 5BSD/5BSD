[bsd_tablegen(name = output.replace("/", "_").removesuffix(".inc"),
    src = "//contrib/llvm-project/clang/include:" + config[1],
    includes = [config[2]] if config[2] else [],
    include_dirs = ["contrib/llvm-project/clang/include"], flags = [config[0]],
    output = output, tool = "//usr.bin/clang/clang-tblgen:bootstrap",
