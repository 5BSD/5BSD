cc_library(name = "ast_definition_headers", hdrs = [":" + output.replace("/", "_").removesuffix(".inc") for output in _AST_DEFINITIONS], strip_include_prefix = ".", visibility = ["//visibility:public"])
filegroup(name = "ast_definition_outputs", srcs = [":" + output.replace("/", "_").removesuffix(".inc") for output in _AST_DEFINITIONS], visibility = ["//visibility:public"])
