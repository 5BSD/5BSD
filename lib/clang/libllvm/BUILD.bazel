# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_tablegen.bzl", "bsd_tablegen")
[bsd_tablegen(name = name,
    src = "//contrib/llvm-project/llvm/include:llvm/Frontend/" + source,
    includes = ["//contrib/llvm-project/llvm/include:llvm/Frontend/Directive/DirectiveBase.td"],
    include_dirs = ["contrib/llvm-project/llvm/include"], flags = [flag],
    output = "llvm/Frontend/" + output, tool = "//usr.bin/clang/llvm-tblgen:bootstrap",
) for name, source, flag, output in [
    ("openacc_impl", "OpenACC/ACC.td", "--gen-directive-impl", "OpenACC/ACC.inc"),
    ("openmp_decl", "OpenMP/OMP.td", "--gen-directive-decl", "OpenMP/OMP.h.inc"),
    ("openmp_impl", "OpenMP/OMP.td", "--gen-directive-impl", "OpenMP/OMP.inc"),
]]
cc_library(name = "directive_headers", hdrs = [":openacc_impl", ":openmp_decl", ":openmp_impl"], strip_include_prefix = ".", visibility = ["//visibility:public"])
filegroup(name = "directive_outputs", srcs = [":openacc_impl", ":openmp_decl", ":openmp_impl"], visibility = ["//visibility:public"])

_TARGET_DEFINITIONS = [
    [
        "AArch64",
        "AArch64",
        "-gen-arm-target-def",
        "AArch64TargetParserDef.inc"
    ],
    [
        "ARM",
        "ARM",
        "-gen-arm-target-def",
        "ARMTargetParserDef.inc"
    ],
    [
        "RISCV",
        "RISCV",
        "-gen-riscv-target-def",
        "RISCVTargetParserDef.inc"
    ],
    [
        "PowerPC",
        "PPC",
        "-gen-target-features",
        "PPCGenTargetFeatures.inc"
    ]
]
[bsd_tablegen(name = arch.lower() + "_target_definitions",
    src = "//contrib/llvm-project/llvm/lib/Target/" + arch + ":" + stem + ".td",
    includes = ["//contrib/llvm-project/llvm/lib/Target/" + arch + ":definitions", "//contrib/llvm-project/llvm/include:" + arch.lower() + "_target_inputs"],
    include_dirs = ["contrib/llvm-project/llvm/include", "contrib/llvm-project/llvm/lib/Target/" + arch],
    flags = [flag], output = "llvm/TargetParser/" + output, tool = "//usr.bin/clang/llvm-tblgen:bootstrap",
) for arch, stem, flag, output in _TARGET_DEFINITIONS]
cc_library(name = "target_definition_headers", hdrs = [":" + arch.lower() + "_target_definitions" for arch, _, _, _ in _TARGET_DEFINITIONS], strip_include_prefix = ".", visibility = ["//visibility:public"])
filegroup(name = "target_definition_outputs", srcs = [":" + arch.lower() + "_target_definitions" for arch, _, _, _ in _TARGET_DEFINITIONS], visibility = ["//visibility:public"])

bsd_tablegen(name = "attributes", src = "//contrib/llvm-project/llvm/include:llvm/IR/Attributes.td", flags = ["-gen-attrs"], output = "llvm/IR/Attributes.inc", tool = "//usr.bin/clang/llvm-tblgen:bootstrap", visibility = ["//visibility:public"])
bsd_tablegen(name = "intrinsic_enums", src = "//contrib/llvm-project/llvm/include:llvm/IR/Intrinsics.td", includes = ["//contrib/llvm-project/llvm/include:intrinsic_definitions"], include_dirs = ["contrib/llvm-project/llvm/include"], flags = ["-gen-intrinsic-enums"], output = "llvm/IR/IntrinsicEnums.inc", tool = "//usr.bin/clang/llvm-tblgen:bootstrap", visibility = ["//visibility:public"])

cc_library(name = "ir_generated_headers", hdrs = [":attributes", ":intrinsic_enums"], strip_include_prefix = ".", visibility = ["//visibility:public"])

_INTRINSIC_ARCHITECTURES = {
    "AArch64": "aarch64",
    "AMDGPU": "amdgcn",
    "ARM": "arm",
    "BPF": "bpf",
    "DirectX": "dx",
    "Hexagon": "hexagon",
    "LoongArch": "loongarch",
    "Mips": "mips",
    "NVPTX": "nvvm",
    "PowerPC": "ppc",
    "R600": "r600",
    "RISCV": "riscv",
    "S390": "s390",
    "SPIRV": "spv",
    "VE": "ve",
    "WebAssembly": "wasm",
    "X86": "x86",
    "XCore": "xcore"
}
[bsd_tablegen(name = "intrinsics_" + arch,
    src = "//contrib/llvm-project/llvm/include:llvm/IR/Intrinsics.td",
    includes = ["//contrib/llvm-project/llvm/include:intrinsic_definitions"],
    include_dirs = ["contrib/llvm-project/llvm/include"],
    flags = ["-gen-intrinsic-enums", "-intrinsic-prefix=" + prefix],
    output = "llvm/IR/Intrinsics" + arch + ".h", tool = "//usr.bin/clang/llvm-tblgen:bootstrap",
) for arch, prefix in _INTRINSIC_ARCHITECTURES.items()]
bsd_tablegen(name = "intrinsic_implementation", src = "//contrib/llvm-project/llvm/include:llvm/IR/Intrinsics.td",
    includes = ["//contrib/llvm-project/llvm/include:intrinsic_definitions"], include_dirs = ["contrib/llvm-project/llvm/include"],
    flags = ["-gen-intrinsic-impl"], output = "llvm/IR/IntrinsicImpl.inc", tool = "//usr.bin/clang/llvm-tblgen:bootstrap")
bsd_tablegen(name = "runtime_libcalls", src = "//contrib/llvm-project/llvm/include:llvm/IR/RuntimeLibcalls.td",
    includes = ["//contrib/llvm-project/llvm/include:llvm/IR/RuntimeLibcallsImpl.td", "//contrib/llvm-project/llvm/include:llvm/TableGen/SetTheory.td"],
    include_dirs = ["contrib/llvm-project/llvm/include"], flags = ["-gen-runtime-libcalls"],
    output = "llvm/IR/RuntimeLibcalls.inc", tool = "//usr.bin/clang/llvm-tblgen:bootstrap")
_INTRINSIC_OUTPUTS = [":intrinsics_" + arch for arch in _INTRINSIC_ARCHITECTURES] + [":intrinsic_implementation", ":runtime_libcalls"]
cc_library(name = "intrinsic_headers", hdrs = _INTRINSIC_OUTPUTS, deps = [":ir_generated_headers"], strip_include_prefix = ".", visibility = ["//visibility:public"])
filegroup(name = "intrinsic_outputs", srcs = _INTRINSIC_OUTPUTS, visibility = ["//visibility:public"])

_X86_TABLES = [('AsmMatcher', ['-gen-asm-matcher']), ('AsmWriter', ['-gen-asm-writer']), ('AsmWriter1', ['-gen-asm-writer', '-asmwriternum=1']), ('CallingConv', ['-gen-callingconv']), ('DAGISel', ['-gen-dag-isel']), ('DisassemblerTables', ['-gen-disassembler']), ('FastISel', ['-gen-fast-isel']), ('FoldTables', ['-gen-x86-fold-tables', '-asmwriternum=1']), ('GlobalISel', ['-gen-global-isel']), ('InstrInfo', ['-gen-instr-info', '-instr-info-expand-mi-operand-info=0']), ('InstrMapping', ['-gen-x86-instr-mapping']), ('MnemonicTables', ['-gen-x86-mnemonic-tables', '-asmwriternum=1']), ('RegisterBank', ['-gen-register-bank']), ('RegisterInfo', ['-gen-register-info']), ('SubtargetInfo', ['-gen-subtarget'])]
[bsd_tablegen(name = "x86_" + stem.lower(),
    src = "//contrib/llvm-project/llvm/lib/Target/X86:X86.td",
    includes = ["//contrib/llvm-project/llvm/lib/Target/X86:definitions", "//contrib/llvm-project/llvm/include:x86_target_inputs"],
    include_dirs = ["contrib/llvm-project/llvm/include", "contrib/llvm-project/llvm/lib/Target/X86"],
    flags = flags, output = "X86Gen" + stem + ".inc", tool = "//usr.bin/clang/llvm-tblgen:bootstrap",
) for stem, flags in _X86_TABLES]
cc_library(name = "x86_generated_headers", hdrs = [":x86_" + stem.lower() for stem, _ in _X86_TABLES], strip_include_prefix = ".", visibility = ["//visibility:public"])
filegroup(name = "x86_generated_outputs", srcs = [":x86_" + stem.lower() for stem, _ in _X86_TABLES], visibility = ["//visibility:public"])

_ARM_TABLES = [('AsmMatcher', ['-gen-asm-matcher']), ('AsmWriter', ['-gen-asm-writer']), ('CallingConv', ['-gen-callingconv']), ('DAGISel', ['-gen-dag-isel']), ('DisassemblerTables', ['-gen-disassembler']), ('FastISel', ['-gen-fast-isel']), ('GlobalISel', ['-gen-global-isel']), ('InstrInfo', ['-gen-instr-info']), ('MCCodeEmitter', ['-gen-emitter']), ('MCPseudoLowering', ['-gen-pseudo-lowering']), ('RegisterBank', ['-gen-register-bank']), ('RegisterInfo', ['-gen-register-info']), ('SubtargetInfo', ['-gen-subtarget']), ('SystemRegister', ['-gen-searchable-tables'])]
[bsd_tablegen(name = "arm_" + stem.lower(),
    src = "//contrib/llvm-project/llvm/lib/Target/ARM:ARM.td",
    includes = ["//contrib/llvm-project/llvm/lib/Target/ARM:definitions", "//contrib/llvm-project/llvm/include:arm_target_inputs"],
    include_dirs = ["contrib/llvm-project/llvm/include", "contrib/llvm-project/llvm/lib/Target/ARM"],
    flags = flags, output = "ARMGen" + stem + ".inc", tool = "//usr.bin/clang/llvm-tblgen:bootstrap",
) for stem, flags in _ARM_TABLES]
cc_library(name = "arm_generated_headers", hdrs = [":arm_" + stem.lower() for stem, _ in _ARM_TABLES], strip_include_prefix = ".", visibility = ["//visibility:public"])
filegroup(name = "arm_generated_outputs", srcs = [":arm_" + stem.lower() for stem, _ in _ARM_TABLES], visibility = ["//visibility:public"])

_POWERPC_TABLES = [('AsmMatcher', ['-gen-asm-matcher']), ('AsmWriter', ['-gen-asm-writer']), ('CallingConv', ['-gen-callingconv']), ('DAGISel', ['-gen-dag-isel']), ('DisassemblerTables', ['-gen-disassembler']), ('FastISel', ['-gen-fast-isel']), ('GlobalISel', ['-gen-global-isel']), ('InstrInfo', ['-gen-instr-info']), ('MCCodeEmitter', ['-gen-emitter']), ('RegisterBank', ['-gen-register-bank']), ('RegisterInfo', ['-gen-register-info']), ('SubtargetInfo', ['-gen-subtarget'])]
[bsd_tablegen(name = "powerpc_" + stem.lower(),
    src = "//contrib/llvm-project/llvm/lib/Target/PowerPC:PPC.td",
    includes = ["//contrib/llvm-project/llvm/lib/Target/PowerPC:definitions", "//contrib/llvm-project/llvm/include:powerpc_target_inputs"],
    include_dirs = ["contrib/llvm-project/llvm/include", "contrib/llvm-project/llvm/lib/Target/PowerPC"],
    flags = flags, output = "PPCGen" + stem + ".inc", tool = "//usr.bin/clang/llvm-tblgen:bootstrap",
) for stem, flags in _POWERPC_TABLES]
cc_library(name = "powerpc_generated_headers", hdrs = [":powerpc_" + stem.lower() for stem, _ in _POWERPC_TABLES], strip_include_prefix = ".", visibility = ["//visibility:public"])
filegroup(name = "powerpc_generated_outputs", srcs = [":powerpc_" + stem.lower() for stem, _ in _POWERPC_TABLES], visibility = ["//visibility:public"])
