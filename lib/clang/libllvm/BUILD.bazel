# Imported native aggregate preserves exactly the selected installed LLVM objects.
# Compression/terminal libraries remain executable dependencies, as in llvm.prog.mk.
cc_import(name = "llvm", pic_static_library = ":pic_archive",
    deps = ["//lib/libc++:cxx", "//lib/msun:m"], visibility = ["//visibility:public"])
cc_shared_library(name = "llvm_shared", deps = [":llvm"],
    dynamic_deps = ["//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared"],
    shared_lib_name = "libprivatellvm.so.21",
    user_link_flags = ["-Wl,-soname,libprivatellvm.so.21", "-Wl,--gc-sections", "-Wl,-znow", "-Wl,-zrelro", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
