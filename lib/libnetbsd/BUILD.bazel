load("@rules_cc//cc:defs.bzl", "cc_library")
# NetBSD compatibility interfaces and internal implementation.
cc_library(name = "util_header", hdrs = ["util.h"], strip_include_prefix = ".",
    deps = ["//lib/libutil:util"], visibility = ["//visibility:public"])

cc_library(name = "cdefs_header", hdrs = ["sys/cdefs.h"], strip_include_prefix = ".", visibility = ["//visibility:public"])

# The override headers used by netbsd-tests.test.mk. Runtime compatibility
# functions require a separate implementation dependency when referenced.
cc_library(
    name = "compat_headers",
    hdrs = [
        "glob.h", "math.h", "netinet/in.h", "pthread.h", "rmd160.h",
        "sha1.h", "sha2.h", "stdlib.h", "sys/cdefs.h", "sys/event.h",
        "sys/time.h", "sys/types.h", "sys/wait.h", "util.h",
    ],
    strip_include_prefix = ".",
    deps = ["//lib/libutil:headers"],
    visibility = ["//visibility:public"],
)

load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
# INTERNALLIB: ordinary and PIE archives; no installed library or API headers.
[cc_library(
    name = "netbsd" + suffix,
    srcs = ["efun.c", "sockaddr_snprintf.c", "strsuftoll.c", "util.c"],
    deps = [":compat_headers"],
    copts = ["-fPIE"] if suffix else [],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
) for suffix in ["", "_pie"]]
bsd_component_archive(name = "static_archive", groups = [":netbsd"], visibility = ["//visibility:public"])
bsd_component_archive(name = "pie_archive", groups = [":netbsd_pie"], visibility = ["//visibility:public"])
