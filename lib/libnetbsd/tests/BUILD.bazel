load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
cc_binary(name = "efun_test", srcs = ["//contrib/netbsd-tests/lib/libutil:t_efun.c"],
    deps = ["//lib/libnetbsd:netbsd_pie", "//lib/atf/libatf-c:atf_c"],
    dynamic_deps = ["//lib/atf/libatf-c:atf_c_shared"],
    copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
[bsd_atf_test(name = "native_" + case, case_name = case, interface = "program",
    body = ":efun_test", runner = "//tools/build/bazel:atf_runner",
    runtime_lib = ["//lib/atf/libatf-c:atf_c_shared", "@bsd_sdk//toolchain:sysroot/lib/libc.so.7",
                   "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"], size = "small")
 for case in ["ecalloc", "efopen", "emalloc", "erealloc"]]
test_suite(name = "tests", tests = [":native_" + case for case in ["ecalloc", "efopen", "emalloc", "erealloc"]],
    visibility = ["//visibility:public"])
