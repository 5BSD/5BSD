# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_binary")
load(":modules.bzl", "citrus_module")
cc_library(name = "headers", hdrs = glob(["*/*.h"]))
load(":sources.bzl", "MODULE_SOURCES")
[citrus_module(name = name, src = source) for name, source in MODULE_SOURCES]
# mapper_parallel deliberately uses the serial source, as maintained Make does.

cc_binary(name = "module_load_program", srcs = ["module_load_test.c"],
    deps = ["//lib/libc:shared_link_interface"],
    dynamic_deps = ["//lib/libc:c_shared", "//lib/libsys:sys_shared"],
    linkopts = ["-nodefaultlibs"], testonly = True)

cc_library(name = "mapper_file_header", hdrs = ["mapper_std/citrus_mapper_std_file.h"],
    strip_include_prefix = "mapper_std", visibility = ["//usr.bin/mkcsmapper:__pkg__"])

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "install_archive",
    manifests = [":" + name + "_install_manifest" for name, _ in MODULE_SOURCES],
    directories = {path: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for path in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib", "/usr/lib/debug/usr/lib/i18n"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
    visibility = ["//visibility:public"])
