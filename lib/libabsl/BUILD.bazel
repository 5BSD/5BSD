# Abseil as the private shared library libprivateabsl (lib/libabsl/Makefile):
# PRIVATELIB, LIB_CXX, SHLIB_MAJOR 2501, CXXSTD c++17, -I contrib/abseil-cpp,
# LIBADD pthread.  Sources keep Makefile SRCS order; randen_hwaes.cc, which
# Make alone compiles with -maes -msse4.1 (CXXFLAGS.randen_hwaes.cc), is its
# own group so the archive members keep that order.
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
