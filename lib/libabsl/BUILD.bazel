# LIBADD pthread precedes the C++ driver's -lc++ -lm (Make NEEDED order).
_DEPS = ["//contrib/abseil-cpp:headers", "//contrib/llvm-project/libcxx/include:headers", "//lib/libthr:thr", "//lib/libc++:cxx", "//lib/libcxxrt:cxxrt", "//lib/msun:m"]
_COPTS = ["-std=c++17", "-nostdinc++"]
[cc_library(name = name, srcs = ["//contrib/abseil-cpp:" + source for source in sources], deps = _DEPS,
    copts = _COPTS + extra, linkstatic = True, target_compatible_with = _PLATFORM)
 for name, sources, extra in [
    ("objects_before_hwaes", SOURCES_BEFORE_HWAES, []),
    ("randen_hwaes", ["absl/random/internal/randen_hwaes.cc"], ["-maes", "-msse4.1"]),
    ("objects_after_hwaes", SOURCES_AFTER_HWAES, []),
 ]]
_GROUPS = [":objects_before_hwaes", ":randen_hwaes", ":objects_after_hwaes"]
cc_library(name = "absl", deps = _GROUPS + _DEPS, linkstatic = True, target_compatible_with = _PLATFORM,
    visibility = ["//lib/protobuf:__subpackages__", "//lib/libotelexport/tests/pbcpp:__pkg__", "//usr.bin/protoc:__pkg__", "//libexec/protoc-gen-upb:__pkg__",
        "//libexec/protoc-gen-upb_minitable:__pkg__", "//libexec/protoc-gen-upbdefs:__pkg__"])
bsd_component_archive(name = "static_archive", groups = _GROUPS, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_shared_library(name = "absl_shared", deps = [":absl"],
    dynamic_deps = ["//lib/libthr:thr_shared", "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared"],
    shared_lib_name = "libprivateabsl.so.2501", user_link_flags = ["-Wl,-soname,libprivateabsl.so.2501", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Private library installation (package protobuf).
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=protobuf","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]} |
        {"/usr/share/licenses/abseil-cpp": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=protobuf"]}'},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
