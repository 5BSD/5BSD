# SPDX-License-Identifier: BSD-2-Clause
#
# Abseil (contrib/abseil-cpp) as one private shared library,
# libprivateabsl.so.  The sources are upstream's own single-library
# composition (CMake/AbseilDll.cmake ABSL_INTERNAL_DLL_FILES, the
# "abseil_dll" target), not the ~90 per-component libraries of a default
# CMake build.  Its consumers are libprivateprotobuf, protoc and the upb
# code generators.  The headers are installed under /usr/include/private
# for base consumers of the protobuf C++ API; contrib/abseil-cpp/README.5BSD
# records the version and the local configuration (absl/base/options.h).
#
# buildworld also builds this library (static) in the bootstrap-tools stage
# for the bootstrap protoc (Makefile.inc1).

.include <src.opts.mk>

ABSL=		${SRCTOP}/contrib/abseil-cpp

PACKAGE=	protobuf
LIB_CXX=	absl
PRIVATELIB=	true
# ABSL_SOVERSION "2501.0.0" (CMakeLists.txt); base uses the major part.
SHLIB_MAJOR=	2501

CXXSTD=		c++17
CXXFLAGS+=	-I${ABSL}
WARNS?=		1

# Hardware AES for the Randen generator, as upstream's
# ABSL_RANDOM_RANDEN_COPTS (absl/copts/GENERATED_AbseilCopts.cmake).
.if ${MACHINE_CPUARCH} == "amd64" || ${MACHINE_CPUARCH} == "i386"
CXXFLAGS.randen_hwaes.cc+=	-maes -msse4.1
.elif ${MACHINE_CPUARCH} == "aarch64"
CXXFLAGS.randen_hwaes.cc+=	-march=armv8-a+crypto
.elif ${MACHINE_CPUARCH} == "arm"
CXXFLAGS.randen_hwaes.cc+=	-mfpu=neon
.endif

LIBADD=		pthread

.PATH:		${ABSL}

