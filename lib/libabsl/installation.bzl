def library_installation(name):
    bsd_debug_split(name = name + "_debug", src = ":absl_shared",
        binary_name = name + "/libprivateabsl.so.2501", debug_name = name + "/libprivateabsl.so.2501.debug",
        objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy", objcopy_inputs = "@bsd_sdk//toolchain:objcopy_inputs")
    bsd_strip_binary(name = name + "_stripped", src = ":" + name + "_debug", output = name + "/stripped/libprivateabsl.so.2501",
        strip = "@bsd_sdk//toolchain:bin/llvm-strip", strip_inputs = "@bsd_sdk//toolchain:strip_inputs")
    native.filegroup(name = name + "_symbols", srcs = [":" + name + "_debug"], output_group = "debug_files")
    files = [(source, destination, ["package=protobuf", "dev"]) for source, destination in HEADERS]
    files += [
        (":static_archive", "/usr/lib/libprivateabsl.a", ["package=protobuf", "dev"]),
        (":" + name + "_stripped", "/usr/lib/libprivateabsl.so.2501", ["package=protobuf"]),
        (":" + name + "_symbols", "/usr/lib/debug/usr/lib/libprivateabsl.so.2501.debug", ["package=protobuf", "dbg"]),
    ]
    files += [(source, destination, ["package=" + package]) for source, destination, package in LICENSES]
    entries = []
    for source, destination, tags in files:
        target = name + "_file_" + destination.replace("/", "_")
        bsd_install_file(name = target, src = source, destination = destination,
            owner = "root", group = "wheel", mode = "0444", install_tags = tags)
        entries.append(":" + target)
    bsd_install_link(name = name + "_link", destination = "/usr/lib/libprivateabsl.so", target = "libprivateabsl.so.2501",
        kind = "symlink", owner = "root", group = "wheel", mode = "0755", install_tags = ["package=protobuf", "dev"])
    bsd_install_manifest(name = name, entries = entries + [":" + name + "_link"], visibility = ["//visibility:public"])
