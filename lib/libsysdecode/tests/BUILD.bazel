load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_import")
load("//tools/build/bazel:bsd_link_sequence.bzl", "bsd_link_sequence")
load("//lib/libc:test_policy.bzl", "libc_test_copts")
load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
cc_import(name = "test_atf_abi", shared_library = "//lib/atf/libatf-c:atf_c_shared", deps = ["//contrib/atf:c_headers"])
cc_import(name = "test_sysdecode_abi", shared_library = "//lib/libsysdecode:sysdecode_shared", deps = ["//lib/libsysdecode:headers"])
bsd_link_sequence(name = "test_link", deps = [":test_atf_abi", ":test_sysdecode_abi", "//lib/libc:shared_abi_interface"])
cc_binary(name = "sysdecode_test", srcs = ["sysdecode_test.c"], deps = [":test_link"],
    copts = ["-fpie"] + libc_test_copts(6), defines = ["PIC"], linkopts = ["-pie", "-nodefaultlibs"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
bsd_atf_test(name = "native_cap_rights", case_name = "cap_rights",
    interface = "program", body = ":install_manifest_stripped",
    runtime_lib = ["//lib/libsysdecode:sysdecode_shared", "//lib/atf/libatf-c:atf_c_shared",
        "//lib/libc:c_shared", "//lib/libsys:sys_shared"],
    test_environment = {"DTRACE_DOF_INIT_DISABLE": "1"},
    runner = "//tools/build/bazel:atf_runner", size = "small")
test_suite(name = "tests", tests = [":native_cap_rights"], visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_kyuafile")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["sysdecode_test"],
    interfaces = {"sysdecode_test": "atf"})
bsd_install_file(name = "install_kyuafile", src = ":kyuafile",
    destination = "/usr/tests/lib/libsysdecode/Kyuafile", owner = "root", group = "wheel",
    mode = "0444", install_tags = ["package=tests"])
utility_installation(name = "install_manifest", program = "sysdecode_test",
    manual = None, package = "tests", bindir = "/usr/tests/lib/libsysdecode",
    extra_entries = [":install_kyuafile"])
