# These compilation groups currently model the maintained amd64 optimized build.
# Other architectures must receive their own source/flag selections explicitly.
_AMD64 = ["@platforms//cpu:x86_64", "@platforms//os:freebsd"]
_C_DEFINES = ["WEAK_REFS", "MD5_ASM", "SHA1_ASM", "SKEIN_ASM", "SKEIN_USE_ASM=1792"]
_HEADERS = [":headers", "//sys/sys:md_headers", "//sys/crypto/sha2:headers", "//sys/crypto/skein:headers"]

cc_library(
    name = "headers",
    hdrs = ["md4.h", "md5.h", "ripemd.h", "sha.h"],
    strip_include_prefix = "/lib/libmd",
    deps = ["//sys/sys:md_headers"],
)

cc_library(
    name = "common_objects",
    srcs = [
        ":highlevel_sources",
        "//sys/crypto:md4c.c", "//sys/crypto:md5c.c",
        "rmd160c.c", "rmd_locl.h", "rmdconst.h", "sha0c.c", "sha1c.c", "sha_locl.h",
        "//sys/crypto/sha2:sha256c.c", "//sys/crypto/sha2:sha512c.c",
        "//sys/crypto/skein:skein.c",
        "amd64/md5dispatch.c", "amd64/sha1dispatch.c",
    ],
    local_defines = _C_DEFINES,
    deps = _HEADERS,
    target_compatible_with = _AMD64,
)

cc_library(
    name = "skein_block_objects",
    srcs = ["//sys/crypto/skein:skein_block.c"],
    local_defines = _C_DEFINES + ["SKEIN_LOOP=995"],
    deps = _HEADERS,
    target_compatible_with = _AMD64,
)

cc_library(
    name = "assembly_objects",
    srcs = ["amd64/md5block.S", "amd64/sha1block.S", "//sys/crypto/skein:amd64/skein_block_asm.S"],
    local_defines = ["SKEIN_LOOP=0", "ELF"],
    copts = ["-Wa,--noexecstack"],
    deps = _HEADERS,
    target_compatible_with = _AMD64,
)

filegroup(
    name = "compilation",
    srcs = [":common_objects", ":skein_block_objects", ":assembly_objects"],
    target_compatible_with = _AMD64,
    visibility = ["//visibility:public"],
)

# Aggregate the object groups through rules_cc rather than installing only one
# cc_library's archive and silently losing its transitive compilation groups.
cc_static_library(
    name = "md",
    deps = [":common_objects", ":skein_block_objects", ":assembly_objects"],
    target_compatible_with = _AMD64,
    visibility = ["//visibility:public"],
)

# Consume the actual aggregate archive in runtime qualification, not a separate
# reconstruction of its object dependencies.
cc_import(
    name = "md_archive",
    static_library = ":md",
    deps = _HEADERS,
    target_compatible_with = _AMD64,
    visibility = ["//lib/libmd/tests:__pkg__", "//sbin/md5:__pkg__", "//lib/liblzma:__pkg__", "//lib/libarchive:__pkg__"],
)

bsd_configured_version_map(
    name = "version_map",
    symbol_maps = ["Symbol.map"],
    versions = "//lib/libc:Versions.def",
    generator = "//share/mk:version_gen.awk",
    # This symbol inventory has no includes or target-dependent conditionals.
    cpp_flags = ["-P", "-nostdinc", "-undef"],
    compiler = "@bsd_sdk//toolchain:bin/clang",
    compiler_inputs = "@bsd_sdk//toolchain:compile_inputs",
    cat = "@bsd_sdk//toolchain:cat",
    cat_runtime = "@bsd_sdk//toolchain:cat_runtime",
    awk = "@bsd_sdk//toolchain:awk",
    awk_runtime = "@bsd_sdk//toolchain:awk_runtime",
    redirect = "@bsd_sdk//toolchain:stdout_redirect",
)

cc_library(
    name = "md_link",
    deps = [":common_objects", ":skein_block_objects", ":assembly_objects"],
    target_compatible_with = _AMD64,
    # Public CcInfo interface for the installed base library.
    visibility = ["//visibility:public"],
)

cc_shared_library(
    name = "md_shared",
    deps = [":md_link"],
    shared_lib_name = "libmd.so.7",
    additional_linker_inputs = [":version_map"],
    user_link_flags = [
        "-Wl,-soname,libmd.so.7",
        "-Wl,--version-script=$(location :version_map),--no-undefined-version",
        "-Wl,--fatal-warnings,--warn-shared-textrel",
    ],
    target_compatible_with = _AMD64,
    visibility = ["//visibility:public"],
)

bsd_debug_split(
    name = "md_debug",
    src = ":md_shared",
    binary_name = "install/libmd.so.7",
    debug_name = "install/libmd.so.7.debug",
    objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    objcopy_inputs = "@bsd_sdk//toolchain:objcopy_inputs",
)
bsd_strip_binary(
    name = "md_install",
    src = ":md_debug",
    output = "stripped/libmd.so.7",
    strip = "@bsd_sdk//toolchain:bin/llvm-strip",
    strip_inputs = "@bsd_sdk//toolchain:strip_inputs",
    visibility = ["//visibility:public"],
)


