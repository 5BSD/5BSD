libmd_installation(name = "install_manifest")

# Component qualification artifact, not a complete runtime/tests package family.
bsd_install_archive(
    name = "component_archive",
    testonly = True,
    # bsd.test.mk creates these debug ancestors during installation.
    directories = {
        "/usr/lib/debug/usr/tests/lib": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests","dbg"]}',
        "/usr/lib/debug/usr/tests/lib/libmd": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests","dbg"]}',
    },
    manifests = [":install_manifest", "//lib/libmd/tests:install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
        "//etc/mtree:BSD.tests.dist": "/usr/tests",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
    visibility = ["//visibility:public"],
)

# Audits this component's partition only. Runtime/tests contain many additional
# components and their complete package manifests must be aggregated elsewhere.
bsd_pkg_layout(
    name = "component_package_layout",
    scope = "component",
    testonly = True,
    manifests = [":install_manifest", "//lib/libmd/tests:install_manifest"],
    packages = ["runtime", "runtime-dbg", "runtime-dev", "tests", "tests-dbg"] + select({
        "//tools/build/bazel/config:split_manpages_enabled": ["runtime-man"],
        "//conditions:default": [],
    }),
    suffix_tags = ["dbg", "dev"],
    visibility = ["//visibility:public"],
)
