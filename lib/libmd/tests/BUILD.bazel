# Host inspection does not execute foreign digest drivers.
load("//tools/build/bazel:bsd_python_test.bzl", "bsd_host_artifact_test")
config_setting(name = "target_aarch64", constraint_values = ["@platforms//cpu:aarch64"])
config_setting(name = "target_riscv64", constraint_values = ["@platforms//cpu:riscv64"])
bsd_host_artifact_test(name = "archive_contract_test", src = "archive-contract-test.py",
    data = [":md5driver", "//lib/libmd:md_shared", "//lib/libmd:md", "//lib/libmd:md_pic_archive",
            "@bsd_sdk//toolchain:bin/llvm-nm", "@bsd_sdk//toolchain:bin/llvm-ar"],
    args = ["--driver", "$(location :md5driver)", "--shared", "$(location //lib/libmd:md_shared)",
            "--archive", "$(location //lib/libmd:md)", "--pic-archive", "$(location //lib/libmd:md_pic_archive)",
            "--nm", "$(location @bsd_sdk//toolchain:bin/llvm-nm)", "--ar", "$(location @bsd_sdk//toolchain:bin/llvm-ar)",
            "--machine"] + select({":target_aarch64": ["183"], ":target_riscv64": ["243"], "//conditions:default": ["62"]}) +
            ["--optimized"] + select({"//tools/build/bazel/config:machdep_optimizations_enabled": ["true"], "//conditions:default": ["false"]}),
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:llvm-nm_runtime", "@bsd_sdk//toolchain:llvm-ar_runtime"], size = "small")
