load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
cc_library(name = "configuration", hdrs = ["xo_config.h"], strip_include_prefix = ".", visibility = ["//usr.bin/xo:__pkg__", "//lib/libxo/tests:__subpackages__"])
cc_library(name = "xo", srcs = ["//contrib/libxo:libxo/libxo.c", "//contrib/libxo:libxo/xo_encoder.c", "//contrib/libxo:libxo/xo_syslog.c"],
    deps = ["//contrib/libxo:headers", "//lib/libutil:util"],
    implementation_deps = [":configuration", "//contrib/libxo:internal_headers"],
    local_defines = ['XO_ENCODERDIR=\\"/usr/lib/libxo/encoder\\"'],
    linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":xo"], visibility = ["//visibility:public"])
cc_shared_library(name = "xo_shared", deps = [":xo"], dynamic_deps = ["//lib/libutil:util_shared"],
    shared_lib_name = "libxo.so.0", user_link_flags = ["-Wl,-soname,libxo.so.0", "-Wl,--fatal-warnings,--warn-shared-textrel"], visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_import", "cc_test")
cc_import(name = "archive_link", static_library = ":static_archive")
[
    cc_test(name = "format_" + variant, srcs = ["format_test.c"],
        deps = ([":archive_link", "//contrib/libxo:headers", "//lib/libutil:util"] if variant == "static" else [":xo"]),
        dynamic_deps = [] if variant == "static" else [":xo_shared", "//lib/libutil:util_shared"],
        features = [] if variant == "static" else ["bsd_test_runtime_paths"], linkstatic = variant == "static",
        size = "small", target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
    for variant in ["static", "shared"]
]

load(":installation.bzl", "xo_installation")
xo_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//lib/libxo:__pkg__"],
    manifests = [":install_manifest"],
    directories = {"/usr/lib/debug/lib": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime","dbg"]}'},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
