# SPDX-License-Identifier: BSD-2-Clause
# upb, protobuf's C runtime (lib/protobuf/libupb/Makefile): INTERNALLIB, -I
# contrib/protobuf -I upb/reflection/cmake -fvisibility=hidden; libupb.a and
# libupb_pie.a.  Only its licences are installed (package utilities).
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
# Makefile SRCS order.
SOURCES = [
    "upb/base/status.c",
    "upb/hash/common.c",
    "upb/json/decode.c",
    "upb/json/encode.c",
    "upb/lex/atoi.c",
    "upb/lex/round_trip.c",
    "upb/lex/strtod.c",
    "upb/lex/unicode.c",
    "upb/mem/alloc.c",
    "upb/mem/arena.c",
    "upb/message/accessors.c",
    "upb/message/array.c",
    "upb/message/compare.c",
    "upb/message/compat.c",
    "upb/message/copy.c",
    "upb/message/internal/compare_unknown.c",
    "upb/message/internal/extension.c",
    "upb/message/internal/iterator.c",
    "upb/message/internal/message.c",
    "upb/message/map.c",
    "upb/message/map_sorter.c",
    "upb/message/merge.c",
    "upb/message/message.c",
    "upb/mini_descriptor/build_enum.c",
    "upb/mini_descriptor/decode.c",
    "upb/mini_descriptor/internal/base92.c",
    "upb/mini_descriptor/internal/encode.c",
    "upb/mini_descriptor/link.c",
    "upb/mini_table/extension_registry.c",
    "upb/mini_table/internal/message.c",
    "upb/mini_table/message.c",
    "upb/reflection/def_pool.c",
    "upb/reflection/def_type.c",
    "upb/reflection/desc_state.c",
    "upb/reflection/enum_def.c",
    "upb/reflection/enum_reserved_range.c",
    "upb/reflection/enum_value_def.c",
    "upb/reflection/extension_range.c",
    "upb/reflection/field_def.c",
    "upb/reflection/file_def.c",
    "upb/reflection/internal/def_builder.c",
    "upb/reflection/internal/strdup2.c",
    "upb/reflection/message.c",
    "upb/reflection/message_def.c",
    "upb/reflection/message_reserved_range.c",
    "upb/reflection/method_def.c",
    "upb/reflection/oneof_def.c",
    "upb/reflection/service_def.c",
    "upb/text/encode.c",
    "upb/text/internal/encode.c",
    "upb/util/def_to_proto.c",
    "upb/util/required_fields.c",
    "upb/wire/byte_size.c",
    "upb/wire/decode.c",
    "upb/wire/encode.c",
    "upb/wire/eps_copy_input_stream.c",
    "upb/wire/internal/decode_fast.c",
    "upb/wire/reader.c",
    "upb/reflection/cmake/google/protobuf/descriptor.upb_minitable.c",
    "third_party/utf8_range/utf8_range.c",
]
[cc_library(name = "upb" + suffix, srcs = ["//contrib/protobuf:" + source for source in SOURCES],
    deps = ["//contrib/protobuf:upb_headers", "//contrib/protobuf:src_headers"],
    copts = ["-fvisibility=hidden"] + copts, linkstatic = True, target_compatible_with = _PLATFORM,
    visibility = ["//visibility:public"])
 for suffix, copts in [("", []), ("_pie", ["-fpie"])]]
bsd_component_archive(name = "static_archive", groups = [":upb"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "pie_archive", groups = [":upb_pie"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities"]}' for d in ["/usr/share/licenses/upb", "/usr/share/licenses/upb/utf8_range"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
    visibility = ["//visibility:public"],
)
