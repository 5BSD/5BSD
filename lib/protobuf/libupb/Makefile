# upb, the protobuf C runtime, for base C consumers of protoc-generated
# code (protoc-gen-upb, protoc-gen-upb_minitable; lib/protobuf/protoc-gen.mk).
# Internal and static: upstream does not support upb as a shared library
# (cmake/libupb.cmake).  Built with hidden visibility as upstream.

LIB=		upb
INTERNALLIB=

CFLAGS+=	-I${PROTOBUF} \
		-I${PROTOBUF}/upb/reflection/cmake \
		-fvisibility=hidden

# BEGIN generated by the import (contrib/protobuf/README.5BSD)
SRCS+=	upb/base/status.c
