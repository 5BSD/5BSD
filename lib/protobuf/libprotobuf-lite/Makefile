# The protobuf "lite" C++ runtime (MessageLite, no descriptors or
# reflection), libprivateprotobuf-lite.so.  Built as upstream's
# libprotobuf-lite: -fvisibility=hidden with the PROTOBUF_EXPORT API
# exported, the upstream version script, utf8_range linked in.

LIB_CXX=	protobuf-lite
PRIVATELIB=	true
SHLIB_MAJOR=	29

CXXFLAGS+=	-DHAVE_ZLIB=1 -DPROTOBUF_USE_DLLS -DLIBPROTOBUF_EXPORTS \
		-fvisibility=hidden -fvisibility-inlines-hidden
# PROTOBUF_EXPORT on 'enum class' declarations (text_format.h) is ignored
# by clang; upstream builds without -Werror.
CXXWARNFLAGS+=	-Wno-ignored-attributes
LDFLAGS+=	-Wl,--version-script=${PROTOBUF}/src/libprotobuf-lite.map

# BEGIN generated by the import (contrib/protobuf/README.5BSD)
SRCS+=	src/google/protobuf/any_lite.cc
SRCS+=	src/google/protobuf/arena.cc
SRCS+=	src/google/protobuf/arena_align.cc
SRCS+=	src/google/protobuf/arenastring.cc
SRCS+=	src/google/protobuf/arenaz_sampler.cc
SRCS+=	src/google/protobuf/extension_set.cc
SRCS+=	src/google/protobuf/generated_enum_util.cc
SRCS+=	src/google/protobuf/generated_message_tctable_lite.cc
SRCS+=	src/google/protobuf/generated_message_util.cc
SRCS+=	src/google/protobuf/implicit_weak_message.cc
SRCS+=	src/google/protobuf/inlined_string_field.cc
SRCS+=	src/google/protobuf/io/coded_stream.cc
SRCS+=	src/google/protobuf/io/io_win32.cc
SRCS+=	src/google/protobuf/io/zero_copy_stream.cc
SRCS+=	src/google/protobuf/io/zero_copy_stream_impl.cc
SRCS+=	src/google/protobuf/io/zero_copy_stream_impl_lite.cc
SRCS+=	src/google/protobuf/map.cc
SRCS+=	src/google/protobuf/message_lite.cc
SRCS+=	src/google/protobuf/parse_context.cc
SRCS+=	src/google/protobuf/port.cc
SRCS+=	src/google/protobuf/raw_ptr.cc
SRCS+=	src/google/protobuf/repeated_field.cc
SRCS+=	src/google/protobuf/repeated_ptr_field.cc
SRCS+=	src/google/protobuf/stubs/common.cc
SRCS+=	src/google/protobuf/wire_format_lite.cc
# END generated
SRCS+=	third_party/utf8_range/utf8_range.c \
	third_party/utf8_range/utf8_validity.cc

LIBADD=		absl pthread

.include <bsd.lib.mk>
