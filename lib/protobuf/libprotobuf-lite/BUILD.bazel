# SPDX-License-Identifier: BSD-2-Clause
# libprivateprotobuf-lite (lib/protobuf/libprotobuf-lite/Makefile): PRIVATELIB,
# LIB_CXX, SHLIB_MAJOR 29, upstream version script, LIBADD absl pthread.
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
# Makefile SRCS order.
SOURCES = [
    "src/google/protobuf/any_lite.cc",
    "src/google/protobuf/arena.cc",
    "src/google/protobuf/arena_align.cc",
    "src/google/protobuf/arenastring.cc",
    "src/google/protobuf/arenaz_sampler.cc",
    "src/google/protobuf/extension_set.cc",
    "src/google/protobuf/generated_enum_util.cc",
    "src/google/protobuf/generated_message_tctable_lite.cc",
    "src/google/protobuf/generated_message_util.cc",
    "src/google/protobuf/implicit_weak_message.cc",
    "src/google/protobuf/inlined_string_field.cc",
    "src/google/protobuf/io/coded_stream.cc",
    "src/google/protobuf/io/io_win32.cc",
    "src/google/protobuf/io/zero_copy_stream.cc",
    "src/google/protobuf/io/zero_copy_stream_impl.cc",
    "src/google/protobuf/io/zero_copy_stream_impl_lite.cc",
    "src/google/protobuf/map.cc",
    "src/google/protobuf/message_lite.cc",
    "src/google/protobuf/parse_context.cc",
    "src/google/protobuf/port.cc",
    "src/google/protobuf/raw_ptr.cc",
    "src/google/protobuf/repeated_field.cc",
    "src/google/protobuf/repeated_ptr_field.cc",
    "src/google/protobuf/stubs/common.cc",
    "src/google/protobuf/wire_format_lite.cc",
    "third_party/utf8_range/utf8_range.c",
    "third_party/utf8_range/utf8_validity.cc",
]
cc_library(name = "protobuf_lite", srcs = ["//contrib/protobuf:" + source for source in SOURCES],
    deps = ["//contrib/protobuf:src_headers", "//contrib/abseil-cpp:headers", "//contrib/llvm-project/libcxx/include:headers"] +
        ["//lib/libabsl:absl", "//lib/libthr:thr"] + ["//lib/libc++:cxx", "//lib/libcxxrt:cxxrt", "//lib/msun:m"],
    # lib/protobuf/Makefile.inc CFLAGS reach both languages; CXXFLAGS only C++.
    cxxopts = ["-std=c++17", "-nostdinc++", "-DHAVE_ZLIB=1", "-DPROTOBUF_USE_DLLS", "-DLIBPROTOBUF_EXPORTS",
        "-fvisibility=hidden", "-fvisibility-inlines-hidden"],
    linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":protobuf_lite"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_shared_library(name = "protobuf_lite_shared", deps = [":protobuf_lite"],
    dynamic_deps = ["//lib/libabsl:absl_shared", "//lib/libthr:thr_shared"] + ["//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared"],
    additional_linker_inputs = ["//contrib/protobuf:src/libprotobuf-lite.map"],
    shared_lib_name = "libprivateprotobuf-lite.so.29",
    user_link_flags = ["-Wl,-soname,libprivateprotobuf-lite.so.29", "-Wl,--version-script=$(location //contrib/protobuf:src/libprotobuf-lite.map)",
        "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=protobuf","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
    visibility = ["//visibility:public"],
)
