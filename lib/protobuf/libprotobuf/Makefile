# The full protobuf C++ runtime (descriptors, reflection, text/JSON
# formats, util), libprivateprotobuf.so.  As upstream, it contains the lite
# runtime too and does not link libprivateprotobuf-lite.  It also installs
# the runtime headers and the well-known .proto files under
# /usr/include/private, where the installed protoc finds them.

LIB_CXX=	protobuf
PRIVATELIB=	true
SHLIB_MAJOR=	29

CXXFLAGS+=	-DHAVE_ZLIB=1 -DPROTOBUF_USE_DLLS -DLIBPROTOBUF_EXPORTS \
		-fvisibility=hidden -fvisibility-inlines-hidden
# PROTOBUF_EXPORT on 'enum class' declarations (text_format.h) is ignored
# by clang; upstream builds without -Werror.
CXXWARNFLAGS+=	-Wno-ignored-attributes
LDFLAGS+=	-Wl,--version-script=${PROTOBUF}/src/libprotobuf.map

