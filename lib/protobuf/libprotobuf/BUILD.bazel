# SPDX-License-Identifier: BSD-2-Clause
# libprivateprotobuf (lib/protobuf/libprotobuf/Makefile): PRIVATELIB, LIB_CXX,
# SHLIB_MAJOR 29, upstream version script, LIBADD absl z pthread; installs the
# private headers, well-known .proto files and licences.
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
# Makefile SRCS order.
SOURCES = [
    "src/google/protobuf/any.cc",
    "src/google/protobuf/any.pb.cc",
    "src/google/protobuf/any_lite.cc",
    "src/google/protobuf/api.pb.cc",
    "src/google/protobuf/arena.cc",
    "src/google/protobuf/arena_align.cc",
    "src/google/protobuf/arenastring.cc",
    "src/google/protobuf/arenaz_sampler.cc",
    "src/google/protobuf/compiler/importer.cc",
    "src/google/protobuf/compiler/parser.cc",
    "src/google/protobuf/cpp_features.pb.cc",
    "src/google/protobuf/descriptor.cc",
    "src/google/protobuf/descriptor.pb.cc",
    "src/google/protobuf/descriptor_database.cc",
    "src/google/protobuf/duration.pb.cc",
    "src/google/protobuf/dynamic_message.cc",
    "src/google/protobuf/empty.pb.cc",
    "src/google/protobuf/extension_set.cc",
    "src/google/protobuf/extension_set_heavy.cc",
    "src/google/protobuf/feature_resolver.cc",
    "src/google/protobuf/field_mask.pb.cc",
    "src/google/protobuf/generated_enum_util.cc",
    "src/google/protobuf/generated_message_bases.cc",
    "src/google/protobuf/generated_message_reflection.cc",
    "src/google/protobuf/generated_message_tctable_full.cc",
    "src/google/protobuf/generated_message_tctable_gen.cc",
    "src/google/protobuf/generated_message_tctable_lite.cc",
    "src/google/protobuf/generated_message_util.cc",
    "src/google/protobuf/implicit_weak_message.cc",
    "src/google/protobuf/inlined_string_field.cc",
    "src/google/protobuf/io/coded_stream.cc",
    "src/google/protobuf/io/gzip_stream.cc",
    "src/google/protobuf/io/io_win32.cc",
    "src/google/protobuf/io/printer.cc",
    "src/google/protobuf/io/strtod.cc",
    "src/google/protobuf/io/tokenizer.cc",
    "src/google/protobuf/io/zero_copy_sink.cc",
    "src/google/protobuf/io/zero_copy_stream.cc",
    "src/google/protobuf/io/zero_copy_stream_impl.cc",
    "src/google/protobuf/io/zero_copy_stream_impl_lite.cc",
    "src/google/protobuf/json/internal/lexer.cc",
    "src/google/protobuf/json/internal/message_path.cc",
    "src/google/protobuf/json/internal/parser.cc",
    "src/google/protobuf/json/internal/unparser.cc",
    "src/google/protobuf/json/internal/untyped_message.cc",
    "src/google/protobuf/json/internal/writer.cc",
    "src/google/protobuf/json/internal/zero_copy_buffered_stream.cc",
    "src/google/protobuf/json/json.cc",
    "src/google/protobuf/map.cc",
    "src/google/protobuf/map_field.cc",
    "src/google/protobuf/message.cc",
    "src/google/protobuf/message_lite.cc",
    "src/google/protobuf/parse_context.cc",
    "src/google/protobuf/port.cc",
    "src/google/protobuf/raw_ptr.cc",
    "src/google/protobuf/reflection_mode.cc",
    "src/google/protobuf/reflection_ops.cc",
    "src/google/protobuf/repeated_field.cc",
    "src/google/protobuf/repeated_ptr_field.cc",
    "src/google/protobuf/service.cc",
    "src/google/protobuf/source_context.pb.cc",
    "src/google/protobuf/struct.pb.cc",
    "src/google/protobuf/stubs/common.cc",
    "src/google/protobuf/text_format.cc",
    "src/google/protobuf/timestamp.pb.cc",
    "src/google/protobuf/type.pb.cc",
    "src/google/protobuf/unknown_field_set.cc",
    "src/google/protobuf/util/delimited_message_util.cc",
    "src/google/protobuf/util/field_comparator.cc",
    "src/google/protobuf/util/field_mask_util.cc",
    "src/google/protobuf/util/message_differencer.cc",
    "src/google/protobuf/util/time_util.cc",
    "src/google/protobuf/util/type_resolver_util.cc",
    "src/google/protobuf/wire_format.cc",
    "src/google/protobuf/wire_format_lite.cc",
    "src/google/protobuf/wrappers.pb.cc",
    "third_party/utf8_range/utf8_range.c",
    "third_party/utf8_range/utf8_validity.cc",
]
cc_library(name = "protobuf", srcs = ["//contrib/protobuf:" + source for source in SOURCES],
    deps = ["//contrib/protobuf:src_headers", "//contrib/abseil-cpp:headers", "//contrib/llvm-project/libcxx/include:headers"] +
        ["//lib/libabsl:absl", "//lib/libz:z", "//lib/libthr:thr"] + ["//lib/libc++:cxx", "//lib/libcxxrt:cxxrt", "//lib/msun:m"],
    # lib/protobuf/Makefile.inc CFLAGS reach both languages; CXXFLAGS only C++.
    cxxopts = ["-std=c++17", "-nostdinc++", "-DHAVE_ZLIB=1", "-DPROTOBUF_USE_DLLS", "-DLIBPROTOBUF_EXPORTS",
        "-fvisibility=hidden", "-fvisibility-inlines-hidden"],
    linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":protobuf"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_shared_library(name = "protobuf_shared", deps = [":protobuf"],
    dynamic_deps = ["//lib/libabsl:absl_shared", "//lib/libz:z_shared", "//lib/libthr:thr_shared"] + ["//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared"],
    additional_linker_inputs = ["//contrib/protobuf:src/libprotobuf.map"],
    shared_lib_name = "libprivateprotobuf.so.29",
    user_link_flags = ["-Wl,-soname,libprivateprotobuf.so.29", "-Wl,--version-script=$(location //contrib/protobuf:src/libprotobuf.map)",
        "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=protobuf","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]} | {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=protobuf"]}' for d in ["/usr/share/licenses/protobuf", "/usr/share/licenses/protobuf/utf8_range"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
    visibility = ["//visibility:public"],
)
