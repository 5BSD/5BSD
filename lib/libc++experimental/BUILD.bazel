load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
# Upstream keeps this archive present even when it contains no experimental APIs.
cc_library(name = "experimental", srcs = ["//contrib/llvm-project/libcxx/src:experimental/keep.cpp"], deps = ["//contrib/llvm-project/libcxx/include:headers"], copts = ["-std=c++20", "-fPIC", "-nostdinc++", "-nostdlib"], local_defines = ["_LIBCPP_BUILDING_LIBRARY", "LIBCXXRT"], linkstatic = True, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":experimental"], visibility = ["//visibility:public"])
bsd_install_file(name = "install_library", src = ":static_archive", destination = "/usr/lib/libc++experimental.a", owner = "root", group = "wheel", mode = "0444", install_tags = ["package=clibs", "dev"])
bsd_install_manifest(name = "install_manifest", entries = [":install_library"])
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"],
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.include.dist": "/usr/include", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
