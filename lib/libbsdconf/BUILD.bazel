load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
cc_library(name = "headers", hdrs = ["bsdconf.h"], strip_include_prefix = ".", visibility = ["//visibility:public"])
cc_library(name = "bsdconf",
    srcs = ["bsdconf.c", "bsdconf_format.c", "bsdconf_format_generic.c", "bsdconf_format_loader.c", "bsdconf_format_make.c", "bsdconf_format_src.c", "bsdconf_format_sysctl.c", "bsdconf_put.c", "bsdconf_stmt.c", "bsdconf_string.c", "bsdconf_internal.h", "bsdconf_formats.h"],
    deps = [":headers"], linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":bsdconf"], visibility = ["//visibility:public"])
cc_shared_library(name = "bsdconf_shared", deps = [":bsdconf"], shared_lib_name = "libbsdconf.so.1",
    user_link_flags = ["-Wl,-soname,libbsdconf.so.1", "-Wl,--fatal-warnings,--warn-shared-textrel"], visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//lib:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

load("@rules_cc//cc:defs.bzl", "cc_test")
[cc_test(
    name = "runtime_" + linkage,
    srcs = ["runtime_test.c"],
    deps = [":bsdconf"],
    dynamic_deps = [":bsdconf_shared"] if linkage == "shared" else [],
    features = ["bsd_test_runtime_paths"] if linkage == "shared" else [],
    linkstatic = True,
    size = "small",
) for linkage in ["static", "shared"]]
