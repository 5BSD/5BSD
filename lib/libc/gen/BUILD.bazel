# Compile the maintained sources directly. Make's cancelpoints_ aliases select
# these exception flags; source copies/aliases are unnecessary in the native graph.
cc_library(
    name = "semaphore_objects",
    srcs = ["sem.c", "sem_new.c"],
    implementation_deps = ["//lib/libc/include:semaphore_headers"],
    local_defines = ["_FORTIFY_SOURCE_read=_read", "NO__SCCSID", "NO__RCSID"] + select({
        "//tools/build/bazel/config:nls_enabled": ["NLS"],
        "//conditions:default": [],
    }) + select({
        "//tools/build/bazel/config:dtrace_enabled": ["WITH_COVERAGE_DTRACE"],
        "//conditions:default": [],
    }),
    copts = ["-ftls-model=initial-exec"] + select({
        "//tools/build/bazel/config:thread_stack_unwind_enabled": ["-fexceptions"],
        "//conditions:default": [],
    }),
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//lib/libc:__pkg__"],
)
# Raw objects: final DOF processing must combine all libc provider contributors.
bsd_component_archive(name = "semaphore_archive", groups = [":semaphore_objects"])
bsd_component_archive(name = "semaphore_pic_archive", groups = [":semaphore_objects"], pic = True)

