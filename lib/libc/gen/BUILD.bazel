cc_library(
    name = "directory_blocks_objects",
    srcs = [
        "fts.c",
        "glob.c",
    ],
    hdrs = ["fts-compat.h", "fts-compat11.h", "fts-compat15.h", "gen-compat.h", "gen-private.h", "glob-compat11.h", "telldir.h"],
    textual_hdrs = ["scandir.c"],
    implementation_deps = ["//lib/libc/include:gen_directory_headers", "//lib/libc/locale:regex_headers"],
    local_defines = ["_FORTIFY_SOURCE_read=_read", "NO__SCCSID", "NO__RCSID"] + select({
        "//tools/build/bazel/config:nls_enabled": ["NLS"],
        "//conditions:default": [],
    }),
    copts = ["-ftls-model=initial-exec", "-fblocks"],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//lib/libc:__pkg__"],
)

bsd_component_archive(name = "directory_archive", groups = [":directory_objects", ":directory_blocks_objects"])
bsd_component_archive(name = "directory_pic_archive", groups = [":directory_objects", ":directory_blocks_objects"], pic = True, visibility = ["//lib/libc:__pkg__", "//lib/libc/tests/gen:__pkg__"])

