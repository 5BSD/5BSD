        "closedir.c",
        "dirfd.c",
        "fdopendir.c",
        "opendir.c",
        "opendir2.c",
        "readdir.c",
        "readdir-compat11.c",
        "rewinddir.c",
        "seekdir.c",
        "telldir.c",
        "scandir.c",
        "scandir_b.c",
        "scandir-compat11.c",
        "fts-compat.c",
        "fts-compat11.c",
        "fts-compat15.c",
        "ftw.c",
        "ftw-compat11.c",
        "nftw.c",
        "nftw-compat11.c",
        "glob-compat11.c",
    ],
    hdrs = ["fts-compat.h", "fts-compat11.h", "fts-compat15.h", "gen-compat.h", "gen-private.h", "glob-compat11.h", "telldir.h"],
    textual_hdrs = ["scandir.c"],
    implementation_deps = ["//lib/libc/include:gen_directory_headers", "//lib/libc/locale:regex_headers"],
    local_defines = ["_FORTIFY_SOURCE_read=_read", "NO__SCCSID", "NO__RCSID"] + select({
