# These portable routines can read within a page beyond the requested range.
# Preserve their narrowly scoped address-sanitizer exclusions.
cc_library(
    features = LIBC_VARIANT_FEATURES,
    name = 'page_read_objects',
    srcs = select({"//tools/build/bazel/config:machdep_optimizations_enabled": ['//lib/libc/amd64/string:strlen.S', '//lib/libc/amd64/string:strchrnul.S', '//lib/libc/amd64/string:memchr.S'], "//conditions:default": ['strlen.c', 'strchrnul.c', 'memchr.c']}),
    textual_hdrs = ["bcopy.c", "memset.c", "//lib/libc/amd64/string:memcmp.S", "//lib/libc/amd64/string:memmove.S"],
    implementation_deps = ["//lib/libc/include:string_headers", "//lib/libc/locale:regex_headers"],
    local_defines = ["_FORTIFY_SOURCE_read=_read", "NO__SCCSID", "NO__RCSID"] + select({"//tools/build/bazel/config:nls_enabled": ["NLS"], "//conditions:default": []}),
    copts = ['-ftls-model=initial-exec', '-fno-sanitize=address'],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//lib/libc:__pkg__"],
)
# IFUNC CPU selection runs before address-sanitizer initialization.
cc_library(
    features = LIBC_VARIANT_FEATURES,
    name = 'archlevel_objects',
    srcs = ['//lib/libc/amd64/string:amd64_archlevel.c'],
    textual_hdrs = ["bcopy.c", "memset.c", "//lib/libc/amd64/string:memcmp.S", "//lib/libc/amd64/string:memmove.S"],
    implementation_deps = ["//lib/libc/include:string_headers", "//lib/libc/locale:regex_headers"],
    local_defines = ["_FORTIFY_SOURCE_read=_read", "NO__SCCSID", "NO__RCSID"] + select({"//tools/build/bazel/config:nls_enabled": ["NLS"], "//conditions:default": []}),
    copts = ['-ftls-model=initial-exec', '-fno-sanitize=address'],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//lib/libc:__pkg__"],
)
bsd_component_archive(name = 'objects_archive', groups = [":string_objects", ":page_read_objects"] + select({"//tools/build/bazel/config:machdep_optimizations_enabled": [":archlevel_objects"], "//conditions:default": []}), pic = False)
