# SPDX-License-Identifier: BSD-2-Clause
load("//lib/libc:nossp.bzl", "LIBC_VARIANT_FEATURES")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load(":sources.bzl", "AMD64_STRING_SOURCES", "AARCH64_STRING_SOURCES", "GENERIC_STRING_SOURCES", "AARCH64_REPLACEMENTS")
load("@bazel_skylib//lib:selects.bzl", "selects")
config_setting(name = "amd64", constraint_values = ["@platforms//cpu:x86_64"])
config_setting(name = "aarch64", constraint_values = ["@platforms//cpu:aarch64"])
selects.config_setting_group(name = "amd64_machdep", match_all = [":amd64", "//tools/build/bazel/config:machdep_optimizations_enabled"], visibility = ["//lib/libc:__pkg__"])
selects.config_setting_group(name = "aarch64_machdep", match_all = [":aarch64", "//tools/build/bazel/config:machdep_optimizations_enabled"], visibility = ["//lib/libc:__pkg__"])
_PLATFORM = ["@platforms//os:freebsd"] + select({
    "@platforms//cpu:x86_64": [], "@platforms//cpu:aarch64": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# Explicit source selection also preserves Make .PATH overrides for bcopy/bzero.
# Portable routines remain selectable independently of the amd64 implementations.
cc_library(
    features = LIBC_VARIANT_FEATURES,
    name = 'string_objects',
    srcs = select({":amd64_machdep": AMD64_STRING_SOURCES,
        ":aarch64_machdep": AARCH64_STRING_SOURCES,
        "//conditions:default": GENERIC_STRING_SOURCES}),
    textual_hdrs = ["bcopy.c", "memset.c"] + select({
        ":amd64_machdep": ["//lib/libc/amd64/string:memcmp.S", "//lib/libc/amd64/string:memmove.S"],
        "//conditions:default": [],
    }),
    implementation_deps = ["//lib/libc/include:string_headers", "//lib/libc/locale:regex_headers"] + select({
        ":aarch64_machdep": ["//contrib/arm-optimized-routines/string:aarch64_assembly"],
        "//conditions:default": [],
    }),
    local_defines = ["_FORTIFY_SOURCE_read=_read", "NO__SCCSID", "NO__RCSID"] + select({"//tools/build/bazel/config:nls_enabled": ["NLS"], "//conditions:default": []}),
    copts = ['-ftls-model=initial-exec'],
    linkstatic = True,
    target_compatible_with = _PLATFORM,
    visibility = ["//lib/libc:__pkg__"],
)
# These portable routines can read within a page beyond the requested range.
# Preserve their narrowly scoped address-sanitizer exclusions.
cc_library(
    features = LIBC_VARIANT_FEATURES,
    name = 'page_read_objects',
    srcs = select({":aarch64_machdep": [AARCH64_REPLACEMENTS[n] for n in ['strlen.c', 'strchrnul.c', 'memchr.c']], ":amd64_machdep": ['//lib/libc/amd64/string:strlen.S', '//lib/libc/amd64/string:strchrnul.S', '//lib/libc/amd64/string:memchr.S'], "//conditions:default": ['strlen.c', 'strchrnul.c', 'memchr.c']}),
    textual_hdrs = ["bcopy.c", "memset.c"] + select({
        ":amd64_machdep": ["//lib/libc/amd64/string:memcmp.S", "//lib/libc/amd64/string:memmove.S"],
        "//conditions:default": [],
    }),
    implementation_deps = ["//lib/libc/include:string_headers", "//lib/libc/locale:regex_headers"] + select({
        ":aarch64_machdep": ["//contrib/arm-optimized-routines/string:aarch64_assembly"],
        "//conditions:default": [],
    }),
    local_defines = ["_FORTIFY_SOURCE_read=_read", "NO__SCCSID", "NO__RCSID"] + select({"//tools/build/bazel/config:nls_enabled": ["NLS"], "//conditions:default": []}),
    copts = ['-ftls-model=initial-exec', '-fno-sanitize=address'],
    linkstatic = True,
    target_compatible_with = _PLATFORM,
    visibility = ["//lib/libc:__pkg__"],
)
# IFUNC CPU selection runs before address-sanitizer initialization.
cc_library(
    features = LIBC_VARIANT_FEATURES,
    name = 'archlevel_objects',
    srcs = ['//lib/libc/amd64/string:amd64_archlevel.c'],
    textual_hdrs = ["bcopy.c", "memset.c", "//lib/libc/amd64/string:memcmp.S", "//lib/libc/amd64/string:memmove.S"],
    implementation_deps = ["//lib/libc/include:string_headers", "//lib/libc/locale:regex_headers"],
    local_defines = ["_FORTIFY_SOURCE_read=_read", "NO__SCCSID", "NO__RCSID"] + select({"//tools/build/bazel/config:nls_enabled": ["NLS"], "//conditions:default": []}),
    copts = ['-ftls-model=initial-exec', '-fno-sanitize=address'],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//lib/libc:__pkg__"],
)
bsd_component_archive(name = 'objects_archive', groups = [":string_objects", ":page_read_objects"] + select({":amd64_machdep": [":archlevel_objects"], "//conditions:default": []}), pic = False)
bsd_component_archive(name = 'pic_objects_archive', groups = [":string_objects", ":page_read_objects"] + select({":amd64_machdep": [":archlevel_objects"], "//conditions:default": []}), pic = True)
exports_files(["Symbol.map"], visibility = ["//lib/libc:__pkg__"])

exports_files(["memcpy.c", "memset.c", "strlcpy.c", "bcopy.c"], visibility = ["//lib/libsys:__pkg__"])

# Maintained manual sources consumed by libc installation.
[filegroup(name = name, srcs = [source], visibility = ["//lib/libc:__pkg__"])
 for name, source in [
    ('libc_manual_bcmp.3', 'bcmp.3'),
    ('libc_manual_bcopy.3', 'bcopy.3'),
    ('libc_manual_bstring.3', 'bstring.3'),
    ('libc_manual_bzero.3', 'bzero.3'),
    ('libc_manual_ffs.3', 'ffs.3'),
    ('libc_manual_index.3', 'index.3'),
    ('libc_manual_memccpy.3', 'memccpy.3'),
    ('libc_manual_memchr.3', 'memchr.3'),
    ('libc_manual_memcmp.3', 'memcmp.3'),
    ('libc_manual_memcpy.3', 'memcpy.3'),
    ('libc_manual_memmem.3', 'memmem.3'),
    ('libc_manual_memmove.3', 'memmove.3'),
    ('libc_manual_memset.3', 'memset.3'),
    ('libc_manual_strcasecmp.3', 'strcasecmp.3'),
    ('libc_manual_strcat.3', 'strcat.3'),
    ('libc_manual_strchr.3', 'strchr.3'),
    ('libc_manual_strcmp.3', 'strcmp.3'),
    ('libc_manual_strcoll.3', 'strcoll.3'),
    ('libc_manual_strcpy.3', 'strcpy.3'),
    ('libc_manual_strdup.3', 'strdup.3'),
    ('libc_manual_strerror.3', 'strerror.3'),
    ('libc_manual_string.3', 'string.3'),
    ('libc_manual_strlcpy.3', 'strlcpy.3'),
    ('libc_manual_strlen.3', 'strlen.3'),
    ('libc_manual_strmode.3', 'strmode.3'),
    ('libc_manual_strpbrk.3', 'strpbrk.3'),
    ('libc_manual_strsep.3', 'strsep.3'),
    ('libc_manual_strspn.3', 'strspn.3'),
    ('libc_manual_strstr.3', 'strstr.3'),
    ('libc_manual_strtok.3', 'strtok.3'),
    ('libc_manual_strverscmp.3', 'strverscmp.3'),
    ('libc_manual_strxfrm.3', 'strxfrm.3'),
    ('libc_manual_swab.3', 'swab.3'),
    ('libc_manual_timingsafe_bcmp.3', 'timingsafe_bcmp.3'),
    ('libc_manual_wcscoll.3', 'wcscoll.3'),
    ('libc_manual_wcstok.3', 'wcstok.3'),
    ('libc_manual_wcswidth.3', 'wcswidth.3'),
    ('libc_manual_wcsxfrm.3', 'wcsxfrm.3'),
    ('libc_manual_wmemchr.3', 'wmemchr.3'),
]]

load("//libexec/rtld-elf:libc_sources.bzl", "rtld_libc_source_exports")
rtld_libc_source_exports('lib/libc/string')

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")


filegroup(name = 'standalone_sa_core_sources', srcs = ['bcmp.c', 'bcopy.c', 'bzero.c', 'ffs.c', 'fls.c', 'memccpy.c', 'memchr.c', 'memcmp.c', 'memcpy.c', 'memmove.c', 'memset.c', 'strcat.c', 'strchr.c', 'strchrnul.c', 'strcmp.c', 'strcpy.c', 'stpcpy.c', 'stpncpy.c', 'strcspn.c', 'strlcat.c', 'strlcpy.c', 'strlen.c', 'strncat.c', 'strncmp.c', 'strncpy.c', 'strnlen.c', 'strpbrk.c', 'strrchr.c', 'strsep.c', 'strspn.c', 'strstr.c', 'strtok.c', 'swab.c'], visibility = ["//stand/libsa:__pkg__"])

bsd_source_headers(name = "standalone_sa_headers", hdrs = ['bcopy.c', 'memset.c'], visibility = ["//stand/libsa:__pkg__"])

bsd_source_headers(name = "standalone_sa_efi_headers", hdrs = ['bcopy.c', 'memset.c'], visibility = ["//stand/libsa:__pkg__"])
