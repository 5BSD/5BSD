# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
cc_library(
    name = 'objects',
    srcs = ['fgets_chk.c', 'memcpy_chk.c', 'memmove_chk.c', 'mempcpy_chk.c', 'memset_chk.c', 'stpcpy_chk.c', 'stpncpy_chk.c', 'strcat_chk.c', 'strcpy_chk.c', 'strlcat_chk.c', 'strncat_chk.c', 'strlcpy_chk.c', 'strncpy_chk.c', 'stack_protector_compat.c'],
    implementation_deps = ["//lib/libc/include:rt_private_headers"],
    local_defines = ["_FORTIFY_SOURCE_read=_read", "NO__SCCSID", "NO__RCSID"] + select({"//tools/build/bazel/config:nls_enabled": ["NLS"], "//conditions:default": []}),
    copts = ['-ftls-model=initial-exec'],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//lib/libc:__pkg__"],
)
cc_library(
    name = 'format_objects',
    srcs = ['snprintf_chk.c', 'sprintf_chk.c', 'vsnprintf_chk.c', 'vsprintf_chk.c'],
    implementation_deps = ["//lib/libc/include:rt_private_headers"],
    local_defines = ["_FORTIFY_SOURCE_read=_read", "NO__SCCSID", "NO__RCSID"] + select({"//tools/build/bazel/config:nls_enabled": ["NLS"], "//conditions:default": []}),
    copts = ['-ftls-model=initial-exec', '-Wno-unused-parameter'],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//lib/libc:__pkg__"],
)
# libc/Makefile excludes this implementation from SSP instrumentation.
cc_library(
    name = 'stack_protector_objects',
    srcs = ["libc_stack_protector.c"],
    implementation_deps = ["//lib/libc/include:rt_private_headers"],
    local_defines = ["_FORTIFY_SOURCE_read=_read", "NO__SCCSID", "NO__RCSID"] + select({"//tools/build/bazel/config:nls_enabled": ["NLS"], "//conditions:default": []}),
    copts = ['-ftls-model=initial-exec', '-fno-stack-protector'],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//lib/libc:__pkg__"],
)
bsd_component_archive(name = "objects_archive", groups = [':objects', ':format_objects', ':stack_protector_objects'])
bsd_component_archive(name = "pic_objects_archive", groups = [':objects', ':format_objects', ':stack_protector_objects'], pic = True)
exports_files(["Symbol.map"], visibility = ["//lib/libc:__pkg__"])
