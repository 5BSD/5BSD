load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
cc_library(name = "platform_headers", hdrs = glob(["include/**/*.h"]), strip_include_prefix = "include")
cc_library(
    name = "jemalloc_objects",
    srcs = ['//contrib/jemalloc:src/jemalloc.c', '//contrib/jemalloc:src/arena.c', '//contrib/jemalloc:src/background_thread.c', '//contrib/jemalloc:src/base.c', '//contrib/jemalloc:src/bin.c', '//contrib/jemalloc:src/bitmap.c', '//contrib/jemalloc:src/ckh.c', '//contrib/jemalloc:src/ctl.c', '//contrib/jemalloc:src/div.c', '//contrib/jemalloc:src/extent.c', '//contrib/jemalloc:src/extent_dss.c', '//contrib/jemalloc:src/extent_mmap.c', '//contrib/jemalloc:src/hook.c', '//contrib/jemalloc:src/large.c', '//contrib/jemalloc:src/log.c', '//contrib/jemalloc:src/malloc_io.c', '//contrib/jemalloc:src/mutex.c', '//contrib/jemalloc:src/nstime.c', '//contrib/jemalloc:src/pages.c', '//contrib/jemalloc:src/prof.c', '//contrib/jemalloc:src/rtree.c', '//contrib/jemalloc:src/safety_check.c', '//contrib/jemalloc:src/sc.c', '//contrib/jemalloc:src/stats.c', '//contrib/jemalloc:src/sz.c', '//contrib/jemalloc:src/tcache.c', '//contrib/jemalloc:src/test_hooks.c', '//contrib/jemalloc:src/ticker.c', '//contrib/jemalloc:src/tsd.c', '//contrib/jemalloc:src/witness.c', '//contrib/jemalloc:src/bin_info.c', '//contrib/jemalloc:src/san.c', '//contrib/jemalloc:src/san_bump.c', '//contrib/jemalloc:src/counter.c', '//contrib/jemalloc:src/prof_data.c', '//contrib/jemalloc:src/prof_log.c', '//contrib/jemalloc:src/prof_recent.c', '//contrib/jemalloc:src/prof_stats.c', '//contrib/jemalloc:src/prof_sys.c', '//contrib/jemalloc:src/emap.c', '//contrib/jemalloc:src/edata.c', '//contrib/jemalloc:src/edata_cache.c', '//contrib/jemalloc:src/pa.c', '//contrib/jemalloc:src/pa_extra.c', '//contrib/jemalloc:src/pac.c', '//contrib/jemalloc:src/decay.c', '//contrib/jemalloc:src/hpa.c', '//contrib/jemalloc:src/hpa_hooks.c', '//contrib/jemalloc:src/fxp.c', '//contrib/jemalloc:src/hpdata.c', '//contrib/jemalloc:src/pai.c', '//contrib/jemalloc:src/ecache.c', '//contrib/jemalloc:src/ehooks.c', '//contrib/jemalloc:src/eset.c', '//contrib/jemalloc:src/sec.c', '//contrib/jemalloc:src/cache_bin.c', '//contrib/jemalloc:src/peak_event.c', '//contrib/jemalloc:src/psset.c', '//contrib/jemalloc:src/inspect.c', '//contrib/jemalloc:src/exp_grow.c', '//contrib/jemalloc:src/thread_event.c', '//contrib/jemalloc:src/buf_writer.c'],
    implementation_deps = [":platform_headers", "//contrib/jemalloc:headers", "//lib/libc/include:rt_private_headers"],
    local_defines = ["_FORTIFY_SOURCE_read=_read", "NO__SCCSID", "NO__RCSID"] +
        select({"//tools/build/bazel/config:nls_enabled": ["NLS"], "//conditions:default": []}) +
        select({"//tools/build/bazel/config:malloc_production_enabled": ["MALLOC_PRODUCTION"], "//conditions:default": []}) +
        select({"//tools/build/bazel/config:jemalloc_lg_vaddr_wide_enabled": ["_USE_LG_VADDR_WIDE"], "//conditions:default": []}),
    copts = ["-ftls-model=initial-exec"],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//lib/libc:__pkg__"],
)
# Compilation qualification only; no detached production-publication stamp.
bsd_component_archive(name = "objects_archive", groups = [":jemalloc_objects"])
bsd_component_archive(name = "pic_objects_archive", groups = [":jemalloc_objects"], pic = True)

# Maintained manual sources consumed by libc installation.
[filegroup(name = name, srcs = [source], visibility = ["//lib/libc:__pkg__"])
 for name, source in [
    ('libc_manual_jemalloc.3', 'jemalloc.3'),
]]
