def sys_tests():
    cc_import(name = "atf_interface", shared_library = "//lib/atf/libatf-c:atf_c_shared", deps = ["//contrib/atf:c_headers"])
    cc_import(name = "thr_interface", shared_library = "//lib/libthr:thr_shared")
    cc_import(name = "rt_interface", shared_library = "//lib/librt:rt_shared")
    manifests = []
    host = []
    guest = []
    for program in _LOCAL + _IMPORTED:
        imported = program in _IMPORTED
        source = _SOURCE + "t_" + program[:-5] + ".c" if imported else program + ".c"
        sources = [source] + (["mlock_helper.c"] if program in ["mlock_test", "setrlimit_test"] else [])
        deps = [":atf_interface"]
        if imported:
            deps += ["//lib/libnetbsd:netbsd_pie", "//contrib/netbsd-tests:test_headers"]
        if program == "wait_noproc_wnohang_test":
            deps.append(_SOURCE + "wait_noproc_text")
        if program == "getpid_test":
            deps.append(":thr_interface")
        if program == "timer_create_test":
            deps.append(":rt_interface")
        deps.append("//lib/libc:shared_abi_interface")
        bsd_link_sequence(name = program + "_link", deps = deps)
        cc_binary(name = program, srcs = sources, deps = [":" + program + "_link"],
            copts = libc_test_copts() + (["-U_FORTIFY_SOURCE", "-D_FORTIFY_SOURCE=0"] if program == "getgroups_test" else []),
            defines = ["PIC"], linkopts = ["-pie", "-nodefaultlibs"], target_compatible_with = _PLATFORM)
        utility_installation(name = program + "_install", program = program, manual = None, package = "tests", bindir = _DIRECTORY)
        manifests.append(":" + program + "_install")
        for case in _CASES[program]:
            selected = case in _HOST_CASES.get(program, [])
            name = program + "_" + case + "_runtime"
            timeout = _TIMEOUTS.get(program, {}).get(case, 0)
            bsd_atf_test(name = name, body = ":" + program, case_name = case, interface = "program",
                runtime_lib = LIBC_TEST_RUNTIME + (["//lib/libthr:thr_shared"] if program == "getpid_test" else (["//lib/librt:rt_shared", "//lib/libthr:thr_shared"] if program == "timer_create_test" else [])),
                required_user = _USERS.get(program, {}).get(case, ""),
                data_paths = {":truncate_fixture": "truncate_test.root_owned"} if program == "truncate_test" else {},
                cleanup = case in _CLEANUP.get(program, []), body_timeout_seconds = timeout,
                tags = ([] if selected else ["manual", "external", "no-remote"]) + (["exclusive"] if program in _EXCLUSIVE else []),
                runner = "//tools/build/bazel:atf_runner", test_environment = {"DTRACE_DOF_INIT_DISABLE": "1"},
                target_compatible_with = _PLATFORM, size = "large" if timeout >= 300 else ("medium" if timeout >= 60 else "small"))
            (host if selected else guest).append(":" + name)
    # Original Make creates this empty fixture from /dev/null, then installs
    # root:wheel 0600. Preserve content/ownership without requiring a host dd.
    write_file(name = "truncate_fixture", out = "truncate_test.root_owned", content = [])
    bsd_install_file(name = "truncate_entry", src = ":truncate_fixture", destination = _DIRECTORY + "/truncate_test.root_owned",
        owner = "root", group = "wheel", mode = "0600", install_tags = ["package=tests"])
    bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = sorted(_CASES.keys()), interfaces = {p: "atf" for p in _CASES},
        metadata = {p: json.encode({"is_exclusive": "true"}) for p in _EXCLUSIVE})
    bsd_install_file(name = "kyuafile_entry", src = ":kyuafile", destination = _DIRECTORY + "/Kyuafile",
        owner = "root", group = "wheel", mode = "0444", install_tags = ["package=tests"])
    bsd_install_manifest(name = "install_manifest", manifests = manifests, entries = [":truncate_entry", ":kyuafile_entry"], visibility = ["//visibility:public"])
    bsd_test_install_archive(name = "install_archive", directory = _DIRECTORY, manifests = [":install_manifest"], debug = True)
    bsd_install_archive_set(name = "installation_archives", archives = [":install_archive"], visibility = ["//visibility:public"], target_compatible_with = _PLATFORM)
    native.test_suite(name = "runtime_tests", tests = host)
    native.test_suite(name = "deferred_runtime_tests", tests = guest, tags = ["manual"])
