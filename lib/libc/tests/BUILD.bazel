load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive_set")
load("//tools/build/bazel:bsd_test_installation.bzl", "bsd_test_install_archive")

# This order is the original libc/tests Makefile traversal. tls owns both helper
# library contributions; tls_dso is built but does not add a Kyua include.
_CHILDREN = ['c063', 'db', 'gen', 'hash', 'inet', 'net', 'nss', 'regex', 'resolv', 'rpc', 'secure', 'setjmp', 'stdbit', 'stdio', 'stdlib', 'stdtime', 'string', 'sys', 'termios', 'time', 'tls', 'ttyio']
_ICONV = select({"//tools/build/bazel/config:iconv_enabled": ["iconv"], "//conditions:default": []})
_LOCALE = select({"//tools/build/bazel/config:locales_enabled": ["locale"], "//conditions:default": []})
_SSP = select({"//tools/build/bazel/config:ssp_enabled": ["ssp"], "//conditions:default": []})
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = [], interfaces = {},
    subdirectories = _CHILDREN + _ICONV + _LOCALE + _SSP)
bsd_install_file(name = "kyuafile_entry", src = ":kyuafile", destination = "/usr/tests/lib/libc/Kyuafile",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=tests"])
bsd_install_manifest(name = "install_manifest", entries = [":kyuafile_entry"], visibility = ["//visibility:public"])
bsd_test_install_archive(name = "install_archive", directory = "/usr/tests/lib/libc", manifests = [":install_manifest"])
bsd_install_archive_set(name = "installation_archives",
    archives = [":install_archive"] + ["//lib/libc/tests/" + child + ":installation_archives" for child in _CHILDREN] +
        select({"//tools/build/bazel/config:iconv_enabled": ["//lib/libc/tests/iconv:installation_archives"], "//conditions:default": []}) +
        select({"//tools/build/bazel/config:locales_enabled": ["//lib/libc/tests/locale:installation_archives"], "//conditions:default": []}) +
        select({"//tools/build/bazel/config:ssp_enabled": ["//lib/libc/tests/ssp:installation_archives"], "//conditions:default": []}),
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
