load("//lib/libc:netbsd_test_installation.bzl", "netbsd_test_installation")

netbsd_test_installation(
    programs = {stem + "_test": "//contrib/netbsd-tests/lib/libc/inet:t_" + stem + ".c"
        for stem in ['inet_addr', 'inet_network']},
    directory = "/usr/tests/lib/libc/inet",
    cases = {stem + "_test": [stem + "_basic", stem + "_err"] for stem in ["inet_addr", "inet_network"]},
)

# Preserve existing public test labels while using the actual installed programs.
[alias(name = name + "_runtime_program", actual = ":" + name + "_test")
 for name in ["inet_addr", "inet_network"]]
[alias(name = "native_" + name + "_" + case, actual = ":" + name + "_test_" + name + "_" + case + "_runtime",
    visibility = ["//visibility:public"])
 for name in ["inet_addr", "inet_network"] for case in ["basic", "err"]]
