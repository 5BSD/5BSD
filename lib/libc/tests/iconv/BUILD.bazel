load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_import")
load("//tools/build/bazel:bsd_link_sequence.bzl", "bsd_link_sequence")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive_set")
load("//tools/build/bazel:bsd_test_installation.bzl", "bsd_test_install_archive")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//lib/libc:test_policy.bzl", "libc_test_copts")

_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"] + select({
    "//tools/build/bazel/config:iconv_enabled": [],
    "//conditions:default": ["@platforms//:incompatible"],
})
_DIRECTORY = "/usr/tests/lib/libc/iconv"

# Original program requires real absolute-path Citrus modules and data. Keep its
# installed cases for guest execution, rather than using host resource fallbacks.
cc_import(name = "atf_interface", shared_library = "//lib/atf/libatf-c:atf_c_shared",
    deps = ["//contrib/atf:c_headers"])
bsd_link_sequence(name = "iconvctl_link",
    deps = [":atf_interface", "//lib/libc:shared_abi_interface"],
    target_compatible_with = _PLATFORM)
cc_binary(
    name = "iconvctl_test",
    srcs = ["iconvctl_test.c"],
    deps = [":iconvctl_link"],
    copts = libc_test_copts(warnings = 6),
    defines = ["PIC"],
    linkopts = ["-pie", "-nodefaultlibs"],
    target_compatible_with = _PLATFORM,
)
# Preserve explicit VM-fixture callers of the earlier prototype name.
alias(name = "iconvctl_runtime_program", actual = ":iconvctl_test")
utility_installation(name = "iconvctl_test_install", program = "iconvctl_test",
    manual = None, package = "tests", bindir = _DIRECTORY)
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["iconvctl_test"],
    interfaces = {"iconvctl_test": "atf"})
bsd_install_file(name = "kyuafile_entry", src = ":kyuafile", destination = _DIRECTORY + "/Kyuafile",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=tests"])
bsd_install_manifest(name = "install_manifest", manifests = [":iconvctl_test_install"],
    entries = [":kyuafile_entry"], visibility = ["//visibility:public"])
bsd_test_install_archive(name = "install_archive", directory = _DIRECTORY,
    manifests = [":install_manifest"], debug = True)
bsd_install_archive_set(name = "installation_archives", archives = [":install_archive"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
