# SPDX-License-Identifier: BSD-2-Clause
exports_files(["Versions.def"], visibility = ["//lib/libsys:__pkg__", "//lib/libusb:__pkg__", "//lib/libthr:__pkg__", "//lib/libmixer:__pkg__", "//lib/msun:__pkg__", "//lib/libmd:__pkg__", "//lib/libutil:__pkg__", "//lib/libprocstat:__pkg__", "//lib/librt:__pkg__"])

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_header")
# libc owns one provider shared by resolver, NSS and semaphore sources.
bsd_dtrace_header(name = "nameres_provider", source = "nameres_provider.d", output = "nameres_provider.h",
    flags = ["-C", "-x", "nolibs"], static_anchor = True, object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:bootstrap", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti", runtime_libraries = ["//cddl/usr.sbin/dtrace:bootstrap_runtime"],
    tool_inputs = ["@bsd_sdk//toolchain:compile_inputs", "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"])
cc_library(name = "nameres_provider_headers", hdrs = [":nameres_provider"], strip_include_prefix = ".",
    visibility = ["//lib/libc/resolv:__pkg__", "//lib/libc/net:__pkg__", "//lib/libc/include:__pkg__"])

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest")
[bsd_install_file(name = "config_" + name, src = source, destination = "/etc/" + name,
    owner = "root", group = "wheel", mode = mode, install_tags = ["package=runtime", "config"])
 for name, source, mode in [("group", "//etc:group", "0644"), ("master.passwd", "//etc:master.passwd", "0600"),
                           ("shells", "//etc:shells", "0644"), ("mac.conf", "//lib/libc/posix1e:mac.conf", "0644")]]
bsd_install_manifest(name = "base_config_manifest", entries = [":config_" + n for n in ["group", "master.passwd", "shells", "mac.conf"]])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Configuration plus generated fresh-system state; package payload excludes
# the untagged account database manifest. No account migration is performed.
bsd_install_archive(
    name = "config_archive",
    manifests = [":base_config_manifest", "//lib/libc/net:config_manifest", "//lib/libc/rpc:config_manifest", "//etc:account_install_manifest"],
    directories = {"/etc": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities"]}'},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

load(":composition.bzl", "COMMON_GROUPS", "TRACE_GROUPS", "STATIC_GROUPS", "SHARED_GROUPS")
load("@rules_cc//cc:defs.bzl", "cc_import", "cc_shared_library")
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_cc_objects")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load("//tools/build/bazel:configured_version_map.bzl", "bsd_configured_version_map")
bsd_dtrace_cc_objects(name = "traced_objects", libraries = TRACE_GROUPS,
    provider = ":nameres_provider", provider_object = "nameres_provider",
    copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = "traced_" + group, srcs = [":traced_objects"], output_group = group)
 for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "provider_link", objects = [":traced_regular_provider"], pic_objects = [":traced_pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":traced_regular_objects"], pic_objects = [":traced_pic_objects"], deps = [":provider_link"])
_TRACE_LINK = select({"//tools/build/bazel/config:dtrace_enabled": [":traced", ":provider_link"], "//conditions:default": TRACE_GROUPS})
bsd_component_archive(name = "static_archive", groups = COMMON_GROUPS + STATIC_GROUPS + _TRACE_LINK, visibility = ["//visibility:public"])
bsd_component_archive(name = "shared_objects_archive", groups = COMMON_GROUPS + SHARED_GROUPS + _TRACE_LINK, pic = True)
bsd_configured_version_map(name = "version_map",
    symbol_maps = ["//lib/libc/amd64:Symbol.map"] + ["//lib/libc/csu:Symbol.map"] + ["//lib/libc/db:Symbol.map"] + ["//lib/libc/compat-43:Symbol.map"] + ["//lib/libc/gdtoa:Symbol.map"] + ["//lib/libc/gen:Symbol.map"] + ["//lib/libc/gmon:Symbol.map"] + select({"//tools/build/bazel/config:iconv_enabled": ["//lib/libc/iconv:Symbol.map"], "//conditions:default": []}) + ["//lib/libc/inet:Symbol.map"] + ["//lib/libc/locale:Symbol.map"] + ["//lib/libc/nameser:Symbol.map"] + ["//lib/libc/net:Symbol.map"] + select({"//tools/build/bazel/config:hesiod_enabled": ["//lib/libc/net:Symbol.hesiod.map"], "//conditions:default": []}) + ["//lib/libc/nls:Symbol.map"] + ["//lib/libc/posix1e:Symbol.map"] + ["//lib/libc/regex:Symbol.map"] + ["//lib/libc/resolv:Symbol.map"] + ["//lib/libc/stdbit:Symbol.map"] + ["//lib/libc/stdio:Symbol.map"] + ["//lib/libc/stdlib:Symbol.map"] + ["//lib/libc/stdlib/malloc:Symbol.map"] + ["//lib/libc/stdtime:Symbol.map"] + ["//lib/libc/string:Symbol.map"] + ["//lib/libsys:syscalls.map"] + ["//lib/libsys:Symbol.sys.map"] + ["//lib/libsys/amd64:Symbol.sys.map"] + ["//lib/libc/sys:Symbol.map"] + ["//lib/libc/secure:Symbol.map"] + ["//lib/libc/rpc:Symbol.map"] + ["//lib/libc/uuid:Symbol.map"] + ["//lib/libc/xdr:Symbol.map"] + select({"//tools/build/bazel/config:nis_enabled": ["//lib/libc/yp:Symbol.map"], "//conditions:default": []}) + ["//lib/libc/capability:Symbol.map"],
    versions = "Versions.def", generator = "//share/mk:version_gen.awk",
    cpp_flags = ["-P", "-nostdinc", "-undef"] + select({"//tools/build/bazel/config:detect_tz_changes_enabled": ["-DDETECT_TZ_CHANGES"], "//conditions:default": []}),
    compiler = "@bsd_sdk//toolchain:bin/clang", compiler_inputs = "@bsd_sdk//toolchain:compile_inputs",
    cat = "@bsd_sdk//toolchain:cat", cat_runtime = "@bsd_sdk//toolchain:cat_runtime",
    awk = "@bsd_sdk//toolchain:awk", awk_runtime = "@bsd_sdk//toolchain:awk_runtime",
    redirect = "@bsd_sdk//toolchain:stdout_redirect")

# Shared libc uses its own filtered syscall bodies. Runtime dependencies remain
# below the archive root so cc_shared_library extracts only needed builtins.
cc_import(name = "shared_link_objects", static_library = ":shared_objects_archive",
    deps = ["//lib/libcompiler_rt:compiler_rt", "//lib/libsys:sys"])
cc_shared_library(name = "c_shared", deps = [":shared_link_objects"],
    dynamic_deps = ["//lib/libsys:sys_shared"], shared_lib_name = "libc.so.7",
    additional_linker_inputs = [":version_map"],
    user_link_flags = ["-nodefaultlibs", "-Wl,--auxiliary,libsys.so.7", "-Wl,-soname,libc.so.7",
        "-Wl,--version-script=$(location :version_map),--no-undefined-version",
        "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_program_test.bzl", "bsd_program_test")
# Link the existing ABI probe through the native public libc interface, then
# select native runtime runfiles. SDK headers/startup objects still apply.
cc_binary(name = "runtime_probe", srcs = ["//tools/build/bazel:tests/libc_runtime.c"],
    deps = [":shared_link_interface"], dynamic_deps = [":c_shared", "//lib/libsys:sys_shared"],
    linkopts = ["-nodefaultlibs"],
    testonly = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
bsd_program_test(name = "runtime_test", program = ":runtime_probe",
    runtime_lib = [":c_shared", "//lib/libsys:sys_shared"],
    runner = "//tools/build/bazel:program_test_runner", size = "small")

cc_import(name = "static_link_objects", static_library = ":static_archive",
    deps = ["//lib/libcompiler_rt:compiler_rt"], visibility = ["//visibility:public"])
cc_binary(name = "static_runtime_probe", srcs = ["//tools/build/bazel:tests/libc_runtime.c"],
    deps = [":static_link_objects"], features = ["fully_static_link"],
    linkopts = ["-nodefaultlibs"], linkstatic = True, testonly = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
bsd_program_test(name = "static_runtime_test", program = ":static_runtime_probe",
    runner = "//tools/build/bazel:program_test_runner", size = "small")

# Shared consumers need the nonshared public wrappers as well as the DSO.
cc_library(name = "shared_link_interface", deps = [":shared_link_objects", "//lib/libc_nonshared:nonshared"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_template.bzl", libc_link_template = "bsd_template")
libc_link_template(name = "linker_script", template = "libc_nossp.ldscript", output = "libc.ld",
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    substitutions = {"@@SHLIB@@": "/lib/libc.so.7", "@@LIBDIR@@": "/usr/lib"})
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_link")
bsd_install_file(name = "linker_script_install", src = ":linker_script", destination = "/usr/lib/libc.so",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=clibs", "dev"])
bsd_install_link(name = "xnet_link", destination = "/usr/lib/libxnet.so", target = "libc.so",
    kind = "symlink", owner = "root", group = "wheel", mode = "0444", install_tags = ["package=clibs"])
# This manifest covers the link interface only; whole libc installation is separate.
bsd_install_manifest(name = "link_interface_manifest", entries = [":linker_script_install", ":xnet_link"])
