load("//lib/libc:nossp.bzl", "LIBC_VARIANT_FEATURES")
load(":catalogs.bzl", "libc_catalogs")
libc_catalogs()

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
cc_library(features = LIBC_VARIANT_FEATURES, name = "msgcat_objects", srcs = ["msgcat.c"],
    implementation_deps = ["//lib/libc/include:rt_private_headers", "//lib/libc/locale:gdtoa_headers"],
    local_defines = ["_FORTIFY_SOURCE_read=_read", "NO__SCCSID", "NO__RCSID"] + select({"//tools/build/bazel/config:nls_enabled": ["NLS"], "//conditions:default": []}),
    copts = ["-ftls-model=initial-exec"], linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//lib/libc:__pkg__"],
)
bsd_component_archive(name = "objects_archive", groups = [":msgcat_objects"])
bsd_component_archive(name = "pic_objects_archive", groups = [":msgcat_objects"], pic = True)
exports_files(["Symbol.map"], visibility = ["//lib/libc:__pkg__"])

# Maintained manual sources consumed by libc installation.
[filegroup(name = name, srcs = [source], visibility = ["//lib/libc:__pkg__"])
 for name, source in [
    ('libc_manual_catclose.3', 'catclose.3'),
    ('libc_manual_catgets.3', 'catgets.3'),
    ('libc_manual_catopen.3', 'catopen.3'),
]]
