load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(
    name = "localedef_headers",
    hdrs = ["collate.h", "runefile.h", "lnumeric.h", "lmonetary.h", "lmessages.h", "xlocale_private.h", "setlocale.h"],
    strip_include_prefix = ".",
    visibility = ["//usr.bin/localedef:__pkg__", "//lib/libc/stdtime:__pkg__"],
)

cc_library(name = "setlocale_header", hdrs = ["setlocale.h"], strip_include_prefix = ".", visibility = ["//usr.bin/locale:__pkg__"])

cc_library(name = "gdtoa_headers", hdrs = ['xlocale_private.h', 'setlocale.h'], strip_include_prefix = ".", visibility = ["//lib/libc/nls:__pkg__", "//lib/libc/gdtoa:__pkg__", "//lib/libc/stdlib:__pkg__"])

cc_library(name = "stdio_headers", hdrs = ["xlocale_private.h", "setlocale.h", "mblocal.h", "collate.h"], strip_include_prefix = ".", visibility = ["//lib/libc/stdio:__pkg__"])

