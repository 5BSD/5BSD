        "lmonetary.h",
        "lnumeric.h",
        "mblocal.h",
        "mbrtocXX_iconv.h",
        "runefile.h",
        "setlocale.h",
        "xlocale_private.h",
        "//lib/libc/stdtime:timelocal.h",
    ] + select({
        "//tools/build/bazel/config:iconv_enabled": ["c16rtomb_iconv.c", "c32rtomb_iconv.c", "mbrtoc16_iconv.c", "mbrtoc32_iconv.c"],
        "//conditions:default": ["c16rtomb.c", "c32rtomb.c", "mbrtoc16.c", "mbrtoc32.c"],
    }),
    implementation_deps = [":localedef_headers", "//lib/libc/include:rt_private_headers"] + select({
        "//tools/build/bazel/config:iconv_enabled": ["//lib/libc/iconv:locale_headers"],
        "//conditions:default": [],
    }),
