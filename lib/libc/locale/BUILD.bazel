    ] + select({
        "//tools/build/bazel/config:iconv_enabled": ["c16rtomb_iconv.c", "c32rtomb_iconv.c", "mbrtoc16_iconv.c", "mbrtoc32_iconv.c"],
        "//conditions:default": ["c16rtomb.c", "c32rtomb.c", "mbrtoc16.c", "mbrtoc32.c"],
    }),
    implementation_deps = [":localedef_headers", "//lib/libc/include:rt_private_headers"] + select({
        "//tools/build/bazel/config:iconv_enabled": ["//lib/libc/iconv:locale_headers"],
        "//conditions:default": [],
    }),
    local_defines = ["_FORTIFY_SOURCE_read=_read", "NO__SCCSID", "NO__RCSID"] + select({"//tools/build/bazel/config:nls_enabled": ["NLS"], "//conditions:default": []}),
    copts = ["-ftls-model=initial-exec"],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//lib/libc:__pkg__"],
)
bsd_component_archive(name = "objects_archive", groups = [":locale_objects"])
bsd_component_archive(name = "pic_objects_archive", groups = [":locale_objects"], pic = True)
exports_files(["Symbol.map"], visibility = ["//lib/libc:__pkg__"])

cc_library(name = "stdtime_headers", hdrs = ["ldpart.h"], strip_include_prefix = ".", deps = [":localedef_headers"], visibility = ["//lib/libc/stdtime:__pkg__"])

cc_library(name = "regex_headers", hdrs = ["collate.h", "xlocale_private.h", "setlocale.h"], strip_include_prefix = ".", visibility = ["//lib/libc/regex:__pkg__", "//lib/libc/string:__pkg__", "//lib/libc/gen:__pkg__"])

