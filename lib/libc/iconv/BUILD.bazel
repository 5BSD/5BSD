        "citrus_mapper.c",
        "citrus_memstream.c",
        "citrus_mmap.c",
        "citrus_module.c",
        "citrus_none.c",
        "citrus_pivot_factory.c",
        "citrus_prop.c",
        "citrus_stdenc.c",
        "bsd_iconv.c",
        "iconv_compat.c",
        "_strtol.h",
        "_strtoul.h",
        "citrus_aliasname_local.h",
        "citrus_bcs.h",
        "citrus_csmapper.h",
        "citrus_db.h",
        "citrus_db_factory.h",
        "citrus_db_file.h",
        "citrus_db_hash.h",
        "citrus_esdb.h",
        "citrus_esdb_file.h",
        "citrus_fix_grouping.h",
        "citrus_hash.h",
        "citrus_iconv.h",
