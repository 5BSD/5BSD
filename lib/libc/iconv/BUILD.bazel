cc_library(
    name = "static_wrapper_objects",
    srcs = ICONV_WRAPPERS + ['_strtol.h', '_strtoul.h', 'citrus_aliasname_local.h', 'citrus_bcs.h', 'citrus_csmapper.h', 'citrus_db.h', 'citrus_db_factory.h', 'citrus_db_file.h', 'citrus_db_hash.h', 'citrus_esdb.h', 'citrus_esdb_file.h', 'citrus_fix_grouping.h', 'citrus_hash.h', 'citrus_iconv.h', 'citrus_iconv_local.h', 'citrus_lock.h', 'citrus_lookup.h', 'citrus_lookup_factory.h', 'citrus_lookup_file.h', 'citrus_mapper.h', 'citrus_mapper_local.h', 'citrus_memstream.h', 'citrus_mmap.h', 'citrus_module.h', 'citrus_namespace.h', 'citrus_none.h', 'citrus_pivot_factory.h', 'citrus_pivot_file.h', 'citrus_prop.h', 'citrus_region.h', 'citrus_stdenc.h', 'citrus_stdenc_local.h', 'citrus_stdenc_template.h', 'citrus_types.h', 'iconv-internal.h'],
    implementation_deps = ["//lib/libc/include:rt_private_headers"],
    local_defines = ["_FORTIFY_SOURCE_read=_read", "NO__SCCSID", "NO__RCSID"] + select({"//tools/build/bazel/config:nls_enabled": ["NLS"], "//conditions:default": []}),
    copts = ["-ftls-model=initial-exec"],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"] + select({"//tools/build/bazel/config:iconv_enabled": [], "//conditions:default": ["@platforms//:incompatible"]}),
    visibility = ["//lib/libc:__pkg__"],
)
# Keep static-only wrappers out of shared libc's object group. The separate
# libc_nonshared library requires PIC/hidden flags and its own qualification.
bsd_component_archive(name = "objects_archive", groups = [":iconv_objects"])
bsd_component_archive(name = "pic_objects_archive", groups = [":iconv_objects"], pic = True)
bsd_component_archive(name = "static_wrappers_archive", groups = [":static_wrapper_objects"])
exports_files(["Symbol.map"], visibility = ["//lib/libc:__pkg__"])

exports_files(ICONV_WRAPPERS + ["iconv-internal.h"], visibility = ["//lib/libc_nonshared:__pkg__"])

# Private Citrus module API, made available only to the module package.
cc_library(name = "module_headers", hdrs = glob(["citrus_*.h"]),
    strip_include_prefix = ".", visibility = ["//lib/libiconv_modules:__pkg__", "//usr.bin/mkesdb:__pkg__", "//usr.bin/mkcsmapper:__pkg__"])
