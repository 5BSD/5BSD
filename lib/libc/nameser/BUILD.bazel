load("//lib/libc:nossp.bzl", "LIBC_VARIANT_FEATURES")
load("//lib/libc:platforms.bzl", "LIBC_PORTABLE_PLATFORMS")

# Preserve the original BSD compiler source identity in assertion diagnostics.
_SOURCE_IDENTITY_COPTS = [
    "-ffile-prefix-map=" + prefix + "lib/libc/nameser/=/usr/src/lib/libc/nameser/"
    for prefix in ["", "./"]
]

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")

# libc object group; qualification archives are not independently installed.
cc_library(
    features = LIBC_VARIANT_FEATURES,
    name = "nameser_objects",
    srcs = ['ns_name.c', 'ns_netint.c', 'ns_parse.c', 'ns_print.c', 'ns_samedomain.c', 'ns_ttl.c'],
    implementation_deps = ["//lib/libc/include:resolver_port_headers"],
    local_defines = ["_FORTIFY_SOURCE_read=_read", "NO__SCCSID", "NO__RCSID"] + select({
        "//tools/build/bazel/config:nls_enabled": ["NLS"], "//conditions:default": [],
    }),
    copts = ["-ftls-model=initial-exec"] + _SOURCE_IDENTITY_COPTS,
    linkstatic = True,
    target_compatible_with = LIBC_PORTABLE_PLATFORMS,
    visibility = ["//lib/libc:__pkg__"],
)
bsd_component_archive(name = "objects_archive", groups = [":nameser_objects"])
bsd_component_archive(name = "pic_objects_archive", groups = [":nameser_objects"], pic = True)
exports_files(["Symbol.map"], visibility = ["//lib/libc:__pkg__"])
