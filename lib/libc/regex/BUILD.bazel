# SPDX-License-Identifier: BSD-2-Clause
exports_files(["regcomp.c", "regerror.c", "regexec.c", "regfree.c", "engine.c", "cname.h", "regex2.h", "utils.h"],
    visibility = ["//lib/libregex:__pkg__"])

load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "test_headers", hdrs = ["utils.h", "regex2.h"], includes = ["."], visibility = ["//lib/libregex/tests:__pkg__"])

load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
# libc uses locale collation; standalone libregex defines LIBREGEX instead.
cc_library(
    name = "regex_objects",
    srcs = ["regcomp.c", "regerror.c", "regexec.c", "regfree.c"],
    textual_hdrs = ["engine.c", "cname.h", "regex2.h", "utils.h"],
    implementation_deps = ["//lib/libc/locale:regex_headers"],
    local_defines = ["POSIX_MISTAKE", "_FORTIFY_SOURCE_read=_read", "NO__SCCSID", "NO__RCSID"] + select({"//tools/build/bazel/config:nls_enabled": ["NLS"], "//conditions:default": []}),
    copts = ["-ftls-model=initial-exec"],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//lib/libc:__pkg__"],
)
bsd_component_archive(name = "objects_archive", groups = [":regex_objects"])
bsd_component_archive(name = "pic_objects_archive", groups = [":regex_objects"], pic = True)
exports_files(["Symbol.map"], visibility = ["//lib/libc:__pkg__"])

# Maintained manual sources consumed by libc installation.
[filegroup(name = name, srcs = [source], visibility = ["//lib/libc:__pkg__"])
 for name, source in [
    ('libc_manual_regex.3', 'regex.3'),
    ('libc_manual_re_format.7', 're_format.7'),
]]
