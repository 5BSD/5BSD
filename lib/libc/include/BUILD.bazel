load("//lib/libc:nossp.bzl", "LIBC_VARIANT_FEATURES")
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(features = LIBC_VARIANT_FEATURES, name = "rt_private_headers", hdrs = ["namespace.h", "un-namespace.h", "libc_private.h"],
    strip_include_prefix = ".", deps = ["//lib/libsys:headers"], visibility = ["//lib/libssp:__pkg__", "//lib/libsys:__pkg__", "//lib/libthr:__pkg__", "//lib/librt:__pkg__", "//lib/msun:__pkg__", "//lib/libc/yp:__pkg__", "//lib/libc/xdr:__pkg__", "//lib/libc/rpc:__pkg__", "//lib/libc/resolv:__pkg__", "//lib/libc/posix1e:__pkg__", "//lib/libc/iconv:__pkg__", "//lib/libc/stdtime:__pkg__", "//lib/libc/stdlib/malloc/jemalloc:__pkg__", "//lib/libc/nls:__pkg__", "//lib/libc/compat-43:__pkg__", "//lib/libc/secure:__pkg__", "//lib/libc/gmon:__pkg__", "//lib/libc/csu:__pkg__", "//lib/libc/sys:__pkg__", "//lib/libc/db:__pkg__", "//lib/libc/locale:__pkg__", "//lib/libc/gen:__pkg__"])

cc_library(features = LIBC_VARIANT_FEATURES, name = "math_headers", hdrs = ["fpmath.h"], strip_include_prefix = ".", deps = [":rt_private_headers", "//lib/libc/amd64:math_headers"], visibility = ["//lib/libgcc_s:__pkg__", "//lib/msun:__pkg__", "//lib/libc/gdtoa:__pkg__", "//lib/libc/gen:__pkg__"])

cc_library(features = LIBC_VARIANT_FEATURES, name = "thr_headers", hdrs = ["spinlock.h"], strip_include_prefix = ".",
    deps = [":rt_private_headers"], visibility = ["//lib/libthr:__pkg__"])

cc_library(features = LIBC_VARIANT_FEATURES, name = "yp_private_headers", hdrs = ["reentrant.h"], strip_include_prefix = ".",
    deps = [":rt_private_headers"], visibility = ["//lib/libc/yp:__pkg__"])

cc_library(features = LIBC_VARIANT_FEATURES, name = "rpc_private_headers", hdrs = ["reentrant.h", "nss_tls.h", "nscache.h", "nscachedcli.h"],
    strip_include_prefix = ".", deps = [":rt_private_headers"], visibility = ["//lib/libc/rpc:__pkg__", "//lib/libc/net:__pkg__", "//lib/libc/gen:__pkg__"])

cc_library(features = LIBC_VARIANT_FEATURES, name = "resolver_port_headers", hdrs = ["port_before.h", "port_after.h", "isc/eventlib.h", "isc/platform.h", "isc/list.h"],
    strip_include_prefix = ".", visibility = ["//lib/libc/nameser:__pkg__", "//lib/libc/isc:__pkg__", "//lib/libc/resolv:__pkg__", "//lib/libc/inet:__pkg__"])

cc_library(features = LIBC_VARIANT_FEATURES, name = "resolver_private_headers", hdrs = ["reentrant.h", "resolv_mt.h"],
    strip_include_prefix = ".", deps = [":rt_private_headers", ":resolver_port_headers"], visibility = ["//lib/libc/resolv:__pkg__"])

cc_library(features = LIBC_VARIANT_FEATURES, name = "inet_private_headers", hdrs = ["resolv_mt.h"], strip_include_prefix = ".",
    deps = [":resolver_port_headers"], visibility = ["//lib/libc/inet:__pkg__"])

cc_library(features = LIBC_VARIANT_FEATURES, name = "stdio_private_headers", hdrs = ["errlst.h", "spinlock.h"], strip_include_prefix = ".", deps = [":rt_private_headers"], visibility = ["//lib/libc/stdio:__pkg__"])

cc_library(features = LIBC_VARIANT_FEATURES, name = "stdlib_headers", hdrs = ["block_abi.h", "spinlock.h"], strip_include_prefix = ".", deps = [":rt_private_headers"], visibility = ["//lib/libc/stdlib:__pkg__"])

cc_library(features = LIBC_VARIANT_FEATURES, name = "string_headers", hdrs = ["reentrant.h", "errlst.h"], strip_include_prefix = ".", deps = [":rt_private_headers", "//lib/libc/amd64:math_headers"], visibility = ["//lib/libc/string:__pkg__"])

cc_library(features = LIBC_VARIANT_FEATURES, name = "gen_directory_headers", hdrs = ["block_abi.h"], strip_include_prefix = ".", deps = [":rt_private_headers"], visibility = ["//lib/libc/gen:__pkg__"])

cc_library(features = LIBC_VARIANT_FEATURES, name = "semaphore_headers", hdrs = ["semwait_trace.h"],
    strip_include_prefix = ".", deps = [":rt_private_headers"] + select({
        "//tools/build/bazel/config:dtrace_enabled": ["//lib/libc:nameres_provider_headers"],
        "//conditions:default": [],
    }), visibility = ["//lib/libc/gen:__pkg__"])

cc_library(features = LIBC_VARIANT_FEATURES, name = "gen_helper_headers", hdrs = ["errlst.h", "reentrant.h"], strip_include_prefix = ".", deps = [":rt_private_headers"], visibility = ["//lib/libc/gen:__pkg__"])

cc_library(features = LIBC_VARIANT_FEATURES, name = "gen_support_headers", hdrs = ["spinlock.h"], strip_include_prefix = ".", deps = [":math_headers"], visibility = ["//lib/libc/gen:__pkg__"])

cc_library(features = LIBC_VARIANT_FEATURES, name = "syscall_compat_header", hdrs = ["compat.h"],
    strip_include_prefix = ".", visibility = ["//lib/libsys:__pkg__", "//lib/libc/sys:__pkg__"])

cc_library(name = "rtld_errlst_header", hdrs = ["errlst.h"], strip_include_prefix = ".",
    visibility = ["//libexec/rtld-elf:__pkg__"])

cc_library(name = "dl_private_headers", hdrs = ["namespace.h", "un-namespace.h", "libc_private.h", "reentrant.h"],
    strip_include_prefix = ".", deps = ["//lib/libsys:headers"], visibility = ["//lib/libdl:__pkg__"])
