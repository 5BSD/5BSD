load("//lib/libc:nossp.bzl", "LIBC_VARIANT_FEATURES")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_rpcgen.bzl", "bsd_rpcgen")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")

# This is a libc object group, not a replacement library for NIS consumers.
# The eventual libc aggregate selects it when the nis setting is enabled.
[bsd_rpcgen(
    name = output + "_generate",
    source = "//include/rpcsvc:yp.x",
    output = output,
    mode = mode,
    flags = ["-C"],
    cpp_flags = ["-E", "-x", "c", "-nostdinc"],
    rpcgen = "//usr.bin/rpcgen:rpcgen",
    cpp = "@bsd_sdk//toolchain:bin/cpp",
    compiler_inputs = "@bsd_sdk//toolchain:compile_inputs",
    runtime = ["@bsd_sdk//toolchain:cpp_runtime"],
) for output, mode in [("yp.h", "-h"), ("yp_xdr.c", "-c")]]

cc_library(
    features = LIBC_VARIANT_FEATURES,
    name = "protocol_headers",
    hdrs = [":yp.h"],
    include_prefix = "rpcsvc",
    visibility = ["//usr.bin/ypcat:__pkg__", "//usr.bin/ypmatch:__pkg__", "//usr.bin/ypwhich:__pkg__", "//usr.sbin/ypserv/common:__pkg__"] + ["//usr.sbin/ypbind:__pkg__", "//usr.sbin/yp_mkdb:__pkg__", "//usr.sbin/yppoll:__pkg__", "//usr.sbin/yppush:__pkg__", "//usr.sbin/ypset:__pkg__", "//usr.sbin/ypserv:__pkg__", "//usr.sbin/rpc.ypxfrd:__pkg__", "//usr.sbin/rpc.yppasswdd:__pkg__", "//usr.sbin/rpc.ypupdated:__pkg__", "//usr.sbin/ypldap:__pkg__"],
)

cc_library(
    features = LIBC_VARIANT_FEATURES,
    name = "yp_objects",
    srcs = ["xdryp.c", "yplib.c", ":yp_xdr.c", ":yp.h"],
    implementation_deps = [":protocol_headers", "//lib/libc/include:yp_private_headers"],
    local_defines = ["_FORTIFY_SOURCE_read=_read", "NO__SCCSID", "NO__RCSID"] + select({"//tools/build/bazel/config:nls_enabled": ["NLS"], "//conditions:default": []}),
    copts = ["-ftls-model=initial-exec"],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//lib/libc:__pkg__"],
)

# Object qualification artifacts; neither archive is an installed ABI.
bsd_component_archive(name = "objects_archive", groups = [":yp_objects"])
bsd_component_archive(name = "pic_objects_archive", groups = [":yp_objects"], pic = True)
exports_files(["Symbol.map"], visibility = ["//lib/libc:__pkg__"])
