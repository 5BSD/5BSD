load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
# Raw libc compilation objects. Final DOF rewriting must process the combined
# libc groups once, retaining the shared provider and its static archive anchor.
cc_library(
    name = "resolv_objects",
    srcs = ['herror.c', 'h_errno.c', 'mtctxres.c', 'res_comp.c', 'res_data.c', 'res_debug.c', 'res_findzonecut.c', 'res_init.c', 'res_mkquery.c', 'res_mkupdate.c', 'res_query.c', 'res_send.c', 'res_state.c', 'res_update.c', 'res_private.h', 'res_debug.h', 'nameres_trace.h'],
    implementation_deps = ["//lib/libc/include:resolver_private_headers", "//lib/libc/net:resolver_config_headers"] +
        select({_TRACE: ["//lib/libc:nameres_provider_headers"], "//conditions:default": []}),
    local_defines = ["_FORTIFY_SOURCE_read=_read", "NO__SCCSID", "NO__RCSID"] +
        select({"//tools/build/bazel/config:nls_enabled": ["NLS"], "//conditions:default": []}) +
        select({"//tools/build/bazel/config:inet6_support_enabled": ["INET6"], "//conditions:default": []}) +
        select({_TRACE: ["WITH_COVERAGE_DTRACE"], "//conditions:default": []}),
    copts = ["-ftls-model=initial-exec"],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//lib/libc:__pkg__"],
)
bsd_component_archive(name = "objects_archive", groups = [":resolv_objects"])
bsd_component_archive(name = "pic_objects_archive", groups = [":resolv_objects"], pic = True)
exports_files(["Symbol.map"], visibility = ["//lib/libc:__pkg__"])

cc_library(name = "net_private_headers", hdrs = ["res_private.h", "nameres_trace.h"], strip_include_prefix = ".",
    visibility = ["//lib/libc/net:__pkg__"])
