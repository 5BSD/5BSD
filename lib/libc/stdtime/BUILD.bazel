load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "localedef_headers", hdrs = ["timelocal.h"],
    strip_include_prefix = ".", deps = ["//lib/libc/locale:localedef_headers"],
    visibility = ["//usr.bin/localedef:__pkg__"])

exports_files(["timelocal.h"], visibility = ["//lib/libc/locale:__pkg__"])

load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
cc_library(
    name = 'time_objects',
    srcs = ['//contrib/tzcode:asctime.c', '//contrib/tzcode:difftime.c', 'strftime.c', 'strptime.c', 'timelocal.c', 'timelocal.h'],
    implementation_deps = ["//contrib/tzcode:headers", "//lib/libc/include:rt_private_headers", "//lib/libc/locale:stdtime_headers"],
    local_defines = ['_FORTIFY_SOURCE_read=_read', 'NO__SCCSID', 'NO__RCSID'] + select({"//tools/build/bazel/config:nls_enabled": ["NLS"], "//conditions:default": []}),
    copts = ['-ftls-model=initial-exec', '-include', 'tzconfig.h'],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//lib/libc:__pkg__"],
)
cc_library(
    name = 'localtime_objects',
    srcs = ['//contrib/tzcode:localtime.c'],
    implementation_deps = ["//contrib/tzcode:headers", "//lib/libc/include:rt_private_headers", "//lib/libc/locale:stdtime_headers"],
    local_defines = ['ALL_STATE', 'THREAD_SAFE', '_FORTIFY_SOURCE_read=_read', 'NO__SCCSID', 'NO__RCSID'] + select({"//tools/build/bazel/config:nls_enabled": ["NLS"], "//conditions:default": []}) + select({"//tools/build/bazel/config:detect_tz_changes_enabled": ["DETECT_TZ_CHANGES"], "//conditions:default": []}),
    copts = ['-ftls-model=initial-exec', '-include', 'tzconfig.h'],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//lib/libc:__pkg__"],
)
cc_library(
    name = 'time32_objects',
    srcs = ['time32.c'],
    implementation_deps = ["//contrib/tzcode:headers", "//lib/libc/include:rt_private_headers", "//lib/libc/locale:stdtime_headers"],
    local_defines = ['_FORTIFY_SOURCE_read=_read', 'NO__SCCSID', 'NO__RCSID'] + select({"//tools/build/bazel/config:nls_enabled": ["NLS"], "//conditions:default": []}),
    copts = ['-ftls-model=initial-exec'],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//lib/libc:__pkg__"],
)
bsd_component_archive(name = "objects_archive", groups = [":time_objects", ":localtime_objects", ":time32_objects"])
bsd_component_archive(name = "pic_objects_archive", groups = [":time_objects", ":localtime_objects", ":time32_objects"], pic = True)
exports_files(["Symbol.map"], visibility = ["//lib/libc:__pkg__"])
