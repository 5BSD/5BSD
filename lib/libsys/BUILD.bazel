load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test", "cc_shared_library")
cc_library(name = "headers", hdrs = ["libsys.h", "_libsys.h"], strip_include_prefix = ".", visibility = ["//lib/libc/include:__pkg__"])

exports_files(["auxv.c", "interposing_table.c", "libc_stubs.c", "ptrace.c", "recvmmsg.c", "sendmmsg.c"], visibility = ["//lib/libc/sys:__pkg__"])

exports_files(['clock_gettime.c', 'gettimeofday.c', '__vdso_gettimeofday.c', '__error.c', '__getosreldate.c', 'getpagesize.c', 'getpagesizes.c', 'libsys_sigwait.c'], visibility = ["//lib/libc/sys:__pkg__"])

load("//tools/build/bazel:bsd_syscall_asm.bzl", "bsd_syscall_asm")
load("//sys/sys:syscall_symbols.bzl", "SYSCALL_SYMBOLS")
load(":syscall_policy.bzl", "AMD64_HANDWRITTEN_SYSCALLS", "PSEUDO_SYSCALLS")

_REGULAR_SYSCALLS = [s for s in SYSCALL_SYMBOLS
                     if s not in AMD64_HANDWRITTEN_SYSCALLS and s not in PSEUDO_SYSCALLS]
_SYSCALL_STUBS = [(s, "RSYSCALL", s) for s in _REGULAR_SYSCALLS] + [
    ("_" + s, "PSEUDO", s) for s in PSEUDO_SYSCALLS
]
[bsd_syscall_asm(
    name = stem + "_asm",
    generator = "gen-syscall.sh",
    arguments = [macro, symbol, '\t.section .note.GNU-stack,"",%%progbits\n', ""],
    output = "generated/" + stem + ".S",
    shell = "@bsd_sdk//toolchain:sh",
    redirect = "@bsd_sdk//toolchain:stdout_redirect",
    runtime = ["@bsd_sdk//toolchain:sh_runtime"],
) for stem, macro, symbol in _SYSCALL_STUBS]
filegroup(
    name = "amd64_syscall_sources",
    srcs = [":" + stem + "_asm" for stem, _, _ in _SYSCALL_STUBS],
    visibility = ["//lib/libc/sys:__pkg__"],
)

load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load("//tools/build/bazel:configured_version_map.bzl", "bsd_configured_version_map")

_AMD64 = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
_HEADERS = ["//lib/libc/include:rt_private_headers",
    "//lib/libc/include:syscall_compat_header", "//lib/libsys/amd64:sys_headers",
    "//sys/sys:syscall_header"]
_DEFINES = ["LIBSYS"] + select({
    "//tools/build/bazel/config:hyperv_enabled": ["WANT_HYPERV"],
    "//conditions:default": [],
})
_COPTS = ["-ftls-model=initial-exec", "-fno-stack-protector"]
cc_library(
    name = "sys_objects",
    srcs = [":amd64_syscall_sources", "auxv.c", "interposing_table.c",
        "clock_gettime.c", "gettimeofday.c", "__vdso_gettimeofday.c",
        "__error.c", "__getosreldate.c", "getpagesize.c", "getpagesizes.c",
        "libsys_sigwait.c", "//lib/libsys/x86:pkru.c",
        "//lib/libsys/x86:sched_getcpu_x86.c"] +
        ["//lib/libsys/amd64:" + n for n in [
            "amd64_get_fsbase.c", "amd64_get_gsbase.c", "amd64_set_fsbase.c",
            "amd64_set_gsbase.c", "amd64_set_tlsbase.c", "rfork_thread.S",
            "pdrfork_thread.S", "vfork.S", "cerror.S", "getcontext.S", "_umtx_op_err.S",
        ]] + ["//lib/libc/string:" + n for n in ["memcpy.c", "memset.c", "strlcpy.c"]],
    textual_hdrs = ["//lib/libc/string:bcopy.c"],
    # Runtime builtins are dependencies of these objects, not additional DSO
    # roots: cc_shared_library whole-links roots and normally extracts deps.
    implementation_deps = _HEADERS + ["//lib/libcompiler_rt:compiler_rt"],
    local_defines = _DEFINES,
    copts = _COPTS,
    linkstatic = True,
    target_compatible_with = _AMD64,
)
# IFUNC initialization precedes sanitizer runtime initialization.
cc_library(
    name = "vdso_objects", srcs = ["//lib/libsys/x86:__vdso_gettc.c"],
    implementation_deps = _HEADERS, local_defines = _DEFINES,
    copts = _COPTS + ["-fno-sanitize=address", "-fno-sanitize=undefined"],
    linkstatic = True, target_compatible_with = _AMD64,
)
cc_library(name = "sys", deps = [":headers", ":sys_objects", ":vdso_objects"],
    target_compatible_with = _AMD64, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":sys_objects", ":vdso_objects"])
bsd_component_archive(name = "pic_archive", groups = [":sys_objects", ":vdso_objects"], pic = True)
bsd_configured_version_map(
    name = "version_map",
    symbol_maps = ["Symbol.map", "syscalls.map", "Symbol.sys.map",
        "//lib/libsys/amd64:Symbol.sys.map", "Symbol.thr.map"],
    versions = "//lib/libc:Versions.def", generator = "//share/mk:version_gen.awk",
    cpp_flags = ["-P", "-nostdinc", "-undef"],
    compiler = "@bsd_sdk//toolchain:bin/clang",
    compiler_inputs = "@bsd_sdk//toolchain:compile_inputs",
    cat = "@bsd_sdk//toolchain:cat", cat_runtime = "@bsd_sdk//toolchain:cat_runtime",
    awk = "@bsd_sdk//toolchain:awk", awk_runtime = "@bsd_sdk//toolchain:awk_runtime",
    redirect = "@bsd_sdk//toolchain:stdout_redirect",
)

# Direct syscall smoke test; links this native archive, with the SDK/host libc
# still supplying the rest of the process runtime until full libc integration.
cc_test(name = "syscall_runtime_test",
    srcs = ["//tools/build/bazel:tests/libsys_runtime.c"],
    deps = [":sys", ":headers"], linkstatic = True,
    target_compatible_with = _AMD64, size = "small",
)

cc_shared_library(name = "sys_shared", deps = [":sys"], shared_lib_name = "libsys.so.7",
    additional_linker_inputs = [":version_map"],
    user_link_flags = ["-nodefaultlibs", "-Wl,-Bsymbolic", "-Wl,-soname,libsys.so.7",
        "-Wl,--version-script=$(location :version_map),--no-undefined-version",
        "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = _AMD64, visibility = ["//visibility:public"])

cc_test(name = "syscall_shared_runtime_test",
    srcs = ["//tools/build/bazel:tests/libsys_runtime.c"],
    deps = [":sys"], dynamic_deps = [":sys_shared"],
    features = ["bsd_test_runtime_paths"],
    target_compatible_with = _AMD64, size = "small")

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"],
    directories = {"/usr/lib/debug/lib": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=clibs","dbg"]}'},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
    visibility = ["//visibility:public"])

exports_files(["syscalls.map"], visibility = ["//lib/libc:__pkg__"])

exports_files(["Symbol.sys.map"], visibility = ["//lib/libc:__pkg__"])
