# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(
    name = "headers",
    hdrs = ["capsicum_helpers.h"],
    strip_include_prefix = "/lib/libcapsicum",
    visibility = ["//visibility:public"],
)

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_link", "bsd_install_manifest", "bsd_compress")
bsd_install_file(name = "install_header", src = "capsicum_helpers.h", destination = "/usr/include/capsicum_helpers.h",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=utilities", "dev"])
bsd_compress(name = "manual", src = "capsicum_helpers.3", output = "capsicum_helpers.3.gz", arguments = ["-cn"],
    compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
_MAN_TAGS = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=utilities-man"], "//conditions:default": ["package=utilities-dev"]})
bsd_install_file(manual = True, name = "install_manual", src = ":manual", destination = "/usr/share/man/man3/capsicum_helpers.3.gz",
    owner = "root", group = "wheel", mode = "0444", install_tags = _MAN_TAGS)
_MANUAL_ALIASES = [
    'caph_enter.3',
    'caph_enter_casper.3',
    'caph_stream_rights.3',
    'caph_rights_limit.3',
    'caph_fcntls_limit.3',
    'caph_ioctls_limit.3',
    'caph_limit_stream.3',
    'caph_limit_stdin.3',
    'caph_limit_stderr.3',
    'caph_limit_stdout.3',
    'caph_limit_stdio.3',
    'caph_cache_tzdata.3',
    'caph_cache_catpages.3',
]
[bsd_install_link(manual = True, name = "install_" + alias.replace(".", "_"), destination = "/usr/share/man/man3/" + alias + ".gz",
    target = "/usr/share/man/man3/capsicum_helpers.3.gz", kind = "hardlink", owner = "root", group = "wheel", mode = "0444", install_tags = _MAN_TAGS)
 for alias in _MANUAL_ALIASES]
bsd_install_manifest(name = "install_manifest", entries = [":install_header", ":install_manual"] + [":install_" + alias.replace(".", "_") for alias in _MANUAL_ALIASES], visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Production payload only; installed test-suite contributions remain separate.
bsd_install_archive(
    name = "production_install_archive",
    visibility = ["//lib:__pkg__", "//tools/build/bazel:__pkg__"],
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive_set")
bsd_install_archive_set(name = "installation_archives", archives = [":production_install_archive"] + select({
    "//tools/build/bazel/config:tests_enabled": ["//lib/libcapsicum/tests:installation_archives"],
    "//conditions:default": [],
}), target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
