load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
# Original Make selects NO_SHARED for both original stream test programs.
cc_binary(name = "stream_test", srcs = ["stream_test.c"],
    deps = ["//lib/libcapsicum:headers", "//lib/atf/libatf-c:atf_c"],
    linkstatic = True, linkopts = ["-static"], target_compatible_with = _PLATFORM)
cc_binary(name = "stream_cxx_test", srcs = ["stream_cxx_test.cc"],
    deps = ["//lib/libcapsicum:headers", "//lib/atf/libatf-c++:atf_cxx"],
    copts = ["-std=gnu++17", "-nostdinc++"], linkstatic = True, linkopts = ["-static"], target_compatible_with = _PLATFORM)
_CASES = [("c_narrow_stream", "stream_test", "narrow_stream"),
          ("c_narrow_commands", "stream_test", "narrow_commands"),
          ("c_ordinary_and_empty", "stream_test", "ordinary_and_empty"),
          ("cxx_narrow_commands", "stream_cxx_test", "narrow_commands")]
[bsd_atf_test(name = name, case_name = case, interface = "program", body = ":" + program,
    runner = "//tools/build/bazel:atf_runner", size = "small") for name, program, case in _CASES]
test_suite(name = "tests", tests = [":" + name for name, _, _ in _CASES], visibility = ["//visibility:public"])
