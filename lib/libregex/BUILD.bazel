load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
# Ordinary archive plus an explicit PIC static consumer variant for test
# executables. The PIC archive is not a Make-installed artifact.
# The shared library uses the maintained version map below.
_SRCS = ["//lib/libc/regex:" + f for f in ["regcomp.c", "regerror.c", "regexec.c", "regfree.c"]]
_HEADERS = ["//lib/libc/regex:" + f for f in ["engine.c", "cname.h", "regex2.h", "utils.h"]]
[cc_library(name = name, srcs = _SRCS, textual_hdrs = _HEADERS,
    local_defines = ["LIBREGEX", "POSIX_MISTAKE"], copts = flags,
    linkstatic = True, visibility = ["//visibility:public"])
 for name, flags in [("regex", []), ("regex_pic", ["-fPIC"])]]

load("//tools/build/bazel:configured_version_map.bzl", "bsd_configured_version_map")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
bsd_component_archive(name = "static_archive", groups = [":regex"], visibility = ["//visibility:public"])
bsd_configured_version_map(
    name = "version_map",
    symbol_maps = ["Symbol.map"],
    versions = "Versions.def",
    generator = "//share/mk:version_gen.awk",
    # This symbol inventory has no includes or target-dependent conditionals.
    cpp_flags = ["-P", "-nostdinc", "-undef"],
    compiler = "@bsd_sdk//toolchain:bin/clang",
    compiler_inputs = "@bsd_sdk//toolchain:compile_inputs",
    cat = "@bsd_sdk//toolchain:cat",
    cat_runtime = "@bsd_sdk//toolchain:cat_runtime",
    awk = "@bsd_sdk//toolchain:awk",
    awk_runtime = "@bsd_sdk//toolchain:awk_runtime",
    redirect = "@bsd_sdk//toolchain:stdout_redirect",
)

cc_shared_library(name = "regex_shared", deps = [":regex"], shared_lib_name = "libregex.so.1",
    additional_linker_inputs = [":version_map"],
    user_link_flags = ["-Wl,-soname,libregex.so.1", "-Wl,--version-script=$(location :version_map),--no-undefined-version", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//lib:__pkg__"],
    manifests = [":install_manifest"],
    directories = {
        "/usr/lib/debug/usr": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime","dbg"]}',
        "/usr/lib/debug/usr/lib": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime","dbg"]}',
    },
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive_set")
# Preserve the original selected library payload and optional test traversal.
bsd_install_archive_set(name = "installation_archives", archives = [":install_archive"] + select({
    "//tools/build/bazel/config:tests_enabled": ["//lib/libregex/tests:install_archive"],
    "//conditions:default": [],
}), target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
