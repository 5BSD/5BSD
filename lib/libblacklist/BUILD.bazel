load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
cc_library(name = "blacklist", srcs = ['//contrib/blocklist:lib/old_bl.c', '//contrib/blocklist:lib/blacklist.c', '//contrib/blocklist:port/vsyslog_r.c'], deps = ["//contrib/blocklist:legacy_headers", "//lib/libthr:thr"], local_defines = ['_REENTRANT', 'HAVE_CONFIG_H', 'HAVE_DB_H', 'HAVE_LIBUTIL_H', 'HAVE_CLOCK_GETTIME', 'HAVE_FGETLN', 'HAVE_GETPROGNAME', 'HAVE_STRLCAT', 'HAVE_STRLCPY', 'HAVE_STRUCT_SOCKADDR_SA_LEN', 'HAVE_SYS_CDEFS_H'], copts = ["-Wno-thread-safety-analysis"], linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":blacklist"], visibility = ["//visibility:public"])
cc_shared_library(name = "blacklist_shared", deps = [":blacklist"], dynamic_deps = ["//lib/libthr:thr_shared"], shared_lib_name = "libblacklist.so.0", user_link_flags = ["-Wl,-z,defs", "-Wl,-soname,libblacklist.so.0"], visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=blocklist","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
