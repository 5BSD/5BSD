# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
_SOURCES = ['//contrib/sendmail:libmilter/main.c', '//contrib/sendmail:libmilter/engine.c', '//contrib/sendmail:libmilter/listener.c', '//contrib/sendmail:libmilter/handler.c', '//contrib/sendmail:libmilter/comm.c', '//contrib/sendmail:libmilter/monitor.c', '//contrib/sendmail:libmilter/smfi.c', '//contrib/sendmail:libmilter/signal.c', '//contrib/sendmail:libmilter/sm_gethost.c', '//contrib/sendmail:libsm/errstring.c', '//contrib/sendmail:libsm/strl.c', '//contrib/sendmail:libmilter/worker.c']
cc_library(name = "milter", srcs = _SOURCES,
    deps = ["//lib/libsm:headers", "//contrib/sendmail:milter_private_headers"],
    local_defines = ["NOT_SENDMAIL", "sm_snprintf=snprintf", "_THREAD_SAFE", "SM_CONF_POLL"] +
        select({"//tools/build/bazel/config:inet6_support_enabled": ["NETINET6"], "//conditions:default": []}) +
        select({"//tools/build/bazel/config:openssl_enabled": ["STARTTLS"], "//conditions:default": []}),
    copts = ["-Wno-deprecated-non-prototype"], linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":milter"], visibility = ["//visibility:public"])
# Match Make: consumers supply thread linkage; no invented direct dependency.
cc_shared_library(name = "milter_shared", deps = [":milter"], shared_lib_name = "libmilter.so.6",
    user_link_flags = ["-Wl,-soname,libmilter.so.6", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libmilter","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
