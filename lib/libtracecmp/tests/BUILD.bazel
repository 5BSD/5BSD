# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_kyua.bzl", "bsd_kyua_test")
load("//tools/build/bazel:bsd_link_sequence.bzl", "bsd_link_sequence")
# libdtrace's libproc dependency requires libcxxrt precedence over libc++.
# Keep this explicit at the final static consumer boundary; cc_binary owns linking.
bsd_link_sequence(name = "static_dependencies", deps = [
    "//lib/atf/libatf-c:atf_c", "//cddl/lib/libdtrace:dtrace",
    "//lib/libtracecmp:tracecmp", "//lib/libtracecmp:test_source_headers",
    "//lib/libservice:service", "//lib/libfidl:fidl", "//lib/libchannel:channel"])

[cc_binary(name = name, srcs = [name + ".c", "tracecmp_test_impl.c"] +
        (["//lib/libtracecmp:tracecmp_legacy.c"] if name == "tracecmp_test" else ["fake_service.c", "fake_service.h"]),
    deps = [":static_dependencies"] + (["//lib/libthr:thr"] if name == "client_lifecycle_test" else []),
    local_defines = ["TRACECMP_TESTING"] if name == "tracecmp_test" else [],
    linkstatic = True, linkopts = ["-static"])
 for name in ["tracecmp_test", "client_lifecycle_test"]]
[bsd_kyua_test(name = name + "_run", program = ":" + name, interface = "atf",
    case_timeout = 120 if name == "client_lifecycle_test" else 300,
    test_metadata = '{"required_user":"root"}' if name == "client_lifecycle_test" else "{}",
    tags = ["manual", "requires-matching-kernel"] if name == "client_lifecycle_test" else [],
    suite = "FreeBSD", kyua = "@bsd_sdk//toolchain:extra_kyua", clean_environment = True,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_kyua_runtime"], size = "medium", visibility = ["//visibility:public"])
 for name in ["tracecmp_test", "client_lifecycle_test"]]

load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
load(":installation.bzl", "TESTDIR", "ATF_PROGRAMS", "BINARIES")
[utility_installation(name = "install_" + p, program = p, manual = "",
    package = "libtracecmp-tests", bindir = TESTDIR) for p in BINARIES]
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ATF_PROGRAMS,
    interfaces = {p: "atf" for p in ATF_PROGRAMS},
    metadata = {n: '{"required_user":"root","timeout":"120"}' for n in ["client_lifecycle_test"]})
_FILES = [(":kyuafile", TESTDIR + "/Kyuafile")] + [
    ("//contrib/fuchsia:" + n, "/usr/share/licenses/libtracecmp-tests/fuchsia/" + n) for n in ["LICENSE", "PATENTS"]]
[bsd_install_file(name = "install_file_" + str(i), src = source, destination = dest,
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=libtracecmp-tests"])
 for i, (source, dest) in enumerate(_FILES)]
bsd_install_manifest(name = "install_extra", entries = [":install_file_" + str(i) for i in range(len(_FILES))],
    visibility = ["//lib/libtracecmp:__pkg__"])
