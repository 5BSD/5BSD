    entries = [":install_kyuafile"], visibility = ["//visibility:public"])

# Safe fault injection: the wrapped kill never sends a signal.
cc_library(name = "flopen_failure_objects", srcs = ["flopen_test.c"],
    local_defines = ["main=flopen_original_main"], copts = _TEST_FLAGS,
    deps = ["//lib/libutil:headers"], target_compatible_with = _TESTS_COMPAT)
