load("@rules_cc//cc:defs.bzl", "cc_library", "cc_import", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_spec", "bsd_dtrace_cc_objects")
load("//tools/build/bazel:configured_version_map.bzl", "bsd_configured_version_map")
load(":sources.bzl", "UTIL_SOURCES")
_SECTION_TRACE = "//tools/build/bazel/config:experimental_dtrace_section_archives_enabled"
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "headers", hdrs = ["libutil.h", "login_cap.h", "mntopts.h"], strip_include_prefix = ".", visibility = ["//visibility:public"])
bsd_dtrace_spec(name = "provider", source = "logincap_provider.d", output = "logincap_provider.o",
    flags = ["-C", "-x", "nolibs"], static_anchor = True, object_path_mode = "relative",
    dtrace = "@bsd_sdk//toolchain:extra_dtrace", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//tools/build/bazel:dtrace_runtime_object",
    tool_inputs = ["@bsd_sdk//toolchain:extra_dtrace_runtime", "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"])
bsd_dtrace_spec(name = "section_provider", source = "logincap_provider.d", output = "logincap_provider.o",
    flags = ["-C", "-x", "nolibs"], static_anchor = False, object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:bootstrap", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti",
    runtime_libraries = ["//cddl/usr.sbin/dtrace:bootstrap_runtime"],
    tool_inputs = [ "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"])
cc_library(name = "objects", srcs = UTIL_SOURCES + ["logincap_probes.h"], deps = [":headers"],
    features = ["bsd_small_pic"], copts = ['-pipe', '-fno-common', '-std=gnu17', '-Wno-format-zero-length', '-Wsystem-headers', '-Werror', '-Wall', '-Wno-format-y2k', '-W', '-Wno-unused-parameter', '-Wstrict-prototypes', '-Wmissing-prototypes', '-Wpointer-arith', '-Wreturn-type', '-Wcast-qual', '-Wwrite-strings', '-Wswitch', '-Wshadow', '-Wunused-parameter', '-Wcast-align', '-Wchar-subscripts', '-Wnested-externs', '-Wold-style-definition', '-Wno-pointer-sign', '-Wdate-time', '-Wmissing-variable-declarations', '-Wthread-safety', '-Wno-empty-body', '-Wno-string-plus-int', '-Wno-unused-const-variable', '-Wno-error=unused-but-set-parameter', '-Wno-error=cast-function-type-mismatch', '-Qunused-arguments'],
    implementation_deps = ["//lib/libc/gen:pw_scan_headers"],
    local_defines = ["NO__SCCSID"] + select({_SECTION_TRACE: ["WITH_DTRACE"], _TRACE: ["WITH_DTRACE", "WITH_DTRACE_STATIC_ANCHOR"], "//conditions:default": []}) +
        select({"//tools/build/bazel/config:inet6_support_enabled": ["INET6"], "//conditions:default": []}),
    linkstatic = True, target_compatible_with = _PLATFORM)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider",
    provider_object = "logincap_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group)
 for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"])
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"], deps = [":provider_link"])
bsd_dtrace_cc_objects(name = "section_objects", library = ":objects", provider = ":section_provider",
    provider_object = "logincap_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner",
    archive_members = True, archive_runner = "//tools/build/bazel:dtrace_archive_member")
[filegroup(name = "section_" + group, srcs = [":section_objects"], output_group = group)
 for group in ["regular_archive_objects", "pic_archive_objects"]]
cc_import(name = "section_traced", objects = [":section_regular_archive_objects"], pic_objects = [":section_pic_archive_objects"])
cc_library(name = "util", deps = [":headers"] + select({_SECTION_TRACE: [":section_traced"], _TRACE: [":traced"], "//conditions:default": [":objects"]}),
    linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
# Original Make archive has a separate provider with its retained static anchor.
# Lazy extraction follows the instrumented object's original source reference.
bsd_dtrace_cc_objects(name = "archive_objects", library = ":objects", provider = ":provider",
    provider_object = "logincap_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = "archive_" + group, srcs = [":archive_objects"], output_group = group)
 for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "archive_provider_link", objects = [":archive_regular_provider"], pic_objects = [":archive_pic_provider"])
cc_import(name = "archive_traced", objects = [":archive_regular_objects"], pic_objects = [":archive_pic_objects"])
# Explicit static Make order leaves ordinary compilation/shared link order intact.
_MAKE_STATIC_ORDER = ['_secure_path.o', 'cpuset.o', 'expand_number.o', 'flopen.o', 'fparseln.o', 'ftime.o', 'getlocalbase.o', 'gr_util.o', 'hexdump.o', 'humanize_number.o', 'kinfo_getfile.o', 'kinfo_getallproc.o', 'kinfo_getproc.o', 'kinfo_getvmmap.o', 'kinfo_getvmobject.o', 'kld.o', 'login_auth.o', 'login_cap.o', 'login_class.o', 'login_crypt.o', 'login_ok.o', 'login_times.o', 'login_tty.o', 'mntopts.o', 'pidfile.o', 'property.o', 'pty.o', 'pw_scan.o', 'pw_util.o', 'quotafile.o', 'realhostname.o', 'stub.o', 'trimdomain.o', 'uucplock.o', 'logincap_provider.o']
bsd_component_archive(name = "static_archive", groups = select({_SECTION_TRACE: [":section_traced"], _TRACE: [":archive_traced", ":archive_provider_link"], "//conditions:default": [":objects"]}),
    object_order = select({_SECTION_TRACE: [], _TRACE: [n[:-2] + ".nopic.o" for n in _MAKE_STATIC_ORDER], "//conditions:default": []}),
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_configured_version_map(
    name = "version_map",
    symbol_maps = ["Symbol.map"],
    versions = "//lib/libc:Versions.def",
    generator = "//share/mk:version_gen.awk",
    # This symbol inventory has no includes or target-dependent conditionals.
    cpp_flags = ["-P", "-nostdinc", "-undef"],
    compiler = "@bsd_sdk//toolchain:bin/clang",
    compiler_inputs = "@bsd_sdk//toolchain:compile_inputs",
    cat = "@bsd_sdk//toolchain:cat",
    cat_runtime = "@bsd_sdk//toolchain:cat_runtime",
    awk = "@bsd_sdk//toolchain:awk",
    awk_runtime = "@bsd_sdk//toolchain:awk_runtime",
    redirect = "@bsd_sdk//toolchain:stdout_redirect",
)

cc_shared_library(name = "util_shared", deps = [":util"], shared_lib_name = "libutil.so.10",
    additional_linker_inputs = [":version_map"],
    user_link_flags = ["-Wl,-x", "-Wl,-soname,libutil.so.10", "-Wl,--version-script=$(location :version_map),--no-undefined-version", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "util_installation")
util_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = select({
        "//tools/build/bazel/config:tests_enabled": {"/usr/lib/debug/lib": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime","dbg"]}'} | {
            "/usr/tests/lib/libutil": json.encode({"owner": "root", "group": "wheel", "mode": "0755", "tags": ["package=tests"]}),
        } | {path: json.encode({"owner": "root", "group": "wheel", "mode": "0755", "tags": ["package=tests", "dbg"]}) for path in [
            "/usr/lib/debug/usr", "/usr/lib/debug/usr/tests", "/usr/lib/debug/usr/tests/lib", "/usr/lib/debug/usr/tests/lib/libutil"]},
        "//conditions:default": {"/usr/lib/debug/lib": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime","dbg"]}'},
    }),
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
        "//etc/mtree:BSD.tests.dist": "/usr/tests",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

# Original rescue replacement compilation; own source files remain here.
exports_files(["login_class.c", "logincap_probes.h"], visibility = ["//rescue/librescue:__pkg__"])

# Inspect the original traced archive contract; experimental/untraced modes
# retain distinct composition and their separate qualification obligations.
load("//tools/build/bazel:bsd_python_test.bzl", "bsd_python_test")
bsd_python_test(name = "static_archive_contract_test", src = "static-archive-contract-test.py",
    data = [":static_archive", "static-archive-contract.json", "Makefile", "logincap_provider.d", "logincap_probes.h"],
    target_compatible_with = _PLATFORM + select({_SECTION_TRACE: ["@platforms//:incompatible"], _TRACE: [], "//conditions:default": ["@platforms//:incompatible"]}))

# Original tests compile these production translation units with their wrappers.
exports_files(["login_ok.c", "login_times.c", "login_cap.c"], visibility = ["//lib/libutil/tests:__pkg__"])
