load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
cc_library(name = "gtest_main", srcs = ["//contrib/googletest:googletest/src/gtest_main.cc"],
    deps = ["//lib/googletest/gtest:gtest"], copts = ["-fPIC", "-nostdinc++", "-pthread"],
    linkstatic = True, visibility = ["//visibility:public"])

cc_shared_library(name = "gtest_main_shared", deps = [":gtest_main"],
    dynamic_deps = ['//lib/googletest/gtest:gtest_shared', '//lib/libc++:cxx_shared', '//lib/libcxxrt:cxxrt_shared'],
    shared_lib_name = "libprivategtest_main.so.0",
    user_link_flags = ["-Wl,-soname,libprivategtest_main.so.0"],
    visibility = ["//visibility:public"])
