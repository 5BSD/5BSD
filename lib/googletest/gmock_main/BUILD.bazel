load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
cc_library(name = "gmock_main", srcs = ["//contrib/googletest:googlemock/src/gmock_main.cc"],
    deps = ["//lib/googletest/gmock:gmock"], copts = ["-fPIC", "-nostdinc++", "-pthread"],
    linkstatic = True, visibility = ["//visibility:public"])

cc_shared_library(name = "gmock_main_shared", deps = [":gmock_main"],
    dynamic_deps = ['//lib/googletest/gmock:gmock_shared', '//lib/libc++:cxx_shared', '//lib/libcxxrt:cxxrt_shared'],
    shared_lib_name = "libprivategmock_main.so.0",
    user_link_flags = ["-Wl,-soname,libprivategmock_main.so.0"],
    visibility = ["//visibility:public"])
