# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
cc_library(
    name = "gtest",
    srcs = ["//contrib/googletest:googletest/src/gtest-all.cc"],
    deps = ["//contrib/googletest:bsd_headers", "//lib/libc++:cxx", "//lib/libregex:regex", "//lib/libthr:thr"],
    implementation_deps = ["//contrib/googletest:bsd_implementation"],
    local_defines = ["GTEST_HAS_POSIX_RE=1", "GTEST_HAS_PTHREAD=1", "GTEST_HAS_STREAM_REDIRECTION=1"],
    copts = ["-fPIC", "-nostdinc++", "-frtti", "-pthread"],
    linkopts = ["-pthread"],
    linkstatic = True,
    visibility = ["//visibility:public"],
)

cc_shared_library(name = "gtest_shared", deps = [":gtest"],
    dynamic_deps = ['//lib/libregex:regex_shared', '//lib/libthr:thr_shared', '//lib/libc++:cxx_shared', '//lib/libcxxrt:cxxrt_shared'],
    shared_lib_name = "libprivategtest.so.0",
    user_link_flags = ["-Wl,-soname,libprivategtest.so.0"],
    visibility = ["//visibility:public"])
