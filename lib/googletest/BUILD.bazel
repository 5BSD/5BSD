# SPDX-License-Identifier: BSD-2-Clause
exports_files(["installation.bzl"])
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_manifest")
config_setting(name = "test_install_enabled", flag_values = {
    "//tools/build/bazel/config:tests": "true", "//tools/build/bazel/config:googletest": "true"})
bsd_install_manifest(name = "install_manifest", merge_identical_directories = True,
    manifests = ["//lib/googletest/" + component + ":install_manifest"
        for component in ["gtest", "gmock", "gmock_main", "gtest_main"]] +
        select({":test_install_enabled": ["//lib/googletest/tests:install_manifest"], "//conditions:default": []}),
    visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_manifest(name = "production_install_manifest", merge_identical_directories = True,
    manifests = ["//lib/googletest/" + component + ":install_manifest"
        for component in ["gtest", "gmock", "gmock_main", "gtest_main"]])
bsd_install_archive(name = "production_install_archive", manifests = [":production_install_manifest"],

    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"],

    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include", "//etc/mtree:BSD.debug.dist": "/usr/lib",
        "//etc/mtree:BSD.tests.dist": "/usr/tests"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive_set")
bsd_install_archive_set(name = "installation_archives", archives = select({
    ":test_install_enabled": [":install_archive"],
    "//conditions:default": [":production_install_archive"],
}), target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
