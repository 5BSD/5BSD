load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/build/bazel:bsd_template.bzl", "bsd_template")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load(":sources.bzl", "SM_SOURCES")
bsd_template(name = "os_header", template = "//contrib/sendmail:include/sm/os/sm_os_freebsd.h", output = "sm_os.h", substitutions = {})
cc_library(name = "headers", hdrs = [":os_header"], strip_include_prefix = ".", deps = ["//contrib/sendmail:headers"], visibility = ["//visibility:public"])
[cc_library(name = name, srcs = SM_SOURCES, deps = [":headers"], linkstatic = True,
    local_defines = ["NEWDB", "NIS", "MAP_REGEX", "NOT_SENDMAIL", "HAVE_NANOSLEEP"] + select({"//tools/build/bazel/config:inet6_support_enabled": ["NETINET6"], "//conditions:default": []}),
    copts = ["-std=gnu17", "-Wno-deprecated-non-prototype"] + flags,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
 for name, flags in [("sm", []), ("sm_pie", ["-fPIE"])]]
# libsm is an internal build archive, with no installed public library payload.
bsd_component_archive(name = "static_archive", groups = [":sm"], visibility = ["//visibility:public"])

bsd_component_archive(name = "pie_archive", groups = [":sm_pie"], visibility = ["//visibility:public"])
[cc_test(name = "test_" + n, srcs = ["//contrib/sendmail:libsm/t-" + n + ".c"], deps = [":sm"], linkstatic = True,
    copts = ["-std=gnu17", "-Wno-deprecated-non-prototype"]) for n in ["string", "strl", "scanf", "strio", "match"]]
test_suite(name = "tests", tests = [":test_" + n for n in ["string", "strl", "scanf", "strio", "match"]])
