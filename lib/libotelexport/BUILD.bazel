load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_unavailable.bzl", "bsd_unavailable")

# The archives are not buildable natively yet.  Make's libotelexport has 15
# sources (the six of the 2026-10-30 native candidate plus oe_id, oe_sink,
# oe_otlpenc, oe_otlpfile, oe_sysconf, oe_service, oe_otlppb, oe_otlppost and
# oe_grpc) and 48 OTLP files generated by protoc with the upb plugins from
# contrib/opentelemetry-proto, and links libucl, libupb and libprivatenghttp2
# besides zlib, OpenSSL and libthr.  The native graph has no protoc, upb
# plugin, libupb, nghttp2 or Abseil/protobuf targets to generate and link
# them, so building the old six-source list would produce a stale library.
# The declared-toolchain probes (tools/build/bazel/otel-probe.py,
# protobuf-probe.py, dtrace-probe.py) build and compare the current library.
_REASON = ("lib/libotelexport needs the OTLP protobuf closure (protoc and " +
           "the upb plugins generating contrib/opentelemetry-proto, libupb, " +
           "libprivatenghttp2, libucl), which the native graph does not " +
           "provide yet; the six-source native candidate of 2026-10-30 is " +
           "stale. Use tools/build/bazel/otel-probe.py or protobuf-probe.py " +
           "for the current library (see tools/build/bazel/README.md).")
cc_library(name = "headers", hdrs = ["otelexport.h"], strip_include_prefix = ".", visibility = ["//visibility:public"])
cc_library(name = "private_headers", hdrs = ["oe_http.h"], strip_include_prefix = ".", visibility = ["//lib/libotelexport/tests:__pkg__"])
[bsd_unavailable(name = "otelexport" + suffix, reason = _REASON,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
 for suffix in ["", "_pie"]]
[bsd_unavailable(name = name, reason = _REASON, visibility = ["//visibility:public"])
 for name in ["static_archive", "pie_archive"]]

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {"/usr/share/licenses/opentelemetry-proto": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities"]}'},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
