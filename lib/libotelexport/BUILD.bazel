# SPDX-License-Identifier: BSD-2-Clause
# libotelexport (lib/libotelexport/Makefile): INTERNALLIB, WARNS 6, -I
# contrib/libucl/include -I contrib/nghttp2/lib/includes -I lib/libnghttp2,
# LIBADD z ssl crypto pthread ucl upb nghttp2, and the OTLP binding set of
# lib/protobuf/protoc-gen.mk (PROTO_SETS otlp, PROTO_LANG upbdefs): the
# generated mini-table and definition sources follow SRCS in the archives.
# libotelexport.a and libotelexport_pie.a stay in the object tree; Make
# installs the manuals and the opentelemetry-proto licence.
#
# Consumers add their own thread library: DTrace(1) links this library, and
# the instrumented native libthr needs DTrace to build, so the library's own
# closure must not contain it (Make's LIBADD pthread resolves at the
# consumer's final link).
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load("//tools/build/bazel:bsd_protobuf.bzl", "bsd_protoc_generate")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
# Makefile SRCS order.
SOURCES = [
    "oe_util.c",
    "oe_id.c",
    "oe_sink.c",
    "oe_text.c",
    "oe_jsonl.c",
    "oe_collapsed.c",
    "oe_http.c",
    "oe_otlpenc.c",
    "oe_otlpprof.c",
    "oe_profdict.c",
    "oe_otlp.c",
    "oe_otlpfile.c",
    "oe_sysconf.c",
    "oe_service.c",
    "oe_otlppb.c",
    "oe_otlppost.c",
    "oe_grpc.c",
]
# PROTO_FILES.otlp, in order.
OTLP_PROTOS = [
    "opentelemetry/proto/common/v1/common.proto",
    "opentelemetry/proto/resource/v1/resource.proto",
    "opentelemetry/proto/logs/v1/logs.proto",
    "opentelemetry/proto/metrics/v1/metrics.proto",
    "opentelemetry/proto/trace/v1/trace.proto",
    "opentelemetry/proto/profiles/v1development/profiles.proto",
    "opentelemetry/proto/collector/logs/v1/logs_service.proto",
    "opentelemetry/proto/collector/metrics/v1/metrics_service.proto",
    "opentelemetry/proto/collector/trace/v1/trace_service.proto",
    "opentelemetry/proto/collector/profiles/v1development/profiles_service.proto",
]
bsd_protoc_generate(name = "otlp", srcs = ["//contrib/opentelemetry-proto:" + proto for proto in OTLP_PROTOS],
    proto_root = "contrib/opentelemetry-proto", language = "upbdefs")
filegroup(name = "otlp_sources", srcs = [":otlp"], output_group = "sources")
filegroup(name = "otlp_headers", srcs = [":otlp"], output_group = "headers")
# The generated include root (PROTOGEN.otlp) with upb's headers.
cc_library(name = "otlp_bindings", hdrs = [":otlp_headers"], includes = ["otlp"], deps = ["//contrib/protobuf:upb_headers"],
    visibility = ["//lib/libotelexport/tests:__pkg__"])
# Consumers add -I lib/libotelexport and include otelexport.h and oe_sysconf.h.
cc_library(name = "headers", hdrs = ["otelexport.h", "oe_sysconf.h"], strip_include_prefix = ".", visibility = ["//visibility:public"])
cc_library(name = "private_headers", hdrs = ["oe_http.h", "oe_otlpenc.h", "oe_otlppb.h", "oe_profdict.h"],
    strip_include_prefix = ".", visibility = ["//lib/libotelexport/tests:__pkg__", "//cddl/lib/libdtotel/tests:__pkg__"])
[cc_library(name = "otelexport" + suffix, srcs = SOURCES + [":otlp_sources"],
    deps = [":headers", "//lib/libz:z", "//secure/lib/libssl:ssl", "//secure/lib/libcrypto:crypto",
        "//lib/libucl:ucl", "//lib/protobuf/libupb:upb" + suffix, "//lib/libnghttp2:nghttp2"],
    implementation_deps = [":private_headers", ":otlp_bindings", "//contrib/libucl:headers", "//lib/libnghttp2:headers"],
    copts = copts, linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
 for suffix, copts in [("", []), ("_pie", ["-fpie"])]]
bsd_component_archive(name = "static_archive", groups = [":otelexport"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "pie_archive", groups = [":otelexport_pie"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Library payload; the test installation is added with tests enabled.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"] + select({"//tools/build/bazel/config:tests_enabled": ["//lib/libotelexport/tests:install_manifest", "//lib/libotelexport/tests/pbcpp:install_manifest"] + ["//lib/libotelexport/tests:install_" + name for name in ["otelexport_test", "otlp_validate", "otlp_collector", "otlppb_encode", "sysconf_test", "sysconf_oom_test", "otlppb_test", "otlpprof_test", "signals_test", "otlp_pb_receiver"]], "//conditions:default": []}),
    directories = {"/usr/share/licenses/opentelemetry-proto": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities"]}'} |
        select({"//tools/build/bazel/config:tests_enabled": {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libotelexport-tests","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/tests", "/usr/lib/debug/usr/tests/lib", "/usr/lib/debug/usr/tests/lib/libotelexport"]} |
            {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libotelexport-tests"]}' for d in ["/usr/tests/lib/libotelexport", "/usr/tests/lib/libotelexport/golden"]}, "//conditions:default": {}}),
    mtree_specs = {
        "//etc/mtree:BSD.tests.dist": "/usr/tests",
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
