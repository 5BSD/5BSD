# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "headers", hdrs = ["camlib.h", "scsi_wrap.h"], deps = ["//sys/cam:headers"], strip_include_prefix = ".", visibility = ["//visibility:public"])
cc_library(name = "cam", srcs = ['camlib.c', 'scsi_cmdparse.c', '//sys/cam:scsi/scsi_all.c', '//sys/cam:scsi/scsi_da.c', '//sys/cam:scsi/scsi_sa.c', '//sys/cam:cam.c', '//sys/cam:ata/ata_all.c', '//sys/cam:nvme/nvme_all.c', '//sys/dev/nvme:nvme_util.c', '//sys/cam:scsi/smp_all.c', 'scsi_wrap.c'],
    deps = [":headers", "//lib/libsbuf:sbuf"],
    linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":cam"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_shared_library(name = "cam_shared", deps = [":cam"], dynamic_deps = ["//lib/libsbuf:sbuf_shared"],
    shared_lib_name = "libcam.so.7", user_link_flags = ["-Wl,-soname,libcam.so.7", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_debug_directories")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//lib:__pkg__"],
    manifests = [":install_manifest"],
    directories = utility_debug_directories("runtime", "/lib"),
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

load("@rules_cc//cc:defs.bzl", "cc_import", "cc_test")
cc_import(name = "archive_link", static_library = ":static_archive")
[cc_test(name = "topology_" + variant, srcs = ["topology_test.c"],
    deps = ([":archive_link", ":headers", "//lib/libsbuf:sbuf"] if variant == "static" else [":cam"]),
    dynamic_deps = [] if variant == "static" else [":cam_shared", "//lib/libsbuf:sbuf_shared"],
    features = [] if variant == "static" else ["bsd_test_runtime_paths"], linkstatic = variant == "static",
    size = "small", target_compatible_with = _PLATFORM)
 for variant in ["static", "shared"]]

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive_set")
bsd_install_archive_set(name = "installation_archives", archives = [":install_archive"] + select({
    "//tools/build/bazel/config:tests_enabled": ["//lib/libcam/tests:installation_archives"],
    "//conditions:default": [],
}), target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
