.Fn appbundle_nservices "const struct appbundle *b"
.Ft "struct appbundle_service *"
.Fn appbundle_service "const struct appbundle *b" "unsigned idx"
.Ft const char *
.Fn appbundle_svc_program "const struct appbundle_service *s"
.Ft const char *
.Fn appbundle_svc_label "const struct appbundle_service *s"
.Ft unsigned
.Fn appbundle_svc_nprovides "const struct appbundle_service *s"
.Ft const char *
.Fn appbundle_svc_provides "const struct appbundle_service *s" "unsigned idx"
