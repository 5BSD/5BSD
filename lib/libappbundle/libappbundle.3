.Dd June 7, 2026
.Dt LIBAPPBUNDLE 3
.Os
.Sh NAME
.Nm libappbundle
.Nd parse and validate 5BSD .app bundles
.Sh LIBRARY
.Lb libappbundle
.Sh SYNOPSIS
.In libappbundle.h
.Ft int
.Fn appbundle_open "const char *path" "struct appbundle **bp" "char *errbuf" "size_t errlen"
.Ft void
.Fn appbundle_close "struct appbundle *b"
