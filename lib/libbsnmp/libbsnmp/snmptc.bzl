"""Generate textual-convention declarations using the native execution tool."""
def _generate(ctx):
    body = ctx.actions.declare_file(ctx.label.name + ".body")
    prefix = ctx.actions.declare_file(ctx.label.name + ".prefix")
    suffix = ctx.actions.declare_file(ctx.label.name + ".suffix")
    output = ctx.actions.declare_file("snmptc.h")
    # Preserve the maintained header wrapper from libbsnmp's Makefile.
    ctx.actions.write(prefix, "/* autogenerated from tc.def */\n#ifndef snmptc_h_1529923773\n#define snmptc_h_1529923773\n")
    ctx.actions.write(suffix, "#endif\n")
    ctx.actions.run(executable = ctx.executable.redirect,
        arguments = ["--stdin", ctx.file.source.path, body.path, ctx.executable.generator.path, "-E", "-f"],
        inputs = [ctx.file.source], tools = [ctx.attr.generator[DefaultInfo].files_to_run],
        outputs = [body], mnemonic = "BsdSnmpConventions", env = {"LC_ALL": "C"})
    ctx.actions.run(executable = ctx.executable.redirect,
        arguments = [output.path, ctx.executable.cat.path, prefix.path, body.path, suffix.path],
        inputs = [prefix, body, suffix],
        tools = [ctx.attr.cat[DefaultInfo].files_to_run] + ctx.files.cat_runtime,
        outputs = [output], mnemonic = "BsdSnmpHeader", env = {"LC_ALL": "C"})
    return [DefaultInfo(files = depset([output]))]

snmp_conventions = rule(implementation = _generate, attrs = {
    "source": attr.label(mandatory = True, allow_single_file = True),
    "generator": attr.label(mandatory = True, executable = True, cfg = "exec"),
    "redirect": attr.label(mandatory = True, executable = True, allow_single_file = True, cfg = "exec"),
    "cat": attr.label(mandatory = True, executable = True, allow_single_file = True, cfg = "exec"),
    "cat_runtime": attr.label_list(allow_files = True, cfg = "exec"),
})
