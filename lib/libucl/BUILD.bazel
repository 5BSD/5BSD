# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(
    name = "ucl",
    srcs = ["//contrib/libucl:src/" + source for source in [
        "ucl_emitter_streamline.c", "ucl_emitter_utils.c", "ucl_emitter.c",
        "ucl_hash.c", "ucl_msgpack.c", "ucl_parser.c", "ucl_schema.c",
        "ucl_sexp.c", "ucl_util.c",
    ]],
    deps = ["//contrib/libucl:headers", "//lib/msun:m"],
    implementation_deps = ["//contrib/libucl:source_headers", "//contrib/libucl:uthash_headers", "//contrib/libucl:klib_headers"],
    linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"],
)
bsd_component_archive(name = "static_archive", groups = [":ucl"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_shared_library(name = "ucl_shared", deps = [":ucl"], dynamic_deps = ["//lib/msun:m_shared"],
    shared_lib_name = "libprivateucl.so.1", user_link_flags = ["-Wl,-soname,libprivateucl.so.1", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Private library installation matches the maintained base payload.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//lib:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libucl","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
