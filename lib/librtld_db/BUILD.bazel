load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
cc_library(name = "headers", hdrs = ["rtld_db.h"], strip_include_prefix = ".", visibility = ["//visibility:public"])
cc_library(name = "rtld_db", srcs = ["rtld_db.c"], deps = [":headers", "//lib/libelf:elf", "//lib/libprocstat:procstat"],
    implementation_deps = ["//lib/libproc:headers", "//lib/libutil:headers"],
    linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":rtld_db"], visibility = ["//visibility:public"])
cc_shared_library(name = "rtld_db_shared", deps = [":rtld_db"],
    dynamic_deps = ["//lib/libelf:elf_shared", "//lib/libprocstat:procstat_shared"],
    shared_lib_name = "librtld_db.so.2", user_link_flags = ["-Wl,-soname,librtld_db.so.2", "-Wl,--fatal-warnings,--warn-shared-textrel"], visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
# Production contribution only; selected installed tests require separate closure.
bsd_install_archive(
    name = "production_install_archive",
    visibility = ["//lib:__pkg__", "//tools/build/bazel:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
