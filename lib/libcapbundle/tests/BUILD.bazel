load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_script_wrapper")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
# Installation retains the original dynamic ATF/component ABI and load order.
# Existing static programs remain separate host candidates.
cc_import(name = "installed_atf_abi", shared_library = "//lib/atf/libatf-c:atf_c_shared", deps = ["//contrib/atf:c_headers"])
cc_import(name = "installed_capbundle_abi", shared_library = "//lib/libcapbundle:capbundle_shared", deps = ["//lib/libcapbundle:internal_headers", "//contrib/libucl:headers"])
bsd_link_sequence(name = "installed_link", deps = [":installed_atf_abi", ":installed_capbundle_abi", "//lib/libc:shared_abi_interface"])
[cc_binary(name = program + "_installed", srcs = [program + ".c"], deps = [":installed_link"],
    copts = ["-fpie"] + libc_test_copts(6), defines = ["PIC"], linkopts = ["-pie", "-nodefaultlibs"]) for program in _CASES]
[utility_installation(name = "install_" + program, program = program, binary = ":" + program + "_installed", manual = "", package = "libcapbundle-tests", bindir = "/usr/tests/lib/libcapbundle") for program in _CASES]
# Preserve the installed shell suite; native runtime needs switchboardctl first.
bsd_script_wrapper(name = "capbundle_format_test", body = "capbundle_format_test.sh", interpreter = "/usr/libexec/atf-sh", cat = "@bsd_sdk//toolchain:cat", cat_runtime = ["@bsd_sdk//toolchain:cat_runtime"], redirect = "@bsd_sdk//toolchain:stdout_redirect")
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = sorted(list(_CASES.keys()) + ["capbundle_format_test"]), interfaces = {program: "atf" for program in list(_CASES.keys()) + ["capbundle_format_test"]})
[bsd_install_file(name = "install_" + name, src = source, destination = "/usr/tests/lib/libcapbundle/" + name, owner = "root", group = "wheel", mode = mode, install_tags = ["package=libcapbundle-tests"]) for name, source, mode in [("Kyuafile", ":kyuafile", "0444"), ("capbundle_format_test", ":capbundle_format_test", "0555"), ("switchboardctl", "switchboardctl", "0555")]]
bsd_install_manifest(name = "install_extra", entries = [":install_Kyuafile", ":install_capbundle_format_test", ":install_switchboardctl"], visibility = ["//lib/libcapbundle:__pkg__"])

