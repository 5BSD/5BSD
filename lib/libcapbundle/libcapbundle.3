.Dd July 29, 2026
.Dt LIBCAPBUNDLE 3
.Os
.Sh NAME
.Nm libcapbundle
.Nd parse and validate 5BSD .cap bundles
.Sh LIBRARY
.Lb libcapbundle
.Sh SYNOPSIS
.In libcapbundle.h
