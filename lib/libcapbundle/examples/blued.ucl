# blued.ucl - Units/blued.unit/Unit.ucl example.
#
# blued is the sole owner of the Bluetooth radio.  It acquires device and
# network authority at runtime from system.Device and system.Network, then
# brokers already-connected, rights-limited data descriptors to clients.
# Unit manifests deliberately contain no launch-time path or network grants.

activation { ipc = ["system.Bluetooth"]; }
restart = "on-failure";
stop_timeout = 10;
