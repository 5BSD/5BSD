# skybluemeshd.ucl - serviced manifest for the BLE mesh daemon.
#
# skybluemeshd is a radio CLIENT of skyblued, not a second HCI owner.
# It drives mesh advertising and scanning through skyblued's mesh-bearer
# API and reuses skyblued's L2CAP broker for the GATT-proxy bearer, so
# it declares NO Bluetooth network capability: with AF_BLUETOOTH
# reserved to skyblued's nonce, any socket(PF_BLUETOOTH, ...) it tried
# would be denied EACCES at create time.  It reaches the radio only via
# the fds skyblued hands it over the control socket.

bundle_id = "org.5bsd.skybluemesh";
version = "1.0";
author = "5BSD";
program = "skybluemeshd";
provides = ["org.5bsd.blemesh"];
restart = "on-failure";
stop_timeout = 10;

# No capabilities.network entry: mesh gets its radio from skyblued's
# broker, never from a Bluetooth socket of its own.
