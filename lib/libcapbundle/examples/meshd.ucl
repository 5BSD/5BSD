# meshd.ucl - Units/meshd.unit/Unit.ucl example.
#
# meshd is a radio CLIENT of blued, not a second HCI owner.
# It drives mesh advertising and scanning through blued's mesh-bearer
# API and reuses blued's L2CAP broker for the GATT-proxy bearer, so
# it declares NO Bluetooth network capability: with AF_BLUETOOTH
# reserved to blued's nonce, any socket(PF_BLUETOOTH, ...) it tried
# would be denied EACCES at create time.  It reaches the radio only via
# the fds blued hands it over the control socket.

activation { ipc = ["org.5bsd.blemesh"]; }
restart = "on-failure";
stop_timeout = 10;

# No capabilities.network entry: mesh gets its radio from blued's
# broker, never from a Bluetooth socket of its own.
