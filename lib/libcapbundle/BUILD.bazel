load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "headers", hdrs = ["libcapbundle.h"], strip_include_prefix = ".", visibility = ["//visibility:public"])
cc_library(name = "internal_headers", hdrs = ["libcapbundle_internal.h", "switchboard_manifest.h", "gates.h"], strip_include_prefix = ".", deps = [":headers", "//lib/libcapsulert:headers", "//sys/dev/mac_capability:system_headers"], visibility = ["//usr.sbin/BSDFilesystem/tests:__pkg__", "//usr.sbin/capsule:__pkg__", "//lib/libcapbundle/tests:__pkg__", "//usr.sbin/switchboardctl:__pkg__", "//usr.sbin/switchboard:__pkg__"])
cc_library(name = "capbundle", srcs = ["libcapbundle.c", "libcapbundle_parse.c", "libcapbundle_verify.c", "libcapbundle_sign.c"],
    deps = [":headers", "//lib/libcapsulert:capsulert", "//lib/libucl:ucl", "//lib/libmd:md_link", "//lib/libcapimage:capimage"],
    implementation_deps = [":internal_headers", "//sys/sys:zfshandle_header", "//sys/dev/mac_capability:isolation_headers", "//sys/dev/mac_capability:capprotect_headers"],
    linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":capbundle"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_shared_library(name = "capbundle_shared", deps = [":capbundle"],
    dynamic_deps = ["//lib/libcapsulert:capsulert_shared", "//lib/libucl:ucl_shared", "//lib/libmd:md_shared", "//lib/libcapimage:capimage_shared"],
    shared_lib_name = "libcapbundle.so.2", user_link_flags = ["-Wl,-soname,libcapbundle.so.2", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//lib:__pkg__"],
    manifests = [":install_manifest"] + select({"//tools/build/bazel/config:tests_enabled": ["//lib/libcapbundle/tests:install_api_test", "//lib/libcapbundle/tests:install_management_test", "//lib/libcapbundle/tests:install_manifest_activation_test", "//lib/libcapbundle/tests:install_manifest_attributes_test", "//lib/libcapbundle/tests:install_manifest_launch_test", "//lib/libcapbundle/tests:install_manifest_policy_test", "//lib/libcapbundle/tests:install_sysctl_isolate_test", "//lib/libcapbundle/tests:install_extra"], "//conditions:default": []}),
    directories = {"/usr/share/examples/libcapbundle": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libcapbundle"]}'} | {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libcapbundle","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]} | select({"//tools/build/bazel/config:tests_enabled": {
        "/usr/tests/lib/libcapbundle": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libcapbundle-tests"]}',
        "/usr/lib/debug/usr": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libcapbundle-tests","dbg"]}',
        "/usr/lib/debug/usr/tests": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libcapbundle-tests","dbg"]}',
        "/usr/lib/debug/usr/tests/lib": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libcapbundle-tests","dbg"]}',
        "/usr/lib/debug/usr/tests/lib/libcapbundle": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libcapbundle-tests","dbg"]}',
    }, "//conditions:default": {}}),
    mtree_specs = {
        "//etc/mtree:BSD.tests.dist": "/usr/tests",
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

exports_files(["libcapbundle_sign.c"], visibility = ["//usr.sbin/switchboard/tests:__pkg__"])

cc_library(name = "gates_headers", hdrs = ["gates.h"], strip_include_prefix = ".", deps = ["//sys/dev/mac_capability:system_headers"], visibility = ["//usr.sbin/bsd-build/capsule-policy-validate:__pkg__"])
