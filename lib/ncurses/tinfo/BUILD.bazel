    name = "tinfo_shared",
    deps = [":tinfo"],
    shared_lib_name = "libtinfow.so." + str(LIBRARY_ABIS["tinfow"]),
    user_link_flags = ["-Wl,-soname,libtinfow.so." + str(LIBRARY_ABIS["tinfow"]), "-Wl,--fatal-warnings,--warn-shared-textrel"],
    visibility = ["//visibility:public"],
)
bsd_component_archive(name = "static_archive", groups = [":tinfo"], visibility = ["//visibility:public"])

load(":manuals.bzl", "MANUAL_SOURCES")

# Restrict substitutions to the maintained MANFILTER contract. Other template
# markers in prose remain unchanged, even when they are known header settings.
[bsd_awk_output(
    name = "manual_" + manual.replace(".", "_"),
    script = "configure-header.awk",
    srcs = ["header-policy.conf", "//contrib/ncurses:dist.mk", source],
    variables = {"substitution_names": "TERMINFO,DATADIR,NCURSES_OSPEED,NCURSES_MAJOR,NCURSES_MINOR,NCURSES_PATCH,TPUT,TSET,RESET,CLEAR,TABS,TIC,TOE,INFOCMP,CAPTOINFO,INFOTOCAP"},
    output = "manuals/" + manual,
    awk = "@bsd_sdk//toolchain:awk",
    redirect = "@bsd_sdk//toolchain:stdout_redirect",
    runtime = ["@bsd_sdk//toolchain:awk_runtime"],
) for manual, source in MANUAL_SOURCES.items()]

bsd_script_output(
    name = "terminfo_manual_source",
    script = "generate-terminfo.sh",
    src = "//contrib/ncurses:man/MKterminfo.sh",
    additional_sources = ["//contrib/ncurses:man/terminfo.head", "//contrib/ncurses:include/Caps", "//contrib/ncurses:man/terminfo.tail"],
    input_mode = "argument",
    output = "terminfo.5",
    path_tools = {"@bsd_sdk//toolchain:" + tool: name for tool, name in [
        ("sh", "sh"), ("cat", "cat"), ("sed", "sed"), ("rm", "rm"), ("extra_sort", "sort"), ("extra_tr", "tr"), ("extra_mktemp", "mktemp"),
    ]} | {"//bin/mkdir:mkdir": "mkdir"},
    shell = "@bsd_sdk//toolchain:sh",
    redirect = "@bsd_sdk//toolchain:stdout_redirect",
    runtime = ["@bsd_sdk//toolchain:" + name + "_runtime" for name in ["sh", "cat", "sed", "rm", "extra_sort", "extra_tr", "extra_mktemp"]],
    runtime_libraries = ["@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"],
)

load(":installation.bzl", "library_manual_installation")
library_manual_installation(name = "library_manual_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(
    name = "library_manual_archive",
    manifests = [":library_manual_manifest"],
    directories = {"/usr/lib/debug/lib": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=ncurses","dbg"]}'},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

load(":pkgconfig.bzl", "ncurses_pkgconfig")
[ncurses_pkgconfig(
    name = "pkgconfig_" + module,
    module = module,
    abi = LIBRARY_ABIS[module],
    description = "terminal interface library" if module == "tinfow" else ("library" if module == "ncursesw" else "add-on library"),
    requires = "" if module in ["ncursesw", "tinfow"] else "ncursesw",
    libraries = [module] + (["tinfow"] if module == "ncursesw" else []),
    template = "pkgconfig.pc.in",
    version = "//contrib/ncurses:dist.mk",
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib"],
) for module in ["ncursesw", "tinfow", "formw", "menuw", "panelw"]]

load(":installation.bzl", "pkgconfig_installation")
pkgconfig_installation(name = "pkgconfig_manifest")
bsd_install_archive(
    name = "install_archive",
    manifests = [":library_manual_manifest", ":pkgconfig_manifest"],
    directories = {"/usr/lib/debug/lib": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=ncurses","dbg"]}'},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

exports_files(["configure-header.awk", "header-policy.conf"], visibility = ["//lib/ncurses:__subpackages__", "//usr.bin/ncurses:__pkg__"])
