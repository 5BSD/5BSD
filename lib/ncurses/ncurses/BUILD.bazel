    shared_lib_name = "libncursesw.so." + str(LIBRARY_ABIS["ncursesw"]),
    dynamic_deps = ["//lib/ncurses/tinfo:tinfo_shared"],
    user_link_flags = ["-Wl,-soname,libncursesw.so." + str(LIBRARY_ABIS["ncursesw"]), "-Wl,--fatal-warnings,--warn-shared-textrel"],
    visibility = ["//visibility:public"])

load(":installation.bzl", "install_library")
install_library(name = "install_manifest")
