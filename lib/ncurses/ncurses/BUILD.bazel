    shell = "@bsd_sdk//toolchain:sh",
    redirect = "@bsd_sdk//toolchain:stdout_redirect",
) for name, script, source, additional, output in [
    ("library_source", "generate-library.sh", "//contrib/ncurses:ncurses/base/MKlib_gen.sh", ["//lib/ncurses/tinfo:curses_header"], "lib_gen.c"),
