load("//tools/build/bazel:bsd_fidl.bzl", "bsd_fidl_ir", "bsd_fidl_bindings")
exports_files(["filesystemcmp.fidl"])
bsd_fidl_ir(name = "filesystem_ir", schemas = ["//lib/libfidl/tests:zx.fidl", "filesystemcmp.fidl"], available = "bsd:1",
    compiler = "//tools/build/fuchsia/fidlc:fidlc",
    runtime_libraries = ["//lib/libmd:md_shared", "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared",
        "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7", "@bsd_sdk//toolchain:sysroot/lib/libgcc_s.so.1"])
bsd_fidl_bindings(name = "filesystem_bindings", ir = ":filesystem_ir",
    generator = "//tools/build/fuchsia:fidlgen-build.py", modules = ["//tools/build/fuchsia:binding_modules"],
    templates = ["@fuchsia_runtime_src//:binding_templates"],
    sources = ["fidl/bsd.filesystem.v1/" + name for name in ["cpp/natural_types.cc", "cpp/common_types.cc", "c/bsd.cc"]],
    headers = ["fidl/bsd.filesystem.v1/" + name for name in ["cpp/markers.h", "cpp/common_types.h", "cpp/natural_types.h", "cpp/bsd.h", "c/bsd.h", "c/bridge.h"]],
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib"])

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test", "cc_shared_library")
filegroup(name = "binding_sources", srcs = [":filesystem_bindings"], output_group = "sources")
filegroup(name = "binding_headers", srcs = [":filesystem_bindings"], output_group = "headers")
cc_library(name = "generated_headers", hdrs = [":binding_headers"], strip_include_prefix = "filesystem_bindings", visibility = ["//lib/libbsdfilesystem:__pkg__", "//usr.sbin/BSDFilesystem:__pkg__", "//usr.sbin/BSDFilesystem/tests:__pkg__"])
cc_library(name = "generated_bindings", srcs = [":binding_sources"],
    deps = [":generated_headers", "//lib/libfidl:headers", "//contrib/llvm-project/libcxx/include:headers"], copts = ["-std=gnu++20", "-nostdinc++"], linkstatic = True)

load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "headers", hdrs = ["filesystemcmp.h"], strip_include_prefix = ".", deps = ["//lib/libservice:headers"], visibility = ["//visibility:public"])
cc_library(name = "objects", srcs = ["filesystemcmp.c", "filesystem_transact.h"], copts = ["-fPIC"], deps = [":headers", ":generated_headers", "//lib/libservice:headers", "//lib/libtrustedzfs:headers", "//lib/libfidl:headers", "//lib/libcapsulert:headers"], linkstatic = True, target_compatible_with = _PLATFORM)
cc_library(name = "filesystemcmp", deps = [":objects", ":generated_bindings", "//lib/libservice:service", "//lib/libtrustedzfs:trustedzfs", "//lib/libfidl:fidl", "//lib/libc++:cxx", "//lib/libcxxrt:cxxrt", "//lib/libthr:thr"], linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":objects", ":generated_bindings"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_shared_library(name = "filesystemcmp_shared", deps = [":filesystemcmp"],
    dynamic_deps = ["//lib/libservice:service_shared", "//lib/libtrustedzfs:trustedzfs_shared", "//lib/libfidl:fidl_shared", "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/libthr:thr_shared"],
    shared_lib_name = "libfilesystemcmp.so.1", user_link_flags = ["-Wl,-soname,libfilesystemcmp.so.1", "-Wl,--fatal-warnings,--warn-shared-textrel"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Complete maintained library payload; no component-local test installation.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//lib:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libfilesystemcmp"]}' for d in ["/usr/share/licenses/libfilesystemcmp", "/usr/share/licenses/libfilesystemcmp/fuchsia"]} | {"/usr/share/fidl": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libfilesystemcmp-dev"]}'} | {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libfilesystemcmp","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)


cc_library(name = "client_source_headers", textual_hdrs = ["filesystemcmp.c"], hdrs = ["filesystem_transact.h"], strip_include_prefix = ".",
    deps = [":headers", ":generated_headers", "//lib/libservice:headers", "//lib/libtrustedzfs:headers", "//lib/libfidl:headers", "//lib/libcapsulert:headers"],
    visibility = ["//usr.sbin/BSDFilesystem/tests:__pkg__"])

cc_library(name = "transport_headers", hdrs = ["filesystem_transact.h"], strip_include_prefix = ".",
    deps = [":generated_headers", "//lib/libfidl:headers", "//lib/libservice:headers", "//lib/libcapsulert:headers"],
    visibility = ["//lib/libbsdfilesystem:__pkg__", "//lib/libbsdfilesystem/tests:__pkg__"])
