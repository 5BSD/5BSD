load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
cc_library(name = "headers", hdrs = ["libpmcstat.h"], includes = ["."], visibility = ["//lib/libpmc:__pkg__"])

_SOURCES = ["libpmcstat_event.c", "libpmcstat_image.c", "libpmcstat_logging.c", "libpmcstat_process.c", "libpmcstat_string.c", "libpmcstat_symbol.c"]
# Internal consumers select ordinary or PIE objects; neither archive is installed.
[cc_library(name = "pmcstat" + suffix, srcs = _SOURCES, hdrs = ["libpmcstat.h"],
    deps = ["//lib/libpmc:public_headers"], copts = ["-fpie"] if suffix else [],
    linkstatic = True, visibility = ["//visibility:public"])
 for suffix in ["", "_pie"]]
bsd_component_archive(name = "static_archive", groups = [":pmcstat"], visibility = ["//visibility:public"])
bsd_component_archive(name = "pie_archive", groups = [":pmcstat_pie"], visibility = ["//visibility:public"])
