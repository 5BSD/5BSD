# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_import", "cc_test")
_DEFINES = ["XXH_NAMESPACE=ZSTD_", "ZSTD_MULTITHREAD=1", "ZSTD_DISABLE_ASM"]
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(
    name = "common_objects",
    srcs = ['//sys/contrib/zstd:lib/common/entropy_common.c', '//sys/contrib/zstd:lib/common/error_private.c', '//sys/contrib/zstd:lib/common/fse_decompress.c', '//sys/contrib/zstd:lib/common/threading.c', '//sys/contrib/zstd:lib/common/xxhash.c', '//sys/contrib/zstd:lib/common/zstd_common.c', '//sys/contrib/zstd:lib/compress/fse_compress.c', '//sys/contrib/zstd:lib/compress/huf_compress.c', '//sys/contrib/zstd:lib/compress/zstd_compress.c', '//sys/contrib/zstd:lib/compress/zstd_compress_literals.c', '//sys/contrib/zstd:lib/compress/zstd_compress_sequences.c', '//sys/contrib/zstd:lib/compress/zstd_compress_superblock.c', '//sys/contrib/zstd:lib/compress/zstd_preSplit.c', '//sys/contrib/zstd:lib/compress/zstdmt_compress.c', '//sys/contrib/zstd:lib/decompress/huf_decompress.c', '//sys/contrib/zstd:lib/decompress/zstd_ddict.c', '//sys/contrib/zstd:lib/decompress/zstd_decompress.c', '//sys/contrib/zstd:lib/decompress/zstd_decompress_block.c', '//sys/contrib/zstd:lib/deprecated/zbuff_common.c', '//sys/contrib/zstd:lib/deprecated/zbuff_compress.c', '//sys/contrib/zstd:lib/deprecated/zbuff_decompress.c', '//sys/contrib/zstd:lib/dictBuilder/cover.c', '//sys/contrib/zstd:lib/dictBuilder/divsufsort.c', '//sys/contrib/zstd:lib/dictBuilder/zdict.c', '//sys/contrib/zstd:lib/compress/zstd_fast.c', '//sys/contrib/zstd:lib/compress/zstd_lazy.c', '//sys/contrib/zstd:lib/compress/zstd_ldm.c', '//sys/contrib/zstd:lib/compress/zstd_opt.c', '//sys/contrib/zstd:lib/compress/zstd_double_fast.c', '//sys/contrib/zstd:lib/common/debug.c', '//sys/contrib/zstd:lib/compress/hist.c', '//sys/contrib/zstd:lib/dictBuilder/fastcover.c'],
    deps = ["//sys/contrib/zstd:headers"],
    implementation_deps = ["//sys/contrib/zstd:internal_headers"],
    local_defines = _DEFINES,
    copts = ["-fvisibility=hidden"],
    target_compatible_with = _PLATFORM,
)
cc_library(
    name = "pool_objects", srcs = ["//sys/contrib/zstd:lib/common/pool.c"],
    implementation_deps = ["//sys/contrib/zstd:internal_headers"],
    local_defines = _DEFINES, copts = ["-fvisibility=default"],
    linkopts = ["-pthread"],
    target_compatible_with = _PLATFORM,
)
cc_library(
    name = "zstd", deps = [":common_objects", ":pool_objects"],
    target_compatible_with = _PLATFORM,
    visibility = ["//visibility:public"],
)
cc_shared_library(
    name = "zstd_shared", deps = [":zstd"], shared_lib_name = "libprivatezstd.so.5",
    user_link_flags = ["-Wl,-soname,libprivatezstd.so.5", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"],
)

load("@rules_cc//cc:cc_static_library.bzl", "cc_static_library")
load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_debug_split", "bsd_strip_binary")
load(":installation.bzl", "zstd_library_installation")
cc_static_library(name = "static_archive", deps = [":common_objects", ":pool_objects"],
    target_compatible_with = _PLATFORM)
bsd_debug_split(name = "debug", src = ":zstd_shared", binary_name = "install/libprivatezstd.so.5",
    debug_name = "install/libprivatezstd.so.5.debug", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    objcopy_inputs = "@bsd_sdk//toolchain:objcopy_inputs")
bsd_strip_binary(name = "stripped", src = ":debug", output = "stripped/libprivatezstd.so.5",
    strip = "@bsd_sdk//toolchain:bin/llvm-strip", strip_inputs = "@bsd_sdk//toolchain:strip_inputs")
zstd_library_installation(name = "install_manifest")

# Exercise the exported aggregate archive, not a reconstruction of its groups.
cc_import(name = "archive_link", static_library = ":static_archive")
cc_test(name = "roundtrip_static", srcs = ["tests/roundtrip.c"],
    deps = [":archive_link", "//sys/contrib/zstd:headers"], linkopts = ["-pthread"],
    size = "small", target_compatible_with = _PLATFORM)
cc_test(name = "roundtrip_shared", srcs = ["tests/roundtrip.c"],
    deps = [":zstd"], dynamic_deps = [":zstd_shared"], features = ["bsd_test_runtime_paths"],
    size = "small", target_compatible_with = _PLATFORM)
