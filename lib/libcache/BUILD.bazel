# SPDX-License-Identifier: BSD-2-Clause
load("//tools/build/bazel:bsd_test_installation.bzl", "bsd_library_installation_archives")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
cc_library(name = "headers", hdrs = ["bsd_cache.h"], strip_include_prefix = ".", visibility = ["//visibility:public"])
cc_library(name = "cache", srcs = ["bsd_cache.c"], copts = ["-fPIC"],
    deps = [":headers", "//lib/libnotify:notify", "//lib/libservice:service", "//lib/libthr:thr"],
    linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":cache"], visibility = ["//visibility:public"])
cc_shared_library(name = "cache_shared", deps = [":cache"],
    dynamic_deps = ["//lib/libnotify:notify_shared", "//lib/libservice:service_shared", "//lib/libthr:thr_shared"],
    shared_lib_name = "libcache.so.1", user_link_flags = ["-Wl,-soname,libcache.so.1", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_library_installation_archives(
    name = "installation_archives", production_name = "install_archive", test_name = "tests_install_archive",
    production_manifests = [":install_manifest"],
    test_manifests = select({"//tools/build/bazel/config:tests_enabled": ["//lib/libcache/tests:install_test", "//lib/libcache/tests:install_extra"], "//conditions:default": []}),
    production_directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libcache","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    test_directories = select({"//tools/build/bazel/config:tests_enabled": {
        "/usr/tests/lib/libcache": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libcache-tests"]}',
    } | {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libcache-tests","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/tests", "/usr/lib/debug/usr/tests/lib", "/usr/lib/debug/usr/tests/lib/libcache"]}, "//conditions:default": {}}),
    visibility = ["//visibility:public"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
        "//etc/mtree:BSD.tests.dist": "/usr/tests",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

# The maintained unit test includes the implementation to inject notify operations.
cc_library(name = "test_source_headers", hdrs = ["bsd_cache.c", "bsd_cache.h"],
    visibility = ["//lib/libcache/tests:__pkg__"])
