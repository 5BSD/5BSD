load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load("//tools/build/bazel:configured_version_map.bzl", "bsd_configured_version_map")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "headers", hdrs = ["mp.h"], strip_include_prefix = ".", deps = ["//secure/lib/libcrypto:crypto"], visibility = ["//visibility:public"])
cc_library(name = "mp", srcs = ["mpasbn.c"], deps = [":headers"], linkstatic = True,
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":mp"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_configured_version_map(
    name = "version_map",
    symbol_maps = ["Symbol.map"],
    versions = "//lib/libc:Versions.def",
    generator = "//share/mk:version_gen.awk",
    # This symbol inventory has no includes or target-dependent conditionals.
    cpp_flags = ["-P", "-nostdinc", "-undef"],
    compiler = "@bsd_sdk//toolchain:bin/clang",
    compiler_inputs = "@bsd_sdk//toolchain:compile_inputs",
    cat = "@bsd_sdk//toolchain:cat",
    cat_runtime = "@bsd_sdk//toolchain:cat_runtime",
    awk = "@bsd_sdk//toolchain:awk",
    awk_runtime = "@bsd_sdk//toolchain:awk_runtime",
    redirect = "@bsd_sdk//toolchain:stdout_redirect",
)

cc_shared_library(name = "mp_shared", deps = [":mp"], shared_lib_name = "libmp.so.7",
    dynamic_deps = ["//secure/lib/libcrypto:crypto_shared"],
    additional_linker_inputs = [":version_map"],
    user_link_flags = ["-Wl,-soname,libmp.so.7", "-Wl,--version-script=$(location :version_map),--no-undefined-version", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive", "bsd_install_archive_set")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
# Preserve independent original production and test package directory claims.
_INSTALL_POLICY = {
    'mtree_specs': {
        "//etc/mtree:BSD.tests.dist": "/usr/tests",
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    'passwd': "//etc:master.passwd",
    'group': "//etc:group",
    'mtree': "@bsd_sdk//toolchain:extra_mtree",
    'epoch': 0,
    'python': "@bsd_sdk//toolchain:extra_python",
    'python_home': "@bsd_sdk//toolchain:python-home/runtime.json",
    'runtime': ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
}
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    visibility = ["//visibility:public"], mtree_specs = _INSTALL_POLICY["mtree_specs"],
    passwd = _INSTALL_POLICY["passwd"],
    group = _INSTALL_POLICY["group"],
    mtree = _INSTALL_POLICY["mtree"],
    epoch = _INSTALL_POLICY["epoch"],
    python = _INSTALL_POLICY["python"],
    python_home = _INSTALL_POLICY["python_home"],
    runtime = _INSTALL_POLICY["runtime"])
bsd_install_archive(name = "tests_install_archive", manifests = ["//lib/libmp/tests:install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/tests", "/usr/lib/debug/usr/tests/lib", "/usr/lib/debug/usr/tests/lib/libmp"]} | {"/usr/tests/lib/libmp": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests"]}'}, mtree_specs = _INSTALL_POLICY["mtree_specs"],
    passwd = _INSTALL_POLICY["passwd"],
    group = _INSTALL_POLICY["group"],
    mtree = _INSTALL_POLICY["mtree"],
    epoch = _INSTALL_POLICY["epoch"],
    python = _INSTALL_POLICY["python"],
    python_home = _INSTALL_POLICY["python_home"],
    runtime = _INSTALL_POLICY["runtime"])
bsd_install_archive_set(name = "installation_archives", archives = [":install_archive"] + select({
    "//tools/build/bazel/config:tests_enabled": [":tests_install_archive"],
    "//conditions:default": [],
}), visibility = ["//visibility:public"])
