load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "headers", hdrs = ["bsdfilesystem.h"], deps = ["//lib/libcapsulert:headers"], strip_include_prefix = ".", visibility = ["//visibility:public"])
cc_library(name = "objects", srcs = ["bsdfilesystem.c"], deps = [":headers", "//lib/libfilesystemcmp:transport_headers", "//lib/libtrustedzfs:headers"], linkstatic = True)
cc_library(name = "bsdfilesystem", deps = [":objects", ":headers", "//lib/libtrustedzfs:trustedzfs", "//lib/libservice:service", "//lib/libchannel:channel", "//lib/libfilesystemcmp:filesystemcmp", "//lib/libfidl:fidl"], linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
