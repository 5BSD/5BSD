cc_shared_library(name = "bsdfilesystem_shared", deps = [":bsdfilesystem"],
    dynamic_deps = ["//lib/libtrustedzfs:trustedzfs_shared", "//lib/libservice:service_shared", "//lib/libchannel:channel_shared", "//lib/libfilesystemcmp:filesystemcmp_shared", "//lib/libfidl:fidl_shared"],
    shared_lib_name = "libbsdfilesystem.so.1", user_link_flags = ["-Wl,-soname,libbsdfilesystem.so.1", "-Wl,--fatal-warnings,--warn-shared-textrel"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
library_installation(name = "install_manifest")
bsd_install_archive(name = "library_install_archive", manifests = [":install_manifest"],
    directories = {"/usr/lib/debug/lib": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime","dbg"]}'},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.include.dist": "/usr/include", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])

cc_library(name = "test_source_headers", textual_hdrs = ["bsdfilesystem.c"], deps = [":headers", "//lib/libservice:headers", "//lib/libtrustedzfs:headers"], strip_include_prefix = ".", visibility = ["//lib/libbsdfilesystem/tests:__pkg__"])

