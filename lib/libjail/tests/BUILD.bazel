load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_kyua.bzl", "bsd_kyua_test")

# ATF-C remains a declared SDK bootstrap library until its native migration.
cc_binary(
    name = "metadata_test",
    srcs = ["metadata_test.c"],
    deps = ["//lib/libjail:jail"],
    linkstatic = True,
    linkopts = ["-Wl,-Bstatic", "-lprivateatf-c", "-Wl,-Bdynamic"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
)
bsd_kyua_test(
    name = "metadata",
    program = ":metadata_test",
    interface = "atf",
    kyua = "@bsd_sdk//toolchain:extra_kyua",
    runtime = ["@bsd_sdk//toolchain:extra_kyua_runtime"],
    clean_environment = True,
)
