.Ft int
.Fn service_component_recv_bootstrap "int fd" "struct component_session_bootstrap *bootstrap" "char *options" "size_t options_size"
.Ft int
.Fn service_component_send_reply "int fd" "uint64_t instance_id" "int status" "uint32_t member_type" "int member_fd"
.Ft int
