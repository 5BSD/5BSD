.Dd July 29, 2026
.Dt LIBSERVICE 3
.Os
.Sh NAME
.Nm service_init ,
.Nm service_ready ,
.Nm service_register ,
.Nm service_unregister ,
.Nm service_lookup ,
.Nm service_accept ,
.Nm service_send ,
.Nm service_send_fds ,
.Nm service_recv ,
.Nm service_recv_fds ,
.Nm service_channel_fd ,
.Nm service_label ,
.Nm service_capability_fd ,
.Nm service_component_fd ,
.Nm service_component_recv_bootstrap ,
.Nm service_component_send_reply ,
.Nm service_authorize_capabilities ,
.Nm service_protect
.Nd client library for services managed by serviced
.Sh LIBRARY
.Lb libservice
.Sh SYNOPSIS
.In libservice.h
.Ft int
.Fn service_init void
.Ft int
.Fn service_ready void
.Ft int
