.Ft int
.Fn service_unregister "const char *name"
.Ft int
.Fn service_lookup "const char *name"
.Ft int
.Fn service_accept "char *client_label" "size_t labelsz"
.Ft int
.Fn service_send "int fd" "const void *data" "size_t len"
.Ft int
.Fn service_send_fds "int fd" "const void *data" "size_t len" "const int *fds" "size_t nfds"
.Ft ssize_t
.Fn service_recv "int fd" "void *buf" "size_t bufsz" "int *peer_fd"
.Ft ssize_t
.Fn service_recv_fds "int fd" "void *buf" "size_t bufsz" "int *fds" "size_t *nfds"
.Ft int
.Fn service_channel_fd void
.Ft "const char *"
