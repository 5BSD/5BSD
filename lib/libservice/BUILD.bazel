load("@rules_cc//cc:defs.bzl", "cc_library", "cc_import", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_spec", "bsd_dtrace_cc_objects")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
_SECTION_TRACE = "//tools/build/bazel/config:experimental_dtrace_section_archives_enabled"
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "headers", hdrs = ["libservice.h", "libservice_session.h", "service_runtime.h"], deps = ["//sys/sys:cap_authority_header", "//sys/sys:cap_process_header"], strip_include_prefix = ".", visibility = ["//visibility:public"])
bsd_dtrace_spec(name = "provider", source = "service_ambient_provider.d", output = "service_ambient_provider.o",
    flags = ["-C", "-x", "nolibs"], static_anchor = False, object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:dtrace", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti",
    runtime_libraries = ["//cddl/lib/libdtrace:dtrace_shared", "//cddl/lib/libctf:ctf_shared", "//lib/libelf:elf_shared", "//lib/libproc:proc_shared", "//cddl/lib/libspl:spl_shared", "//lib/libxo/libxo:xo_shared", "//lib/libutil:util_shared", "//lib/libprocstat:procstat_shared", "//lib/librtld_db:rtld_db_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/libz:z_shared", "//lib/libkvm:kvm_shared"],
    tool_inputs = [ "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"])
cc_library(name = "objects", srcs = ["service_runtime.c", "libservice.c", "service_ambient.c", "service_client.c", "service_private.h", "lookup_identity.h", "service_bootstrap.h", "service_ambient_probes.h", "trace_pressure.h"], deps = [":headers", "//lib/libcapability:capability", "//lib/libchannel:channel", "//lib/libtrustedzfs:trustedzfs", "//lib/libcapsulert:capsulert", "//lib/libthr:thr"],
    implementation_deps = ["//sys/dev/mac_capability:ioctl_headers", "//sys/dev/mac_capability:system_headers", "//sys/dev/mac_capability:capprotect_headers", "//sys/dev/mac_capability:isolation_headers"],
    local_defines = select({_TRACE: ["WITH_DTRACE"], "//conditions:default": []}),
    linkstatic = True, target_compatible_with = _PLATFORM)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider",
    provider_object = "service_ambient_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner",
    archive_members = True, archive_runner = "//tools/build/bazel:dtrace_archive_member")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group)
 for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider", "regular_archive_objects", "pic_archive_objects"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"], deps = [":provider_link"])
cc_import(name = "section_traced", objects = [":regular_archive_objects"], pic_objects = [":pic_archive_objects"])
cc_library(name = "service", deps = [":headers", "//lib/libcapability:capability", "//lib/libchannel:channel", "//lib/libtrustedzfs:trustedzfs", "//lib/libcapsulert:capsulert", "//lib/libthr:thr"] + select({_SECTION_TRACE: [":section_traced"], _TRACE: [":traced"], "//conditions:default": [":objects"]}),
    linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = select({_SECTION_TRACE: [":section_traced"], _TRACE: [":traced", ":provider_link"], "//conditions:default": [":objects"]}),
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_shared_library(name = "service_shared", deps = [":service"], dynamic_deps = ["//lib/libcapability:capability_shared", "//lib/libchannel:channel_shared", "//lib/libtrustedzfs:trustedzfs_shared", "//lib/libcapsulert:capsulert_shared", "//lib/libthr:thr_shared"], shared_lib_name = "libservice.so.2",
    user_link_flags = ["-Wl,-soname,libservice.so.2", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Library payload only; full maintained test installation remains to migrate.
bsd_install_archive(
    name = "library_install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libservice","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)


# Source-including maintained tests require original paths and declared inputs.
cc_library(name = "test_source_headers", strip_include_prefix = ".", hdrs = ["service_private.h", "lookup_identity.h", "service_bootstrap.h", "trace_pressure.h"], textual_hdrs = ["service_runtime.c", "service_client.c"], deps = [":headers", "//lib/libchannel:headers", "//lib/libcapsulert:headers"], visibility = ["//lib/libservice/tests:__pkg__"])
exports_files(["service_runtime.c"], visibility = ["//lib/libservice/tests:__pkg__", "//usr.sbin/BSDNetwork/tests:__pkg__"])

# Complete installation payload; live test qualification remains separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"] + select({"//tools/build/bazel/config:tests_enabled": ['//lib/libservice/tests:install_bootstrap_test', '//lib/libservice/tests:install_runtime_test', '//lib/libservice/tests:install_client_deadline_test', '//lib/libservice/tests:install_libservice_api_test', '//lib/libservice/tests:install_service_ambient_test', '//lib/libservice/tests:install_software_identity_test', '//lib/libservice/tests:install_capd_service_fixture', '//lib/libservice/tests:install_capd_test_guardian', '//lib/libservice/tests:install_extra'], "//conditions:default": []}),
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libservice","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]} | select({"//tools/build/bazel/config:tests_enabled": {'/usr/tests/lib/libservice': '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libservice-tests"]}', '/usr/tests/lib/libservice/srctree/usr.sbin/BSDAudit': '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libservice-tests"]}', '/usr/tests/lib/libservice/srctree/usr.sbin': '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libservice-tests"]}', '/usr/tests/lib/libservice/srctree': '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libservice-tests"]}', '/usr/tests/lib/libservice/srctree/usr.sbin/BSDCrypto': '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libservice-tests"]}', '/usr/tests/lib/libservice/srctree/usr.sbin/BSDDevice': '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libservice-tests"]}', '/usr/tests/lib/libservice/srctree/usr.sbin/BSDFilesystem': '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libservice-tests"]}', '/usr/tests/lib/libservice/srctree/usr.sbin/BSDLog': '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libservice-tests"]}', '/usr/tests/lib/libservice/srctree/usr.sbin/BSDNetwork': '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libservice-tests"]}', '/usr/tests/lib/libservice/srctree/usr.sbin/BSDNotify': '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libservice-tests"]}', '/usr/tests/lib/libservice/srctree/usr.sbin/BSDTrace': '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libservice-tests"]}', '/usr/tests/lib/libservice/srctree/usr.sbin/BSDVM': '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libservice-tests"]}', '/usr/lib/debug/usr': '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libservice-tests","dbg"]}', '/usr/lib/debug/usr/tests': '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libservice-tests","dbg"]}', '/usr/lib/debug/usr/tests/lib': '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libservice-tests","dbg"]}', '/usr/lib/debug/usr/tests/lib/libservice': '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libservice-tests","dbg"]}'}, "//conditions:default": {}}),
    mtree_specs = {
        "//etc/mtree:BSD.tests.dist": "/usr/tests",
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

# Internal descriptor ABI consumed by Switchboard at launch.
cc_library(name = "bootstrap_headers", hdrs = ["service_bootstrap.h"], deps = [":headers"],
    strip_include_prefix = ".", visibility = ["//usr.sbin/capsule:__pkg__", "//usr.sbin/switchboard:__pkg__", "//lib/libnetworkcmp/tests:__pkg__"])

cc_library(name = "managed_fixture_headers", hdrs = ["service_private.h", "service_bootstrap.h"],
    strip_include_prefix = ".", deps = [":headers"], visibility = ["//usr.sbin/switchboard/tests:__pkg__"])

cc_library(name = "runtime_source_headers", hdrs = ["trace_pressure.h"], strip_include_prefix = ".",
    deps = [":headers", "//lib/libchannel:headers"], visibility = ["//usr.sbin/BSDNetwork/tests:__pkg__"])
