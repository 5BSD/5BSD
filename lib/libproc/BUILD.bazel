load("@rules_cc//cc:defs.bzl", "cc_library")
# Header-only edge avoids the libproc/librtld_db link dependency cycle.
cc_library(name = "headers", hdrs = ["libproc.h"], strip_include_prefix = ".",
    deps = ["//contrib/elftoolchain:elf_headers", "//lib/librtld_db:headers"], visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load(":sources.bzl", "PROC_SOURCES")
_CTF = "//tools/build/bazel/config:ctf_enabled"
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
_LIBS = ["//lib/libcxxrt:cxxrt", "//lib/libelf:elf", "//lib/libprocstat:procstat", "//lib/librtld_db:rtld_db", "//lib/libutil:util", "//lib/libz:z"] + select({_CTF: ["//cddl/lib/libctf:ctf"], "//conditions:default": []})
_SHARED = ["//lib/libcxxrt:cxxrt_shared", "//lib/libelf:elf_shared", "//lib/libprocstat:procstat_shared", "//lib/librtld_db:rtld_db_shared", "//lib/libutil:util_shared", "//lib/libz:z_shared"] + select({_CTF: ["//cddl/lib/libctf:ctf_shared"], "//conditions:default": []})
cc_library(name = "proc", srcs = PROC_SOURCES + ["_libproc.h"], deps = [":headers"] + _LIBS,
    local_defines = select({_CTF: ["IN_BASE", "SKIP_SPL_SYS_CONDVAR_H", "HAVE_ISSETUGID", "HAVE_BOOLEAN", "HAVE_STRLCAT", "HAVE_STRLCPY"], "//conditions:default": ["NO_CTF"]}),
    copts = select({_CTF: ["-include", "sys/contrib/openzfs/include/os/freebsd/spl/sys/ccompile.h"], "//conditions:default": []}),
    # MK_CTF gives this implementation its own Solaris/CTF include context.
    # libctf's link interface deliberately does not export those private paths.
    implementation_deps = select({_CTF: ["//cddl/contrib/opensolaris:ctf_library_headers"], "//conditions:default": []}),
    linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":proc"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_shared_library(name = "proc_shared", deps = [":proc"], dynamic_deps = _SHARED,
    shared_lib_name = "libproc.so.5", user_link_flags = ["-Wl,-soname,libproc.so.5", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
# Production contribution only; selected installed tests require separate closure.
bsd_install_archive(
    name = "production_install_archive",
    visibility = ["//lib:__pkg__", "//tools/build/bazel:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
