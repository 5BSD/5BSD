load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
_SOURCES = ["chap.c", "connection.c", "keys.c", "log.c", "pdu.c", "text.c", "utils.c"]
# INTERNALLIB: regular and PIE static variants, with no installed DSO.
[cc_library(
    name = name,
    srcs = _SOURCES,
    hdrs = ["libiscsiutil.h"],
    strip_include_prefix = ".",
    deps = ["//sys/dev/iscsi:user_headers", "//lib/libmd:md_link"],
    copts = flags,
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
) for name, flags in [("iscsiutil", []), ("iscsiutil_pie", ["-fPIE", "-DPIC"])]]
bsd_component_archive(name = "static_archive", groups = [":iscsiutil"], visibility = ["//visibility:public"])
bsd_component_archive(name = "pie_archive", groups = [":iscsiutil_pie"], visibility = ["//visibility:public"])
