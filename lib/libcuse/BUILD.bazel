load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
cc_library(name = "headers", hdrs = ["cuse.h"], strip_include_prefix = ".",
    deps = ["//sys/fs/cuse:headers"], visibility = ["//visibility:public"])
_DEBUG = "//tools/build/bazel/config:cuse_debug_enabled"
cc_library(name = "cuse", srcs = ["cuse_lib.c"],
    deps = [":headers", "//lib/libthr:thr"],
    local_defines = ["_GNU_SOURCE"] + select({_DEBUG: ["HAVE_DEBUG"], "//conditions:default": []}),
    copts = select({_DEBUG: ["-g"], "//conditions:default": []}),
    linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":cuse"], visibility = ["//visibility:public"])
cc_shared_library(name = "cuse_shared", deps = [":cuse"], dynamic_deps = ["//lib/libthr:thr_shared"],
    shared_lib_name = "libcuse.so.1", user_link_flags = ["-Wl,-soname,libcuse.so.1", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//visibility:public"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libcuse","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
