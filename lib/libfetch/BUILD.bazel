load("@rules_cc//cc:defs.bzl", "cc_library", "cc_import", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_header", "bsd_dtrace_cc_objects")
load(":error_table.bzl", "fetch_error_table")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
_SSL = "//tools/build/bazel/config:openssl_enabled"
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
[fetch_error_table(name = protocol + "_errors", source = protocol + ".errors", output = protocol + "err.h", protocol = protocol,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib"])
 for protocol in ["ftp", "http"]]
cc_library(name = "headers", hdrs = ["fetch.h"], strip_include_prefix = ".", visibility = ["//visibility:public"])
cc_library(name = "private_headers", hdrs = ["common.h", "fetchio_trace.h", ":ftp_errors", ":http_errors"], strip_include_prefix = ".")
bsd_dtrace_header(
    name = "provider", source = "fetchio_provider.d", output = "fetchio_provider.h",
    flags = ["-C", "-x", "nolibs"], object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:dtrace", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti",
    runtime_libraries = ['//cddl/lib/libdtrace:dtrace_shared', '//cddl/lib/libctf:ctf_shared', '//lib/libelf:elf_shared', '//lib/libproc:proc_shared', '//cddl/lib/libspl:spl_shared', '//lib/libxo/libxo:xo_shared', '//lib/libutil:util_shared', '//lib/libprocstat:procstat_shared', '//lib/librtld_db:rtld_db_shared', '//lib/libcxxrt:cxxrt_shared', '//lib/libz:z_shared', '//lib/libkvm:kvm_shared'],
    tool_inputs = [ "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"], static_anchor = True,
)
cc_library(name = "provider_headers", hdrs = [":provider"], strip_include_prefix = ".")

_CRYPTO = select({_SSL: ["//secure/lib/libssl:ssl", "//secure/lib/libcrypto:crypto"], "//conditions:default": ["//lib/libmd:md_link"]})
cc_library(name = "objects", srcs = ["fetch.c", "common.c", "ftp.c", "http.c", "file.c"],
    deps = [":headers"] + _CRYPTO,
    implementation_deps = [":private_headers"] + select({_TRACE: [":provider_headers"], "//conditions:default": []}),
    local_defines = ["FTP_COMBINE_CWDS"] + select({_TRACE: ["WITH_COVERAGE_DTRACE"], "//conditions:default": []}) +
        select({_SSL: ["WITH_SSL", "OPENSSL_API_COMPAT=0x10100000L"], "//conditions:default": []}) +
        select({"//tools/build/bazel/config:inet6_support_enabled": ["INET6"], "//conditions:default": []}),
    linkstatic = True, target_compatible_with = _PLATFORM)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider", provider_object = "fetchio_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group) for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"], deps = [":provider_link"])
cc_library(name = "fetch", deps = [":headers"] + _CRYPTO + select({_TRACE: [":traced"], "//conditions:default": [":objects"]}),
    linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = select({_TRACE: [":traced", ":provider_link"], "//conditions:default": [":objects"]}),
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_shared_library(name = "fetch_shared", deps = [":fetch"], shared_lib_name = "libfetch.so.6",
    dynamic_deps = select({_SSL: ["//secure/lib/libssl:ssl_shared", "//secure/lib/libcrypto:crypto_shared"], "//conditions:default": ["//lib/libmd:md_shared"]}),
    user_link_flags = ["-Wl,-soname,libfetch.so.6", "-Wl,--fatal-warnings,--warn-shared-textrel"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

load("@rules_cc//cc:defs.bzl", "cc_import", "cc_test")
cc_import(name = "archive_link", static_library = ":static_archive")
[cc_test(name = "topology_" + variant, srcs = ["topology_test.c"],
    deps = ([":archive_link", ":headers", "//lib/libsbuf:sbuf"] if variant == "static" else [":cam"]),
    dynamic_deps = [] if variant == "static" else [":cam_shared", "//lib/libsbuf:sbuf_shared"],
    features = [] if variant == "static" else ["bsd_test_runtime_paths"], linkstatic = variant == "static",
    size = "small", target_compatible_with = _PLATFORM)
 for variant in ["static", "shared"]]

load("@rules_cc//cc:defs.bzl", "cc_test")
# Static native dependencies prevent loader fallback to installed libfetch/TLS.
cc_test(name = "local_test", srcs = ["local_test.c"], deps = [":fetch"],
    linkstatic = True, size = "small", target_compatible_with = _PLATFORM)
