load("@rules_cc//cc:defs.bzl", "cc_library")
load("//lib/libc/iconv:nonshared_sources.bzl", "ICONV_WRAPPERS")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest")
cc_library(
    name = "nonshared_objects",
    srcs = ["__stub.c"] + select({
        "//tools/build/bazel/config:iconv_enabled": ["//lib/libc/iconv:" + s for s in ICONV_WRAPPERS] + ["//lib/libc/iconv:iconv-internal.h"],
        "//conditions:default": [],
    }),
    copts = ["-fpic", "-fvisibility=hidden"],
    local_defines = ["PIC"],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
)
# NO_PIC in Make suppresses additional archives; this archive itself is PIC.
bsd_component_archive(name = "static_archive", groups = [":nonshared_objects"], visibility = ["//visibility:public"])
bsd_install_file(name = "archive_install", src = ":static_archive", destination = "/usr/lib/libc_nonshared.a",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=clibs", "dev"])
bsd_install_manifest(name = "install_manifest", entries = [":archive_install"])

load("@rules_cc//cc:defs.bzl", "cc_import")
cc_import(name = "nonshared", static_library = ":static_archive", visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Production payload only; installed test-suite contributions remain separate.
bsd_install_archive(
    name = "production_install_archive",
    visibility = ["//lib:__pkg__", "//tools/build/bazel:__pkg__"],
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
