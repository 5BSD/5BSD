# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "rdmacm", srcs = ['//contrib/ofed/librdmacm:acm.c', '//contrib/ofed/librdmacm:addrinfo.c', '//contrib/ofed/librdmacm:cma.c', '//contrib/ofed/librdmacm:indexer.c'],
    deps = ["//lib/ofed/libibverbs:ibverbs", "//contrib/ofed/librdmacm:headers"], implementation_deps = ["//contrib/ofed/librdmacm:private_headers"],
    linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":rdmacm"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_shared_library(name = "rdmacm_shared", deps = [":rdmacm"], shared_lib_name = "librdmacm.so.1",
    dynamic_deps = ["//lib/ofed/libibverbs:ibverbs_shared"],
    additional_linker_inputs = ["//contrib/ofed/librdmacm:librdmacm.map"],
    user_link_flags = ['-Wl,-soname,librdmacm.so.1', '-Wl,--version-script=$(location //contrib/ofed/librdmacm:librdmacm.map),--no-undefined-version', '-Wl,--fatal-warnings,--warn-shared-textrel'],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=rdma","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
