load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "ibverbs", srcs = ['//contrib/ofed/libibverbs:cmd.c', '//contrib/ofed/libibverbs:compat-1_0.c', '//contrib/ofed/libibverbs:device.c', '//contrib/ofed/libibverbs:enum_strs.c', '//contrib/ofed/libibverbs:init.c', '//contrib/ofed/libibverbs:marshall.c', '//contrib/ofed/libibverbs:memory.c', '//contrib/ofed/libibverbs:sysfs.c', '//contrib/ofed/libibverbs:verbs.c'],
    deps = ["//contrib/ofed/libibverbs:headers"], implementation_deps = ["//contrib/ofed/libibverbs:private_headers"],
    linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":ibverbs"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_shared_library(name = "ibverbs_shared", deps = [":ibverbs"], shared_lib_name = "libibverbs.so.1",
    additional_linker_inputs = ["//contrib/ofed/libibverbs:libibverbs.map"],
    user_link_flags = ["-Wl,-soname,libibverbs.so.1", "-Wl,--version-script=$(location //contrib/ofed/libibverbs:libibverbs.map),--no-undefined-version", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive", visibility = ["//lib/ofed:__pkg__"],
    manifests = [":install_manifest"],
    directories = {"/usr/lib/debug/lib": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=rdma","dbg"]}'},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
