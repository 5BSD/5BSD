load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "c_objects", srcs = ["//contrib/ofed/libibnetdisc:chassis.c", "//contrib/ofed/libibnetdisc:ibnetdisc.c", "//contrib/ofed/libibnetdisc:ibnetdisc_cache.c", "//contrib/ofed/libibnetdisc:query_smp.c"], deps = ["//contrib/ofed/libibnetdisc:private_headers", "//lib/ofed/complib:osmcomp", "//lib/ofed/libibmad:ibmad", "//lib/ofed/libibumad:ibumad"], local_defines = ["HAVE_CONFIG_H=1"], linkstatic = True, target_compatible_with = _PLATFORM)
cc_library(name = "cxx_objects", srcs = ["//contrib/ofed/libibnetdisc:g_hash_table.cpp"], deps = ["//contrib/ofed/libibnetdisc:private_headers", "//lib/libc++:cxx", "//lib/libcxxrt:cxxrt", "//lib/msun:m"], copts = ["-nostdinc++"], local_defines = ["HAVE_CONFIG_H=1"], linkstatic = True, target_compatible_with = _PLATFORM)
cc_library(name = "ibnetdisc", deps = [":c_objects", ":cxx_objects", "//contrib/ofed/libibnetdisc:headers"], linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":c_objects", ":cxx_objects"], visibility = ["//visibility:public"])
cc_shared_library(name = "ibnetdisc_shared", deps = [":ibnetdisc"], shared_lib_name = "libibnetdisc.so.5", dynamic_deps = ["//lib/ofed/complib:osmcomp_shared", "//lib/ofed/libibmad:ibmad_shared", "//lib/ofed/libibumad:ibumad_shared", "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared"], additional_linker_inputs = ["//contrib/ofed/libibnetdisc:libibnetdisc.map"], user_link_flags = ["-Wl,-soname,libibnetdisc.so.5", "-Wl,--version-script=$(location //contrib/ofed/libibnetdisc:libibnetdisc.map),--no-undefined-version", "-Wl,--fatal-warnings,--warn-shared-textrel"], visibility = ["//visibility:public"])
load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive", visibility = ["//lib/ofed:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=rdma","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
