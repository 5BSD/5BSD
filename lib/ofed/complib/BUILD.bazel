load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "osmcomp", srcs = ['//contrib/ofed/opensm:complib/cl_complib.c', '//contrib/ofed/opensm:complib/cl_dispatcher.c', '//contrib/ofed/opensm:complib/cl_event.c', '//contrib/ofed/opensm:complib/cl_event_wheel.c', '//contrib/ofed/opensm:complib/cl_list.c', '//contrib/ofed/opensm:complib/cl_log.c', '//contrib/ofed/opensm:complib/cl_map.c', '//contrib/ofed/opensm:complib/cl_nodenamemap.c', '//contrib/ofed/opensm:complib/cl_pool.c', '//contrib/ofed/opensm:complib/cl_ptr_vector.c', '//contrib/ofed/opensm:complib/cl_spinlock.c', '//contrib/ofed/opensm:complib/cl_statustext.c', '//contrib/ofed/opensm:complib/cl_thread.c', '//contrib/ofed/opensm:complib/cl_threadpool.c', '//contrib/ofed/opensm:complib/cl_timer.c', '//contrib/ofed/opensm:complib/cl_vector.c', '//contrib/ofed/opensm:complib/ib_statustext.c'],
    deps = ["//contrib/ofed/opensm:common_headers", "//lib/libthr:thr"], implementation_deps = ["//contrib/ofed/opensm:configuration"],
    local_defines = ["HAVE_CONFIG_H=1"],
    linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":osmcomp"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_shared_library(name = "osmcomp_shared", deps = [":osmcomp"], shared_lib_name = "libosmcomp.so.3",
    dynamic_deps = ["//lib/libthr:thr_shared"],
    additional_linker_inputs = ["//contrib/ofed/opensm:complib/libosmcomp.map"],
    user_link_flags = ['-Wl,-soname,libosmcomp.so.3', '-Wl,--fatal-warnings,--warn-shared-textrel', '-Wl,--version-script=$(location //contrib/ofed/opensm:complib/libosmcomp.map),--no-undefined-version'],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=rdma","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
