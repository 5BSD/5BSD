load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "ibmad", srcs = ['//contrib/ofed/libibmad:bm.c', '//contrib/ofed/libibmad:cc.c', '//contrib/ofed/libibmad:dump.c', '//contrib/ofed/libibmad:fields.c', '//contrib/ofed/libibmad:gs.c', '//contrib/ofed/libibmad:mad.c', '//contrib/ofed/libibmad:portid.c', '//contrib/ofed/libibmad:register.c', '//contrib/ofed/libibmad:resolve.c', '//contrib/ofed/libibmad:rpc.c', '//contrib/ofed/libibmad:sa.c', '//contrib/ofed/libibmad:serv.c', '//contrib/ofed/libibmad:smp.c', '//contrib/ofed/libibmad:vendor.c'],
    deps = ['//contrib/ofed/libibmad:headers', '//lib/ofed/libibumad:ibumad'], implementation_deps = ["//contrib/ofed/libibmad:private_headers"],
    local_defines = ["HAVE_CONFIG_H=1"],
    linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":ibmad"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_shared_library(name = "ibmad_shared", deps = [":ibmad"], shared_lib_name = "libibmad.so.5",
    dynamic_deps = ['//lib/ofed/libibumad:ibumad_shared'],
    additional_linker_inputs = ["//contrib/ofed/libibmad:libibmad.map"],
    user_link_flags = ['-Wl,-soname,libibmad.so.5', '-Wl,--fatal-warnings,--warn-shared-textrel', '-Wl,--version-script=$(location //contrib/ofed/libibmad:libibmad.map),--no-undefined-version'],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=rdma","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
