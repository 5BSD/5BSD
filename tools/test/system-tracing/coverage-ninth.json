  "passes": [
    "Interface cloning: ioctl and Netlink create requests after cloner lookup; no attach-time auto-create site.",
    "Bridge: validated control callback timing and result, outside packet forwarding.",
    "Link aggregation: member add/remove lifecycle and failure before dropping the interface reference.",
    "VLAN: ioctl association with parent/tag and configuration result.",
    "Tun/tap: blocking character-device reads and wake errors, no packets.",
    "Tarfs: backing/compressed stream read latency, requested extent and residual/error.",
    "Unionfs: actual lower-to-upper copy phase timing and error.",
    "Nullfs: initial vnode cache hit/miss and getnewvnode latency/error; no allocator internals.",
    "UDF: buffer/cluster read extent, latency and error before touching the returned buffer.",
    "CD9660: buffer/cluster read extent, latency and error before touching the returned buffer.",
    "Memory disks: ioctl attach/detach/resize/query dispatch; excluded preload initialization.",
    "Terminal: validated tty ioctl dispatch latency and failure, no terminal bytes.",
    "ln/link: hard/symbolic link creation syscall latency/error; no path strings.",
    "rmdir: each directory/parent removal attempt and syscall errno.",
    "chflags: requested file flags and actual chflagsat outcome, including suppressed failures.",
    "renice: selector/identity/requested priority and kernel outcome.",
    "kldload: actual load attempt latency, returned module id and errno.",
    "kldunload: unload id/flags, syscall result and errno.",
    "sync: whole sync syscall boundary; done does not invent an errno for a void API.",
    "lockf: fd flock and path open-with-lock operations, including lock release and interruption; no filenames."
  ],
