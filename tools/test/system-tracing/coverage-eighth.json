  "passes": [
    "POSIX message queues: wake outcomes and queue depth complement existing block probes.",
    "System V message queues: distinguish periodic retry wakes from interruption and receive wakes.",
    "System V semaphores: raw timed wait completion before object revalidation.",
    "Pipe serialization: lock contention latency and interruption.",
    "AIO suspend: per-sleep latency and raw wake status.",
    "Filesystem unmount: reference drain timing outside filesystem callbacks.",
    "USB FIFO: process-context I/O waits including device-loss wake status.",
    "Swap pager: async write-buffer exhaustion wait and available capacity on wake.",
    "Resource accounting: throttling delay and state on wake, before timeout clearing.",
    "GEOM control: queued event execution latency and handler outcome.",
    "UNIX stream sockets: peer receive-buffer backpressure latency and wake errors.",
    "Kqueue teardown: reference and taskqueue drain timing with explicit reason.",
    "dd: fsync/fdatasync latency and durable-write failure.",
    "cp: interrupted transfer retries with descriptor identities, no paths.",
    "libfetch: connect/read/write readiness wait latency, poll timeout, errno, revents.",
    "rm/unlink: file/directory removal attempts, latency and errno.",
    "chmod: requested permission mode, actual syscall outcome including suppressed errors.",
    "mkdir: each parent/leaf creation attempt, requested mode and errno.",
    "truncate: resize and hole-deallocation extent, latency and failure.",
    "mv: parent-only copy/remove child wait latency, raw exit status and wait error.",
    "Autofs: joined/new request wait including daemon status and interruption before releasing request reference.",
    "CUSE: client command completion and outstanding process-reference drain, including server closing.",
    "9P: whole synchronous RPC through preparation/transport/reply error and exhausted transaction tags."
  ],
