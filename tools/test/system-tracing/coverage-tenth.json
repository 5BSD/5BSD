  "passes": [
    {
      "component": "usr.bin/touch",
      "provider": "filetime",
      "scope": "Each timestamp update, including retry; flags, result and errno. No timestamps or paths."
    },
    {
      "component": "usr.bin/stat",
      "provider": "filestat",
      "scope": "Metadata queries: kind 0 stat, 1 lstat, 2 fstat. Result/errno; excludes fhstat and readlink payload."
    },
    {
      "component": "usr.sbin/chown",
      "provider": "fileowner",
      "scope": "Ownership update attempts, including chgrp alias; flags and result, no identities/paths."
    },
    {
      "component": "usr.bin/mkfifo",
      "provider": "fifocreate",
      "scope": "FIFO creation mode, result and errno."
    },
    {
      "component": "usr.bin/pathchk",
      "provider": "pathcheck",
      "scope": "Filesystem-aware path component lookup; ENOENT may be accepted by the caller, not a command failure."
    },
    {
      "component": "usr.bin/du",
      "provider": "diskwalk",
      "scope": "Traversal advance; FTS entry type or terminal zero, with errno only for terminal return or FTS_ERR/DNR/NS entries. No paths."
    },
    {
      "component": "bin/df",
      "provider": "diskspace",
      "scope": "Per-path filesystem usage query; excludes bulk getmntinfo."
    },
    {
      "component": "sbin/sysctl",
      "provider": "sysctltool",
      "scope": "Sysctl query/set and name-walking requests; write flag and MIB length, never values or MIB buffers."
    },
    {
      "component": "usr.bin/limits",
      "provider": "limittool",
      "scope": "Current-process resource limit application; resource/result; excludes target-process sysctl mode."
    },
    {
      "component": "usr.bin/killall",
      "provider": "signalall",
      "scope": "Each selected-process signal attempt; pid, signal, result, errno. Dry-run produces no send probes."
    },
    {
      "component": "bin/kill",
      "provider": "signaltool",
      "scope": "Numeric signal syscall boundary including signal-zero checks; no process names."
    },
    {
      "component": "usr.bin/logger",
      "provider": "logsend",
      "scope": "Remote datagram send length, bytes/result and errno; local submission pair is void and does not claim delivery."
    },
    {
      "component": "usr.sbin/daemon",
      "provider": "daemonwait",
      "scope": "Supervisor event registration and waits; change/event capacities, returned count and errno. No probes in signal handlers."
    },
    {
      "component": "usr.bin/env",
      "provider": "envdir",
      "scope": "Requested working-directory change before exec; no environment or command values."
    },
    {
      "component": "usr.bin/getconf",
      "provider": "configquery",
      "scope": "Sysconf query key and returned value; -1 with errno zero is indeterminate, not a failure."
    },
    {
      "component": "bin/cpuset",
      "provider": "cpusettool",
      "scope": "Affinity read/write operation kind, level and selector; no masks. Excludes domain/id operations."
    },
    {
      "component": "bin/timeout",
      "provider": "timeoutsig",
      "scope": "Foreground signal dispatch including SIGCONT; reaper dispatch has its own pair. Signal handlers only set flags."
    },
    {
      "component": "bin/realpath",
      "provider": "pathresolve",
      "scope": "Path resolution boundary; boolean success and errno, no input/resolved strings."
    },
    {
      "component": "bin/sleep",
      "provider": "sleepwait",
      "scope": "Each sleep attempt, completion and interruption; duration measured by paired timestamps outside signal handler."
    },
    {
      "component": "usr.bin/mktemp",
      "provider": "tempcreate",
      "scope": "Temporary file (kind 0) or directory (kind 1) creation; boolean success/errno, never templates or generated paths."
    }
  ],
