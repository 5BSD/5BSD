load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_object")

# Synthetic relocatable ELF metadata for kldxref audits. Never kernel-load these.
# Keep the cases aligned with pnp_fixture.c and the maintained Makefile.
[cc_library(
    name = "pnp_%d_objects" % case,
    srcs = ["pnp_fixture.c"],
    copts = ["-fno-pic", "-DPNP_CASE=%d" % case],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
) for case in range(9)]

[bsd_component_object(
    name = "pnp_%d" % case,
    group = ":pnp_%d_objects" % case,
    out = "pnp-%d.ko" % case,
) for case in range(9)]

filegroup(
    name = "pnp_fixtures",
    srcs = [":pnp_%d" % case for case in range(9)],
    visibility = ["//visibility:public"],
)

load(":kldxref_test.bzl", "kldxref_audit_test")
[kldxref_audit_test(
    name = variant + "_" + mode.replace("-", "_") + "_test",
    program = "//usr.sbin/kldxref:" + program,
    audit = "audit-" + mode + ".py",
    mode = mode,
    fixtures = [":pnp_fixtures"],
    libraries = [
        "//lib/libelf:elf_shared", "//lib/libz:z_shared",
        "@bsd_sdk//toolchain:sysroot/lib/libc.so.7",
        "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7",
    ] + (["//lib/libkldelf:kldelf_shared"] if variant == "native" else []),
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib"],
    tags = ["local", "no-cache"],
    size = "small",
) for variant, program in [("native", "kldxref"), ("bootstrap", "bootstrap_kldxref")]
  for mode in ["pnp", "module-inputs", "kldxref"]]

# Real linked module; this test inspects it without kernel loading.
kldxref_audit_test(name = "nullfs_artifacts_test", mode = "module-artifacts",
    program = "//usr.sbin/kldxref:kldxref", audit = "audit-module-artifacts.py",
    fixtures = ["//sys/modules/nullfs:generic_module", "//sys/modules/nullfs:generic_full", "//sys/modules/nullfs:generic_debug",
        "//cddl/usr.bin/ctfdump:ctfdump", "//sys/sys:param.h", "//tools/build/bazel:elf-debug-check.py", "module-policy.json"],
    libraries = ["//lib/libelf:elf_shared", "//lib/libz:z_shared", "//lib/libkldelf:kldelf_shared",
        "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"],
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib"], tags = ["local", "no-cache"], size = "small")

exports_files(['inventory_audit_test.py'], visibility = ["//usr.sbin/bsd-build/tests:__pkg__"])


# Semantic module inspection uses native Python and target ELF inputs. Keep the
# older AMD64 kldxref whole-module audit's execution contract separate.
load("//tools/build/bazel:bsd_python_test.bzl", "bsd_host_artifact_test")
[bsd_host_artifact_test(
    name = prefix + "nullfs_ctf_symbols_test",
    src = "module-ctf-test.py",
    data = ["//sys/modules/nullfs:" + prefix + "generic_module",
        "//sys/modules/nullfs:" + prefix + "generic_full",
        "//tools/build/bazel:ctf_semantics.py", "module-policy.json"],
    args = ["--reader", "$(location //tools/build/bazel:ctf_semantics.py)",
        "--module", "$(location //sys/modules/nullfs:" + prefix + "generic_module)",
        "--full", "$(location //sys/modules/nullfs:" + prefix + "generic_full)",
        "--policy", "$(location module-policy.json)",
        "--machine", str(machine), "--elf-type", str(elf_type)],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:" + cpu] + select({
        "//tools/build/bazel/config:kernel_ctf_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    size = "small",
) for prefix, cpu, machine, elf_type in [
    ("", "x86_64", 62, 1), ("arm64_", "aarch64", 183, 3), ("riscv_", "riscv64", 243, 3),
]]
