; SPDX-License-Identifier: BSD-2-Clause
; DESTRUCTIVE TO THE SELECTED FILE. Disposable VM scratch files only.
; Workers share one existing file; includes same-vnode contention.
[global]
filename=${BIP_FIO_FILE}
size=${BIP_FIO_BYTES}
runtime=${BIP_FIO_SECONDS}
ramp_time=${BIP_FIO_RAMP_SECONDS}
randseed=${BIP_FIO_SEED}
ioengine=psync
iodepth=1
direct=0
invalidate=0
allow_file_create=0
unlink=0
time_based=1
group_reporting=0
lat_percentiles=1
percentile_list=50:95:99:99.9
randrepeat=1
refill_buffers=1
buffer_compress_percentage=0

[sequential-write-128k-j1]
rw=write
bs=128k
numjobs=1

[random-write-4k-j1]
stonewall
rw=randwrite
bs=4k
numjobs=1

[random-write-4k-j8]
stonewall
rw=randwrite
bs=4k
numjobs=8

[random-write-4k-j32]
stonewall
rw=randwrite
bs=4k
numjobs=32

[fsync-write-4k-j1]
stonewall
rw=write
bs=4k
numjobs=1
fsync=1

[mixed-read70-write30-4k-j8]
stonewall
rw=randrw
rwmixread=70
bs=4k
numjobs=8
