; SPDX-License-Identifier: BSD-2-Clause
; Run only with --readonly and explicit environment inputs; see README.md.
; Buffered reads: this job does not establish a cold-cache condition.
[global]
filename=${BIP_FIO_FILE}
size=${BIP_FIO_BYTES}
runtime=${BIP_FIO_SECONDS}
ramp_time=${BIP_FIO_RAMP_SECONDS}
randseed=${BIP_FIO_SEED}
ioengine=psync
iodepth=1
direct=0
invalidate=0
allow_file_create=0
unlink=0
time_based=1
group_reporting=0
lat_percentiles=1
percentile_list=50:95:99:99.9
randrepeat=1

[sequential-128k-j1]
rw=read
bs=128k
numjobs=1

[random-4k-j1]
stonewall
rw=randread
bs=4k
numjobs=1

[random-4k-j2]
stonewall
rw=randread
bs=4k
numjobs=2

[random-4k-j8]
stonewall
rw=randread
bs=4k
numjobs=8

[random-4k-j32]
stonewall
rw=randread
bs=4k
numjobs=32
