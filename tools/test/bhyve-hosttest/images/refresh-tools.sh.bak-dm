#!/bin/sh
# Refresh the kit's helper binaries after the upgrade (ordinary user):
# OTLP collector/validators from the world object tree, the C helpers and the
# guest tools (vsock-pipe, srtool) rebuilt with the installed toolchain.
# Run it before images/build-guest.sh: the image embeds guest-bin/.
#   usage: images/refresh-tools.sh [OBJTOP]
set -eu
KIT=$(cd "$(dirname "$0")/.." && pwd)
O=${1:-/usr/obj/usr/src/amd64.amd64}
cp "$O/lib/libotelexport/tests/otlp_collector" "$O/lib/libotelexport/tests/otlp_validate" \
    "$O/usr.sbin/otelconf/tests/otlp_json_validate" "$KIT/bin/"
cc -O2 -Wall -o "$KIT/bin/ht-sockpair" "$KIT/src/ht-sockpair.c"
cc -O2 -Wall -o "$KIT/bin/ht-camera" "$KIT/src/ht-camera.c"
cc -O2 -Wall -o "$KIT/bin/ht-audio" "$KIT/src/ht-audio.c" -lm
cc -O2 -Wall -o "$KIT/bin/vsh-connect" "$KIT/src/vsh-connect.c"
cc -O2 -Wall -o "$KIT/guest-bin/vsock-pipe" "$KIT/src/vsock-pipe.c"
# sr2: static, so the same binary computes reference digests on the host.
cc -static -O2 -Wall -o "$KIT/guest-bin/srtool" "$KIT/src/srtool.c" -lmd
{
	for f in otlp_collector otlp_validate otlp_json_validate; do
		echo "$f $(sha256 -q "$KIT/bin/$f") from $O"
	done
	echo "source_revision=$(git -C /usr/src rev-parse HEAD 2>/dev/null || echo unknown)"
	echo "refreshed=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
} > "$KIT/bin/PROVENANCE"
cat "$KIT/bin/PROVENANCE"
