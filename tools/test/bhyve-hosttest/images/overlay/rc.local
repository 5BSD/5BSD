#!/bin/sh
# hosttest guest boot marker and role dispatch.
role=$(kenv -q hosttest.role); role=${role:-l1}
gen=$(cat /etc/hosttest-generation 2>/dev/null)
c=/dev/console
echo "HOSTTEST-GUEST-BOOT role=$role generation=$gen host=$(hostname) kernel=$(sysctl -n kern.ident)" > $c
# Check before any readiness or L2 success marker. Keep failures on the console.
if ! timeout -k 1 5 sh /root/hosttest/capability-check.sh > $c 2>&1; then
	echo "CAPABILITY-PLANE-FAIL guest runtime prerequisites" > $c
	exit 1
fi
case "$role" in
l2)
	# Marker, optional checksum workload and hold (guest/l2-role.sh), then off.
	if [ -x /root/hosttest/l2-role.sh ]; then
		/root/hosttest/l2-role.sh
	else
		echo "HOSTTEST-L2-MARKER $(kenv -q hosttest.marker) model=$(sysctl -n hw.model) ncpu=$(sysctl -n hw.ncpu)" > $c
	fi
	sleep 1
	poweroff
	;;
esac
# Preserve dtrace -Y stderr as well as minion errors; daemonized dtraced
# redirects its children's stderr to /dev/null, losing linker/probe errors.
if [ "$(kenv -q hosttest.dtraced)" = yes ]; then
	/usr/sbin/daemon -o /var/log/hosttest-dtraced.log /usr/sbin/dtraced -m -d
fi
echo "HOSTTEST-GUEST-READY role=$role" > $c
