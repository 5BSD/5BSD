load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_objects")
load("//tools/build/bazel:bsd_python_test.bzl", "bsd_host_artifact_test")
load("//tools/build/bazel:bsd_sdk_headers.bzl", "bsd_sdk_headers")

bsd_sdk_headers(name = "integer_header", resource_headers = ["stdckdint.h"])
cc_library(name = "resource_input", srcs = ["resource.c"], deps = [":integer_header"],
    target_compatible_with = ["@bsd_sdk//toolchain:standalone"],
    copts = ["-std=c23"] + select({"@platforms//cpu:riscv64": ["-march=rv64imac", "-mabi=lp64"],
                    "//conditions:default": []}))
bsd_component_objects(name = "resource_object", group = ":resource_input", visibility = ["//visibility:public"],
    target_compatible_with = ["@bsd_sdk//toolchain:standalone"])
bsd_host_artifact_test(name = "resource_test", src = "resource_test.py", data = [":resource_object"],
    args = ["--object", "$(rlocationpath :resource_object)", "--machine"] + select({
        "@platforms//cpu:x86_64": ["62"], "@platforms//cpu:aarch64": ["183"],
        "@platforms//cpu:riscv64": ["243"], "//conditions:default": ["0"]}),
    target_compatible_with = ["@bsd_sdk//toolchain:standalone"],
    visibility = ["//visibility:public"], size = "small")

# This deliberate compile-failure target must not be included in success suites.
# The driver must reject an undeclared hosted header under the standalone ABI.
cc_library(name = "undeclared_hosted_header", srcs = ["hosted_header.c"], tags = ["manual"],
    target_compatible_with = ["@bsd_sdk//toolchain:standalone"],
    visibility = ["//visibility:public"])

exports_files(["resource_test.py"], visibility = ["//tools/build/bazel/tests/freestanding_boundary:__pkg__"])

load("//tools/build/bazel:bsd_firmware_link.bzl", "bsd_firmware_link")
bsd_firmware_link(name = "resource_image", objects = [":resource_object"],
    object_order = ["resource.o"], archives = [], script = "resource.ld", output = "resource.elf",
    linkopts = ["-static", "-no-pie"], target_compatible_with = ["@bsd_sdk//toolchain:standalone"],
    visibility = ["//visibility:public"])
