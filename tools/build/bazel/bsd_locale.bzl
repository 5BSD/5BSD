"""Locale data generated by an execution-platform tool for an explicit target byte order."""

_EXECUTION_RUNTIME = [
    "@bsd_sdk//toolchain:execution-runtime/lib/libc.so.7",
    "@bsd_sdk//toolchain:execution-runtime/lib/libsys.so.7",
    "@bsd_sdk//toolchain:execution-runtime/libexec/ld-elf.so.1",
]

def _locale_environment(ctx):
    return {"LC_ALL": "C", "LD_LIBRARY_PATH": ":".join(sorted(depset([
        f.dirname for f in ctx.files.runtime
    ]).to_list()))}

def _ctype(ctx):
    output = ctx.actions.declare_file(ctx.label.name + ".LC_CTYPE")
    stem = output.path[:-len(".LC_CTYPE")]
    ctx.actions.run(
        executable = ctx.attr.localedef[DefaultInfo].files_to_run,
        arguments = ["-l" if ctx.attr.endian == "little" else "-b", "-D", "-U", "-c",
                     "-w", ctx.file.widths.path, "-f", ctx.file.charmap.path,
                     "-i", ctx.file.src.path, stem],
        inputs = [ctx.file.src, ctx.file.charmap, ctx.file.widths],
        outputs = [output], tools = ctx.files.runtime,
        env = _locale_environment(ctx),
        use_default_shell_env = False,
        mnemonic = "BSDLocaleCtype",
    )
    return [DefaultInfo(files = depset([output]))]

bsd_locale_ctype = rule(implementation = _ctype, attrs = {
    "src": attr.label(allow_single_file = True, mandatory = True),
    "charmap": attr.label(allow_single_file = True, mandatory = True),
    "widths": attr.label(allow_single_file = True, mandatory = True),
    "endian": attr.string(values = ["little", "big"], mandatory = True),
    "localedef": attr.label(executable = True, cfg = "exec", mandatory = True),
    "runtime": attr.label_list(default = _EXECUTION_RUNTIME, allow_files = True, cfg = "exec"),
})


def _catalog(ctx):
    output = ctx.actions.declare_file(ctx.label.name + ".cat")
    ctx.actions.run(executable = ctx.executable.gencat,
        arguments = [output.path, ctx.file.src.path],
        inputs = [ctx.file.src], outputs = [output],
        env = {"LC_ALL": "C"}, use_default_shell_env = False,
        mnemonic = "BSDMessageCatalog")
    return [DefaultInfo(files = depset([output]))]

bsd_message_catalog = rule(implementation = _catalog, attrs = {
    "src": attr.label(allow_single_file = True, mandatory = True),
    "gencat": attr.label(executable = True, cfg = "exec", mandatory = True),
})


def _collate(ctx):
    output = ctx.actions.declare_file(ctx.label.name + ".LC_COLLATE")
    stem = output.path[:-len(".LC_COLLATE")]
    ctx.actions.run(executable = ctx.attr.localedef[DefaultInfo].files_to_run,
        arguments = ["-l" if ctx.attr.endian == "little" else "-b", "-D", "-U",
                     "-i", ctx.file.src.path, "-V", ctx.attr.version,
                     "-f", ctx.file.charmap.path, stem],
        inputs = [ctx.file.src, ctx.file.charmap], outputs = [output], tools = ctx.files.runtime,
        env = _locale_environment(ctx), use_default_shell_env = False,
        mnemonic = "BSDLocaleCollate")
    return [DefaultInfo(files = depset([output]))]

bsd_locale_collate = rule(implementation = _collate, attrs = {
    "src": attr.label(allow_single_file = True, mandatory = True),
    "charmap": attr.label(allow_single_file = True, mandatory = True),
    "endian": attr.string(values = ["little", "big"], mandatory = True),
    "version": attr.string(mandatory = True),
    "localedef": attr.label(executable = True, cfg = "exec", mandatory = True),
    "runtime": attr.label_list(default = _EXECUTION_RUNTIME, allow_files = True, cfg = "exec"),
})
