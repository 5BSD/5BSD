diff --git a/usr.sbin/bsdtrace/BUILD.bazel b/usr.sbin/bsdtrace/BUILD.bazel
new file mode 100644
index 00000000000..5fea84d3bfd
--- /dev/null
+++ b/usr.sbin/bsdtrace/BUILD.bazel
@@ -0,0 +1,22 @@
+# SPDX-License-Identifier: BSD-2-Clause
+load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
+_SOURCES = ["bsdtrace.c", "cmd_decode.c", "cmd_exec.c", "cmd_list.c", "cmd_trace.c", "decode.c", "dwarf.c", "elf.c", "format.c", "hwt.c", "meta.c", "resolve.c", "symbols.c", "trace.c"]
+cc_library(name = "headers", hdrs = ["bsdtrace.h"], strip_include_prefix = ".",
+    deps = ["//sys/sys:bsdtrace_headers", "//sys/vm:bsdtrace_headers", "//sys/bsm:kernel_headers", "//contrib/processor-trace:bsdtrace_headers"])
+cc_binary(name = "bsdtrace", srcs = _SOURCES, deps = [":headers", "//lib/libipt:ipt", "//lib/libelf:elf", "//lib/libdwarf:dwarf", "//lib/libz:z", "//lib/msun:m"],
+    dynamic_deps = ["//lib/libipt:ipt_shared", "//lib/libelf:elf_shared", "//lib/libdwarf:dwarf_shared", "//lib/libz:z_shared", "//lib/msun:m_shared"],
+    copts = ["-fPIE", "-DPIC"], linkopts = ["-pie"],
+    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
+cc_library(name = "ptwrite_header", hdrs = ["bsdtrace_ptwrite.h"], strip_include_prefix = ".", visibility = ["//visibility:public"])
+load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file")
+bsd_install_file(name = "install_ptwrite", src = "bsdtrace_ptwrite.h", destination = "/usr/include/bsdtrace_ptwrite.h", owner = "root", group = "wheel", mode = "0444", install_tags = ["package=bsdtrace", "dev"])
+load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
+utility_installation(name = "install_manifest", program = "bsdtrace", manual = "bsdtrace.8", man_section = "8", package = "bsdtrace", bindir = "/usr/sbin", extra_entries = [":install_ptwrite"])
+load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
+bsd_install_archive(name = "install_archive", manifests = [":install_manifest"] + select({"//tools/build/bazel/config:tests_enabled": ["//usr.sbin/bsdtrace/tests:install_manifest"], "//conditions:default": []}),
+    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bsdtrace","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]} |
+        select({"//tools/build/bazel/config:tests_enabled": {"/usr/tests/usr.sbin/bsdtrace": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bsdtrace-tests"]}'}, "//conditions:default": {}}),
+    mtree_specs = {"//etc/mtree:BSD.tests.dist": "/usr/tests", "//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.include.dist": "/usr/include", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
+    passwd = "//etc:master.passwd", group = "//etc:group", epoch = 0,
+    mtree = "@bsd_sdk//toolchain:extra_mtree", python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
+    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
diff --git a/usr.sbin/bsdtrace/tests/BUILD.bazel b/usr.sbin/bsdtrace/tests/BUILD.bazel
new file mode 100644
index 00000000000..871d1037953
--- /dev/null
+++ b/usr.sbin/bsdtrace/tests/BUILD.bazel
@@ -0,0 +1,20 @@
+# SPDX-License-Identifier: BSD-2-Clause
+load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_script_wrapper")
+load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
+bsd_script_wrapper(name = "bsdtrace_test", body = "bsdtrace_test.sh", interpreter = "/usr/libexec/atf-sh",
+    cat = "@bsd_sdk//toolchain:cat", cat_runtime = ["@bsd_sdk//toolchain:cat_runtime"], redirect = "@bsd_sdk//toolchain:stdout_redirect")
+bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["bsdtrace_test"], interfaces = {"bsdtrace_test": "atf"})
+[bsd_install_file(name = "install_" + name, src = ":" + source, destination = "/usr/tests/usr.sbin/bsdtrace/" + dest,
+    owner = "root", group = "wheel", mode = mode, install_tags = ["package=bsdtrace-tests"])
+ for name, source, dest, mode in [("script", "bsdtrace_test", "bsdtrace_test", "0555"), ("kyuafile", "kyuafile", "Kyuafile", "0444")]]
+bsd_install_manifest(name = "install_manifest", entries = [":install_script", ":install_kyuafile"], visibility = ["//usr.sbin/bsdtrace:__pkg__"])
+load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
+# Install all thirteen cases unchanged. Two installed-path cases need a guest:
+# ptwrite_header_compiles and meta_unparsable_warns (/boot/kernel/kernel).
+_NATIVE_CASES = ["usage_surface", "list_runs", "decode_missing_files", "decode_empty_trace", "decode_corrupt_meta", "decode_truncated_pt", "exec_requires_command", "trace_requires_pid", "option_validation", "decode_capture_env", "decode_extended_meta"]
+_TOOLS = ["//usr.sbin/bsdtrace:bsdtrace", "//bin/sh:sh", "//libexec/atf/atf-sh:atf-sh", "//libexec/atf/atf-check:atf-check", "//bin/cat:cat", "//bin/dd:dd", "//usr.bin/tr:tr", "//usr.bin/grep:grep", "//usr.bin/dirname:dirname", "//usr.bin/basename:basename", "//usr.bin/sed:sed", "//bin/rm:rm", "//bin/test:test", "//usr.bin/true:true"]
+_LIBS = ["//lib/libipt:ipt_shared", "//lib/libelf:elf_shared", "//lib/libdwarf:dwarf_shared", "//lib/libz:z_shared", "//lib/msun:m_shared", "//lib/libthr:thr_shared", "//lib/libutil:util_shared", "//lib/libxo/libxo:xo_shared", "//lib/libregex:regex_shared", "//lib/libedit:edit_shared", "//lib/ncurses/tinfo:tinfo_shared", "//lib/atf/libatf-c:atf_c_shared", "//lib/atf/libatf-c++:atf_cxx_shared", "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/libc:c_shared", "//lib/libsys:sys_shared", "@bsd_sdk//toolchain:sysroot/lib/libgcc_s.so.1"]
+[bsd_atf_test(name = "native_" + case, body = "bsdtrace_test.sh", case_name = case,
+    subr = "//libexec/atf/atf-sh:shell_library", runner = "//tools/build/bazel:atf_runner", runtime_bin = _TOOLS, runtime_lib = _LIBS,
+    size = "small", visibility = ["//visibility:public"]) for case in _NATIVE_CASES]
+test_suite(name = "tests", tests = [":native_" + case for case in _NATIVE_CASES], visibility = ["//visibility:public"])
