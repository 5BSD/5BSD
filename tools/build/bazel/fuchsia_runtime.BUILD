filegroup(name = "fidlc_sources", srcs = ['tools/fidl/fidlc/cmd/fidlc/main.cc', 'tools/fidl/fidlc/src/attribute_schema.cc', 'tools/fidl/fidlc/src/attributes.cc', 'tools/fidl/fidlc/src/availability_step.cc', 'tools/fidl/fidlc/src/compile_step.cc', 'tools/fidl/fidlc/src/compiler.cc', 'tools/fidl/fidlc/src/constraints.cc', 'tools/fidl/fidlc/src/consume_step.cc', 'tools/fidl/fidlc/src/diagnostic_types.cc', 'tools/fidl/fidlc/src/diagnostics_json.cc', 'tools/fidl/fidlc/src/experimental_flags.cc', 'tools/fidl/fidlc/src/flat_ast.cc', 'tools/fidl/fidlc/src/index_json_generator.cc', 'tools/fidl/fidlc/src/json_generator.cc', 'tools/fidl/fidlc/src/lexer.cc', 'tools/fidl/fidlc/src/name.cc', 'tools/fidl/fidlc/src/names.cc', 'tools/fidl/fidlc/src/parser.cc', 'tools/fidl/fidlc/src/raw_ast.cc', 'tools/fidl/fidlc/src/reference.cc', 'tools/fidl/fidlc/src/replacement_step.cc', 'tools/fidl/fidlc/src/reporter.cc', 'tools/fidl/fidlc/src/resolve_step.cc', 'tools/fidl/fidlc/src/source_file.cc', 'tools/fidl/fidlc/src/source_manager.cc', 'tools/fidl/fidlc/src/source_span.cc', 'tools/fidl/fidlc/src/transport.cc', 'tools/fidl/fidlc/src/tree_visitor.cc', 'tools/fidl/fidlc/src/type_resolver.cc', 'tools/fidl/fidlc/src/type_shape_step.cc', 'tools/fidl/fidlc/src/types.cc', 'tools/fidl/fidlc/src/typespace.cc', 'tools/fidl/fidlc/src/utils.cc', 'tools/fidl/fidlc/src/values.cc', 'tools/fidl/fidlc/src/verify_steps.cc', 'tools/fidl/fidlc/src/versioning_types.cc', 'tools/fidl/fidlc/src/virtual_source_file.cc', 'src/lib/cmdline/args_parser.cc', 'sdk/lib/zircon-assert/zx_panic_libc.cc', 'src/lib/fxl/strings/ascii.cc', 'src/lib/fxl/strings/concatenate.cc', 'src/lib/fxl/strings/split_string.cc', 'src/lib/fxl/strings/string_number_conversions.cc', 'src/lib/fxl/strings/string_printf.cc', 'src/lib/fxl/strings/substitute.cc', 'src/lib/fxl/strings/trim.cc', 'src/lib/fxl/strings/utf_codecs.cc', 'src/lib/fxl/third_party/icu/icu_utf.cc'])
exports_files(["tools/fidl/fidlc/gen-json-schema.sh", "tools/fidl/fidlc/schema.json"])

filegroup(name = "binding_templates", srcs = ['tools/fidl/fidlgen_cpp/codegen/file_markers.tmpl', 'tools/fidl/fidlgen_cpp/codegen/file_common_types_header.tmpl', 'tools/fidl/fidlgen_cpp/codegen/file_common_types_source.tmpl', 'tools/fidl/fidlgen_cpp/codegen/file_natural_types_header.tmpl', 'tools/fidl/fidlgen_cpp/codegen/file_natural_types_source.tmpl', 'tools/fidl/fidlgen_cpp/codegen/natural_struct.tmpl', 'tools/fidl/fidlgen_cpp/codegen/natural_table.tmpl', 'tools/fidl/fidlgen_cpp/codegen/natural_union.tmpl', 'tools/fidl/fidlgen_cpp/codegen/fragment_enum.tmpl', 'tools/fidl/fidlgen_cpp/codegen/fragment_bits.tmpl', 'tools/fidl/fidlgen_cpp/codegen/fragment_const.tmpl', 'tools/fidl/fidlgen_cpp/codegen/fragment_alias.tmpl'])
