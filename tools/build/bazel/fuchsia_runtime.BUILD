load("@rules_cc//cc:defs.bzl", "cc_library")
package(default_visibility = ["//visibility:public"])
cc_library(name = "headers_0", hdrs = glob(["sdk/lib/fidl_base/include/**/*.h"]) + glob(["sdk/lib/fidl_base/include/**/*.inc"], allow_empty = True), strip_include_prefix = "sdk/lib/fidl_base/include")
cc_library(name = "headers_1", hdrs = glob(["sdk/lib/fidl/cpp/include/**/*.h"]) + glob(["sdk/lib/fidl/cpp/include/**/*.inc"], allow_empty = True), strip_include_prefix = "sdk/lib/fidl/cpp/include")
cc_library(name = "headers_2", hdrs = glob(["sdk/lib/fidl/cpp/wire/include/**/*.h"]) + glob(["sdk/lib/fidl/cpp/wire/include/**/*.inc"], allow_empty = True), strip_include_prefix = "sdk/lib/fidl/cpp/wire/include")
cc_library(name = "headers_3", hdrs = glob(["sdk/lib/fit/include/**/*.h"]) + glob(["sdk/lib/fit/include/**/*.inc"], allow_empty = True), strip_include_prefix = "sdk/lib/fit/include")
cc_library(name = "headers_4", hdrs = glob(["sdk/lib/stdcompat/include/**/*.h"]) + glob(["sdk/lib/stdcompat/include/**/*.inc"], allow_empty = True), strip_include_prefix = "sdk/lib/stdcompat/include")
cc_library(name = "headers_5", hdrs = glob(["src/zircon/lib/zircon/include/**/*.h"]) + glob(["src/zircon/lib/zircon/include/**/*.inc"], allow_empty = True), strip_include_prefix = "src/zircon/lib/zircon/include")
cc_library(name = "headers_6", hdrs = glob(["zircon/system/public/zircon/**/*.h"]) + glob(["zircon/system/public/zircon/**/*.inc"], allow_empty = True), strip_include_prefix = "zircon/system/public")
cc_library(name = "headers_7", hdrs = glob(["sdk/lib/zircon-assert/zircon/**/*.h"]) + glob(["sdk/lib/zircon-assert/zircon/**/*.inc"], allow_empty = True), strip_include_prefix = "sdk/lib/zircon-assert")
cc_library(name = "utf_headers", hdrs = ["sdk/lib/utf-utils/utf-utils.h"] + glob(["sdk/lib/utf-utils/internal/*.h"]), strip_include_prefix = "sdk")
cc_library(name = "headers", deps = [':headers_0', ':headers_1', ':headers_2', ':headers_3', ':headers_4', ':headers_5', ':headers_6', ':headers_7', ':utf_headers'])
filegroup(name = "runtime_cxx_sources", srcs = ['sdk/lib/fidl/cpp/wire/coding_errors.cc', 'sdk/lib/fidl/cpp/wire/incoming_message.cc', 'sdk/lib/fidl/cpp/wire/outgoing_message.cc', 'sdk/lib/fidl/cpp/wire/status.cc', 'sdk/lib/fidl/cpp/wire/transport.cc', 'sdk/lib/fidl/cpp/wire/wire_coding_traits.cc', 'sdk/lib/fidl/cpp/wire/wire_decoder.cc', 'sdk/lib/fidl/cpp/wire/wire_encoder.cc', 'sdk/lib/fidl/cpp/wire/transport_channel_host.cc', 'sdk/lib/fidl/cpp/natural_coding_traits.cc', 'sdk/lib/fidl/cpp/natural_decoder.cc', 'sdk/lib/fidl/cpp/natural_encoder.cc', 'sdk/lib/fidl_base/handle_close_many.cc', 'sdk/lib/fidl_base/wire_format_metadata.cc', 'sdk/lib/zircon-assert/zx_panic_libc.cc', 'sdk/lib/utf-utils/utf-utils.cc', 'sdk/lib/utf-utils/internal/scalar.cc'])
exports_files(['LICENSE', 'PATENTS', 'sdk/lib/utf-utils/utf-utils.h', 'sdk/lib/fidl/cpp/wire/coding_errors.cc', 'sdk/lib/fidl/cpp/wire/incoming_message.cc', 'sdk/lib/fidl/cpp/wire/outgoing_message.cc', 'sdk/lib/fidl/cpp/wire/status.cc', 'sdk/lib/fidl/cpp/wire/transport.cc', 'sdk/lib/fidl/cpp/wire/wire_coding_traits.cc', 'sdk/lib/fidl/cpp/wire/wire_decoder.cc', 'sdk/lib/fidl/cpp/wire/wire_encoder.cc', 'sdk/lib/fidl/cpp/wire/transport_channel_host.cc', 'sdk/lib/fidl/cpp/natural_coding_traits.cc', 'sdk/lib/fidl/cpp/natural_decoder.cc', 'sdk/lib/fidl/cpp/natural_encoder.cc', 'sdk/lib/fidl_base/handle_close_many.cc', 'sdk/lib/fidl_base/wire_format_metadata.cc', 'sdk/lib/zircon-assert/zx_panic_libc.cc', 'sdk/lib/utf-utils/utf-utils.cc', 'sdk/lib/fidl_base/internal.c', 'sdk/lib/utf-utils/internal/scalar.cc'])

exports_files(glob(["**/*.h"]) + glob(["**/*.inc"], allow_empty = True))

cc_library(name = "fidlc_headers", hdrs = glob(["tools/fidl/fidlc/src/*.h", "tools/fidl/fidlc/src/*.inc", "src/lib/fxl/strings/*.h", "src/lib/fxl/third_party/icu/*.h"]) + ["src/lib/fxl/macros.h", "src/lib/fxl/fxl_export.h", 'src/lib/fxl/build_config.h'], strip_include_prefix = ".")
