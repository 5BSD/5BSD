load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
load(":tests.bzl", "environment_tests")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
# Framework regression: one actual test can be configured incompatible.
bool_flag(name = "conditional_enabled", build_setting_default = True, visibility = ["//visibility:public"])
config_setting(name = "conditional_on", flag_values = {":conditional_enabled": "true"})
cc_binary(name = "startup", srcs = ["startup.c"],
    deps = ["//lib/atf/libatf-c:atf_c"],
    dynamic_deps = ["//lib/atf/libatf-c:atf_c_shared"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
[bsd_atf_test(name = "startup_" + case, case_name = case, interface = "program", body = ":startup",
    test_environment = {"SOURCE_OWNED_VALUE": value, "DTRACE_DOF_INIT_DISABLE": "1"},
    runtime_lib = ["//lib/atf/libatf-c:atf_c_shared", "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"],
    target_compatible_with = select({":conditional_on": [], "//conditions:default": ["@platforms//:incompatible"]}) if case == "beta" else [],
    runner = "//tools/build/bazel:atf_runner", size = "small")
 for case, value in [("alpha", "alpha two words"), ("beta", "beta=distinct")]]
environment_tests(name = "tests")

# An explicit all-incompatible request must not become a passing empty run.
test_suite(name = "conditional_only", tests = [":startup_beta"])
