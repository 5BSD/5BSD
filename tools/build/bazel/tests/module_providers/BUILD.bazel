    "gpiospi": "//sys/modules/gpio/gpiospi:generic_module",
    "gpioths": "//sys/modules/gpio/gpioths:generic_module",
}
_BROADCOM_GPIO_MODULES = dict(_MODULES.items() + _GPIO_MODULES.items())
bsd_host_artifact_test(name = "broadcom_gpio_providers_test", src = "check.py",
    data = _BROADCOM_GPIO_MODULES.values(),
    args = [arg for name, target in _BROADCOM_GPIO_MODULES.items()
            for arg in ["--module", name + "=$(location " + target + ")"]] + [
        "--require-edge", "bhnd", "gpiobus", "gpiobus_add_bus",
