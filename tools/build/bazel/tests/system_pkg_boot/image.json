        "setuid": "off"
      }
    },
    {
      "name": "zroot/usr",
      "properties": {
        "mountpoint": "/usr",
        "canmount": "off"
      }
    },
    {
      "name": "zroot/usr/local",
      "properties": {
        "mountpoint": "/usr/local"
      }
    },
    {
      "name": "zroot/var",
      "properties": {
        "mountpoint": "/var",
        "canmount": "off"
      }
    },
    {
      "name": "zroot/var/log",
      "properties": {
        "mountpoint": "/var/log",
        "exec": "off",
        "setuid": "off"
      }
    },
    {
      "name": "zroot/var/tmp",
      "properties": {
        "mountpoint": "/var/tmp",
