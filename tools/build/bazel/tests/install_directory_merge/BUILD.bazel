load("//tools/build/bazel:bsd_install.bzl", "bsd_install_directory", "bsd_install_file", "bsd_install_manifest")
load(":tests.bzl", "positive_test", "failure_test")
bsd_install_directory(name='original', destination='/debug', owner='root', group='wheel', mode='0755', install_tags=['package=bzip2', 'dbg'])
bsd_install_manifest(name='original_manifest', entries=[':original'])
bsd_install_directory(name='identical', destination='/debug', owner='root', group='wheel', mode='0755', install_tags=['package=bzip2', 'dbg'])
bsd_install_manifest(name='identical_manifest', entries=[':identical'])
bsd_install_directory(name='mode', destination='/debug', owner='root', group='wheel', mode='0700', install_tags=['package=bzip2', 'dbg'])
bsd_install_manifest(name='mode_manifest', entries=[':mode'])
bsd_install_directory(name='owner', destination='/debug', owner='nobody', group='wheel', mode='0755', install_tags=['package=bzip2', 'dbg'])
bsd_install_manifest(name='owner_manifest', entries=[':owner'])
bsd_install_directory(name='group', destination='/debug', owner='root', group='nogroup', mode='0755', install_tags=['package=bzip2', 'dbg'])
bsd_install_manifest(name='group_manifest', entries=[':group'])
bsd_install_directory(name='tags', destination='/debug', owner='root', group='wheel', mode='0755', install_tags=['package=other', 'dbg'])
bsd_install_manifest(name='tags_manifest', entries=[':tags'])
bsd_install_directory(name='flags', destination='/debug', owner='root', group='wheel', mode='0755', install_tags=['package=bzip2', 'dbg'], flags='uchg')
bsd_install_manifest(name='flags_manifest', entries=[':flags'])
bsd_install_manifest(name='merged', manifests=[':original_manifest', ':identical_manifest'], merge_identical_directories=True)
positive_test(name='inherited_test', target_under_test=':merged')
bsd_install_manifest(name='merged_entries', entries=[':original', ':identical'], merge_identical_directories=True)
positive_test(name='entries_test', target_under_test=':merged_entries')
bsd_install_manifest(name='default_duplicate', manifests=[':original_manifest', ':identical_manifest'])
failure_test(name='default_reject_test', target_under_test=':default_duplicate')
bsd_install_manifest(name='conflict_mode', manifests=[':original_manifest', ':mode_manifest'], merge_identical_directories=True)
failure_test(name='mode_reject_test', target_under_test=':conflict_mode')
bsd_install_manifest(name='conflict_owner', manifests=[':original_manifest', ':owner_manifest'], merge_identical_directories=True)
failure_test(name='owner_reject_test', target_under_test=':conflict_owner')
bsd_install_manifest(name='conflict_group', manifests=[':original_manifest', ':group_manifest'], merge_identical_directories=True)
failure_test(name='group_reject_test', target_under_test=':conflict_group')
bsd_install_manifest(name='conflict_tags', manifests=[':original_manifest', ':tags_manifest'], merge_identical_directories=True)
failure_test(name='tags_reject_test', target_under_test=':conflict_tags')
bsd_install_manifest(name='conflict_flags', manifests=[':original_manifest', ':flags_manifest'], merge_identical_directories=True)
failure_test(name='flags_reject_test', target_under_test=':conflict_flags')
bsd_install_file(name='payload', src='tests.bzl', destination='/payload', owner='root', group='wheel', mode='0444', install_tags=['package=bzip2'])
bsd_install_manifest(name='file_one', entries=[':payload'])
bsd_install_manifest(name='file_two', entries=[':payload'])
bsd_install_manifest(name='duplicate_file', manifests=[':file_one', ':file_two'], merge_identical_directories=True)
failure_test(name='payload_reject_test', target_under_test=':duplicate_file')
test_suite(name='tests', tests=[':inherited_test', ':entries_test', ':default_reject_test', ':mode_reject_test', ':owner_reject_test', ':group_reject_test', ':tags_reject_test', ':flags_reject_test', ':payload_reject_test'])
