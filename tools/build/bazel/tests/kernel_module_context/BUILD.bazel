load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_link", "bsd_install_manifest")
load("//tools/build/bazel:bsd_kernel_module_installation.bzl", "bsd_kernel_module_installation", "bsd_kernel_module_set")
load(":tests.bzl", "path_test", "custom_path_test", "inline_debug_test", "collision_test", "fixture_product", "invalid_base_test", "invalid_debug_test", "source_selection_test")

bsd_install_file(name = "module", src = "sample.ko", destination = "/sample.ko",
    destination_prefixes = ["//tools/build/bazel/config:kernel_directory"],
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=oes"])
bsd_install_file(name = "debug", src = "sample.ko.debug", destination = "/sample.ko.debug",
    destination_prefixes = ["//tools/build/bazel/config:kernel_debug_directory", "//tools/build/bazel/config:kernel_directory"],
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=oes", "dbg"])
bsd_install_link(name = "alias", destination = "/alias.ko", target = "sample.ko", kind = "symlink",
    destination_prefixes = ["//tools/build/bazel/config:kernel_directory"],
    owner = "root", group = "wheel", mode = "0755", install_tags = ["package=oes"])
bsd_install_manifest(name = "standalone", entries = [":module", ":debug", ":alias"])
fixture_product(name = "product", binary = "sample.ko", debug = "sample.ko.debug")
fixture_product(name = "duplicate_product", binary = "sample.ko", debug = "sample.ko.debug")
bsd_kernel_module_installation(name = "base", modules = [":product"])
bsd_kernel_module_installation(name = "collision", modules = [":product", ":duplicate_product"])
path_test(name = "standalone_test", target_under_test = ":standalone",
    expected = ["/boot/modules/sample.ko", "/boot/modules/alias.ko", "/usr/lib/debug/boot/modules/sample.ko.debug"])
path_test(name = "base_test", target_under_test = ":base",
    expected = ["/boot/kernel/sample.ko", "/boot/kernel/alias.ko", "/usr/lib/debug/boot/kernel/sample.ko.debug"])
custom_path_test(name = "custom_base_test", target_under_test = ":base",
    expected = ["/boot/custom/sample.ko", "/boot/custom/alias.ko", "/debug/custom/boot/custom/sample.ko.debug"])
custom_path_test(name = "custom_standalone_test", target_under_test = ":standalone",
    expected = ["/third-party/modules/sample.ko", "/third-party/modules/alias.ko", "/debug/custom/third-party/modules/sample.ko.debug"])
inline_debug_test(name = "inline_debug_test", target_under_test = ":base",
    expected = ["/boot/inline/sample.ko", "/boot/inline/alias.ko", "/boot/inline/sample.ko.debug"])
collision_test(name = "collision_test", target_under_test = ":collision")

# Real module producer: no payload copies or metadata rewrites.
bsd_kernel_module_installation(name = "newreno_base", modules = ["//sys/modules/cc/cc_newreno:module_product"])

invalid_base_test(name = "invalid_base_test", target_under_test = ":base")
invalid_debug_test(name = "invalid_debug_test", target_under_test = ":base")

# Nested source traversal preserves the same declared product and rejects repeats.
bsd_kernel_module_set(name = "child_set", modules = [":product"])
bsd_kernel_module_set(name = "parent_set", module_sets = [":child_set"])
bsd_kernel_module_installation(name = "nested", module_sets = [":parent_set"])
path_test(name = "nested_test", target_under_test = ":nested",
    expected = ["/boot/kernel/sample.ko", "/boot/kernel/alias.ko", "/usr/lib/debug/boot/kernel/sample.ko.debug"])
bsd_kernel_module_set(name = "repeated_set", modules = [":product"], module_sets = [":child_set"])
collision_test(name = "repeated_set_test", target_under_test = ":repeated_set",
    expected = "duplicate selected kernel module")
bsd_kernel_module_set(name = "empty_set")
bsd_kernel_module_installation(name = "empty_installation", module_sets = [":empty_set"])
collision_test(name = "empty_installation_test", target_under_test = ":empty_installation",
    expected = "explicit selected kernel module products required")

# Analysis-only source-availability fixtures; these are not runtime ELF evidence.
filegroup(name = "absent_selection_source", srcs = [])
filegroup(name = "present_selection_source", srcs = ["sample.ko"])
bsd_kernel_module_set(name = "source_absent", modules = [":product"], source_availability = ":absent_selection_source")
bsd_kernel_module_set(name = "source_present", modules = [":product"], source_availability = ":present_selection_source")
source_selection_test(name = "source_absent_test", target_under_test = ":source_absent", expected = 0)
source_selection_test(name = "source_present_test", target_under_test = ":source_present", expected = 1)
bsd_kernel_module_set(name = "generated_selection_source", modules = [":product"], source_availability = ":standalone")
collision_test(name = "generated_selection_source_test", target_under_test = ":generated_selection_source", expected = "module selection availability requires source-only files")
