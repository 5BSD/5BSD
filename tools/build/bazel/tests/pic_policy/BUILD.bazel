load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_objects")
load("//tools/build/bazel:bsd_python_test.bzl", "bsd_python_test")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
[cc_library(name = mode + "_objects", srcs = ["pic-policy.c"],
    local_defines = ["EXPECTED_PIC_LEVEL=" + str(level)],
    features = ["bsd_small_pic"] if mode == "small" else [],
    target_compatible_with = _PLATFORM)
 for mode, level in [("default", 2), ("small", 1)]]
[bsd_component_objects(name = mode + "_" + variant, group = ":" + mode + "_objects", pic = pic,
    target_compatible_with = _PLATFORM)
 for mode in ["default", "small"] for variant, pic in [("regular", False), ("pic", True)]]
bsd_python_test(name = "test", src = "pic-policy-test.py",
    data = [":" + mode + "_" + variant for mode in ["default", "small"] for variant in ["regular", "pic"]],
    target_compatible_with = _PLATFORM)
# Negative qualification control: actual compiler must reject this expectation.
cc_library(name = "wrong_objects", srcs = ["pic-policy.c"],
    local_defines = ["EXPECTED_PIC_LEVEL=2"], features = ["bsd_small_pic"],
    target_compatible_with = _PLATFORM, tags = ["manual"])
bsd_component_objects(name = "wrong_pic", group = ":wrong_objects", pic = True,
    target_compatible_with = _PLATFORM, tags = ["manual"])
