def _chunk(option, values):
    if not option:
        return values
    return select({
        "//tools/build/bazel/config:kernel_" + option.lower() + "_enabled": values,
        "//conditions:default": [],
    })


def _selected(rows):
    result = []
    chunk = []
    previous = ""
    for option, value in rows:
        if previous != option and chunk:
            result += _chunk(previous, chunk)
            chunk = []
        chunk.append(value)
        previous = option
    return result + _chunk(previous, chunk)


def amd64_generic_kernel_inputs(name):
    bsd_kernel_inputs(
        name = name,
        objects = _selected(_GROUP_ROWS),
        inventory = _selected(_INPUT_ROWS),
        prefix = ["locore.o"],
        suffix = ["config.o", "env.o", "hints.o", "vnode_if.o", "force-dynamic-hack.pico", "vers.o"],
        manifest = "//sys/amd64/conf:generic_input_manifest",
        kernel_identity = "GENERIC", machine = "amd64", machine_arch = "amd64",
        python = "@bsd_sdk//toolchain:extra_python",
        python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
        runtime = ["@bsd_sdk//toolchain:python_stdlib"],
        visibility = ["//visibility:public"],
    )
