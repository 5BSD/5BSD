# SPDX-License-Identifier: BSD-2-Clause
# Make reference: cddl/usr.sbin/bsdinstruments/Makefile (PROG, WARNS 3).
# libdtrace and its dependency closure are linked from the staged SDK by name,
# exactly like Make's LIBADD; their headers come from declared source trees.
load("//toolchain:bsd_component.bzl", "bsd_program")

package(default_visibility = ["//visibility:public"])

# Keep in the order of Makefile SRCS.
BSDINSTRUMENTS_SRCS = [
    "main.c",
    "filter.c",
    "profile.c",
    "probes.c",
    "watch.c",
]

BSDINSTRUMENTS_PRIVATE_HDRS = ["bsdinstruments.h"]

bsd_program(
    name = "bsdinstruments",
    srcs = BSDINSTRUMENTS_SRCS + BSDINSTRUMENTS_PRIVATE_HDRS,
    warns = 3,
    local_cflags = [
        "-DIN_BASE",
        "-DSKIP_SPL_SYS_CONDVAR_H",
        "-DHAVE_ISSETUGID",
        # cddl/usr.sbin/Makefile.inc
        "-DNEED_SOLARIS_BOOLEAN",
        "-DHAVE_STRLCAT",
        "-DHAVE_STRLCPY",
    ],
    deps = [
        "//:dtrace_userland_headers",
        "//lib/libotelexport:headers",
        "//cddl/lib/libdtotel:headers",
        "//:libtracecmp_headers",
        "//cddl/lib/libdtotel:dtotel_pie",
        "//lib/libotelexport:otelexport_pie",
    ],
    # LIBADD dtotel tracecmp dtrace ctf elf proc spl xo pthread otelexport
    # jail m
    linkopts = ["-ltracecmp", "-ldtrace", "-lctf", "-lelf", "-lproc", "-lspl",
                "-lxo", "-lm", "-lpthread", "-ljail"],
)

# The unit test (tests/Makefile) compiles profile.c and filter.c again.
exports_files(["profile.c", "filter.c"])

cc_library(
    name = "headers",
    testonly = True,
    hdrs = BSDINSTRUMENTS_PRIVATE_HDRS,
    includes = ["."],
)
