load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = "ps", srcs = ["fmt.c", "keyword.c", "nlist.c", "print.c", "ps.c", "ps.h", "extern.h"], deps = ["//lib/msun:m", "//lib/libkvm:kvm", "//lib/libjail:jail", "//lib/libxo/libxo:xo"], dynamic_deps = ["//lib/msun:m_shared", "//lib/libkvm:kvm_shared", "//lib/libjail:jail_shared", "//lib/libxo/libxo:xo_shared"], local_defines = select({"//tools/build/bazel/config:ps_check_keywords_enabled": ["PS_CHECK_KEYWORDS"], "//conditions:default": []}), copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "ps", manual = "ps.1", package = "runtime", bindir = "/bin")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive", visibility = ["//bin:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=runtime","dbg"]}' for d in ["/usr/lib/debug/bin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

exports_files(["fmt.c", "ps.h", "extern.h"], visibility = ["//usr.bin/w:__pkg__"])

load("//tools/build/bazel:bsd_rescue_application.bzl", "rescue_application")
rescue_application(srcs = ['fmt.c', 'keyword.c', 'nlist.c', 'print.c', 'ps.c', 'ps.h', 'extern.h'],
    object_names = ['fmt.o', 'keyword.o', 'nlist.o', 'print.o', 'ps.o'], deps = ['//lib/libjail:headers', '//lib/libkvm:headers', '//contrib/libxo:headers'], defines = select({'//tools/build/bazel/config:ps_check_keywords_enabled': ['PS_CHECK_KEYWORDS'], '//conditions:default': []}))
