load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
exports_files(["functional_test.sh"], visibility = ["//bin/sh/tests:__subpackages__"])
_GROUPS = ['builtins', 'errors', 'execution', 'expansion', 'invocation', 'parameters', 'parser', 'set-e']
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = [], interfaces = {}, subdirectories = _GROUPS)
bsd_install_file(name = "root_kyuafile", src = ":kyuafile", destination = "/usr/tests/bin/sh/Kyuafile",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=tests"])
bsd_install_manifest(name = "install_manifest", entries = [":root_kyuafile"])
_DIRS = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests"]}' for d in ["/usr/tests/bin/sh"] + ["/usr/tests/bin/sh/" + g for g in _GROUPS]}
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"] + ["//bin/sh/tests/" + g + ":install_manifest" for g in _GROUPS], directories = _DIRS,
        mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib", "//etc/mtree:BSD.tests.dist": "/usr/tests"},
        passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
        python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
        runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])

test_suite(name = "tests", tests = ["//bin/sh/tests/" + g + ":tests" for g in _GROUPS], visibility = ["//visibility:public"])
