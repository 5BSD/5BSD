load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
CASES = ['invalid_usage', 'no_arguments', 'relative_path', 'absolute_path', 'dotdot_path', 'recursive', 'mixed_paths', 'symlink_no_h', 'symlink_rootlevel_H', 'symlink_rootlevel_H_dead', 'outside_symlink_rejected', 'outside_symlink_unsafe']
[bsd_atf_test(
    name = "native_" + case,
    case_name = case,
    body = "chflags_test.sh",
    subr = "//libexec/atf/atf-sh:shell_library",
    runtime_bin = ['//bin/sh:sh', '//libexec/atf/atf-sh:atf-sh', '//libexec/atf/atf-check:atf-check', '//bin/chflags:chflags', '//usr.bin/stat:stat', '//usr.bin/touch:touch', '//bin/rm:rm', '//bin/mkdir:mkdir', '//bin/ln:ln', '//usr.bin/dirname:dirname', '//usr.bin/basename:basename', '//bin/cat:cat', '//usr.bin/grep:grep', '//usr.bin/sed:sed'],
    runtime_lib = ["//lib/atf/libatf-c:atf_c_shared", "//lib/atf/libatf-c++:atf_cxx_shared", "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared", "//lib/libedit:edit_shared", "//lib/ncurses/tinfo:tinfo_shared", "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7", "@bsd_sdk//toolchain:sysroot/lib/libgcc_s.so.1", "//lib/libutil:util_shared", "//lib/libkvm:kvm_shared", "//lib/libelf:elf_shared", "//lib/libjail:jail_shared", "//lib/libregex:regex_shared", "//lib/libmd:md_shared", "//lib/libxo/libxo:xo_shared", "//lib/libnv:nv_shared", "//lib/libcasper/libcasper:casper_shared", "//lib/libcasper/services/cap_fileargs:cap_fileargs_shared"],
    runner = "//tools/build/bazel:atf_runner",
    size = "small",
) for case in CASES]
test_suite(name = "tests", tests = [":native_" + case for case in CASES], visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_script_wrapper")
bsd_script_wrapper(name = "chflags_test", body = "chflags_test.sh", interpreter = "/usr/libexec/atf-sh", cat = "@bsd_sdk//toolchain:cat", cat_runtime = ["@bsd_sdk//toolchain:cat_runtime"], redirect = "@bsd_sdk//toolchain:stdout_redirect")
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["chflags_test"], interfaces = {"chflags_test": "atf"}, metadata = {})
bsd_install_file(name = "test_file", src = ":chflags_test", destination = "/usr/tests/bin/chflags/chflags_test", owner = "root", group = "wheel", mode = "0555", install_tags = ["package=tests"])
bsd_install_file(name = "kyuafile_file", src = ":kyuafile", destination = "/usr/tests/bin/chflags/Kyuafile", owner = "root", group = "wheel", mode = "0444", install_tags = ["package=tests"])
bsd_install_manifest(name = "install_manifest", entries = [":test_file", ":kyuafile_file"], visibility = ["//bin:__subpackages__"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//bin:__subpackages__"],
    manifests = [":install_manifest"],
    directories = {"/usr/tests/bin/chflags": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests"]}'},
    mtree_specs = {
        "//etc/mtree:BSD.tests.dist": "/usr/tests",
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
