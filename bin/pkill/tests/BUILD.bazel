load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_kyuafile")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
cc_binary(name = "spin_helper", srcs = ["spin_helper.c"], copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
PROGRAMS = ['pgrep-_f_test', 'pgrep-_g_test', 'pgrep-_lf_test', 'pgrep-_p_test', 'pgrep-_s_test', 'pgrep-_u_test', 'pgrep-f_test', 'pgrep-g_test', 'pgrep-i_test', 'pgrep-j_test', 'pgrep-l_test', 'pgrep-n_test', 'pgrep-o_test', 'pgrep-q_test', 'pgrep-s_test', 'pgrep-t_test', 'pgrep-v_test', 'pgrep-x_test', 'pkill-_f_test', 'pkill-_g_test', 'pkill-_lf_test', 'pkill-_p_test', 'pkill-_u_test', 'pkill-g_test', 'pkill-i_test', 'pkill-j_test', 'pkill-s_test', 'pkill-t_test', 'pkill-x_test']
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = PROGRAMS,
    interfaces = {name: "tap" for name in PROGRAMS},
    metadata = {name: '{"required_user":"root","required_programs":"jail jls"}' for name in ["pgrep-j_test", "pkill-j_test"]})
[bsd_install_file(name = "install_" + name, src = name + ".sh",
    destination = "/usr/tests/bin/pkill/" + name, owner = "root", group = "wheel",
    mode = "0555", install_tags = ["package=tests"]) for name in PROGRAMS]
bsd_install_file(name = "install_kyuafile", src = ":kyuafile",
    destination = "/usr/tests/bin/pkill/Kyuafile", owner = "root", group = "wheel",
    mode = "0444", install_tags = ["package=tests"])
utility_installation(name = "install_manifest", program = "spin_helper", manual = None,
    package = "tests", bindir = "/usr/tests/bin/pkill",
    extra_entries = [":install_" + name for name in PROGRAMS] + [":install_kyuafile"])
