# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = 'truss', srcs = ['main.c', 'setup.c', 'syscall_filter.c', 'syscalls.c', 'extern.h', 'syscall.h', 'truss.h'], deps = ['//sys/bsm:truss_headers', '//sys/netinet:truss_headers', '//sys/netinet6:truss_headers', '//sys/netlink:truss_headers', '//sys/sys:truss_headers', '//lib/libsysdecode:sysdecode'], dynamic_deps = ["//lib/libsysdecode:sysdecode_shared"], copts = ["-fPIE"], linkopts = ["-pie"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = 'truss', manual = 'truss.1', package = 'utilities', bindir = "/usr/bin", man_section = '1')
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//usr.bin:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/bin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive_set")
bsd_install_archive_set(name = "installation_archives", archives = [":install_archive"] + select({"//tools/build/bazel/config:tests_enabled": ["//usr.bin/truss/tests:install_archive"], "//conditions:default": []}), visibility = ["//usr.bin:__pkg__"])
