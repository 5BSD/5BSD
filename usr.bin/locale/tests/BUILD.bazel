load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_script_wrapper")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
bsd_script_wrapper(name = "locale_test", body = "locale_test.sh",
    interpreter = "/usr/libexec/atf-sh", cat = "@bsd_sdk//toolchain:cat",
    cat_runtime = ["@bsd_sdk//toolchain:cat_runtime"], redirect = "@bsd_sdk//toolchain:stdout_redirect")
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["locale_test"], interfaces = {"locale_test": "atf"})
bsd_install_file(name = "install_shell", src = ":locale_test",
    destination = "/usr/tests/usr.bin/locale/locale_test", owner = "root", group = "wheel",
    mode = "0555", install_tags = ["package=tests"])
bsd_install_file(name = "install_kyuafile", src = ":kyuafile",
    destination = "/usr/tests/usr.bin/locale/Kyuafile", owner = "root", group = "wheel",
    mode = "0444", install_tags = ["package=tests"])
bsd_install_manifest(name = "install_manifest", entries = [":install_shell", ":install_kyuafile"] + [":install_" + f for f in ['k_flag_posix_monetary.out', 'k_flag_posix_numeric.out', 'k_flag_posix_time.out', 'k_flag_posix_messages.out', 'no_flags_posix_monetary.out', 'no_flags_posix_numeric.out', 'no_flags_posix_time.out', 'no_flags_posix_messages.out']], visibility = ["//visibility:public"])

[bsd_install_file(name = "install_" + f, src = f,
    destination = "/usr/tests/usr.bin/locale/" + f, owner = "root", group = "wheel",
    mode = "0444", install_tags = ["package=tests"]) for f in ['k_flag_posix_monetary.out', 'k_flag_posix_numeric.out', 'k_flag_posix_time.out', 'k_flag_posix_messages.out', 'no_flags_posix_monetary.out', 'no_flags_posix_numeric.out', 'no_flags_posix_time.out', 'no_flags_posix_messages.out']]

# Explicit native cases mirror the maintained POSIX keyword checks; the original
# ATF script and fixtures remain the installed suite.
load("//tools/build/bazel:bsd_compare_test.bzl", "bsd_compare_test")
_KEYWORD_CASES = [('k_flag_posix_monetary', ['-k', 'int_curr_symbol', 'currency_symbol', 'mon_decimal_point', 'mon_thousands_sep', 'mon_grouping', 'positive_sign', 'negative_sign', 'int_frac_digits', 'frac_digits', 'p_cs_precedes', 'p_sep_by_space', 'n_cs_precedes', 'n_sep_by_space', 'p_sign_posn', 'n_sign_posn', 'int_p_cs_precedes', 'int_n_cs_precedes', 'int_p_sep_by_space', 'int_n_sep_by_space', 'int_p_sign_posn', 'int_n_sign_posn']), ('k_flag_posix_numeric', ['-k', 'decimal_point', 'thousands_sep', 'grouping']), ('k_flag_posix_time', ['-k', 'abday', 'day', 'abmon', 'mon', 'd_t_fmt', 'd_fmt', 't_fmt', 'am_pm', 't_fmt_ampm', 'era', 'era_d_fmt', 'era_t_fmt', 'era_d_t_fmt', 'alt_digits']), ('k_flag_posix_messages', ['-k', 'yesexpr', 'noexpr']), ('no_flags_posix_monetary', ['int_curr_symbol', 'currency_symbol', 'mon_decimal_point', 'mon_thousands_sep', 'mon_grouping', 'positive_sign', 'negative_sign', 'int_frac_digits', 'frac_digits', 'p_cs_precedes', 'p_sep_by_space', 'n_cs_precedes', 'n_sep_by_space', 'p_sign_posn', 'n_sign_posn', 'int_p_cs_precedes', 'int_n_cs_precedes', 'int_p_sep_by_space', 'int_n_sep_by_space', 'int_p_sign_posn', 'int_n_sign_posn']), ('no_flags_posix_numeric', ['decimal_point', 'thousands_sep', 'grouping']), ('no_flags_posix_time', ['abday', 'day', 'abmon', 'mon', 'd_t_fmt', 'd_fmt', 't_fmt', 'am_pm', 't_fmt_ampm', 'era', 'era_d_fmt', 'era_t_fmt', 'era_d_t_fmt', 'alt_digits']), ('no_flags_posix_messages', ['yesexpr', 'noexpr'])]
[bsd_compare_test(name = name, program = "//usr.bin/locale:locale", expected = name + ".out", expected_stderr = "empty.out",
    arguments = args, runner = "//tools/build/bazel:byte_compare_runner", size = "small",
    runtime_lib = ["//lib/libsbuf:sbuf_shared", "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"])
 for name, args in _KEYWORD_CASES]
bsd_compare_test(name = "unknown_keyword", program = "//usr.bin/locale:locale", expected = "empty.out", expected_exit = 1,
    arguments = ["-k", "nonexistent"], runner = "//tools/build/bazel:byte_compare_runner", size = "small",
    runtime_lib = ["//lib/libsbuf:sbuf_shared", "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"])
test_suite(name = "tests", tests = [":" + name for name, _ in _KEYWORD_CASES] + [":unknown_keyword"], visibility = ["//visibility:public"])
