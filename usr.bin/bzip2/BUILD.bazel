load("//tools/build/bazel:bsd_base_install.bzl", "bsd_program_install")
load("//tools/build/bazel:bsd_install.bzl", "bsd_compress", "bsd_install_file", "bsd_install_link", "bsd_install_directory")
load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_debug_split", "bsd_strip_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_fixture.bzl", "bsd_uu_fixture")
load("//tools/build/bazel:bsd_compare_test.bzl", "bsd_compare_test")

cc_binary(
    name = "bzip2",
    srcs = ["//contrib/bzip2:bzip2.c"],
    copts = ["-fpie", '-pipe', '-fno-common', '-std=gnu17', '-Wno-format-zero-length', '-Wsystem-headers', '-Werror', '-Wall', '-Wno-format-y2k', '-W', '-Wno-unused-parameter', '-Wstrict-prototypes', '-Wmissing-prototypes', '-Wpointer-arith', '-Wno-uninitialized', '-Wno-pointer-sign', '-Wdate-time', '-Wno-empty-body', '-Wno-string-plus-int', '-Wno-unused-const-variable', '-Wno-error=unused-but-set-parameter', '-Wno-error=cast-function-type-mismatch', '-Wno-tautological-compare', '-Wno-unused-value', '-Wno-parentheses-equality', '-Wno-unused-function', '-Wno-enum-conversion', '-Wno-unused-local-typedef', '-Wno-address-of-packed-member', '-Qunused-arguments', '-fPIE'],
    local_defines = ["PIC", "_FILE_OFFSET_BITS=64"],
    linkopts = ["-pie", "-fstack-protector-strong", "-gz=zlib"],
    deps = ["//lib/libbz2:bz2"],
    dynamic_deps = ["//lib/libbz2:bz2_shared"],
    linkstatic = False,
    visibility = ["//visibility:public"],
)

bsd_uu_fixture(
    name = "sample1_ref",
    src = "//contrib/bzip2:sample1.ref.gz.uu",
    output = "sample1.ref",
    gzip = True,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib"],
)

bsd_uu_fixture(
    name = "sample1_bz2",
    src = "//contrib/bzip2:sample1.bz2.uu",
    output = "sample1.bz2",
    gzip = False,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib"],
)

bsd_compare_test(
    name = "sample1_compress_test",
    program = ":bzip2",
    input = ":sample1_ref",
    expected = ":sample1_bz2",
    arguments = ["-1"],
    runner = "//tools/build/bazel:byte_compare_runner",
    runtime_lib = ["//lib/libbz2:bz2_shared"],
    size = "small",
)

bsd_compare_test(
    name = "sample1_decompress_test",
    program = ":bzip2",
    input = ":sample1_bz2",
    expected = ":sample1_ref",
    arguments = ["-d"],
    runner = "//tools/build/bazel:byte_compare_runner",
    runtime_lib = ["//lib/libbz2:bz2_shared"],
    size = "small",
)

