bsd_debug_split(
    name = "bzip2_debug",
    src = ":bzip2",
    binary_name = "install/bzip2",
    debug_name = "install/bzip2.debug",
    objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    objcopy_inputs = "@bsd_sdk//toolchain:objcopy_inputs",
    visibility = ["//visibility:public"],
)

bsd_strip_binary(
    name = "bzip2_install",
    src = ":bzip2_debug",
    output = "stripped/bzip2",
    strip = "@bsd_sdk//toolchain:bin/llvm-strip",
    strip_inputs = "@bsd_sdk//toolchain:strip_inputs",
    visibility = ["//visibility:public"],
)

bsd_compress(
    name = "manual_gzip",
    src = "//contrib/bzip2:bzip2.1",
    output = "bzip2.1.gz",
    arguments = ["-cn"],
    compressor = "@bsd_sdk//toolchain:extra_gzip",
    redirect = "@bsd_sdk//toolchain:stdout_redirect",
    runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"],
)

bsd_install_file(
    name = "manual_entry",
    src = ":manual_gzip",
    destination = "/usr/share/man/man1/bzip2.1.gz",
    owner = "root",
    group = "wheel",
    mode = "0444",
    install_tags = select({
        "//tools/build/bazel/config:split_manpages_enabled": ["package=bzip2-man"],
        "//conditions:default": ["package=bzip2"],
    }),
)

bsd_install_link(
    name = "bunzip2_entry",
    destination = "/usr/bin/bunzip2",
    target = "/usr/bin/bzip2",
    kind = "hardlink",
    owner = "root",
    group = "wheel",
    mode = "0555",
    install_tags = ["package=bzip2"],
)

bsd_install_link(
    name = "bzcat_entry",
    destination = "/usr/bin/bzcat",
    target = "/usr/bin/bzip2",
    kind = "hardlink",
    owner = "root",
    group = "wheel",
    mode = "0555",
    install_tags = ["package=bzip2"],
)

bsd_install_link(
    name = "bunzip2_manual_entry",
    destination = "/usr/share/man/man1/bunzip2.1.gz",
    target = "/usr/share/man/man1/bzip2.1.gz",
    kind = "hardlink",
    owner = "root",
    group = "wheel",
    mode = "0444",
    install_tags = select({
        "//tools/build/bazel/config:split_manpages_enabled": ["package=bzip2-man"],
        "//conditions:default": ["package=bzip2"],
    }),
)

bsd_install_link(
    name = "bzcat_manual_entry",
    destination = "/usr/share/man/man1/bzcat.1.gz",
    target = "/usr/share/man/man1/bzip2.1.gz",
    kind = "hardlink",
    owner = "root",
    group = "wheel",
    mode = "0444",
    install_tags = select({
        "//tools/build/bazel/config:split_manpages_enabled": ["package=bzip2-man"],
        "//conditions:default": ["package=bzip2"],
    }),
)

bsd_install_link(
    name = "bzip2recover_manual_entry",
    destination = "/usr/share/man/man1/bzip2recover.1.gz",
    target = "/usr/share/man/man1/bzip2.1.gz",
    kind = "hardlink",
    owner = "root",
    group = "wheel",
    mode = "0444",
    install_tags = select({
        "//tools/build/bazel/config:split_manpages_enabled": ["package=bzip2-man"],
        "//conditions:default": ["package=bzip2"],
    }),
)

# Original bsd.prog.mk debug directory ownership is part of this component.
bsd_install_directory(name = "debug_usr_dir", destination = "/usr/lib/debug/usr",
    owner = "root", group = "wheel", mode = "0755", install_tags = ["package=bzip2", "dbg"])
bsd_install_directory(name = "debug_bin_dir", destination = "/usr/lib/debug/usr/bin",
    owner = "root", group = "wheel", mode = "0755", install_tags = ["package=bzip2", "dbg"])
bsd_program_install(
    name = "install_manifest",
    binary = ":bzip2_install",
    debug = ":bzip2_debug",
    destination = "/usr/bin/bzip2",
    package = "bzip2",
    extra_entries = [':debug_usr_dir', ':debug_bin_dir', ':manual_entry', ':bunzip2_entry', ':bzcat_entry', ':bunzip2_manual_entry', ':bzcat_manual_entry', ':bzip2recover_manual_entry'],
    visibility = ["//visibility:public"],
)

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "install_archive_bundle", manifests = [":install_manifest"],
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr",
                   "//etc/mtree:BSD.include.dist": "/usr/include", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
    visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive_set")
# These two components preserve their own explicit debug-directory contexts.
bsd_install_archive_set(name = "library_program_install_archives",
    archives = ["//lib/libbz2:install_archive_bundle", ":install_archive_bundle"],
    visibility = ["//visibility:public"])
