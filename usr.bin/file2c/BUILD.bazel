bsd_compare_test(name = "regress_6_test", program = ":file2c", input = ":input_6",
    arguments = ['-n', '1', 'P', 'S'], expected = "tests/regress.6.out", expected_stderr = "tests/empty.out",
    runtime_lib = _RUNTIME, runner = "//tools/build/bazel:byte_compare_runner", size = "small")
bsd_filter_fixture(name = "input_7", src = "tests/regress.in", output = "fixture-7.in",
