bsd_compare_test(name = "regress_9_test", program = ":file2c", input = "tests/regress.in",
    arguments = ['const char data[] = {', ', 0};'], expected = "tests/regress.9.out", expected_stderr = "tests/empty.out",
    runtime_lib = _RUNTIME, runner = "//tools/build/bazel:byte_compare_runner", size = "small")
test_suite(name = "tests", tests = [':regress_1_test', ':regress_2_test', ':regress_3_test', ':regress_4_test', ':regress_5_test', ':regress_6_test', ':regress_7_test', ':regress_8_test', ':regress_9_test'], visibility = ["//visibility:public"])
