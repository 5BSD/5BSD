    arguments = ['PREFIX', 'SUFFIX'], expected = "tests/regress.3.out", expected_stderr = "tests/empty.out",
    runtime_lib = _RUNTIME, runner = "//tools/build/bazel:byte_compare_runner", size = "small")
bsd_filter_fixture(name = "input_4", src = "tests/regress.in", output = "fixture-4.in",
