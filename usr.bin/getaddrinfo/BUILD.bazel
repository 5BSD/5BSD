load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools/build/bazel:bsd_awk_output.bzl", "bsd_awk_output")
label_flag(name = "socket_header", build_setting_default = "//sys/sys:socket.h", visibility = ["//visibility:public"])
bsd_awk_output(name = "tables", script = "tables.awk", srcs = [":socket_header"],
    output = "tables.h", awk = "//usr.bin/awk:awk",
    redirect = "@bsd_sdk//toolchain:stdout_redirect")
cc_library(name = "tables_header", hdrs = [":tables"], strip_include_prefix = ".")
cc_binary(name = "getaddrinfo", srcs = ["getaddrinfo.c"],
    deps = [":tables_header", "//lib/libnetbsd:netbsd_pie", "//lib/libutil:util"],
    dynamic_deps = ["//lib/libutil:util_shared"],
    copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "getaddrinfo", manual = "getaddrinfo.1", package = "utilities")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive", visibility = ["//usr.bin:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/bin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

load("//tools/build/bazel:bsd_compare_test.bzl", "bsd_compare_test")
[bsd_compare_test(name = name, program = ":getaddrinfo", expected = name + ".out",
    arguments = ["-n", "-N", "-f", family, "-p", protocol, "-t", kind, "-s", port, address],
    runner = "//tools/build/bazel:byte_compare_runner",
    runtime_lib = ["//lib/libutil:util_shared", "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"], size = "small")
 for name, family, protocol, kind, port, address in [
    ("numeric_ipv4", "inet", "6", "stream", "443", "192.0.2.1"),
    ("numeric_ipv6", "inet6", "17", "dgram", "53", "2001:db8::1")]]
test_suite(name = "numeric_tests", tests = [":numeric_ipv4", ":numeric_ipv6"], visibility = ["//visibility:public"])
