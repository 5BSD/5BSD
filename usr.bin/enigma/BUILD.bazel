# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = "enigma", srcs = ["enigma.c"], deps = ["//lib/libcrypt:crypt"], dynamic_deps = ["//lib/libcrypt:crypt_shared"], copts = ["-fPIE"], linkopts = ["-pie"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "enigma", manual = "enigma.1", package = "utilities", bindir = "/usr/bin", man_section = "1", aliases = ["crypt"])

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/bin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)





# Legacy ciphertext fixtures are captured from the independent maintained Make
# reference. Decoding must recover the declared plaintext exactly.
load("//tools/build/bazel:bsd_compare_test.bzl", "bsd_compare_test")
_RUNTIME = ["//lib/libcrypt:crypt_shared", "//lib/libmd:md_shared", "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"]
bsd_compare_test(name = "normal_encode_test", program = ":enigma", input = "bazel-fixtures/plain", expected = "bazel-fixtures/normal",
    arguments = ['testkey'], environment = {"CrYpTkEy": "testkey"}, expected_stderr = "bazel-fixtures/empty",
    runtime_lib = _RUNTIME, runner = "//tools/build/bazel:byte_compare_runner", size = "small")
bsd_compare_test(name = "normal_decode_test", program = ":enigma", input = "bazel-fixtures/normal", expected = "bazel-fixtures/plain",
    arguments = ['testkey'], environment = {"CrYpTkEy": "testkey"}, expected_stderr = "bazel-fixtures/empty",
    runtime_lib = _RUNTIME, runner = "//tools/build/bazel:byte_compare_runner", size = "small")
bsd_compare_test(name = "shuffle_encode_test", program = ":enigma", input = "bazel-fixtures/plain", expected = "bazel-fixtures/shuffle",
    arguments = ['-s', 'testkey'], environment = {"CrYpTkEy": "testkey"}, expected_stderr = "bazel-fixtures/empty",
    runtime_lib = _RUNTIME, runner = "//tools/build/bazel:byte_compare_runner", size = "small")
bsd_compare_test(name = "shuffle_decode_test", program = ":enigma", input = "bazel-fixtures/shuffle", expected = "bazel-fixtures/plain",
    arguments = ['-s', 'testkey'], environment = {"CrYpTkEy": "testkey"}, expected_stderr = "bazel-fixtures/empty",
    runtime_lib = _RUNTIME, runner = "//tools/build/bazel:byte_compare_runner", size = "small")
bsd_compare_test(name = "environment_encode_test", program = ":enigma", input = "bazel-fixtures/plain", expected = "bazel-fixtures/normal",
    arguments = ['-k'], environment = {"CrYpTkEy": "testkey"}, expected_stderr = "bazel-fixtures/empty",
    runtime_lib = _RUNTIME, runner = "//tools/build/bazel:byte_compare_runner", size = "small")
bsd_compare_test(name = "environment_decode_test", program = ":enigma", input = "bazel-fixtures/normal", expected = "bazel-fixtures/plain",
    arguments = ['-k'], environment = {"CrYpTkEy": "testkey"}, expected_stderr = "bazel-fixtures/empty",
    runtime_lib = _RUNTIME, runner = "//tools/build/bazel:byte_compare_runner", size = "small")
test_suite(name = "tests", tests = [':normal_encode_test', ':normal_decode_test', ':shuffle_encode_test', ':shuffle_decode_test', ':environment_encode_test', ':environment_decode_test'], visibility = ["//visibility:public"])
