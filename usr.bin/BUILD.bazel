# Separate production packaging from the installed test-suite contribution.
# This target makes no assertion that Make's selected test hierarchy is complete.
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"] + select({
    ":heimdal": ["@platforms//:incompatible"], "//conditions:default": [],
})
bsd_install_archive_set(name = "production_installation_archives", archives = _ARCHIVES,
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
# Until every selected test subdirectory/fixture/support file is reconciled,
# reject full tests-enabled installation instead of shipping sampled tests.
bsd_install_archive_set(name = "installation_archives", archives = _ARCHIVES,
    target_compatible_with = _PLATFORM + select({
        "//tools/build/bazel/config:tests_enabled": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }), visibility = ["//visibility:public"])
