load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(
    name = "xz", srcs = ['//contrib/xz:src/xz/args.c', '//contrib/xz:src/xz/coder.c', '//contrib/xz:src/xz/file_io.c', '//contrib/xz:src/xz/hardware.c', '//contrib/xz:src/xz/list.c', '//contrib/xz:src/xz/main.c', '//contrib/xz:src/xz/message.c', '//contrib/xz:src/xz/mytime.c', '//contrib/xz:src/xz/options.c', '//contrib/xz:src/xz/sandbox.c', '//contrib/xz:src/xz/signals.c', '//contrib/xz:src/xz/suffix.c', '//contrib/xz:src/xz/util.c', '//contrib/xz:src/common/tuklib_open_stdxxx.c', '//contrib/xz:src/common/tuklib_progname.c', '//contrib/xz:src/common/tuklib_exit.c', '//contrib/xz:src/common/tuklib_cpucores.c', '//contrib/xz:src/common/tuklib_mbstr_width.c', '//contrib/xz:src/common/tuklib_mbstr_fw.c', '//contrib/xz:src/common/tuklib_mbstr_nonprint.c', '//contrib/xz:src/common/tuklib_mbstr_wrap.c'],
    deps = ["//lib/liblzma:lzma", "//lib/liblzma:configuration", "//contrib/xz:internal_headers"],
    dynamic_deps = ["//lib/liblzma:lzma_shared"],
    local_defines = ["HAVE_CONFIG_H"], copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
)

load("//tools/build/bazel:bsd_command_install.bzl", "bsd_command_installation")
bsd_command_installation(name = "install_manifest", package = "xz", program = "xz", manual = "//contrib/xz:src/xz/xz.1",
    aliases = ['unxz', 'lzma', 'unlzma', 'xzcat', 'lzcat'], manual_aliases = ['unxz', 'lzma', 'unlzma', 'xzcat', 'lzcat'])

filegroup(name = "package_abi", srcs = [":stripped"], visibility = ["//packages/xz:__pkg__"])
