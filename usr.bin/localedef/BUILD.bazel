load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools/build/bazel:bsd_lex_yacc.bzl", "bsd_yacc")
bsd_yacc(name = "parser", src = "parser.y", output = "parser.c", header = "parser.h", yacc = "//usr.bin/yacc:yacc")
filegroup(name = "parser_source", srcs = [":parser"], output_group = "source")
filegroup(name = "parser_header", srcs = [":parser"], output_group = "header")
cc_library(name = "headers", hdrs = ["localedef.h", ":parser_header"], strip_include_prefix = ".")
cc_binary(
    name = "localedef",
    srcs = ["charmap.c", "collate.c", "ctype.c", "localedef.c", "messages.c", "monetary.c", "numeric.c", "scanner.c", "time.c", "wide.c", ":parser_source"],
    deps = [":headers", "//lib/libc/locale:localedef_headers", "//lib/libc/stdtime:localedef_headers"],
    copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
)
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "localedef", manual = "localedef.1", package = "utilities")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive", visibility = ["//usr.bin:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/bin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
