# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = "calendar", srcs = ["calendar.c", "locale.c", "events.c", "dates.c", "parsedata.c", "io.c", "day.c", "ostern.c", "paskha.c", "pom.c", "sunpos.c", "calendar.h", "pathnames.h"],
    deps = ["//lib/msun:m", "//lib/libutil:util", "//lib/libutil:headers"],
    dynamic_deps = ["//lib/msun:m_shared", "//lib/libutil:util_shared"],
    local_defines = select({"//tools/build/bazel/config:iconv_enabled": ["WITH_ICONV"], "//conditions:default": []}), copts = ["-fPIE"], linkopts = ["-pie"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "calendar", manual = "calendar.1", package = "utilities", bindir = "/usr/bin", man_section = "1", extra_entries = [":calendar_data"])

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {
        '/usr/share/calendar': '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities"]}',
        '/usr/lib/debug/usr': '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}',
        '/usr/lib/debug/usr/bin': '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}',
    },
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)




load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file")
bsd_install_file(name = "calendar_data", src = "calendars/calendar.freebsd", destination = "/usr/share/calendar/calendar.freebsd",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=utilities"])
