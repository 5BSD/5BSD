load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = 'rfcomm_sppd', srcs = ['rfcomm_sppd.c', 'rfcomm_sdp.c'], deps = ['//lib/libbluetooth:bluetooth', '//lib/libsdp:sdp', '//lib/libutil:util'], dynamic_deps = ['//lib/libbluetooth:bluetooth_shared', '//lib/libsdp:sdp_shared', '//lib/libutil:util_shared'], copts = ["-fPIE"], linkopts = ["-pie"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = 'rfcomm_sppd', manual = 'rfcomm_sppd.1', package = 'bluetooth', bindir = "/usr/bin", man_section = '1')
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//usr.bin/bluetooth:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bluetooth","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/bin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

exports_files(["rfcomm_sdp.c"], visibility = ["//usr.sbin/bluetooth/rfcomm_pppd:__pkg__"])
