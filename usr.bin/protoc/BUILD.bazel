# protoc (usr.bin/protoc/Makefile): PROG_CXX installed as /usr/libexec/protoc
# (lib/protobuf/protobuf.dirs.mk), LIBADD protoc protobuf absl.
#
# protoc_tool is the static build-tool variant, the native counterpart of
# buildworld's bootstrap protoc (Makefile.inc1); ":bootstrap" builds it
# without DTrace instrumentation of its own dependencies, so code generation
# (//tools/build/bazel:bsd_protobuf.bzl) never depends on the DTrace tool.
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
load("//tools/build/bazel:bsd_dtrace_bootstrap.bzl", "bsd_dtrace_bootstrap")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
_HEADERS = ["//contrib/protobuf:src_headers", "//contrib/abseil-cpp:headers", "//contrib/llvm-project/libcxx/include:headers"]
cc_binary(name = "protoc", srcs = ["main.cc"],
    deps = _HEADERS + ["//lib/protobuf/libprotoc:protoc_pie", "//lib/protobuf/libprotobuf:protobuf", "//lib/libabsl:absl",
        "//lib/libc++:cxx", "//lib/libcxxrt:cxxrt", "//lib/msun:m"],
    dynamic_deps = ["//lib/protobuf/libprotobuf:protobuf_shared", "//lib/libabsl:absl_shared",
        "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared"],
    copts = ["-std=c++17", "-nostdinc++", "-fPIE"], linkopts = ["-pie"], linkstatic = True,
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_binary(name = "protoc_tool", srcs = ["main.cc"],
    deps = _HEADERS + ["//lib/protobuf/libprotoc:protoc", "//lib/protobuf/libprotobuf:protobuf", "//lib/libabsl:absl"],
    copts = ["-std=c++17", "-nostdinc++"], linkopts = ["-static"], linkstatic = True,
    target_compatible_with = _PLATFORM)
bsd_dtrace_bootstrap(name = "bootstrap", binary = ":protoc_tool", visibility = ["//visibility:public"])
utility_installation(name = "install_manifest", program = "protoc", manual = "protoc.1", package = "protobuf", bindir = "/usr/libexec")
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=protobuf","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/libexec"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
    visibility = ["//visibility:public"],
)
