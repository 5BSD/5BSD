load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_import")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
_CASPER = "//tools/build/bazel/config:casper_enabled"
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
_HEADERS = ["//lib/libcapsicum:headers", "//lib/libcasper/libcasper:headers", "//lib/libcasper/services/cap_fileargs:headers"]
_LIBRARIES = ['//lib/libutil:util'] + select({_CASPER: ["//lib/libcasper/libcasper:casper", "//lib/libcasper/services/cap_fileargs:cap_fileargs"], "//conditions:default": []})
_DYNAMIC = ['//lib/libutil:util_shared'] + select({_CASPER: ["//lib/libcasper/libcasper:casper_shared", "//lib/libcasper/services/cap_fileargs:cap_fileargs_shared"], "//conditions:default": []})
cc_library(name = "objects", srcs = ['head.c'],
    deps = _HEADERS + _LIBRARIES,
    local_defines = select({_CASPER: ["WITH_CASPER"], "//conditions:default": []}),
    copts = ["-fPIE"], target_compatible_with = _PLATFORM)
cc_binary(name = "head", deps = [":objects"], dynamic_deps = _DYNAMIC, linkopts = ["-pie"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "head", manual = "head.1", package = "utilities", bindir = "/usr/bin", man_section = "1")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
