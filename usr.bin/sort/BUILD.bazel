load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools/build/bazel:bsd_compare_test.bzl", "bsd_filter_fixture")
_THREADS = "//tools/build/bazel/config:sort_threads_enabled"
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "objects",
    srcs = ["bwstring.c", "coll.c", "file.c", "mem.c", "radixsort.c", "sort.c", "vsort.c",
            "bwstring.h", "coll.h", "file.h", "mem.h", "radixsort.h", "sort.h", "vsort.h"],
    deps = ["//lib/libmd:md_link"],
    local_defines = select({_THREADS: ["SORT_THREADS"], "//conditions:default": []}),
    copts = ["-fPIE"], target_compatible_with = _PLATFORM)
cc_binary(name = "sort", deps = [":objects"], dynamic_deps = ["//lib/libmd:md_shared"],
    linkopts = ["-pie"] + select({_THREADS: ["-pthread"], "//conditions:default": []}),
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_filter_fixture(name = "manual", src = "sort.1.in", output = "sort.1",
    tool = "@bsd_sdk//toolchain:sed", redirect = "@bsd_sdk//toolchain:stdout_redirect",
    runtime = ["@bsd_sdk//toolchain:sed_runtime"],
    arguments = select({_THREADS: ["-e", "s|%%THREADS%%||g"], "//conditions:default": ["-e", r's|%%THREADS%%|.\\"|g']}))
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "sort", manual = ":manual", package = "runtime")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
