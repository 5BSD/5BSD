# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(
    name = "zstd", srcs = ['//sys/contrib/zstd:programs/benchfn.c', '//sys/contrib/zstd:programs/benchzstd.c', '//sys/contrib/zstd:programs/datagen.c', '//sys/contrib/zstd:programs/dibio.c', '//sys/contrib/zstd:programs/fileio.c', '//sys/contrib/zstd:programs/fileio_asyncio.c', '//sys/contrib/zstd:programs/lorem.c', '//sys/contrib/zstd:programs/timefn.c', '//sys/contrib/zstd:programs/util.c', '//sys/contrib/zstd:programs/zstdcli.c', '//sys/contrib/zstd:programs/zstdcli_trace.c'],
    deps = ["//lib/libzstd:zstd", "//sys/contrib/zstd:internal_headers"],
    dynamic_deps = ["//lib/libzstd:zstd_shared"],
    local_defines = ["PIC", "XXH_NAMESPACE=ZSTD_", "HAVE_THREAD=1", "ZSTD_MULTITHREAD=1"],
    copts = ['-fpie', '-pipe', '-fno-common', '-std=gnu17', '-fPIE', '-Wno-format-zero-length', '-Wsystem-headers', '-Werror', '-Wall', '-Wno-format-y2k', '-Wno-uninitialized', '-Wno-pointer-sign', '-Wdate-time', '-Wno-empty-body', '-Wno-string-plus-int', '-Wno-unused-const-variable', '-Wno-error=unused-but-set-parameter', '-Wno-error=cast-function-type-mismatch', '-Wno-tautological-compare', '-Wno-unused-value', '-Wno-parentheses-equality', '-Wno-unused-function', '-Wno-enum-conversion', '-Wno-unused-local-typedef', '-Wno-address-of-packed-member', '-Wno-switch', '-Wno-switch-enum', '-Wno-knr-promoted-parameter', '-Qunused-arguments'], linkopts = ["-pie", "-fstack-protector-strong", "-gz=zlib"] + select({
        "@platforms//cpu:aarch64": ["-Wl,--fix-cortex-a53-843419"], "//conditions:default": []}),
    target_compatible_with = ["@platforms//os:freebsd"],
    visibility = ["//visibility:public"],
)

load("//tools/build/bazel:bsd_command_install.bzl", "bsd_command_installation")
bsd_command_installation(name = "program_install_manifest", package = "zstd", program = "zstd", manual = "//sys/contrib/zstd:programs/zstd.1",
    aliases = ["unzstd", "zstdcat", "zstdmt"], manual_aliases = ["unzstd", "zstdcat", "zstdmt"])

filegroup(name = "package_abi", srcs = [":stripped"], visibility = ["//packages/zstd:__pkg__"])

# Preserve the original component's explicit debug-directory ownership.
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_directory", "bsd_install_manifest")
bsd_install_directory(name = "debug_usr_dir", destination = "/usr/lib/debug/usr", owner = "root", group = "wheel",
    mode = "0755", install_tags = ["package=zstd", "dbg"])
bsd_install_directory(name = "debug_bin_dir", destination = "/usr/lib/debug/usr/bin", owner = "root", group = "wheel",
    mode = "0755", install_tags = ["package=zstd", "dbg"])
bsd_install_manifest(name = "install_manifest", manifests = [":program_install_manifest"],
    entries = [":debug_usr_dir", ":debug_bin_dir"], visibility = ["//visibility:public"])
