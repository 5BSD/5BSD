# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
_CASPER = "//tools/build/bazel/config:casper_enabled"
cc_binary(
    name = "kdump",
    srcs = ["kdump.c", "linux.c", "kdump.h", "//usr.bin/ktrace:subr.c"],
    deps = ["//lib/libsysdecode:sysdecode", "//usr.bin/ktrace:trace_headers",
        "//lib/libc/gen:exterr_catalog_headers", "//sys/amd64/linux:sysdecode_headers",
        "//sys/compat/linux:sysdecode_headers"] + select({_CASPER: [
            "//lib/libcasper/libcasper:casper", "//lib/libcasper/services/cap_grp:cap_grp",
            "//lib/libcasper/services/cap_pwd:cap_pwd"], "//conditions:default": []}),
    dynamic_deps = ["//lib/libsysdecode:sysdecode_shared"] + select({_CASPER: [
        "//lib/libcasper/libcasper:casper_shared", "//lib/libcasper/services/cap_grp:cap_grp_shared",
        "//lib/libcasper/services/cap_pwd:cap_pwd_shared"], "//conditions:default": []}),
    local_defines = select({_CASPER: ["WITH_CASPER"], "//conditions:default": []}),
    copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
)
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "kdump", manual = "kdump.1", package = "utilities")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/bin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
