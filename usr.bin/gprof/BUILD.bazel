# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = 'gprof', srcs = ['gprof.c', 'arcs.c', 'dfn.c', 'elf.c', 'lookup.c', 'hertz.c', 'printgprof.c', 'printlist.c', 'kernel.c', 'gprof.h', 'pathnames.h'], deps = [], dynamic_deps = [], copts = ["-fPIE"], linkopts = ["-pie"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = 'gprof', manual = 'gprof.1', package = 'toolchain', bindir = "/usr/bin", man_section = '1', extra_entries = [":data_flat", ":data_callg"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//usr.bin:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=toolchain","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/bin"]} | {"/usr/share/misc": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=toolchain"]}'},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file")
[bsd_install_file(name = "data_" + n, src = "gprof." + n, destination = "/usr/share/misc/gprof." + n,
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=toolchain"]) for n in ["flat", "callg"]]
