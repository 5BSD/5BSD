# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = 'pkgconf', srcs = ['//contrib/pkgconf:cli/main.c', '//contrib/pkgconf:cli/core.c', '//contrib/pkgconf:cli/getopt_long.c', '//contrib/pkgconf:cli/renderer-msvc.c'], deps = ["//contrib/pkgconf:cli_headers", "//lib/libpkgconf:pkgconf"], dynamic_deps = ["//lib/libpkgconf:pkgconf_shared"], local_defines = ["SYSTEM_INCLUDEDIR=\\\"/usr/include\\\"", "SYSTEM_LIBDIR=\\\"/usr/lib\\\""], copts = ["-fPIE"], linkopts = ["-pie"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = 'pkgconf', manual = '//contrib/pkgconf:man/pkgconf.1', package = 'pkgconf', bindir = "/usr/bin", man_section = '1', extra_entries = [":pkg_config_link"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//usr.bin:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=pkgconf","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/bin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_link")
bsd_install_link(name = "pkg_config_link", destination = "/usr/bin/pkg-config", target = "pkgconf", kind = "symlink", owner = "root", group = "wheel", mode = "0755", install_tags = ["package=pkgconf"])
