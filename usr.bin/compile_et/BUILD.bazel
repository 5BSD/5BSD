# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools/build/bazel:bsd_lex_yacc.bzl", "bsd_lex", "bsd_yacc")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
bsd_yacc(name = "parser", src = "//contrib/com_err:parse.y", output = "parse.c", header = "parse.h", yacc = "//usr.bin/yacc:yacc")
filegroup(name = "parser_source", srcs = [":parser"], output_group = "source")
filegroup(name = "parser_header", srcs = [":parser"], output_group = "header")
bsd_lex(name = "lexer", src = "//contrib/com_err:lex.l", output = "lex.c",
    lex = "//usr.bin/lex:lex", m4 = "//usr.bin/m4:m4")
cc_library(name = "parser_headers", hdrs = [":parser_header"], strip_include_prefix = ".")
cc_binary(name = "compile_et", srcs = ["//contrib/com_err:compile_et.c", ":parser_source", ":lexer"],
    deps = [":parser_headers", "//contrib/com_err:compiler_headers", "//kerberos5/lib/libroken:roken", "//kerberos5/lib/libvers:vers_pie"],
    dynamic_deps = ["//kerberos5/lib/libroken:roken_shared", "//lib/libc:c_shared"],
    copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
utility_installation(name = "install_manifest", program = "compile_et", manual = "//contrib/com_err:compile_et.1", package = "kerberos")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive", visibility = ["//usr.bin:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=kerberos","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/bin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

load("//tools/build/bazel:bsd_compare_test.bzl", "bsd_compare_test")
bsd_compare_test(name = "version_test", program = ":compile_et", arguments = ["--version"],
    expected = "bazel-fixtures/empty", expected_stderr = "bazel-fixtures/version",
    runtime_lib = ["//kerberos5/lib/libroken:roken_shared", "//lib/libcrypt:crypt_shared", "//lib/libmd:md_shared", "//lib/libc:c_shared", "//lib/libsys:sys_shared"],
    runner = "//tools/build/bazel:byte_compare_runner", size = "small")

load("//tools/build/bazel:bsd_python_test.bzl", "bsd_python_test")
_GENERATION_RUNTIME = ["//kerberos5/lib/libroken:roken_shared", "//lib/libcrypt:crypt_shared", "//lib/libmd:md_shared", "//lib/libc:c_shared", "//lib/libsys:sys_shared"]
bsd_python_test(name = "generation_test", src = "generation-test.py",
    data = [":compile_et", "bazel-fixtures/sample.et"] + _GENERATION_RUNTIME,
    args = ["$(rootpath :compile_et)", "$(rootpath bazel-fixtures/sample.et)"] + ["$(rootpath " + lib + ")" for lib in _GENERATION_RUNTIME], size = "small")
