load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_import")
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_header", "bsd_dtrace_cc_objects")
_LIBRARIES = ["//lib/libarchive:archive"]
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
bsd_dtrace_header(
    name = "provider", source = "archiveop_provider.d", output = "archiveop_provider.h",
    flags = ["-C", "-x", "nolibs"], object_path_mode = "relative",
    dtrace = "@bsd_sdk//toolchain:extra_dtrace", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//tools/build/bazel:dtrace_runtime_object",
    tool_inputs = ["@bsd_sdk//toolchain:extra_dtrace_runtime", "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"],
)
cc_library(
    name = "provider_headers", hdrs = [":provider"], strip_include_prefix = "/usr.bin/tar",
)
cc_library(
    name = "objects",
    srcs = ["//contrib/libarchive:tar/" + source for source in ["bsdtar.c", "cmdline.c", "creation_set.c", "read.c", "subst.c", "util.c", "write.c"]] +
        ["//contrib/libarchive:libarchive_fe/" + source for source in ["lafe_err.c", "line_reader.c", "passphrase.c"]],
    deps = _LIBRARIES,
    implementation_deps = ["//lib/libarchive:configuration", "//contrib/libarchive:tar_headers"] + select({_TRACE: [":provider_headers"], "//conditions:default": []}),
    local_defines = ['PLATFORM_CONFIG_H=\\"config_freebsd.h\\"', "BSDTAR_VERSION_STRING=ARCHIVE_VERSION_ONLY_STRING"] +
        select({_TRACE: ["WITH_COVERAGE_DTRACE"], "//conditions:default": []}) +
        select({"//tools/build/bazel/config:openssl_enabled": ["WITH_OPENSSL", "OPENSSL_API_COMPAT=0x10100000L"], "//conditions:default": []}),
    copts = ["-fPIE"], linkstatic = True, target_compatible_with = _PLATFORM,
)
bsd_dtrace_cc_objects(
    name = "traced_objects", library = ":objects", provider = ":provider",
    provider_object = "archiveop_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner",
)
filegroup(name = "regular_objects", srcs = [":traced_objects"], output_group = "regular_objects")
filegroup(name = "pic_objects", srcs = [":traced_objects"], output_group = "pic_objects")
filegroup(name = "regular_provider", srcs = [":traced_objects"], output_group = "regular_provider")
filegroup(name = "pic_provider", srcs = [":traced_objects"], output_group = "pic_provider")
cc_import(
    name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True,
)
cc_import(
    name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"],
    deps = _LIBRARIES + [":provider_link"],
)
cc_binary(
    name = "bsdtar", deps = select({_TRACE: [":traced"], "//conditions:default": [":objects"]}),
    dynamic_deps = ["//lib/libarchive:archive_shared"], linkopts = ["-pie"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"],
)

load("//contrib/libarchive:cli_installation.bzl", "archive_cli_installation")
archive_cli_installation(name = "install_manifest", program = "bsdtar", alias = "tar", package = "runtime", manual = "//contrib/libarchive:tar/bsdtar.1")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)