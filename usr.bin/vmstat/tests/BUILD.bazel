load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
CASES = ['default', 'opt_s']
[bsd_atf_test(
    name = "native_" + case,
    case_name = case,
    body = "//contrib/netbsd-tests/usr.bin/vmstat:t_vmstat.sh",
    subr = "//libexec/atf/atf-sh:shell_library",
    runtime_bin = ['//bin/sh:sh', '//libexec/atf/atf-sh:atf-sh', '//libexec/atf/atf-check:atf-check', '//usr.bin/vmstat:vmstat', '//usr.bin/mkfifo:mkfifo', '//usr.bin/cmp:cmp', '//usr.bin/tr:tr', '//bin/test:test', '//bin/cat:cat', '//usr.bin/dirname:dirname', '//usr.bin/basename:basename', '//usr.bin/grep:grep', '//usr.bin/sed:sed', '//usr.bin/diff:diff', '//bin/rm:rm'],
    runtime_lib = ["//lib/libdevstat:devstat_shared", "//lib/libmemstat:memstat_shared", "//lib/atf/libatf-c:atf_c_shared", "//lib/atf/libatf-c++:atf_cxx_shared", "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared", "//lib/libedit:edit_shared", "//lib/ncurses/tinfo:tinfo_shared", "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7", "@bsd_sdk//toolchain:sysroot/lib/libgcc_s.so.1", "//lib/libutil:util_shared", "//lib/libkvm:kvm_shared", "//lib/libelf:elf_shared", "//lib/libjail:jail_shared", "//lib/libregex:regex_shared", "//lib/libmd:md_shared", "//lib/libxo/libxo:xo_shared", "//lib/libnv:nv_shared", "//lib/libcasper/libcasper:casper_shared", "//lib/libcasper/services/cap_fileargs:cap_fileargs_shared"],
    runner = "//tools/build/bazel:atf_runner",
    size = "small",
    tags = ["local", "no-cache"],
) for case in CASES]
test_suite(name = "tests", tests = [":native_" + case for case in CASES], visibility = ["//visibility:public"])
