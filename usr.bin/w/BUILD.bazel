# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = "w", srcs = ["w.c", "pr_time.c", "proc_compare.c", "extern.h", "//bin/ps:fmt.c", "//bin/ps:ps.h", "//bin/ps:extern.h"],
    deps = ["//lib/libkvm:kvm", "//lib/libsbuf:sbuf", "//lib/libxo/libxo:xo", "//lib/libutil:util"],
    dynamic_deps = ["//lib/libkvm:kvm_shared", "//lib/libsbuf:sbuf_shared", "//lib/libxo/libxo:xo_shared", "//lib/libutil:util_shared"],
    copts = ["-fPIE"], linkopts = ["-pie"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_link", "bsd_compress")
bsd_install_link(name = "uptime_link", destination = "/usr/bin/uptime", target = "/usr/bin/w", kind = "hardlink", owner = "root", group = "wheel", mode = "0555", install_tags = ["package=utilities"])
bsd_compress(name = "uptime_manual", src = "uptime.1", output = "uptime.1.gz", arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(manual = True, name = "uptime_manual_file", src = ":uptime_manual", destination = "/usr/share/man/man1/uptime.1.gz", owner = "root", group = "wheel", mode = "0444", install_tags = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=utilities-man"], "//conditions:default": ["package=utilities"]}))
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "w", manual = "w.1", package = "utilities", extra_entries = [":uptime_link", ":uptime_manual_file"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//usr.bin:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/bin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
