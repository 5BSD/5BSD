load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_link", "bsd_install_manifest")
cc_library(name = "ln", srcs = ["//contrib/flex/src:libmain.c", "//contrib/flex/src:libyywrap.c"],
    linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
# Make's NO_PIC contract installs the ordinary archive only.
bsd_component_archive(name = "static_archive", groups = [":ln"], visibility = ["//visibility:public"])
bsd_install_file(name = "archive_install", src = ":static_archive", destination = "/usr/lib/libln.a",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=utilities", "dev"])
[bsd_install_link(name = alias + "_install", destination = "/usr/lib/lib" + alias + ".a",
    target = "/usr/lib/libln.a", kind = "hardlink", owner = "root", group = "wheel",
    mode = "0444", install_tags = ["package=utilities", "dev"]) for alias in ["l", "fl"]]
bsd_install_manifest(name = "install_manifest", entries = [":archive_install", ":l_install", ":fl_install"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
