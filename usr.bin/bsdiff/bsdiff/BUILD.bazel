load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = "bsdiff", srcs = ["bsdiff.c", "//contrib/libdivsufsort:lib/divsufsort.c", "//contrib/libdivsufsort:lib/sssort.c", "//contrib/libdivsufsort:lib/trsort.c", "//contrib/libdivsufsort:lib/utils.c"], deps = [":headers", "//contrib/libdivsufsort:headers", "//lib/libbz2:bz2"], local_defines = ["HAVE_CONFIG_H=1", "_FILE_OFFSET_BITS=64", "_LARGEFILE_SOURCE", "_LARGE_FILES", "__STDC_CONSTANT_MACROS", "__STDC_FORMAT_MACROS", "__STDC_LIMIT_MACROS", "BUILD_DIVSUFSORT64"], dynamic_deps = ["//lib/libbz2:bz2_shared"], copts = ["-fPIE"], linkopts = ["-pie"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "bsdiff", manual = "bsdiff.1", package = "utilities", bindir = "/usr/bin", man_section = "1")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/bin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)




load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "headers", hdrs = ["config.h", "divsufsort64.h"], strip_include_prefix = ".")
