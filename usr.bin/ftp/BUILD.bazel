load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
cc_library(name = "configuration", hdrs = ["tnftp_config.h"], includes = ["."])
cc_binary(name = 'ftp', srcs = ['//contrib/tnftp:src/cmds.c', '//contrib/tnftp:src/cmdtab.c', '//contrib/tnftp:src/complete.c', '//contrib/tnftp:src/domacro.c', '//contrib/tnftp:src/fetch.c', '//contrib/tnftp:src/ftp.c', '//contrib/tnftp:src/main.c', '//contrib/tnftp:src/progressbar.c', '//contrib/tnftp:src/ruserpass.c', '//contrib/tnftp:src/util.c'], deps = [":configuration", "//contrib/tnftp:headers", "//lib/libedit:edit"], dynamic_deps = ["//lib/libedit:edit_shared"], local_defines = select({"//tools/build/bazel/config:inet6_support_enabled": ["INET6"], "//conditions:default": []}), copts = ["-fPIE"], linkopts = ["-pie"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = 'ftp', manual = '//contrib/tnftp:src/ftp.1', package = 'ftp', bindir = "/usr/bin", man_section = '1', aliases = ["pftp", "gate-ftp"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//usr.bin:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=ftp","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/bin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
