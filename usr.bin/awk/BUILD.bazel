load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools/build/bazel:bsd_lex_yacc.bzl", "bsd_yacc")
load("//tools/build/bazel:bsd_compare_test.bzl", "bsd_filter_fixture")
bsd_yacc(name = "parser", src = "//contrib/one-true-awk:awkgram.y", output = "awkgram.c", header = "awkgram.tab.h",
    yacc = "//usr.bin/yacc:yacc")
filegroup(name = "parser_source", srcs = [":parser"], output_group = "source")
filegroup(name = "parser_header", srcs = [":parser"], output_group = "header")
cc_library(name = "headers", hdrs = [":parser_header"], strip_include_prefix = ".", deps = ["//contrib/one-true-awk:headers"])
# The table generator is selected in the execution configuration by its consumer.
cc_binary(name = "maketab", srcs = ["//contrib/one-true-awk:maketab.c"], deps = [":headers"])
bsd_filter_fixture(name = "procedure_table", src = ":parser_header", output = "proctab.c",
    tool = ":maketab", redirect = "@bsd_sdk//toolchain:stdout_redirect")
cc_binary(name = "awk",
    srcs = [":parser_source", ":procedure_table"] + ["//contrib/one-true-awk:" + source for source in ["b.c", "lex.c", "lib.c", "main.c", "parse.c", "run.c", "tran.c"]],
    deps = [":headers", "//lib/msun:m"], dynamic_deps = ["//lib/msun:m_shared"],
    local_defines = ["HAS_ISBLANK", "FOPEN_MAX=64"], copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "awk", manual = "awk.1", package = "utilities", bindir = "/usr/bin", man_section = "1", aliases = ["nawk"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive", visibility = ["//usr.bin:__pkg__"],
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
