# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(
    name = "bsdcat",
    srcs = ['//contrib/libarchive:cat/bsdcat.c', '//contrib/libarchive:cat/cmdline.c', '//contrib/libarchive:libarchive_fe/lafe_err.c'],
    deps = ["//lib/libarchive:archive", "//lib/libarchive:configuration", "//contrib/libarchive:cat_headers"],
    dynamic_deps = ["//lib/libarchive:archive_shared"],
    local_defines = ['PLATFORM_CONFIG_H=\\"config_freebsd.h\\"', "BSDCAT_VERSION_STRING=ARCHIVE_VERSION_ONLY_STRING"] + select({
        "//tools/build/bazel/config:openssl_enabled": ["WITH_OPENSSL", "OPENSSL_API_COMPAT=0x10100000L"],
        "//conditions:default": [],
    }),
    copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
)

load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "bsdcat", package = "utilities", manual = "//contrib/libarchive:cat/bsdcat.1")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"] + select({"//tools/build/bazel/config:tests_enabled": ["//usr.bin/bsdcat/tests:install_manifest"], "//conditions:default": []}),
    directories = {"/usr/lib/debug/usr/bin": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}'} | select({"//tools/build/bazel/config:tests_enabled": {
        "/usr/tests/usr.bin/bsdcat": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests"]}',
        "/usr/lib/debug/usr": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests","dbg"]}',
        "/usr/lib/debug/usr/tests": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests","dbg"]}',
        "/usr/lib/debug/usr/tests/usr.bin": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests","dbg"]}',
        "/usr/lib/debug/usr/tests/usr.bin/bsdcat": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests","dbg"]}',
    }, "//conditions:default": {}}),
    mtree_specs = {
        "//etc/mtree:BSD.tests.dist": "/usr/tests",
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)