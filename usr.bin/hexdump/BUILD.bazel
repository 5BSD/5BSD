# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
cc_binary(name = "hexdump", srcs = ['conv.c', 'display.c', 'hexdump.c', 'hexsyntax.c', 'odsyntax.c', 'parse.c', 'hexdump.h'], deps = [], copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "hexdump", manual = "hexdump.1", package = "utilities", bindir = "/usr/bin", man_section = "1", aliases = ["hd"], extra_entries = [":od_link", ":od_manual"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive", visibility = ["//usr.bin:__pkg__"],
    manifests = [":install_manifest"] + select({"//tools/build/bazel/config:tests_enabled": ["//usr.bin/hexdump/tests:install_manifest"], "//conditions:default": []}),
    directories = select({"//tools/build/bazel/config:tests_enabled": {'/usr/lib/debug/usr': '{"owner": "root", "group": "wheel", "mode": "0755", "tags": ["package=utilities", "dbg"]}', '/usr/lib/debug/usr/bin': '{"owner": "root", "group": "wheel", "mode": "0755", "tags": ["package=utilities", "dbg"]}', '/usr/tests/usr.bin/hexdump': '{"owner": "root", "group": "wheel", "mode": "0755", "tags": ["package=tests"]}'}, "//conditions:default": {'/usr/lib/debug/usr': '{"owner": "root", "group": "wheel", "mode": "0755", "tags": ["package=utilities", "dbg"]}', '/usr/lib/debug/usr/bin': '{"owner": "root", "group": "wheel", "mode": "0755", "tags": ["package=utilities", "dbg"]}'}}),
    mtree_specs = {
        "//etc/mtree:BSD.tests.dist": "/usr/tests",
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

# od has a separate manual, although it shares the executable with hexdump.
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_link", "bsd_install_file", "bsd_compress")
bsd_install_link(name = "od_link", destination = "/usr/bin/od", target = "/usr/bin/hexdump",
    kind = "hardlink", owner = "root", group = "wheel", mode = "0555", install_tags = ["package=utilities"])
bsd_compress(name = "od_manual_gzip", src = "od.1", output = "od.1.gz", arguments = ["-cn"],
    compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect",
    runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(name = "od_manual", src = ":od_manual_gzip", destination = "/usr/share/man/man1/od.1.gz",
    owner = "root", group = "wheel", mode = "0444",
    install_tags = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=utilities-man"], "//conditions:default": ["package=utilities"]}))

# Declared executable aliases preserve argv[0] for test/runtime consumers.
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
[copy_file(name = name, src = ":hexdump", out = "aliases/" + name,
    is_executable = True, allow_symlink = True, visibility = ["//visibility:public"])
 for name in ["hd", "od"]]
