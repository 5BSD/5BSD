load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(
    name = "xzdec", srcs = ['//contrib/xz:src/xzdec/xzdec.c', '//contrib/xz:src/common/tuklib_progname.c', '//contrib/xz:src/common/tuklib_exit.c', '//contrib/xz:src/common/tuklib_mbstr_nonprint.c'],
    deps = ["//lib/liblzma:lzma", "//lib/liblzma:configuration", "//contrib/xz:internal_headers"],
    dynamic_deps = ["//lib/liblzma:lzma_shared"],
    local_defines = ["HAVE_CONFIG_H"], copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
)

load("//tools/build/bazel:bsd_command_install.bzl", "bsd_command_installation")
bsd_command_installation(name = "install_manifest", package = "xz", program = "xzdec", manual = "//contrib/xz:src/xzdec/xzdec.1",
    aliases = ['lzdec'], manual_aliases = ['lzmadec'])
