load("@rules_cc//cc:defs.bzl", "cc_binary")
config_setting(name = "target_aarch64", constraint_values = ["@platforms//cpu:aarch64"])
cc_binary(
    name = "lzmainfo", srcs = ['//contrib/xz:src/lzmainfo/lzmainfo.c', '//contrib/xz:src/common/tuklib_progname.c', '//contrib/xz:src/common/tuklib_exit.c', '//contrib/xz:src/common/tuklib_mbstr_nonprint.c', '//contrib/xz:src/common/tuklib_mbstr_width.c', '//contrib/xz:src/common/tuklib_mbstr_wrap.c'],
    deps = ["//lib/liblzma:lzma_link", "//lib/liblzma:configuration", "//contrib/xz:cli_headers"],
    dynamic_deps = ["//lib/liblzma:lzma_shared"],
    local_defines = ["HAVE_CONFIG_H"], copts = ['-fpie', '-DPIC', '-pipe', '-fno-common', '-std=gnu17', '-Wno-format-zero-length', '-Wsystem-headers', '-Werror', '-Wall', '-Wno-format-y2k', '-W', '-Wno-unused-parameter', '-Wstrict-prototypes', '-Wmissing-prototypes', '-Wpointer-arith', '-Wreturn-type', '-Wcast-qual', '-Wwrite-strings', '-Wswitch', '-Wshadow', '-Wunused-parameter', '-Wcast-align', '-Wchar-subscripts', '-Wnested-externs', '-Wold-style-definition', '-Wno-pointer-sign', '-Wdate-time', '-Wmissing-variable-declarations', '-Wthread-safety', '-Wno-empty-body', '-Wno-string-plus-int', '-Wno-unused-const-variable', '-Wno-error=unused-but-set-parameter', '-Wno-error=cast-function-type-mismatch', '-Qunused-arguments', '-fPIE'],
    linkopts = ["-pie", "-fstack-protector-strong", "-gz=zlib"] + select({":target_aarch64": ["-Wl,--fix-cortex-a53-843419"], "//conditions:default": []}),
    target_compatible_with = ["@platforms//os:freebsd"],
    visibility = ["//visibility:public"],
)

load("//tools/build/bazel:bsd_command_install.bzl", "bsd_command_installation")
bsd_command_installation(name = "program_install_manifest", package = "xz", program = "lzmainfo", manual = "//contrib/xz:src/lzmainfo/lzmainfo.1",
    aliases = [], manual_aliases = [])

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_directory", "bsd_install_manifest")
bsd_install_directory(name = "debug_usr_dir", destination = "/usr/lib/debug/usr", owner = "root", group = "wheel",
    mode = "0755", install_tags = ["package=xz", "dbg"])
bsd_install_directory(name = "debug_bin_dir", destination = "/usr/lib/debug/usr/bin", owner = "root", group = "wheel",
    mode = "0755", install_tags = ["package=xz", "dbg"])
bsd_install_manifest(name = "install_manifest", manifests = [":program_install_manifest"],
    entries = [":debug_usr_dir", ":debug_bin_dir"], visibility = ["//visibility:public"])

# Component archive for world-family composition. Package grouping remains
# independent: this contribution contains only this component's manifest.
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"],
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0, python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
    visibility = ["//visibility:public"])
