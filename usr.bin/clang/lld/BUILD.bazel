# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools/build/bazel:bsd_tablegen.bzl", "bsd_tablegen")
load("//tools/build/bazel:bsd_llvm_targets.bzl", "bsd_llvm_targets")
load("//tools/build/bazel:bsd_clang_defaults.bzl", "bsd_clang_defaults")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_sources")
bsd_llvm_targets(name = "registered_targets")
bsd_clang_defaults(name = "compiler_defaults")
bsd_tablegen(name = "options", src = "//contrib/llvm-project/lld:ELF/Options.td",
    includes = ["//contrib/llvm-project/llvm/include:llvm/Option/OptParser.td"],
    include_dirs = ["contrib/llvm-project/llvm/include"], flags = ["-gen-opt-parser-defs"],
    output = "Options.inc", tool = "//usr.bin/clang/llvm-tblgen:bootstrap")
cc_library(name = "option_headers", hdrs = [":options"], strip_include_prefix = ".")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "objects", srcs = ["lld-driver.cpp"] + ["//contrib/llvm-project/lld:" + name for name in [
    "Common/Args.cpp",
    "Common/CommonLinkerContext.cpp",
    "Common/DWARF.cpp",
    "Common/DriverDispatcher.cpp",
    "Common/ErrorHandler.cpp",
    "Common/Filesystem.cpp",
    "Common/Memory.cpp",
    "Common/Reproduce.cpp",
    "Common/Strings.cpp",
    "Common/TargetOptionsCommandFlags.cpp",
    "Common/Utils.cpp",
    "Common/Version.cpp",
    "ELF/AArch64ErrataFix.cpp",
    "ELF/ARMErrataFix.cpp",
    "ELF/Arch/AArch64.cpp",
    "ELF/Arch/AMDGPU.cpp",
    "ELF/Arch/ARM.cpp",
    "ELF/Arch/AVR.cpp",
    "ELF/Arch/Hexagon.cpp",
    "ELF/Arch/LoongArch.cpp",
    "ELF/Arch/MSP430.cpp",
    "ELF/Arch/Mips.cpp",
    "ELF/Arch/MipsArchTree.cpp",
    "ELF/Arch/PPC.cpp",
    "ELF/Arch/PPC64.cpp",
    "ELF/Arch/RISCV.cpp",
    "ELF/Arch/SPARCV9.cpp",
    "ELF/Arch/SystemZ.cpp",
    "ELF/Arch/X86.cpp",
    "ELF/Arch/X86_64.cpp",
    "ELF/BPSectionOrderer.cpp",
    "ELF/CallGraphSort.cpp",
    "ELF/DWARF.cpp",
    "ELF/Driver.cpp",
    "ELF/DriverUtils.cpp",
    "ELF/EhFrame.cpp",
    "ELF/ICF.cpp",
    "ELF/InputFiles.cpp",
    "ELF/InputSection.cpp",
    "ELF/LTO.cpp",
    "ELF/LinkerScript.cpp",
    "ELF/MapFile.cpp",
    "ELF/MarkLive.cpp",
    "ELF/OutputSections.cpp",
    "ELF/Relocations.cpp",
    "ELF/ScriptLexer.cpp",
    "ELF/ScriptParser.cpp",
    "ELF/SymbolTable.cpp",
    "ELF/Symbols.cpp",
    "ELF/SyntheticSections.cpp",
    "ELF/Target.cpp",
    "ELF/Thunks.cpp",
    "ELF/Writer.cpp",
    "tools/lld/lld.cpp"
]],
    deps = [":option_headers", ":registered_targets", ":compiler_defaults", "//contrib/llvm-project/lld:headers", "//contrib/llvm-project/llvm/include:headers", "//contrib/llvm-project/libcxx/include:headers", "//sys/contrib/zstd:headers", "//lib/clang/libllvm:intrinsic_headers", "//lib/clang/libllvm:ir_generated_headers", "//usr.bin/clang/llvm-min-tblgen:value_type_headers"],
    copts = ["-fPIE", "-std=c++17", "-nostdinc++", "-fno-exceptions", "-fno-rtti", "-fvisibility-inlines-hidden", "-ffunction-sections", "-fdata-sections"] + select({"//tools/build/bazel/config:llvm_full_debuginfo_enabled": ["-g"], "//conditions:default": ["-gline-tables-only"]}),
    local_defines = ["__STDC_CONSTANT_MACROS", "__STDC_FORMAT_MACROS", "__STDC_LIMIT_MACROS", "HAVE_VCS_VERSION_INC"] + select({"//tools/build/bazel/config:llvm_assertions_enabled": [], "//conditions:default": ["NDEBUG"]}),
    target_compatible_with = _PLATFORM)
[cc_binary(name = name, deps = [":objects", "//lib/clang/libllvm:llvm", "//lib/libz:z", "//lib/libzstd:zstd", "//lib/libc++:cxx", "//lib/libexecinfo:execinfo", "//lib/ncurses/tinfo:tinfo", "//lib/libthr:thr"] + (["//lib/libc:shared_link_interface"] if runtime else []),
    dynamic_deps = ["//lib/clang/libllvm:llvm_shared", "//lib/libz:z_shared", "//lib/libzstd:zstd_shared", "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared", "//lib/libexecinfo:execinfo_shared", "//lib/ncurses/tinfo:tinfo_shared", "//lib/libthr:thr_shared"] + (["//lib/libc:c_shared", "//lib/libsys:sys_shared", "//lib/libelf:elf_shared"] if runtime else []),
    features = ["bsd_test_runtime_paths"] if runtime else [], linkopts = ["-pie", "-Wl,--gc-sections"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"],
) for name, runtime in [("ld.lld", True), ("lld_installed", False)]]
bsd_component_sources(name = "source_inventory", groups = [":objects"], visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_link")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_link(name = "ld_alias", destination = "/usr/bin/ld", target = "ld.lld", kind = "symlink",
    owner = "root", group = "wheel", mode = "0755", install_tags = ["package=lld"])
utility_installation(name = "install_manifest", program = "ld.lld", binary = ":lld_installed",
    manual = "//contrib/llvm-project/lld:docs/ld.lld.1", package = "lld", manual_aliases = ["ld"], extra_entries = [":ld_alias"])
bsd_install_archive(name = "install_archive", visibility = ["//usr.bin/clang:__pkg__"], manifests = [":install_manifest"],
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.include.dist": "/usr/include", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])
