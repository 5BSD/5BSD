load("//tools/build/bazel:bsd_install.bzl", "bsd_install_link", "bsd_install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
# Each row owns an executable alias and its maintained manual hardlink.
_ALIASES = [
    ("ar", "llvm-ar", "llvm-ar"),
    ("ranlib", "llvm-ranlib", "llvm-ar"),
    ("gcov", "llvm-cov", "llvm-cov"),
    ("c++filt", "llvm-cxxfilt", "llvm-cxxfilt"),
    ("nm", "llvm-nm", "llvm-nm"),
    ("objcopy", "llvm-objcopy", "llvm-objcopy"),
    ("strip", "llvm-strip", "llvm-objcopy"),
    ("objdump", "llvm-objdump", "llvm-objdump"),
    ("readelf", "llvm-readelf", "llvm-readelf"),
    ("size", "llvm-size", "llvm-size"),
    ("addr2line", "llvm-addr2line", "llvm-addr2line"),
]
[bsd_install_link(name = alias + "_binary", destination = "/usr/bin/" + alias, target = binary,
    kind = "symlink", owner = "root", group = "wheel", mode = "0755", install_tags = ["package=toolchain"])
 for alias, binary, manual in _ALIASES]
[bsd_install_link(name = alias + "_manual", destination = "/usr/share/man/man1/" + alias + ".1.gz",
    target = "/usr/share/man/man1/" + manual + ".1.gz", kind = "hardlink", owner = "root", group = "wheel", mode = "0444",
    install_tags = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=toolchain-man"], "//conditions:default": ["package=toolchain"]}))
 for alias, binary, manual in _ALIASES]
bsd_install_manifest(name = "install_manifest",
    manifests = ["//usr.bin/clang/" + name + ":install_manifest" for name in ["llvm-ar", "llvm-cov", "llvm-cxxfilt", "llvm-nm", "llvm-objcopy", "llvm-objdump", "llvm-readobj", "llvm-size", "llvm-strings", "llvm-symbolizer"]],
    entries = select({"//tools/build/bazel/config:llvm_binutils_enabled": [":" + alias + suffix for alias, binary, manual in _ALIASES for suffix in ["_binary", "_manual"]], "//conditions:default": []}),
    visibility = ["//visibility:public"])
bsd_install_archive(name = "install_archive", visibility = ["//usr.bin/clang:__pkg__"], manifests = [":install_manifest"],
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.include.dist": "/usr/include", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])
