load("//tools/build/bazel:bsd_tablegen.bzl", "bsd_tablegen")
load("//lib/clang:lldb_utility.bzl", "lldb_utility")
bsd_tablegen(name = "options", src = "//contrib/llvm-project/lldb:tools/lldb-server/LLGSOptions.td",
    includes = ["//contrib/llvm-project/llvm/include:llvm/Option/OptParser.td"],
    include_dirs = ["contrib/llvm-project/llvm/include"], flags = ["-gen-opt-parser-defs"],
    output = "LLGSOptions.inc", tool = "//usr.bin/clang/llvm-tblgen:bootstrap")
lldb_utility(name = "lldb-server", srcs = ['//contrib/llvm-project/lldb:tools/lldb-server/LLDBServerUtilities.cpp', '//contrib/llvm-project/lldb:tools/lldb-server/SystemInitializerLLGS.cpp', '//contrib/llvm-project/lldb:tools/lldb-server/lldb-gdbserver.cpp', '//contrib/llvm-project/lldb:tools/lldb-server/lldb-platform.cpp', '//contrib/llvm-project/lldb:tools/lldb-server/lldb-server.cpp'], options = ":options",
    headers = "//contrib/llvm-project/lldb:lldb-server_headers", manual = "lldb-server.1", kvm = False)

load("//tools/build/bazel:bsd_python_test.bzl", "bsd_python_test")
bsd_python_test(name = "safe_cli_test", src = "safe_cli_test.py", data = [":lldb-server", "//lib/clang/liblldb:lldb_shared", "//lib/clang/libclang:clang_shared", "//lib/clang/libllvm:llvm_shared"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"] + select({"//tools/build/bazel/config:tests_enabled": [], "//conditions:default": ["@platforms//:incompatible"]}))
