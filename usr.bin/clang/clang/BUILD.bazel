load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")
load("//tools/build/bazel:bsd_llvm_targets.bzl", "bsd_llvm_targets")
load("//tools/build/bazel:bsd_clang_defaults.bzl", "bsd_clang_defaults")
bsd_llvm_targets(name = "registered_targets")
bsd_clang_defaults(name = "compiler_defaults")
[cc_binary(
    name = name,
    srcs = ["clang-driver.cpp"] + ["//contrib/llvm-project/clang/tools/driver:" + f for f in ["cc1_main.cpp", "cc1as_main.cpp", "cc1gen_reproducer_main.cpp", "driver.cpp"]],
    deps = ["//lib/clang/libllvm:directive_headers", "//lib/clang/libllvm:intrinsic_headers", "//lib/clang/libllvm:ir_generated_headers", "//lib/clang/libllvm:target_definition_headers", ":registered_targets", ":compiler_defaults", "//contrib/llvm-project/clang/include:headers", "//contrib/llvm-project/libcxx/include:headers", "//usr.bin/clang/llvm-min-tblgen:value_type_headers", "//lib/clang/libclang:clang", "//lib/clang/libllvm:llvm", "//lib/libz:z", "//lib/libzstd:zstd", "//lib/libc++:cxx", "//lib/libcxxrt:cxxrt", "//lib/libexecinfo:execinfo", "//lib/ncurses/ncurses:ncurses", "//lib/libthr:thr"] + (["//lib/libc:shared_link_interface"] if runtime else []),
    dynamic_deps = ["//lib/clang/libclang:clang_shared", "//lib/clang/libllvm:llvm_shared", "//lib/libz:z_shared", "//lib/libzstd:zstd_shared", "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared", "//lib/libexecinfo:execinfo_shared", "//lib/ncurses/ncurses:ncurses_shared", "//lib/libthr:thr_shared"] + (["//lib/libc:c_shared", "//lib/libsys:sys_shared", "//lib/libelf:elf_shared"] if runtime else []),
    copts = ["-fPIE", "-std=c++17", "-nostdinc++", "-fno-exceptions", "-fno-rtti", "-fvisibility-inlines-hidden", "-ffunction-sections", "-fdata-sections"] + select({"//tools/build/bazel/config:llvm_full_debuginfo_enabled": ["-g"], "//conditions:default": ["-gline-tables-only"]}),
    local_defines = select({"//tools/build/bazel/config:clang_full_enabled": ["CLANG_ENABLE_STATIC_ANALYZER"], "//conditions:default": []}) + ["__STDC_CONSTANT_MACROS", "__STDC_FORMAT_MACROS", "__STDC_LIMIT_MACROS", "HAVE_VCS_VERSION_INC"] + select({"//tools/build/bazel/config:llvm_assertions_enabled": [], "//conditions:default": ["NDEBUG"]}),
    features = ["bsd_test_runtime_paths"] if runtime else [],
    linkopts = ["-pie", "-Wl,--gc-sections"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
) for name, runtime in [("clang", True), ("clang_installed", False)]]

# Exercise the produced compiler, including object architecture, through bazel test.
cc_test(name = "codegen_test", srcs = ["codegen_test.c"],
    data = [":clang"],
    args = ["$(location :clang)"] +
        select({"//tools/build/bazel/config:llvm_target_x86_enabled": ["x86_64-unknown-freebsd16.0", "62"], "//conditions:default": []}) +
        select({"//tools/build/bazel/config:llvm_target_aarch64_enabled": ["aarch64-unknown-freebsd16.0", "183"], "//conditions:default": []}) +
        select({"//tools/build/bazel/config:llvm_target_arm_enabled": ["armv7-unknown-freebsd16.0-gnueabihf", "40"], "//conditions:default": []}) +
        select({"//tools/build/bazel/config:llvm_target_powerpc_enabled": ["powerpc64-unknown-freebsd16.0", "21"], "//conditions:default": []}) +
        select({"//tools/build/bazel/config:llvm_target_riscv_enabled": ["riscv64-unknown-freebsd16.0", "243"], "//conditions:default": []}) +
        select({"//tools/build/bazel/config:llvm_target_bpf_enabled": ["bpfel", "247"], "//conditions:default": []}) +
        select({"//tools/build/bazel/config:llvm_target_loongarch_enabled": ["loongarch64-unknown-freebsd16.0", "258"], "//conditions:default": []}),
    linkopts = ["-static"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_compiler_probe.bzl", "bsd_compiler_probe")
load("//tools/build/bazel:bsd_program_test.bzl", "bsd_program_test")
[bsd_compiler_probe(name = "sdk_" + language + "_probe",
    compiler = ":clang", linker = "@bsd_sdk//toolchain:bin/ld.lld",
    sdk = ["@bsd_sdk//toolchain:compile_inputs", "@bsd_sdk//toolchain:link_inputs"], src = "sdk_probe." + language,
    cxx = language == "cc",
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
) for language in ["c", "cc"]]
[bsd_program_test(name = "sdk_" + language + "_test", program = ":sdk_" + language + "_probe",
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
) for language in ["c", "cc"]]

load(":installation.bzl", "clang_installation")
clang_installation(binary = ":clang_installed")

# Link with the produced LLD and its declared execution runtime.
[bsd_compiler_probe(name = "native_link_" + language + "_probe",
    compiler = ":clang", linker = "//usr.bin/clang/lld:ld.lld",
    sdk = ["@bsd_sdk//toolchain:compile_inputs", "@bsd_sdk//toolchain:link_inputs"],
    src = "sdk_probe." + language, cxx = language == "cc",
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
) for language in ["c", "cc"]]
[bsd_program_test(name = "native_link_" + language + "_test", program = ":native_link_" + language + "_probe",
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"],
) for language in ["c", "cc"]]
