load("@rules_cc//cc:defs.bzl", "cc_binary")
# Bootstrap generator: the installed compiler utilities use full libllvm.
cc_binary(
    name = "bootstrap",
    srcs = ["//contrib/llvm-project/llvm/utils/TableGen:" + f for f in ["AsmMatcherEmitter.cpp", "AsmWriterEmitter.cpp", "Basic/ARMTargetDefEmitter.cpp", "Basic/Attributes.cpp", "Basic/CodeGenIntrinsics.cpp", "Basic/DirectiveEmitter.cpp", "Basic/IntrinsicEmitter.cpp", "Basic/RISCVTargetDefEmitter.cpp", "Basic/RuntimeLibcallsEmitter.cpp", "Basic/SDNodeProperties.cpp", "Basic/TableGen.cpp", "Basic/TargetFeaturesEmitter.cpp", "Basic/VTEmitter.cpp", "CTagsEmitter.cpp", "CallingConvEmitter.cpp", "CodeEmitterGen.cpp", "CodeGenMapTable.cpp", "Common/AsmWriterInst.cpp", "Common/CodeGenDAGPatterns.cpp", "Common/CodeGenHwModes.cpp", "Common/CodeGenInstAlias.cpp", "Common/CodeGenInstruction.cpp", "Common/CodeGenRegisters.cpp", "Common/CodeGenSchedule.cpp", "Common/CodeGenTarget.cpp", "Common/DAGISelMatcher.cpp", "Common/GlobalISel/CodeExpander.cpp", "Common/GlobalISel/CombinerUtils.cpp", "Common/GlobalISel/CXXPredicates.cpp", "Common/GlobalISel/GlobalISelMatchTable.cpp", "Common/GlobalISel/GlobalISelMatchTableExecutorEmitter.cpp", "Common/GlobalISel/PatternParser.cpp", "Common/GlobalISel/Patterns.cpp", "Common/InfoByHwMode.cpp", "Common/OptEmitter.cpp", "Common/PredicateExpander.cpp", "Common/SubtargetFeatureInfo.cpp", "Common/Types.cpp", "Common/Utils.cpp", "Common/VarLenCodeEmitterGen.cpp", "CompressInstEmitter.cpp", "DAGISelEmitter.cpp", "DAGISelMatcherEmitter.cpp", "DAGISelMatcherGen.cpp", "DAGISelMatcherOpt.cpp", "DFAEmitter.cpp", "DFAPacketizerEmitter.cpp", "DXILEmitter.cpp", "DecoderEmitter.cpp", "DisassemblerEmitter.cpp", "ExegesisEmitter.cpp", "FastISelEmitter.cpp", "GlobalISelCombinerEmitter.cpp", "GlobalISelEmitter.cpp", "InstrDocsEmitter.cpp", "InstrInfoEmitter.cpp", "MacroFusionPredicatorEmitter.cpp", "OptionParserEmitter.cpp", "PseudoLoweringEmitter.cpp", "RegisterBankEmitter.cpp", "RegisterInfoEmitter.cpp", "SDNodeInfoEmitter.cpp", "SearchableTableEmitter.cpp", "SubtargetEmitter.cpp", "WebAssemblyDisassemblerEmitter.cpp", "X86DisassemblerTables.cpp", "X86FoldTablesEmitter.cpp", "X86InstrMappingEmitter.cpp", "X86MnemonicTables.cpp", "X86ModRMFilters.cpp", "X86RecognizableInstr.cpp", "llvm-tblgen.cpp"]],
    deps = ["//contrib/llvm-project/llvm/utils/TableGen:headers", "//usr.bin/clang/llvm-min-tblgen:value_type_headers", "//lib/libc:shared_link_interface", "//contrib/llvm-project/llvm/lib:llvmminimal", "//lib/libc++:cxx", "//lib/libcxxrt:cxxrt", "//lib/libexecinfo:execinfo", "//lib/ncurses/tinfo:tinfo", "//lib/libthr:thr"],
    dynamic_deps = ["//lib/libc:c_shared", "//lib/libsys:sys_shared", "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared", "//lib/libexecinfo:execinfo_shared", "//lib/libelf:elf_shared", "//lib/ncurses/tinfo:tinfo_shared", "//lib/libthr:thr_shared"],
    copts = ["-std=c++17", "-nostdinc++", "-fno-exceptions", "-fno-rtti", "-fvisibility-inlines-hidden", "-ffunction-sections", "-fdata-sections"] + select({"//tools/build/bazel/config:llvm_full_debuginfo_enabled": ["-g"], "//conditions:default": ["-gline-tables-only"]}),
    local_defines = ["__STDC_CONSTANT_MACROS", "__STDC_FORMAT_MACROS", "__STDC_LIMIT_MACROS", "HAVE_VCS_VERSION_INC"] + select({"//tools/build/bazel/config:llvm_assertions_enabled": [], "//conditions:default": ["NDEBUG"]}),
    features = ["bsd_test_runtime_paths"],
    linkopts = ["-Wl,--gc-sections"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
)

load("//tools/build/bazel:bsd_tablegen.bzl", "bsd_tablegen")
bsd_tablegen(name = "attributes", src = "//contrib/llvm-project/llvm/include:llvm/IR/Attributes.td", flags = ["-gen-attrs"], output = "llvm/IR/Attributes.inc", tool = ":bootstrap", visibility = ["//visibility:public"])
bsd_tablegen(name = "intrinsic_enums", src = "//contrib/llvm-project/llvm/include:llvm/IR/Intrinsics.td", includes = ["//contrib/llvm-project/llvm/include:intrinsic_definitions"], include_dirs = ["contrib/llvm-project/llvm/include"], flags = ["-gen-intrinsic-enums"], output = "llvm/IR/IntrinsicEnums.inc", tool = ":bootstrap", visibility = ["//visibility:public"])
