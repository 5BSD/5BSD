load("//tools/build/bazel:bsd_tablegen.bzl", "bsd_tablegen")
load("//lib/clang:lldb_utility.bzl", "lldb_utility")
bsd_tablegen(name = "options", src = "//contrib/llvm-project/lldb:tools/driver/Options.td",
    includes = ["//contrib/llvm-project/llvm/include:llvm/Option/OptParser.td"],
    include_dirs = ["contrib/llvm-project/llvm/include"], flags = ["-gen-opt-parser-defs"],
    output = "Options.inc", tool = "//usr.bin/clang/llvm-tblgen:bootstrap")
lldb_utility(name = "lldb", srcs = ['//contrib/llvm-project/lldb:tools/driver/Driver.cpp'], options = ":options",
    headers = "//contrib/llvm-project/lldb:driver_headers", manual = "lldb.1", kvm = True)

load("//tools/build/bazel:bsd_python_test.bzl", "bsd_python_test")
bsd_python_test(name = "safe_cli_test", src = "safe_cli_test.py", visibility = ["//lib/clang:__pkg__"], data = [":lldb", "//lib/clang/liblldb:lldb_shared", "//lib/clang/libclang:clang_shared", "//lib/clang/libllvm:llvm_shared"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"] + select({"//tools/build/bazel/config:lldb_tests_enabled": [], "//conditions:default": ["@platforms//:incompatible"]}))
