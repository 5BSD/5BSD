# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = "factor", srcs = ["factor.c", "//usr.bin/primes:pr_tbl.c"], deps = ["//usr.bin/primes:headers"] + select({"//tools/build/bazel/config:openssl_enabled": ["//secure/lib/libcrypto:crypto"], "//conditions:default": []}), dynamic_deps = select({"//tools/build/bazel/config:openssl_enabled": ["//secure/lib/libcrypto:crypto_shared"], "//conditions:default": []}), local_defines = select({"//tools/build/bazel/config:openssl_enabled": ["HAVE_OPENSSL"], "//conditions:default": []}), copts = ["-fPIE"], linkopts = ["-pie"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "factor", manual = "factor.6", package = "utilities", bindir = "/usr/bin", man_section = "6", manual_aliases = ["primes"])

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive", visibility = ["//usr.bin:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/bin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)




# Cases preserve the maintained factor/tests shell expectations.
load("//tools/build/bazel:bsd_compare_test.bzl", "bsd_compare_test")
bsd_compare_test(name = "float_non_prime_test", program = ":factor", arguments = ['1.44'],
    expected = "bazel-fixtures/float_non_prime.out", expected_stderr = "bazel-fixtures/float_non_prime.err", expected_exit = 0,
    runtime_lib = select({"//tools/build/bazel/config:openssl_enabled": ["//secure/lib/libcrypto:crypto_shared"], "//conditions:default": []}) + ["@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"],
    runner = "//tools/build/bazel:byte_compare_runner", size = "small")
bsd_compare_test(name = "float_prime_test", program = ":factor", arguments = ['3.141592653589793238462643383279502884197'],
    expected = "bazel-fixtures/float_prime.out", expected_stderr = "bazel-fixtures/float_prime.err", expected_exit = 0,
    runtime_lib = select({"//tools/build/bazel/config:openssl_enabled": ["//secure/lib/libcrypto:crypto_shared"], "//conditions:default": []}) + ["@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"],
    runner = "//tools/build/bazel:byte_compare_runner", size = "small")
bsd_compare_test(name = "int_non_prime_test", program = ":factor", arguments = ['8'],
    expected = "bazel-fixtures/int_non_prime.out", expected_stderr = "bazel-fixtures/int_non_prime.err", expected_exit = 0,
    runtime_lib = select({"//tools/build/bazel/config:openssl_enabled": ["//secure/lib/libcrypto:crypto_shared"], "//conditions:default": []}) + ["@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"],
    runner = "//tools/build/bazel:byte_compare_runner", size = "small")
bsd_compare_test(name = "int_prime_test", program = ":factor", arguments = ['31'],
    expected = "bazel-fixtures/int_prime.out", expected_stderr = "bazel-fixtures/int_prime.err", expected_exit = 0,
    runtime_lib = select({"//tools/build/bazel/config:openssl_enabled": ["//secure/lib/libcrypto:crypto_shared"], "//conditions:default": []}) + ["@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"],
    runner = "//tools/build/bazel:byte_compare_runner", size = "small")
bsd_compare_test(name = "negative_numbers_not_allowed_test", program = ":factor", arguments = ['--', '-4'],
    expected = "bazel-fixtures/negative_numbers_not_allowed.out", expected_stderr = "bazel-fixtures/negative_numbers_not_allowed.err", expected_exit = 1,
    runtime_lib = select({"//tools/build/bazel/config:openssl_enabled": ["//secure/lib/libcrypto:crypto_shared"], "//conditions:default": []}) + ["@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"],
    runner = "//tools/build/bazel:byte_compare_runner", size = "small")
test_suite(name = "tests", tests = [':float_non_prime_test', ':float_prime_test', ':int_non_prime_test', ':int_prime_test', ':negative_numbers_not_allowed_test'], visibility = ["//visibility:public"])
