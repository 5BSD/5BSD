load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
# Reuse the maintained sm_os.h generator and Sendmail header interface.
cc_binary(
    name = "vacation",
    srcs = ["//contrib/sendmail:vacation/vacation.c"],
    deps = ["//lib/libsm:headers", "//lib/libsmdb:smdb_pie", "//lib/libsmutil:smutil_pie", "//lib/libsm:sm_pie"],
    local_defines = ["NEWDB", "NOT_SENDMAIL", "_FFR_LISTDB", "_FFR_DEBUG"],
    copts = ["-std=gnu17", "-Wno-deprecated-non-prototype", "-fPIE"],
    linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"] + select({
        "//tools/build/bazel/config:sendmail_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)
utility_installation(name = "install_manifest", program = "vacation", manual = "//contrib/sendmail:vacation/vacation.1", package = "utilities")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive", visibility = ["//usr.bin:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/bin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

load("//tools/build/bazel:bsd_compare_test.bzl", "bsd_compare_test")
# Missing login exits before opening a vacation database or sending any reply.
bsd_compare_test(name = "usage_test", program = ":vacation", expected_exit = 64,
    expected = "bazel-fixtures/empty", expected_stderr = "bazel-fixtures/empty",
    runtime_lib = ["@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"],
    runner = "//tools/build/bazel:byte_compare_runner", size = "small")
