load("//tools/build/bazel:bsd_base_install.bzl", "bsd_program_install")
load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_debug_split", "bsd_strip_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_directory")

cc_binary(
    name = "bzip2recover",
    srcs = ["//contrib/bzip2:bzip2recover.c"],
    copts = ['-fpie', '-pipe', '-fno-common', '-fPIE', '-std=gnu17', '-Wno-format-zero-length', '-Wsystem-headers', '-Werror', '-Wall', '-Wno-format-y2k', '-W', '-Wno-unused-parameter', '-Wstrict-prototypes', '-Wmissing-prototypes', '-Wpointer-arith', '-Wreturn-type', '-Wcast-qual', '-Wwrite-strings', '-Wswitch', '-Wshadow', '-Wunused-parameter', '-Wcast-align', '-Wchar-subscripts', '-Wnested-externs', '-Wold-style-definition', '-Wno-pointer-sign', '-Wdate-time', '-Wthread-safety', '-Wno-empty-body', '-Wno-string-plus-int', '-Wno-unused-const-variable', '-Wno-error=unused-but-set-parameter', '-Wno-error=cast-function-type-mismatch', '-Qunused-arguments'],
    local_defines = ["PIC"],
    linkopts = ["-pie", "-fstack-protector-strong", "-gz=zlib"],
    visibility = ["//visibility:public"],
)

bsd_debug_split(
    name = "bzip2recover_debug",
    src = ":bzip2recover",
    binary_name = "install/bzip2recover",
    debug_name = "install/bzip2recover.debug",
    objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    objcopy_inputs = "@bsd_sdk//toolchain:objcopy_inputs",
    visibility = ["//visibility:public"],
)

bsd_strip_binary(
    name = "bzip2recover_install",
    src = ":bzip2recover_debug",
    output = "stripped/bzip2recover",
    strip = "@bsd_sdk//toolchain:bin/llvm-strip",
    strip_inputs = "@bsd_sdk//toolchain:strip_inputs",
    visibility = ["//visibility:public"],
)

bsd_install_directory(name = "debug_usr_dir", destination = "/usr/lib/debug/usr",
    owner = "root", group = "wheel", mode = "0755", install_tags = ["package=bzip2", "dbg"])
bsd_install_directory(name = "debug_bin_dir", destination = "/usr/lib/debug/usr/bin",
    owner = "root", group = "wheel", mode = "0755", install_tags = ["package=bzip2", "dbg"])

bsd_program_install(
    name = "install_manifest",
    binary = ":bzip2recover_install",
    debug = ":bzip2recover_debug",
    destination = "/usr/bin/bzip2recover",
    package = "bzip2",
    extra_entries = [":debug_usr_dir", ":debug_bin_dir"],
    visibility = ["//visibility:public"],
)

# Component archive for world-family composition. Package grouping remains
# independent: this contribution contains only this component's manifest.
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"],
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0, python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
    visibility = ["//visibility:public"])
