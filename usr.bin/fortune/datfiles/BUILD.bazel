load(":fortune_database.bzl", "fortune_database")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest")
_DATABASES = ["freebsd-tips", "5bsd-tips"]
[fortune_database(name = n + "_index", src = n, output = n + ".dat", compiler = "//usr.bin/fortune/strfile:strfile") for n in _DATABASES]
[bsd_install_file(name = "install_" + n + suffix, src = ":" + n + "_index" if suffix else n,
    destination = "/usr/share/games/fortune/" + n + suffix, owner = "root", group = "wheel", mode = "0444",
    install_tags = ["package=utilities"]) for n in _DATABASES for suffix in ["", ".dat"]]
bsd_install_manifest(name = "install_manifest", entries = [":install_" + n + suffix for n in _DATABASES for suffix in ["", ".dat"]])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//usr.bin/fortune:__pkg__"],
    manifests = [":install_manifest"],
    directories = {"/usr/share/games/fortune": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities"]}'},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
