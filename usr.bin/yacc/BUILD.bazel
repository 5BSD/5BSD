# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load(":version_config.bzl", "version_config")
version_config(name = "version_config", config = "config.h", version = "//contrib/byacc:VERSION",
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib"])
cc_library(name = "config_headers", hdrs = [":version_config"], strip_include_prefix = "generated")
cc_binary(name = "yacc", srcs = ['//contrib/byacc:closure.c', '//contrib/byacc:error.c', '//contrib/byacc:graph.c', '//contrib/byacc:lalr.c', '//contrib/byacc:lr0.c', '//contrib/byacc:main.c', '//contrib/byacc:mkpar.c', '//contrib/byacc:mstring.c', '//contrib/byacc:output.c', '//contrib/byacc:reader.c', '//contrib/byacc:yaccpar.c', '//contrib/byacc:symtab.c', '//contrib/byacc:verbose.c', '//contrib/byacc:warshall.c'],
    deps = [":config_headers", "//contrib/byacc:headers"], local_defines = ["HAVE_CONFIG_H", "MAXTABLE=INT_MAX"],
    copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "yacc", manual = "//contrib/byacc:yacc.1", package = "toolchain", bindir = "/usr/bin", man_section = "1", aliases = ["byacc"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
