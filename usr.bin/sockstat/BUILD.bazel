# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_import")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_header", "bsd_dtrace_cc_objects")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
bsd_dtrace_header(
    name = "provider", source = "socketsnapshot_provider.d", output = "socketsnapshot_provider.h",
    flags = ["-C", "-x", "nolibs"], object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:dtrace", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti",
    runtime_libraries = ['//cddl/lib/libdtrace:dtrace_shared', '//cddl/lib/libctf:ctf_shared', '//lib/libelf:elf_shared', '//lib/libproc:proc_shared', '//cddl/lib/libspl:spl_shared', '//lib/libxo/libxo:xo_shared', '//lib/libutil:util_shared', '//lib/libprocstat:procstat_shared', '//lib/librtld_db:rtld_db_shared', '//lib/libcxxrt:cxxrt_shared', '//lib/libz:z_shared', '//lib/libkvm:kvm_shared'],
    tool_inputs = [ "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"], static_anchor = False,
)
cc_library(name = "provider_headers", hdrs = [":provider"], strip_include_prefix = ".")

cc_library(name = "objects", srcs = ["main.c", "sockstat.c", "sockstat.h", "socketsnapshot_trace.h"],
    deps = ['//lib/libjail:jail', '//lib/libxo/libxo:xo', '//lib/libcapsicum:headers', '//lib/libcasper/libcasper:headers', '//lib/libcasper/services/cap_net:headers', '//lib/libcasper/services/cap_netdb:headers', '//lib/libcasper/services/cap_pwd:headers', '//lib/libcasper/services/cap_sysctl:headers'] + select({"//tools/build/bazel/config:casper_enabled": ['//lib/libcasper/libcasper:casper', '//lib/libcasper/services/cap_net:cap_net', '//lib/libcasper/services/cap_netdb:cap_netdb', '//lib/libcasper/services/cap_pwd:cap_pwd', '//lib/libcasper/services/cap_sysctl:cap_sysctl'], "//conditions:default": []}) + select({_TRACE: [":provider_headers"], "//conditions:default": []}),
    local_defines = select({"//tools/build/bazel/config:casper_enabled": ["WITH_CASPER"], "//conditions:default": []}) + select({_TRACE: ["WITH_COVERAGE_DTRACE"], "//conditions:default": []}),
    copts = ["-fPIE"], target_compatible_with = _PLATFORM)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider", provider_object = "socketsnapshot_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group) for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"], deps = [":provider_link"] + ['//lib/libjail:jail', '//lib/libxo/libxo:xo', '//lib/libcapsicum:headers', '//lib/libcasper/libcasper:headers', '//lib/libcasper/services/cap_net:headers', '//lib/libcasper/services/cap_netdb:headers', '//lib/libcasper/services/cap_pwd:headers', '//lib/libcasper/services/cap_sysctl:headers'] + select({"//tools/build/bazel/config:casper_enabled": ['//lib/libcasper/libcasper:casper', '//lib/libcasper/services/cap_net:cap_net', '//lib/libcasper/services/cap_netdb:cap_netdb', '//lib/libcasper/services/cap_pwd:cap_pwd', '//lib/libcasper/services/cap_sysctl:cap_sysctl'], "//conditions:default": []}))
cc_binary(name = "sockstat", deps = select({_TRACE: [":traced"], "//conditions:default": [":objects"]}),
    dynamic_deps = ['//lib/libjail:jail_shared', '//lib/libxo/libxo:xo_shared'] + select({"//tools/build/bazel/config:casper_enabled": ['//lib/libcasper/libcasper:casper_shared', '//lib/libcasper/services/cap_net:cap_net_shared', '//lib/libcasper/services/cap_netdb:cap_netdb_shared', '//lib/libcasper/services/cap_pwd:cap_pwd_shared', '//lib/libcasper/services/cap_sysctl:cap_sysctl_shared'], "//conditions:default": []}),
    linkopts = ["-pie"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "sockstat", manual = "sockstat.1", package = "utilities")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//usr.bin:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/bin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

exports_files(["sockstat.c", "sockstat.h"], visibility = ["//usr.bin/sockstat/tests:__pkg__"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive_set")
bsd_install_archive_set(name = "installation_archives", archives = [":install_archive"] + select({"//tools/build/bazel/config:tests_enabled": ["//usr.bin/sockstat/tests:install_archive"], "//conditions:default": []}), visibility = ["//usr.bin:__pkg__"])
