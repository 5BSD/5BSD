load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools/build/bazel:bsd_lex_yacc.bzl", "bsd_lex", "bsd_yacc")
bsd_yacc(name = "parser", src = "yacc.y", output = "yacc.c", header = "yacc.h",
    yacc = "//usr.bin/yacc:yacc")
filegroup(name = "parser_source", srcs = [":parser"], output_group = "source")
filegroup(name = "parser_header", srcs = [":parser"], output_group = "header")
bsd_lex(name = "scanner", src = "lex.l", output = "lex.c",
    lex = "//usr.bin/lex:lex", m4 = "//usr.bin/m4:m4")
cc_library(name = "headers", hdrs = ["ldef.h", ":parser_header"], strip_include_prefix = ".")
cc_binary(name = "mkcsmapper", srcs = [":parser_source", ":scanner"],
    deps = [":headers", "//lib/libc/iconv:module_headers", "//lib/libiconv_modules:mapper_file_header", "//lib/libc:shared_link_interface"],
    dynamic_deps = ["//lib/libc:c_shared", "//lib/libsys:sys_shared"],
    copts = ["-fPIE"], linkopts = ["-pie", "-nodefaultlibs"],
    visibility = ["//visibility:public"])
# Execution tool carries native libc statically; no installed runtime is needed.
cc_binary(name = "mkcsmapper_tool", srcs = [":parser_source", ":scanner"],
    deps = [":headers", "//lib/libc/iconv:module_headers", "//lib/libiconv_modules:mapper_file_header", "//lib/libc:static_link_objects"],
    features = ["fully_static_link"], linkopts = ["-nodefaultlibs"], linkstatic = True,
    visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "mkcsmapper", manual = "mkcsmapper.1", package = "utilities")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/bin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
