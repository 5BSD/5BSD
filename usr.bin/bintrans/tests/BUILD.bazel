load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_script_wrapper")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
_FIXTURES = ["textqpenc", "textqpdec", "regress.base64.in", "regress.base64.out", "regress.in", "regress.out", "regress.sh", "regress.traditional.in", "regress.traditional.out", "regress.153276.in", "regress.153276.out"]
_SUITES = {"bintrans_test": ("bintrans_test.sh", ["encode_qp", "decode_qp"])}
_TOOLS = ["//bin/sh:sh", "//usr.bin/bintrans:bintrans", "//libexec/atf/atf-sh:atf-sh", "//libexec/atf/atf-check:atf-check",
    "//usr.bin/dirname:dirname", "//usr.bin/basename:basename", "//usr.bin/grep:grep", "//usr.bin/sed:sed", "//usr.bin/diff:diff", "//bin/rm:rm", "//bin/test:test"]
_LIBS = ["//lib/atf/libatf-c:atf_c_shared", "//lib/atf/libatf-c++:atf_cxx_shared", "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared", "//lib/libedit:edit_shared", "//lib/ncurses/tinfo:tinfo_shared", "//lib/libregex:regex_shared", "//lib/libmd:md_shared", "//lib/libxo/libxo:xo_shared", "//lib/libnv:nv_shared", "//lib/libcasper/libcasper:casper_shared", "//lib/libcasper/services/cap_fileargs:cap_fileargs_shared", "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7", "@bsd_sdk//toolchain:sysroot/lib/libgcc_s.so.1"]
[bsd_atf_test(name = "native_" + case, case_name = case, body = source,
    subr = "//libexec/atf/atf-sh:shell_library", runner = "//tools/build/bazel:atf_runner",
    runtime_bin = _TOOLS, runtime_lib = _LIBS,
    data = _FIXTURES, size = "small")
 for source,cases in _SUITES.values() for case in cases]
test_suite(name = "tests", tests = [":legacy"] + [":native_" + case for source,cases in _SUITES.values() for case in cases], visibility = ["//visibility:public"])
[bsd_script_wrapper(name = name, body = source, interpreter = "/usr/libexec/atf-sh",
    cat = "@bsd_sdk//toolchain:cat", cat_runtime = ["@bsd_sdk//toolchain:cat_runtime"], redirect = "@bsd_sdk//toolchain:stdout_redirect") for name,(source,cases) in _SUITES.items()]
[bsd_install_file(name = "install_" + name, src = ":" + name, destination = "/usr/tests/usr.bin/bintrans/" + name,
    owner = "root", group = "wheel", mode = "0555", install_tags = ["package=tests"]) for name in _SUITES]
[bsd_install_file(name = "fixture_" + str(i), src = f, destination = "/usr/tests/usr.bin/bintrans/" + f,
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=tests"]) for i,f in enumerate(_FIXTURES)]
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["bintrans_test", "legacy_test"], interfaces = {"bintrans_test": "atf", "legacy_test": "tap"})
bsd_install_file(name = "install_kyuafile", src = ":kyuafile", destination = "/usr/tests/usr.bin/bintrans/Kyuafile", owner = "root", group = "wheel", mode = "0444", install_tags = ["package=tests"])
bsd_install_manifest(name = "install_manifest", entries = [":install_kyuafile", ":install_legacy"] + [":install_" + n for n in _SUITES] + [":fixture_" + str(i) for i in range(len(_FIXTURES))], visibility = ["//visibility:public"])

# The shared /usr/tests/usr.bin/regress.m4 belongs to usr.bin/tests.
bsd_install_file(name = "install_legacy", src = "legacy_test.sh", destination = "/usr/tests/usr.bin/bintrans/legacy_test",
    owner = "root", group = "wheel", mode = "0555", install_tags = ["package=tests"])

load("//tools/build/bazel:bsd_kyua.bzl", "bsd_kyua_test")
bsd_script_wrapper(name = "legacy_test", body = "legacy_test.sh", interpreter = "/bin/sh",
    cat = "@bsd_sdk//toolchain:cat", cat_runtime = ["@bsd_sdk//toolchain:cat_runtime"], redirect = "@bsd_sdk//toolchain:stdout_redirect")
bsd_kyua_test(name = "legacy", program = ":legacy_test", program_path = "bintrans/legacy_test", interface = "tap",
    suite = "FreeBSD", kyua = "@bsd_sdk//toolchain:extra_kyua", clean_environment = True,
    path_programs = {"//usr.bin/bintrans:uuencode": "uuencode", "//usr.bin/bintrans:uudecode": "uudecode"},
    suite_files = {f: "bintrans/" + f for f in _FIXTURES} | {"//usr.bin/tests:regress.m4": "regress.m4"},
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_kyua_runtime"],
    size = "small", visibility = ["//visibility:public"])
