load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = 'drill', srcs = ['//contrib/ldns/drill:drill.c', '//contrib/ldns/drill:drill_util.c', '//contrib/ldns/drill:error.c', '//contrib/ldns/drill:root.c', '//contrib/ldns/drill:work.c', '//contrib/ldns/drill:chasetrace.c', '//contrib/ldns/drill:dnssec.c', '//contrib/ldns/drill:securetrace.c'], deps = ['//lib/libldns:ldns', '//contrib/ldns/drill:headers', '//contrib/ldns:drill_configuration', '//secure/lib/libcrypto:crypto'], dynamic_deps = ['//lib/libldns:ldns_shared', '//secure/lib/libcrypto:crypto_shared'], local_defines = ["LDNS_TRUST_ANCHOR_FILE=\\\"/etc/unbound/root.key\\\""], copts = ["-fPIE"], linkopts = ["-pie"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = 'drill', manual = '//contrib/ldns/drill:drill.1', package = 'utilities', bindir = "/usr/bin", man_section = '1')
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//usr.bin:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/bin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
