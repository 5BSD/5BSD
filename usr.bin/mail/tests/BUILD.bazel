# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
cc_binary(name = "mailx_signal_test", srcs = ["mailx_signal_test.c"], deps = ["//lib/atf/libatf-c:atf_c"], dynamic_deps = ["//lib/atf/libatf-c:atf_c_shared"], copts = ["-fPIE"], linkopts = ["-pie"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
# Preserve the installed mailx name for the maintained test's execlp lookup.
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
copy_file(name = "mailx_runtime", src = "//usr.bin/mail:mail", out = "mailx", is_executable = True)
_CASES = ["mailx_sighup_interactive", "mailx_sighup_noninteractive", "mailx_sigint_interactive", "mailx_sigint_noninteractive"]
[bsd_atf_test(name = "native_" + case, case_name = case, interface = "program", body = ":mailx_signal_test", runtime_bin = [":mailx_runtime"], runtime_lib = ["//lib/atf/libatf-c:atf_c_shared", "//lib/libc:c_shared", "//lib/libsys:sys_shared"], runner = "//tools/build/bazel:atf_runner", size = "small") for case in _CASES]
test_suite(name = "tests", tests = [":native_" + case for case in _CASES], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
utility_installation(name = "install_manifest", program = "mailx_signal_test", manual = "", package = "tests", bindir = "/usr/tests/usr.bin/mail")
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["mailx_signal_test"], interfaces = {"mailx_signal_test": "atf"})
bsd_install_file(name = "kyuafile_file", src = ":kyuafile", destination = "/usr/tests/usr.bin/mail/Kyuafile", owner = "root", group = "wheel", mode = "0444", install_tags = ["package=tests"])
bsd_install_manifest(name = "install_extra", entries = [":kyuafile_file"], visibility = ["//usr.bin/mail:__pkg__"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//usr.bin:__subpackages__"],
    manifests = [":install_manifest", ":install_extra"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/tests", "/usr/lib/debug/usr/tests/usr.bin"]} | {"/usr/lib/debug/usr/tests/usr.bin/mail": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests","dbg"]}', "/usr/tests/usr.bin/mail": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests"]}'},
    mtree_specs = {
        "//etc/mtree:BSD.tests.dist": "/usr/tests",
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
