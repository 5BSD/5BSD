load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = "caesar", srcs = ["caesar.c"], deps = ["//lib/msun:m"], dynamic_deps = ["//lib/msun:m_shared"], copts = ["-fPIE"], linkopts = ["-pie"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "caesar", manual = "caesar.6", package = "games", bindir = "/usr/bin", man_section = "6", manual_aliases = ["rot13"], extra_entries = [":script_install"])

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive", visibility = ["//usr.bin:__pkg__"],
    manifests = [":install_manifest"],
    directories = {
        "/usr/bin": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=games"]}',
        "/usr/lib/debug/usr": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=games","dbg"]}',
        "/usr/lib/debug/usr/bin": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=games","dbg"]}',
    },
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)




load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file")
bsd_install_file(name = "script_install", src = "rot13.sh", destination = "/usr/bin/rot13",
    owner = "root", group = "wheel", mode = "0555", install_tags = ["package=games"])

load("//tools/build/bazel:bsd_compare_test.bzl", "bsd_compare_test")
bsd_compare_test(name = "shift_0_test", program = ":caesar", input = "bazel-fixtures/input",
    arguments = ["0"], expected = "bazel-fixtures/shift-0", expected_stderr = "bazel-fixtures/empty",
    runtime_lib = ["//lib/msun:m_shared", "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"],
    runner = "//tools/build/bazel:byte_compare_runner", size = "small")
bsd_compare_test(name = "shift_1_test", program = ":caesar", input = "bazel-fixtures/input",
    arguments = ["1"], expected = "bazel-fixtures/shift-1", expected_stderr = "bazel-fixtures/empty",
    runtime_lib = ["//lib/msun:m_shared", "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"],
    runner = "//tools/build/bazel:byte_compare_runner", size = "small")
bsd_compare_test(name = "shift_13_test", program = ":caesar", input = "bazel-fixtures/input",
    arguments = ["13"], expected = "bazel-fixtures/shift-13", expected_stderr = "bazel-fixtures/empty",
    runtime_lib = ["//lib/msun:m_shared", "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"],
    runner = "//tools/build/bazel:byte_compare_runner", size = "small")
bsd_compare_test(name = "shift_25_test", program = ":caesar", input = "bazel-fixtures/input",
    arguments = ["25"], expected = "bazel-fixtures/shift-25", expected_stderr = "bazel-fixtures/empty",
    runtime_lib = ["//lib/msun:m_shared", "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"],
    runner = "//tools/build/bazel:byte_compare_runner", size = "small")
bsd_compare_test(name = "shift_26_test", program = ":caesar", input = "bazel-fixtures/input",
    arguments = ["26"], expected = "bazel-fixtures/shift-26", expected_stderr = "bazel-fixtures/empty",
    runtime_lib = ["//lib/msun:m_shared", "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"],
    runner = "//tools/build/bazel:byte_compare_runner", size = "small")
test_suite(name = "tests", tests = [':shift_0_test', ':shift_1_test', ':shift_13_test', ':shift_25_test', ':shift_26_test'], visibility = ["//visibility:public"])
