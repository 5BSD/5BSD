load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_script_wrapper")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
cc_binary(name = "while1", srcs = ["while1.c"], copts = ["-fPIE"], linkopts = ["-pie"])
utility_installation(name = "arch_install", program = "while1", manual = None, package = "tests", bindir = "/usr/tests/usr.bin/procstat")
bsd_script_wrapper(name = "procstat_test", body = "procstat_test.sh", interpreter = "/usr/libexec/atf-sh",
    cat = "@bsd_sdk//toolchain:cat", cat_runtime = ["@bsd_sdk//toolchain:cat_runtime"], redirect = "@bsd_sdk//toolchain:stdout_redirect")
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = ["procstat_test"], interfaces = {"procstat_test": "atf"})
bsd_install_file(name = "install_shell", src = ":procstat_test", destination = "/usr/tests/usr.bin/procstat/procstat_test",
    owner = "root", group = "wheel", mode = "0555", install_tags = ["package=tests"])
bsd_install_file(name = "install_kyuafile", src = ":kyuafile", destination = "/usr/tests/usr.bin/procstat/Kyuafile",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=tests"])
bsd_install_manifest(name = "install_manifest", entries = [":install_shell", ":install_kyuafile", ":arch_install_binary", ":arch_install_symbols_file"], visibility = ["//visibility:public"])
