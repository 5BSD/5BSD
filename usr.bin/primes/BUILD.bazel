# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = "primes", srcs = ["pattern.c", "pr_tbl.c", "primes.c", "spsp.c"], deps = [":headers", "//lib/msun:m"], dynamic_deps = ["//lib/msun:m_shared"], copts = ["-fPIE"], linkopts = ["-pie"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "primes", manual = None, package = "utilities", bindir = "/usr/bin", man_section = "1")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive", visibility = ["//usr.bin:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/bin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)




load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "headers", hdrs = ["primes.h"], strip_include_prefix = ".", visibility = ["//visibility:public"])
exports_files(["pr_tbl.c"], visibility = ["//usr.bin/factor:__pkg__"])

# Cases preserve the maintained factor/tests shell expectations.
load("//tools/build/bazel:bsd_compare_test.bzl", "bsd_compare_test")
bsd_compare_test(name = "invalid_range_test", program = ":primes", arguments = ['--', '2', '1'],
    expected = "bazel-fixtures/invalid_range.out", expected_stderr = "bazel-fixtures/invalid_range.err", expected_exit = 1,
    runtime_lib = ["//lib/msun:m_shared"] + ["@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"],
    runner = "//tools/build/bazel:byte_compare_runner", size = "small")
bsd_compare_test(name = "negative_numbers_not_allowed_test", program = ":primes", arguments = ['--', '-1', '0'],
    expected = "bazel-fixtures/negative_numbers_not_allowed.out", expected_stderr = "bazel-fixtures/negative_numbers_not_allowed.err", expected_exit = 1,
    runtime_lib = ["//lib/msun:m_shared"] + ["@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"],
    runner = "//tools/build/bazel:byte_compare_runner", size = "small")
bsd_compare_test(name = "no_primes_between_between_20_and_22_test", program = ":primes", arguments = ['20', '22'],
    expected = "bazel-fixtures/no_primes_between_between_20_and_22.out", expected_stderr = "bazel-fixtures/no_primes_between_between_20_and_22.err", expected_exit = 0,
    runtime_lib = ["//lib/msun:m_shared"] + ["@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"],
    runner = "//tools/build/bazel:byte_compare_runner", size = "small")
bsd_compare_test(name = "primes_in_20_to_50_range_test", program = ":primes", arguments = ['20', '50'],
    expected = "bazel-fixtures/primes_in_20_to_50_range.out", expected_stderr = "bazel-fixtures/primes_in_20_to_50_range.err", expected_exit = 0,
    runtime_lib = ["//lib/msun:m_shared"] + ["@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"],
    runner = "//tools/build/bazel:byte_compare_runner", size = "small")
test_suite(name = "tests", tests = [':invalid_range_test', ':negative_numbers_not_allowed_test', ':no_primes_between_between_20_and_22_test', ':primes_in_20_to_50_range_test'], visibility = ["//visibility:public"])
