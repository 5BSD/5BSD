load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
cc_library(name = "headers", deps = ["//kerberos5/tools/make-roken:headers", "//crypto/heimdal/lib/roken:headers"],
    visibility = ["//kerberos5:__subpackages__", "//usr.bin/compile_et:__pkg__"])
load(":sources.bzl", "ROKEN_SOURCES")
[cc_library(name = "roken" + suffix, srcs = ROKEN_SOURCES,
    deps = [":headers", "//lib/libcrypt:crypt", "//lib/libc:shared_link_objects"],
    implementation_deps = ["//kerberos5/include:config_headers", "//crypto/openssl:headers"],
    local_defines = ["HAVE_CONFIG_H"], copts = ["-fpie"] if suffix else [],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//kerberos5:__subpackages__", "//usr.bin/compile_et:__pkg__"])
 for suffix in ["", "_pie"]]
bsd_component_archive(name = "static_archive", groups = [":roken"])
bsd_component_archive(name = "pie_archive", groups = [":roken_pie"])
cc_shared_library(name = "roken_shared", deps = [":roken"],
    dynamic_deps = ["//lib/libcrypt:crypt_shared", "//lib/libc:c_shared"],
    shared_lib_name = "libroken.so.11",
    user_link_flags = ["-Wl,-soname,libroken.so.11", "-Wl,--version-script=$(location //crypto/heimdal/lib/roken:version-script.map)", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    additional_linker_inputs = ["//crypto/heimdal/lib/roken:version-script.map"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//usr.bin/compile_et:__pkg__"])

# PIC own-object capture also supports independent original DSO comparisons.
bsd_component_archive(name = "pic_archive", groups = [":roken"], pic = True)
load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive", visibility = ["//kerberos5:__subpackages__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=kerberos","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
