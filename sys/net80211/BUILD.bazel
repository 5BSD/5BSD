amd64_generic_module_objects(name = "wlan_default_module", srcs = [source for source in _WLAN_SOURCES if source not in _WLAN_UNUSED_FUNCTION_SOURCES],
    deps = _WLAN_DEPS + ["//sys/amd64/conf:generic_opt_ddb_header", "//sys/amd64/conf:generic_opt_inet_header", "//sys/amd64/conf:generic_opt_inet6_header", "//sys/amd64/conf:generic_opt_tdma_header", "//sys/amd64/conf:generic_opt_wlan_header"], copts = [])
[cross_generic_module_objects(arch = arch, name = "wlan_default_module", srcs = [source for source in _WLAN_SOURCES if source not in _WLAN_UNUSED_FUNCTION_SOURCES],
    deps = _WLAN_DEPS + ["//sys/" + arch + "/conf:generic_" + option + "_header" for option in ["opt_ddb", "opt_inet", "opt_inet6", "opt_tdma", "opt_wlan"]], copts = [])
 for arch in ["arm64", "riscv"]]

amd64_generic_module_objects(name = "wlan_unused_function_module", srcs = _WLAN_UNUSED_FUNCTION_SOURCES,
    deps = _WLAN_DEPS + ["//sys/amd64/conf:generic_opt_ddb_header", "//sys/amd64/conf:generic_opt_inet_header", "//sys/amd64/conf:generic_opt_inet6_header", "//sys/amd64/conf:generic_opt_tdma_header", "//sys/amd64/conf:generic_opt_wlan_header"], copts = ["-Wno-unused-function"])
[cross_generic_module_objects(arch = arch, name = "wlan_unused_function_module", srcs = _WLAN_UNUSED_FUNCTION_SOURCES,
    deps = _WLAN_DEPS + ["//sys/" + arch + "/conf:generic_" + option + "_header" for option in ["opt_ddb", "opt_inet", "opt_inet6", "opt_tdma", "opt_wlan"]], copts = ["-Wno-unused-function"])
 for arch in ["arm64", "riscv"]]

# Forward compiler outputs in SRCS order without archive extraction actions.
[bsd_component_selected_objects(
    name = prefix + source[:-2] + "_object",
    group = ":" + prefix + ("wlan_unused_function_module_ctf" if source in _WLAN_UNUSED_FUNCTION_SOURCES else "wlan_default_module_ctf"),
    object_names = [source[:-2] + ".o"],
) for prefix in ["", "arm64_", "riscv_"] for source in _WLAN_SOURCES]
[filegroup(name = prefix + "wlan_module_object_files",
    srcs = [":" + prefix + source[:-2] + "_object" for source in _WLAN_SOURCES],
    visibility = ["//sys/modules/wlan:__pkg__"])
 for prefix in ["", "arm64_", "riscv_"]]

