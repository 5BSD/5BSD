load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "socket_headers", hdrs = ["ng_hci.h", "ng_l2cap.h", "ng_btsocket.h"],
    includes = ["../../.."], visibility = ["//sys/dev/mac_capability:__pkg__"])

