load("@rules_cc//cc:defs.bzl", "cc_library")
# Included implementation files are inputs to vdev.c, not separate objects.
cc_library(name = "makefs_zfs_inputs", hdrs = ["zfs/zfsimpl.h", "zfs/fletcher.c", "zfs/sha256.c"], strip_include_prefix = ".", visibility = ["//usr.sbin/makefs:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")
bsd_source_headers(name = "libefi_headers", hdrs = ['zfs/zfsimpl.h'], visibility = ["//stand/efi/libefi:__pkg__"])

bsd_source_headers(name = "standalone_sa_headers", hdrs = ['zfs/blake3_zfs.c', 'zfs/blkptr.c', 'zfs/fletcher.c', 'zfs/gzip.c', 'zfs/lzjb.c', 'zfs/sha256.c', 'zfs/skein_zfs.c', 'zfs/zfsimpl.h', 'zfs/zfssubr.c', 'zfs/zle.c'], visibility = ["//stand/libsa:__pkg__"])

bsd_source_headers(name = "standalone_sa_efi_headers", hdrs = ['zfs/blake3_zfs.c', 'zfs/blkptr.c', 'zfs/fletcher.c', 'zfs/gzip.c', 'zfs/lzjb.c', 'zfs/sha256.c', 'zfs/skein_zfs.c', 'zfs/zfsimpl.h', 'zfs/zfssubr.c', 'zfs/zle.c'], visibility = ["//stand/libsa:__pkg__"])

bsd_source_headers(name = "efi_loader_entry_headers", hdrs = ['zfs/zfsimpl.h'], visibility = ["//stand/efi/loader:__pkg__"])

bsd_source_headers(name = 'efi_boot1_headers', hdrs = ['zfs/blake3_zfs.c', 'zfs/blkptr.c', 'zfs/fletcher.c', 'zfs/gzip.c', 'zfs/lzjb.c', 'zfs/sha256.c', 'zfs/skein_zfs.c', 'zfs/zfsimpl.h', 'zfs/zfssubr.c', 'zfs/zle.c'], visibility = ["//stand/efi/boot1:__pkg__"])

bsd_source_headers(name = 'efi_loader_4th_headers', hdrs = ['zfs/zfsimpl.h'], visibility = ["//stand/efi/loader_4th:__pkg__"])

bsd_source_headers(name = 'efi_loader_simp_headers', hdrs = ['zfs/zfsimpl.h'], visibility = ["//stand/efi/loader_simp:__pkg__"])
