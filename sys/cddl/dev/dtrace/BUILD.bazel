load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "layout_headers", hdrs = ["dtrace_cddl.h"], strip_include_prefix = "/sys", visibility = ["//cddl/lib/libdtrace:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")
bsd_source_headers(name = "tracing_module_headers", hdrs = ["dtrace_cddl.h"],
    includes = ["."], visibility = ["//sys/dev/dttransport:__pkg__", "//sys/cddl/dev/hypertrace:__pkg__", "//sys/security/audit:__pkg__", "//sys/cddl/dev/dtmalloc:__pkg__", "//sys/fs/nfsclient:__pkg__", "//sys/cddl/dev/profile:__pkg__", "//sys/cddl/dev:__pkg__", "//sys/cddl/dev/sdt:__pkg__"])

# SDT includes this physical header through ../dtrace, without a search-root override.
bsd_source_headers(name = "sdt_layout_headers", hdrs = ["dtrace_cddl.h"], visibility = ["//sys/cddl/dev/sdt:__pkg__"])
