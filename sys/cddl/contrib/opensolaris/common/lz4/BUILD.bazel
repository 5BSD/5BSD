load("@rules_cc//cc:defs.bzl", "cc_library")
exports_files(["lz4.c"], visibility = ["//usr.bin/vtfontcvt:__pkg__"])
cc_library(
    name = "headers",
    hdrs = ["lz4.h"],
    strip_include_prefix = ".",
    visibility = ["//usr.bin/vtfontcvt:__pkg__"],
)

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

filegroup(name = 'standalone_sa_lz4_sources', srcs = ['lz4.c'], visibility = ["//stand/libsa:__pkg__"])

bsd_source_headers(name = "standalone_sa_headers", hdrs = ['lz4.h'], visibility = ["//stand/libsa:__pkg__"])

bsd_source_headers(name = "standalone_sa_efi_headers", hdrs = ['lz4.h'], visibility = ["//stand/libsa:__pkg__"])

bsd_source_headers(name = "efi_loader_entry_headers", hdrs = ['lz4.h'], visibility = ["//stand/efi/loader:__pkg__"])

bsd_source_headers(name = 'efi_boot1_headers', hdrs = ['lz4.h'], visibility = ["//stand/efi/boot1:__pkg__"])

bsd_source_headers(name = 'efi_loader_4th_headers', hdrs = ['lz4.h'], visibility = ["//stand/efi/loader_4th:__pkg__"])

bsd_source_headers(name = 'efi_loader_simp_headers', hdrs = ['lz4.h'], visibility = ["//stand/efi/loader_simp:__pkg__"])
