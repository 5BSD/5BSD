load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "kernel_headers", hdrs = ["chacha.h", "_chacha.h"], includes = ["../.."], visibility = ["//sys/libkern:__pkg__"])

# arc4random embeds chacha.c; expose only that implementation and its headers.
cc_library(name = "libc_headers", hdrs = ["chacha.h", "_chacha.h"],
    strip_include_prefix = "/sys", visibility = [":__pkg__"])
cc_library(name = "libc_embedded", hdrs = ["chacha.c"],
    strip_include_prefix = ".", deps = [":libc_headers"],
    visibility = ["//lib/libc/gen:__pkg__"])

# Core kernel physical prerequisites.
load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")
bsd_source_headers(name = "core_kernel_kern_shutdown_headers", hdrs = ["_chacha.h", "chacha.h"],
    visibility = ["//sys/kern:__pkg__"])

# Physical prerequisites for native codec and crypto built-ins.
bsd_source_headers(name = "codecs_crypto_kernel_chacha_headers", hdrs = ["_chacha.h", "chacha.h"],
    visibility = ["//sys/contrib/ck:__pkg__", "//sys/contrib/libb2:__pkg__", "//sys/contrib/libnv:__pkg__", "//sys/contrib/libsodium:__pkg__", "//sys/contrib/xz-embedded:__pkg__", "//sys/contrib/zlib:__pkg__", "//sys/contrib/zstd:__pkg__", "//sys/crypto:__pkg__", "//sys/crypto/camellia:__pkg__", "//sys/crypto/chacha20:__pkg__", "//sys/crypto/rijndael:__pkg__", "//sys/crypto/siphash:__pkg__", "//sys/crypto/skein:__pkg__", "//sys/dev/random:__pkg__", "//sys/dev/xz:__pkg__", "//sys/dev/zlib:__pkg__"])
bsd_source_headers(name = "codecs_crypto_kernel_random_harvestq_headers", hdrs = ["_chacha.h"],
    visibility = ["//sys/contrib/ck:__pkg__", "//sys/contrib/libb2:__pkg__", "//sys/contrib/libnv:__pkg__", "//sys/contrib/libsodium:__pkg__", "//sys/contrib/xz-embedded:__pkg__", "//sys/contrib/zlib:__pkg__", "//sys/contrib/zstd:__pkg__", "//sys/crypto:__pkg__", "//sys/crypto/camellia:__pkg__", "//sys/crypto/chacha20:__pkg__", "//sys/crypto/rijndael:__pkg__", "//sys/crypto/siphash:__pkg__", "//sys/crypto/skein:__pkg__", "//sys/dev/random:__pkg__", "//sys/dev/xz:__pkg__", "//sys/dev/zlib:__pkg__"])

load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")
load("//tools/build/bazel:kernel_common.bzl", "KERNEL_BUILTIN_WARNING_FLAGS")

# Native amd64 GENERIC codec and crypto built-ins.
amd64_generic_kernel_objects(name = "generic_codecs_crypto_chacha", srcs = ["chacha.c"],
    deps = ["//sys/crypto/chacha20:codecs_crypto_kernel_chacha_headers"], early_deps = [],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS, copts = [])
amd64_generic_kernel_objects(name = "generic_codecs_crypto_chacha-sw", srcs = ["chacha-sw.c"],
    deps = ["//sys/crypto/camellia:codecs_crypto_kernel_camellia_headers", "//sys/crypto/chacha20:codecs_crypto_kernel_chacha_headers", "//sys/crypto/rijndael:codecs_crypto_kernel_blake2-sw_headers", "//sys/opencrypto:codecs_crypto_kernel_chacha-sw_headers"], early_deps = [],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS, copts = [])

# hash.c embeds this implementation with its own source-level configuration.
bsd_source_headers(name = "codecs_crypto_kernel_hash_headers", hdrs = ["_chacha.h", "chacha.c", "chacha.h"], visibility = ["//sys/dev/random:__pkg__"])
