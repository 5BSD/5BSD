load("@rules_cc//cc:defs.bzl", "cc_library")
exports_files(['sha256c.c', 'sha512c.c'], visibility = ["//lib/libmd:__pkg__"])
cc_library(
    name = "headers",
    hdrs = ['sha224.h', 'sha256.h', 'sha384.h', 'sha512.h', 'sha512t.h', 'sha256c_impl.h', 'sha512c_impl.h'],
    strip_include_prefix = "/sys/crypto/sha2",
