load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(name = "kernel_headers", hdrs = ["rijndael.h"], strip_include_prefix = "/sys",
    visibility = ["//sys/opencrypto:__pkg__"])

# Physical source headers: the kernel compilation context supplies -Isys.
cc_library(name = "wlan_headers", hdrs = ["rijndael.h", "rijndael_local.h"],
    visibility = ["//sys/net80211:__pkg__"])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")

# Shared AES implementation for CCMP and GCMP; neither source uses opt_wlan.h.
amd64_generic_module_objects(name = "wlan_module", srcs = ["rijndael-alg-fst.c", "rijndael-api.c"], deps = [":wlan_headers"])
[cross_generic_module_objects(arch = arch, name = "wlan_module",
    srcs = ["rijndael-alg-fst.c", "rijndael-api.c"], deps = [":wlan_headers"])
 for arch in ["arm64", "riscv"]]
