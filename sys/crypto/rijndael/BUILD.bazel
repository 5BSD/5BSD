load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")
load("//tools/build/bazel:kernel_common.bzl", "KERNEL_BUILTIN_WARNING_FLAGS")

# Native amd64 GENERIC codec and crypto built-ins.
amd64_generic_kernel_objects(name = "generic_codecs_crypto_rijndael-alg-fst", srcs = ["rijndael-alg-fst.c"],
    deps = ["//sys/crypto/rijndael:codecs_crypto_kernel_rijndael-alg-fst_headers"], early_deps = [],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS, copts = [])
amd64_generic_kernel_objects(name = "generic_codecs_crypto_rijndael-api-fst", srcs = ["rijndael-api-fst.c"],
    deps = ["//sys/crypto/rijndael:codecs_crypto_kernel_rijndael-api-fst_headers"], early_deps = [],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS, copts = [])
amd64_generic_kernel_objects(name = "generic_codecs_crypto_rijndael-api", srcs = ["rijndael-api.c"],
    deps = ["//sys/crypto/rijndael:codecs_crypto_kernel_blake2-sw_headers"], early_deps = [],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS, copts = [])

# Physical prerequisites for native SIMD crypto built-ins.
bsd_source_headers(name = "simd_crypto_kernel_aesni_wrap_headers", hdrs = ["rijndael.h"],
    visibility = ["//sys/crypto:__pkg__"])

load("//tools/build/bazel:kernel_amd64.bzl", "AMD64_KERNEL_WARNING_FLAGS")

amd64_generic_module_objects(name = "crypto_rijndael-alg-fst_module", srcs = ["rijndael-alg-fst.c"],
    deps = ["//sys/crypto/rijndael:codecs_crypto_kernel_rijndael-alg-fst_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = ["SKEIN_ASM", "SKEIN_USE_ASM=1792"])

amd64_generic_module_objects(name = "crypto_rijndael-api_module", srcs = ["rijndael-api.c"],
    deps = ["//sys/crypto/rijndael:wlan_kernel_ieee80211_crypto_ccmp_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = ["SKEIN_ASM", "SKEIN_USE_ASM=1792"])

amd64_generic_module_objects(name = "crypto_rijndael-api-fst_module", srcs = ["rijndael-api-fst.c"],
