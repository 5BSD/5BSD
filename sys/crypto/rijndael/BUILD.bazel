    visibility = ["//sys/net80211:__pkg__", "//sys/crypto/chacha20:__pkg__", "//sys/crypto/rijndael:__pkg__", "//sys/crypto:__pkg__", "//sys/opencrypto:__pkg__", "//sys/netipsec:__pkg__", "//sys/dev/mlx5:__pkg__", "//sys/dev/cxgbe:__pkg__", "//sys/dev/safexcel:__pkg__"])
