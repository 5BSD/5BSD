load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(name = "kernel_headers", hdrs = ["camellia.h"], strip_include_prefix = "/sys",
    visibility = ["//sys/opencrypto:__pkg__"])

# OpenCrypto built-in prerequisites.
load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")
bsd_source_headers(name = "opencrypto_kernel_crypto_headers", hdrs = ["camellia.h"],
    visibility = ["//sys/opencrypto:__pkg__", "//sys/crypto/camellia:__pkg__", "//sys/crypto/chacha20:__pkg__", "//sys/crypto:__pkg__"])
bsd_source_headers(name = "opencrypto_kernel_cryptodev_headers", hdrs = ["camellia.h"],
    visibility = ["//sys/opencrypto:__pkg__"])
bsd_source_headers(name = "opencrypto_kernel_cryptosoft_headers", hdrs = ["camellia.h"],
    visibility = ["//sys/opencrypto:__pkg__"])
bsd_source_headers(name = "opencrypto_kernel_xform_aes_cbc_headers", hdrs = ["camellia.h"],
    visibility = ["//sys/opencrypto:__pkg__"])
bsd_source_headers(name = "opencrypto_kernel_xform_aes_icm_headers", hdrs = ["camellia.h"],
    visibility = ["//sys/opencrypto:__pkg__"])
bsd_source_headers(name = "opencrypto_kernel_xform_aes_xts_headers", hdrs = ["camellia.h"],
    visibility = ["//sys/opencrypto:__pkg__"])
bsd_source_headers(name = "opencrypto_kernel_xform_chacha20_poly1305_headers", hdrs = ["camellia.h"],
    visibility = ["//sys/opencrypto:__pkg__"])
bsd_source_headers(name = "opencrypto_kernel_xform_cml_headers", hdrs = ["camellia.h"],
    visibility = ["//sys/opencrypto:__pkg__"])
bsd_source_headers(name = "opencrypto_kernel_xform_gmac_headers", hdrs = ["camellia.h"],
    visibility = ["//sys/opencrypto:__pkg__"])
bsd_source_headers(name = "opencrypto_kernel_xform_null_headers", hdrs = ["camellia.h"],
    visibility = ["//sys/opencrypto:__pkg__"])

# Native OpenZFS built-in physical prerequisites and compatibility overlay roots.
bsd_source_headers(name = "openzfs_kernel_crypto_os_headers", hdrs = ["camellia.h"],
    visibility = ["//sys/contrib/openzfs:__pkg__"])

# Native Mellanox physical prerequisites and ordered OFED/LinuxKPI roots.
bsd_source_headers(name = "mlx_kernel_mlx5_ipsec_fs_headers", hdrs = ["camellia.h"],
    visibility = ["//sys/dev/mlx5:__pkg__"])

# Physical prerequisites for native network policy built-ins.
bsd_source_headers(name = "network_policy_kernel_ipsec_pcb_headers", hdrs = ["camellia.h"],
    visibility = ["//contrib/openbsd-pf/sys/net:__pkg__", "//contrib/openbsd-pf/sys/netinet:__pkg__", "//sys/net:__pkg__", "//sys/netgraph:__pkg__", "//sys/netgraph/bluetooth:__pkg__", "//sys/netinet:__pkg__", "//sys/netinet/cc:__pkg__", "//sys/netipsec:__pkg__", "//sys/netlink:__pkg__", "//sys/netpfil/dummynet:__pkg__", "//sys/netpfil/openbsd-pf:__pkg__"])

# Physical prerequisites for native codec and crypto built-ins.
bsd_source_headers(name = "codecs_crypto_kernel_camellia_headers", hdrs = ["camellia.h"],
    visibility = ["//sys/contrib/ck:__pkg__", "//sys/contrib/libb2:__pkg__", "//sys/contrib/libnv:__pkg__", "//sys/contrib/libsodium:__pkg__", "//sys/contrib/xz-embedded:__pkg__", "//sys/contrib/zlib:__pkg__", "//sys/contrib/zstd:__pkg__", "//sys/crypto:__pkg__", "//sys/crypto/camellia:__pkg__", "//sys/crypto/chacha20:__pkg__", "//sys/crypto/rijndael:__pkg__", "//sys/crypto/siphash:__pkg__", "//sys/crypto/skein:__pkg__", "//sys/dev/random:__pkg__", "//sys/dev/xz:__pkg__", "//sys/dev/zlib:__pkg__"])

load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")
load("//tools/build/bazel:kernel_common.bzl", "KERNEL_BUILTIN_WARNING_FLAGS")

# Native amd64 GENERIC codec and crypto built-ins.
amd64_generic_kernel_objects(name = "generic_codecs_crypto_camellia", srcs = ["camellia.c"],
    deps = ["//sys/crypto/camellia:codecs_crypto_kernel_camellia_headers"], early_deps = [],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS, copts = [])
amd64_generic_kernel_objects(name = "generic_codecs_crypto_camellia-api", srcs = ["camellia-api.c"],
    deps = ["//sys/crypto/camellia:codecs_crypto_kernel_camellia_headers"], early_deps = [],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS, copts = [])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")

load("//tools/build/bazel:kernel_amd64.bzl", "AMD64_KERNEL_WARNING_FLAGS")

amd64_generic_module_objects(name = "crypto_camellia_module", srcs = ["camellia.c", "camellia-api.c"],
    deps = ["//sys/crypto/camellia:opencrypto_kernel_crypto_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = ["SKEIN_ASM", "SKEIN_USE_ASM=1792"])
