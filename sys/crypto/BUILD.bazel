# SPDX-License-Identifier: BSD-2-Clause
exports_files(["md4c.c", "md5c.c"], visibility = ["//lib/libmd:__pkg__"])

load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "intake_headers", hdrs = ["intake.h"], includes = [".."], visibility = ["//visibility:public"])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
cc_library(name = "sha1_headers", hdrs = ["sha1.h"], includes = [".."], visibility = ["//sys/security/mac_veriexec:__pkg__", "//sys/opencrypto:__pkg__", "//sys/netgraph:__pkg__", "//sys/netinet:__pkg__"])
amd64_generic_module_objects(name = "sha1_module", srcs = ["sha1.c"], deps = [":sha1_headers"])

cc_library(name = "rc4_headers", hdrs = ["rc4/rc4.h"], strip_include_prefix = "/sys",
    visibility = ["//sys/modules/rc4:__pkg__", "//sys/netgraph:__pkg__"])
amd64_generic_module_objects(name = "rc4_module", srcs = ["rc4/rc4.c"], deps = [":rc4_headers"])

cc_library(name = "curve25519_headers", hdrs = ["curve25519.h"], strip_include_prefix = "/sys",
    visibility = ["//sys/opencrypto:__pkg__"])

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")

[cross_generic_module_objects(
    arch = arch,
    name = "rc4_module",
    srcs = ["rc4/rc4.c"],
    deps = [":rc4_headers"],
) for arch in ["arm64", "riscv"]]

exports_files(["sha1.c"], visibility = ["//sys/netgraph:__pkg__", "//sys/netinet:__pkg__"])

# IPv4 built-in prerequisites.
load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")
bsd_source_headers(name = "ipv4_kernel_sctp_crc32_headers", hdrs = ["sha1.h"],
    visibility = ["//sys/netinet:__pkg__"])

# Network built-in prerequisites.
bsd_source_headers(name = "net_kernel_if_ethersubr_headers", hdrs = ["sha1.h"],
    visibility = ["//sys/net:__pkg__"])

# OpenCrypto built-in prerequisites.
bsd_source_headers(name = "opencrypto_kernel_cbc_mac_headers", hdrs = ["sha1.h"],
    visibility = ["//sys/opencrypto:__pkg__"])
bsd_source_headers(name = "opencrypto_kernel_crypto_headers", hdrs = ["intake.h", "sha1.h"],
    visibility = ["//sys/opencrypto:__pkg__"])
bsd_source_headers(name = "opencrypto_kernel_cryptodev_headers", hdrs = ["curve25519.h", "sha1.h"],
    visibility = ["//sys/opencrypto:__pkg__"])
bsd_source_headers(name = "opencrypto_kernel_cryptosoft_headers", hdrs = ["sha1.h"],
    visibility = ["//sys/opencrypto:__pkg__"])
bsd_source_headers(name = "opencrypto_kernel_xform_cbc_mac_headers", hdrs = ["sha1.h"],
    visibility = ["//sys/opencrypto:__pkg__"])
bsd_source_headers(name = "opencrypto_kernel_xform_chacha20_poly1305_headers", hdrs = ["libsodium/limits.h", "libsodium/stddef.h", "libsodium/stdint.h", "libsodium/stdio.h", "libsodium/stdlib.h", "sha1.h"],
    includes = ["libsodium"],
    visibility = ["//sys/opencrypto:__pkg__"])
bsd_source_headers(name = "opencrypto_kernel_xform_gmac_headers", hdrs = ["sha1.h"],
    visibility = ["//sys/opencrypto:__pkg__"])
bsd_source_headers(name = "opencrypto_kernel_xform_null_headers", hdrs = ["sha1.h"],
    visibility = ["//sys/opencrypto:__pkg__"])
bsd_source_headers(name = "opencrypto_kernel_xform_poly1305_headers", hdrs = ["libsodium/limits.h", "libsodium/stddef.h", "libsodium/stdint.h", "libsodium/stdio.h", "libsodium/stdlib.h", "sha1.h"],
    includes = ["libsodium"],
    visibility = ["//sys/opencrypto:__pkg__"])
bsd_source_headers(name = "opencrypto_kernel_xform_rmd160_headers", hdrs = ["sha1.h"],
    visibility = ["//sys/opencrypto:__pkg__"])
bsd_source_headers(name = "opencrypto_kernel_xform_sha1_headers", hdrs = ["sha1.h"],
    visibility = ["//sys/opencrypto:__pkg__"])
bsd_source_headers(name = "opencrypto_kernel_xform_sha2_headers", hdrs = ["sha1.h"],
    visibility = ["//sys/opencrypto:__pkg__"])

# Native OpenZFS built-in physical prerequisites and compatibility overlay roots.
bsd_source_headers(name = "openzfs_kernel_crypto_os_headers", hdrs = ["sha1.h"],
    visibility = ["//sys/contrib/openzfs:__pkg__"])

# Native Mellanox physical prerequisites and ordered OFED/LinuxKPI roots.
bsd_source_headers(name = "mlx_kernel_mlx5_ipsec_fs_headers", hdrs = ["sha1.h"],
    visibility = ["//sys/dev/mlx5:__pkg__"])

# Physical prerequisites for native network policy built-ins.
bsd_source_headers(name = "network_policy_kernel_ipsec_pcb_headers", hdrs = ["sha1.h"],
    visibility = ["//contrib/openbsd-pf/sys/net:__pkg__", "//contrib/openbsd-pf/sys/netinet:__pkg__", "//sys/net:__pkg__", "//sys/netgraph:__pkg__", "//sys/netgraph/bluetooth:__pkg__", "//sys/netinet:__pkg__", "//sys/netinet/cc:__pkg__", "//sys/netipsec:__pkg__", "//sys/netlink:__pkg__", "//sys/netpfil/dummynet:__pkg__", "//sys/netpfil/openbsd-pf:__pkg__"])
