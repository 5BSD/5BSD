# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "kernel_headers", hdrs = ["siphash.h"], includes = ["../.."],
    visibility = ["//sys/kern:__pkg__", "//sys/fs/fuse:__pkg__"])

cc_library(name = "packet_filter_headers", hdrs = ["siphash.h"], strip_include_prefix = "/sys",
    visibility = ["//sys/netpfil:__subpackages__"])

# Core kernel physical prerequisites.
load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")
bsd_source_headers(name = "core_kernel_uipc_mbuf_headers", hdrs = ["siphash.h"],
    visibility = ["//sys/kern:__pkg__"])

# IPv4 built-in prerequisites.
bsd_source_headers(name = "ipv4_kernel_tcp_fastopen_headers", hdrs = ["siphash.h"],
    visibility = ["//sys/netinet:__pkg__"])
bsd_source_headers(name = "ipv4_kernel_tcp_subr_headers", hdrs = ["siphash.h"],
    visibility = ["//sys/netinet:__pkg__"])
bsd_source_headers(name = "ipv4_kernel_tcp_syncache_headers", hdrs = ["siphash.h"],
    visibility = ["//sys/netinet:__pkg__"])

# Physical prerequisites for native network policy built-ins.
bsd_source_headers(name = "network_policy_kernel_pf_headers", hdrs = ["siphash.h"],
    visibility = ["//contrib/openbsd-pf/sys/net:__pkg__", "//contrib/openbsd-pf/sys/netinet:__pkg__", "//sys/net:__pkg__", "//sys/netgraph:__pkg__", "//sys/netgraph/bluetooth:__pkg__", "//sys/netinet:__pkg__", "//sys/netinet/cc:__pkg__", "//sys/netipsec:__pkg__", "//sys/netlink:__pkg__", "//sys/netpfil/dummynet:__pkg__", "//sys/netpfil/openbsd-pf:__pkg__"])
