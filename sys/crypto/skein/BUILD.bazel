load("@rules_cc//cc:defs.bzl", "cc_library")
exports_files(['skein.c', 'skein_block.c', 'amd64/skein_block_asm.S'], visibility = ["//lib/libmd:__pkg__"])
cc_library(
    name = "headers",
    hdrs = ['skein.h', 'skein_port.h', 'skein_freebsd.h', 'skein_iv.h', 'skein_debug.h'],
    strip_include_prefix = "/sys/crypto/skein",
    visibility = ["//lib/libmd:__pkg__"],
)

exports_files(['skein.h', 'skein_port.h', 'skein_freebsd.h', 'skein_iv.h'], visibility = ["//lib/libmd:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

# Physical prerequisites for native codec and crypto built-ins.
bsd_source_headers(name = "codecs_crypto_kernel_skein_headers", hdrs = ["skein.h", "skein_freebsd.h", "skein_iv.h", "skein_port.h"],
    visibility = ["//sys/contrib/ck:__pkg__", "//sys/contrib/libb2:__pkg__", "//sys/contrib/libnv:__pkg__", "//sys/contrib/libsodium:__pkg__", "//sys/contrib/xz-embedded:__pkg__", "//sys/contrib/zlib:__pkg__", "//sys/contrib/zstd:__pkg__", "//sys/crypto:__pkg__", "//sys/crypto/camellia:__pkg__", "//sys/crypto/chacha20:__pkg__", "//sys/crypto/rijndael:__pkg__", "//sys/crypto/siphash:__pkg__", "//sys/crypto/skein:__pkg__", "//sys/dev/random:__pkg__", "//sys/dev/xz:__pkg__", "//sys/dev/zlib:__pkg__"])
bsd_source_headers(name = "codecs_crypto_kernel_skein_block_headers", hdrs = ["skein.h", "skein_freebsd.h", "skein_port.h"],
    visibility = ["//sys/contrib/ck:__pkg__", "//sys/contrib/libb2:__pkg__", "//sys/contrib/libnv:__pkg__", "//sys/contrib/libsodium:__pkg__", "//sys/contrib/xz-embedded:__pkg__", "//sys/contrib/zlib:__pkg__", "//sys/contrib/zstd:__pkg__", "//sys/crypto:__pkg__", "//sys/crypto/camellia:__pkg__", "//sys/crypto/chacha20:__pkg__", "//sys/crypto/rijndael:__pkg__", "//sys/crypto/siphash:__pkg__", "//sys/crypto/skein:__pkg__", "//sys/dev/random:__pkg__", "//sys/dev/xz:__pkg__", "//sys/dev/zlib:__pkg__"])

load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")
load("//tools/build/bazel:kernel_common.bzl", "KERNEL_BUILTIN_WARNING_FLAGS")

# Native amd64 GENERIC codec and crypto built-ins.
amd64_generic_kernel_objects(name = "generic_codecs_crypto_skein", srcs = ["skein.c"],
    deps = ["//sys/crypto/skein:codecs_crypto_kernel_skein_headers"], early_deps = [],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS, copts = [])
amd64_generic_kernel_objects(name = "generic_codecs_crypto_skein_block", srcs = ["skein_block.c"],
    deps = ["//sys/crypto/skein:codecs_crypto_kernel_skein_block_headers"], early_deps = [],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS, copts = [])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")

load("//tools/build/bazel:kernel_amd64.bzl", "AMD64_KERNEL_WARNING_FLAGS")

amd64_generic_module_objects(name = "crypto_skein_module", srcs = ["skein.c"],
    deps = ["//sys/crypto/skein:codecs_crypto_kernel_skein_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = ["SKEIN_ASM", "SKEIN_USE_ASM=1792"])

amd64_generic_module_objects(name = "crypto_skein_block_module", srcs = ["skein_block.c"],
    deps = ["//sys/crypto/skein:codecs_crypto_kernel_skein_block_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = ["SKEIN_ASM", "SKEIN_LOOP=995", "SKEIN_USE_ASM=1792"])

amd64_generic_module_objects(name = "crypto_skein_block_asm_module", srcs = ["amd64/skein_block_asm.S"],
    deps = [],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = ["-Wa,--noexecstack"], local_defines = ["ELF", "SKEIN_ASM", "SKEIN_LOOP=0", "SKEIN_USE_ASM=1792"])


filegroup(name = 'standalone_sa_skein_sources', srcs = ['skein.c'], visibility = ["//stand/libsa:__pkg__"])

filegroup(name = 'standalone_sa_skein_block_sources', srcs = ['skein_block.c'], visibility = ["//stand/libsa:__pkg__"])

bsd_source_headers(name = "standalone_sa_headers", hdrs = ['skein.h', 'skein_freebsd.h', 'skein_iv.h', 'skein_port.h'], visibility = ["//stand/libsa:__pkg__"])

bsd_source_headers(name = "standalone_sa_efi_headers", hdrs = ['skein.h', 'skein_freebsd.h', 'skein_iv.h', 'skein_port.h'], visibility = ["//stand/libsa:__pkg__"])
