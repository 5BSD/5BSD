    strip_include_prefix = "generic_options", visibility = ["//sys/cam:__pkg__", "//sys/fs:__subpackages__", "//sys/ufs:__subpackages__", "//sys/net80211:__pkg__"])
 for option in ["ddb", "pseudofs", "tmpfs"]]

