#
# 5BSD default kernel configuration.
#
# GENERIC plus 5BSD identity.  The mac_capability capability plane (the TCB) is
# MANDATORY and is compiled in unconditionally (standard, see sys/conf/files) --
# it is never a loadable module and cannot be compiled out; a 5BSD kernel does
# not come up without it.  The security policies below are also compiled in so
# ARM64 has the same trust-boundary policy as AMD64.
#

include GENERIC

ident		VBSD

options 	OES			# OpenEndpointSecurity
options 	MAC_ABAC		# Attribute-based access control MAC policy

# Compile verified-execution enforcement into the trusted kernel rather than
# relying on a late-loadable policy.  It remains inactive unless a verified
# manifest is supplied and enforcement is explicitly entered.
options 	MAC_VERIEXEC
options 	MAC_VERIEXEC_SHA256
device		mac_veriexec_parser
