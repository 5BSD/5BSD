exports_files(["minidump.h"], visibility = ["//lib/libkvm:__pkg__"])

load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "kernel_headers", hdrs = glob(["*.h"]),
    strip_include_prefix = ".", include_prefix = "machine", visibility = ["//visibility:public"])

# Preserve the architecture's real machine/../linux include relationship.
filegroup(name = "architecture_view_machine_sources", srcs = glob(["*.h"]))
load("//tools/build/bazel:bsd_architecture_headers.bzl", "bsd_architecture_headers")
bsd_architecture_headers(
    name = "linux_module_headers",
    headers = {
        ":architecture_view_machine_sources": "machine",
        "//sys/arm64/linux:module_header_sources": "linux",
    },
    visibility = ["//sys/dev/mfi:__pkg__", "//sys/dev/mrsas:__pkg__"],
)

filegroup(name = "standalone_lua_headers", srcs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'endian.h', 'metadata.h', 'param.h', 'setjmp.h'], visibility = ["//stand/liblua:__pkg__"])

filegroup(name = "libefi_headers", srcs = ['_armreg.h', '_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'armreg.h', 'endian.h', 'metadata.h', 'param.h'], visibility = ["//stand/efi/libefi:__pkg__"])

filegroup(name = "loader_fdt_headers", srcs = ['_limits.h', '_stdint.h', '_types.h', 'elf.h', 'endian.h', 'param.h'], visibility = ["//stand/fdt:__pkg__", "//stand/efi/fdt:__pkg__"])

filegroup(name = "standalone_ficl_headers", srcs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'endian.h', 'metadata.h', 'param.h', 'setjmp.h'], visibility = ["//stand/ficl:__pkg__"])

filegroup(name = "standalone_sa_arch_headers", srcs = ['_armreg.h', '_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'armreg.h', 'asm.h', 'atomic.h', 'cpufunc.h', 'debug_monitor.h', 'elf.h', 'endian.h', 'fpu.h', 'md_var.h', 'param.h', 'pcb.h', 'proc.h', 'setjmp.h', 'signal.h', 'ucontext.h', 'vfp.h'], visibility = ["//stand/libsa:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

bsd_source_headers(name = 'efi_loader_aarch64_headers', hdrs = ['_armreg.h', '_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'armreg.h', 'atomic.h', 'cpufunc.h', 'elf.h', 'endian.h', 'exec.h', 'metadata.h', 'param.h', 'psl.h', 'setjmp.h'], visibility = ["//stand/efi/loader:__pkg__"])

bsd_source_headers(name = 'efi_boot1_aarch64_headers', hdrs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'elf.h', 'endian.h', 'param.h'], visibility = ["//stand/efi/boot1:__pkg__"])

bsd_source_headers(name = 'efi_gptboot_aarch64_headers', hdrs = ['_limits.h', '_stdint.h', '_types.h', 'elf.h', 'endian.h', 'param.h'], visibility = ["//stand/efi/gptboot:__pkg__"])
