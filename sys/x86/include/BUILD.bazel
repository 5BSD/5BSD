load("@rules_cc//cc:defs.bzl", "cc_library")

# Preserve nested architecture headers under the same logical include namespace.
cc_library(name = "kernel_headers", hdrs = glob(["**/*.h"]),
    strip_include_prefix = ".", include_prefix = "x86", visibility = ["//visibility:public"])

cc_library(name = "busdma_internal_headers", hdrs = ["busdma_impl.h"], includes = ["../.."], visibility = ["//sys/x86/x86:__pkg__"])

# Explicit source-header closure for the amd64 bhyve engine.
cc_library(name = "bhyve_engine_headers", hdrs = ['apicreg.h'], strip_include_prefix = "/sys", visibility = ["//usr.sbin/bhyve:__pkg__"])

filegroup(name = "boot2_headers", srcs = ['_limits.h', '_stdint.h', '_types.h', 'elf.h', 'endian.h', 'psl.h'], visibility = ["//stand/i386/boot2:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")
filegroup(name = "standalone_lua_headers", srcs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'endian.h', 'metadata.h', 'setjmp.h'], visibility = ["//stand/liblua:__pkg__"])

filegroup(name = "libefi_headers", srcs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'endian.h', 'metadata.h'], visibility = ["//stand/efi/libefi:__pkg__"])

filegroup(name = "loader_fdt_headers", srcs = ['_limits.h', '_stdint.h', '_types.h', 'elf.h', 'endian.h'], visibility = ["//stand/fdt:__pkg__", "//stand/efi/fdt:__pkg__"])

filegroup(name = "standalone_ficl_headers", srcs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'endian.h', 'metadata.h', 'setjmp.h'], visibility = ["//stand/ficl:__pkg__"])

filegroup(name = "standalone_sa_arch_headers", srcs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'endian.h', 'fpu.h', 'segments.h', 'setjmp.h', 'signal.h', 'specialreg.h', 'ucontext.h', 'x86_var.h'], visibility = ["//stand/libsa:__pkg__"])

bsd_source_headers(name = "efi_loader_entry_headers", hdrs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'elf.h', 'endian.h', 'frame.h', 'metadata.h', 'psl.h', 'segments.h', 'setjmp.h', 'specialreg.h'], visibility = ["//stand/efi/loader:__pkg__"])

bsd_source_headers(name = 'efi_boot1_headers', hdrs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'elf.h', 'endian.h'], visibility = ["//stand/efi/boot1:__pkg__"])

bsd_source_headers(name = 'efi_gptboot_headers', hdrs = ['_limits.h', '_stdint.h', '_types.h', 'elf.h', 'endian.h'], visibility = ["//stand/efi/gptboot:__pkg__"])

bsd_source_headers(name = 'efi_loader_4th_headers', hdrs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'elf.h', 'endian.h', 'frame.h', 'metadata.h', 'psl.h', 'segments.h', 'setjmp.h', 'specialreg.h'], visibility = ["//stand/efi/loader_4th:__pkg__"])

bsd_source_headers(name = 'efi_loader_simp_headers', hdrs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'elf.h', 'endian.h', 'frame.h', 'metadata.h', 'psl.h', 'segments.h', 'setjmp.h', 'specialreg.h'], visibility = ["//stand/efi/loader_simp:__pkg__"])

filegroup(name = "efi_loader_ia32_headers", srcs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'elf.h', 'endian.h', 'metadata.h', 'psl.h', 'segments.h', 'setjmp.h', 'specialreg.h'], visibility = ["//stand/efi/loader:__pkg__"])
