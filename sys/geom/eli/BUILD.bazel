load("@rules_cc//cc:defs.bzl", "cc_library")
exports_files(["g_eli_crypto.c", "g_eli_hmac.c", "g_eli_key.c", "pkcs5v2.c"], visibility = ["//lib/geom/eli:__pkg__"])
cc_library(name = "headers", hdrs = ["g_eli.h", "pkcs5v2.h"], strip_include_prefix = "/sys", deps = ["//sys/opencrypto:cryptodev_headers", "//sys/crypto/sha2:kernel_headers"], visibility = ["//lib/geom/eli:__pkg__", "//usr.sbin/fstyp:__pkg__"])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
amd64_generic_module_objects(srcs = ["g_eli.c", "g_eli_crypto.c", "g_eli_ctl.c", "g_eli_hmac.c", "g_eli_integrity.c", "g_eli_key.c", "g_eli_key_cache.c", "g_eli_privacy.c", "pkcs5v2.c"],
    deps = [":headers", "//sys/geom:kernel_headers", "//sys/crypto:intake_headers"])

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")

[cross_generic_module_objects(
    arch = arch,
    srcs = [
        "g_eli.c",
        "g_eli_crypto.c",
        "g_eli_ctl.c",
        "g_eli_hmac.c",
        "g_eli_integrity.c",
        "g_eli_key.c",
        "g_eli_key_cache.c",
        "g_eli_privacy.c",
        "pkcs5v2.c",
    ],
    deps = [
        ":headers",
        "//sys/geom:kernel_headers",
        "//sys/crypto:intake_headers",
    ],
) for arch in ["arm64", "riscv"]]

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

filegroup(name = 'standalone_sa_core_sources', srcs = ['g_eli_hmac.c', 'pkcs5v2.c', 'g_eli_key.c', 'g_eli_key_cache.c'], visibility = ["//stand/libsa:__pkg__"])

bsd_source_headers(name = "standalone_sa_headers", hdrs = ['g_eli.h', 'pkcs5v2.h'], visibility = ["//stand/libsa:__pkg__"])

bsd_source_headers(name = "standalone_sa_efi_headers", hdrs = ['g_eli.h', 'pkcs5v2.h'], visibility = ["//stand/libsa:__pkg__"])

bsd_source_headers(name = "efi_loader_entry_headers", hdrs = ['g_eli.h', 'pkcs5v2.h'], visibility = ["//stand/efi/loader:__pkg__"])

bsd_source_headers(name = 'efi_loader_4th_headers', hdrs = ['g_eli.h', 'pkcs5v2.h'], visibility = ["//stand/efi/loader_4th:__pkg__"])

bsd_source_headers(name = 'efi_loader_simp_headers', hdrs = ['g_eli.h', 'pkcs5v2.h'], visibility = ["//stand/efi/loader_simp:__pkg__"])

bsd_source_headers(name = 'efi_loader_aarch64_headers', hdrs = ['g_eli.h', 'pkcs5v2.h'], visibility = ["//stand/efi/loader:__pkg__"])

bsd_source_headers(name = 'efi_loader_riscv64_headers', hdrs = ['g_eli.h', 'pkcs5v2.h'], visibility = ["//stand/efi/loader:__pkg__"])

bsd_source_headers(name = 'efi_loader_simp_aarch64_headers', hdrs = ['g_eli.h', 'pkcs5v2.h'], visibility = ["//stand/efi/loader_simp:__pkg__"])

bsd_source_headers(name = 'efi_loader_4th_aarch64_headers', hdrs = ['g_eli.h', 'pkcs5v2.h'], visibility = ["//stand/efi/loader_4th:__pkg__"])

bsd_source_headers(name = 'efi_loader_simp_riscv64_headers', hdrs = ['g_eli.h', 'pkcs5v2.h'], visibility = ["//stand/efi/loader_simp:__pkg__"])

bsd_source_headers(name = 'efi_loader_4th_riscv64_headers', hdrs = ['g_eli.h', 'pkcs5v2.h'], visibility = ["//stand/efi/loader_4th:__pkg__"])

bsd_source_headers(name = "bios_libi386_headers", hdrs = ['g_eli.h'], visibility = ["//stand/i386/libi386:__pkg__"])

bsd_source_headers(name = "bios_loader_headers", hdrs = ['g_eli.h'], visibility = ["//stand/i386/loader:__pkg__"])

bsd_source_headers(name = "gpt_boot_headers", hdrs = ['g_eli.h'], visibility = ['//stand/i386/gptboot:__pkg__', '//stand/i386/isoboot:__pkg__'])

bsd_source_headers(name = "gpt_zfs_headers", hdrs = ['g_eli.h'], visibility = ['//stand/i386/gptzfsboot:__pkg__'])

bsd_source_headers(name = "bios_4th_headers", hdrs = ['g_eli.h'], visibility = ["//stand/i386/loader:__pkg__"])

bsd_source_headers(name = "bios_simp_headers", hdrs = ['g_eli.h'], visibility = ["//stand/i386/loader:__pkg__"])

bsd_source_headers(name = 'kboot_loader_headers', hdrs = ['g_eli.h'], visibility = ["//stand/kboot/kboot:__pkg__"])
