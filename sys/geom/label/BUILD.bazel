# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "headers", hdrs = ["g_label.h"], strip_include_prefix = "/sys", visibility = ["//lib/geom/label:__pkg__", "//sbin/geom:__pkg__"])

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
# Module-local policy from sys/modules/geom/geom_label/Makefile.
write_file(name = "module_options", out = "module_options/opt_geom.h", content = ["#define GEOM_LABEL 1", ""])
cc_library(name = "module_option_headers", hdrs = [":module_options"],
    strip_include_prefix = "module_options")
cc_library(name = "module_headers", hdrs = ["g_label_msdosfs.h"],
    includes = ["../.."], deps = [":module_option_headers"])
amd64_generic_module_objects(srcs = ["g_label.c", "g_label_disk_ident.c", "g_label_ext2fs.c", "g_label_flashmap.c", "g_label_gpt.c", "g_label_iso9660.c", "g_label_msdosfs.c", "g_label_ntfs.c", "g_label_ufs.c", "g_label_swaplinux.c"],
    deps = [":headers", ":module_headers", "//sys/geom:disk_headers", "//sys/geom:slice_headers", "//sys/geom:partition_headers", "//sys/geom/multipath:headers", "//sys/ufs/ffs:kernel_headers"])

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")

[cross_generic_module_objects(
    arch = arch,
    srcs = [
        "g_label.c",
        "g_label_disk_ident.c",
        "g_label_ext2fs.c",
        "g_label_flashmap.c",
        "g_label_gpt.c",
        "g_label_iso9660.c",
        "g_label_msdosfs.c",
        "g_label_ntfs.c",
        "g_label_ufs.c",
        "g_label_swaplinux.c",
    ],
    deps = [
        ":headers",
        ":module_headers",
        "//sys/geom:disk_headers",
        "//sys/geom:slice_headers",
        "//sys/geom:partition_headers",
        "//sys/geom/multipath:headers",
        "//sys/ufs/ffs:kernel_headers",
    ],
) for arch in ["arm64", "riscv"]]

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

# Physical storage core prerequisites; identical contexts share providers.
bsd_source_headers(name = "storage_core_kernel_g_label_headers", hdrs = ["g_label.h"],
    visibility = ["//sys/dev/ufshci:__pkg__", "//sys/geom/label:__pkg__", "//sys/dev/nvme:__pkg__", "//sys/geom:__pkg__", "//sys/cam:__pkg__"])
bsd_source_headers(name = "storage_core_kernel_g_label_msdosfs_headers", hdrs = ["g_label.h", "g_label_msdosfs.h"],
    visibility = ["//sys/dev/ufshci:__pkg__", "//sys/geom/label:__pkg__", "//sys/dev/nvme:__pkg__", "//sys/geom:__pkg__", "//sys/cam:__pkg__"])

# Native amd64 GENERIC storage core built-ins, using maintained per-source warnings.
load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")
load("//tools/build/bazel:kernel_common.bzl", "KERNEL_BUILTIN_WARNING_FLAGS")
amd64_generic_kernel_objects(name = "generic_storage_core_g_label", srcs = ["g_label.c"],
    deps = ["//sys/geom/label:storage_core_kernel_g_label_headers", "//sys/geom:storage_core_kernel_g_label_headers", "//sys/amd64/conf:storage_core_kernel_opt_geom_header"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_storage_core_g_label_ext2fs", srcs = ["g_label_ext2fs.c"],
    deps = ["//sys/geom/label:storage_core_kernel_g_label_headers", "//sys/geom:storage_core_kernel_g_label_ext2fs_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_storage_core_g_label_flashmap", srcs = ["g_label_flashmap.c"],
    deps = ["//sys/geom/label:storage_core_kernel_g_label_headers", "//sys/geom:storage_core_kernel_g_label_flashmap_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_storage_core_g_label_iso9660", srcs = ["g_label_iso9660.c"],
    deps = ["//sys/geom/label:storage_core_kernel_g_label_headers", "//sys/geom:storage_core_kernel_g_label_ext2fs_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_storage_core_g_label_msdosfs", srcs = ["g_label_msdosfs.c"],
    deps = ["//sys/geom/label:storage_core_kernel_g_label_msdosfs_headers", "//sys/geom:storage_core_kernel_g_label_ext2fs_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_storage_core_g_label_ntfs", srcs = ["g_label_ntfs.c"],
    deps = ["//sys/geom/label:storage_core_kernel_g_label_headers", "//sys/geom:storage_core_kernel_nvme_ns_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_storage_core_g_label_ufs", srcs = ["g_label_ufs.c"],
    deps = ["//sys/geom/label:storage_core_kernel_g_label_headers", "//sys/geom:storage_core_kernel_g_label_ext2fs_headers", "//sys/ufs/ffs:storage_core_kernel_g_label_ufs_headers", "//sys/ufs/ufs:storage_core_kernel_g_label_ufs_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_storage_core_g_label_gpt", srcs = ["g_label_gpt.c"],
    deps = ["//sys/geom/label:storage_core_kernel_g_label_headers", "//sys/geom:storage_core_kernel_g_label_gpt_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_storage_core_g_label_disk_ident", srcs = ["g_label_disk_ident.c"],
    deps = ["//sys/geom/label:storage_core_kernel_g_label_headers", "//sys/geom:storage_core_kernel_nvme_da_headers", "//sys/geom/multipath:storage_core_kernel_g_label_disk_ident_headers", "//sys/net:storage_core_kernel_cam_headers", "//sys/netinet:storage_core_kernel_cam_headers", "//sys/netinet6:storage_core_kernel_cam_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_storage_core_g_label_swaplinux", srcs = ["g_label_swaplinux.c"],
    deps = ["//sys/geom/label:storage_core_kernel_g_label_headers", "//sys/geom:storage_core_kernel_g_label_ext2fs_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)

load("//tools/build/bazel:bsd_public_headers.bzl", "public_header_installation")

# Public installed ABI headers follow include/Makefile source groups.
public_header_installation(name = "public_flat_geom_label_install", directory = "geom/label",
    files = {header: header.split("/")[-1] for header in glob(["*.h"], allow_empty = False)}, enabled = "//tools/build/bazel/config:includes_enabled")
