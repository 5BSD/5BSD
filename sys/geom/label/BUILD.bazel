load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "headers", hdrs = ["g_label.h"], strip_include_prefix = "/sys", visibility = ["//lib/geom/label:__pkg__"])

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
# Module-local policy from sys/modules/geom/geom_label/Makefile.
write_file(name = "module_options", out = "module_options/opt_geom.h", content = ["#define GEOM_LABEL 1", ""])
cc_library(name = "module_option_headers", hdrs = [":module_options"],
    strip_include_prefix = "module_options")
cc_library(name = "module_headers", hdrs = ["g_label_msdosfs.h"],
    includes = ["../.."], deps = [":module_option_headers"])
amd64_generic_module_objects(srcs = ["g_label.c", "g_label_disk_ident.c", "g_label_ext2fs.c", "g_label_flashmap.c", "g_label_gpt.c", "g_label_iso9660.c", "g_label_msdosfs.c", "g_label_ntfs.c", "g_label_ufs.c", "g_label_swaplinux.c"],
    deps = [":headers", ":module_headers", "//sys/geom:disk_headers", "//sys/geom:slice_headers", "//sys/geom:partition_headers", "//sys/geom/multipath:headers", "//sys/ufs/ffs:kernel_headers"])
