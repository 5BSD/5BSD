exports_files(["geom_bsd_enc.c"], visibility = ["//sbin/newfs:__pkg__", "//sys/modules/geom/geom_part/geom_part_bsd:__pkg__"])

load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = ["part/g_part_if.m"])

load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "kernel_headers", hdrs = ["geom.h", "geom_dbg.h", "geom_int.h"], includes = [".."],
    deps = ["//sys/contrib/ck:kernel_headers", "//sys/vm:kernel_headers"], visibility = ["//visibility:public"])

cc_library(name = "disk_headers", hdrs = ["geom_disk.h"], includes = [".."],
    deps = [":kernel_headers", "//sys/net:network_headers", "//sys/netinet:address_headers"], visibility = ["//visibility:public"])

exports_files(["part/g_part_gpt.c"], visibility = ["//sys/modules/geom/geom_part/geom_part_gpt:__pkg__"])
filegroup(name = "g_part_interface_header", srcs = [":g_part_if"], output_group = "header")
cc_library(name = "partition_headers", hdrs = ["part/g_part.h"], includes = [".."],
    deps = [":kernel_headers"], visibility = ["//visibility:public"])
cc_library(name = "partition_interface_headers", hdrs = [":g_part_interface_header"],
    strip_include_prefix = "g_part_if.generated", deps = [":partition_headers"], visibility = ["//visibility:public"])

exports_files(["part/g_part_mbr.c"], visibility = ["//sys/modules/geom/geom_part/geom_part_mbr:__pkg__"])
exports_files(["part/g_part_ebr.c"], visibility = ["//sys/modules/geom/geom_part/geom_part_ebr:__pkg__"])
exports_files(["part/g_part_bsd.c"], visibility = ["//sys/modules/geom/geom_part/geom_part_bsd:__pkg__"])

cc_library(name = "slice_headers", hdrs = ["geom_slice.h", "geom_flashmap.h"], includes = [".."],
    deps = [":kernel_headers"], visibility = ["//visibility:public"])

exports_files(["geom_flashmap.c"], visibility = ["//sys/modules/geom/geom_flashmap:__pkg__"])
