# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "headers", hdrs = ["g_multipath.h"], strip_include_prefix = "/sys", visibility = ["//lib/geom/multipath:__pkg__", "//sys/geom/label:__pkg__"])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
amd64_generic_module_objects(srcs = ["g_multipath.c"], deps = [":headers", "//sys/geom:kernel_headers"])

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")

[cross_generic_module_objects(
    arch = arch,
    srcs = ["g_multipath.c"],
    deps = [":headers", "//sys/geom:kernel_headers"],
) for arch in ["arm64", "riscv"]]

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

# Physical storage core prerequisites; identical contexts share providers.
bsd_source_headers(name = "storage_core_kernel_g_label_disk_ident_headers", hdrs = ["g_multipath.h"],
    visibility = ["//sys/dev/ufshci:__pkg__", "//sys/geom/label:__pkg__", "//sys/dev/nvme:__pkg__", "//sys/geom:__pkg__", "//sys/cam:__pkg__"])
