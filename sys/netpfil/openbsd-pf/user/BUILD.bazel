# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "compat_headers", hdrs = ["openbsd_compat.h"],
    strip_include_prefix = ".", visibility = ["//sbin/ifconfig:__pkg__", "//libexec/tftp-proxy:__pkg__", "//usr.sbin/ftp-proxy:__pkg__", "//usr.sbin/authpf:__pkg__"])

cc_library(name = "util_headers", hdrs = ["util.h"], strip_include_prefix = ".", visibility = ["//sbin/pflogd:__pkg__"])

cc_library(name = "pfctl_headers", hdrs = ["openbsd_compat.h", "util.h", "sys/refcnt.h", "sys/timeout.h"], strip_include_prefix = ".", visibility = ["//sbin/pfctl:__subpackages__"])
exports_files(["pfctl_jail.c", "pfctl_ether.c"], visibility = ["//sbin/pfctl:__subpackages__"])

# Physical wrappers used by the OpenBSD tcpdump compatibility include order.
load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")
bsd_source_headers(name = "tcpdump_headers", hdrs = ["openbsd_compat.h", "sys/refcnt.h", "sys/timeout.h"], includes = ["."],
    visibility = ["//usr.sbin/tcpdump/tcpdump:__pkg__"])

load("//tools/build/bazel:bsd_public_headers.bzl", "public_header_installation")

# Public installed ABI headers follow include/Makefile source groups.
public_header_installation(name = "public_group_pfsys_install", directory = "sys",
    files = {"sys/refcnt.h": "refcnt.h", "sys/timeout.h": "timeout.h"}, enabled = "//tools/build/bazel/config:includes_enabled")
