[cross_generic_module_objects(arch = arch, name = "glue_module", srcs = _PF_GLUE_SOURCES,
    deps = _PF_DEPS + ["//sys/" + arch + "/conf:generic_" + option + "_header" for option in ["opt_inet", "opt_inet6", "opt_bpf"]],
    header_overrides = [":compatibility_headers"], textual_hdrs = ["openbsd_compat.h"], warning_flags = _PF_WARNING_FLAGS, copts = _PF_COPTS + ["-DOPENBSD_PF_GLUE"])
 for arch in ["arm64", "riscv"]]

# Compile with three distinct policies, then retain the maintained final link order.
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_selected_objects")
_PF_OBJECT_SEGMENTS = [
    ("vendor_before_radix", "vendor", ["pf.o", "pf_if.o", "pf_ioctl.o", "pf_lb.o", "pf_norm.o", "pf_osfp.o", "pf_ruleset.o", "pf_syncookies.o", "pf_table.o"]),
    ("radix", "radix", ["radix.o"]),
    ("vendor_after_radix", "vendor", ["inet_nat64.o", "in4_cksum.o", "if_pflog.o", "if_pflow.o", "if_pfsync.o"]),
    ("glue", "glue", ["openbsd_compat.o", "openbsd_net.o", "openbsd_ifq.o", "pf_freebsd.o", "pf_sdt.o", "pf_divert.o", "pf_dummynet.o", "pf_ether.o", "pf_jail.o", "pf_pfsync.o", "pf_sctp.o", "pf_quota.o", "pf_sysctl.o"]),
]
[bsd_component_selected_objects(name = prefix + segment + "_objects",
    group = ":" + prefix + group + "_module_ctf", object_names = names,
    visibility = ["//sys/modules/pf:__pkg__"])
 for prefix in ["", "arm64_", "riscv_"]
 for segment, group, names in _PF_OBJECT_SEGMENTS]

