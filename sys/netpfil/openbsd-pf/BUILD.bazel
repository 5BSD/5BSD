    deps = _PF_DEPS + ["//sys/" + arch + "/conf:generic_" + option + "_header" for option in ["opt_inet", "opt_inet6", "opt_bpf"]],
    header_overrides = [":compatibility_headers"], textual_hdrs = ["openbsd_compat.h"], warning_flags = _PF_WARNING_FLAGS, copts = _PF_COPTS + ["-DOBSD_RADIX_IMPL"])
 for arch in ["arm64", "riscv"]]

_PF_GLUE_SOURCES = ["openbsd_compat.c", "openbsd_net.c", "openbsd_ifq.c", "pf_freebsd.c", "pf_sdt.c", "pf_divert.c", "pf_dummynet.c", "pf_ether.c", "pf_jail.c", "pf_pfsync.c", "pf_sctp.c", "pf_quota.c", "pf_sysctl.c"]
amd64_generic_module_objects(name = "glue_module", srcs = _PF_GLUE_SOURCES,
    deps = _PF_DEPS + ["//sys/amd64/conf:generic_opt_inet_header", "//sys/amd64/conf:generic_opt_inet6_header", "//sys/amd64/conf:generic_opt_bpf_header"], header_overrides = [":compatibility_headers"],
