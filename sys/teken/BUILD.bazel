load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(name = 'kernel_headers', hdrs = ['teken.h'],
    strip_include_prefix = "/sys",
    deps = [],
    visibility = ['//sys/dev/vt:__pkg__'])

# Core kernel physical prerequisites.
load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")
bsd_source_headers(name = "core_kernel_subr_terminal_headers", hdrs = ["teken.h"],
    visibility = ["//sys/kern:__pkg__"])
bsd_source_headers(name = "core_kernel_tty_ttydisc_headers", hdrs = ["teken.h", "teken_wcwidth.h"],
    visibility = ["//sys/kern:__pkg__"])

# Physical device I/O prerequisites; identical contexts share providers.
bsd_source_headers(name = "device_io_kernel_vt_font_default_headers", hdrs = ["teken.h"],
    visibility = ["//sys/dev/usb/controller:__pkg__", "//sys/dev/sound/pci/hda:__pkg__", "//sys/dev/sound/midi:__pkg__", "//sys/dev/sound/pcm:__pkg__", "//sys/dev/sound/usb:__pkg__", "//sys/dev/usb/net:__pkg__", "//sys/dev/atkbdc:__pkg__", "//sys/dev/evdev:__pkg__", "//sys/dev/sound:__pkg__", "//sys/dev/hid:__pkg__", "//sys/dev/kbd:__pkg__", "//sys/dev/usb:__pkg__", "//sys/dev/vt:__pkg__", "//sys/teken:__pkg__"])
bsd_source_headers(name = "device_io_kernel_teken_headers", hdrs = ["teken.h", "teken_scs.h", "teken_subr.h", "teken_subr_compat.h", "teken_wcwidth.h"],
    visibility = ["//sys/dev/usb/controller:__pkg__", "//sys/dev/sound/pci/hda:__pkg__", "//sys/dev/sound/midi:__pkg__", "//sys/dev/sound/pcm:__pkg__", "//sys/dev/sound/usb:__pkg__", "//sys/dev/usb/net:__pkg__", "//sys/dev/atkbdc:__pkg__", "//sys/dev/evdev:__pkg__", "//sys/dev/sound:__pkg__", "//sys/dev/hid:__pkg__", "//sys/dev/kbd:__pkg__", "//sys/dev/usb:__pkg__", "//sys/dev/vt:__pkg__", "//sys/teken:__pkg__"])

load("//tools/build/bazel:bsd_awk_output.bzl", "bsd_awk_output")
bsd_awk_output(name = "state_header", script = "gensequences", srcs = ["sequences"], output = "generated/teken_state.h", visibility = ["//visibility:public"],
    awk = "@bsd_sdk//toolchain:awk", redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:awk_runtime"])
cc_library(name = "device_io_state_headers", hdrs = [":state_header"], strip_include_prefix = "generated", visibility = ["//stand/efi/libefi:__pkg__", "//stand/i386/libi386:__pkg__"])

load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")

load("//tools/build/bazel:kernel_common.bzl", "KERNEL_BUILTIN_WARNING_FLAGS")

# Native amd64 GENERIC device I/O built-ins.
amd64_generic_kernel_objects(name = "generic_device_io_teken", srcs = ["teken.c"],
    deps = ["//sys/teken:device_io_kernel_teken_headers", "//sys/teken:device_io_state_headers"], warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)

# Physical prerequisites for native peripheral device built-ins.
bsd_source_headers(name = "peripheral_devices_kernel_fbd_headers", hdrs = ["teken.h"],
    visibility = ["//sys/dev/amdsmn:__pkg__", "//sys/dev/amdtemp:__pkg__", "//sys/dev/backlight:__pkg__", "//sys/dev/coretemp:__pkg__", "//sys/dev/cpuctl:__pkg__", "//sys/dev/cpufreq:__pkg__", "//sys/dev/dttransport:__pkg__", "//sys/dev/efidev:__pkg__", "//sys/dev/fb:__pkg__", "//sys/dev/ichsmb:__pkg__", "//sys/dev/iicbus:__pkg__", "//sys/dev/intpm:__pkg__", "//sys/dev/io:__pkg__", "//sys/dev/iommu:__pkg__", "//sys/dev/iwn:__pkg__", "//sys/dev/kbdmux:__pkg__", "//sys/dev/kvm_clock:__pkg__", "//sys/dev/led:__pkg__", "//sys/dev/md:__pkg__", "//sys/dev/mdio:__pkg__", "//sys/dev/mem:__pkg__", "//sys/dev/mlxfw:__pkg__", "//sys/dev/mmc:__pkg__", "//sys/dev/null:__pkg__", "//sys/dev/pci:__pkg__", "//sys/dev/puc:__pkg__", "//sys/dev/sdhci:__pkg__", "//sys/dev/smbios:__pkg__", "//sys/dev/smbus:__pkg__", "//sys/dev/tcp_log:__pkg__", "//sys/dev/tpm:__pkg__", "//sys/dev/uart:__pkg__", "//sys/dev/veriexec:__pkg__", "//sys/dev/video:__pkg__", "//sys/dev/vkbd:__pkg__", "//sys/dev/vmd:__pkg__", "//sys/dev/vmgenc:__pkg__", "//sys/dev/vmware:__pkg__", "//sys/dev/watchdog:__pkg__"])

# Physical inputs of ARM64/RISC-V GENERIC core built-ins.
bsd_source_headers(name = "cross_core_builtin_headers", hdrs = [
        "teken.h",
        "teken_wcwidth.h",
    ],
    includes = [], visibility = ["//sys/kern:__pkg__"])

bsd_source_headers(name = "standalone_lua_headers", hdrs = ['teken.h'], includes = ["."], visibility = ["//stand/liblua:__pkg__"])

bsd_source_headers(name = "libefi_headers", hdrs = ['teken.h', 'teken_scs.h', 'teken_subr.h', 'teken_subr_compat.h', 'teken_wcwidth.h'], visibility = ["//stand/efi/libefi:__pkg__"])

exports_files(["teken.c"], visibility = ["//stand/efi/libefi:__pkg__", "//stand/i386/libi386:__pkg__"])

exports_files(["gensequences", "sequences"], visibility = ["//stand/efi/libefi:__pkg__"])

bsd_source_headers(name = "standalone_ficl_headers", hdrs = ['teken.h'], visibility = ["//stand/ficl:__pkg__"])

bsd_source_headers(name = "efi_loader_entry_headers", hdrs = ['teken.h'], visibility = ["//stand/efi/loader:__pkg__"])

bsd_source_headers(name = 'efi_loader_4th_headers', hdrs = ['teken.h'], visibility = ["//stand/efi/loader_4th:__pkg__"])

bsd_source_headers(name = 'efi_loader_simp_headers', hdrs = ['teken.h'], visibility = ["//stand/efi/loader_simp:__pkg__"])

bsd_source_headers(name = 'efi_loader_aarch64_headers', hdrs = ['teken.h'], visibility = ["//stand/efi/loader:__pkg__"])

bsd_source_headers(name = 'efi_loader_riscv64_headers', hdrs = ['teken.h'], visibility = ["//stand/efi/loader:__pkg__"])

bsd_source_headers(name = 'efi_loader_simp_aarch64_headers', hdrs = ['teken.h'], visibility = ["//stand/efi/loader_simp:__pkg__"])

bsd_source_headers(name = 'efi_loader_4th_aarch64_headers', hdrs = ['teken.h'], visibility = ["//stand/efi/loader_4th:__pkg__"])

bsd_source_headers(name = 'efi_loader_simp_riscv64_headers', hdrs = ['teken.h'], visibility = ["//stand/efi/loader_simp:__pkg__"])

bsd_source_headers(name = 'efi_loader_4th_riscv64_headers', hdrs = ['teken.h'], visibility = ["//stand/efi/loader_4th:__pkg__"])

bsd_source_headers(name = "bios_libi386_headers", hdrs = ['teken.h', 'teken_scs.h', 'teken_subr.h', 'teken_subr_compat.h', 'teken_wcwidth.h'], visibility = ["//stand/i386/libi386:__pkg__"])

bsd_source_headers(name = "bios_loader_headers", hdrs = ['teken.h'], visibility = ["//stand/i386/loader:__pkg__"])
