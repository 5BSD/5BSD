load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")

cc_library(name = "cc_headers", hdrs = [
    "cc.h", "cc_module.h",
], includes = ["../.."], deps = [
    "//sys/netinet:tcp_cc_headers",
])
cc_library(name = "cc_cubic_headers", hdrs = ["cc_cubic.h"], includes = ["../.."],
    deps = [":cc_headers"])
cc_library(name = "cc_newreno_headers", hdrs = ["cc_newreno.h"], includes = ["../.."],
    deps = [":cc_headers"])

_CC_MODULES = [
    ("cc_cdg", [":cc_headers", "//sys/contrib/pcg-c:kernel_headers", "//sys/net:route_nhop_headers", "//sys/netinet:tcp_cc_ertt_headers"]),
    ("cc_chd", [":cc_headers", "//sys/contrib/pcg-c:kernel_headers", "//sys/net:route_nhop_headers", "//sys/netinet:tcp_cc_ertt_headers"]),
    ("cc_cubic", [":cc_cubic_headers", "//sys/net:route_nhop_headers", "//sys/netinet:tcp_cc_hpts_headers"]),
    ("cc_dctcp", [":cc_headers", "//sys/net:route_nhop_headers"]),
    ("cc_hd", [":cc_headers", "//sys/contrib/pcg-c:kernel_headers", "//sys/netinet:tcp_cc_ertt_headers"]),
    ("cc_htcp", [":cc_headers", "//sys/net:route_nhop_headers"]),
    ("cc_newreno", [":cc_newreno_headers", "//sys/net:route_nhop_headers", "//sys/netinet:tcp_cc_hpts_headers"]),
    ("cc_vegas", [":cc_headers", "//sys/net:route_nhop_headers", "//sys/netinet:tcp_cc_ertt_headers"]),
]

[
    amd64_generic_module_objects(
        name = name + "_module",
        srcs = [name + ".c"],
        deps = [
            "//sys/amd64/conf:generic_opt_kern_tls_header",
            "//sys/contrib/ck:kernel_headers",
            "//sys/vm:kernel_headers",
        ] + deps,
    )
    for name, deps in _CC_MODULES
]

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")
[
    cross_generic_module_objects(
        arch = arch,
        name = name + "_module",
        srcs = [name + ".c"],
        deps = [
            "//sys/" + arch + "/conf:generic_opt_kern_tls_header",
            "//sys/contrib/ck:kernel_headers",
            "//sys/vm:kernel_headers",
        ] + deps,
    )
    for arch in ["arm64", "riscv"]
    for name, deps in _CC_MODULES
]

cc_library(name = "nfs_headers", hdrs = ["cc.h"], strip_include_prefix = "/sys",
    visibility = ["//sys/netinet:__pkg__"])

cc_library(name = "packet_filter_headers", hdrs = ["cc.h"], strip_include_prefix = "/sys",
    visibility = ["//sys/netpfil:__subpackages__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

# Physical prerequisites consumed by independent network-support module builds.
bsd_source_headers(name = "network_support_headers", hdrs = ["cc.h"], visibility = ["//sys/netinet:__pkg__", "//sys/netipsec:__pkg__", "//sys/netlink:__pkg__", "//sys/dev/cxgbe:__pkg__", "//sys/compat/linprocfs:__pkg__"])

# Core kernel physical prerequisites.
bsd_source_headers(name = "core_kernel_kern_sendfile_headers", hdrs = ["cc.h"],
    visibility = ["//sys/kern:__pkg__"])
bsd_source_headers(name = "core_kernel_uipc_ktls_headers", hdrs = ["cc.h"],
    visibility = ["//sys/kern:__pkg__"])

# IPv4 built-in prerequisites.
bsd_source_headers(name = "ipv4_kernel_tcp_ecn_headers", hdrs = ["cc.h"],
    visibility = ["//sys/netinet:__pkg__"])
bsd_source_headers(name = "ipv4_kernel_tcp_fastopen_headers", hdrs = ["cc.h"],
    visibility = ["//sys/netinet:__pkg__"])
bsd_source_headers(name = "ipv4_kernel_tcp_hostcache_headers", hdrs = ["cc.h"],
    visibility = ["//sys/netinet:__pkg__"])
bsd_source_headers(name = "ipv4_kernel_tcp_input_headers", hdrs = ["cc.h"],
    visibility = ["//sys/netinet:__pkg__"])
bsd_source_headers(name = "ipv4_kernel_tcp_log_buf_headers", hdrs = ["cc.h"],
    visibility = ["//sys/netinet:__pkg__"])
bsd_source_headers(name = "ipv4_kernel_tcp_lro_headers", hdrs = ["cc.h"],
    visibility = ["//sys/netinet:__pkg__"])
bsd_source_headers(name = "ipv4_kernel_tcp_output_headers", hdrs = ["cc.h"],
    visibility = ["//sys/netinet:__pkg__"])
bsd_source_headers(name = "ipv4_kernel_tcp_offload_headers", hdrs = ["cc.h"],
    visibility = ["//sys/netinet:__pkg__"])
bsd_source_headers(name = "ipv4_kernel_tcp_reass_headers", hdrs = ["cc.h"],
    visibility = ["//sys/netinet:__pkg__"])
bsd_source_headers(name = "ipv4_kernel_tcp_sack_headers", hdrs = ["cc.h"],
    visibility = ["//sys/netinet:__pkg__"])
bsd_source_headers(name = "ipv4_kernel_tcp_subr_headers", hdrs = ["cc.h"],
    visibility = ["//sys/netinet:__pkg__"])
bsd_source_headers(name = "ipv4_kernel_tcp_syncache_headers", hdrs = ["cc.h"],
    visibility = ["//sys/netinet:__pkg__"])
bsd_source_headers(name = "ipv4_kernel_tcp_timer_headers", hdrs = ["cc.h"],
    visibility = ["//sys/netinet:__pkg__"])
bsd_source_headers(name = "ipv4_kernel_tcp_timewait_headers", hdrs = ["cc.h"],
    visibility = ["//sys/netinet:__pkg__"])
bsd_source_headers(name = "ipv4_kernel_tcp_usrreq_headers", hdrs = ["cc.h"],
    visibility = ["//sys/netinet:__pkg__"])

# IPv6 built-in prerequisites.
bsd_source_headers(name = "ipv6_kernel_icmp6_headers", hdrs = ["cc.h"],
    visibility = ["//sys/netinet6:__pkg__"])
bsd_source_headers(name = "ipv6_kernel_in6_mcast_headers", hdrs = ["cc.h"],
    visibility = ["//sys/netinet6:__pkg__"])
bsd_source_headers(name = "ipv6_kernel_ip6_output_headers", hdrs = ["cc.h"],
    visibility = ["//sys/netinet6:__pkg__"])

# Native filesystem/RPC physical prerequisites; identical contexts share providers.
bsd_source_headers(name = "filesystems_rpc_kernel_nfs_commonkrpc_headers", hdrs = ["cc.h"],
    visibility = ["//sys/fs/cd9660:__pkg__", "//sys/fs/cuse:__pkg__", "//sys/fs/deadfs:__pkg__", "//sys/fs/fdescfs:__pkg__", "//sys/fs/fifofs:__pkg__", "//sys/fs/mntfs:__pkg__", "//sys/fs/msdosfs:__pkg__", "//sys/fs/nfs:__pkg__", "//sys/fs/nfsclient:__pkg__", "//sys/fs/nfsserver:__pkg__", "//sys/fs/nullfs:__pkg__", "//sys/nlm:__pkg__", "//sys/rpc:__pkg__", "//sys/ufs/ffs:__pkg__", "//sys/ufs/ufs:__pkg__", "//sys/xdr:__pkg__"])

# Physical prerequisites for native network policy built-ins.
bsd_source_headers(name = "network_policy_kernel_cc_headers", hdrs = ["cc.h", "cc_module.h"],
    visibility = ["//contrib/openbsd-pf/sys/net:__pkg__", "//contrib/openbsd-pf/sys/netinet:__pkg__", "//sys/net:__pkg__", "//sys/netgraph:__pkg__", "//sys/netgraph/bluetooth:__pkg__", "//sys/netinet:__pkg__", "//sys/netinet/cc:__pkg__", "//sys/netipsec:__pkg__", "//sys/netlink:__pkg__", "//sys/netpfil/dummynet:__pkg__", "//sys/netpfil/openbsd-pf:__pkg__"])
bsd_source_headers(name = "network_policy_kernel_cc_cubic_headers", hdrs = ["cc.h", "cc_cubic.h", "cc_module.h"],
    visibility = ["//contrib/openbsd-pf/sys/net:__pkg__", "//contrib/openbsd-pf/sys/netinet:__pkg__", "//sys/net:__pkg__", "//sys/netgraph:__pkg__", "//sys/netgraph/bluetooth:__pkg__", "//sys/netinet:__pkg__", "//sys/netinet/cc:__pkg__", "//sys/netipsec:__pkg__", "//sys/netlink:__pkg__", "//sys/netpfil/dummynet:__pkg__", "//sys/netpfil/openbsd-pf:__pkg__"])
bsd_source_headers(name = "network_policy_kernel_netlink_sock_diag_headers", hdrs = ["cc.h"],
    visibility = ["//contrib/openbsd-pf/sys/net:__pkg__", "//contrib/openbsd-pf/sys/netinet:__pkg__", "//sys/net:__pkg__", "//sys/netgraph:__pkg__", "//sys/netgraph/bluetooth:__pkg__", "//sys/netinet:__pkg__", "//sys/netinet/cc:__pkg__", "//sys/netipsec:__pkg__", "//sys/netlink:__pkg__", "//sys/netpfil/dummynet:__pkg__", "//sys/netpfil/openbsd-pf:__pkg__"])

load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")
load("//tools/build/bazel:kernel_common.bzl", "KERNEL_BUILTIN_WARNING_FLAGS")

# Native amd64 GENERIC network policy built-ins.
amd64_generic_kernel_objects(name = "generic_network_policy_cc", srcs = ["cc.c"],
    deps = ["//sys/contrib/ck:network_policy_kernel_nhgrp_headers", "//sys/net:network_policy_kernel_cc_headers", "//sys/netinet:network_policy_kernel_cc_headers", "//sys/netinet/cc:network_policy_kernel_cc_headers", "//sys/netinet6:network_policy_kernel_nhop_headers", "//sys/vm:network_policy_kernel_nhgrp_headers", "//sys/amd64/conf:network_policy_kernel_opt_cc_header"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS, early_deps = [])
amd64_generic_kernel_objects(name = "generic_network_policy_cc_cubic", srcs = ["cc_cubic.c"],
    deps = ["//sys/contrib/ck:network_policy_kernel_nhgrp_headers", "//sys/net:network_policy_kernel_cc_cubic_headers", "//sys/netinet:network_policy_kernel_cc_cubic_headers", "//sys/netinet/cc:network_policy_kernel_cc_cubic_headers", "//sys/netinet6:network_policy_kernel_nhop_headers", "//sys/vm:network_policy_kernel_nhgrp_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS, early_deps = [])

# Physical prerequisites for native custom-named kernel built-ins.
bsd_source_headers(name = "custom_names_kernel_obsd_radix_headers", hdrs = ["cc.h"],
    visibility = ["//contrib/openbsd-pf/sys/net:__pkg__", "//sys/contrib/openzfs:__pkg__", "//sys/net:__pkg__"])

bsd_source_headers(name = "storage_tcp_ktest_module_context_1", hdrs = ["cc.h", "cc_newreno.h"], includes = [],
    visibility = ["//sys/netinet:__pkg__"])

# Physical inputs of ARM64/RISC-V GENERIC network built-ins.
bsd_source_headers(name = "cross_network_builtin_headers", hdrs = [
        "cc.h",
    ],
    includes = [], visibility = ["//sys/net:__pkg__", "//sys/netinet:__pkg__"])

# Physical inputs of ARM64/RISC-V GENERIC core built-ins.
bsd_source_headers(name = "cross_core_builtin_headers", hdrs = [
        "cc.h",
    ],
    includes = [], visibility = ["//sys/kern:__pkg__"])

load("//tools/build/bazel:bsd_public_headers.bzl", "public_header_installation")

# Public installed ABI headers follow include/Makefile source groups.
public_header_installation(name = "public_flat_netinet_cc_install", directory = "netinet/cc",
    files = {header: header.split("/")[-1] for header in glob(["*.h"], allow_empty = False)}, enabled = "//tools/build/bazel/config:includes_enabled")
