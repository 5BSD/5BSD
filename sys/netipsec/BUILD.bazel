load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "userspace_headers", hdrs = ["ipsec.h", "keydb.h", "key_debug.h", "key_var.h", "xform.h"], strip_include_prefix = "/sys", visibility = ["//sbin/setkey:__pkg__"])
cc_library(name = "if_enc_headers", hdrs = ["ipsec.h", "keydb.h", "key_var.h", "xform.h"], strip_include_prefix = "/sys",
    deps = ["//sys/net:if_enc_headers", "//sys/netinet:ipv4_tunnel_headers", "//sys/opencrypto:cryptodev_headers", "//sys/opencrypto:if_enc_headers"],
    visibility = ["//sys/net:__pkg__", "//sys/modules/if_enc:__pkg__"])
exports_files(["key_debug.c"], visibility = ["//sbin/setkey:__pkg__"])

