load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(name = "kernel_headers", hdrs = ["ddb.h", "db_command.h"],
    strip_include_prefix = ".", include_prefix = "ddb", visibility = ["//visibility:public"])

cc_library(name = "symbol_headers", hdrs = ["db_sym.h"], includes = [".."], visibility = ["//sys/kern:__pkg__"])

cc_library(name = "lexer_headers", hdrs = ["db_lex.h"], includes = [".."], visibility = ["//sys/kern:__pkg__"])

cc_library(name = "ctf_headers", hdrs = ["db_ctf.h"], includes = [".."],
    deps = [":kernel_headers", ":symbol_headers"], visibility = ["//sys/kern:__pkg__"])

# Physical source headers: the kernel compilation context supplies -Isys.
cc_library(name = "wlan_headers", hdrs = ["db_sym.h", "ddb.h"],
    visibility = ["//sys/net80211:__pkg__"])

cc_library(name = "cam_module_headers", hdrs = ["ddb.h"], visibility = ["//sys/cam:__pkg__"])

