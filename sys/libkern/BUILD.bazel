exports_files(["gsb_crc32.c"], visibility = ["//lib/libnvmf:__pkg__", "//lib/libufs:__pkg__"])

load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = glob(["*_if.m"]))

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")
# qsort_r.c includes the maintained common implementation.
cc_library(name = "qsort_implementation", hdrs = ["qsort.c"], includes = [".."])
# GENERIC common support routines; provider and architecture groups follow below.
amd64_generic_kernel_objects(name = "generic_common",
    srcs = [
    "arc4random_uniform.c",
    "asprintf.c",
    "bcd.c",
    "bsearch.c",
    "crc16.c",
    "explicit_bzero.c",
    "fnmatch.c",
    "gsb_crc32.c",
    "inet_aton.c",
    "inet_ntoa.c",
    "inet_ntop.c",
    "inet_pton.c",
    "jenkins_hash.c",
    "murmur3_32.c",
    "memcchr.c",
    "memchr.c",
    "memmem.c",
    "qsort.c",
    "qsort_r.c",
    "random.c",
    "scanc.c",
    "strcasecmp.c",
    "strcasestr.c",
    "strcat.c",
    "strchr.c",
    "strchrnul.c",
    "strcpy.c",
    "strcspn.c",
    "strdup.c",
    "strndup.c",
    "strlcat.c",
    "strlcpy.c",
    "strncat.c",
    "strncpy.c",
    "strnlen.c",
    "strnstr.c",
    "strrchr.c",
    "strsep.c",
    "strspn.c",
    "strstr.c",
    "strtol.c",
    "strtoq.c",
    "strtoul.c",
    "strtouq.c",
    "strvalid.c",
    "timingsafe_bcmp.c",
    "strcmp.c",
    "strncmp.c"
],
    deps = [":qsort_implementation", "//sys/netinet:address_headers", "//sys/contrib/pcg-c:kernel_headers"])

amd64_generic_kernel_objects(name = "generic_random", srcs = ["arc4random.c"],
    deps = ["//sys/crypto/chacha20:kernel_headers", "//sys/crypto/sha2:kernel_headers", "//sys/dev/random:provider_headers"])
amd64_generic_kernel_objects(name = "generic_x86_crc", srcs = ["x86/crc32_sse42.c"])
filegroup(name = "generic_object_files", srcs = [":generic_common_object_files", ":generic_random_object_files", ":generic_x86_crc_object_files"], visibility = ["//visibility:public"])

exports_files(["explicit_bzero.c"], visibility = ["//lib/libc/string:__pkg__"])
