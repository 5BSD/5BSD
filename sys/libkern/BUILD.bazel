    "inet_aton.c",
    "inet_ntoa.c",
    "inet_ntop.c",
    "inet_pton.c",
    "jenkins_hash.c",
    "murmur3_32.c",
    "memcchr.c",
    "memchr.c",
    "memmem.c",
    "qsort.c",
    "qsort_r.c",
    "random.c",
    "scanc.c",
    "strcasecmp.c",
    "strcasestr.c",
    "strcat.c",
    "strchr.c",
    "strchrnul.c",
    "strcpy.c",
    "strcspn.c",
    "strdup.c",
    "strndup.c",
    "strlcat.c",
    "strlcpy.c",
    "strncat.c",
