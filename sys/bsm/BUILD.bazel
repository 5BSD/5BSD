exports_files(['audit_kevents.h'], visibility = ["//usr.sbin/BSDAudit/tests:__pkg__"])

load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(name = "kernel_headers", hdrs = glob(["*.h"]),
    strip_include_prefix = ".", include_prefix = "bsm", visibility = ["//visibility:public"])

# Source-header closure for the maintained truss build on amd64.
cc_library(name = "truss_headers", hdrs = ['audit.h'], strip_include_prefix = "/sys", visibility = ["//usr.bin/truss:__pkg__"])

# Userland PMC source ABI header closure.
cc_library(name = "pmc_user_headers", hdrs = ['audit.h'], visibility = ["//lib/libpmc:__pkg__"])

# Physical source closure used by the native storage module candidates.
cc_library(name = "storage_module_headers", hdrs = ["audit.h", "audit_kevents.h"],
    visibility = ["//sys/cam:__pkg__", "//sys/dev/nvme:__pkg__", "//sys/dev/nvd:__pkg__", "//sys/dev/ahci:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")
bsd_source_headers(name = "tracing_module_headers", hdrs = ["audit.h", "audit_internal.h", "audit_kevents.h"],
    includes = [], visibility = ["//sys/dev/dttransport:__pkg__", "//sys/cddl/dev/hypertrace:__pkg__", "//sys/security/audit:__pkg__", "//sys/cddl/dev/dtmalloc:__pkg__", "//sys/fs/nfsclient:__pkg__", "//sys/cddl/dev/profile:__pkg__", "//sys/cddl/dev:__pkg__", "//sys/cddl/dev/sdt:__pkg__"])

bsd_source_headers(name = "tracing_core_headers", hdrs = ["audit.h", "audit_kevents.h"], includes = [],
    visibility = ["//sys/cddl/dev/dtrace:__pkg__", "//sys/cddl/dev/fbt:__pkg__", "//sys/cddl/dev/kinst:__pkg__", "//sys/modules/dtrace/dtraceall:__pkg__"])
