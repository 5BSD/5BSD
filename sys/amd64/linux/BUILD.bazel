bsd_source_headers(name = "linux_vdso_gtod_vdso_headers", hdrs = ["linux.h", "linux_syscall.h"], includes = [], visibility = ["//sys/amd64/linux:__pkg__"])

cc_library(name = "module_linux_vdso_gtod" , srcs = ["linux_vdso_gtod.c"], deps = ["//sys/amd64/include:linux64_module_headers", "//include:linux_vdso_gtod_vdso_headers", "//sys/amd64/linux:linux_vdso_gtod_vdso_headers", "//sys/compat/linux:linux_vdso_gtod_vdso_headers", "//sys/x86/linux:linux_vdso_gtod_vdso_headers", "//sys/sys:kernel_headers", "//sys/amd64/include:kernel_headers", "//sys/x86/include:kernel_headers", "//sys/bsm:kernel_headers"], copts = ["-fPIC", "-pipe", "-O2", "-Werror", "-mcmodel=small", "-msoft-float", "-nostdinc", "-fasynchronous-unwind-tables", "-fno-omit-frame-pointer", "-foptimize-sibling-calls", "-fno-stack-protector"], local_defines = [], features = ["-bsd_kernel_freestanding"], target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
