load("//tools/build/bazel:bsd_vdso.bzl", "bsd_vdso_link")
# Match the Linux VDSO ABI/script, not the native BSD VDSO layout.
bsd_vdso_link(name = "module_vdso", objects = [":module_linux_locore_object", ":module_linux_vdso_gtod_object"], script = "linux_vdso.lds.s",
    linkopts = ["--shared", "--eh-frame-hdr", "-soname=linux-vdso.so.1", "--no-undefined", "--hash-style=both", "-warn-common", "-nostdlib", "--strip-debug", "-s", "--build-id=sha1", "-Bsymbolic"], output = "module_vdso/linux_vdso.so.o", visibility = ["//sys/compat/linux:__pkg__"])
