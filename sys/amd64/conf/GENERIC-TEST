#
# GENERIC-TEST -- GENERIC with the test-kernel options, for the test suites
#		  of 5BSD/amd64.
#
# This is a test kernel.  It must never be published: publication and
# release media refuse a kernel or module built from it
# (release/scripts/check-test-kernel.sh), and build-bsd(8) refuses to plan
# packages or media for a configuration that carries any of its options.
# Every option here is a row of the test-kernel option ledger,
# sys/conf/test-options, which names this file as the one configuration
# allowed to carry it.
#
# Each option does nothing until its knob is set (dq(4), at boot:
# debug.dq.unverified_open="1"; mac_capability(4), at boot:
# kern.mac_capability.test_issuer="1"; ffs(4), by a test:
# debug.ffs.test_hold_mnt).
#

include GENERIC

ident		GENERIC-TEST

options 	DQ_TEST_OPEN		# dq(4) test access: never published
options 	MAC_CAPABILITY_TEST_PERMISSIVE	# test issuers: never published
options 	FFS_TEST_HOOKS		# ffs(4) resume hold: never published
