#
# VBSD-KASAN -- the 5BSD kernel with the Kernel Address Sanitizer.
#
# Identical to VBSD but adds KASAN, which instruments every kernel and module
# object to detect use-after-free, out-of-bounds, and use-of-uninitialised-
# adjacent accesses at runtime.  Used to validate memory-safety-sensitive
# subsystems (e.g. squeue) under their test and stress suites; far slower and
# larger than VBSD, not for production.
#

include VBSD

ident		VBSD-KASAN

options 	KASAN
