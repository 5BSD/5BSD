load("//tools/build/bazel:bsd_kernel_config.bzl", "bsd_kernel_config")
# Configuration sources remain ordinary inputs, including DEFAULTS and includes.
filegroup(name = "configuration_inputs", srcs = glob(["*"], exclude = ["BUILD.bazel"]), visibility = ["//visibility:public"])
[bsd_kernel_config(
    name = name, config = "GENERIC", debug = debug,
    option_settings = {"//tools/build/bazel/config:kernel_zstdio": "ZSTDIO",
        "//tools/build/bazel/config:kernel_nfs_root": "NFS_ROOT"},
    inputs = [":configuration_inputs", "//sys/conf:configuration_inputs"],
    source_anchor = "//sys/conf:files",
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib"],
    libraries = ["//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared",
        "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7",
        "@bsd_sdk//toolchain:sysroot/lib/libthr.so.3"],
    visibility = ["//visibility:public"],
) for name, debug in [("generic_config", False), ("generic_debug_config", True)]]

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_tree_file.bzl", "bsd_tree_file")
[bsd_tree_file(name = name, tree = ":generic_config", member = name + ".h",
    output = "generic_options/" + name + ".h",
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib"])
 for name in ["opt_global", "opt_hwpmc_hooks", "opt_kstack_pages", "opt_config", "opt_tmpfs", "opt_ddb", "opt_pseudofs", "opt_geom", "opt_zstdio", "opt_capsicum", "opt_mac", "opt_veriexec", "opt_posix", "opt_sysvipc", "opt_ktrace", "opt_adaptive_mutexes", "opt_no_adaptive_rwlocks", "opt_no_adaptive_sx", "opt_sched", "opt_sleepqueue_profiling", "opt_turnstile_profiling", "opt_stack", "opt_callout_profiling", "opt_ffclock", "opt_ntp", "opt_rss", "opt_kqueue", "opt_inet", "opt_inet6", "opt_ipsec", "opt_kern_tls", "opt_netgraph", "opt_sctp", "opt_param", "opt_hwt_hooks", "opt_vm", "opt_witness", "opt_umtx_profiling", "opt_sysctl", "opt_kld", "opt_gdb", "opt_kdb", "opt_init_path", "opt_verbose_sysinit", "opt_device_polling", "opt_watchdog", "opt_printf", "opt_rootdevname", "opt_debug_lockf", "opt_acpi", "opt_bus", "opt_iommu", "opt_snd"]]
cc_library(name = "generic_global_headers", hdrs = [":opt_global"],
    strip_include_prefix = "generic_options", visibility = ["//visibility:public"])
cc_library(name = "generic_assym_headers", hdrs = [":opt_hwpmc_hooks", ":opt_kstack_pages"],
    strip_include_prefix = "generic_options", visibility = ["//visibility:public"])

cc_library(name = "generic_config_header", hdrs = [":opt_config"], strip_include_prefix = "generic_options", visibility = ["//visibility:public"])
[bsd_tree_file(name = "generic_" + name + "_source", tree = ":generic_config", member = name + ".c",
    output = "generic_sources/" + name + ".c",
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib"], visibility = ["//visibility:public"])
 for name in ["config", "env", "hints"]]

filegroup(name = "generic_identity", srcs = [":generic_config"], output_group = "identity", visibility = ["//visibility:public"])

[cc_library(name = "generic_" + name + "_header", hdrs = [":" + name],
    strip_include_prefix = "generic_options", visibility = ["//visibility:public"])
 for name in ["opt_tmpfs", "opt_ddb", "opt_pseudofs", "opt_geom", "opt_zstdio", "opt_capsicum", "opt_mac", "opt_veriexec", "opt_posix", "opt_sysvipc", "opt_ktrace", "opt_adaptive_mutexes", "opt_no_adaptive_rwlocks", "opt_no_adaptive_sx", "opt_sched", "opt_sleepqueue_profiling", "opt_turnstile_profiling", "opt_stack", "opt_callout_profiling", "opt_ffclock", "opt_ntp", "opt_rss", "opt_kqueue", "opt_inet", "opt_inet6", "opt_ipsec", "opt_kern_tls", "opt_netgraph", "opt_sctp", "opt_param", "opt_hwt_hooks", "opt_vm", "opt_witness", "opt_umtx_profiling", "opt_sysctl", "opt_kld", "opt_gdb", "opt_kdb", "opt_init_path", "opt_verbose_sysinit", "opt_device_polling", "opt_watchdog", "opt_printf", "opt_rootdevname", "opt_debug_lockf", "opt_acpi", "opt_bus", "opt_iommu", "opt_snd"]]

cc_library(name = "generic_opt_hwpmc_hooks_header", hdrs = [":opt_hwpmc_hooks"], strip_include_prefix = "generic_options", visibility = ["//visibility:public"])

cc_library(name = "generic_opt_kstack_pages_header", hdrs = [":opt_kstack_pages"],
    strip_include_prefix = "generic_options", visibility = ["//visibility:public"])

bsd_tree_file(name = "opt_platform", tree = ":generic_config", member = "opt_platform.h",
    output = "generic_options/opt_platform.h", python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib"])
cc_library(name = "generic_opt_platform_header", hdrs = [":opt_platform"],
    strip_include_prefix = "generic_options", visibility = ["//sys/dev/backlight:__pkg__"])

# Option contents come from config(8), including deliberately empty headers.
[bsd_tree_file(name = "opt_" + option, tree = ":generic_config", member = "opt_" + option + ".h",
    output = "generic_options/opt_" + option + ".h",
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib"])
 for option in ["splash", "syscons", "teken", "evdev", "kbd", "scsi", "cam"]]
[cc_library(name = "generic_opt_" + option + "_header", hdrs = [":opt_" + option],
    strip_include_prefix = "generic_options", visibility = ["//sys/cam:__pkg__", "//sys/dev:__subpackages__"])
 for option in ["splash", "syscons", "teken", "evdev", "kbd", "scsi", "cam"]]

bsd_tree_file(name = "opt_bpf", tree = ":generic_config", member = "opt_bpf.h",
    output = "generic_options/opt_bpf.h", python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json", runtime = ["@bsd_sdk//toolchain:python_stdlib"])
cc_library(name = "generic_opt_bpf_header", hdrs = [":opt_bpf"],
    strip_include_prefix = "generic_options", visibility = ["//sys/netgraph:__pkg__", "//sys/netinet:__pkg__", "//sys/netpfil:__subpackages__"])

# USB driver options are extracted from the actual target config tree.
[bsd_tree_file(name = "opt_" + option, tree = ":generic_config", member = "opt_" + option + ".h",
    output = "generic_options/opt_" + option + ".h", python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json", runtime = ["@bsd_sdk//toolchain:python_stdlib"])
 for option in ["usb"]]
[cc_library(name = "generic_opt_" + option + "_header", hdrs = [":opt_" + option],
    strip_include_prefix = "generic_options", visibility = ["//sys/netgraph/bluetooth:__pkg__"])
 for option in ["usb"]]

# Filesystem module options come from the actual target configuration.
[bsd_tree_file(name = "opt_" + option, tree = ":generic_config", member = "opt_" + option + ".h",
    output = "generic_options/opt_" + option + ".h", python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json", runtime = ["@bsd_sdk//toolchain:python_stdlib"])
 for option in ["directio", "ffs", "quota", "suiddir", "tarfs", "ufs"]]
[cc_library(name = "generic_opt_" + option + "_header", hdrs = [":opt_" + option],
    strip_include_prefix = "generic_options", visibility = ["//sys/fs:__subpackages__", "//sys/ufs:__subpackages__"])
 for option in ["directio", "ffs", "quota", "suiddir", "tarfs", "ufs"]]

# NFS option contents are generated from the selected target configuration.
[bsd_tree_file(name = "opt_" + option, tree = ":generic_config", member = "opt_" + option + ".h",
    output = "generic_options/opt_" + option + ".h", python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json", runtime = ["@bsd_sdk//toolchain:python_stdlib"])
 for option in ["bootp", "kgssapi", "nfs", "nfsroot"]]
[cc_library(name = "generic_opt_" + option + "_header", hdrs = [":opt_" + option],
    strip_include_prefix = "generic_options", visibility = ["//sys/cddl/dev/dtrace:__pkg__", "//sys/modules/dtrace/dtraceall:__pkg__", "//sys/fs/nfs:__pkg__", "//sys/fs/nfsclient:__pkg__", "//sys/fs/nfsserver:__pkg__", "//sys/nlm:__pkg__", "//sys/nfs:__pkg__"])
 for option in ["bootp", "kgssapi", "nfs", "nfsroot"]]

# Virtual-network options are extracted from the actual target config tree.
[bsd_tree_file(name = "opt_" + option, tree = ":generic_config", member = "opt_" + option + ".h",
    output = "generic_options/opt_" + option + ".h", python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json", runtime = ["@bsd_sdk//toolchain:python_stdlib"])
 for option in ["carp", "ofed", "ratelimit", "vlan"]]
[cc_library(name = "generic_opt_" + option + "_header", hdrs = [":opt_" + option],
    strip_include_prefix = "generic_options", visibility = ["//sys/net:__pkg__", "//sys/netinet:__pkg__"])
 for option in ["carp", "ofed", "ratelimit", "vlan"]]

# WLAN option contents are generated by config for the selected target.
[bsd_tree_file(name = "opt_" + option, tree = ":generic_config", member = "opt_" + option + ".h",
    output = "generic_options/opt_" + option + ".h", python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json", runtime = ["@bsd_sdk//toolchain:python_stdlib"])
 for option in ["wlan", "tdma"]]
[cc_library(name = "generic_opt_" + option + "_header", hdrs = [":opt_" + option],
    strip_include_prefix = "generic_options", visibility = ["//sys/net80211:__pkg__"])
 for option in ["wlan", "tdma"]]

# Storage option contents come from the actual target config tree.
[bsd_tree_file(name = "opt_" + option, tree = ":generic_config", member = "opt_" + option + ".h",
    output = "generic_options/opt_" + option + ".h", python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json", runtime = ["@bsd_sdk//toolchain:python_stdlib"])
 for option in ["nvme"]]
[cc_library(name = "generic_opt_" + option + "_header", hdrs = [":opt_" + option],
    strip_include_prefix = "generic_options", visibility = ["//sys/dev/nvme:__pkg__", "//sys/dev/nvd:__pkg__", "//sys/dev/ahci:__pkg__"])
 for option in ["nvme"]]

# CAM peripheral options are generated by the selected target config.
[bsd_tree_file(name = "opt_" + option, tree = ":generic_config", member = "opt_" + option + ".h",
    output = "generic_options/opt_" + option + ".h", python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json", runtime = ["@bsd_sdk//toolchain:python_stdlib"])
 for option in ["kdtrace", "ada", "cd", "da", "pass", "pt", "sa", "ses"]]
[cc_library(name = "generic_opt_" + option + "_header", hdrs = [":opt_" + option],
    strip_include_prefix = "generic_options", visibility = ["//sys/cam:__pkg__"])
 for option in ["kdtrace", "ada", "cd", "da", "pass", "pt", "sa", "ses"]]

filegroup(name = "fasttrap_global_option", srcs = [":opt_global"], visibility = ["//sys/cddl/contrib/opensolaris:__pkg__"])
