exports_files(["minidump.h"], visibility = ["//lib/libkvm:__pkg__"])

load("@rules_cc//cc:defs.bzl", "cc_library")

# Preserve nested architecture headers under the same logical include namespace.
cc_library(name = "kernel_headers", hdrs = glob(["**/*.h"]),
    strip_include_prefix = ".", include_prefix = "machine", visibility = ["//visibility:public"])

# Source-tree header closure used by the amd64 libvmmapi build.
# vmm_dev.h includes <sys/hypertrace.h> (HyperTrace ioctls).
cc_library(name = "vmmapi_headers", hdrs = ['vmm.h', 'vmm_dev.h', 'vmm_snapshot.h'],
    strip_include_prefix = "/sys", deps = ["//sys/sys:hypertrace_header"], visibility = ["//lib/libvmmapi:__pkg__"])

# Explicit source-header closure for the amd64 bhyve engine.
cc_library(name = "bhyve_engine_headers", hdrs = ['vmm.h', 'vmm_dev.h', 'vmm_snapshot.h'], strip_include_prefix = "/sys", deps = ["//sys/sys:hypertrace_header"], visibility = ["//usr.sbin/bhyve:__pkg__"])

cc_library(name = "pc_bios_headers", hdrs = ["pc/bios.h"],
    strip_include_prefix = ".", include_prefix = "machine",
    visibility = ["//sys/modules/bios/smbios:__pkg__", "//sys/modules/bios/vpd:__pkg__"])

# Original module sources address Linux headers through machine/../linux.
filegroup(name = "architecture_view_machine_sources", srcs = glob(["*.h"]))
load("//tools/build/bazel:bsd_architecture_headers.bzl", "bsd_architecture_headers")
bsd_architecture_headers(name = "linux_module_headers", headers = {
    ":architecture_view_machine_sources": "machine",
    "//sys/amd64/linux:module_header_sources": "linux",
}, visibility = ["//sys/dev/aac:__pkg__", "//sys/dev/aacraid:__pkg__", "//sys/dev/ipmi:__pkg__", "//sys/dev/mfi:__pkg__", "//sys/dev/mrsas:__pkg__"])

bsd_architecture_headers(name = "compat_services_linux_headers", headers = {
    ":architecture_view_machine_sources": "machine",
    "//sys/amd64/linux:compat_services_architecture_header_sources": "linux",
}, visibility = ["//sys/amd64/linux:__pkg__", "//sys/amd64/sgx:__pkg__", "//sys/compat/linprocfs:__pkg__", "//sys/compat/linux:__pkg__", "//sys/dev/ntsync:__pkg__"])

# Both forms occur in unchanged Linuxulator sources; all headers are declared.
bsd_architecture_headers(name = "linux64_module_headers", headers = {
    ":architecture_view_machine_sources": "machine",
    "//sys/amd64/linux:module_generated_headers": "linux",
    "//sys/amd64/linux:module_generated_headers_for_arch": "amd64/linux",
}, visibility = ["//sys/amd64/linux:__pkg__", "//sys/compat/linux:__pkg__", "//sys/x86/linux:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")
filegroup(name = "standalone_lua_headers", srcs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'endian.h', 'metadata.h', 'param.h', 'setjmp.h'], visibility = ["//stand/liblua:__pkg__"])

filegroup(name = "libefi_headers", srcs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'endian.h', 'metadata.h', 'param.h'], visibility = ["//stand/efi/libefi:__pkg__"])

filegroup(name = "loader_fdt_headers", srcs = ['_limits.h', '_stdint.h', '_types.h', 'elf.h', 'endian.h', 'param.h'], visibility = ["//stand/fdt:__pkg__", "//stand/efi/fdt:__pkg__"])

filegroup(name = "standalone_ficl_headers", srcs = ['cpufunc.h', '_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'endian.h', 'metadata.h', 'param.h', 'setjmp.h'], visibility = ["//stand/ficl:__pkg__"])

filegroup(name = "standalone_sa_arch_headers", srcs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'asm.h', 'atomic.h', 'cpufunc.h', 'endian.h', 'fpu.h', 'param.h', 'pcb.h', 'proc.h', 'segments.h', 'setjmp.h', 'signal.h', 'specialreg.h', 'ucontext.h'], visibility = ["//stand/libsa:__pkg__"])

bsd_source_headers(name = "efi_loader_entry_headers", hdrs = ['_inttypes.h', '_limits.h', '_pmap.h', '_stdint.h', '_types.h', 'asmacros.h', 'cpufunc.h', 'elf.h', 'endian.h', 'exec.h', 'frame.h', 'metadata.h', 'param.h', 'pmap.h', 'psl.h', 'pte.h', 'segments.h', 'setjmp.h', 'specialreg.h', 'tss.h', 'vm.h', 'vmparam.h'], visibility = ["//stand/efi/loader:__pkg__"])

bsd_source_headers(name = 'efi_boot1_headers', hdrs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'elf.h', 'endian.h', 'param.h'], visibility = ["//stand/efi/boot1:__pkg__"])

bsd_source_headers(name = 'efi_gptboot_headers', hdrs = ['_limits.h', '_stdint.h', '_types.h', 'elf.h', 'endian.h', 'param.h'], visibility = ["//stand/efi/gptboot:__pkg__"])

bsd_source_headers(name = 'efi_loader_4th_headers', hdrs = ['_inttypes.h', '_limits.h', '_pmap.h', '_stdint.h', '_types.h', 'asmacros.h', 'cpufunc.h', 'elf.h', 'endian.h', 'exec.h', 'frame.h', 'metadata.h', 'param.h', 'pmap.h', 'psl.h', 'pte.h', 'segments.h', 'setjmp.h', 'specialreg.h', 'tss.h', 'vm.h', 'vmparam.h'], visibility = ["//stand/efi/loader_4th:__pkg__"])

bsd_source_headers(name = 'efi_loader_simp_headers', hdrs = ['_inttypes.h', '_limits.h', '_pmap.h', '_stdint.h', '_types.h', 'asmacros.h', 'cpufunc.h', 'elf.h', 'endian.h', 'exec.h', 'frame.h', 'metadata.h', 'param.h', 'pmap.h', 'psl.h', 'pte.h', 'segments.h', 'setjmp.h', 'specialreg.h', 'tss.h', 'vm.h', 'vmparam.h'], visibility = ["//stand/efi/loader_simp:__pkg__"])
