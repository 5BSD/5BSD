# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "makefs_headers", hdrs = ["bootsect.h", "bpb.h", "denode.h", "direntry.h", "fat.h", "msdosfsmount.h"],
    strip_include_prefix = "/sys", includes = ["."], visibility = ["//usr.sbin/makefs:__pkg__"])

cc_library(name = "filesystem_module_headers", hdrs = glob(["*.h"]), strip_include_prefix = "/sys",
    visibility = ["//sys/fs:__subpackages__", "//sys/ufs:__subpackages__"])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")

amd64_generic_module_objects(name = "msdosfs_module", srcs = ["msdosfs_conv.c", "msdosfs_denode.c", "msdosfs_fat.c", "msdosfs_lookup.c", "msdosfs_vfsops.c", "msdosfs_vnops.c"],
    deps = [":filesystem_module_headers", "//sys/vm:kernel_headers", "//sys/contrib/ck:kernel_headers", "//sys/security/mac:framework_headers", "//sys/security/audit:kernel_headers", "//sys/geom:kernel_headers"] + [], copts = [])
[cross_generic_module_objects(arch = arch, name = "msdosfs_module", srcs = ["msdosfs_conv.c", "msdosfs_denode.c", "msdosfs_fat.c", "msdosfs_lookup.c", "msdosfs_vfsops.c", "msdosfs_vnops.c"],
    deps = [":filesystem_module_headers", "//sys/vm:kernel_headers", "//sys/contrib/ck:kernel_headers", "//sys/security/mac:framework_headers", "//sys/security/audit:kernel_headers", "//sys/geom:kernel_headers"] + ["//sys/" + arch + "/conf:generic_" + option + "_header" for option in []], copts = [])
 for arch in ["arm64", "riscv"]]

amd64_generic_module_objects(name = "msdosfs_iconv_module", srcs = ["msdosfs_iconv.c"],
    deps = [":filesystem_module_headers", "//sys/vm:kernel_headers", "//sys/contrib/ck:kernel_headers"] + [], copts = [])
[cross_generic_module_objects(arch = arch, name = "msdosfs_iconv_module", srcs = ["msdosfs_iconv.c"],
    deps = [":filesystem_module_headers", "//sys/vm:kernel_headers", "//sys/contrib/ck:kernel_headers"] + ["//sys/" + arch + "/conf:generic_" + option + "_header" for option in []], copts = [])
 for arch in ["arm64", "riscv"]]

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

# Native filesystem/RPC physical prerequisites; identical contexts share providers.
bsd_source_headers(name = "filesystems_rpc_kernel_msdosfs_conv_headers", hdrs = ["bpb.h", "direntry.h", "msdosfsmount.h"],
    visibility = ["//sys/fs/cd9660:__pkg__", "//sys/fs/cuse:__pkg__", "//sys/fs/deadfs:__pkg__", "//sys/fs/fdescfs:__pkg__", "//sys/fs/fifofs:__pkg__", "//sys/fs/mntfs:__pkg__", "//sys/fs/msdosfs:__pkg__", "//sys/fs/nfs:__pkg__", "//sys/fs/nfsclient:__pkg__", "//sys/fs/nfsserver:__pkg__", "//sys/fs/nullfs:__pkg__", "//sys/nlm:__pkg__", "//sys/rpc:__pkg__", "//sys/ufs/ffs:__pkg__", "//sys/ufs/ufs:__pkg__", "//sys/xdr:__pkg__"])
bsd_source_headers(name = "filesystems_rpc_kernel_msdosfs_denode_headers", hdrs = ["bpb.h", "denode.h", "direntry.h", "fat.h", "msdosfsmount.h"],
    visibility = ["//sys/fs/cd9660:__pkg__", "//sys/fs/cuse:__pkg__", "//sys/fs/deadfs:__pkg__", "//sys/fs/fdescfs:__pkg__", "//sys/fs/fifofs:__pkg__", "//sys/fs/mntfs:__pkg__", "//sys/fs/msdosfs:__pkg__", "//sys/fs/nfs:__pkg__", "//sys/fs/nfsclient:__pkg__", "//sys/fs/nfsserver:__pkg__", "//sys/fs/nullfs:__pkg__", "//sys/nlm:__pkg__", "//sys/rpc:__pkg__", "//sys/ufs/ffs:__pkg__", "//sys/ufs/ufs:__pkg__", "//sys/xdr:__pkg__"])
bsd_source_headers(name = "filesystems_rpc_kernel_msdosfs_vfsops_headers", hdrs = ["bootsect.h", "bpb.h", "denode.h", "direntry.h", "fat.h", "msdosfsmount.h"],
    visibility = ["//sys/fs/cd9660:__pkg__", "//sys/fs/cuse:__pkg__", "//sys/fs/deadfs:__pkg__", "//sys/fs/fdescfs:__pkg__", "//sys/fs/fifofs:__pkg__", "//sys/fs/mntfs:__pkg__", "//sys/fs/msdosfs:__pkg__", "//sys/fs/nfs:__pkg__", "//sys/fs/nfsclient:__pkg__", "//sys/fs/nfsserver:__pkg__", "//sys/fs/nullfs:__pkg__", "//sys/nlm:__pkg__", "//sys/rpc:__pkg__", "//sys/ufs/ffs:__pkg__", "//sys/ufs/ufs:__pkg__", "//sys/xdr:__pkg__"])

load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")

load("//tools/build/bazel:kernel_common.bzl", "KERNEL_BUILTIN_WARNING_FLAGS")

# Native amd64 GENERIC filesystem/RPC built-ins.
amd64_generic_kernel_objects(name = "generic_filesystems_rpc_msdosfs_conv", srcs = ["msdosfs_conv.c"],
    deps = ["//sys/fs/msdosfs:filesystems_rpc_kernel_msdosfs_conv_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_filesystems_rpc_msdosfs_denode", srcs = ["msdosfs_denode.c"],
    deps = ["//sys/fs/msdosfs:filesystems_rpc_kernel_msdosfs_denode_headers", "//sys/vm:filesystems_rpc_kernel_nfs_clkdtrace_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_filesystems_rpc_msdosfs_fat", srcs = ["msdosfs_fat.c"],
    deps = ["//sys/fs/msdosfs:filesystems_rpc_kernel_msdosfs_denode_headers", "//sys/vm:filesystems_rpc_kernel_msdosfs_fat_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_filesystems_rpc_msdosfs_lookup", srcs = ["msdosfs_lookup.c"],
    deps = ["//sys/fs/msdosfs:filesystems_rpc_kernel_msdosfs_denode_headers", "//sys/vm:filesystems_rpc_kernel_msdosfs_fat_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_filesystems_rpc_msdosfs_vfsops", srcs = ["msdosfs_vfsops.c"],
    deps = ["//sys/fs/msdosfs:filesystems_rpc_kernel_msdosfs_vfsops_headers", "//sys/geom:filesystems_rpc_kernel_msdosfs_vfsops_headers", "//sys/vm:filesystems_rpc_kernel_msdosfs_fat_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_filesystems_rpc_msdosfs_vnops", srcs = ["msdosfs_vnops.c"],
    deps = ["//sys/fs/msdosfs:filesystems_rpc_kernel_msdosfs_denode_headers", "//sys/vm:filesystems_rpc_kernel_msdosfs_vnops_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)

load("//tools/build/bazel:bsd_public_headers.bzl", "public_header_installation")

# Public installed ABI headers follow include/Makefile source groups.
public_header_installation(name = "public_flat_fs_msdosfs_install", directory = "fs/msdosfs",
    files = {header: header.split("/")[-1] for header in glob(["*.h"], allow_empty = False)}, enabled = "//tools/build/bazel/config:includes_enabled")
