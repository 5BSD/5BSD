load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")

cc_library(name = "headers", hdrs = ["pseudofs.h", "pseudofs_internal.h"], includes = ["../.."],
    deps = ["//sys/contrib/ck:kernel_headers", "//sys/vm:kernel_headers"])
load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")
_KERNEL_SOURCES = ["pseudofs.c", "pseudofs_fileno.c", "pseudofs_vncache.c", "pseudofs_vnops.c"]
_KERNEL_DEPS = [":headers", "//sys/amd64/conf:generic_opt_pseudofs_header"]
amd64_generic_module_objects(srcs = _KERNEL_SOURCES, deps = _KERNEL_DEPS)
amd64_generic_kernel_objects(name = "generic_builtin", srcs = _KERNEL_SOURCES, deps = _KERNEL_DEPS)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")

[cross_generic_module_objects(
    arch = arch,
    srcs = _KERNEL_SOURCES,
    deps = [":headers", "//sys/" + arch + "/conf:generic_opt_pseudofs_header"],
) for arch in ["arm64", "riscv"]]

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

# Physical prerequisites for native LinuxKPI built-ins.
bsd_source_headers(name = "linuxkpi_kernel_linux_80211_fullmac_headers", hdrs = ["pseudofs.h"],
    visibility = ["//sys/compat/linuxkpi/common/src:__pkg__", "//sys/dev/bnxt:__pkg__", "//sys/dev/qlnx:__pkg__", "//sys/dev/irdma:__pkg__", "//sys/dev/mlx4/mlx4_core:__pkg__", "//sys/dev/mlx4/mlx4_ib:__pkg__", "//sys/dev/mlx5:__pkg__", "//sys/dev/mthca:__pkg__", "//sys/ofed/drivers/infiniband/core:__pkg__", "//sys/dev/cxgbe:__pkg__", "//sys/compat/lindebugfs:__pkg__", "//sys/compat/linprocfs:__pkg__", "//sys/compat/linsysfs:__pkg__"])
