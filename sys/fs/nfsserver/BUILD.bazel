_SOURCES = ["nfs_fha_new.c", "nfs_nfsdserv.c", "nfs_nfsdcache.c", "nfs_nfsdkrpc.c", "nfs_nfsdsocket.c", "nfs_nfsdstate.c", "nfs_nfsdsubs.c", "nfs_nfsdport.c"]
