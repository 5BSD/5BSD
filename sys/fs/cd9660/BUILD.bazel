    arch = arch,
    srcs = [
        "cd9660_bmap.c",
        "cd9660_lookup.c",
        "cd9660_node.c",
        "cd9660_rrip.c",
        "cd9660_util.c",
        "cd9660_vfsops.c",
        "cd9660_vnops.c",
