load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
cc_library(name = "headers", hdrs = ["mac_veriexec.h"], includes = ["../.."], visibility = ["//sys/security/mac:__pkg__", "//sys/security/mac_veriexec_parser:__pkg__"])
amd64_generic_module_objects(name = "sha1_module", srcs = ["mac_veriexec_sha1.c"], deps = [":headers", "//sys/crypto:sha1_headers"])
amd64_generic_module_objects(name = "sha256_module", srcs = ["mac_veriexec_sha256.c"], deps = [":headers", "//sys/crypto/sha2:module_headers"])
amd64_generic_module_objects(name = "sha384_module", srcs = ["mac_veriexec_sha384.c"], deps = [":headers", "//sys/crypto/sha2:module_headers"])
amd64_generic_module_objects(name = "sha512_module", srcs = ["mac_veriexec_sha512.c"], deps = [":headers", "//sys/crypto/sha2:module_headers"])

cc_library(name = "internal_headers", hdrs = ["mac_veriexec_internal.h"], includes = ["../.."], deps = [":headers"], visibility = ["//sys/security/mac_veriexec_parser:__pkg__"])
amd64_generic_module_objects(
    srcs = ["mac_veriexec.c", "veriexec_capimage.c", "veriexec_fingerprint.c", "veriexec_metadata.c"],
    deps = [":internal_headers", "//sys/security/mac:policy_headers", "//sys/security/mac:framework_headers",
        "//sys/amd64/conf:generic_opt_capsicum_header", "//sys/amd64/conf:generic_opt_mac_header",
        "//sys/amd64/conf:generic_opt_veriexec_header", "//sys/fs/nullfs:headers",
        "//sys/crypto/sha2:module_headers", "//sys/opencrypto:ed25519_headers"],
    copts = select({"//tools/build/bazel/config:veriexec_debug_enabled": ["-DVERIFIED_EXEC_DEBUG"], "//conditions:default": []}),
)

load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")
# GENERIC selects capimage verification and the SHA256 registration backend.
amd64_generic_kernel_objects(name = "generic_builtin",
    srcs = ["mac_veriexec.c", "veriexec_capimage.c", "veriexec_fingerprint.c", "veriexec_metadata.c", "mac_veriexec_sha256.c"],
    deps = [":internal_headers", "//sys/security/mac:policy_headers", "//sys/security/mac:framework_headers",
        "//sys/amd64/conf:generic_opt_capsicum_header", "//sys/amd64/conf:generic_opt_mac_header",
        "//sys/amd64/conf:generic_opt_veriexec_header", "//sys/fs/nullfs:headers",
        "//sys/crypto/sha2:module_headers", "//sys/opencrypto:ed25519_headers"])

# Userland rtld requires the syscall ABI, not kernel implementation headers.
cc_library(name = "rtld_abi_header", hdrs = ["mac_veriexec.h"], strip_include_prefix = "/sys",
    visibility = ["//libexec/rtld-elf:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

# Physical prerequisites for native peripheral device built-ins.
bsd_source_headers(name = "peripheral_devices_kernel_verified_exec_headers", hdrs = ["mac_veriexec.h", "mac_veriexec_internal.h"],
    visibility = ["//sys/dev/amdsmn:__pkg__", "//sys/dev/amdtemp:__pkg__", "//sys/dev/backlight:__pkg__", "//sys/dev/coretemp:__pkg__", "//sys/dev/cpuctl:__pkg__", "//sys/dev/cpufreq:__pkg__", "//sys/dev/dttransport:__pkg__", "//sys/dev/efidev:__pkg__", "//sys/dev/fb:__pkg__", "//sys/dev/ichsmb:__pkg__", "//sys/dev/iicbus:__pkg__", "//sys/dev/intpm:__pkg__", "//sys/dev/io:__pkg__", "//sys/dev/iommu:__pkg__", "//sys/dev/iwn:__pkg__", "//sys/dev/kbdmux:__pkg__", "//sys/dev/kvm_clock:__pkg__", "//sys/dev/led:__pkg__", "//sys/dev/md:__pkg__", "//sys/dev/mdio:__pkg__", "//sys/dev/mem:__pkg__", "//sys/dev/mlxfw:__pkg__", "//sys/dev/mmc:__pkg__", "//sys/dev/null:__pkg__", "//sys/dev/pci:__pkg__", "//sys/dev/puc:__pkg__", "//sys/dev/sdhci:__pkg__", "//sys/dev/smbios:__pkg__", "//sys/dev/smbus:__pkg__", "//sys/dev/tcp_log:__pkg__", "//sys/dev/tpm:__pkg__", "//sys/dev/uart:__pkg__", "//sys/dev/veriexec:__pkg__", "//sys/dev/video:__pkg__", "//sys/dev/vkbd:__pkg__", "//sys/dev/vmd:__pkg__", "//sys/dev/vmgenc:__pkg__", "//sys/dev/vmware:__pkg__", "//sys/dev/watchdog:__pkg__"])
