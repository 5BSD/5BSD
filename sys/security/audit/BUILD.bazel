# SPDX-License-Identifier: BSD-2-Clause
exports_files(['audit_syscalls.c'], visibility = ["//usr.sbin/BSDAudit/tests:__pkg__"])

load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "kernel_headers", hdrs = ["audit.h"], strip_include_prefix = ".",
    include_prefix = "security/audit", deps = ["//sys/bsm:kernel_headers"], visibility = ["//visibility:public"])

load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")
cc_library(name = "internal_headers", hdrs = ["audit_private.h", "audit_ioctl.h"], includes = ["../.."],
    deps = [":kernel_headers", "//sys/contrib/ck:kernel_headers", "//sys/vm:kernel_headers"])
# GENERIC AUDIT sources. DTAUDIT/DTRACEALL's audit_dtrace.c is a separate configuration.
amd64_generic_kernel_objects(name = "generic",
    srcs = ["audit.c", "audit_arg.c", "audit_bsm.c", "audit_bsm_db.c", "audit_bsm_klib.c",
        "audit_pipe.c", "audit_syscalls.c", "audit_trigger.c", "audit_worker.c",
        "bsm_domain.c", "bsm_errno.c", "bsm_fcntl.c", "bsm_socket_type.c", "bsm_token.c"],
    deps = [":internal_headers", "//sys/security/mac:framework_headers", "//sys/netinet:pcb_headers", "//sys/netinet:ipv4_wire_headers"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")
bsd_source_headers(name = "tracing_module_headers", hdrs = ["audit.h", "audit_private.h"],
    includes = [], visibility = ["//sys/dev/dttransport:__pkg__", "//sys/cddl/dev/hypertrace:__pkg__", "//sys/security/audit:__pkg__", "//sys/cddl/dev/dtmalloc:__pkg__", "//sys/fs/nfsclient:__pkg__", "//sys/cddl/dev/profile:__pkg__", "//sys/cddl/dev:__pkg__", "//sys/cddl/dev/sdt:__pkg__"])

load("//tools/build/bazel:cddl_generic_module.bzl", "amd64_cddl_module_objects", "cross_cddl_module_objects")

amd64_cddl_module_objects(name = "dtaudit_module", srcs = ["audit_dtrace.c"],
    deps = ["//sys/bsm:tracing_module_headers", "//sys/dev/dttransport:tracing_module_headers", "//sys/dev/vmm:tracing_module_headers", "//sys/fs/nfs:tracing_module_headers", "//sys/fs/nfsclient:tracing_module_headers", "//sys/security/audit:tracing_module_headers", "//sys/vm:tracing_module_headers", "//sys/cddl/dev/hypertrace:tracing_module_headers", "//sys/compat/linuxkpi/common/include/linux:tracing_module_headers", "//sys/contrib/ck:kernel_headers"], header_overrides = [])
[cross_cddl_module_objects(arch = arch, name = "dtaudit_module", srcs = ["audit_dtrace.c"],
    deps = ["//sys/bsm:tracing_module_headers", "//sys/dev/dttransport:tracing_module_headers", "//sys/dev/vmm:tracing_module_headers", "//sys/fs/nfs:tracing_module_headers", "//sys/fs/nfsclient:tracing_module_headers", "//sys/security/audit:tracing_module_headers", "//sys/vm:tracing_module_headers", "//sys/cddl/dev/hypertrace:tracing_module_headers", "//sys/compat/linuxkpi/common/include/linux:tracing_module_headers", "//sys/contrib/ck:kernel_headers"], header_overrides = [])
 for arch in ["arm64", "riscv"]]

# Core kernel physical prerequisites.
bsd_source_headers(name = "core_kernel_coredump_vnode_headers", hdrs = ["audit.h"],
    visibility = ["//sys/kern:__pkg__"])
bsd_source_headers(name = "core_kernel_kern_sendfile_headers", hdrs = ["audit.h"],
    visibility = ["//sys/kern:__pkg__"])
bsd_source_headers(name = "core_kernel_kern_envfd_headers", hdrs = ["audit.h"],
    visibility = ["//sys/kern:__pkg__"])
bsd_source_headers(name = "core_kernel_sys_process_headers", hdrs = ["audit.h"],
    visibility = ["//sys/kern:__pkg__"])
bsd_source_headers(name = "core_kernel_uipc_mqueue_headers", hdrs = ["audit.h"],
    visibility = ["//sys/kern:__pkg__"])
bsd_source_headers(name = "core_kernel_uipc_vsock_user_headers", hdrs = ["audit.h"],
    visibility = ["//sys/kern:__pkg__"])

# Virtual-memory built-in prerequisites.
bsd_source_headers(name = "vm_kernel_vm_mmap_headers", hdrs = ["audit.h"],
    visibility = ["//sys/vm:__pkg__"])

# IPv4 built-in prerequisites.
bsd_source_headers(name = "ipv4_kernel_in_prot_headers", hdrs = ["audit.h"],
    visibility = ["//sys/netinet:__pkg__"])

# Network built-in prerequisites.
bsd_source_headers(name = "net_kernel_bpf_headers", hdrs = ["audit.h"],
    visibility = ["//sys/net:__pkg__"])

# Low-level amd64 built-in prerequisites.
bsd_source_headers(name = "lowlevel_kernel_sys_machdep_headers", hdrs = ["audit.h"],
    visibility = ["//sys/amd64/amd64:__pkg__"])
bsd_source_headers(name = "lowlevel_kernel_trap_headers", hdrs = ["audit.h"],
    visibility = ["//sys/amd64/amd64:__pkg__"])
