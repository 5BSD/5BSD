# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(name = "framework_headers", hdrs = ["mac_framework.h"],
    strip_include_prefix = ".", include_prefix = "security/mac",
    deps = ["//sys/ddb:kernel_headers"], visibility = ["//visibility:public"])

cc_library(name = "policy_headers", hdrs = ["mac_policy.h"], includes = ["../.."],
    deps = ["//sys/ddb:kernel_headers"], visibility = ["//visibility:public"])

load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")
cc_library(name = "internal_headers", hdrs = ["mac_internal.h", "mac_syscalls.h", "mac_trace_args.h"], includes = ["../.."],
    deps = [":framework_headers", ":policy_headers", "//sys/contrib/ck:kernel_headers", "//sys/vm:kernel_headers"], visibility = ["//sys/kern:__pkg__"])
# GENERIC selects MAC, AUDIT, INET and INET6; arbitrary configurations remain pending.
amd64_generic_kernel_objects(name = "generic_control",
    srcs = ["mac_audit.c", "mac_cred.c", "mac_kdb.c", "mac_framework.c", "mac_label.c", "mac_pipe.c",
        "mac_posix_sem.c", "mac_posix_shm.c", "mac_prison.c", "mac_priv.c", "mac_process.c", "mac_socket.c",
        "mac_syscalls.c", "mac_system.c", "mac_sysv_msg.c", "mac_sysv_sem.c", "mac_sysv_shm.c"],
    deps = [":internal_headers", "//sys/amd64/conf:generic_opt_mac_header", "//sys/amd64/conf:generic_opt_posix_header",
        "//sys/security/audit:kernel_headers", "//sys/security/mac_veriexec:headers", "//sys/net:interface_headers", "//sys/netinet:ip_headers"])

amd64_generic_kernel_objects(name = "generic_network",
    srcs = ["mac_net.c", "mac_inet.c", "mac_inet6.c"],
    deps = [":internal_headers", "//sys/amd64/conf:generic_opt_mac_header",
        "//sys/net:interface_headers", "//sys/netinet:ip_headers", "//sys/netinet6:ip6_headers"])
amd64_generic_kernel_objects(name = "generic_vfs", srcs = ["mac_vfs.c"],
    deps = [":internal_headers", "//sys/amd64/conf:generic_opt_mac_header", "//sys/fs/devfs:kernel_headers"])
filegroup(name = "generic_object_files", srcs = [":generic_control_object_files", ":generic_network_object_files", ":generic_vfs_object_files"], visibility = ["//visibility:public"])

