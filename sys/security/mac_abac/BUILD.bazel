load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
cc_library(name = "headers", hdrs = ["abac_dtrace.h", "mac_abac.h"],
    deps = ["//sys/security/mac:policy_headers", "//sys/contrib/ck:kernel_headers", "//sys/vm:kernel_headers"])
load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")
_KERNEL_SOURCES = ["abac_cred.c", "abac_kenv.c", "abac_label.c", "abac_match.c", "abac_pipe.c", "abac_posixsem.c", "abac_posixshm.c", "abac_proc.c", "abac_rules.c", "abac_socket.c", "abac_syscall.c", "abac_system.c", "abac_sysv.c", "abac_vnode.c", "mac_abac.c"]
_KERNEL_DEPS = [":headers"]
amd64_generic_module_objects(srcs = _KERNEL_SOURCES, deps = _KERNEL_DEPS)
amd64_generic_kernel_objects(name = "generic_builtin", srcs = _KERNEL_SOURCES, deps = _KERNEL_DEPS)

# Public management ABI; userland clients must not import kernel-only headers.
cc_library(name = "abi_headers", hdrs = ["mac_abac.h"], strip_include_prefix = "/sys",
    visibility = ["//usr.sbin/mac_abacd:__pkg__", "//usr.sbin/mac_abac_ctl:__pkg__"])
exports_files(["mac_abac.h"], visibility = ["//usr.sbin/mac_abac_ctl:__pkg__"])
