load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")

cc_library(name = "kernel_headers", hdrs = ["amdsmu.h", "amdsmu_reg.h"],
    strip_include_prefix = "/sys")

amd64_generic_module_objects(
    srcs = ["amdsmu.c"],
    deps = [":kernel_headers", "//sys/amd64/conf:generic_opt_acpi_header",
        "//sys/contrib/dev/acpica/include:kernel_headers", "//sys/dev/acpica:acpivar_headers",
        "//sys/dev/pci:kernel_headers", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers"],
)
