load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = glob(["*_if.m"]))

load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "register_headers", hdrs = ["pcireg.h"], includes = ["../.."], visibility = ["//sys/dev/iommu:__pkg__"])

# Explicit source-header closure for the amd64 bhyve engine.
cc_library(name = "bhyve_engine_headers", hdrs = ['pcireg.h'], strip_include_prefix = "/sys", visibility = ["//usr.sbin/bhyve:__pkg__"])

cc_library(name = "acpi_register_headers", hdrs = ["pcireg.h"], strip_include_prefix = "/sys", visibility = ["//usr.sbin/acpi/einj:__pkg__"])

filegroup(name = "pci_if_header_file", srcs = [":pci_if"], output_group = "header")
cc_library(name = "pci_if_headers", hdrs = [":pci_if_header_file"],
    strip_include_prefix = "pci_if.generated", visibility = ["//sys/dev/alc:__pkg__", "//sys/dev/ale:__pkg__", "//sys/dev/aq:__pkg__", "//sys/dev/bce:__pkg__", "//sys/dev/bge:__pkg__", "//sys/dev/et:__pkg__", "//sys/dev/jme:__pkg__", "//sys/dev/msk:__pkg__", "//sys/dev/nfe:__pkg__", "//sys/dev/re:__pkg__", "//sys/dev/rge:__pkg__", "//sys/dev/sge:__pkg__", "//sys/dev/vte:__pkg__", "//visibility:public"])
cc_library(name = "kernel_headers", hdrs = ["pcireg.h", "pcivar.h"],
    strip_include_prefix = "/sys", deps = [":pci_if_headers"],
    visibility = ["//visibility:public"])

# Physical source closure used by the native storage module candidates.
cc_library(name = "storage_module_headers", hdrs = ["pcireg.h", "pcivar.h"],
    visibility = ["//sys/dev/nvme:__pkg__", "//sys/dev/nvd:__pkg__", "//sys/dev/ahci:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

# Physical source prerequisites from independent Ethernet module builds.
bsd_source_headers(name = "pci_ethernet_headers", hdrs = ["pcireg.h", "pcivar.h"], visibility = ["//sys/dev/alc:__pkg__", "//sys/dev/ale:__pkg__", "//sys/dev/aq:__pkg__", "//sys/dev/bce:__pkg__", "//sys/dev/bge:__pkg__", "//sys/dev/et:__pkg__", "//sys/dev/jme:__pkg__", "//sys/dev/msk:__pkg__", "//sys/dev/nfe:__pkg__", "//sys/dev/re:__pkg__", "//sys/dev/rge:__pkg__", "//sys/dev/sge:__pkg__", "//sys/dev/vte:__pkg__"])

# Physical prerequisites consumed by independent MII-family module builds.
bsd_source_headers(name = "mii_family_headers", hdrs = ["pcireg.h", "pcivar.h"], visibility = ["//sys/dev/mii:__pkg__"])

# Physical prerequisites consumed by independent network-support module builds.
bsd_source_headers(name = "network_support_headers", hdrs = ["pci_iov.h", "pci_private.h", "pcireg.h", "pcivar.h"], visibility = ["//sys/net:__pkg__"])

filegroup(name = "pci_iov_if_header_file", srcs = [":pci_iov_if"], output_group = "header")
cc_library(name = "pci_iov_if_headers", hdrs = [":pci_iov_if_header_file"],
    strip_include_prefix = "pci_iov_if.generated", visibility = ["//sys/net:__pkg__"])

# Network built-in prerequisites.
bsd_source_headers(name = "net_kernel_iflib_headers", hdrs = ["pci_iov.h", "pci_private.h", "pcireg.h", "pcivar.h"],
    visibility = ["//sys/net:__pkg__"])

# MII built-in prerequisites.
bsd_source_headers(name = "mii_kernel_brgphy_headers", hdrs = ["pcireg.h", "pcivar.h"],
    visibility = ["//sys/dev/mii:__pkg__"])

# x86 core built-in prerequisites.
bsd_source_headers(name = "x86_core_kernel_legacy_headers", hdrs = ["pcireg.h"],
    visibility = ["//sys/x86/x86:__pkg__"])
bsd_source_headers(name = "x86_core_kernel_io_apic_headers", hdrs = ["pcireg.h", "pcivar.h"],
    visibility = ["//sys/x86/x86:__pkg__"])
bsd_source_headers(name = "x86_core_kernel_msi_headers", hdrs = ["pcivar.h"],
    visibility = ["//sys/x86/x86:__pkg__"])

# Native x86 core consumer of the existing PCI bridge interface producer.
filegroup(name = "pcib_if_header_file", srcs = [":pcib_if"], output_group = "header")
cc_library(name = "pcib_if_headers", hdrs = [":pcib_if_header_file"],
    strip_include_prefix = "pcib_if.generated", visibility = ["//sys/dev/acpica:__pkg__", "//sys/x86/x86:__pkg__"])

# ACPI core built-in prerequisites.
bsd_source_headers(name = "acpica_core_kernel_acpi_headers", hdrs = ["pcivar.h"],
    visibility = ["//sys/dev/acpica:__pkg__"])
bsd_source_headers(name = "acpica_core_kernel_acpi_apei_headers", hdrs = ["pcireg.h", "pcivar.h"],
    visibility = ["//sys/dev/acpica:__pkg__"])
bsd_source_headers(name = "acpica_core_kernel_acpi_cpu_headers", hdrs = ["pcivar.h"],
    visibility = ["//sys/dev/acpica:__pkg__"])
bsd_source_headers(name = "acpica_core_kernel_acpi_throttle_headers", hdrs = ["pcivar.h"],
    visibility = ["//sys/dev/acpica:__pkg__"])
bsd_source_headers(name = "acpica_core_kernel_acpi_pci_headers", hdrs = ["pci_private.h", "pcireg.h", "pcivar.h"],
    visibility = ["//sys/dev/acpica:__pkg__"])
bsd_source_headers(name = "acpica_core_kernel_acpi_pci_link_headers", hdrs = ["pcireg.h", "pcivar.h"],
    visibility = ["//sys/dev/acpica:__pkg__"])
bsd_source_headers(name = "acpica_core_kernel_acpi_pcib_headers", hdrs = ["pcireg.h", "pcivar.h"],
    visibility = ["//sys/dev/acpica:__pkg__"])
bsd_source_headers(name = "acpica_core_kernel_acpi_pcib_acpi_headers", hdrs = ["pcib_private.h", "pcireg.h", "pcivar.h"],
    visibility = ["//sys/dev/acpica:__pkg__"])
bsd_source_headers(name = "acpica_core_kernel_acpi_pcib_pci_headers", hdrs = ["pcib_private.h", "pcireg.h", "pcivar.h"],
    visibility = ["//sys/dev/acpica:__pkg__"])
bsd_source_headers(name = "acpica_core_kernel_acpi_timer_headers", hdrs = ["pcivar.h"],
    visibility = ["//sys/dev/acpica:__pkg__"])

# Native ISCI built-in physical prerequisites, with identical closures shared.
bsd_source_headers(name = "isci_kernel_isci_headers", hdrs = ["pcireg.h", "pcivar.h"],
    visibility = ["//sys/dev/isci:__pkg__"])

# Physical prerequisites for native LinuxKPI built-ins.
bsd_source_headers(name = "linuxkpi_kernel_linuxkpi_80211_pm_headers", hdrs = ["pci_private.h", "pcireg.h", "pcivar.h"],
    visibility = ["//sys/compat/linuxkpi/common/src:__pkg__"])
bsd_source_headers(name = "linuxkpi_kernel_linux_pci_headers", hdrs = ["pci_iov.h", "pci_private.h", "pcireg.h", "pcivar.h"],
    visibility = ["//sys/compat/linuxkpi/common/src:__pkg__"])

filegroup(name = "linuxkpi_pci_if_header_file", srcs = [":pci_if"], output_group = "header")
cc_library(name = "linuxkpi_pci_if_headers", hdrs = [":linuxkpi_pci_if_header_file"],
    strip_include_prefix = "pci_if.generated", visibility = ["//sys/compat/linuxkpi/common/src:__pkg__"])

filegroup(name = "linuxkpi_pci_iov_if_header_file", srcs = [":pci_iov_if"], output_group = "header")
cc_library(name = "linuxkpi_pci_iov_if_headers", hdrs = [":linuxkpi_pci_iov_if_header_file"],
    strip_include_prefix = "pci_iov_if.generated", visibility = ["//sys/compat/linuxkpi/common/src:__pkg__"])

filegroup(name = "linuxkpi_pcib_if_header_file", srcs = [":pcib_if"], output_group = "header")
cc_library(name = "linuxkpi_pcib_if_headers", hdrs = [":linuxkpi_pcib_if_header_file"],
    strip_include_prefix = "pcib_if.generated", visibility = ["//sys/compat/linuxkpi/common/src:__pkg__"])

# Physical Atheros driver/HAL prerequisites; identical contexts share providers.
bsd_source_headers(name = "ath_kernel_if_ath_pci_headers", hdrs = ["pcireg.h", "pcivar.h"],
    visibility = ["//sys/dev/ath:__pkg__", "//sys/contrib/dev/ath:__pkg__"])

# Physical native Intel NIC built-in prerequisites.
bsd_source_headers(name = "intel_nic_kernel_if_em_headers", hdrs = ["pci_iov.h", "pcireg.h", "pcivar.h"],
    visibility = ["//sys/dev/e1000:__pkg__", "//sys/dev/ixgbe:__pkg__", "//sys/dev/ice:__pkg__"])
bsd_source_headers(name = "intel_nic_kernel_if_igbv_headers", hdrs = ["pcireg.h", "pcivar.h"],
    visibility = ["//sys/dev/e1000:__pkg__", "//sys/dev/ixgbe:__pkg__", "//sys/dev/ice:__pkg__"])

filegroup(name = "intel_nic_pci_if_header_file", srcs = [":pci_if"], output_group = "header")
cc_library(name = "intel_nic_pci_if_headers", hdrs = [":intel_nic_pci_if_header_file"],
    strip_include_prefix = "pci_if.generated", visibility = ["//sys/dev/e1000:__pkg__", "//sys/dev/ixgbe:__pkg__", "//sys/dev/ice:__pkg__"])

filegroup(name = "intel_nic_pci_iov_if_header_file", srcs = [":pci_iov_if"], output_group = "header")
cc_library(name = "intel_nic_pci_iov_if_headers", hdrs = [":intel_nic_pci_iov_if_header_file"],
    strip_include_prefix = "pci_iov_if.generated", visibility = ["//sys/dev/e1000:__pkg__", "//sys/dev/ixgbe:__pkg__", "//sys/dev/ice:__pkg__"])

# Native Mellanox physical prerequisites and ordered OFED/LinuxKPI roots.
bsd_source_headers(name = "mlx_kernel_mlx5_alloc_headers", hdrs = ["pci_private.h", "pcireg.h", "pcivar.h"],
    visibility = ["//sys/dev/mlx5:__pkg__"])
bsd_source_headers(name = "mlx_kernel_mlx5_main_headers", hdrs = ["pci_iov.h", "pci_private.h", "pcireg.h", "pcivar.h"],
    visibility = ["//sys/dev/mlx5:__pkg__"])

filegroup(name = "mlx_pci_if_header_file", srcs = [":pci_if"], output_group = "header")
cc_library(name = "mlx_pci_if_headers", hdrs = [":mlx_pci_if_header_file"],
    strip_include_prefix = "pci_if.generated", visibility = ["//sys/dev/mlx5:__pkg__"])

filegroup(name = "mlx_pci_iov_if_header_file", srcs = [":pci_iov_if"], output_group = "header")
cc_library(name = "mlx_pci_iov_if_headers", hdrs = [":mlx_pci_iov_if_header_file"],
    strip_include_prefix = "pci_iov_if.generated", visibility = ["//sys/dev/mlx5:__pkg__"])
