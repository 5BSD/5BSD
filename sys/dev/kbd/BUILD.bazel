load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(name = 'kernel_headers', hdrs = ['kbdreg.h'],
    strip_include_prefix = "/sys",
    deps = ['//sys/amd64/conf:generic_opt_kbd_header'],
    visibility = ['//sys/dev/evdev:__pkg__'])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

bsd_source_headers(name = "acpi_support_headers", hdrs = ["kbdreg.h"], visibility = ["//sys/dev/acpi_support:__pkg__", "//sys/dev/acpica:__pkg__"])

# Core kernel physical prerequisites.
bsd_source_headers(name = "core_kernel_kern_cons_headers", hdrs = ["kbdreg.h"],
    visibility = ["//sys/kern:__pkg__"])

# ACPI core built-in prerequisites.
bsd_source_headers(name = "acpica_core_kernel_acpi_button_headers", hdrs = ["kbdreg.h"],
    visibility = ["//sys/dev/acpica:__pkg__"])
bsd_source_headers(name = "acpica_core_kernel_acpi_lid_headers", hdrs = ["kbdreg.h"],
    visibility = ["//sys/dev/acpica:__pkg__"])

# Physical device I/O prerequisites; identical contexts share providers.
bsd_source_headers(name = "device_io_kernel_cdev_headers", hdrs = ["kbdreg.h"],
    visibility = ["//sys/dev/usb/controller:__pkg__", "//sys/dev/sound/pci/hda:__pkg__", "//sys/dev/sound/midi:__pkg__", "//sys/dev/sound/pcm:__pkg__", "//sys/dev/sound/usb:__pkg__", "//sys/dev/usb/net:__pkg__", "//sys/dev/atkbdc:__pkg__", "//sys/dev/evdev:__pkg__", "//sys/dev/sound:__pkg__", "//sys/dev/hid:__pkg__", "//sys/dev/kbd:__pkg__", "//sys/dev/usb:__pkg__", "//sys/dev/vt:__pkg__", "//sys/teken:__pkg__"])
bsd_source_headers(name = "device_io_kernel_hkbd_headers", hdrs = ["kbdreg.h", "kbdtables.h"],
    visibility = ["//sys/dev/usb/controller:__pkg__", "//sys/dev/sound/pci/hda:__pkg__", "//sys/dev/sound/midi:__pkg__", "//sys/dev/sound/pcm:__pkg__", "//sys/dev/sound/usb:__pkg__", "//sys/dev/usb/net:__pkg__", "//sys/dev/atkbdc:__pkg__", "//sys/dev/evdev:__pkg__", "//sys/dev/sound:__pkg__", "//sys/dev/hid:__pkg__", "//sys/dev/kbd:__pkg__", "//sys/dev/usb:__pkg__", "//sys/dev/vt:__pkg__", "//sys/teken:__pkg__"])

load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")

load("//tools/build/bazel:kernel_common.bzl", "KERNEL_BUILTIN_WARNING_FLAGS")

# Native amd64 GENERIC device I/O built-ins.
amd64_generic_kernel_objects(name = "generic_device_io_kbd", srcs = ["kbd.c"],
    deps = ["//sys/dev/evdev:device_io_kernel_kbd_headers", "//sys/dev/kbd:device_io_kernel_cdev_headers", "//sys/amd64/conf:device_io_kernel_opt_kbd_header"], warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)

# Physical prerequisites for native virtualization built-ins.
bsd_source_headers(name = "virtualization_kernel_hv_kbd_headers", hdrs = ["kbdreg.h", "kbdtables.h"],
    visibility = ["//sys/dev/hyperv:__pkg__", "//sys/dev/hyperv/vmbus:__pkg__", "//sys/dev/virtio:__pkg__", "//sys/dev/virtio/balloon:__pkg__", "//sys/dev/virtio/block:__pkg__", "//sys/dev/virtio/dtrace:__pkg__", "//sys/dev/virtio/network:__pkg__", "//sys/dev/virtio/pci:__pkg__", "//sys/dev/virtio/scsi:__pkg__", "//sys/dev/virtio/vsock:__pkg__", "//sys/dev/xen:__pkg__"])
bsd_source_headers(name = "virtualization_kernel_hv_kbdc_headers", hdrs = ["kbdreg.h"],
    visibility = ["//sys/dev/hyperv:__pkg__", "//sys/dev/hyperv/vmbus:__pkg__", "//sys/dev/virtio:__pkg__", "//sys/dev/virtio/balloon:__pkg__", "//sys/dev/virtio/block:__pkg__", "//sys/dev/virtio/dtrace:__pkg__", "//sys/dev/virtio/network:__pkg__", "//sys/dev/virtio/pci:__pkg__", "//sys/dev/virtio/scsi:__pkg__", "//sys/dev/virtio/vsock:__pkg__", "//sys/dev/xen:__pkg__"])
