load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "headers", hdrs = glob(["*.h", "controller/*.h"]), strip_include_prefix = ".", include_prefix = "dev/nvmf",
    deps = ["//sys/dev/nvme:headers"], visibility = ["//visibility:public"])
cc_library(name = "private_headers", hdrs = ["nvmf_tcp.h", "controller/nvmft_subr.h"], includes = [".", "controller"],
    deps = [":headers"], visibility = ["//lib/libnvmf:__pkg__"])
exports_files(["controller/nvmft_subr.c"], visibility = ["//lib/libnvmf:__pkg__"])
