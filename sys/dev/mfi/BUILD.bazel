    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_storage_controllers_mfi_debug", srcs = ["mfi_debug.c"],
    deps = ["//sys/amd64/conf:storage_controllers_kernel_opt_mfi_header"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_storage_controllers_mfi_pci", srcs = ["mfi_pci.c"],
