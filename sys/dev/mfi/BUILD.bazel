    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_storage_controllers_mfi_syspd", srcs = ["mfi_syspd.c"],
    deps = ["//sys/cam:storage_controllers_kernel_mfi_headers", "//sys/dev/mfi:storage_controllers_kernel_mfi_headers", "//sys/geom:storage_controllers_kernel_aac_headers", "//sys/net:storage_controllers_kernel_aac_headers", "//sys/netinet:storage_controllers_kernel_aac_headers", "//sys/netinet6:storage_controllers_kernel_aac_headers", "//sys/vm:storage_controllers_kernel_aac_disk_headers", "//sys/kern:storage_controllers_kernel_bus_if_headers", "//sys/kern:storage_controllers_kernel_device_if_headers", "//sys/amd64/conf:storage_controllers_kernel_opt_mfi_header"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_storage_controllers_mfi_tbolt", srcs = ["mfi_tbolt.c"],
    deps = ["//sys/cam:storage_controllers_kernel_mfi_headers", "//sys/dev/mfi:storage_controllers_kernel_mfi_headers", "//sys/kern:storage_controllers_kernel_bus_if_headers", "//sys/kern:storage_controllers_kernel_device_if_headers", "//sys/amd64/conf:storage_controllers_kernel_opt_mfi_header"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)

# Existing userland header providers retain their target/include namespace.
exports_files(["mfi_ioctl.h", "mfireg.h"], visibility = ["//:__pkg__"])
