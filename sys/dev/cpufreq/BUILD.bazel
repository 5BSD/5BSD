load("//tools/build/bazel:kernel_amd64.bzl", "AMD64_KERNEL_WARNING_FLAGS")

amd64_generic_module_objects(name = "cpufreq_ichss_module", srcs = ["ichss.c"],
    deps = ["//sys/dev/pci:x86_core_kernel_msi_headers", "//sys/kern:bus_if_headers", "//sys/kern:cpufreq_if_headers", "//sys/kern:device_if_headers", "//sys/dev/pci:pci_if_headers"],
