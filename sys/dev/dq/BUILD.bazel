load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "headers", hdrs = ["dq.h", "dq_observe_proto.h"], strip_include_prefix = "/sys",
    visibility = ["//visibility:public"])
exports_files(["dq.h", "dq_observe_proto.h"], visibility = ["//lib/libdq:__pkg__"])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
cc_library(name = "kernel_headers", hdrs = ["dq.h", "dq_kern.h", "dq_observe_proto.h", "dq_var.h"],
    includes = ["../.."], visibility = ["//sys/security/oes:__pkg__", "//sys/security/mac_abac:__pkg__"],
    deps = ["//sys/contrib/ck:kernel_headers", "//sys/vm:kernel_headers"])
load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")
_KERNEL_SOURCES = ["dq_dev.c", "dq_queue.c", "dq_file.c", "dq_observer.c", "dq_observe.c",
        "dq_pager.c", "dq_async.c"]
_KERNEL_DEPS = [":kernel_headers", "//sys/amd64/conf:generic_opt_dq_header", "//sys/amd64/conf:generic_opt_mac_header",
        "//sys/security/mac:policy_headers", "//sys/dev/mac_capability:label_headers",
        "//sys/dev/mac_capability:kernel_headers"]
amd64_generic_module_objects(srcs = _KERNEL_SOURCES, deps = _KERNEL_DEPS)
amd64_generic_kernel_objects(name = "generic_builtin", srcs = _KERNEL_SOURCES, deps = _KERNEL_DEPS)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")

[cross_generic_module_objects(
    arch = arch,
    srcs = _KERNEL_SOURCES,
    deps = [
        ":kernel_headers",
        "//sys/" + arch + "/conf:generic_opt_dq_header",
        "//sys/" + arch + "/conf:generic_opt_mac_header",
        "//sys/security/mac:policy_headers",
        "//sys/dev/mac_capability:label_headers",
        "//sys/dev/mac_capability:kernel_headers",
    ],
) for arch in ["arm64", "riscv"]]

load("//tools/build/bazel:bsd_public_headers.bzl", "public_header_installation")

# Public installed ABI headers follow include/Makefile source groups (DQ).
public_header_installation(name = "public_group_dq_install", directory = "dev/dq",
    files = {"dq.h": "dq.h", "dq_observe_proto.h": "dq_observe_proto.h"}, enabled = "//tools/build/bazel/config:includes_enabled")
