# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "headers", hdrs = ["dq.h", "dq_observe_proto.h"], strip_include_prefix = "/sys",
    visibility = ["//visibility:public"])
exports_files(["dq.h", "dq_observe_proto.h"], visibility = ["//lib/libdq:__pkg__"])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
cc_library(name = "kernel_headers", hdrs = ["dq.h", "dq_kern.h", "dq_observe_proto.h", "dq_var.h"],
    includes = ["../.."], visibility = ["//sys/security/oes:__pkg__", "//sys/security/mac_abac:__pkg__"],
    deps = ["//sys/contrib/ck:kernel_headers", "//sys/vm:kernel_headers"])
load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")
_KERNEL_SOURCES = ["dq_dev.c", "dq_queue.c", "dq_file.c", "dq_observer.c", "dq_observe.c",
        "dq_pager.c", "dq_async.c", "dq_resolve.c", "dq_dir.c"]
_KERNEL_DEPS = [":kernel_headers", "//sys/amd64/conf:generic_opt_dq_header", "//sys/amd64/conf:generic_opt_mac_header",
        "//sys/security/mac:framework_headers", "//sys/security/mac:policy_headers",
        "//sys/crypto/siphash:kernel_headers", "//sys/dev/mac_capability:label_headers",
        "//sys/dev/mac_capability:kernel_headers"]
_MODULE_DEPS = [dep for dep in _KERNEL_DEPS if dep != "//sys/amd64/conf:generic_opt_dq_header"] + [
    "//sys/modules/dq:module_opt_dq_header", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers"]
amd64_generic_module_objects(srcs = _KERNEL_SOURCES, deps = _MODULE_DEPS)
amd64_generic_kernel_objects(name = "generic_builtin", srcs = _KERNEL_SOURCES, deps = _KERNEL_DEPS)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")

[cross_generic_module_objects(
    arch = arch,
    srcs = _KERNEL_SOURCES,
    deps = [
        ":kernel_headers",
        "//sys/modules/dq:module_opt_dq_header",
        "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers",
        "//sys/" + arch + "/conf:generic_opt_mac_header",
        "//sys/security/mac:framework_headers", "//sys/security/mac:policy_headers",
        "//sys/crypto/siphash:kernel_headers",
        "//sys/dev/mac_capability:label_headers",
        "//sys/dev/mac_capability:kernel_headers",
    ],
) for arch in ["arm64", "riscv"]]

load("//tools/build/bazel:bsd_public_headers.bzl", "public_header_installation")

# Public installed ABI headers follow include/Makefile source groups (DQ).
public_header_installation(name = "public_group_dq_install", directory = "dev/dq",
    files = {"dq.h": "dq.h", "dq_observe_proto.h": "dq_observe_proto.h"}, enabled = "//tools/build/bazel/config:includes_enabled")

# The repository view declares all C/header files across package boundaries.
# The checker's explicit file list avoids grep -r skipping sandbox symlinks.
load("//tools/build/bazel:bsd_script_output.bzl", "bsd_script_output")
bsd_script_output(name = "resolve_ledger_check", script = "//sys/tools:dq_resolve_ledger.sh",
    src = "@kernel_audit_src//:sources/.dq-audit-root", input_mode = "directory",
    directory_anchor = ".dq-audit-root", arguments = ["check"],
    inputs = ["@kernel_audit_src//:sources"],
    additional_sources = ["dq_resolve_ledger.txt", "@kernel_audit_src//:source.list"],
    output = "resolve_ledger.checked",
    shell = "@bsd_sdk//toolchain:sh", redirect = "@bsd_sdk//toolchain:stdout_redirect",
    path_tools = {"@bsd_sdk//toolchain:awk": "awk", "@bsd_sdk//toolchain:sed": "sed",
        "@bsd_sdk//toolchain:rm": "rm", "@bsd_sdk//toolchain:extra_grep": "grep",
        "@bsd_sdk//toolchain:extra_sort": "sort", "@bsd_sdk//toolchain:extra_mktemp": "mktemp",
        "//usr.bin/find:find": "find", "//usr.bin/xargs:xargs": "xargs",
        "//usr.bin/cmp:cmp": "cmp", "//usr.bin/diff:diff": "diff"},
    runtime_libraries = ["@bsd_sdk//toolchain:sh_runtime", "@bsd_sdk//toolchain:awk_runtime",
        "@bsd_sdk//toolchain:sed_runtime", "@bsd_sdk//toolchain:rm_runtime",
        "@bsd_sdk//toolchain:extra_grep_runtime", "@bsd_sdk//toolchain:extra_sort_runtime",
        "@bsd_sdk//toolchain:extra_mktemp_runtime", "//lib/msun:m_shared",
        "@bsd_sdk//toolchain:execution-runtime/lib/libc.so.7",
        "@bsd_sdk//toolchain:execution-runtime/lib/libsys.so.7"],
    visibility = ["//visibility:public"])
# The output is a required link input, not an opt-in test over live sources.
load(":ledger_test.bzl", "dq_ledger_test")
dq_ledger_test(name = "resolve_ledger_test", check = ":resolve_ledger_check",
    visibility = ["//visibility:public"])

# Public qualification metadata; source bytes remain declared action inputs.
filegroup(name = "resolve_ledger_inventory",
    srcs = ["@kernel_audit_src//:inventory.json", "@kernel_audit_src//:source.list"],
    visibility = ["//visibility:public"])
