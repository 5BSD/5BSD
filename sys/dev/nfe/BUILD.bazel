load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_selected_objects")

amd64_generic_module_objects(name = "ethernet_module", srcs = ["if_nfe.c"],
    deps = ["//sys/bsm:pci_ethernet_headers", "//sys/contrib/ck:pci_ethernet_headers", "//sys/dev/mii:pci_ethernet_headers", "//sys/dev/nfe:pci_ethernet_headers", "//sys/dev/pci:pci_ethernet_headers", "//sys/net:pci_ethernet_headers", "//sys/vm:pci_ethernet_headers", "//sys/contrib/ck:kernel_headers", "//sys/amd64/conf:generic_opt_device_polling_header", "//sys/amd64/conf:generic_opt_platform_header", "//sys/kern:device_if_headers", "//sys/kern:bus_if_headers", "//sys/dev/pci:pci_if_headers", "//sys/dev/mii:miibus_if_headers"])
