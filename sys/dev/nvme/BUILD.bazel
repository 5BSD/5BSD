load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "headers", hdrs = glob(["*.h"]), strip_include_prefix = ".", include_prefix = "dev/nvme", visibility = ["//visibility:public"])
exports_files(["nvme_util.c"], visibility = ["//sys/cam:__pkg__", "//lib/libcam:__pkg__", "//sbin/camcontrol:__pkg__", "//sbin/nvmecontrol:__pkg__"])

load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
