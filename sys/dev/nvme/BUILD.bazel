load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "headers", hdrs = glob(["*.h"]), strip_include_prefix = ".", include_prefix = "dev/nvme", visibility = ["//visibility:public"])
exports_files(["nvme_util.c"], visibility = ["//lib/libcam:__pkg__", "//sbin/camcontrol:__pkg__", "//sbin/nvmecontrol:__pkg__"])

load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = glob(["*_if.m"]))

# Explicit source-header closure for the amd64 bhyve engine.
cc_library(name = "bhyve_engine_headers", hdrs = ['nvme.h'], strip_include_prefix = "/sys", visibility = ["//usr.sbin/bhyve:__pkg__"])
