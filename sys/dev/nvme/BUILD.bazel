# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "headers", hdrs = glob(["*.h"]), strip_include_prefix = ".", include_prefix = "dev/nvme", visibility = ["//visibility:public"])
exports_files(["nvme_util.c"], visibility = ["//sys/cam:__pkg__", "//lib/libcam:__pkg__", "//sbin/camcontrol:__pkg__", "//sbin/nvmecontrol:__pkg__"])

load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = glob(["*_if.m"]))

# Explicit source-header closure for the amd64 bhyve engine.
cc_library(name = "bhyve_engine_headers", hdrs = ['nvme.h'], strip_include_prefix = "/sys", visibility = ["//usr.sbin/bhyve:__pkg__"])

# Physical source closure used by the native storage module candidates.
cc_library(name = "storage_module_headers", hdrs = ["nvme.h", "nvme_linux.h", "nvme_private.h"],
    visibility = ["//sys/cam:__pkg__", "//sys/dev/nvme:__pkg__", "//sys/dev/nvd:__pkg__", "//sys/dev/ahci:__pkg__"])

filegroup(name = "nvme_if_header_file", srcs = [":nvme_if"], output_group = "header")
cc_library(name = "nvme_if_headers", hdrs = [":nvme_if_header_file"],
    strip_include_prefix = "nvme_if.generated", visibility = ["//sys/dev/nvd:__pkg__"])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")

_MODULE_DEPS = ["//sys/bsm:storage_module_headers", "//sys/cam:storage_module_headers", "//sys/dev/iommu:storage_module_headers", "//sys/dev/led:storage_module_headers", "//sys/dev/mmc:storage_module_headers", "//sys/dev/nvme:storage_module_headers", "//sys/dev/pci:storage_module_headers", "//sys/geom:storage_module_headers", "//sys/net:storage_module_headers", "//sys/netinet:storage_module_headers", "//sys/netinet6:storage_module_headers", "//sys/vm:storage_module_headers", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/pci:pci_if_headers", "//sys/contrib/ck:kernel_headers", "//sys/dev/nvme:nvme_if_headers"]
_MODULE_SOURCES = ["nvme.c", "nvme_ahci.c", "nvme_ctrlr.c", "nvme_ctrlr_cmd.c", "nvme_ns.c", "nvme_ns_cmd.c", "nvme_pci.c", "nvme_qpair.c", "nvme_sim.c", "nvme_sysctl.c", "nvme_test.c"]
amd64_generic_module_objects(srcs = _MODULE_SOURCES,
    deps = _MODULE_DEPS + ["//sys/amd64/conf:generic_opt_cam_header", "//sys/amd64/conf:generic_opt_nvme_header"])
[cross_generic_module_objects(arch = arch, srcs = _MODULE_SOURCES,
    deps = _MODULE_DEPS + ["//sys/" + arch + "/conf:generic_opt_" + option + "_header" for option in ["cam", "nvme"]])
 for arch in ["arm64", "riscv"]]

load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_selected_objects")
# Preserve SRCS link order, including ARM64's appended generic AHCI driver.
[bsd_component_selected_objects(name = prefix + "ordered_module_objects",
    group = ":" + prefix + "generic_module_ctf",
    object_names = [source[:-2] + ".o" for source in _MODULE_SOURCES],
    visibility = ["//sys/modules/nvme:__pkg__"])
 for prefix in ["", "arm64_", "riscv_"]]

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

# Native ISCI built-in physical prerequisites, with identical closures shared.
bsd_source_headers(name = "isci_kernel_isci_headers", hdrs = ["nvme.h"],
    visibility = ["//sys/dev/isci:__pkg__"])

# Physical storage HBA prerequisites; identical contexts share providers.
bsd_source_headers(name = "storage_hba_kernel_ocs_gendump_headers", hdrs = ["nvme.h"],
    visibility = ["//sys/dev/ocs_fc:__pkg__", "//sys/dev/smartpqi:__pkg__"])

# Physical storage core prerequisites; identical contexts share providers.
bsd_source_headers(name = "storage_core_kernel_cam_headers", hdrs = ["nvme.h"],
    visibility = ["//sys/dev/ufshci:__pkg__", "//sys/geom/label:__pkg__", "//sys/dev/nvme:__pkg__", "//sys/geom:__pkg__", "//sys/cam:__pkg__"])
bsd_source_headers(name = "storage_core_kernel_nvme_headers", hdrs = ["nvme.h", "nvme_private.h"],
    visibility = ["//sys/dev/ufshci:__pkg__", "//sys/geom/label:__pkg__", "//sys/dev/nvme:__pkg__", "//sys/geom:__pkg__", "//sys/cam:__pkg__"])
bsd_source_headers(name = "storage_core_kernel_nvme_ctrlr_headers", hdrs = ["nvme.h", "nvme_linux.h", "nvme_private.h"],
    visibility = ["//sys/dev/ufshci:__pkg__", "//sys/geom/label:__pkg__", "//sys/dev/nvme:__pkg__", "//sys/geom:__pkg__", "//sys/cam:__pkg__"])

filegroup(name = "storage_core_nvme_if_header_file", srcs = [":nvme_if"], output_group = "header")
cc_library(name = "storage_core_nvme_if_headers", hdrs = [":storage_core_nvme_if_header_file"],
    strip_include_prefix = "nvme_if.generated", visibility = ["//sys/dev/ufshci:__pkg__", "//sys/geom/label:__pkg__", "//sys/dev/nvme:__pkg__", "//sys/geom:__pkg__", "//sys/cam:__pkg__"])

# Native amd64 GENERIC storage core built-ins, using maintained per-source warnings.
