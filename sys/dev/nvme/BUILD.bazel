    deps = _MODULE_DEPS + ["//sys/amd64/conf:generic_opt_cam_header", "//sys/amd64/conf:generic_opt_nvme_header"])
[cross_generic_module_objects(arch = arch, srcs = _MODULE_SOURCES,
    deps = _MODULE_DEPS + ["//sys/" + arch + "/conf:generic_opt_" + option + "_header" for option in ["cam", "nvme"]])
 for arch in ["arm64", "riscv"]]

load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_selected_objects")
# Preserve SRCS link order, including ARM64's appended generic AHCI driver.
[bsd_component_selected_objects(name = prefix + "ordered_module_objects",
    group = ":" + prefix + "generic_module_ctf",
    object_names = [source[:-2] + ".o" for source in _MODULE_SOURCES],
    visibility = ["//sys/modules/nvme:__pkg__"])
 for prefix in ["", "arm64_", "riscv_"]]

