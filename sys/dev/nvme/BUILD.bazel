    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_storage_core_nvme_ns_cmd", srcs = ["nvme_ns_cmd.c"],
    deps = ["//sys/dev/nvme:storage_core_kernel_nvme_headers", "//sys/net:storage_core_kernel_cam_headers", "//sys/netinet:storage_core_kernel_cam_headers", "//sys/netinet6:storage_core_kernel_cam_headers", "//sys/vm:storage_core_kernel_cam_compat_headers", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_storage_core_nvme_pci", srcs = ["nvme_pci.c"],
    deps = ["//sys/dev/nvme:storage_core_kernel_nvme_headers", "//sys/dev/pci:storage_core_kernel_nvme_pci_headers", "//sys/net:storage_core_kernel_cam_headers", "//sys/netinet:storage_core_kernel_cam_headers", "//sys/netinet6:storage_core_kernel_cam_headers", "//sys/vm:storage_core_kernel_nvme_pci_headers", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/nvme:storage_core_nvme_if_headers", "//sys/dev/pci:pci_if_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
