load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

# Physical prerequisites for native peripheral device built-ins.
bsd_source_headers(name = "peripheral_devices_kernel_vkbd_headers", hdrs = ["vkbd_var.h"],
    visibility = ["//sys/dev/amdsmn:__pkg__", "//sys/dev/amdtemp:__pkg__", "//sys/dev/backlight:__pkg__", "//sys/dev/coretemp:__pkg__", "//sys/dev/cpuctl:__pkg__", "//sys/dev/cpufreq:__pkg__", "//sys/dev/dttransport:__pkg__", "//sys/dev/efidev:__pkg__", "//sys/dev/fb:__pkg__", "//sys/dev/ichsmb:__pkg__", "//sys/dev/iicbus:__pkg__", "//sys/dev/intpm:__pkg__", "//sys/dev/io:__pkg__", "//sys/dev/iommu:__pkg__", "//sys/dev/iwn:__pkg__", "//sys/dev/kbdmux:__pkg__", "//sys/dev/kvm_clock:__pkg__", "//sys/dev/led:__pkg__", "//sys/dev/md:__pkg__", "//sys/dev/mdio:__pkg__", "//sys/dev/mem:__pkg__", "//sys/dev/mlxfw:__pkg__", "//sys/dev/mmc:__pkg__", "//sys/dev/null:__pkg__", "//sys/dev/pci:__pkg__", "//sys/dev/puc:__pkg__", "//sys/dev/sdhci:__pkg__", "//sys/dev/smbios:__pkg__", "//sys/dev/smbus:__pkg__", "//sys/dev/tcp_log:__pkg__", "//sys/dev/tpm:__pkg__", "//sys/dev/uart:__pkg__", "//sys/dev/veriexec:__pkg__", "//sys/dev/video:__pkg__", "//sys/dev/vkbd:__pkg__", "//sys/dev/vmd:__pkg__", "//sys/dev/vmgenc:__pkg__", "//sys/dev/vmware:__pkg__", "//sys/dev/watchdog:__pkg__"])

load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")
load("//tools/build/bazel:kernel_common.bzl", "KERNEL_BUILTIN_WARNING_FLAGS", "KERNEL_COMMON_WARNING_FLAGS")

# Native amd64 GENERIC peripheral device built-ins.
amd64_generic_kernel_objects(name = "generic_peripheral_devices_vkbd", srcs = ["vkbd.c"],
    deps = ["//sys/dev/kbd:peripheral_devices_kernel_kbdmux_headers", "//sys/dev/vkbd:peripheral_devices_kernel_vkbd_headers", "//sys/amd64/conf:peripheral_devices_kernel_opt_kbd_header"], early_deps = [],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS, copts = [])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")

load("//tools/build/bazel:kernel_amd64.bzl", "AMD64_KERNEL_WARNING_FLAGS")

amd64_generic_module_objects(name = "vkbd_vkbd_module", srcs = ["vkbd.c"],
    deps = ["//sys/dev/kbd:device_io_kernel_hkbd_headers", "//sys/dev/vkbd:peripheral_devices_kernel_vkbd_headers", "//sys/amd64/conf:core_kernel_opt_kbd_header"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = [], header_overrides = [], preinclude_headers = [], textual_hdrs = [])

load("//tools/build/bazel:bsd_public_headers.bzl", "public_header_installation")

# Public installed ABI headers follow include/Makefile source groups.
public_header_installation(name = "public_flat_dev_vkbd_install", directory = "dev/vkbd",
    files = {header: header.split("/")[-1] for header in glob(["*.h"], allow_empty = False)}, enabled = "//tools/build/bazel/config:includes_enabled")
