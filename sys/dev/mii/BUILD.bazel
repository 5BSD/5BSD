load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = glob(["*_if.m"]))

load("@rules_cc//cc:defs.bzl", "cc_library")

# Explicit source-header closure for the amd64 bhyve engine.
cc_library(name = "bhyve_engine_headers", hdrs = ['mii.h'], strip_include_prefix = "/sys", visibility = ["//usr.sbin/bhyve:__pkg__"])

cc_library(name = "bhyve_mii_headers", hdrs = ['mii.h'], strip_include_prefix = '/sys/dev/mii', visibility = ["//usr.sbin/bhyve:__pkg__"])


load("//tools/build/bazel:bsd_miidevs.bzl", "bsd_miidevs_header")
bsd_miidevs_header(name = "device_ids", visibility = ["//visibility:public"])
cc_library(name = "device_id_headers", hdrs = [":device_ids"],
    strip_include_prefix = "device_ids.generated", visibility = ["//visibility:public"])
filegroup(name = "miibus_if_header_file", srcs = [":miibus_if"], output_group = "header")
cc_library(name = "miibus_if_headers", hdrs = [":miibus_if_header_file"],
    strip_include_prefix = "miibus_if.generated", visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

# Physical source prerequisites from independent Ethernet module builds.
bsd_source_headers(name = "pci_ethernet_headers", hdrs = ["brgphyreg.h", "mii.h", "miivar.h"], visibility = ["//sys/dev/alc:__pkg__", "//sys/dev/ale:__pkg__", "//sys/dev/aq:__pkg__", "//sys/dev/bce:__pkg__", "//sys/dev/bge:__pkg__", "//sys/dev/et:__pkg__", "//sys/dev/jme:__pkg__", "//sys/dev/msk:__pkg__", "//sys/dev/nfe:__pkg__", "//sys/dev/re:__pkg__", "//sys/dev/rge:__pkg__", "//sys/dev/sge:__pkg__", "//sys/dev/vte:__pkg__"])

# Physical prerequisites consumed by independent MII-family module builds.
bsd_source_headers(name = "mii_family_headers", hdrs = ["acphyreg.h", "amphyreg.h", "atphyreg.h", "bmtphyreg.h", "brgphyreg.h", "ciphyreg.h", "e1000phyreg.h", "icsphyreg.h", "ip1000phyreg.h", "jmphyreg.h", "lxtphyreg.h", "mii.h", "mii_bitbang.h", "mii_fdt.h", "miivar.h", "nsgphyreg.h", "nsphyreg.h", "nsphyterreg.h", "qsphyreg.h", "rdcphyreg.h", "rgephyreg.h", "tdkphyreg.h", "truephyreg.h", "xmphyreg.h"], visibility = ["//sys/dev/etherswitch:__pkg__", "//sys/dev/mii:__pkg__"])

