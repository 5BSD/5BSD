load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(name = 'kernel_headers', hdrs = ['dttransport.h'],
    strip_include_prefix = "/sys",
    deps = [],
    visibility = ['//sys/dev/virtio/dtrace:__pkg__'])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")
bsd_source_headers(name = "tracing_module_headers", hdrs = ["dttransport.h"],
    includes = [], visibility = ["//sys/dev/dttransport:__pkg__", "//sys/cddl/dev/hypertrace:__pkg__", "//sys/security/audit:__pkg__", "//sys/cddl/dev/dtmalloc:__pkg__", "//sys/fs/nfsclient:__pkg__", "//sys/cddl/dev/profile:__pkg__", "//sys/cddl/dev:__pkg__", "//sys/cddl/dev/sdt:__pkg__"])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")

amd64_generic_module_objects(name = "dttransport_module", srcs = ["dttransport.c"], deps = [":tracing_module_headers", "//sys/vm:tracing_module_headers", "//sys/contrib/ck:kernel_headers", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers"])
[cross_generic_module_objects(arch = arch, name = "dttransport_module", srcs = ["dttransport.c"],
    deps = [":tracing_module_headers", "//sys/vm:tracing_module_headers", "//sys/contrib/ck:kernel_headers", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers"]) for arch in ["arm64", "riscv"]]

# Physical prerequisites for native virtualization built-ins.
bsd_source_headers(name = "virtualization_kernel_virtio_dtrace_headers", hdrs = ["dttransport.h"],
    visibility = ["//sys/dev/hyperv:__pkg__", "//sys/dev/hyperv/vmbus:__pkg__", "//sys/dev/virtio:__pkg__", "//sys/dev/virtio/balloon:__pkg__", "//sys/dev/virtio/block:__pkg__", "//sys/dev/virtio/dtrace:__pkg__", "//sys/dev/virtio/network:__pkg__", "//sys/dev/virtio/pci:__pkg__", "//sys/dev/virtio/scsi:__pkg__", "//sys/dev/virtio/vsock:__pkg__", "//sys/dev/xen:__pkg__"])

# Physical prerequisites for native peripheral device built-ins.
bsd_source_headers(name = "peripheral_devices_kernel_dttransport_headers", hdrs = ["dttransport.h"],
    visibility = ["//sys/dev/amdsmn:__pkg__", "//sys/dev/amdtemp:__pkg__", "//sys/dev/backlight:__pkg__", "//sys/dev/coretemp:__pkg__", "//sys/dev/cpuctl:__pkg__", "//sys/dev/cpufreq:__pkg__", "//sys/dev/dttransport:__pkg__", "//sys/dev/efidev:__pkg__", "//sys/dev/fb:__pkg__", "//sys/dev/ichsmb:__pkg__", "//sys/dev/iicbus:__pkg__", "//sys/dev/intpm:__pkg__", "//sys/dev/io:__pkg__", "//sys/dev/iommu:__pkg__", "//sys/dev/iwn:__pkg__", "//sys/dev/kbdmux:__pkg__", "//sys/dev/kvm_clock:__pkg__", "//sys/dev/led:__pkg__", "//sys/dev/md:__pkg__", "//sys/dev/mdio:__pkg__", "//sys/dev/mem:__pkg__", "//sys/dev/mlxfw:__pkg__", "//sys/dev/mmc:__pkg__", "//sys/dev/null:__pkg__", "//sys/dev/pci:__pkg__", "//sys/dev/puc:__pkg__", "//sys/dev/sdhci:__pkg__", "//sys/dev/smbios:__pkg__", "//sys/dev/smbus:__pkg__", "//sys/dev/tcp_log:__pkg__", "//sys/dev/tpm:__pkg__", "//sys/dev/uart:__pkg__", "//sys/dev/veriexec:__pkg__", "//sys/dev/video:__pkg__", "//sys/dev/vkbd:__pkg__", "//sys/dev/vmd:__pkg__", "//sys/dev/vmgenc:__pkg__", "//sys/dev/vmware:__pkg__", "//sys/dev/watchdog:__pkg__"])

load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")
load("//tools/build/bazel:kernel_common.bzl", "KERNEL_BUILTIN_WARNING_FLAGS", "KERNEL_COMMON_WARNING_FLAGS")

# Native amd64 GENERIC peripheral device built-ins.
amd64_generic_kernel_objects(name = "generic_peripheral_devices_dttransport", srcs = ["dttransport.c"],
    deps = ["//sys/dev/dttransport:peripheral_devices_kernel_dttransport_headers", "//sys/kern:peripheral_devices_kernel_bus_if_headers", "//sys/kern:peripheral_devices_kernel_device_if_headers"], early_deps = [],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS, copts = [])

# Original -I sys/dev/dttransport userland include, separate from kernel contexts.
cc_library(name = "userland_headers", hdrs = ["dttransport.h"], strip_include_prefix = ".",
    visibility = ["//usr.sbin/dtraced:__pkg__"])

# Public include installation consumes the maintained source header.
exports_files(["dttransport.h"], visibility = ["//include:__pkg__"])
