load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = glob(["*_if.m"]))

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

# Physical prerequisites consumed by independent MII-family module builds.
bsd_source_headers(name = "mii_family_headers", hdrs = ["mdio.h"], visibility = ["//sys/dev/mdio:__pkg__"])

load("@rules_cc//cc:defs.bzl", "cc_library")
filegroup(name = "mdio_if_header_file", srcs = [":mdio_if"], output_group = "header")
cc_library(name = "mdio_if_headers", hdrs = [":mdio_if_header_file"],
    strip_include_prefix = "mdio_if.generated", visibility = ["//sys/dev/mdio:__pkg__", "//sys/dev/etherswitch:__pkg__"])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_selected_objects")

filegroup(name = "mdio_if_source", srcs = [":mdio_if"], output_group = "source")

amd64_generic_module_objects(name = "mii_module", srcs = ["mdio.c", ":mdio_if_source"],
    deps = ["//sys/dev/mdio:mii_family_headers", "//sys/contrib/ck:kernel_headers", "//sys/dev/mdio:mdio_if_headers", "//sys/kern:device_if_headers", "//sys/kern:bus_if_headers"],
    copts = ["-fmacro-prefix-map=$(execpath :mdio_if_source)=mdio_if.c", "-fdebug-prefix-map=$(execpath :mdio_if_source)=mdio_if.c"])
bsd_component_selected_objects(name = "ordered_module_objects", group = ":mii_module_ctf",
    object_names = ["mdio.o", "mdio_if.o"], visibility = ["//sys/modules/mdio:__pkg__"])

cross_generic_module_objects(arch = "arm64", name = "mii_module", srcs = ["mdio.c", ":mdio_if_source"],
    deps = ["//sys/dev/mdio:mii_family_headers", "//sys/contrib/ck:kernel_headers", "//sys/dev/mdio:mdio_if_headers", "//sys/kern:device_if_headers", "//sys/kern:bus_if_headers"],
    copts = ["-fmacro-prefix-map=$(execpath :mdio_if_source)=mdio_if.c", "-fdebug-prefix-map=$(execpath :mdio_if_source)=mdio_if.c"])
bsd_component_selected_objects(name = "arm64_ordered_module_objects", group = ":arm64_mii_module_ctf",
    object_names = ["mdio.o", "mdio_if.o"], visibility = ["//sys/modules/mdio:__pkg__"])

cross_generic_module_objects(arch = "riscv", name = "mii_module", srcs = ["mdio.c", ":mdio_if_source"],
    deps = ["//sys/dev/mdio:mii_family_headers", "//sys/contrib/ck:kernel_headers", "//sys/dev/mdio:mdio_if_headers", "//sys/kern:device_if_headers", "//sys/kern:bus_if_headers"],
    copts = ["-fmacro-prefix-map=$(execpath :mdio_if_source)=mdio_if.c", "-fdebug-prefix-map=$(execpath :mdio_if_source)=mdio_if.c"])
bsd_component_selected_objects(name = "riscv_ordered_module_objects", group = ":riscv_mii_module_ctf",
    object_names = ["mdio.o", "mdio_if.o"], visibility = ["//sys/modules/mdio:__pkg__"])

# Physical native Intel NIC built-in prerequisites.
bsd_source_headers(name = "intel_nic_kernel_if_ix_headers", hdrs = ["mdio.h"],
    visibility = ["//sys/dev/e1000:__pkg__", "//sys/dev/ixgbe:__pkg__", "//sys/dev/ice:__pkg__"])

filegroup(name = "intel_nic_mdio_if_header_file", srcs = [":mdio_if"], output_group = "header")
cc_library(name = "intel_nic_mdio_if_headers", hdrs = [":intel_nic_mdio_if_header_file"],
    strip_include_prefix = "mdio_if.generated", visibility = ["//sys/dev/e1000:__pkg__", "//sys/dev/ixgbe:__pkg__", "//sys/dev/ice:__pkg__"])
