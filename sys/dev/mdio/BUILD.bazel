    object_names = ["mdio.o", "mdio_if.o"], visibility = ["//sys/modules/mdio:__pkg__"])

cross_generic_module_objects(arch = "arm64", name = "mii_module", srcs = ["mdio.c", ":mdio_if_source"],
    deps = ["//sys/dev/mdio:mii_family_headers", "//sys/contrib/ck:kernel_headers", "//sys/dev/mdio:mdio_if_headers", "//sys/kern:device_if_headers", "//sys/kern:bus_if_headers"],
    copts = ["-fmacro-prefix-map=$(execpath :mdio_if_source)=mdio_if.c", "-fdebug-prefix-map=$(execpath :mdio_if_source)=mdio_if.c"])
bsd_component_selected_objects(name = "arm64_ordered_module_objects", group = ":arm64_mii_module_ctf",
    object_names = ["mdio.o", "mdio_if.o"], visibility = ["//sys/modules/mdio:__pkg__"])

cross_generic_module_objects(arch = "riscv", name = "mii_module", srcs = ["mdio.c", ":mdio_if_source"],
    deps = ["//sys/dev/mdio:mii_family_headers", "//sys/contrib/ck:kernel_headers", "//sys/dev/mdio:mdio_if_headers", "//sys/kern:device_if_headers", "//sys/kern:bus_if_headers"],
