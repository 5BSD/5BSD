load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = glob(["*_if.m"]))

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

# Physical prerequisites consumed by independent MII-family module builds.
bsd_source_headers(name = "mii_family_headers", hdrs = ["mdio.h"], visibility = ["//sys/dev/mdio:__pkg__"])

load("@rules_cc//cc:defs.bzl", "cc_library")
filegroup(name = "mdio_if_header_file", srcs = [":mdio_if"], output_group = "header")
cc_library(name = "mdio_if_headers", hdrs = [":mdio_if_header_file"],
    strip_include_prefix = "mdio_if.generated", visibility = ["//sys/dev/mdio:__pkg__", "//sys/dev/etherswitch:__pkg__"])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
