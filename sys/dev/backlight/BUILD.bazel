load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = glob(["*_if.m"]))

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
filegroup(name = "backlight_if_header_file", srcs = [":backlight_if"], output_group = "header")
filegroup(name = "backlight_if_source", srcs = [":backlight_if"], output_group = "source")
cc_library(name = "kernel_headers", hdrs = ["backlight.h"], strip_include_prefix = "/sys")
cc_library(name = "interface_headers", hdrs = [":backlight_if_header_file"],
    strip_include_prefix = "backlight_if.generated", visibility = ["//sys/dev/acpi_support:__pkg__"])

amd64_generic_module_objects(name = "backlight_driver", srcs = ["backlight.c"],
    deps = [":kernel_headers", ":interface_headers", "//sys/amd64/conf:generic_opt_platform_header",
        "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers"])
amd64_generic_module_objects(name = "backlight_interface", srcs = [":backlight_if_source"],
    deps = [":kernel_headers", ":interface_headers", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers"],
    # Make compiles this generated source from the module object directory.
    copts = ["-fmacro-prefix-map=$(execpath :backlight_if_source)=backlight_if.c",
        "-fdebug-prefix-map=$(execpath :backlight_if_source)=backlight_if.c"])

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")
[cross_generic_module_objects(arch = arch, name = "backlight_driver", srcs = ["backlight.c"],
    deps = [":kernel_headers", ":interface_headers", "//sys/" + arch + "/conf:generic_opt_platform_header",
        "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers"])
 for arch in ["arm64", "riscv"]]
[cross_generic_module_objects(arch = arch, name = "backlight_interface", srcs = [":backlight_if_source"],
    deps = [":kernel_headers", ":interface_headers", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers"],
    copts = ["-fmacro-prefix-map=$(execpath :backlight_if_source)=backlight_if.c",
        "-fdebug-prefix-map=$(execpath :backlight_if_source)=backlight_if.c"])
 for arch in ["arm64", "riscv"]]

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

bsd_source_headers(name = "acpi_support_headers", hdrs = ["backlight.h"], visibility = ["//sys/dev/acpi_support:__pkg__", "//sys/dev/acpica:__pkg__"])

# Physical prerequisites for native LinuxKPI built-ins.
bsd_source_headers(name = "linuxkpi_kernel_linux_pci_headers", hdrs = ["backlight.h"],
    visibility = ["//sys/compat/linuxkpi/common/src:__pkg__"])

filegroup(name = "linuxkpi_backlight_if_header_file", srcs = [":backlight_if"], output_group = "header")
cc_library(name = "linuxkpi_backlight_if_headers", hdrs = [":linuxkpi_backlight_if_header_file"],
    strip_include_prefix = "backlight_if.generated", visibility = ["//sys/compat/linuxkpi/common/src:__pkg__"])

# Physical prerequisites for native peripheral device built-ins.
bsd_source_headers(name = "peripheral_devices_kernel_backlight_headers", hdrs = ["backlight.h"],
    visibility = ["//sys/dev/amdsmn:__pkg__", "//sys/dev/amdtemp:__pkg__", "//sys/dev/backlight:__pkg__", "//sys/dev/coretemp:__pkg__", "//sys/dev/cpuctl:__pkg__", "//sys/dev/cpufreq:__pkg__", "//sys/dev/dttransport:__pkg__", "//sys/dev/efidev:__pkg__", "//sys/dev/fb:__pkg__", "//sys/dev/ichsmb:__pkg__", "//sys/dev/iicbus:__pkg__", "//sys/dev/intpm:__pkg__", "//sys/dev/io:__pkg__", "//sys/dev/iommu:__pkg__", "//sys/dev/iwn:__pkg__", "//sys/dev/kbdmux:__pkg__", "//sys/dev/kvm_clock:__pkg__", "//sys/dev/led:__pkg__", "//sys/dev/md:__pkg__", "//sys/dev/mdio:__pkg__", "//sys/dev/mem:__pkg__", "//sys/dev/mlxfw:__pkg__", "//sys/dev/mmc:__pkg__", "//sys/dev/null:__pkg__", "//sys/dev/pci:__pkg__", "//sys/dev/puc:__pkg__", "//sys/dev/sdhci:__pkg__", "//sys/dev/smbios:__pkg__", "//sys/dev/smbus:__pkg__", "//sys/dev/tcp_log:__pkg__", "//sys/dev/tpm:__pkg__", "//sys/dev/uart:__pkg__", "//sys/dev/veriexec:__pkg__", "//sys/dev/video:__pkg__", "//sys/dev/vkbd:__pkg__", "//sys/dev/vmd:__pkg__", "//sys/dev/vmgenc:__pkg__", "//sys/dev/vmware:__pkg__", "//sys/dev/watchdog:__pkg__"])

filegroup(name = "peripheral_devices_kernel_backlight_if_file", srcs = [":backlight_if"], output_group = "header")
cc_library(name = "peripheral_devices_kernel_backlight_if_headers", hdrs = [":peripheral_devices_kernel_backlight_if_file"], strip_include_prefix = "backlight_if.generated", visibility = ["//sys/dev/amdsmn:__pkg__", "//sys/dev/amdtemp:__pkg__", "//sys/dev/backlight:__pkg__", "//sys/dev/coretemp:__pkg__", "//sys/dev/cpuctl:__pkg__", "//sys/dev/cpufreq:__pkg__", "//sys/dev/dttransport:__pkg__", "//sys/dev/efidev:__pkg__", "//sys/dev/fb:__pkg__", "//sys/dev/ichsmb:__pkg__", "//sys/dev/iicbus:__pkg__", "//sys/dev/intpm:__pkg__", "//sys/dev/io:__pkg__", "//sys/dev/iommu:__pkg__", "//sys/dev/iwn:__pkg__", "//sys/dev/kbdmux:__pkg__", "//sys/dev/kvm_clock:__pkg__", "//sys/dev/led:__pkg__", "//sys/dev/md:__pkg__", "//sys/dev/mdio:__pkg__", "//sys/dev/mem:__pkg__", "//sys/dev/mlxfw:__pkg__", "//sys/dev/mmc:__pkg__", "//sys/dev/null:__pkg__", "//sys/dev/pci:__pkg__", "//sys/dev/puc:__pkg__", "//sys/dev/sdhci:__pkg__", "//sys/dev/smbios:__pkg__", "//sys/dev/smbus:__pkg__", "//sys/dev/tcp_log:__pkg__", "//sys/dev/tpm:__pkg__", "//sys/dev/uart:__pkg__", "//sys/dev/veriexec:__pkg__", "//sys/dev/video:__pkg__", "//sys/dev/vkbd:__pkg__", "//sys/dev/vmd:__pkg__", "//sys/dev/vmgenc:__pkg__", "//sys/dev/vmware:__pkg__", "//sys/dev/watchdog:__pkg__"])

load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")
load("//tools/build/bazel:kernel_common.bzl", "KERNEL_BUILTIN_WARNING_FLAGS", "KERNEL_COMMON_WARNING_FLAGS")

# Native amd64 GENERIC peripheral device built-ins.
amd64_generic_kernel_objects(name = "generic_peripheral_devices_backlight", srcs = ["backlight.c"],
    deps = ["//sys/dev/backlight:peripheral_devices_kernel_backlight_headers", "//sys/dev/backlight:peripheral_devices_kernel_backlight_if_headers", "//sys/kern:peripheral_devices_kernel_bus_if_headers", "//sys/kern:peripheral_devices_kernel_device_if_headers"], early_deps = [],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS, copts = [])
