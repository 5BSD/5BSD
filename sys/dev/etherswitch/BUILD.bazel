load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "headers", hdrs = ["etherswitch.h"], strip_include_prefix = "/sys",
    visibility = ["//sbin/etherswitchcfg:__pkg__"])

load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = glob(["*_if.m"]))

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

# Physical prerequisites consumed by independent MII-family module builds.
bsd_source_headers(name = "mii_family_headers", hdrs = ["miiproxy.h"], visibility = ["//sys/dev/etherswitch:__pkg__"])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_selected_objects")

amd64_generic_module_objects(name = "mii_module", srcs = ["miiproxy.c"],
    deps = ["//sys/bsm:mii_family_headers", "//sys/contrib/ck:mii_family_headers", "//sys/dev/etherswitch:mii_family_headers", "//sys/dev/mii:mii_family_headers", "//sys/net:mii_family_headers", "//sys/vm:mii_family_headers", "//sys/contrib/ck:kernel_headers", "//sys/amd64/conf:generic_opt_platform_header", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/mdio:mdio_if_headers", "//sys/dev/mii:miibus_if_headers"],
    copts = [])
bsd_component_selected_objects(name = "ordered_module_objects", group = ":mii_module_ctf",
    object_names = ["miiproxy.o"], visibility = ["//sys/modules/miiproxy:__pkg__"])

cross_generic_module_objects(arch = "arm64", name = "mii_module", srcs = ["miiproxy.c"],
    deps = ["//sys/bsm:mii_family_headers", "//sys/contrib/ck:mii_family_headers", "//sys/dev/etherswitch:mii_family_headers", "//sys/dev/mii:mii_family_headers", "//sys/dev/ofw:mii_family_headers", "//sys/net:mii_family_headers", "//sys/vm:mii_family_headers", "//sys/contrib/ck:kernel_headers", "//sys/arm64/conf:generic_opt_platform_header", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/mdio:mdio_if_headers", "//sys/dev/mii:miibus_if_headers", "//sys/dev/ofw:ofw_bus_if_headers"],
    copts = [])
bsd_component_selected_objects(name = "arm64_ordered_module_objects", group = ":arm64_mii_module_ctf",
    object_names = ["miiproxy.o"], visibility = ["//sys/modules/miiproxy:__pkg__"])

cross_generic_module_objects(arch = "riscv", name = "mii_module", srcs = ["miiproxy.c"],
    deps = ["//sys/bsm:mii_family_headers", "//sys/contrib/ck:mii_family_headers", "//sys/dev/etherswitch:mii_family_headers", "//sys/dev/mii:mii_family_headers", "//sys/dev/ofw:mii_family_headers", "//sys/net:mii_family_headers", "//sys/vm:mii_family_headers", "//sys/contrib/ck:kernel_headers", "//sys/riscv/conf:generic_opt_platform_header", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/mdio:mdio_if_headers", "//sys/dev/mii:miibus_if_headers", "//sys/dev/ofw:ofw_bus_if_headers"],
    copts = [])
bsd_component_selected_objects(name = "riscv_ordered_module_objects", group = ":riscv_mii_module_ctf",
    object_names = ["miiproxy.o"], visibility = ["//sys/modules/miiproxy:__pkg__"])

# Physical prerequisites consumed by independent network-support module builds.
bsd_source_headers(name = "network_support_headers", hdrs = ["etherswitch.h"], visibility = ["//sys/dev/etherswitch:__pkg__"])

filegroup(name = "etherswitch_if_header_file", srcs = [":etherswitch_if"], output_group = "header")
cc_library(name = "etherswitch_if_headers", hdrs = [":etherswitch_if_header_file"],
    strip_include_prefix = "etherswitch_if.generated", visibility = ["//sys/dev/etherswitch:__pkg__"])

filegroup(name = "etherswitch_if_source", srcs = [":etherswitch_if"], output_group = "source")

amd64_generic_module_objects(name = "network_support_module", srcs = ["etherswitch.c", ":etherswitch_if_source"],
    deps = ["//sys/dev/etherswitch:network_support_headers", "//sys/net:network_support_headers", "//sys/contrib/ck:kernel_headers", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/mdio:mdio_if_headers", "//sys/dev/mii:miibus_if_headers", "//sys/dev/etherswitch:etherswitch_if_headers"],
    copts = ["-fmacro-prefix-map=$(execpath :etherswitch_if_source)=etherswitch_if.c", "-fdebug-prefix-map=$(execpath :etherswitch_if_source)=etherswitch_if.c"])
bsd_component_selected_objects(name = "network_ordered_module_objects", group = ":network_support_module_ctf",
    object_names = ["etherswitch.o", "etherswitch_if.o"], visibility = ["//sys/modules/etherswitch:__pkg__"])

cross_generic_module_objects(arch = "arm64", name = "network_support_module", srcs = ["etherswitch.c", ":etherswitch_if_source"],
    deps = ["//sys/dev/etherswitch:network_support_headers", "//sys/net:network_support_headers", "//sys/contrib/ck:kernel_headers", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/mdio:mdio_if_headers", "//sys/dev/mii:miibus_if_headers", "//sys/dev/etherswitch:etherswitch_if_headers"],
    copts = ["-fmacro-prefix-map=$(execpath :etherswitch_if_source)=etherswitch_if.c", "-fdebug-prefix-map=$(execpath :etherswitch_if_source)=etherswitch_if.c"])
bsd_component_selected_objects(name = "arm64_network_ordered_module_objects", group = ":arm64_network_support_module_ctf",
    object_names = ["etherswitch.o", "etherswitch_if.o"], visibility = ["//sys/modules/etherswitch:__pkg__"])

cross_generic_module_objects(arch = "riscv", name = "network_support_module", srcs = ["etherswitch.c", ":etherswitch_if_source"],
    deps = ["//sys/dev/etherswitch:network_support_headers", "//sys/net:network_support_headers", "//sys/contrib/ck:kernel_headers", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/mdio:mdio_if_headers", "//sys/dev/mii:miibus_if_headers", "//sys/dev/etherswitch:etherswitch_if_headers"],
    copts = ["-fmacro-prefix-map=$(execpath :etherswitch_if_source)=etherswitch_if.c", "-fdebug-prefix-map=$(execpath :etherswitch_if_source)=etherswitch_if.c"])
bsd_component_selected_objects(name = "riscv_network_ordered_module_objects", group = ":riscv_network_support_module_ctf",
    object_names = ["etherswitch.o", "etherswitch_if.o"], visibility = ["//sys/modules/etherswitch:__pkg__"])

bsd_source_headers(name = "network_services_module_context_0", hdrs = ["e6000sw/e6000swreg.h", "etherswitch.h"], includes = [],
    visibility = ["//sys/dev/etherswitch:__pkg__"])

load("//tools/build/bazel:kernel_amd64.bzl", "AMD64_KERNEL_WARNING_FLAGS")

amd64_generic_module_objects(name = "e6000sw_e6000sw_module", srcs = ["e6000sw/e6000sw.c"],
    deps = ["//sys/contrib/ck:core_kernel_kern_intr_headers", "//sys/net:network_services_module_context_2", "//sys/dev/etherswitch:network_services_module_context_0", "//sys/dev/mii:usb_net_uether_headers", "//sys/vm:usb_net_usie_headers", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/etherswitch:etherswitch_if_headers", "//sys/dev/mdio:mdio_if_headers", "//sys/dev/mii:miibus_if_headers", "//sys/amd64/conf:generic_opt_platform_header"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = [], header_overrides = [], preinclude_headers = [], textual_hdrs = [])
