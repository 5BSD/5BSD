load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = glob(["*_if.m"]))

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

bsd_source_headers(name = "alias_ntb_module_context_0", hdrs = ["ntb_transport.h"], includes = [],
    visibility = ["//sys/dev/ntb:__pkg__"])

bsd_source_headers(name = "alias_ntb_module_context_1", hdrs = ["ntb.h"], includes = [],
    visibility = ["//sys/dev/ntb:__pkg__"])

bsd_source_headers(name = "alias_ntb_module_context_2", hdrs = ["ntb.h", "ntb_hw/ntb_hw_amd.h"], includes = [],
    visibility = ["//sys/dev/ntb:__pkg__"])

bsd_source_headers(name = "alias_ntb_module_context_3", hdrs = ["ntb.h", "ntb_hw/ntb_hw_intel.h"], includes = [],
    visibility = ["//sys/dev/ntb:__pkg__"])

bsd_source_headers(name = "alias_ntb_module_context_4", hdrs = ["ntb.h", "ntb_transport.h"], includes = [],
    visibility = ["//sys/dev/ntb:__pkg__"])

load("@rules_cc//cc:defs.bzl", "cc_library")

filegroup(name = "ntb_if_module_header", srcs = [":ntb_if"], output_group = "header")
cc_library(name = "ntb_if_headers", hdrs = [":ntb_if_module_header"], strip_include_prefix = "ntb_if.generated", visibility = ["//sys/dev/ntb:__pkg__"])

filegroup(name = "ntb_if_module_source", srcs = [":ntb_if"], output_group = "source")

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")

load("//tools/build/bazel:kernel_amd64.bzl", "AMD64_KERNEL_WARNING_FLAGS")

amd64_generic_module_objects(name = "if_ntb_if_ntb_module", srcs = ["if_ntb/if_ntb.c"],
    deps = ["//sys/net:alias_ntb_module_context_2", "//sys/vm:usb_net_usie_headers", "//sys/contrib/ck:core_kernel_kern_intr_headers", "//sys/dev/ntb:alias_ntb_module_context_0", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = [])

amd64_generic_module_objects(name = "ntb_ntb_module", srcs = ["ntb.c"],
    deps = ["//sys/dev/ntb:alias_ntb_module_context_1", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/ntb:ntb_if_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = [])

amd64_generic_module_objects(name = "ntb_ntb_if_module", srcs = [":ntb_if_module_source"],
    deps = ["//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/ntb:ntb_if_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = ["-fmacro-prefix-map=$(execpath :ntb_if_module_source)=ntb_if.c", "-fdebug-prefix-map=$(execpath :ntb_if_module_source)=ntb_if.c"], local_defines = [])

amd64_generic_module_objects(name = "ntb_hw_amd_ntb_hw_amd_module", srcs = ["ntb_hw/ntb_hw_amd.c"],
    deps = ["//sys/vm:acpi_support_headers", "//sys/dev/pci:pci_ethernet_headers", "//sys/dev/ntb:alias_ntb_module_context_2", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/ntb:ntb_if_headers", "//sys/dev/pci:pci_if_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = [])

amd64_generic_module_objects(name = "ntb_hw_intel_ntb_hw_intel_module", srcs = ["ntb_hw/ntb_hw_intel.c"],
    deps = ["//sys/contrib/ck:core_kernel_kern_intr_headers", "//sys/vm:virtualization_kernel_balloon_headers", "//sys/dev/pci:pci_ethernet_headers", "//sys/dev/iommu:storage_controllers_kernel_ahci_pci_headers", "//sys/dev/ntb:alias_ntb_module_context_3", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/ntb:ntb_if_headers", "//sys/dev/pci:pci_if_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = [])

amd64_generic_module_objects(name = "ntb_hw_plx_ntb_hw_plx_module", srcs = ["ntb_hw/ntb_hw_plx.c"],
    deps = ["//sys/contrib/ck:core_kernel_kern_intr_headers", "//sys/vm:virtualization_kernel_balloon_headers", "//sys/dev/pci:pci_ethernet_headers", "//sys/dev/iommu:storage_controllers_kernel_ahci_pci_headers", "//sys/dev/ntb:alias_ntb_module_context_1", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/ntb:ntb_if_headers", "//sys/dev/pci:pci_if_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = [])

amd64_generic_module_objects(name = "ntb_tool_ntb_tool_module", srcs = ["test/ntb_tool.c"],
    deps = ["//sys/vm:mii_family_headers", "//sys/dev/ntb:alias_ntb_module_context_1", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/ntb:ntb_if_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = [])

amd64_generic_module_objects(name = "ntb_transport_ntb_transport_module", srcs = ["ntb_transport.c"],
    deps = ["//sys/vm:pci_ethernet_headers", "//sys/dev/ntb:alias_ntb_module_context_4", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/ntb:ntb_if_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = [])
