load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(name = 'kernel_headers', hdrs = ['evdev.h', 'input.h', 'input-event-codes.h'],
    strip_include_prefix = "/sys",
    deps = ['//sys/dev/kbd:kernel_headers', '//sys/contrib/ck:kernel_headers'],
    visibility = ['//sys/dev/virtio/input:__pkg__'])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

bsd_source_headers(name = "acpi_support_headers", hdrs = ["evdev.h", "input-event-codes.h", "input.h"], visibility = ["//sys/dev/acpi_support:__pkg__", "//sys/dev/acpica:__pkg__"])

# Only the input ABI headers used by the userland bhyve engine.
cc_library(name = "bhyve_engine_headers", hdrs = ["input-event-codes.h", "input.h"],
    strip_include_prefix = "/sys", visibility = ["//:__pkg__"])

# ACPI core built-in prerequisites.
bsd_source_headers(name = "acpica_core_kernel_acpi_button_headers", hdrs = ["evdev.h", "input-event-codes.h", "input.h"],
    visibility = ["//sys/dev/acpica:__pkg__"])
bsd_source_headers(name = "acpica_core_kernel_acpi_lid_headers", hdrs = ["evdev.h", "input-event-codes.h", "input.h"],
    visibility = ["//sys/dev/acpica:__pkg__"])

# Physical device I/O prerequisites; identical contexts share providers.
bsd_source_headers(name = "device_io_kernel_cdev_headers", hdrs = ["evdev.h", "evdev_private.h", "input-event-codes.h", "input.h"],
    visibility = ["//sys/dev/usb/controller:__pkg__", "//sys/dev/sound/pci/hda:__pkg__", "//sys/dev/sound/midi:__pkg__", "//sys/dev/sound/pcm:__pkg__", "//sys/dev/sound/usb:__pkg__", "//sys/dev/usb/net:__pkg__", "//sys/dev/atkbdc:__pkg__", "//sys/dev/evdev:__pkg__", "//sys/dev/sound:__pkg__", "//sys/dev/hid:__pkg__", "//sys/dev/kbd:__pkg__", "//sys/dev/usb:__pkg__", "//sys/dev/vt:__pkg__", "//sys/teken:__pkg__"])
bsd_source_headers(name = "device_io_kernel_uinput_headers", hdrs = ["evdev.h", "evdev_private.h", "input-event-codes.h", "input.h", "uinput.h"],
    visibility = ["//sys/dev/usb/controller:__pkg__", "//sys/dev/sound/pci/hda:__pkg__", "//sys/dev/sound/midi:__pkg__", "//sys/dev/sound/pcm:__pkg__", "//sys/dev/sound/usb:__pkg__", "//sys/dev/usb/net:__pkg__", "//sys/dev/atkbdc:__pkg__", "//sys/dev/evdev:__pkg__", "//sys/dev/sound:__pkg__", "//sys/dev/hid:__pkg__", "//sys/dev/kbd:__pkg__", "//sys/dev/usb:__pkg__", "//sys/dev/vt:__pkg__", "//sys/teken:__pkg__"])
bsd_source_headers(name = "device_io_kernel_hcons_headers", hdrs = ["evdev.h", "input-event-codes.h", "input.h"],
    visibility = ["//sys/dev/usb/controller:__pkg__", "//sys/dev/sound/pci/hda:__pkg__", "//sys/dev/sound/midi:__pkg__", "//sys/dev/sound/pcm:__pkg__", "//sys/dev/sound/usb:__pkg__", "//sys/dev/usb/net:__pkg__", "//sys/dev/atkbdc:__pkg__", "//sys/dev/evdev:__pkg__", "//sys/dev/sound:__pkg__", "//sys/dev/hid:__pkg__", "//sys/dev/kbd:__pkg__", "//sys/dev/usb:__pkg__", "//sys/dev/vt:__pkg__", "//sys/teken:__pkg__"])
bsd_source_headers(name = "device_io_kernel_hidquirk_headers", hdrs = ["input-event-codes.h", "input.h"],
    visibility = ["//sys/dev/usb/controller:__pkg__", "//sys/dev/sound/pci/hda:__pkg__", "//sys/dev/sound/midi:__pkg__", "//sys/dev/sound/pcm:__pkg__", "//sys/dev/sound/usb:__pkg__", "//sys/dev/usb/net:__pkg__", "//sys/dev/atkbdc:__pkg__", "//sys/dev/evdev:__pkg__", "//sys/dev/sound:__pkg__", "//sys/dev/hid:__pkg__", "//sys/dev/kbd:__pkg__", "//sys/dev/usb:__pkg__", "//sys/dev/vt:__pkg__", "//sys/teken:__pkg__"])
bsd_source_headers(name = "device_io_kernel_kbd_headers", hdrs = ["input-event-codes.h"],
    visibility = ["//sys/dev/usb/controller:__pkg__", "//sys/dev/sound/pci/hda:__pkg__", "//sys/dev/sound/midi:__pkg__", "//sys/dev/sound/pcm:__pkg__", "//sys/dev/sound/usb:__pkg__", "//sys/dev/usb/net:__pkg__", "//sys/dev/atkbdc:__pkg__", "//sys/dev/evdev:__pkg__", "//sys/dev/sound:__pkg__", "//sys/dev/hid:__pkg__", "//sys/dev/kbd:__pkg__", "//sys/dev/usb:__pkg__", "//sys/dev/vt:__pkg__", "//sys/teken:__pkg__"])

load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")

load("//tools/build/bazel:kernel_common.bzl", "KERNEL_BUILTIN_WARNING_FLAGS")

# Native amd64 GENERIC device I/O built-ins.
amd64_generic_kernel_objects(name = "generic_device_io_cdev", srcs = ["cdev.c"],
    deps = ["//sys/contrib/ck:device_io_kernel_cdev_headers", "//sys/dev/evdev:device_io_kernel_cdev_headers", "//sys/dev/kbd:device_io_kernel_cdev_headers", "//sys/amd64/conf:device_io_kernel_opt_evdev_header", "//sys/amd64/conf:device_io_kernel_opt_kbd_header"], warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_device_io_evdev", srcs = ["evdev.c"],
    deps = ["//sys/contrib/ck:device_io_kernel_cdev_headers", "//sys/dev/evdev:device_io_kernel_cdev_headers", "//sys/dev/kbd:device_io_kernel_cdev_headers", "//sys/amd64/conf:device_io_kernel_opt_evdev_header", "//sys/amd64/conf:device_io_kernel_opt_kbd_header"], warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_device_io_evdev_mt", srcs = ["evdev_mt.c"],
    deps = ["//sys/contrib/ck:device_io_kernel_cdev_headers", "//sys/dev/evdev:device_io_kernel_cdev_headers", "//sys/dev/kbd:device_io_kernel_cdev_headers", "//sys/amd64/conf:device_io_kernel_opt_kbd_header"], warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_device_io_evdev_utils", srcs = ["evdev_utils.c"],
    deps = ["//sys/contrib/ck:device_io_kernel_cdev_headers", "//sys/dev/evdev:device_io_kernel_cdev_headers", "//sys/dev/kbd:device_io_kernel_cdev_headers", "//sys/kern:device_io_device_if_headers", "//sys/kern:device_io_bus_if_headers", "//sys/amd64/conf:device_io_kernel_opt_kbd_header"], warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_device_io_uinput", srcs = ["uinput.c"],
    deps = ["//sys/contrib/ck:device_io_kernel_cdev_headers", "//sys/dev/evdev:device_io_kernel_uinput_headers", "//sys/dev/kbd:device_io_kernel_cdev_headers", "//sys/amd64/conf:device_io_kernel_opt_evdev_header", "//sys/amd64/conf:device_io_kernel_opt_kbd_header"], warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
