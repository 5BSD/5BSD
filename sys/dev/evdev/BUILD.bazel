load("//tools/build/bazel:kernel_common.bzl", "KERNEL_BUILTIN_WARNING_FLAGS")

# Native amd64 GENERIC device I/O built-ins.
amd64_generic_kernel_objects(name = "generic_device_io_cdev", srcs = ["cdev.c"],
    deps = ["//sys/contrib/ck:device_io_kernel_cdev_headers", "//sys/dev/evdev:device_io_kernel_cdev_headers", "//sys/dev/kbd:device_io_kernel_cdev_headers", "//sys/amd64/conf:device_io_kernel_opt_evdev_header", "//sys/amd64/conf:device_io_kernel_opt_kbd_header"], warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_device_io_evdev", srcs = ["evdev.c"],
    deps = ["//sys/contrib/ck:device_io_kernel_cdev_headers", "//sys/dev/evdev:device_io_kernel_cdev_headers", "//sys/dev/kbd:device_io_kernel_cdev_headers", "//sys/amd64/conf:device_io_kernel_opt_evdev_header", "//sys/amd64/conf:device_io_kernel_opt_kbd_header"], warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_device_io_evdev_mt", srcs = ["evdev_mt.c"],
    deps = ["//sys/contrib/ck:device_io_kernel_cdev_headers", "//sys/dev/evdev:device_io_kernel_cdev_headers", "//sys/dev/kbd:device_io_kernel_cdev_headers", "//sys/amd64/conf:device_io_kernel_opt_kbd_header"], warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_device_io_evdev_utils", srcs = ["evdev_utils.c"],
    deps = ["//sys/contrib/ck:device_io_kernel_cdev_headers", "//sys/dev/evdev:device_io_kernel_cdev_headers", "//sys/dev/kbd:device_io_kernel_cdev_headers", "//sys/kern:device_io_device_if_headers", "//sys/kern:device_io_bus_if_headers", "//sys/amd64/conf:device_io_kernel_opt_kbd_header"], warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_device_io_uinput", srcs = ["uinput.c"],
    deps = ["//sys/contrib/ck:device_io_kernel_cdev_headers", "//sys/dev/evdev:device_io_kernel_uinput_headers", "//sys/dev/kbd:device_io_kernel_cdev_headers", "//sys/amd64/conf:device_io_kernel_opt_evdev_header", "//sys/amd64/conf:device_io_kernel_opt_kbd_header"], warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)

# Physical prerequisites for native virtualization built-ins.
bsd_source_headers(name = "virtualization_kernel_hv_kbd_headers", hdrs = ["evdev.h", "input-event-codes.h", "input.h"],
    visibility = ["//sys/dev/hyperv:__pkg__", "//sys/dev/hyperv/vmbus:__pkg__", "//sys/dev/virtio:__pkg__", "//sys/dev/virtio/balloon:__pkg__", "//sys/dev/virtio/block:__pkg__", "//sys/dev/virtio/dtrace:__pkg__", "//sys/dev/virtio/network:__pkg__", "//sys/dev/virtio/pci:__pkg__", "//sys/dev/virtio/scsi:__pkg__", "//sys/dev/virtio/vsock:__pkg__", "//sys/dev/xen:__pkg__"])

