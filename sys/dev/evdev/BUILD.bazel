load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(name = 'kernel_headers', hdrs = ['evdev.h', 'input.h', 'input-event-codes.h'],
    strip_include_prefix = "/sys",
    deps = ['//sys/dev/kbd:kernel_headers', '//sys/contrib/ck:kernel_headers'],
    visibility = ['//sys/dev/virtio/input:__pkg__'])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

bsd_source_headers(name = "acpi_support_headers", hdrs = ["evdev.h", "input-event-codes.h", "input.h"], visibility = ["//sys/dev/acpi_support:__pkg__", "//sys/dev/acpica:__pkg__"])

# Only the input ABI headers used by the userland bhyve engine.
cc_library(name = "bhyve_engine_headers", hdrs = ["input-event-codes.h", "input.h"],
    strip_include_prefix = "/sys", visibility = ["//:__pkg__"])

# ACPI core built-in prerequisites.
bsd_source_headers(name = "acpica_core_kernel_acpi_button_headers", hdrs = ["evdev.h", "input-event-codes.h", "input.h"],
    visibility = ["//sys/dev/acpica:__pkg__"])
bsd_source_headers(name = "acpica_core_kernel_acpi_lid_headers", hdrs = ["evdev.h", "input-event-codes.h", "input.h"],
    visibility = ["//sys/dev/acpica:__pkg__"])
