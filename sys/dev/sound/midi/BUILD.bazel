load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = glob(["*_if.m"]))

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

# Physical device I/O prerequisites; identical contexts share providers.
bsd_source_headers(name = "device_io_kernel_midi_headers", hdrs = ["midi.h", "midiq.h"],
    visibility = ["//sys/dev/usb/controller:__pkg__", "//sys/dev/sound/pci/hda:__pkg__", "//sys/dev/sound/midi:__pkg__", "//sys/dev/sound/pcm:__pkg__", "//sys/dev/sound/usb:__pkg__", "//sys/dev/usb/net:__pkg__", "//sys/dev/atkbdc:__pkg__", "//sys/dev/evdev:__pkg__", "//sys/dev/sound:__pkg__", "//sys/dev/hid:__pkg__", "//sys/dev/kbd:__pkg__", "//sys/dev/usb:__pkg__", "//sys/dev/vt:__pkg__", "//sys/teken:__pkg__"])
bsd_source_headers(name = "device_io_kernel_mpu401_headers", hdrs = ["midi.h", "mpu401.h"],
    visibility = ["//sys/dev/usb/controller:__pkg__", "//sys/dev/sound/pci/hda:__pkg__", "//sys/dev/sound/midi:__pkg__", "//sys/dev/sound/pcm:__pkg__", "//sys/dev/sound/usb:__pkg__", "//sys/dev/usb/net:__pkg__", "//sys/dev/atkbdc:__pkg__", "//sys/dev/evdev:__pkg__", "//sys/dev/sound:__pkg__", "//sys/dev/hid:__pkg__", "//sys/dev/kbd:__pkg__", "//sys/dev/usb:__pkg__", "//sys/dev/vt:__pkg__", "//sys/teken:__pkg__"])

load("@rules_cc//cc:defs.bzl", "cc_library")

filegroup(name = "device_io_mpu_if_header_file", srcs = [":mpu_if"], output_group = "header")
cc_library(name = "device_io_mpu_if_headers", hdrs = [":device_io_mpu_if_header_file"], strip_include_prefix = "mpu_if.generated", visibility = ["//sys/dev/usb/controller:__pkg__", "//sys/dev/sound/pci/hda:__pkg__", "//sys/dev/sound/midi:__pkg__", "//sys/dev/sound/pcm:__pkg__", "//sys/dev/sound/usb:__pkg__", "//sys/dev/usb/net:__pkg__", "//sys/dev/atkbdc:__pkg__", "//sys/dev/evdev:__pkg__", "//sys/dev/sound:__pkg__", "//sys/dev/hid:__pkg__", "//sys/dev/kbd:__pkg__", "//sys/dev/usb:__pkg__", "//sys/dev/vt:__pkg__", "//sys/teken:__pkg__"])

filegroup(name = "device_io_mpufoi_if_header_file", srcs = [":mpufoi_if"], output_group = "header")
cc_library(name = "device_io_mpufoi_if_headers", hdrs = [":device_io_mpufoi_if_header_file"], strip_include_prefix = "mpufoi_if.generated", visibility = ["//sys/dev/usb/controller:__pkg__", "//sys/dev/sound/pci/hda:__pkg__", "//sys/dev/sound/midi:__pkg__", "//sys/dev/sound/pcm:__pkg__", "//sys/dev/sound/usb:__pkg__", "//sys/dev/usb/net:__pkg__", "//sys/dev/atkbdc:__pkg__", "//sys/dev/evdev:__pkg__", "//sys/dev/sound:__pkg__", "//sys/dev/hid:__pkg__", "//sys/dev/kbd:__pkg__", "//sys/dev/usb:__pkg__", "//sys/dev/vt:__pkg__", "//sys/teken:__pkg__"])

load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")

load("//tools/build/bazel:kernel_common.bzl", "KERNEL_BUILTIN_WARNING_FLAGS")

# Native amd64 GENERIC device I/O built-ins.
amd64_generic_kernel_objects(name = "generic_device_io_midi", srcs = ["midi.c"],
    deps = ["//sys/dev/sound/midi:device_io_kernel_midi_headers", "//sys/amd64/conf:device_io_kernel_opt_snd_header", "//sys/dev/sound/midi:device_io_mpu_if_headers"], warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_device_io_mpu401", srcs = ["mpu401.c"],
    deps = ["//sys/dev/sound/midi:device_io_kernel_mpu401_headers", "//sys/kern:device_io_device_if_headers", "//sys/kern:device_io_bus_if_headers", "//sys/amd64/conf:device_io_kernel_opt_snd_header", "//sys/dev/sound/midi:device_io_mpu_if_headers", "//sys/dev/sound/midi:device_io_mpufoi_if_headers"], warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
