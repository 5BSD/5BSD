load("@rules_cc//cc:defs.bzl", "cc_library")

filegroup(name = "device_io_hdac_if_header_file", srcs = [":hdac_if"], output_group = "header")
cc_library(name = "device_io_hdac_if_headers", hdrs = [":device_io_hdac_if_header_file"], strip_include_prefix = "hdac_if.generated", visibility = ["//sys/dev/usb/controller:__pkg__", "//sys/dev/sound/pci/hda:__pkg__", "//sys/dev/sound/midi:__pkg__", "//sys/dev/sound/pcm:__pkg__", "//sys/dev/sound/usb:__pkg__", "//sys/dev/usb/net:__pkg__", "//sys/dev/atkbdc:__pkg__", "//sys/dev/evdev:__pkg__", "//sys/dev/sound:__pkg__", "//sys/dev/hid:__pkg__", "//sys/dev/kbd:__pkg__", "//sys/dev/usb:__pkg__", "//sys/dev/vt:__pkg__", "//sys/teken:__pkg__"])

