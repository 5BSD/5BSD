amd64_generic_kernel_objects(name = "generic_device_io_hdacc", srcs = ["hdacc.c"],
    deps = ["//sys/dev/sound/pci/hda:device_io_kernel_hdacc_headers", "//sys/dev/sound/pcm:device_io_kernel_hdaa_headers", "//sys/vm:device_io_kernel_hdaa_headers", "//sys/amd64/conf:device_io_kernel_opt_snd_header", "//sys/kern:device_io_device_if_headers", "//sys/kern:device_io_bus_if_headers", "//sys/dev/sound/pcm:device_io_channel_if_headers", "//sys/dev/sound/pci/hda:device_io_hdac_if_headers"], warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
