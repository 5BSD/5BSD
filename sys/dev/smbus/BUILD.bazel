load("//tools/build/bazel:kernel_amd64.bzl", "AMD64_KERNEL_WARNING_FLAGS")

amd64_generic_module_objects(name = "smb_smb_module", srcs = ["smb.c"],
    deps = ["//sys/dev/smbus:i2c_module_context_3", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/smbus:smbus_if_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [])

