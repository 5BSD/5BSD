    deps = ["//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/smbus:smbus_if_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = ["-fmacro-prefix-map=$(execpath :smbus_if_module_source)=smbus_if.c", "-fdebug-prefix-map=$(execpath :smbus_if_module_source)=smbus_if.c"])

amd64_generic_module_objects(name = "smbus_smbconf_module", srcs = ["smbconf.c", "smbus.c"],
