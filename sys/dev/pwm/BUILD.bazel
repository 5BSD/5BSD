load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = glob(["*_if.m"]))

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

bsd_source_headers(name = "device_families_module_context_0", hdrs = ["pwmbus.h"], includes = [],
    visibility = ["//sys/dev/pwm:__pkg__"])

bsd_source_headers(name = "device_families_module_context_1", hdrs = ["pwmbus.h", "pwmc.h"], includes = [],
    visibility = ["//sys/dev/pwm:__pkg__"])

load("@rules_cc//cc:defs.bzl", "cc_library")

filegroup(name = "pwmbus_if_module_header", srcs = [":pwmbus_if"], output_group = "header")
cc_library(name = "pwmbus_if_headers", hdrs = [":pwmbus_if_module_header"], strip_include_prefix = "pwmbus_if.generated", visibility = ["//sys/dev/pwm:__pkg__"])

filegroup(name = "pwmbus_if_module_source", srcs = [":pwmbus_if"], output_group = "source")

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")

load("//tools/build/bazel:kernel_amd64.bzl", "AMD64_KERNEL_WARNING_FLAGS")

amd64_generic_module_objects(name = "pwmbus_pwmbus_module", srcs = ["pwmbus.c"],
    deps = ["//sys/dev/pwm:device_families_module_context_0", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/amd64/conf:generic_opt_platform_header", "//sys/dev/pwm:pwmbus_if_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = [])

amd64_generic_module_objects(name = "pwmbus_pwmbus_if_module", srcs = [":pwmbus_if_module_source"],
    deps = ["//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/pwm:pwmbus_if_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = ["-fmacro-prefix-map=$(execpath :pwmbus_if_module_source)=pwmbus_if.c", "-fdebug-prefix-map=$(execpath :pwmbus_if_module_source)=pwmbus_if.c"], local_defines = [])

amd64_generic_module_objects(name = "pwmc_pwmc_module", srcs = ["pwmc.c"],
    deps = ["//sys/dev/pwm:device_families_module_context_1", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/amd64/conf:generic_opt_platform_header", "//sys/dev/pwm:pwmbus_if_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = [])

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")

[cross_generic_module_objects(
    arch = arch,
    name = "pwmbus_pwmbus_module",
    srcs = ['pwmbus.c'],
    deps = ["//sys/dev/pwm:device_families_module_context_0", "//sys/dev/pwm:pwmbus_if_headers", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/" + arch + "/conf:generic_opt_platform_header"],
) for arch in ['arm64', 'riscv']]

# Additional physical prerequisites of the cross-target I/O-bus consumers.
bsd_source_headers(name = "cross_io_bus_pwmbus_ofw_pwm_module_headers", hdrs = ['ofw_pwm.h'], visibility = ['//sys/dev/pwm:__pkg__'])

[cross_generic_module_objects(
    arch = arch,
    name = "pwmbus_ofw_pwm_module",
    srcs = ['ofw_pwm.c'],
    deps = ["//sys/dev/ofw:mii_family_headers", "//sys/dev/ofw:ofw_bus_if_headers", "//sys/dev/pwm:cross_io_bus_pwmbus_ofw_pwm_module_headers", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/vm:core_kernel_tty_headers"],
) for arch in ['arm64', 'riscv']]

[cross_generic_module_objects(
    arch = arch,
    name = "pwmbus_ofw_pwmbus_module",
    srcs = ['ofw_pwmbus.c'],
    deps = ["//sys/contrib/libfdt:mii_family_headers", "//sys/dev/fdt:mii_family_headers", "//sys/dev/ofw:mii_family_headers", "//sys/dev/ofw:ofw_bus_if_headers", "//sys/dev/pwm:device_families_module_context_0", "//sys/dev/pwm:pwmbus_if_headers", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/net:cross_io_bus_gpiokeys_gpiokeys_module_headers", "//sys/vm:core_kernel_tty_headers"],
) for arch in ['arm64', 'riscv']]

[cross_generic_module_objects(
    arch = arch,
    name = "pwmbus_pwmbus_if_module",
    srcs = [':pwmbus_if_module_source'],
    deps = ["//sys/dev/pwm:pwmbus_if_headers", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers"],
    copts = ['-fmacro-prefix-map=$(execpath :pwmbus_if_module_source)=pwmbus_if.c', '-fdebug-prefix-map=$(execpath :pwmbus_if_module_source)=pwmbus_if.c'],
) for arch in ['arm64', 'riscv']]

[cross_generic_module_objects(
    arch = arch,
    name = "pwmc_pwmc_module",
    srcs = ['pwmc.c'],
    deps = ["//sys/dev/ofw:mii_family_headers", "//sys/dev/ofw:ofw_bus_if_headers", "//sys/dev/pwm:device_families_module_context_1", "//sys/dev/pwm:pwmbus_if_headers", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/vm:core_kernel_tty_headers", "//sys/" + arch + "/conf:generic_opt_platform_header"],
) for arch in ['arm64', 'riscv']]
