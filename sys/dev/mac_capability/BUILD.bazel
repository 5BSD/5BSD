# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "ioctl_headers", hdrs = ["mac_capability_ioctl.h", "mac_capability_coalition_proto.h"],
    strip_include_prefix = "/sys", deps = ["//sys/sys:cap_authority_header"], visibility = ["//visibility:public"])
cc_library(name = "capprotect_headers", hdrs = ["mac_capability_capprotect_proto.h"],
    strip_include_prefix = "/sys", visibility = ["//visibility:public"])

cc_library(name = "channel_headers", hdrs = ["mac_capability_channel_proto.h"],
    strip_include_prefix = "/sys", visibility = ["//visibility:public"])

cc_library(name = "isolation_headers", hdrs = ["mac_capability_isolation_proto.h"], strip_include_prefix = "/sys", visibility = ["//visibility:public"])

cc_library(name = "system_headers", hdrs = ["mac_capability_system_proto.h"], strip_include_prefix = "/sys", visibility = ["//visibility:public"])

cc_library(name = "shield_test_headers", hdrs = ["mac_capability_ioctl.h", "mac_capability_capprotect_proto.h", "mac_capability_identity_proto.h"],
    strip_include_prefix = ".", deps = ["//sys/sys:cap_authority_header"], visibility = ["//tests/sys/mac_capability:__pkg__"])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
cc_library(name = "kernel_headers", includes = ["../.."], hdrs = ["mac_capability.h", "mac_capability_ioctl.h", "mac_capability_label.h"],
    deps = ["//sys/contrib/ck:kernel_headers", "//sys/vm:kernel_headers"])
cc_library(name = "internal_headers", hdrs = ["mac_capability_internal.h"], deps = [":kernel_headers"])
cc_library(name = "accounting_module_headers", hdrs = ["mac_capability_accounting_proto.h"], deps = [":kernel_headers"])
amd64_generic_module_objects(name = "accounting_module", srcs = ["mac_capability_accounting.c"], deps = [":accounting_module_headers"])
cc_library(name = "identity_module_headers", hdrs = ["mac_capability_identity_proto.h"], deps = [":kernel_headers"])
amd64_generic_module_objects(name = "identity_module", srcs = ["mac_capability_identity.c"], deps = [":identity_module_headers"])
cc_library(name = "coalition_module_headers", hdrs = ["mac_capability_coalition_proto.h"], deps = [":internal_headers"])
amd64_generic_module_objects(name = "coalition_module", srcs = ["mac_capability_coalition.c"], deps = [":coalition_module_headers"])
cc_library(name = "node_module_headers", hdrs = ["mac_capability_node_proto.h"], deps = [":kernel_headers"])
amd64_generic_module_objects(name = "node_module", srcs = ["mac_capability_node.c"], deps = [":node_module_headers"])
cc_library(name = "channel_module_headers", hdrs = ["mac_capability_channel_proto.h"], deps = [":kernel_headers"])
amd64_generic_module_objects(name = "channel_module", srcs = ["mac_capability_channel.c"], deps = [":channel_module_headers"])
cc_library(name = "isolation_module_headers", hdrs = ["mac_capability_isolation_proto.h"], includes = ["../.."], deps = [":kernel_headers"])
amd64_generic_module_objects(name = "isolation_module", srcs = ["mac_capability_isolation.c"], deps = [":isolation_module_headers", "//sys/security/mac:policy_headers", "//sys/netinet:address_headers", "//sys/netgraph/bluetooth/include:socket_headers"])
cc_library(name = "mount_module_headers", hdrs = ["mac_capability_mount_proto.h"], includes = ["../.."], deps = [":kernel_headers"])
amd64_generic_module_objects(name = "mount_module", srcs = ["mac_capability_mount.c"], deps = [":mount_module_headers"])
cc_library(name = "system_module_headers", hdrs = ["mac_capability_system_proto.h"], includes = ["../.."], deps = [":kernel_headers"])
amd64_generic_module_objects(name = "system_module", srcs = ["mac_capability_system.c"], deps = [":system_module_headers", "//sys/security/mac:policy_headers", "//sys/net:network_headers"])

# Process lifecycle callbacks are built into the kernel, not this module.
amd64_generic_module_objects(name = "core_module",
    srcs = ["mac_capability_core.c", "mac_capability_dev.c", "mac_capability_kern.c", "mac_capability_label.c"],
    deps = [":internal_headers", "//sys/security/mac:policy_headers", "//sys/amd64/conf:generic_opt_capsicum_header"])
cc_library(name = "capprotect_module_headers", hdrs = ["mac_capability_capprotect_proto.h"], deps = [":kernel_headers"])
amd64_generic_module_objects(name = "capprotect_module", srcs = ["mac_capability_capprotect.c"],
    deps = [":capprotect_module_headers", "//sys/security/mac:policy_headers"])

load("//tools/build/bazel:kernel_amd64.bzl", "AMD64_KERNEL_FLAGS", "AMD64_KERNEL_HEADER_DEPS")
load("//tools/build/bazel:bsd_ctf.bzl", "bsd_ctf_library")
# Standard kernel sources: deliberately no KLD_MODULE or KLD_TIED definitions.
cc_library(name = "generic_builtin_objects",
    srcs = ["mac_capability_process.c", "mac_capability_authority.c"],
    deps = AMD64_KERNEL_HEADER_DEPS + [":internal_headers", "//sys/kern:generic_offset_header", "//sys/kern:vnode_headers"],
    copts = [flag for flag in AMD64_KERNEL_FLAGS if flag != "-fcommon"] + ["-fno-common"],
    local_defines = ["_KERNEL", "HAVE_KERNEL_OPTION_HEADERS", "__printf__=__freebsd_kprintf__"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
bsd_ctf_library(name = "generic_builtin_ctf", library = ":generic_builtin_objects",
    converter = "//cddl/usr.bin/ctfconvert:ctfconvert",
    runtime = ["//cddl/lib/libspl:spl_shared", "//lib/libdwarf:dwarf_shared", "//lib/libelf:elf_shared", "//lib/libz:z_shared",
        "@bsd_sdk//toolchain:sysroot/lib/libc.so.7", "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"],
    ctf_label_setting = "//tools/build/bazel/config:kernel_ctf_label", preserve_debug = True)
filegroup(name = "generic_builtin_object_files", srcs = [":generic_builtin_ctf"], output_group = "regular_objects", visibility = ["//visibility:public"])
