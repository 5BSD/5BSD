# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "ioctl_headers", hdrs = ["mac_capability_ioctl.h", "mac_capability_coalition_proto.h"],
    strip_include_prefix = "/sys", deps = ["//sys/sys:cap_authority_header"], visibility = ["//visibility:public"])
cc_library(name = "capprotect_headers", hdrs = ["mac_capability_capprotect_proto.h"],
    strip_include_prefix = "/sys", visibility = ["//visibility:public"])

cc_library(name = "channel_headers", hdrs = ["mac_capability_channel_proto.h"],
    strip_include_prefix = "/sys", visibility = ["//visibility:public"])

cc_library(name = "isolation_headers", hdrs = ["mac_capability_isolation_proto.h"], strip_include_prefix = "/sys", visibility = ["//visibility:public"])

cc_library(name = "system_headers", hdrs = ["mac_capability_system_proto.h"], strip_include_prefix = "/sys", visibility = ["//visibility:public"])

cc_library(name = "shield_test_headers", hdrs = ["mac_capability_ioctl.h", "mac_capability_capprotect_proto.h", "mac_capability_identity_proto.h"],
    strip_include_prefix = ".", deps = ["//sys/sys:cap_authority_header"], visibility = ["//tests/sys/mac_capability:__pkg__"])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
cc_library(name = "kernel_headers", includes = ["../.."], hdrs = ["mac_capability.h", "mac_capability_ioctl.h", "mac_capability_label.h"],
    deps = ["//sys/contrib/ck:kernel_headers", "//sys/vm:kernel_headers"])
cc_library(name = "internal_headers", hdrs = ["mac_capability_internal.h"], deps = [":kernel_headers"])
cc_library(name = "accounting_module_headers", hdrs = ["mac_capability_accounting_proto.h"], deps = [":kernel_headers"])

cc_library(name = "identity_module_headers", hdrs = ["mac_capability_identity_proto.h"], deps = [":kernel_headers"])

cc_library(name = "coalition_module_headers", hdrs = ["mac_capability_coalition_proto.h"], deps = [":internal_headers"])

cc_library(name = "node_module_headers", hdrs = ["mac_capability_node_proto.h"], deps = [":kernel_headers"])

cc_library(name = "channel_module_headers", hdrs = ["mac_capability_channel_proto.h"], deps = [":kernel_headers"])

cc_library(name = "isolation_module_headers", hdrs = ["mac_capability_isolation_proto.h"], includes = ["../.."], deps = [":kernel_headers"])

cc_library(name = "mount_module_headers", hdrs = ["mac_capability_mount_proto.h"], includes = ["../.."], deps = [":kernel_headers"])

cc_library(name = "system_module_headers", hdrs = ["mac_capability_system_proto.h"], includes = ["../.."], deps = [":kernel_headers"])



cc_library(name = "capprotect_module_headers", hdrs = ["mac_capability_capprotect_proto.h"], deps = [":kernel_headers"])


load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")
# Process lifecycle and authority sources always belong to the kernel.
amd64_generic_kernel_objects(name = "generic_builtin",
    srcs = ["mac_capability_process.c", "mac_capability_authority.c"], deps = [":internal_headers"])

cc_library(name = "label_headers", hdrs = ["mac_capability_label.h"], includes = ["../.."], visibility = ["//sys/security/oes:__pkg__", "//sys/kern:__pkg__"])

# Explicit GENERIC source groups, shared by the built-in and module variants.
_CAPABILITY_GROUPS = [
    ("accounting_module", ["mac_capability_accounting.c"], [":accounting_module_headers"]),
    ("identity_module", ["mac_capability_identity.c"], [":identity_module_headers"]),
    ("coalition_module", ["mac_capability_coalition.c"], [":coalition_module_headers"]),
    ("node_module", ["mac_capability_node.c"], [":node_module_headers"]),
    ("channel_module", ["mac_capability_channel.c"], [":channel_module_headers"]),
    ("isolation_module", ["mac_capability_isolation.c"], [":isolation_module_headers", "//sys/security/mac:policy_headers", "//sys/netinet:address_headers", "//sys/netgraph/bluetooth/include:socket_headers"]),
    ("mount_module", ["mac_capability_mount.c"], [":mount_module_headers"]),
    ("system_module", ["mac_capability_system.c"], [":system_module_headers", "//sys/security/mac:policy_headers", "//sys/net:network_headers"]),
    ("core_module", ["mac_capability_core.c", "mac_capability_dev.c", "mac_capability_kern.c", "mac_capability_label.c"], [":internal_headers", "//sys/security/mac:policy_headers", "//sys/amd64/conf:generic_opt_capsicum_header"]),
    ("capprotect_module", ["mac_capability_capprotect.c"], [":capprotect_module_headers", "//sys/security/mac:policy_headers"]),
]
[amd64_generic_module_objects(name = name, srcs = srcs, deps = deps) for name, srcs, deps in _CAPABILITY_GROUPS]
[amd64_generic_kernel_objects(name = name + "_builtin", srcs = srcs, deps = deps) for name, srcs, deps in _CAPABILITY_GROUPS]
filegroup(name = "generic_object_files", srcs = [":generic_builtin_object_files"] + [":" + name + "_builtin_object_files" for name, _, _deps in _CAPABILITY_GROUPS], visibility = ["//visibility:public"])
