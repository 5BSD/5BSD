load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "user_header", hdrs = ["filemon.h"], strip_include_prefix = ".", visibility = ["//usr.bin/bmake:__pkg__"])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
amd64_generic_module_objects(srcs = ["filemon.c"], textual_hdrs = ["filemon_wrapper.c"],
    deps = [":user_header", "//sys/contrib/ck:kernel_headers", "//sys/vm:kernel_headers"])

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")
[cross_generic_module_objects(arch = arch, srcs = ["filemon.c"], textual_hdrs = ["filemon_wrapper.c"],
    deps = [":user_header", "//sys/contrib/ck:kernel_headers", "//sys/vm:kernel_headers"])
 for arch in ["arm64", "riscv"]]
