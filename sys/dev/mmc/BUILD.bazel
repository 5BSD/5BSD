load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = glob(["*_if.m"]))

load("@rules_cc//cc:defs.bzl", "cc_library")

# Explicit source-header closure for the amd64 bhyve engine.
cc_library(name = "bhyve_engine_headers", hdrs = ['bridge.h', 'mmcreg.h'], strip_include_prefix = "/sys", visibility = ["//usr.sbin/bhyve:__pkg__"])

cc_library(name = "cam_headers", hdrs = ["mmcreg.h", "bridge.h"], strip_include_prefix = "/sys",
    visibility = ["//sys/cam:__pkg__"])

# Physical source closure used by the native storage module candidates.
cc_library(name = "storage_module_headers", hdrs = ["bridge.h", "mmcreg.h"],
    visibility = ["//sys/cam:__pkg__", "//sys/dev/nvme:__pkg__", "//sys/dev/nvd:__pkg__", "//sys/dev/ahci:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

# Native ISCI built-in physical prerequisites, with identical closures shared.
bsd_source_headers(name = "isci_kernel_isci_headers", hdrs = ["bridge.h", "mmcreg.h"],
    visibility = ["//sys/dev/isci:__pkg__"])

# Physical storage HBA prerequisites; identical contexts share providers.
bsd_source_headers(name = "storage_hba_kernel_ocs_gendump_headers", hdrs = ["bridge.h", "mmcreg.h"],
    visibility = ["//sys/dev/ocs_fc:__pkg__", "//sys/dev/smartpqi:__pkg__"])

# Physical storage core prerequisites; identical contexts share providers.
bsd_source_headers(name = "storage_core_kernel_cam_headers", hdrs = ["bridge.h", "mmcreg.h"],
    visibility = ["//sys/dev/ufshci:__pkg__", "//sys/geom/label:__pkg__", "//sys/dev/nvme:__pkg__", "//sys/geom:__pkg__", "//sys/cam:__pkg__"])
