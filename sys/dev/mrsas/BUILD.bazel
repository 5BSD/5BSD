    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_storage_controllers_mrsas_cam", srcs = ["mrsas_cam.c"],
    deps = ["//sys/cam:storage_controllers_kernel_isp_freebsd_headers", "//sys/dev/mmc:storage_controllers_kernel_aac_cam_headers", "//sys/dev/mrsas:storage_controllers_kernel_mrsas_headers", "//sys/dev/nvme:storage_controllers_kernel_aac_cam_headers", "//sys/dev/pci:storage_controllers_kernel_aac_headers", "//sys/net:storage_controllers_kernel_aac_headers", "//sys/netinet:storage_controllers_kernel_aac_headers", "//sys/netinet6:storage_controllers_kernel_aac_headers", "//sys/vm:storage_controllers_kernel_ciss_headers", "//sys/kern:storage_controllers_kernel_bus_if_headers", "//sys/kern:storage_controllers_kernel_device_if_headers", "//sys/amd64/conf:storage_controllers_kernel_opt_cam_header", "//sys/dev/pci:storage_controllers_kernel_pci_if_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_storage_controllers_mrsas_ioctl", srcs = ["mrsas_ioctl.c"],
    deps = ["//sys/dev/mrsas:storage_controllers_kernel_mrsas_headers", "//sys/dev/pci:storage_controllers_kernel_aac_headers", "//sys/kern:storage_controllers_kernel_bus_if_headers", "//sys/kern:storage_controllers_kernel_device_if_headers", "//sys/dev/pci:storage_controllers_kernel_pci_if_headers"],
