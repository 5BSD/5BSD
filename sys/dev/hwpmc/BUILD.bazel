load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "kernel_headers", hdrs = glob(["*.h"]),
    strip_include_prefix = ".", include_prefix = "dev/hwpmc", visibility = ["//visibility:public"])

# Userland PMC source ABI header closure.
cc_library(name = "pmc_user_headers", hdrs = ['hwpmc_amd.h', 'hwpmc_core.h', 'hwpmc_ibs.h', 'hwpmc_perf.h', 'hwpmc_rapl.h', 'hwpmc_tsc.h', 'hwpmc_uncore.h', 'pmc_events.h'], visibility = ["//lib/libpmc:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

bsd_source_headers(name = "tracing_core_headers", hdrs = ["hwpmc_amd.h", "hwpmc_core.h", "hwpmc_ibs.h", "hwpmc_perf.h", "hwpmc_rapl.h", "hwpmc_tsc.h", "hwpmc_uncore.h", "pmc_events.h"], includes = [],
    visibility = ["//sys/cddl/dev/dtrace:__pkg__", "//sys/cddl/dev/fbt:__pkg__", "//sys/cddl/dev/kinst:__pkg__", "//sys/modules/dtrace/dtraceall:__pkg__"])
