load("@rules_cc//cc:defs.bzl", "cc_library")

# Source-tree header closure used by the amd64 libvmmapi build.
cc_library(name = "vmmapi_headers", hdrs = ['vmm_dev.h', 'vmm_dirty_log.h', 'vmm_dirty_log_request.h', 'vmm_mem.h', 'vmm_param.h', 'vmm_startup_event.h', 'vmm_startup_mode.h', 'vmm_startup_request.h', 'vmm_startup_run_request.h'],
    strip_include_prefix = "/sys", visibility = ["//lib/libvmmapi:__pkg__"])

# Explicit source-header closure for the amd64 bhyve engine.
cc_library(name = "bhyve_engine_headers", hdrs = ['vmm_address_range.h', 'vmm_dirty_log_request.h', 'vmm_mem.h', 'vmm_param.h', 'vmm_startup_event.h', 'vmm_startup_mode.h', 'vmm_startup_request.h', 'vmm_startup_run_request.h'], strip_include_prefix = "/sys", visibility = ["//usr.sbin/bhyve:__pkg__"])

# dtrace(1) reads VM_MAXCPU-sized state (Make: -I sys).
cc_library(name = "param_header", hdrs = ["vmm_param.h"], strip_include_prefix = "/sys", visibility = ["//cddl/usr.sbin/dtrace:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")
bsd_source_headers(name = "tracing_module_headers", hdrs = ["vmm_param.h", "vmm_startup_event.h", "vmm_startup_mode.h"],
    includes = [], visibility = ["//sys/dev/dttransport:__pkg__", "//sys/cddl/dev/hypertrace:__pkg__", "//sys/security/audit:__pkg__", "//sys/cddl/dev/dtmalloc:__pkg__", "//sys/fs/nfsclient:__pkg__", "//sys/cddl/dev/profile:__pkg__", "//sys/cddl/dev:__pkg__", "//sys/cddl/dev/sdt:__pkg__"])
