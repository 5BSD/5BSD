load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = glob(["*_if.m"]))

load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "user_headers", hdrs = ["iscsi_ioctl.h", "iscsi_proto.h"],
    strip_include_prefix = ".", visibility = ["//lib/libiscsiutil:__pkg__", "//usr.bin/iscsictl:__pkg__", "//usr.sbin/iscsid:__pkg__", "//usr.sbin/ctld:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

bsd_source_headers(name = "rdma_module_context_0", hdrs = ["icl.h", "iscsi_proto.h"], includes = [],
    visibility = ["//sys/dev/iser:__pkg__"])

filegroup(name = "icl_conn_if_module_header", srcs = [":icl_conn_if"], output_group = "header")
cc_library(name = "icl_conn_if_headers", hdrs = [":icl_conn_if_module_header"], strip_include_prefix = "icl_conn_if.generated", visibility = ["//sys/dev/iser:__pkg__"])
