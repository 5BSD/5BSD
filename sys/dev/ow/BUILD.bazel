load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = glob(["*_if.m"]))

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

bsd_source_headers(name = "device_families_module_context_0", hdrs = ["ow.h", "owll.h", "own.h"], includes = [],
    visibility = ["//sys/dev/ow:__pkg__"])

bsd_source_headers(name = "device_families_module_context_1", hdrs = ["ow.h"], includes = [],
    visibility = ["//sys/dev/ow:__pkg__"])

bsd_source_headers(name = "device_families_module_context_2", hdrs = ["owll.h"], includes = [],
    visibility = ["//sys/dev/ow:__pkg__"])

bsd_source_headers(name = "device_families_module_context_3", hdrs = ["ow.h", "own.h"], includes = [],
    visibility = ["//sys/dev/ow:__pkg__"])

load("@rules_cc//cc:defs.bzl", "cc_library")

filegroup(name = "owll_if_module_header", srcs = [":owll_if"], output_group = "header")
cc_library(name = "owll_if_headers", hdrs = [":owll_if_module_header"], strip_include_prefix = "owll_if.generated", visibility = ["//sys/dev/ow:__pkg__"])

filegroup(name = "own_if_module_header", srcs = [":own_if"], output_group = "header")
cc_library(name = "own_if_headers", hdrs = [":own_if_module_header"], strip_include_prefix = "own_if.generated", visibility = ["//sys/dev/ow:__pkg__"])

filegroup(name = "own_if_module_source", srcs = [":own_if"], output_group = "source")

filegroup(name = "owll_if_module_source", srcs = [":owll_if"], output_group = "source")

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")

load("//tools/build/bazel:kernel_amd64.bzl", "AMD64_KERNEL_WARNING_FLAGS")

amd64_generic_module_objects(name = "ow_ow_module", srcs = ["ow.c"],
    deps = ["//sys/dev/ow:device_families_module_context_0", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/ow:owll_if_headers", "//sys/dev/ow:own_if_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = [])

amd64_generic_module_objects(name = "ow_own_if_module", srcs = [":own_if_module_source"],
    deps = ["//sys/dev/ow:device_families_module_context_1", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/ow:own_if_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = ["-fmacro-prefix-map=$(execpath :own_if_module_source)=own_if.c", "-fdebug-prefix-map=$(execpath :own_if_module_source)=own_if.c"], local_defines = [])

amd64_generic_module_objects(name = "ow_owll_if_module", srcs = [":owll_if_module_source"],
    deps = ["//sys/dev/ow:device_families_module_context_2", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/ow:owll_if_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = ["-fmacro-prefix-map=$(execpath :owll_if_module_source)=owll_if.c", "-fdebug-prefix-map=$(execpath :owll_if_module_source)=owll_if.c"], local_defines = [])

amd64_generic_module_objects(name = "ow_temp_ow_temp_module", srcs = ["ow_temp.c"],
    deps = ["//sys/dev/ow:device_families_module_context_3", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/ow:own_if_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = [])

amd64_generic_module_objects(name = "owc_owc_gpiobus_module", srcs = ["owc_gpiobus.c"],
    deps = ["//sys/dev/gpio:hardware_module_amdgpio_headers", "//sys/dev/ofw:hardware_module_adlngpio_headers", "//sys/vm:core_kernel_imgact_shell_headers", "//sys/dev/ow:device_families_module_context_2", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers", "//sys/dev/gpio:gpio_if_headers", "//sys/amd64/conf:generic_opt_platform_header", "//sys/dev/ow:owll_if_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = [])
