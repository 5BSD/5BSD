load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = glob(["*_if.m"]))

load("@rules_cc//cc:defs.bzl", "cc_library")
filegroup(name = "fb_if_header_file", srcs = [":fb_if"], output_group = "header")
cc_library(name = "fb_if_headers", hdrs = [":fb_if_header_file"],
    strip_include_prefix = "fb_if.generated", visibility = ["//sys/dev/virtio/gpu:__pkg__"])
