load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = glob(["*_if.m"]))

load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "ioctl_headers", hdrs = ["acpiio.h"], strip_include_prefix = "/sys", visibility = ["//usr.sbin/acpi:__subpackages__"])

filegroup(name = "acpi_if_header_file", srcs = [":acpi_if"], output_group = "header")
cc_library(name = "acpi_if_headers", hdrs = [":acpi_if_header_file"], strip_include_prefix = "acpi_if.generated",
    visibility = ["//sys/x86/x86:__pkg__", "//sys/amd64/amd64:__pkg__", "//sys/dev/acpi_support:__pkg__", "//sys/dev/acpica:__pkg__", "//sys/dev/ahci:__pkg__", "//sys/dev/amdsmu:__pkg__", "//sys/dev/virtio/pmem:__pkg__"])
cc_library(name = "acpivar_headers", hdrs = ["acpivar.h"], strip_include_prefix = "/sys",
    deps = [":acpi_if_headers", "//sys/kern:bus_if_headers", "//sys/sys:kernel_headers"],
    visibility = ["//sys/dev/amdsmu:__pkg__", "//sys/dev/virtio/pmem:__pkg__"])

# Physical source closure used by the native storage module candidates.
cc_library(name = "storage_module_headers", hdrs = ["acpivar.h"],
    visibility = ["//sys/dev/nvme:__pkg__", "//sys/dev/nvd:__pkg__", "//sys/dev/ahci:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

bsd_source_headers(name = "acpi_support_headers", hdrs = ["acpiio.h", "acpivar.h", "apeivar.h"], visibility = ["//sys/dev/acpi_support:__pkg__", "//sys/dev/acpica:__pkg__"])

filegroup(name = "apei_if_header_file", srcs = [":apei_if"], output_group = "header")
cc_library(name = "apei_if_headers", hdrs = [":apei_if_header_file"], strip_include_prefix = "apei_if.generated", visibility = ["//sys/dev/acpi_support:__pkg__", "//sys/dev/acpica:__pkg__"])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")

