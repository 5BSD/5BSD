# Low-level amd64 built-in prerequisites.
bsd_source_headers(name = "lowlevel_kernel_mp_machdep_headers", hdrs = ["acpivar.h"],
    visibility = ["//sys/amd64/amd64:__pkg__"])

# x86 core built-in prerequisites.
bsd_source_headers(name = "x86_core_kernel_mp_x86_headers", hdrs = ["acpivar.h"],
    visibility = ["//sys/x86/x86:__pkg__"])
bsd_source_headers(name = "x86_core_kernel_tsc_headers", hdrs = ["acpi_hpet.h"],
    visibility = ["//sys/x86/x86:__pkg__"])
