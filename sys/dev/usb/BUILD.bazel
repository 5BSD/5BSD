load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = glob(["*_if.m"]))

load("@rules_cc//cc:defs.bzl", "cc_library")

# Explicit source-header closure for the amd64 bhyve engine.
cc_library(name = "bhyve_engine_headers", hdrs = ['usb.h', 'usb_endian.h', 'usb_freebsd.h', 'usbdi.h'], strip_include_prefix = "/sys", visibility = ["//usr.sbin/bhyve:__pkg__"])

load("//tools/build/bazel:bsd_usbdevs.bzl", "bsd_usbdevs_header")
exports_files(["usbdevs"])
bsd_usbdevs_header(name = "device_ids")
cc_library(name = "device_id_headers", hdrs = [":device_ids"],
    strip_include_prefix = "device_ids.generated", visibility = ["//sys/dev/usb/net:__pkg__", "//sys/netgraph/bluetooth:__pkg__", "//sys/dev/hid:__pkg__", "//sys/dev/sound/usb:__pkg__", "//sys/dev/usb:__pkg__", "//sys/dev/otus:__pkg__", "//sys/dev/rtwn:__pkg__"])
filegroup(name = "usb_if_header_file", srcs = [":usb_if"], output_group = "header")
cc_library(name = "usb_if_headers", hdrs = [":usb_if_header_file"],
    strip_include_prefix = "usb_if.generated", visibility = ["//sys/dev/usb/net:__pkg__", "//sys/netgraph/bluetooth:__pkg__", "//sys/dev/usb/controller:__pkg__", "//sys/dev/usb:__pkg__"])

cc_library(name = "bluetooth_headers", hdrs = ["usb.h", "usb_busdma.h", "usb_debug.h", "usb_dev.h", "usb_endian.h", "usb_freebsd.h", "usb_ioctl.h", "usbdi.h", "usbdi_util.h"], strip_include_prefix = "/sys",
