load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(name = "virtio_driver_headers", hdrs = ["if_vtnet_netmap.h", "netmap_kern.h", "netmap_mbq.h"],
    includes = ["../.."], deps = ["//sys/net:netmap_user_headers", "//sys/vm:kernel_headers"],
    visibility = ["//sys/dev/virtio/network:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

# Physical source prerequisites from independent Ethernet module builds.
bsd_source_headers(name = "pci_ethernet_headers", hdrs = ["if_re_netmap.h", "netmap_kern.h", "netmap_mbq.h"], visibility = ["//sys/dev/alc:__pkg__", "//sys/dev/ale:__pkg__", "//sys/dev/aq:__pkg__", "//sys/dev/bce:__pkg__", "//sys/dev/bge:__pkg__", "//sys/dev/et:__pkg__", "//sys/dev/jme:__pkg__", "//sys/dev/msk:__pkg__", "//sys/dev/nfe:__pkg__", "//sys/dev/re:__pkg__", "//sys/dev/rge:__pkg__", "//sys/dev/sge:__pkg__", "//sys/dev/vte:__pkg__"])

# Physical prerequisites consumed by independent network-support module builds.
bsd_source_headers(name = "network_support_headers", hdrs = ["netmap_kern.h", "netmap_mbq.h"], visibility = ["//sys/net:__pkg__"])

# Network built-in prerequisites.
bsd_source_headers(name = "net_kernel_iflib_headers", hdrs = ["netmap_kern.h", "netmap_mbq.h"],
    visibility = ["//sys/net:__pkg__"])

# Physical native Intel NIC built-in prerequisites.
bsd_source_headers(name = "intel_nic_kernel_if_ix_headers", hdrs = ["netmap_kern.h", "netmap_mbq.h"],
    visibility = ["//sys/dev/e1000:__pkg__", "//sys/dev/ixgbe:__pkg__", "//sys/dev/ice:__pkg__"])

# Physical prerequisites for native virtualization built-ins.
bsd_source_headers(name = "virtualization_kernel_if_vtnet_headers", hdrs = ["if_vtnet_netmap.h", "netmap_kern.h", "netmap_mbq.h"],
    visibility = ["//sys/dev/hyperv:__pkg__", "//sys/dev/hyperv/vmbus:__pkg__", "//sys/dev/virtio:__pkg__", "//sys/dev/virtio/balloon:__pkg__", "//sys/dev/virtio/block:__pkg__", "//sys/dev/virtio/dtrace:__pkg__", "//sys/dev/virtio/network:__pkg__", "//sys/dev/virtio/pci:__pkg__", "//sys/dev/virtio/scsi:__pkg__", "//sys/dev/virtio/vsock:__pkg__", "//sys/dev/xen:__pkg__"])

# Physical prerequisites for native Ethernet built-ins.
bsd_source_headers(name = "ethernet_kernel_if_re_headers", hdrs = ["if_re_netmap.h", "netmap_kern.h", "netmap_mbq.h"],
    visibility = ["//sys/dev/alc:__pkg__", "//sys/dev/ale:__pkg__", "//sys/dev/aq:__pkg__", "//sys/dev/axgbe:__pkg__", "//sys/dev/bce:__pkg__", "//sys/dev/bge:__pkg__", "//sys/dev/bxe:__pkg__", "//sys/dev/et:__pkg__", "//sys/dev/iavf:__pkg__", "//sys/dev/igc:__pkg__", "//sys/dev/ixl:__pkg__", "//sys/dev/jme:__pkg__", "//sys/dev/msk:__pkg__", "//sys/dev/nfe:__pkg__", "//sys/dev/re:__pkg__", "//sys/dev/rge:__pkg__", "//sys/dev/sge:__pkg__"])
