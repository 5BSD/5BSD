load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")
load("//tools/build/bazel:kernel_common.bzl", "KERNEL_BUILTIN_WARNING_FLAGS")

# Native amd64 GENERIC codec and crypto built-ins.
amd64_generic_kernel_objects(name = "generic_codecs_crypto_xz_mod", srcs = ["xz_mod.c"],
    deps = ["//sys/contrib/xz-embedded:codecs_crypto_kernel_xz_mod_headers", "//sys/contrib/xz-embedded:codecs_crypto_kernel_port_headers"], early_deps = [],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS, copts = ["-DXZ_USE_CRC64"])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")

load("//tools/build/bazel:kernel_amd64.bzl", "AMD64_KERNEL_WARNING_FLAGS")

amd64_generic_module_objects(name = "xz_xz_mod_module", srcs = ["xz_mod.c"],
    deps = [],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = ["XZ_USE_CRC64"], header_overrides = ["//sys/contrib/xz-embedded:system_io_module_context_3"], preinclude_headers = [], textual_hdrs = [])
