load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = glob(["*_if.m"]))

load("@rules_cc//cc:defs.bzl", "cc_library")

# Explicit source-header closure for the amd64 bhyve engine.
cc_library(name = "bhyve_engine_headers", hdrs = ['balloon/virtio_balloon.h', 'gpu/virtio_gpu.h', 'network/virtio_net_5bsd.h', 'virtio.h', 'virtio_config.h', 'virtio_endian.h', 'virtio_ids.h', 'virtio_ring.h'], strip_include_prefix = "/sys", deps = ["//sys/dev/virtio/rtc:rtc_headers"], visibility = ["//usr.sbin/bhyve:__pkg__"])

# HyperTrace virtio-dtrace wire format, included by bhyve as <dev/virtio/dtrace/virtio_dtrace_wire.h>.
cc_library(name = "hypertrace_headers", hdrs = ["dtrace/virtio_dtrace_wire.h"], strip_include_prefix = "/sys", visibility = ["//usr.sbin/bhyve:__pkg__"])

# Kernel driver headers and generated interfaces shared by virtio modules.
cc_library(name = "virtio_headers", hdrs = ["virtio.h", "virtio_config.h", "virtio_endian.h", "virtio_ids.h", "virtqueue.h"], strip_include_prefix = "/sys", visibility = ["//visibility:public"])

filegroup(name = "virtio_if_header_file", srcs = [":virtio_if"], output_group = "header")
cc_library(name = "virtio_if_headers", hdrs = [":virtio_if_header_file"], strip_include_prefix = "virtio_if.generated", visibility = ["//visibility:public"])

filegroup(name = "virtio_bus_if_header_file", srcs = [":virtio_bus_if"], output_group = "header")
cc_library(name = "virtio_bus_if_headers", hdrs = [":virtio_bus_if_header_file"], strip_include_prefix = "virtio_bus_if.generated", visibility = ["//visibility:public"])
