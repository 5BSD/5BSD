load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(name = "random_headers", hdrs = ["virtio_random_var.h"], strip_include_prefix = "/sys")

amd64_generic_module_objects(name = "generic_module", srcs = ["virtio_random.c"], deps = [
    ":random_headers",
    "//sys/dev/random:harvest_headers",
    "//sys/dev/random:provider_headers",
    "//sys/dev/virtio:virtio_headers",
    "//sys/dev/virtio:virtio_if_headers",
    "//sys/kern:bus_if_headers",
    "//sys/kern:device_if_headers",
    "//sys/vm:kernel_headers",
])
