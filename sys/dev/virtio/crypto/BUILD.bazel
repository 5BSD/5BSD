load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(name = "kernel_headers", hdrs = ['virtio_crypto.h'], strip_include_prefix = "/sys")

# virtio_crypto_guest_test includes the driver as <dev/virtio/crypto/virtio_crypto.c>
# (Make: -I sys); the kernel headers it names only need to exist there.
cc_library(name = "guest_test_inputs", hdrs = ["virtio_crypto.h"], textual_hdrs = ["virtio_crypto.c"],
    strip_include_prefix = "/sys", deps = ["//sys/dev/virtio:virtio_headers", "//sys/opencrypto:cryptodev_headers"],
    visibility = ["//tests/sys/kern/vsock_device_harness:__pkg__"])

amd64_generic_module_objects(srcs = ["virtio_crypto.c"],
    deps = [":kernel_headers", "//sys/dev/virtio:driver_headers",
        "//sys/opencrypto:cryptodev_headers",
        "//sys/opencrypto:cryptodev_if_headers"])

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")

[cross_generic_module_objects(
    arch = arch,
    srcs = ["virtio_crypto.c"],
    deps = [
        ":kernel_headers",
        "//sys/dev/virtio:driver_headers",
        "//sys/opencrypto:cryptodev_headers",
        "//sys/opencrypto:cryptodev_if_headers",
    ],
) for arch in ["arm64", "riscv"]]
