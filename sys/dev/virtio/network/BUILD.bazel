load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")

cc_library(name = "kernel_headers", hdrs = ["virtio_net.h", "if_vtnetvar.h", "virtio_net_5bsd.h"], strip_include_prefix = "/sys")
exports_files(["virtio_net_5bsd.h"], visibility = ["//sys/dev/virtio:__pkg__"])

amd64_generic_module_objects(srcs = ["if_vtnet.c"], deps = [
    ":kernel_headers", "//sys/dev/virtio:driver_headers", "//sys/dev/netmap:virtio_driver_headers",
    "//sys/net:virtio_driver_headers", "//sys/netinet:virtio_driver_headers", "//sys/netinet6:ip6_headers",
    "//sys/vm:kernel_headers", "//sys/contrib/ck:kernel_headers",
    "//sys/amd64/conf:generic_opt_inet_header", "//sys/amd64/conf:generic_opt_inet6_header",
])

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")

[cross_generic_module_objects(
    arch = arch,
    srcs = ["if_vtnet.c"],
    deps = [
        ":kernel_headers",
        "//sys/dev/virtio:driver_headers",
        "//sys/dev/netmap:virtio_driver_headers",
        "//sys/net:virtio_driver_headers",
        "//sys/netinet:virtio_driver_headers",
        "//sys/netinet6:ip6_headers",
        "//sys/vm:kernel_headers",
        "//sys/contrib/ck:kernel_headers",
        "//sys/" + arch + "/conf:generic_opt_inet_header",
        "//sys/" + arch + "/conf:generic_opt_inet6_header",
    ],
) for arch in ["arm64", "riscv"]]

# Network built-in prerequisites.
load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")
bsd_source_headers(name = "net_kernel_if_tuntap_headers", hdrs = ["virtio_net.h"],
    visibility = ["//sys/net:__pkg__"])

# Physical prerequisites for native virtualization built-ins.
bsd_source_headers(name = "virtualization_kernel_if_vtnet_headers", hdrs = ["if_vtnetvar.h", "virtio_net.h", "virtio_net_5bsd.h"],
    visibility = ["//sys/dev/hyperv:__pkg__", "//sys/dev/hyperv/vmbus:__pkg__", "//sys/dev/virtio:__pkg__", "//sys/dev/virtio/balloon:__pkg__", "//sys/dev/virtio/block:__pkg__", "//sys/dev/virtio/dtrace:__pkg__", "//sys/dev/virtio/network:__pkg__", "//sys/dev/virtio/pci:__pkg__", "//sys/dev/virtio/scsi:__pkg__", "//sys/dev/virtio/vsock:__pkg__", "//sys/dev/xen:__pkg__"])

load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")
load("//tools/build/bazel:kernel_common.bzl", "KERNEL_BUILTIN_WARNING_FLAGS")

# Native amd64 GENERIC virtualization built-ins.
amd64_generic_kernel_objects(name = "generic_virtualization_if_vtnet", srcs = ["if_vtnet.c"],
    deps = ["//sys/contrib/ck:virtualization_kernel_if_vtnet_headers", "//sys/dev/netmap:virtualization_kernel_if_vtnet_headers", "//sys/dev/virtio:virtualization_kernel_virtio_headers", "//sys/dev/virtio/network:virtualization_kernel_if_vtnet_headers", "//sys/net:virtualization_kernel_if_vtnet_headers", "//sys/netinet:virtualization_kernel_if_vtnet_headers", "//sys/netinet6:virtualization_kernel_if_vtnet_headers", "//sys/vm:virtualization_kernel_if_vtnet_headers", "//sys/kern:virtualization_kernel_bus_if_headers", "//sys/kern:virtualization_kernel_device_if_headers", "//sys/amd64/conf:virtualization_kernel_opt_inet_header", "//sys/amd64/conf:virtualization_kernel_opt_inet6_header", "//sys/dev/virtio:virtualization_kernel_virtio_if_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)

# Physical prerequisites for native monitoring device built-ins.
bsd_source_headers(name = "monitoring_devices_kernel_if_ptnet_headers", hdrs = ["virtio_net.h"],
    visibility = ["//sys/dev/acpica:__pkg__", "//sys/dev/hwpmc:__pkg__", "//sys/dev/hwt:__pkg__", "//sys/dev/netmap:__pkg__", "//sys/nfs:__pkg__", "//sys/security/audit:__pkg__", "//sys/security/mac_ntpd:__pkg__"])
