amd64_generic_module_objects(name = "generic_module", srcs = ["virtio_pmem.c"], deps = [
    ":pmem_headers",
    "//sys/amd64/conf:generic_opt_acpi_header",
    "//sys/contrib/dev/acpica/include:kernel_headers",
    "//sys/dev/acpica:acpivar_headers",
    "//sys/dev/nvdimm:kernel_headers",
    "//sys/dev/virtio:virtio_headers",
    "//sys/dev/virtio:virtio_if_headers",
    "//sys/dev/virtio/pci:shmem_headers",
    "//sys/geom:kernel_headers",
    "//sys/kern:bus_if_headers",
    "//sys/kern:device_if_headers",
    "//sys/vm:kernel_headers",
])
