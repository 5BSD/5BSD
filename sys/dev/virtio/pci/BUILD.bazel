load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = glob(["*_if.m"]))

load("@rules_cc//cc:defs.bzl", "cc_library")

# Explicit source-header closure for the amd64 bhyve engine.
cc_library(name = "bhyve_engine_headers", hdrs = ['virtio_pci_legacy_var.h', 'virtio_pci_modern_var.h', 'virtio_pci_var.h'], strip_include_prefix = "/sys", visibility = ["//usr.sbin/bhyve:__pkg__"])

cc_library(name = "shmem_headers", hdrs = ["virtio_pci_shmem.h"], strip_include_prefix = "/sys",
    visibility = ["//sys/dev/virtio/pmem:__pkg__"])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")

filegroup(name = "virtio_pci_if_header_file", srcs = [":virtio_pci_if"], output_group = "header")
filegroup(name = "virtio_pci_if_source", srcs = [":virtio_pci_if"], output_group = "source")
cc_library(name = "interface_headers", hdrs = [":virtio_pci_if_header_file"], strip_include_prefix = "virtio_pci_if.generated")
cc_library(name = "kernel_headers", hdrs = ["virtio_pci.h", "virtio_pci_var.h", "virtio_pci_legacy_var.h", "virtio_pci_modern_var.h"], strip_include_prefix = "/sys")

amd64_generic_module_objects(name = "generic_driver", srcs = ["virtio_pci.c", "virtio_pci_legacy.c", "virtio_pci_modern.c"],
    deps = [":kernel_headers", ":shmem_headers", ":interface_headers",
        "//sys/dev/virtio:driver_headers", "//sys/dev/virtio/iommu:kernel_headers", "//sys/dev/pci:kernel_headers"])
amd64_generic_module_objects(name = "generic_interface", srcs = [":virtio_pci_if_source"],
    deps = [":kernel_headers", ":interface_headers", "//sys/dev/virtio:driver_headers"],
    copts = ["-fmacro-prefix-map=$(execpath :virtio_pci_if_source)=virtio_pci_if.c",
        "-fdebug-prefix-map=$(execpath :virtio_pci_if_source)=virtio_pci_if.c"])

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")

[cross_generic_module_objects(
    arch = arch,
    name = "generic_driver",
    srcs = [
        "virtio_pci.c",
        "virtio_pci_legacy.c",
        "virtio_pci_modern.c",
    ],
    deps = [
        ":kernel_headers",
        ":shmem_headers",
        ":interface_headers",
        "//sys/dev/virtio:driver_headers",
        "//sys/dev/virtio/iommu:kernel_headers",
        "//sys/dev/pci:kernel_headers",
    ],
) for arch in ["arm64", "riscv"]]

[cross_generic_module_objects(
    arch = arch,
    name = "generic_interface",
    srcs = [":virtio_pci_if_source"],
    deps = [
        ":kernel_headers",
        ":interface_headers",
        "//sys/dev/virtio:driver_headers",
    ],
    copts = ["-fmacro-prefix-map=$(execpath :virtio_pci_if_source)=virtio_pci_if.c", "-fdebug-prefix-map=$(execpath :virtio_pci_if_source)=virtio_pci_if.c"],
) for arch in ["arm64", "riscv"]]

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

# Physical prerequisites for native virtualization built-ins.
bsd_source_headers(name = "virtualization_kernel_virtio_pci_headers", hdrs = ["virtio_pci.h", "virtio_pci_var.h"],
    visibility = ["//sys/dev/hyperv:__pkg__", "//sys/dev/hyperv/vmbus:__pkg__", "//sys/dev/virtio:__pkg__", "//sys/dev/virtio/balloon:__pkg__", "//sys/dev/virtio/block:__pkg__", "//sys/dev/virtio/dtrace:__pkg__", "//sys/dev/virtio/network:__pkg__", "//sys/dev/virtio/pci:__pkg__", "//sys/dev/virtio/scsi:__pkg__", "//sys/dev/virtio/vsock:__pkg__", "//sys/dev/xen:__pkg__"])
bsd_source_headers(name = "virtualization_kernel_virtio_pci_legacy_headers", hdrs = ["virtio_pci.h", "virtio_pci_legacy_var.h", "virtio_pci_var.h"],
    visibility = ["//sys/dev/hyperv:__pkg__", "//sys/dev/hyperv/vmbus:__pkg__", "//sys/dev/virtio:__pkg__", "//sys/dev/virtio/balloon:__pkg__", "//sys/dev/virtio/block:__pkg__", "//sys/dev/virtio/dtrace:__pkg__", "//sys/dev/virtio/network:__pkg__", "//sys/dev/virtio/pci:__pkg__", "//sys/dev/virtio/scsi:__pkg__", "//sys/dev/virtio/vsock:__pkg__", "//sys/dev/xen:__pkg__"])
bsd_source_headers(name = "virtualization_kernel_virtio_pci_modern_headers", hdrs = ["virtio_pci.h", "virtio_pci_modern_var.h", "virtio_pci_shmem.h", "virtio_pci_var.h"],
    visibility = ["//sys/dev/hyperv:__pkg__", "//sys/dev/hyperv/vmbus:__pkg__", "//sys/dev/virtio:__pkg__", "//sys/dev/virtio/balloon:__pkg__", "//sys/dev/virtio/block:__pkg__", "//sys/dev/virtio/dtrace:__pkg__", "//sys/dev/virtio/network:__pkg__", "//sys/dev/virtio/pci:__pkg__", "//sys/dev/virtio/scsi:__pkg__", "//sys/dev/virtio/vsock:__pkg__", "//sys/dev/xen:__pkg__"])

filegroup(name = "virtualization_kernel_virtio_pci_if_file", srcs = [":virtio_pci_if"], output_group = "header")
cc_library(name = "virtualization_kernel_virtio_pci_if_headers", hdrs = [":virtualization_kernel_virtio_pci_if_file"], strip_include_prefix = "virtio_pci_if.generated", visibility = ["//sys/dev/hyperv:__pkg__", "//sys/dev/hyperv/vmbus:__pkg__", "//sys/dev/virtio:__pkg__", "//sys/dev/virtio/balloon:__pkg__", "//sys/dev/virtio/block:__pkg__", "//sys/dev/virtio/dtrace:__pkg__", "//sys/dev/virtio/network:__pkg__", "//sys/dev/virtio/pci:__pkg__", "//sys/dev/virtio/scsi:__pkg__", "//sys/dev/virtio/vsock:__pkg__", "//sys/dev/xen:__pkg__"])

load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")
load("//tools/build/bazel:kernel_common.bzl", "KERNEL_BUILTIN_WARNING_FLAGS")

# Native amd64 GENERIC virtualization built-ins.
amd64_generic_kernel_objects(name = "generic_virtualization_virtio_pci", srcs = ["virtio_pci.c"],
    deps = ["//sys/dev/pci:virtualization_kernel_virtio_pci_headers", "//sys/dev/virtio:virtualization_kernel_virtio_headers", "//sys/dev/virtio/pci:virtualization_kernel_virtio_pci_headers", "//sys/kern:virtualization_kernel_bus_if_headers", "//sys/kern:virtualization_kernel_device_if_headers", "//sys/dev/pci:virtualization_kernel_pci_if_headers", "//sys/dev/virtio:virtualization_kernel_virtio_if_headers", "//sys/dev/virtio/pci:virtualization_kernel_virtio_pci_if_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_virtualization_virtio_pci_legacy", srcs = ["virtio_pci_legacy.c"],
    deps = ["//sys/dev/pci:virtualization_kernel_virtio_pci_headers", "//sys/dev/virtio:virtualization_kernel_virtio_headers", "//sys/dev/virtio/pci:virtualization_kernel_virtio_pci_legacy_headers", "//sys/kern:virtualization_kernel_bus_if_headers", "//sys/kern:virtualization_kernel_device_if_headers", "//sys/dev/pci:virtualization_kernel_pci_if_headers", "//sys/dev/virtio:virtualization_kernel_virtio_bus_if_headers", "//sys/dev/virtio:virtualization_kernel_virtio_if_headers", "//sys/dev/virtio/pci:virtualization_kernel_virtio_pci_if_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_virtualization_virtio_pci_modern", srcs = ["virtio_pci_modern.c"],
    deps = ["//sys/dev/pci:virtualization_kernel_virtio_pci_headers", "//sys/dev/virtio:virtualization_kernel_virtio_headers", "//sys/dev/virtio/iommu:virtualization_kernel_virtio_iommu_headers", "//sys/dev/virtio/pci:virtualization_kernel_virtio_pci_modern_headers", "//sys/kern:virtualization_kernel_bus_if_headers", "//sys/kern:virtualization_kernel_device_if_headers", "//sys/dev/pci:virtualization_kernel_pci_if_headers", "//sys/dev/virtio:virtualization_kernel_virtio_bus_if_headers", "//sys/dev/virtio:virtualization_kernel_virtio_if_headers", "//sys/dev/virtio/pci:virtualization_kernel_virtio_pci_if_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)

filegroup(name = "kobj_builtins_kernel_virtio_pci_if_file", srcs = [":virtio_pci_if"], output_group = "header")
cc_library(name = "kobj_builtins_kernel_virtio_pci_if_headers", hdrs = [":kobj_builtins_kernel_virtio_pci_if_file"], strip_include_prefix = "virtio_pci_if.generated", visibility = ["//sys/compat/linuxkpi/common/src:__pkg__", "//sys/dev/acpi_support:__pkg__", "//sys/dev/acpica:__pkg__", "//sys/dev/backlight:__pkg__", "//sys/dev/fb:__pkg__", "//sys/dev/hid:__pkg__", "//sys/dev/hyperv/vmbus:__pkg__", "//sys/dev/ice:__pkg__", "//sys/dev/iicbus:__pkg__", "//sys/dev/mdio:__pkg__", "//sys/dev/mii:__pkg__", "//sys/dev/mmc:__pkg__", "//sys/dev/nvme:__pkg__", "//sys/dev/pci:__pkg__", "//sys/dev/sdhci:__pkg__", "//sys/dev/smbus:__pkg__", "//sys/dev/sound/midi:__pkg__", "//sys/dev/sound/pci/hda:__pkg__", "//sys/dev/sound/pcm:__pkg__", "//sys/dev/tpm:__pkg__", "//sys/dev/uart:__pkg__", "//sys/dev/usb:__pkg__", "//sys/dev/video:__pkg__", "//sys/dev/virtio:__pkg__", "//sys/dev/virtio/pci:__pkg__", "//sys/geom:__pkg__", "//sys/isa:__pkg__", "//sys/kern:__pkg__", "//sys/net:__pkg__", "//sys/opencrypto:__pkg__", "//sys/xen/xenbus:__pkg__", "//sys/xen/xenmem:__pkg__"])

# Native amd64 GENERIC generated KOBJ interface built-ins.
filegroup(name = "builtin_virtio_pci_if_source", srcs = [":virtio_pci_if"], output_group = "source")
amd64_generic_kernel_objects(name = "generic_kobj_builtins_virtio_pci_if", srcs = [":builtin_virtio_pci_if_source"],
    deps = ["//sys/kern:kobj_builtins_kernel_bus_if_headers", "//sys/kern:kobj_builtins_kernel_device_if_headers", "//sys/dev/virtio/pci:kobj_builtins_kernel_virtio_pci_if_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
