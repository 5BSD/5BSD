load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(name = "kernel_headers", hdrs = ['virtio_blk.h', 'virtio_blk_capacity.h'], strip_include_prefix = "/sys")

amd64_generic_module_objects(srcs = ["virtio_blk.c"],
    deps = [":kernel_headers", "//sys/dev/virtio:driver_headers",
        "//sys/geom:disk_headers",
        "//sys/vm:kernel_headers"])
