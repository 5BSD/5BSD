load("@rules_cc//cc:defs.bzl", "cc_library")

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")

cc_library(name = "kernel_headers", hdrs = ['virtio_scsi.h', 'virtio_scsivar.h'], strip_include_prefix = "/sys")

amd64_generic_module_objects(srcs = ["virtio_scsi.c"],
    deps = [":kernel_headers", "//sys/dev/virtio:driver_headers",
        "//sys/cam:headers",
        "//sys/netinet:address_headers",
        "//sys/amd64/conf:generic_opt_scsi_header",
        "//sys/amd64/conf:generic_opt_cam_header",
        "//sys/contrib/ck:kernel_headers",
        "//sys/vm:kernel_headers"])

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")

[cross_generic_module_objects(
    arch = arch,
    srcs = ["virtio_scsi.c"],
    deps = [
        ":kernel_headers",
        "//sys/dev/virtio:driver_headers",
        "//sys/cam:headers",
        "//sys/netinet:address_headers",
        "//sys/" + arch + "/conf:generic_opt_scsi_header",
        "//sys/" + arch + "/conf:generic_opt_cam_header",
        "//sys/contrib/ck:kernel_headers",
        "//sys/vm:kernel_headers",
    ],
) for arch in ["arm64", "riscv"]]

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

# Physical prerequisites for native virtualization built-ins.
bsd_source_headers(name = "virtualization_kernel_virtio_scsi_headers", hdrs = ["virtio_scsi.h", "virtio_scsivar.h"],
    visibility = ["//sys/dev/hyperv:__pkg__", "//sys/dev/hyperv/vmbus:__pkg__", "//sys/dev/virtio:__pkg__", "//sys/dev/virtio/balloon:__pkg__", "//sys/dev/virtio/block:__pkg__", "//sys/dev/virtio/dtrace:__pkg__", "//sys/dev/virtio/network:__pkg__", "//sys/dev/virtio/pci:__pkg__", "//sys/dev/virtio/scsi:__pkg__", "//sys/dev/virtio/vsock:__pkg__", "//sys/dev/xen:__pkg__"])

load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")
load("//tools/build/bazel:kernel_common.bzl", "KERNEL_BUILTIN_WARNING_FLAGS")

# Native amd64 GENERIC virtualization built-ins.
amd64_generic_kernel_objects(name = "generic_virtualization_virtio_scsi", srcs = ["virtio_scsi.c"],
    deps = ["//sys/cam:virtualization_kernel_virtio_scsi_headers", "//sys/dev/mmc:virtualization_kernel_virtio_scsi_headers", "//sys/dev/nvme:virtualization_kernel_virtio_scsi_headers", "//sys/dev/virtio:virtualization_kernel_virtio_headers", "//sys/dev/virtio/scsi:virtualization_kernel_virtio_scsi_headers", "//sys/net:virtualization_kernel_virtio_blk_headers", "//sys/netinet:virtualization_kernel_virtio_blk_headers", "//sys/netinet6:virtualization_kernel_virtio_blk_headers", "//sys/vm:virtualization_kernel_virtio_scsi_headers", "//sys/kern:virtualization_kernel_bus_if_headers", "//sys/kern:virtualization_kernel_device_if_headers", "//sys/amd64/conf:virtualization_kernel_opt_cam_header", "//sys/dev/virtio:virtualization_kernel_virtio_if_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
