    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [])

amd64_generic_module_objects(name = "pca954x_pca954x_module", srcs = ["pca954x.c"],
    deps = ['//sys/dev/iicbus:linuxkpi_kernel_linux_i2c_headers', '//sys/dev/iicbus/mux:i2c_module_context_0', '//sys/kern:bus_if_headers', '//sys/kern:device_if_headers', '//sys/dev/iicbus:iicbus_if_headers', '//sys/dev/iicbus/mux:iicmux_if_headers', '//sys/amd64/conf:generic_opt_platform_header'] + select({"//tools/build/bazel/config:kernel_fdt_enabled": ['//sys/dev/ofw:mii_family_headers', '//sys/dev/ofw:ofw_bus_if_headers', '//sys/vm:core_kernel_tty_headers'], "//conditions:default": []}),
