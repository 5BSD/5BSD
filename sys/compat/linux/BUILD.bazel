# SPDX-License-Identifier: BSD-2-Clause
exports_files([
    "linux.h",
    "linux_file.h",
    "linux_fork.h",
    "linux_time.h",
], visibility = ["//usr.bin/kdump:__pkg__", "//lib/libsysdecode:__pkg__"])

load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(
    name = "sysdecode_headers",
    hdrs = ["linux.h", "linux_errno.h", "linux_file.h", "linux_fork.h", "linux_time.h", "linux_siginfo.h"],
    textual_hdrs = ["linux_errno.inc"],
    strip_include_prefix = ".",
    include_prefix = "compat/linux",
    visibility = ["//usr.bin/kdump:__pkg__", "//lib/libsysdecode:__pkg__", "//sys/amd64/linux:__pkg__"],
)

cc_library(name = "fuse_errno_headers", hdrs = ["linux_errno.h"], textual_hdrs = ["linux_errno.inc"], strip_include_prefix = "/sys",
    visibility = ["//sys/fs/fuse:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

bsd_source_headers(name = "tracing_remaining_headers", hdrs = ["linux.h", "linux_siginfo.h"], visibility = ["//sys/cddl/dev/systrace:__pkg__", "//sys/cddl/contrib/opensolaris:__pkg__", "//sys/cddl/dev/dtrace:__pkg__"])
