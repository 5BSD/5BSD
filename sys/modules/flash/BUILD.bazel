# The source parent has no AMD64 children; ARM64/FDT selects FlexSPI separately.
load("//tools/build/bazel:bsd_kernel_module_installation.bzl", "bsd_kernel_module_set")
bsd_kernel_module_set(name = "amd64_modules",
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
