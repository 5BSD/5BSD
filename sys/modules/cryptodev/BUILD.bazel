load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
amd64_generic_module(module = "cryptodev", objects = ["//sys/opencrypto:generic_cryptodev_module_object_files"])

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")
[cross_generic_module(arch = arch, module = "cryptodev", objects = ["//sys/opencrypto:" + arch + "_generic_cryptodev_module_object_files"], export_all = False)
 for arch in ["arm64", "riscv"]]
