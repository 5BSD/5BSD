load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")
amd64_generic_module(module = "nvme", objects = ["//sys/dev/nvme:ordered_module_objects"], export_all = True)
[cross_generic_module(arch = arch, module = "nvme", objects = ["//sys/dev/nvme:" + arch + "_ordered_module_objects"], export_all = True)
 for arch in ["arm64", "riscv"]]
