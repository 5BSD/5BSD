load("//tools/build/bazel:bsd_kernel_module_installation.bzl", "bsd_kernel_module_set", "bsd_kernel_module_installation")

# AMD64 source traversal, including the parent module where KMOD is defined.
bsd_kernel_module_set(name = "amd64_modules",
    modules = [
        "//sys/modules/sound/driver/envy24:module_product",
        "//sys/modules/sound/driver/envy24ht:module_product",
        "//sys/modules/sound/driver/hda:module_product",
        "//sys/modules/sound/driver/hdsp:module_product",
        "//sys/modules/sound/driver/hdspe:module_product",
        "//sys/modules/sound/driver/spicds:module_product",
        "//sys/modules/sound/driver/driver:module_product",
        "//sys/modules/sound/driver/uaudio:module_product",
        "//sys/modules/sound/driver/dummy:module_product",
    ],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])

bsd_kernel_module_installation(name = "amd64_base_installation", module_sets = [":amd64_modules"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
