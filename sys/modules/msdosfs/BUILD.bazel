load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")
amd64_generic_module(module = "msdosfs", objects = ["//sys/fs/msdosfs:msdosfs_module_object_files"], exports = ["msdosfs_iconv"], export_all = False)
[cross_generic_module(arch = arch, module = "msdosfs", objects = ["//sys/fs/msdosfs:" + arch + "_msdosfs_module_object_files"], exports = ["msdosfs_iconv"], export_all = False)
 for arch in ["arm64", "riscv"]]
