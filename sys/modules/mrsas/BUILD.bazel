load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

amd64_generic_module(module = "mrsas", objects = ["//sys/dev/mrsas:mrsas_mrsas_module_object_files", "//sys/dev/mrsas:mrsas_mrsas_cam_module_object_files", "//sys/dev/mrsas:mrsas_mrsas_ioctl_module_object_files", "//sys/dev/mrsas:mrsas_mrsas_fp_module_object_files"], object_order = ["mrsas.o", "mrsas_cam.o", "mrsas_ioctl.o", "mrsas_fp.o"], export_all = False, package = "kernel")

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "mrsas",
    objects = ["//sys/dev/mrsas:" + arch + "_mrsas_mrsas_module_object_files", "//sys/dev/mrsas:" + arch + "_mrsas_mrsas_cam_module_object_files", "//sys/dev/mrsas:" + arch + "_mrsas_mrsas_ioctl_module_object_files", "//sys/dev/mrsas:" + arch + "_mrsas_mrsas_fp_module_object_files"],
    object_order = ['mrsas.o', 'mrsas_cam.o', 'mrsas_ioctl.o', 'mrsas_fp.o'],
    package = 'kernel',
    export_all = False,
) for arch in ["arm64", "riscv"]]

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_manifest")

bsd_install_manifest(
    name = "arm64_family_install_manifest",
    manifests = [':arm64_install_manifest', '//sys/modules/mrsas/mrsas_linux:arm64_install_manifest'],
    visibility = ["//visibility:public"],
)

bsd_install_manifest(
    name = "riscv_family_install_manifest",
    manifests = [':riscv_install_manifest'],
    visibility = ["//visibility:public"],
)
