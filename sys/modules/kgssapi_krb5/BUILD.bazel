load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")
amd64_generic_module(module = "kgssapi_krb5", objects = ["//sys/kgssapi:kgssapi_krb5_module_object_files"], export_all = False)
[cross_generic_module(arch = arch, module = "kgssapi_krb5", objects = ["//sys/kgssapi:" + arch + "_kgssapi_krb5_module_object_files"], export_all = False)
 for arch in ["arm64", "riscv"]]
