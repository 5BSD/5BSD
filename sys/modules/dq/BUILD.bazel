load("@rules_cc//cc:defs.bzl", "cc_library")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

# sys/modules/dq/Makefile always enables the standalone device, independently
# of whether the selected kernel includes it as a built-in.
write_file(name = "module_opt_dq", out = "module_options/opt_dq.h",
    content = ["#define DEV_DQ 1"])
cc_library(name = "module_opt_dq_header", hdrs = [":module_opt_dq"],
    strip_include_prefix = "module_options", visibility = ["//sys/dev/dq:__pkg__"])

amd64_generic_module(module = "dq", objects = ["//sys/dev/dq:generic_module_object_files"],
    package = "dq")
[cross_generic_module(arch = arch, module = "dq",
    objects = ["//sys/dev/dq:" + arch + "_generic_module_object_files"], package = "dq")
 for arch in ["arm64", "riscv"]]
