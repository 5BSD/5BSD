load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

amd64_generic_module(module = "mfip", objects = ["//sys/dev/mfi:mfip_mfi_cam_module_object_files"], object_order = ["mfi_cam.o"], export_all = False, package = "kernel")

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "mfip",
    objects = ["//sys/dev/mfi:" + arch + "_mfip_mfi_cam_module_object_files"],
    object_order = ['mfi_cam.o'],
    package = 'kernel',
    export_all = False,
) for arch in ["arm64", "riscv"]]
