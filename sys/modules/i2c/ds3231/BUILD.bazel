load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "ds3231", objects = ["//sys/dev/iicbus:ds3231_ds3231_module_object_files"],
    object_order = ["ds3231.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "ds3231",
    objects = ["//sys/dev/iicbus:" + arch + "_ds3231_ds3231_module_object_files"],
    object_order = ['ds3231.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
