load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "ads111x", objects = ["//sys/dev/iicbus:ads111x_ads111x_module_object_files"],
    object_order = ["ads111x.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "ads111x",
    objects = ["//sys/dev/iicbus:" + arch + "_ads111x_ads111x_module_object_files"],
    object_order = ['ads111x.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
