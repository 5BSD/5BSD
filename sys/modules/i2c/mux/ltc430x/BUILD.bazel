load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "ltc430x", objects = ["//sys/dev/iicbus/mux:ltc430x_ltc430x_module_object_files"],
    object_order = ["ltc430x.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "ltc430x",
    objects = ["//sys/dev/iicbus/mux:" + arch + "_ltc430x_ltc430x_module_object_files"],
    object_order = ['ltc430x.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
