load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "iic_gpiomux",
    objects = ["//sys/dev/iicbus/mux:" + arch + "_iic_gpiomux_iic_gpiomux_module_object_files"],
    object_order = ['iic_gpiomux.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
