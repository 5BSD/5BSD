load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "iicmux", objects = ["//sys/dev/iicbus/mux:iicmux_iicmux_module_object_files", "//sys/dev/iicbus/mux:iicmux_iicmux_if_module_object_files"],
    object_order = ["iicmux.o", "iicmux_if.o"], export_all = True)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "iicmux",
    objects = ["//sys/dev/iicbus/mux:" + arch + "_iicmux_iicmux_module_object_files", "//sys/dev/iicbus/mux:" + arch + "_iicmux_iicmux_if_module_object_files"],
    object_order = ['iicmux.o', 'iicmux_if.o'],
    export_all = True,
) for arch in ["arm64", "riscv"]]
