load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "tca64xx",
    objects = ["//sys/dev/iicbus:" + arch + "_tca64xx_tca64xx_module_object_files"],
    object_order = ['tca64xx.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
amd64_generic_module(module = 'tca64xx', object_order = ['tca64xx.o'], export_all = False, objects = ['//sys/dev/iicbus:tca64xx_tca64xx_module_object_files'])
