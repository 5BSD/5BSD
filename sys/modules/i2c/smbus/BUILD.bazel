load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "smbus", objects = ["//sys/dev/smbus:smbus_smbus_if_module_object_files", "//sys/dev/smbus:smbus_smbconf_module_object_files"],
    object_order = ["smbus_if.o", "smbconf.o", "smbus.o"], export_all = True)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "smbus",
    objects = ["//sys/dev/smbus:" + arch + "_smbus_smbus_if_module_object_files", "//sys/dev/smbus:" + arch + "_smbus_smbconf_module_object_files"],
    object_order = ['smbus_if.o', 'smbconf.o', 'smbus.o'],
    export_all = True,
) for arch in ["arm64", "riscv"]]
