load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "tmp461",
    objects = ["//sys/dev/iicbus:" + arch + "_tmp461_tmp461_module_object_files"],
    object_order = ['tmp461.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
amd64_generic_module(module = 'tmp461', object_order = ['tmp461.o'], export_all = False, objects = ['//sys/dev/iicbus:tmp461_tmp461_module_object_files'])
