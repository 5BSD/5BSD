load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "ichsmb", objects = ["//sys/dev/ichsmb:ichsmb_ichsmb_module_object_files", "//sys/dev/ichsmb:ichsmb_ichsmb_pci_module_object_files"],
    object_order = ["ichsmb.o", "ichsmb_pci.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "ichsmb",
    objects = ["//sys/dev/ichsmb:" + arch + "_ichsmb_ichsmb_module_object_files", "//sys/dev/ichsmb:" + arch + "_ichsmb_ichsmb_pci_module_object_files"],
    object_order = ['ichsmb.o', 'ichsmb_pci.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
