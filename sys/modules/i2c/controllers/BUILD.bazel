load("//tools/build/bazel:bsd_kernel_module_installation.bzl", "bsd_kernel_module_set", "bsd_kernel_module_installation")

# AMD64 source traversal, including the parent module where KMOD is defined.
bsd_kernel_module_set(name = "amd64_modules",
    modules = [
        "//sys/modules/i2c/controllers/alpm:module_product",
        "//sys/modules/i2c/controllers/amdpm:module_product",
        "//sys/modules/i2c/controllers/amdsmb:module_product",
        "//sys/modules/i2c/controllers/ichiic:module_product",
        "//sys/modules/i2c/controllers/ichsmb:module_product",
        "//sys/modules/i2c/controllers/intpm:module_product",
        "//sys/modules/i2c/controllers/ismt:module_product",
        "//sys/modules/i2c/controllers/nfsmb:module_product",
        "//sys/modules/i2c/controllers/viapm:module_product",
        "//sys/modules/i2c/controllers/pcf:module_product",
        "//sys/modules/i2c/controllers/imcsmb:module_product",
    ],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])

bsd_kernel_module_installation(name = "amd64_base_installation", module_sets = [":amd64_modules"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
