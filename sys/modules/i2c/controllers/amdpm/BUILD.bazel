load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "amdpm", objects = ["//sys/dev/amdpm:amdpm_amdpm_module_object_files"],
    object_order = ["amdpm.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "amdpm",
    objects = ["//sys/dev/amdpm:" + arch + "_amdpm_amdpm_module_object_files"],
    object_order = ['amdpm.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
