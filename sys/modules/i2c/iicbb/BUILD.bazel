load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "iicbb", objects = ["//sys/dev/iicbus:iicbb_iicbb_if_module_object_files", "//sys/dev/iicbus:iicbb_iicbb_module_object_files"],
    object_order = ["iicbb_if.o", "iicbb.o"], export_all = True)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "iicbb",
    objects = ["//sys/dev/iicbus:" + arch + "_iicbb_iicbb_if_module_object_files", "//sys/dev/iicbus:" + arch + "_iicbb_iicbb_module_object_files"],
    object_order = ['iicbb_if.o', 'iicbb.o'],
    export_all = True,
) for arch in ["arm64", "riscv"]]
