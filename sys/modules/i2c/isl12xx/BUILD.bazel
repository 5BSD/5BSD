load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "isl12xx", objects = ["//sys/dev/iicbus:isl12xx_isl12xx_module_object_files"],
    object_order = ["isl12xx.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "isl12xx",
    objects = ["//sys/dev/iicbus:" + arch + "_isl12xx_isl12xx_module_object_files"],
    object_order = ['isl12xx.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
