load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "ds1307", objects = ["//sys/dev/iicbus:ds1307_ds1307_module_object_files"],
    object_order = ["ds1307.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "ds1307",
    objects = ["//sys/dev/iicbus:" + arch + "_ds1307_ds1307_module_object_files"],
    object_order = ['ds1307.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
