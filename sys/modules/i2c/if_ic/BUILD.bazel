load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "if_ic", objects = ["//sys/dev/iicbus:if_ic_if_ic_module_object_files"],
    object_order = ["if_ic.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "if_ic",
    objects = ["//sys/dev/iicbus:" + arch + "_if_ic_if_ic_module_object_files"],
    object_order = ['if_ic.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
