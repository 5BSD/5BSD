load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "rv3032",
    objects = ["//sys/dev/iicbus:" + arch + "_rv3032_rv3032_module_object_files"],
    object_order = ['rv3032.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
