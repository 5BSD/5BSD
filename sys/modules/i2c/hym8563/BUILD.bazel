load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "hym8563",
    objects = ["//sys/dev/iicbus:" + arch + "_hym8563_hym8563_module_object_files"],
    object_order = ['hym8563.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
amd64_generic_module(module = 'hym8563', object_order = ['hym8563.o'], export_all = False, objects = ['//sys/dev/iicbus:hym8563_hym8563_module_object_files'])
