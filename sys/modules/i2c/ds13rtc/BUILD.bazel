load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "ds13rtc", objects = ["//sys/dev/iicbus:ds13rtc_ds13rtc_module_object_files"],
    object_order = ["ds13rtc.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "ds13rtc",
    objects = ["//sys/dev/iicbus:" + arch + "_ds13rtc_ds13rtc_module_object_files"],
    object_order = ['ds13rtc.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
