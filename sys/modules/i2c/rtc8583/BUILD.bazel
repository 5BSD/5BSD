load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "rtc8583", objects = ["//sys/dev/iicbus:rtc8583_rtc8583_module_object_files"],
    object_order = ["rtc8583.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "rtc8583",
    objects = ["//sys/dev/iicbus:" + arch + "_rtc8583_rtc8583_module_object_files"],
    object_order = ['rtc8583.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
