load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")
amd64_generic_module(module = "nvd", objects = ["//sys/dev/nvd:ordered_module_objects"], export_all = False)
[cross_generic_module(arch = arch, module = "nvd", objects = ["//sys/dev/nvd:" + arch + "_ordered_module_objects"], export_all = False)
 for arch in ["arm64", "riscv"]]
