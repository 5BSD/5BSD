load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")
amd64_generic_module(module = "mqueuefs", objects = ["//sys/kern:ipc_mqueuefs_module_object_files"], exports = ["kern_kmq_notify", "kern_kmq_open", "kern_kmq_setattr", "kern_kmq_timedreceive", "kern_kmq_timedsend", "sys_kmq_unlink"], export_all = False)
[cross_generic_module(arch = arch, module = "mqueuefs", objects = ["//sys/kern:" + arch + "_ipc_mqueuefs_module_object_files"], exports = ["kern_kmq_notify", "kern_kmq_open", "kern_kmq_setattr", "kern_kmq_timedreceive", "kern_kmq_timedsend", "sys_kmq_unlink"], export_all = False)
 for arch in ["arm64", "riscv"]]
