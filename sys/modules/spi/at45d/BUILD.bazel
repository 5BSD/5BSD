load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "at45d", objects = ["//sys/dev/flash:at45d_at45d_module_object_files"],
    object_order = ["at45d.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "at45d",
    objects = ["//sys/dev/flash:" + arch + "_at45d_at45d_module_object_files"],
    object_order = ['at45d.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
