load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")
amd64_generic_module(module = "nfslockd", objects = ["//sys/nlm:nfslockd_module_object_files"], export_all = False)
[cross_generic_module(arch = arch, module = "nfslockd", objects = ["//sys/nlm:" + arch + "_nfslockd_module_object_files"], export_all = False)
 for arch in ["arm64", "riscv"]]
