load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "spigen", objects = ["//sys/dev/spibus:spigen_spigen_module_object_files"],
    object_order = ["spigen.o"], export_all = True)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "spigen",
    objects = ["//sys/dev/spibus:" + arch + "_spigen_spigen_module_object_files"],
    object_order = ['spigen.o'],
    export_all = True,
) for arch in ["arm64", "riscv"]]
