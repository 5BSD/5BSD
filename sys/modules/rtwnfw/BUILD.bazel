load("//tools/build/bazel:bsd_kernel_module_installation.bzl", "bsd_kernel_module_set", "bsd_kernel_module_installation")

# Source-owned unconditional SUBDIR traversal; no runtime Make queries.
bsd_kernel_module_set(name = "amd64_modules",
    modules = [
        "//sys/modules/rtwnfw/rtwnrtl8188eu:module_product",
        "//sys/modules/rtwnfw/rtwnrtl8192cT:module_product",
        "//sys/modules/rtwnfw/rtwnrtl8192cU:module_product",
        "//sys/modules/rtwnfw/rtwnrtl8192eu:module_product",
        "//sys/modules/rtwnfw/rtwnrtl8812au:module_product",
        "//sys/modules/rtwnfw/rtwnrtl8821au:module_product",
        "//sys/modules/rtwnfw/rtwnrtl8192cE:module_product",
        "//sys/modules/rtwnfw/rtwnrtl8192cEB:module_product",
        "//sys/modules/rtwnfw/rtwnrtl8188ee:module_product",
        "//sys/modules/rtwnfw/rtwnrtl8723bu:module_product",
    ],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])

bsd_kernel_module_installation(name = "amd64_base_installation", module_sets = [":amd64_modules"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
