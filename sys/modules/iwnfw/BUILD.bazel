load("//tools/build/bazel:bsd_kernel_module_installation.bzl", "bsd_kernel_module_set", "bsd_kernel_module_installation")

# Source-owned unconditional SUBDIR traversal; no runtime Make queries.
bsd_kernel_module_set(name = "amd64_modules",
    modules = [
        "//sys/modules/iwnfw/iwn100:module_product",
        "//sys/modules/iwnfw/iwn105:module_product",
        "//sys/modules/iwnfw/iwn135:module_product",
        "//sys/modules/iwnfw/iwn1000:module_product",
        "//sys/modules/iwnfw/iwn2000:module_product",
        "//sys/modules/iwnfw/iwn2030:module_product",
        "//sys/modules/iwnfw/iwn4965:module_product",
        "//sys/modules/iwnfw/iwn5000:module_product",
        "//sys/modules/iwnfw/iwn5150:module_product",
        "//sys/modules/iwnfw/iwn6000:module_product",
        "//sys/modules/iwnfw/iwn6000g2a:module_product",
        "//sys/modules/iwnfw/iwn6000g2b:module_product",
        "//sys/modules/iwnfw/iwn6050:module_product",
    ],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])

bsd_kernel_module_installation(name = "amd64_base_installation", module_sets = [":amd64_modules"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
