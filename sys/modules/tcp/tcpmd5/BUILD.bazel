load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

amd64_generic_module(module = "tcpmd5", objects = ["//sys/netipsec:tcpmd5_xform_tcp_module_object_files"], object_order = ["xform_tcp.o"], export_all = False, package = "kernel")

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "tcpmd5",
    objects = ["//sys/netipsec:" + arch + "_tcpmd5_xform_tcp_module_object_files"],
    object_order = ['xform_tcp.o'],
    package = 'kernel',
    export_all = False,
) for arch in ["arm64", "riscv"]]
