    module = "tcp_bbr",
    objects = ["//sys/netinet:" + arch + "_tcp_bbr_bbr_module_object_files", "//sys/netinet:" + arch + "_tcp_bbr_sack_filter_module_object_files", "//sys/netinet:" + arch + "_tcp_bbr_rack_bbr_common_module_object_files"],
