load("//tools/build/bazel:bsd_kernel_module_installation.bzl", "bsd_kernel_module_set", "bsd_kernel_module_installation")

bsd_kernel_module_set(name = "amd64_modules", modules = select({
    "//tools/build/bazel/config:ip_enabled": ["//sys/modules/tcp/hpts:module_product", "//sys/modules/tcp/bbr:module_product", "//sys/modules/tcp/rack:module_product"],
    "//conditions:default": [],
}) + select({"//tools/build/bazel/config:tcp_md5_module_enabled": ["//sys/modules/tcp/tcpmd5:module_product"], "//conditions:default": []}),
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
bsd_kernel_module_installation(name = "amd64_base_installation", module_sets = [":amd64_modules"],
    allow_empty = select({"//tools/build/bazel/config:ip_enabled": False, "//conditions:default": True}),
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
