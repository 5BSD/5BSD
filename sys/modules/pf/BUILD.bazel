load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")
amd64_generic_module(module = "pf", objects = ["//sys/netpfil/openbsd-pf:" + segment + "_objects" for segment in ["vendor_before_radix", "radix", "vendor_after_radix", "glue"]])
[cross_generic_module(arch = arch, module = "pf", objects = ["//sys/netpfil/openbsd-pf:" + arch + "_" + segment + "_objects" for segment in ["vendor_before_radix", "radix", "vendor_after_radix", "glue"]])
 for arch in ["arm64", "riscv"]]
