load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
amd64_generic_module(module = "mac_test_hooks", objects = ["//sys/security/mac_test_hooks:generic_module_object_files"], package = "tests")

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "mac_test_hooks",
    objects = ["//sys/security/mac_test_hooks:" + arch + "_generic_module_object_files"],
    package = "tests",
) for arch in ["arm64", "riscv"]]
