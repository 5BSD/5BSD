load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")
amd64_generic_module(module = "wlan_ccmp", objects = ["//sys/net80211:wlan_ccmp_module_object_files"] + ["//sys/crypto/rijndael:wlan_module_object_files"], export_all = False)
[cross_generic_module(arch = arch, module = "wlan_ccmp", objects = ["//sys/net80211:" + arch + "_wlan_ccmp_module_object_files"] + ["//sys/crypto/rijndael:" + arch + "_wlan_module_object_files"], export_all = False)
 for arch in ["arm64", "riscv"]]
