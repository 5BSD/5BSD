load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
amd64_generic_module(module = "mac_test", objects = ["//sys/security/mac_test:generic_module_object_files"], package = "kernel")

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "mac_test",
    objects = ["//sys/security/mac_test:" + arch + "_generic_module_object_files"],
    package = "kernel",
) for arch in ["arm64", "riscv"]]
