load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

amd64_generic_module(module = "virtio_iommu", objects = ["//sys/dev/virtio/iommu:generic_module_object_files"])

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "virtio_iommu",
    objects = ["//sys/dev/virtio/iommu:" + arch + "_generic_module_object_files"],
) for arch in ["arm64", "riscv"]]
