load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

amd64_generic_module(module = "virtio_pci",
    objects = ['//sys/dev/virtio/pci:generic_driver_object_files', '//sys/dev/virtio/pci:generic_interface_object_files'],
    exports = ["virtio_pci_get_shmem_region"])

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "virtio_pci",
    objects = ["//sys/dev/virtio/pci:" + arch + "_generic_driver_object_files", "//sys/dev/virtio/pci:" + arch + "_generic_interface_object_files"],
    exports = ["virtio_pci_get_shmem_region"],
) for arch in ["arm64", "riscv"]]
