load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

amd64_generic_module(module = "virtio_p9fs", objects = ["//sys/dev/virtio/p9fs:generic_module_object_files"])

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "virtio_p9fs",
    objects = ["//sys/dev/virtio/p9fs:" + arch + "_generic_module_object_files"],
) for arch in ["arm64", "riscv"]]
