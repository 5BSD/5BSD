load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module", "amd64_generic_module_objects")

amd64_generic_module_objects(srcs = ["//sys/geom:part/g_part_bsd.c", "//sys/geom:geom_bsd_enc.c"], deps = ["//sys/geom:partition_interface_headers"])
amd64_generic_module(module = "geom_part_bsd", objects = [":generic_module_object_files"])

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module", "cross_generic_module_objects")

[cross_generic_module_objects(
    arch = arch,
    srcs = ["//sys/geom:part/g_part_bsd.c", "//sys/geom:geom_bsd_enc.c"],
    deps = ["//sys/geom:partition_interface_headers"],
) for arch in ["arm64", "riscv"]]

[cross_generic_module(
    arch = arch,
    module = "geom_part_bsd",
    objects = [":" + arch + "_generic_module_object_files"],
) for arch in ["arm64", "riscv"]]
