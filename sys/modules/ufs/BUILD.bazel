load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")
amd64_generic_module(module = "ufs", objects = ["//sys/ufs/ufs:ufs_module_object_files"], exports = [], export_all = True)
[cross_generic_module(arch = arch, module = "ufs", objects = ["//sys/ufs/ufs:" + arch + "_ufs_module_object_files"], exports = [], export_all = True)
 for arch in ["arm64", "riscv"]]
