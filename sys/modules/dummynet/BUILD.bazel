load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")
amd64_generic_module(module = "dummynet", objects = ["//sys/netpfil/dummynet:generic_module_object_files"])
[cross_generic_module(arch = arch, module = "dummynet", objects = ["//sys/netpfil/dummynet:" + arch + "_generic_module_object_files"])
 for arch in ["arm64", "riscv"]]
