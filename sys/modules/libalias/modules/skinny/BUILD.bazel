load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

amd64_generic_module(module = "alias_skinny", objects = ["//sys/netinet/libalias:alias_skinny_alias_skinny_module_object_files"], object_order = ["alias_skinny.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "alias_skinny",
    objects = ["//sys/netinet/libalias:" + arch + "_alias_skinny_alias_skinny_module_object_files"],
    object_order = ['alias_skinny.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
