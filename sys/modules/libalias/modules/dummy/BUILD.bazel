load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

amd64_generic_module(module = "alias_dummy", objects = ["//sys/netinet/libalias:alias_dummy_alias_dummy_module_object_files"], object_order = ["alias_dummy.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "alias_dummy",
    objects = ["//sys/netinet/libalias:" + arch + "_alias_dummy_alias_dummy_module_object_files"],
    object_order = ['alias_dummy.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
