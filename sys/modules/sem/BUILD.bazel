load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")
amd64_generic_module(module = "sem", objects = ["//sys/kern:ipc_sem_module_object_files"], exports = [], export_all = False)
[cross_generic_module(arch = arch, module = "sem", objects = ["//sys/kern:" + arch + "_ipc_sem_module_object_files"], exports = [], export_all = False)
 for arch in ["arm64", "riscv"]]
