load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")
amd64_generic_module(module = "tarfs", objects = ["//sys/fs/tarfs:tarfs_module_object_files"], exports = [], export_all = False)
[cross_generic_module(arch = arch, module = "tarfs", objects = ["//sys/fs/tarfs:" + arch + "_tarfs_module_object_files"], exports = [], export_all = False)
 for arch in ["arm64", "riscv"]]
