load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "ehci", objects = ["//sys/dev/usb/controller:ehci_ehci_pci_module_object_files", "//sys/dev/usb/controller:ehci_ehci_module_object_files"],
    object_order = ["ehci_pci.o", "ehci.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "ehci",
    objects = ["//sys/dev/usb/controller:" + arch + "_ehci_ehci_pci_module_object_files", "//sys/dev/usb/controller:" + arch + "_ehci_ehci_module_object_files"],
    object_order = ['ehci_pci.o', 'ehci.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
