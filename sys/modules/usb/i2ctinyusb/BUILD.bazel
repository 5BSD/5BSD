load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "i2ctinyusb", objects = ["//sys/dev/usb:i2ctinyusb_i2ctinyusb_module_object_files"],
    object_order = ["i2ctinyusb.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "i2ctinyusb",
    objects = ["//sys/dev/usb:" + arch + "_i2ctinyusb_i2ctinyusb_module_object_files"],
    object_order = ['i2ctinyusb.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
