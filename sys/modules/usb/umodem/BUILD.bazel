load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "umodem", objects = ["//sys/dev/usb:umodem_umodem_module_object_files"],
    object_order = ["umodem.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "umodem",
    objects = ["//sys/dev/usb:" + arch + "_umodem_umodem_module_object_files"],
    object_order = ['umodem.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
