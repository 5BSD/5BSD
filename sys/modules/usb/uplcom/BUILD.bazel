load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "uplcom", objects = ["//sys/dev/usb:uplcom_uplcom_module_object_files"],
    object_order = ["uplcom.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "uplcom",
    objects = ["//sys/dev/usb:" + arch + "_uplcom_uplcom_module_object_files"],
    object_order = ['uplcom.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
