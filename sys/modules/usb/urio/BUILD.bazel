load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "urio", objects = ["//sys/dev/usb:urio_urio_module_object_files"],
    object_order = ["urio.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "urio",
    objects = ["//sys/dev/usb:" + arch + "_urio_urio_module_object_files"],
    object_order = ['urio.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
