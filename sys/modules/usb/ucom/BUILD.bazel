load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "ucom", objects = ["//sys/dev/usb:ucom_usb_serial_module_object_files"],
    object_order = ["usb_serial.o"], export_all = True)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "ucom",
    objects = ["//sys/dev/usb:" + arch + "_ucom_usb_serial_module_object_files"],
    object_order = ['usb_serial.o'],
    export_all = True,
) for arch in ["arm64", "riscv"]]
