load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "xhci", objects = ["//sys/dev/usb/controller:xhci_xhci_pci_module_object_files", "//sys/dev/usb/controller:xhci_xhci_module_object_files"],
    object_order = ["xhci_pci.o", "xhci.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "xhci",
    objects = ["//sys/dev/usb/controller:" + arch + "_xhci_xhci_pci_module_object_files", "//sys/dev/usb/controller:" + arch + "_xhci_xhci_module_object_files"],
    object_order = ['xhci_pci.o', 'xhci.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
