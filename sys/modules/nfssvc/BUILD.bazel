load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")
amd64_generic_module(module = "nfssvc", objects = ["//sys/nfs:nfssvc_module_object_files"], export_all = True)
[cross_generic_module(arch = arch, module = "nfssvc", objects = ["//sys/nfs:" + arch + "_nfssvc_module_object_files"], export_all = True)
 for arch in ["arm64", "riscv"]]
