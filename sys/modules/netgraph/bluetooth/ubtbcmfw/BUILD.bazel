load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")
amd64_generic_module(module = "ubtbcmfw", objects = ["//sys/netgraph/bluetooth:ubtbcmfw_module_object_files"], export_all = False)
[cross_generic_module(arch = arch, module = "ubtbcmfw", objects = ["//sys/netgraph/bluetooth:" + arch + "_ubtbcmfw_module_object_files"], export_all = False)
 for arch in ["arm64", "riscv"]]
