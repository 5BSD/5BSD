load("//tools/build/bazel:bsd_kernel_module_installation.bzl", "bsd_kernel_module_set", "bsd_kernel_module_installation")

# Source-owned unconditional SUBDIR traversal; no runtime Make queries.
bsd_kernel_module_set(name = "amd64_modules",
    modules = [
        "//sys/modules/netgraph/bluetooth/bluetooth:module_product",
        "//sys/modules/netgraph/bluetooth/hci:module_product",
        "//sys/modules/netgraph/bluetooth/l2cap:module_product",
        "//sys/modules/netgraph/bluetooth/socket:module_product",
        "//sys/modules/netgraph/bluetooth/ubt:module_product",
        "//sys/modules/netgraph/bluetooth/ubtbcmfw:module_product",
        "//sys/modules/netgraph/bluetooth/vhci:module_product",
    ],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])

bsd_kernel_module_installation(name = "amd64_base_installation", module_sets = [":amd64_modules"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
