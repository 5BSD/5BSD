load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")
amd64_generic_module(module = "ng_bpf", objects = ["//sys/netgraph:ng_bpf_module_object_files"], export_all = False)
[cross_generic_module(arch = arch, module = "ng_bpf", objects = ["//sys/netgraph:" + arch + "_ng_bpf_module_object_files"], export_all = False)
 for arch in ["arm64", "riscv"]]
