load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "gpiokeys",
    objects = ["//sys/dev/gpio:" + arch + "_gpiokeys_gpiokeys_module_object_files", "//sys/dev/gpio:" + arch + "_gpiokeys_gpiokeys_codes_module_object_files"],
    object_order = ['gpiokeys.o', 'gpiokeys_codes.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
amd64_generic_module(module = 'gpiokeys', object_order = ['gpiokeys.o', 'gpiokeys_codes.o'], export_all = False, objects = ['//sys/dev/gpio:gpiokeys_gpiokeys_module_object_files', '//sys/dev/gpio:gpiokeys_gpiokeys_codes_module_object_files'])
