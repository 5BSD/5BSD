load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "gpiospi", objects = ["//sys/dev/gpio:gpiospi_gpiospi_module_object_files"],
    object_order = ["gpiospi.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "gpiospi",
    objects = ["//sys/dev/gpio:" + arch + "_gpiospi_gpiospi_module_object_files"],
    object_order = ['gpiospi.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
