load("//tools/build/bazel:bsd_kernel_module_installation.bzl", "bsd_kernel_module_set", "bsd_kernel_module_installation")
bsd_kernel_module_set(name = "amd64_modules",
    modules = ['//sys/modules/gpio/gpiobus:module_product', '//sys/modules/gpio/gpioiic:module_product', '//sys/modules/gpio/gpioled:module_product', '//sys/modules/gpio/gpiospi:module_product', '//sys/modules/gpio/gpioths:module_product'] + select({"//tools/build/bazel/config:kernel_fdt_enabled": ['//sys/modules/gpio/gpiokeys:module_product', '//sys/modules/gpio/gpiopps:module_product'], "//conditions:default": []}) + ['//sys/modules/gpio/gpioaei:module_product'],
    module_sets = [],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
bsd_kernel_module_installation(name = "amd64_base_installation", module_sets = [":amd64_modules"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])

filegroup(name = "amd64_inventory", srcs = [":amd64_modules"], output_group = "inventory", visibility = ["//visibility:public"])
