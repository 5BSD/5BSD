load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "gpioled", objects = select({"//tools/build/bazel/config:kernel_fdt_enabled": ['//sys/dev/gpio:gpioled_gpioled_fdt_module_object_files'], "//conditions:default": ['//sys/dev/gpio:gpioled_gpioled_module_object_files']}),
    object_order = select({"//tools/build/bazel/config:kernel_fdt_enabled": ['gpioled_fdt.o'], "//conditions:default": ['gpioled.o']}), export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "gpioled",
    objects = ["//sys/dev/gpio:" + arch + "_gpioled_gpioled_fdt_module_object_files"],
    object_order = ['gpioled_fdt.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]

filegroup(name = "link_recipe", srcs = [":generic_link"], output_group = "metadata", visibility = ["//tools/build/bazel:__pkg__"])
