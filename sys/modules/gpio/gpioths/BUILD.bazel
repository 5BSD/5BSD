load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "gpioths", objects = ["//sys/dev/gpio:gpioths_gpioths_module_object_files"],
    object_order = ["gpioths.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "gpioths",
    objects = ["//sys/dev/gpio:" + arch + "_gpioths_gpioths_module_object_files"],
    object_order = ['gpioths.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
