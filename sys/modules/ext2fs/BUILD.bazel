load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")
amd64_generic_module(module = "ext2fs", objects = ["//sys/fs/ext2fs:ext2fs_module_object_files"], exports = [], export_all = False)
[cross_generic_module(arch = arch, module = "ext2fs", objects = ["//sys/fs/ext2fs:" + arch + "_ext2fs_module_object_files"], exports = [], export_all = False)
 for arch in ["arm64", "riscv"]]
