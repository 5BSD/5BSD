load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")
amd64_generic_module(module = "sysvmsg", objects = ["//sys/kern:ipc_sysvmsg_module_object_files"], exports = [], export_all = True)
[cross_generic_module(arch = arch, module = "sysvmsg", objects = ["//sys/kern:" + arch + "_ipc_sysvmsg_module_object_files"], exports = [], export_all = True)
 for arch in ["arm64", "riscv"]]
