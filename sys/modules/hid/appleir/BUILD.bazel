load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "appleir", objects = ["//sys/dev/hid:appleir_appleir_module_object_files"],
    object_order = ["appleir.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "appleir",
    objects = ["//sys/dev/hid:" + arch + "_appleir_appleir_module_object_files"],
    object_order = ['appleir.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
