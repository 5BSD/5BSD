load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "bcm5974", objects = ["//sys/dev/hid:bcm5974_bcm5974_module_object_files"],
    object_order = ["bcm5974.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "bcm5974",
    objects = ["//sys/dev/hid:" + arch + "_bcm5974_bcm5974_module_object_files"],
    object_order = ['bcm5974.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
