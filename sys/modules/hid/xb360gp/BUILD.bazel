load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "xb360gp", objects = ["//sys/dev/hid:xb360gp_xb360gp_module_object_files"],
    object_order = ["xb360gp.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "xb360gp",
    objects = ["//sys/dev/hid:" + arch + "_xb360gp_xb360gp_module_object_files"],
    object_order = ['xb360gp.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
