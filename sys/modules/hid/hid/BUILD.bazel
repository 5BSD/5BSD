load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "hid", objects = ["//sys/dev/hid:hid_hid_module_object_files", "//sys/dev/hid:hid_hid_if_module_object_files"],
    object_order = ["hid.o", "hid_if.o"], export_all = True)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "hid",
    objects = ["//sys/dev/hid:" + arch + "_hid_hid_module_object_files", "//sys/dev/hid:" + arch + "_hid_hid_if_module_object_files"],
    object_order = ['hid.o', 'hid_if.o'],
    export_all = True,
) for arch in ["arm64", "riscv"]]
