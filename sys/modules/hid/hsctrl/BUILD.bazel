load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "hsctrl", objects = ["//sys/dev/hid:hsctrl_hsctrl_module_object_files"],
    object_order = ["hsctrl.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "hsctrl",
    objects = ["//sys/dev/hid:" + arch + "_hsctrl_hsctrl_module_object_files"],
    object_order = ['hsctrl.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
