load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

# Original export policy and complete link order.
amd64_generic_module(module = "hkbd", objects = ["//sys/dev/hid:hkbd_hkbd_module_object_files"],
    object_order = ["hkbd.o"], export_all = False)

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "hkbd",
    objects = ["//sys/dev/hid:" + arch + "_hkbd_hkbd_module_object_files"],
    object_order = ['hkbd.o'],
    export_all = False,
) for arch in ["arm64", "riscv"]]
