load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")
amd64_generic_module(module = "nfscl", objects = ["//sys/fs/nfsclient:nfscl_module_object_files"] + select({"//tools/build/bazel/config:kernel_nfs_root_enabled": ["//sys/fs/nfsclient:nfs_diskless_module_object_files"], "//conditions:default": []}), export_all = False)
[cross_generic_module(arch = arch, module = "nfscl", objects = ["//sys/fs/nfsclient:" + arch + "_nfscl_module_object_files"] + select({"//tools/build/bazel/config:kernel_nfs_root_enabled": ["//sys/fs/nfsclient:" + arch + "_nfs_diskless_module_object_files"], "//conditions:default": []}), export_all = False)
 for arch in ["arm64", "riscv"]]
