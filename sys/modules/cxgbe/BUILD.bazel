load("//tools/build/bazel:bsd_kernel_module_installation.bzl", "bsd_kernel_module_set", "bsd_kernel_module_installation")

# AMD64 source traversal, including the parent module where KMOD is defined.
bsd_kernel_module_set(name = "amd64_modules",
    modules = [
        "//sys/modules/cxgbe/if_cxgbe:module_product",
        "//sys/modules/cxgbe/if_cxl:module_product",
        "//sys/modules/cxgbe/if_cc:module_product",
        "//sys/modules/cxgbe/if_cxgbev:module_product",
        "//sys/modules/cxgbe/if_cxlv:module_product",
        "//sys/modules/cxgbe/if_ccv:module_product",
        "//sys/modules/cxgbe/t4_firmware:module_product",
        "//sys/modules/cxgbe/t5_firmware:module_product",
        "//sys/modules/cxgbe/t6_firmware:module_product",
        "//sys/modules/cxgbe/t7_firmware:module_product",
        "//sys/modules/cxgbe/tom:module_product",
    ] + select({
        "//tools/build/bazel/config:ofed_enabled": [
            "//sys/modules/cxgbe/iw_cxgbe:module_product",
        ],
        "//conditions:default": [],
    }) + [
        "//sys/modules/cxgbe/cxgbei:module_product",
        "//sys/modules/cxgbe/ccr:module_product",
        "//sys/modules/cxgbe/nvmf_che:module_product",
    ],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])

bsd_kernel_module_installation(name = "amd64_base_installation", module_sets = [":amd64_modules"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
