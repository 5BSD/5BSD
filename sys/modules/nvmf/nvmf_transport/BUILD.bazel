load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

amd64_generic_module(module = "nvmf_transport", objects = ["//sys/dev/nvmf:nvmf_transport_nvmf_transport_module_object_files"], object_order = ["nvmf_transport.o"], export_all = True, package = "kernel")

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "nvmf_transport",
    objects = ["//sys/dev/nvmf:" + arch + "_nvmf_transport_nvmf_transport_module_object_files"],
    object_order = ['nvmf_transport.o'],
    package = 'kernel',
    export_all = True,
