load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")

amd64_generic_module(module = "nvmf_tcp", objects = ["//sys/dev/nvmf:nvmf_tcp_nvmf_tcp_module_object_files"], object_order = ["nvmf_tcp.o"], export_all = False, package = "kernel")

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")

[cross_generic_module(
    arch = arch,
    module = "nvmf_tcp",
    objects = ["//sys/dev/nvmf:" + arch + "_nvmf_tcp_nvmf_tcp_module_object_files"],
    object_order = ['nvmf_tcp.o'],
    package = 'kernel',
    export_all = False,
) for arch in ["arm64", "riscv"]]
