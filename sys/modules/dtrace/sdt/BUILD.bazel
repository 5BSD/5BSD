load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")
amd64_generic_module(module = "sdt", objects = ["//sys/cddl/dev/sdt:sdt_module_object_files"], exports = [])
[cross_generic_module(arch = arch, module = "sdt", objects = ["//sys/cddl/dev/sdt:" + arch + "_sdt_module_object_files"], exports = [])
 for arch in ["arm64", "riscv"]]
