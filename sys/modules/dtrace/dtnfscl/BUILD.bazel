load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")
amd64_generic_module(module = "dtnfscl", objects = ["//sys/fs/nfsclient:dtnfscl_module_object_files"], exports = [])
[cross_generic_module(arch = arch, module = "dtnfscl", objects = ["//sys/fs/nfsclient:" + arch + "_dtnfscl_module_object_files"], exports = [])
 for arch in ["arm64", "riscv"]]
