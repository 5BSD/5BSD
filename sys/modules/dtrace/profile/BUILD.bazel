load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")
amd64_generic_module(module = "profile", objects = ["//sys/cddl/dev/profile:profile_module_object_files"], exports = [])
[cross_generic_module(arch = arch, module = "profile", objects = ["//sys/cddl/dev/profile:" + arch + "_profile_module_object_files"], exports = [])
 for arch in ["arm64", "riscv"]]
