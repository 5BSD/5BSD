load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module")
amd64_generic_module(module = "p9fs", objects = ["//sys/fs/p9fs:p9fs_module_object_files"], exports = [], export_all = False)
[cross_generic_module(arch = arch, module = "p9fs", objects = ["//sys/fs/p9fs:" + arch + "_p9fs_module_object_files"], exports = [], export_all = False)
 for arch in ["arm64", "riscv"]]
