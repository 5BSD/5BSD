filegroup(name = "platform_support_kernel_xenbus_if_file", srcs = [":xenbus_if"], output_group = "header")
cc_library(name = "platform_support_kernel_xenbus_if_headers", hdrs = [":platform_support_kernel_xenbus_if_file"], strip_include_prefix = "xenbus_if.generated", visibility = ["//sys/amd64/acpica:__pkg__", "//sys/amd64/pci:__pkg__", "//sys/compat/x86bios:__pkg__", "//sys/contrib/x86emu:__pkg__", "//sys/gdb:__pkg__", "//sys/isa:__pkg__", "//sys/x86/acpica:__pkg__", "//sys/x86/cpufreq:__pkg__", "//sys/x86/iommu:__pkg__", "//sys/x86/isa:__pkg__", "//sys/x86/pci:__pkg__", "//sys/x86/xen:__pkg__", "//sys/xen:__pkg__", "//sys/xen/xenbus:__pkg__"])

