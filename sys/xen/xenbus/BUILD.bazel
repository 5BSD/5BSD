load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = glob(["*_if.m"]))

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

# Physical prerequisites for native virtualization built-ins.
bsd_source_headers(name = "virtualization_kernel_blkfront_headers", hdrs = ["xenbusvar.h"],
    visibility = ["//sys/dev/hyperv:__pkg__", "//sys/dev/hyperv/vmbus:__pkg__", "//sys/dev/virtio:__pkg__", "//sys/dev/virtio/balloon:__pkg__", "//sys/dev/virtio/block:__pkg__", "//sys/dev/virtio/dtrace:__pkg__", "//sys/dev/virtio/network:__pkg__", "//sys/dev/virtio/pci:__pkg__", "//sys/dev/virtio/scsi:__pkg__", "//sys/dev/virtio/vsock:__pkg__", "//sys/dev/xen:__pkg__"])

load("@rules_cc//cc:defs.bzl", "cc_library")

filegroup(name = "virtualization_kernel_xenbus_if_file", srcs = [":xenbus_if"], output_group = "header")
cc_library(name = "virtualization_kernel_xenbus_if_headers", hdrs = [":virtualization_kernel_xenbus_if_file"], strip_include_prefix = "xenbus_if.generated", visibility = ["//sys/dev/hyperv:__pkg__", "//sys/dev/hyperv/vmbus:__pkg__", "//sys/dev/virtio:__pkg__", "//sys/dev/virtio/balloon:__pkg__", "//sys/dev/virtio/block:__pkg__", "//sys/dev/virtio/dtrace:__pkg__", "//sys/dev/virtio/network:__pkg__", "//sys/dev/virtio/pci:__pkg__", "//sys/dev/virtio/scsi:__pkg__", "//sys/dev/virtio/vsock:__pkg__", "//sys/dev/xen:__pkg__"])
