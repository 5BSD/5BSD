load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "kernel_headers", hdrs = ["dinode.h", "extattr.h", "quota.h"], includes = ["../.."],
    deps = [], visibility = ["//visibility:public"])

cc_library(name = "filesystem_module_headers", hdrs = glob(["*.h"]), strip_include_prefix = "/sys",
    visibility = ["//sys/fs:__subpackages__", "//sys/ufs:__subpackages__"])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")
load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")

amd64_generic_module_objects(name = "ufs_module", srcs = ["ufs_acl.c", "ufs_bmap.c", "ufs_dirhash.c", "ufs_extattr.c", "ufs_inode.c", "ufs_lookup.c", "ufs_quota.c", "ufs_vfsops.c", "ufs_vnops.c", "//sys/ufs/ffs:ffs_alloc.c", "//sys/ufs/ffs:ffs_balloc.c", "//sys/ufs/ffs:ffs_inode.c", "//sys/ufs/ffs:ffs_rawread.c", "//sys/ufs/ffs:ffs_snapshot.c", "//sys/ufs/ffs:ffs_softdep.c", "//sys/ufs/ffs:ffs_subr.c", "//sys/ufs/ffs:ffs_suspend.c", "//sys/ufs/ffs:ffs_tables.c", "//sys/ufs/ffs:ffs_vfsops.c", "//sys/ufs/ffs:ffs_vnops.c"],
    deps = ['//sys/ddb:kernel_headers', ":filesystem_module_headers", "//sys/vm:kernel_headers", "//sys/contrib/ck:kernel_headers", "//sys/security/mac:framework_headers", "//sys/security/audit:kernel_headers", "//sys/geom:kernel_headers", "//sys/ufs/ffs:filesystem_module_headers"] + ["//sys/amd64/conf:generic_opt_ddb_header", "//sys/amd64/conf:generic_opt_directio_header", "//sys/amd64/conf:generic_opt_ffs_header", "//sys/amd64/conf:generic_opt_quota_header", "//sys/amd64/conf:generic_opt_suiddir_header", "//sys/amd64/conf:generic_opt_ufs_header"], copts = [])
[cross_generic_module_objects(arch = arch, name = "ufs_module", srcs = ["ufs_acl.c", "ufs_bmap.c", "ufs_dirhash.c", "ufs_extattr.c", "ufs_inode.c", "ufs_lookup.c", "ufs_quota.c", "ufs_vfsops.c", "ufs_vnops.c", "//sys/ufs/ffs:ffs_alloc.c", "//sys/ufs/ffs:ffs_balloc.c", "//sys/ufs/ffs:ffs_inode.c", "//sys/ufs/ffs:ffs_rawread.c", "//sys/ufs/ffs:ffs_snapshot.c", "//sys/ufs/ffs:ffs_softdep.c", "//sys/ufs/ffs:ffs_subr.c", "//sys/ufs/ffs:ffs_suspend.c", "//sys/ufs/ffs:ffs_tables.c", "//sys/ufs/ffs:ffs_vfsops.c", "//sys/ufs/ffs:ffs_vnops.c"],
    deps = ['//sys/ddb:kernel_headers', ":filesystem_module_headers", "//sys/vm:kernel_headers", "//sys/contrib/ck:kernel_headers", "//sys/security/mac:framework_headers", "//sys/security/audit:kernel_headers", "//sys/geom:kernel_headers", "//sys/ufs/ffs:filesystem_module_headers"] + ["//sys/" + arch + "/conf:generic_" + option + "_header" for option in ["opt_ddb", "opt_directio", "opt_ffs", "opt_quota", "opt_suiddir", "opt_ufs"]], copts = [])
 for arch in ["arm64", "riscv"]]
