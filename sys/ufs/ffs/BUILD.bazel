exports_files(["ffs_alloc.c", "ffs_balloc.c", "ffs_inode.c", "ffs_rawread.c", "ffs_snapshot.c", "ffs_softdep.c", "ffs_suspend.c", "ffs_vfsops.c", "ffs_vnops.c"], visibility = ["//sys/ufs/ufs:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

