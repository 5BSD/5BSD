    visibility = ["//sys/dev/xz:__pkg__"])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")

load("//tools/build/bazel:kernel_amd64.bzl", "AMD64_KERNEL_WARNING_FLAGS")

amd64_generic_module_objects(name = "xz_xz_crc32_module", srcs = ["linux/lib/xz/xz_crc32.c", "linux/lib/xz/xz_crc64.c", "linux/lib/xz/xz_dec_bcj.c"],
    deps = [],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = ["XZ_USE_CRC64"], header_overrides = ["//sys/contrib/xz-embedded:system_io_module_context_0"], preinclude_headers = [], textual_hdrs = [])

