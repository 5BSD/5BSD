    deps = [],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = ["XZ_USE_CRC64"], header_overrides = ["//sys/contrib/xz-embedded:system_io_module_context_1"], preinclude_headers = [], textual_hdrs = [])

amd64_generic_module_objects(name = "xz_xz_dec_stream_module", srcs = ["linux/lib/xz/xz_dec_stream.c"],
