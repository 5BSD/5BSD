    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = ["XZ_USE_CRC64"], header_overrides = ["//sys/contrib/xz-embedded:system_io_module_context_2"], preinclude_headers = [], textual_hdrs = [])

