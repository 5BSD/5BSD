bsd_source_headers(name = "standalone_sa_efi_headers", hdrs = ['freebsd/xz_config.h', 'freebsd/xz_malloc.h', 'linux/include/linux/xz.h', 'linux/lib/xz/xz_lzma2.h', 'linux/lib/xz/xz_private.h', 'linux/lib/xz/xz_stream.h'], visibility = ["//stand/libsa:__pkg__"])

