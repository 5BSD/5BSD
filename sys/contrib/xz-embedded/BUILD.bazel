bsd_source_headers(name = "system_io_module_context_0", hdrs = ["freebsd/xz_config.h", "freebsd/xz_malloc.h", "linux/include/linux/xz.h", "linux/lib/xz/xz_private.h"], includes = ["freebsd", "linux/include/linux"],
    visibility = ["//sys/contrib/xz-embedded:__pkg__"])

bsd_source_headers(name = "system_io_module_context_1", hdrs = ["freebsd/xz_config.h", "freebsd/xz_malloc.h", "linux/include/linux/xz.h", "linux/lib/xz/xz_lzma2.h", "linux/lib/xz/xz_private.h"], includes = ["freebsd", "linux/include/linux"],
