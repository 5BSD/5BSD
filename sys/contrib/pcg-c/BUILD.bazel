load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "kernel_headers", hdrs = ["include/pcg_variants.h"], includes = ["../.."], visibility = ["//sys/libkern:__pkg__", "//sys/kern:__pkg__", "//sys/netinet/cc:__pkg__", "//sys/netgraph:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

bsd_source_headers(name = "tracing_core_headers", hdrs = ["include/pcg_variants.h"], includes = [],
    visibility = ["//sys/cddl/dev/dtrace:__pkg__", "//sys/cddl/dev/fbt:__pkg__", "//sys/cddl/dev/kinst:__pkg__", "//sys/modules/dtrace/dtraceall:__pkg__", "//sys/contrib/openzfs:__pkg__"])

bsd_source_headers(name = "opensolaris_module_headers", hdrs = ["include/pcg_variants.h"], visibility = ["//sys/cddl/compat/opensolaris:__pkg__"])

# Core kernel physical prerequisites.
bsd_source_headers(name = "core_kernel_subr_prng_headers", hdrs = ["include/pcg_variants.h"],
    visibility = ["//sys/kern:__pkg__"])

# Native OpenZFS built-in physical prerequisites and compatibility overlay roots.
bsd_source_headers(name = "openzfs_kernel_spl_misc_headers", hdrs = ["include/pcg_variants.h"],
    visibility = ["//sys/contrib/openzfs:__pkg__"])

# Physical prerequisites for native DTrace built-in built-ins.
bsd_source_headers(name = "dtrace_builtins_kernel_dtrace_headers", hdrs = ["include/pcg_variants.h"],
    visibility = ["//sys/cddl/compat/opensolaris:__pkg__", "//sys/cddl/contrib/opensolaris:__pkg__", "//sys/cddl/dev/dtmalloc:__pkg__", "//sys/cddl/dev/dtrace:__pkg__", "//sys/cddl/dev/dtrace/x86:__pkg__", "//sys/cddl/dev/fbt:__pkg__", "//sys/cddl/dev/profile:__pkg__", "//sys/cddl/dev/sdt:__pkg__", "//sys/cddl/dev/systrace:__pkg__"])

# Physical inputs of ARM64/RISC-V GENERIC core built-ins.
bsd_source_headers(name = "cross_core_builtin_headers", hdrs = [
        "include/pcg_variants.h",
    ],
    includes = [], visibility = ["//sys/kern:__pkg__"])

bsd_source_headers(name = "standalone_sa_headers", hdrs = ['include/pcg_variants.h'], visibility = ["//stand/libsa:__pkg__"])

bsd_source_headers(name = "standalone_sa_efi_headers", hdrs = ['include/pcg_variants.h'], visibility = ["//stand/libsa:__pkg__"])
