load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "headers", hdrs = ["fdt.h", "libfdt.h", "libfdt_env.h"],
    strip_include_prefix = ".", visibility = ["//visibility:public"])
exports_files(['fdt.c', 'fdt_addresses.c', 'fdt_empty_tree.c', 'fdt_overlay.c', 'fdt_ro.c', 'fdt_rw.c', 'fdt_strerror.c', 'fdt_sw.c', 'fdt_wip.c', 'libfdt_internal.h'], visibility = ["//lib/libfdt:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

# Physical prerequisites consumed by independent MII-family module builds.
bsd_source_headers(name = "mii_family_headers", hdrs = ["libfdt_env.h"], visibility = ["//sys/dev/mii:__pkg__", "//sys/dev/usb:__pkg__"])

bsd_source_headers(
    name = "usb_net_if_smsc_headers",
    hdrs = [
        "libfdt_env.h"
    ],
    visibility = [
        "//sys/dev/usb/net:__pkg__"
    ],
)

bsd_source_headers(
    name = "usb_net_if_muge_headers",
    hdrs = [
        "libfdt_env.h"
    ],
    visibility = [
        "//sys/dev/usb/net:__pkg__"
    ],
)
