# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(
    name = "headers", hdrs = ["zconf.h", "zlib.h"],
    strip_include_prefix = "/sys/contrib/zlib",
    visibility = ["//visibility:public"],
)
exports_files(['adler32.c', 'compress.c', 'crc32.c', 'deflate.c', 'gzclose.c', 'gzlib.c', 'gzread.c', 'gzwrite.c', 'infback.c', 'inffast.c', 'inflate.c', 'inftrees.c', 'trees.c', 'uncompr.c', 'zutil.c', 'inftrees.h', 'inffast.h', 'crc32.h', 'deflate.h', 'trees.h', 'zutil.h', 'gzguts.h', 'inffixed.h', 'inflate.h', 'test/example.c'], visibility = ["//lib/libz:__pkg__"])

exports_files(["zlib.pc.in", "zlib.3", "zlib.h", "zconf.h"], visibility = ["//lib/libz:__pkg__"])

cc_library(name = "kernel_headers", hdrs = ["zlib.h", "zconf.h", "zutil.h"], includes = ["../.."], visibility = ["//visibility:public"])

# Core kernel physical prerequisites.
load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")
bsd_source_headers(name = "core_kernel_subr_compressor_headers", hdrs = ["zconf.h", "zlib.h", "zutil.h"],
    visibility = ["//sys/kern:__pkg__"])

# OpenCrypto built-in prerequisites.
bsd_source_headers(name = "opencrypto_kernel_cryptodeflate_headers", hdrs = ["zconf.h", "zlib.h"],
    visibility = ["//sys/opencrypto:__pkg__"])

# Native OpenZFS built-in physical prerequisites and compatibility overlay roots.
bsd_source_headers(name = "openzfs_kernel_spl_zlib_headers", hdrs = ["zconf.h", "zlib.h"],
    visibility = ["//sys/contrib/openzfs:__pkg__"])

# Physical prerequisites for native Ethernet built-ins.
bsd_source_headers(name = "ethernet_kernel_bxe_headers", hdrs = ["zconf.h", "zlib.h"],
    visibility = ["//sys/dev/alc:__pkg__", "//sys/dev/ale:__pkg__", "//sys/dev/aq:__pkg__", "//sys/dev/axgbe:__pkg__", "//sys/dev/bce:__pkg__", "//sys/dev/bge:__pkg__", "//sys/dev/bxe:__pkg__", "//sys/dev/et:__pkg__", "//sys/dev/iavf:__pkg__", "//sys/dev/igc:__pkg__", "//sys/dev/ixl:__pkg__", "//sys/dev/jme:__pkg__", "//sys/dev/msk:__pkg__", "//sys/dev/nfe:__pkg__", "//sys/dev/re:__pkg__", "//sys/dev/rge:__pkg__", "//sys/dev/sge:__pkg__"])
