# SPDX-License-Identifier: BSD-2-Clause
# BLAKE2 reference code for userland consumers (bsdextension(8) compares
# module files with pkg's BLAKE2b file checksums).  The kernel builds these
# files through sys/conf/files with sys/crypto/blake2/config.h.
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "headers", hdrs = ["blake2.h", "blake2-impl.h"],
    strip_include_prefix = ".",
    visibility = ["//usr.sbin/BSDExtension:__subpackages__"])
exports_files(["blake2b-ref.c"],
    visibility = ["//usr.sbin/BSDExtension:__subpackages__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

# Physical prerequisites for native codec and crypto built-ins.
bsd_source_headers(name = "codecs_crypto_kernel_blake2b-ref_headers", hdrs = ["blake2-impl.h", "blake2.h"],
    visibility = ["//sys/contrib/ck:__pkg__", "//sys/contrib/libb2:__pkg__", "//sys/contrib/libnv:__pkg__", "//sys/contrib/libsodium:__pkg__", "//sys/contrib/xz-embedded:__pkg__", "//sys/contrib/zlib:__pkg__", "//sys/contrib/zstd:__pkg__", "//sys/crypto:__pkg__", "//sys/crypto/camellia:__pkg__", "//sys/crypto/chacha20:__pkg__", "//sys/crypto/rijndael:__pkg__", "//sys/crypto/siphash:__pkg__", "//sys/crypto/skein:__pkg__", "//sys/dev/random:__pkg__", "//sys/dev/xz:__pkg__", "//sys/dev/zlib:__pkg__"])
bsd_source_headers(name = "codecs_crypto_kernel_blake2-sw_headers", hdrs = ["blake2.h"],
    visibility = ["//sys/contrib/ck:__pkg__", "//sys/contrib/libb2:__pkg__", "//sys/contrib/libnv:__pkg__", "//sys/contrib/libsodium:__pkg__", "//sys/contrib/xz-embedded:__pkg__", "//sys/contrib/zlib:__pkg__", "//sys/contrib/zstd:__pkg__", "//sys/crypto:__pkg__", "//sys/crypto/camellia:__pkg__", "//sys/crypto/chacha20:__pkg__", "//sys/crypto/rijndael:__pkg__", "//sys/crypto/siphash:__pkg__", "//sys/crypto/skein:__pkg__", "//sys/dev/random:__pkg__", "//sys/dev/xz:__pkg__", "//sys/dev/zlib:__pkg__"])

load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")
load("//tools/build/bazel:kernel_common.bzl", "KERNEL_BUILTIN_WARNING_FLAGS")

# Native amd64 GENERIC codec and crypto built-ins.
amd64_generic_kernel_objects(name = "generic_codecs_crypto_blake2b-ref", srcs = ["blake2b-ref.c"],
    deps = ["//sys/contrib/libb2:codecs_crypto_kernel_blake2b-ref_headers", "//sys/crypto:codecs_crypto_kernel_blake2b-ref_headers"], early_deps = [],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS, copts = ["-DSUFFIX=_ref", "-Wno-cast-qual", "-Wno-unused-function"])
amd64_generic_kernel_objects(name = "generic_codecs_crypto_blake2s-ref", srcs = ["blake2s-ref.c"],
    deps = ["//sys/contrib/libb2:codecs_crypto_kernel_blake2b-ref_headers", "//sys/crypto:codecs_crypto_kernel_blake2b-ref_headers"], early_deps = [],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS, copts = ["-DSUFFIX=_ref", "-Wno-cast-qual", "-Wno-unused-function"])

bsd_source_headers(name = "crypto_module_context_0", hdrs = ["blake2-config.h", "blake2-impl.h", "blake2.h", "blake2b-load-sse2.h", "blake2b-round.h", "blake2b.c"], includes = ["."],
    visibility = ["//sys/crypto:__pkg__"])

bsd_source_headers(name = "crypto_module_context_1", hdrs = ["blake2-config.h", "blake2-impl.h", "blake2.h", "blake2b-load-sse41.h", "blake2b-round.h", "blake2b.c"], includes = ["."],
    visibility = ["//sys/crypto:__pkg__"])

bsd_source_headers(name = "crypto_module_context_2", hdrs = ["blake2-config.h", "blake2-impl.h", "blake2.h", "blake2s-load-sse2.h", "blake2s-round.h", "blake2s.c"], includes = ["."],
    visibility = ["//sys/crypto:__pkg__"])

bsd_source_headers(name = "crypto_module_context_3", hdrs = ["blake2-config.h", "blake2-impl.h", "blake2.h", "blake2s-load-sse41.h", "blake2s-round.h", "blake2s.c"], includes = ["."],
    visibility = ["//sys/crypto:__pkg__"])

bsd_source_headers(name = "crypto_module_context_4", hdrs = ["blake2-config.h", "blake2-impl.h", "blake2.h", "blake2s-load-xop.h", "blake2s-round.h", "blake2s.c"], includes = ["."],
    visibility = ["//sys/crypto:__pkg__"])

bsd_source_headers(name = "crypto_module_context_5", hdrs = ["blake2.h"], includes = ["."],
    visibility = ["//sys/contrib/libb2:__pkg__", "//sys/crypto:__pkg__"])

bsd_source_headers(name = "crypto_module_context_6", hdrs = ["blake2-impl.h", "blake2.h"], includes = ["."],
    visibility = ["//sys/contrib/libb2:__pkg__"])

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")

load("//tools/build/bazel:kernel_amd64.bzl", "AMD64_KERNEL_WARNING_FLAGS")

amd64_generic_module_objects(name = "blake2_blake2-dispatch_module", srcs = ["blake2-dispatch.c"],
    deps = ["//sys/crypto:crypto_module_context_5", "//sys/contrib/libb2:crypto_module_context_5"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + ["-Wno-cast-qual", "-Wno-unused-const-variable"], copts = [], local_defines = [])

amd64_generic_module_objects(name = "blake2_blake2bp_module", srcs = ["blake2bp.c", "blake2sp.c"],
    deps = ["//sys/crypto:crypto_module_context_6", "//sys/contrib/libb2:crypto_module_context_6"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + ["-Wno-cast-qual"], copts = [], local_defines = [])

amd64_generic_module_objects(name = "crypto_blake2b-ref_module", srcs = ["blake2b-ref.c", "blake2s-ref.c"],
    deps = ["//sys/crypto:codecs_crypto_kernel_blake2b-ref_headers", "//sys/contrib/libb2:codecs_crypto_kernel_blake2b-ref_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + ["-Wno-cast-qual", "-Wno-unused-function"], copts = [], local_defines = ["SKEIN_ASM", "SKEIN_USE_ASM=1792", "SUFFIX=_ref"])
