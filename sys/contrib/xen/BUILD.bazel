# Low-level amd64 built-in prerequisites.
load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")
bsd_source_headers(name = "lowlevel_kernel_xen-locore_headers", hdrs = ["arch-x86/xen-x86_64.h", "arch-x86/xen.h", "elfnote.h", "xen-compat.h", "xen.h"],
    visibility = ["//sys/amd64/amd64:__pkg__"])

# x86 core built-in prerequisites.
bsd_source_headers(name = "x86_core_kernel_identcpu_headers", hdrs = ["arch-x86/xen-x86_64.h", "arch-x86/xen.h", "callback.h", "event_channel.h", "hvm/dm_op.h", "hvm/hvm_op.h", "hvm/params.h", "memory.h", "physdev.h", "platform.h", "sched.h", "trace.h", "xen-compat.h", "xen.h"],
    visibility = ["//sys/x86/x86:__pkg__"])
bsd_source_headers(name = "x86_core_kernel_local_apic_headers", hdrs = ["arch-x86/cpuid.h"],
    visibility = ["//sys/x86/x86:__pkg__"])
