    pre_copts = [], copts = [], warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_monitoring_devices_nfs_nfssvc", srcs = ["nfs_nfssvc.c"],
    deps = ["//sys/nfs:monitoring_devices_kernel_nfs_nfssvc_headers", "//sys/security/audit:monitoring_devices_kernel_nfs_nfssvc_headers", "//sys/vm:monitoring_devices_kernel_hwpmc_logging_headers", "//sys/amd64/conf:monitoring_devices_kernel_opt_nfs_header"], early_deps = [],
