load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "cryptodev_headers", hdrs = ["cryptodev.h", "_cryptodev.h"],
    strip_include_prefix = "/sys", visibility = ["//sys/kern:__pkg__", "//sys/geom/eli:__pkg__", "//sys/netipsec:__pkg__", "//sys/opencrypto:__pkg__", "//usr.sbin/BSDCrypto:__pkg__", "//usr.sbin/BSDCrypto/tests:__pkg__"])

load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = glob(["*_if.m"]))

cc_library(name = "ed25519_headers", hdrs = ["cryptodesc_ed25519.h"], includes = [".."], visibility = ["//sys/security/mac_veriexec:__pkg__"])

cc_library(name = "if_enc_headers", hdrs = ["cbc_mac.h", "deflate.h", "gmac.h", "gfmult.h", "rmd160.h", "xform.h", "xform_auth.h", "xform_comp.h", "xform_enc.h"], strip_include_prefix = "/sys",
    deps = ["//sys/crypto:sha1_headers", "//sys/crypto/camellia:kernel_headers", "//sys/crypto/rijndael:kernel_headers", "//sys/crypto/sha2:kernel_headers", ":cryptodev_headers"],
    visibility = ["//sys/net:__pkg__", "//sys/netipsec:__pkg__", "//sys/modules/if_enc:__pkg__"])
