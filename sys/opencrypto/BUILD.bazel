    deps = [":cryptodev_headers", ":if_enc_headers", ":ed25519_headers", ":cryptodesc_kdf_headers",
        "//sys/crypto:curve25519_headers", "//sys/crypto/sha2:kernel_headers", "//sys/net:network_headers",
        "//sys/vm:kernel_headers", "//sys/contrib/ck:kernel_headers", "//sys/kern:bus_if_headers", "//sys/kern:device_if_headers"])
