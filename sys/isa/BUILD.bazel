load("//tools/build/bazel:bsd_kobj.bzl", "kernel_interfaces")
kernel_interfaces(srcs = glob(["*_if.m"]))

load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(name = "kernel_headers", hdrs = glob(["*.h"]), strip_include_prefix = ".", include_prefix = "isa", visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

bsd_source_headers(name = "tracing_core_headers", hdrs = ["rtc.h"], includes = [],
    visibility = ["//sys/cddl/dev/dtrace:__pkg__", "//sys/cddl/dev/fbt:__pkg__", "//sys/cddl/dev/kinst:__pkg__", "//sys/modules/dtrace/dtraceall:__pkg__"])

bsd_source_headers(name = "acpi_support_headers", hdrs = ["rtc.h"], visibility = ["//sys/dev/acpi_support:__pkg__", "//sys/dev/acpica:__pkg__"])

# Low-level amd64 built-in prerequisites.
bsd_source_headers(name = "lowlevel_kernel_efirt_machdep_headers", hdrs = ["rtc.h"],
    visibility = ["//sys/amd64/amd64:__pkg__"])
bsd_source_headers(name = "lowlevel_kernel_fpu_headers", hdrs = ["isavar.h", "pnpvar.h"],
    visibility = ["//sys/amd64/amd64:__pkg__"])
bsd_source_headers(name = "lowlevel_kernel_machdep_headers", hdrs = ["isareg.h", "rtc.h"],
    visibility = ["//sys/amd64/amd64:__pkg__"])

# Native amd64 core consumer of the maintained ISA object interface.
filegroup(name = "isa_if_header_file", srcs = [":isa_if"], output_group = "header")
cc_library(name = "isa_if_headers", hdrs = [":isa_if_header_file"], strip_include_prefix = "isa_if.generated",
    visibility = ["//sys/dev/acpica:__pkg__", "//sys/x86/x86:__pkg__", "//sys/amd64/amd64:__pkg__"])

# x86 core built-in prerequisites.
bsd_source_headers(name = "x86_core_kernel_autoconf_headers", hdrs = ["isavar.h", "pnpvar.h"],
    visibility = ["//sys/x86/x86:__pkg__"])
bsd_source_headers(name = "x86_core_kernel_cpu_machdep_headers", hdrs = ["isareg.h"],
    visibility = ["//sys/x86/x86:__pkg__"])
bsd_source_headers(name = "x86_core_kernel_intr_machdep_headers", hdrs = ["isareg.h"],
    visibility = ["//sys/x86/x86:__pkg__"])
bsd_source_headers(name = "x86_core_kernel_nexus_headers", hdrs = ["isareg.h", "isavar.h", "pnpvar.h"],
    visibility = ["//sys/x86/x86:__pkg__"])

# ACPI core built-in prerequisites.
bsd_source_headers(name = "acpica_core_kernel_acpi_headers", hdrs = ["isavar.h", "pnpvar.h"],
    visibility = ["//sys/dev/acpica:__pkg__"])
bsd_source_headers(name = "acpica_core_kernel_acpi_acad_headers", hdrs = ["isavar.h", "pnpvar.h"],
    visibility = ["//sys/dev/acpica:__pkg__"])
bsd_source_headers(name = "acpica_core_kernel_acpi_isab_headers", hdrs = ["isavar.h", "pnpvar.h"],
    visibility = ["//sys/dev/acpica:__pkg__"])
