    deps = ["//sys/ddb:platform_support_kernel_gdb_cons_headers", "//sys/gdb:platform_support_kernel_gdb_cons_headers", "//sys/amd64/conf:platform_support_kernel_opt_ddb_header"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_platform_support_gdb_packet", srcs = ["gdb_packet.c"],
    deps = ["//sys/ddb:platform_support_kernel_gdb_cons_headers", "//sys/gdb:platform_support_kernel_gdb_cons_headers", "//sys/amd64/conf:platform_support_kernel_opt_ddb_header"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
