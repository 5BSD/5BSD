# SoC metadata referenced by files directives in the maintained configurations.
filegroup(name = "configuration_inputs", srcs = glob(["*/files.*"]) + glob(["*/options.*"], allow_empty = True),
    visibility = ["//sys/riscv/conf:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

bsd_source_headers(name = "tracing_core_headers", hdrs = ["vmm/riscv.h", "vmm/vmm_vtimer.h"], includes = [],
    visibility = ["//sys/cddl/dev/dtrace:__pkg__", "//sys/cddl/dev/fbt:__pkg__", "//sys/cddl/dev/kinst:__pkg__", "//sys/modules/dtrace/dtraceall:__pkg__"])
