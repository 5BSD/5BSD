#
# DEFAULTS -- Default kernel configuration file for FreeBSD/RISC-V
#

machine		riscv	riscv64

# Pseudo devices.
device		mem		# Memory and kernel memory devices

# Default partitioning schemes
options 	GEOM_PART_BSD
options 	GEOM_PART_MBR
options 	GEOM_PART_GPT

# Default congestion control algorithm
options 	CC_CUBIC		# include CUBIC congestion control

options 	INTRNG

options 	NETLINK			# netlink(4) support

# Mandatory in 5BSD (sys/conf/mandatory-options): every configuration has
# them, and standalone module builds see them in opt_global.h.
options 	AUDIT			# Security event auditing
options 	CAPABILITY_MODE		# Capsicum capability mode
options 	CAPABILITIES		# Capsicum capabilities
options 	RACCT			# Resource accounting framework
options 	RCTL			# Resource limits
