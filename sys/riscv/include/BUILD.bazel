exports_files(["minidump.h"], visibility = ["//lib/libkvm:__pkg__"])

load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "kernel_headers", hdrs = glob(["*.h"]),
    strip_include_prefix = ".", include_prefix = "machine", visibility = ["//visibility:public"])

filegroup(name = "standalone_lua_headers", srcs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'endian.h', 'metadata.h', 'param.h', 'setjmp.h'], visibility = ["//stand/liblua:__pkg__"])

filegroup(name = "libefi_headers", srcs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'endian.h', 'metadata.h', 'param.h'], visibility = ["//stand/efi/libefi:__pkg__"])

filegroup(name = "loader_fdt_headers", srcs = ['_limits.h', '_stdint.h', '_types.h', 'elf.h', 'endian.h', 'param.h'], visibility = ["//stand/fdt:__pkg__", "//stand/efi/fdt:__pkg__"])

filegroup(name = "standalone_ficl_headers", srcs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'endian.h', 'metadata.h', 'param.h', 'setjmp.h'], visibility = ["//stand/ficl:__pkg__"])

filegroup(name = "standalone_sa_arch_headers", srcs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'asm.h', 'atomic.h', 'cpufunc.h', 'endian.h', 'param.h', 'proc.h', 'setjmp.h', 'signal.h', 'ucontext.h'], visibility = ["//stand/libsa:__pkg__"])

load("//tools/build/bazel:bsd_source_headers.bzl", "bsd_source_headers")

bsd_source_headers(name = 'efi_loader_riscv64_headers', hdrs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'asm.h', 'cpufunc.h', 'elf.h', 'endian.h', 'exec.h', 'md_var.h', 'metadata.h', 'param.h', 'psl.h', 'setjmp.h'], visibility = ["//stand/efi/loader:__pkg__"])

bsd_source_headers(name = 'efi_boot1_riscv64_headers', hdrs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'asm.h', 'elf.h', 'endian.h', 'param.h'], visibility = ["//stand/efi/boot1:__pkg__"])

bsd_source_headers(name = 'efi_gptboot_riscv64_headers', hdrs = ['_limits.h', '_stdint.h', '_types.h', 'asm.h', 'elf.h', 'endian.h', 'param.h'], visibility = ["//stand/efi/gptboot:__pkg__"])

bsd_source_headers(name = 'efi_loader_simp_riscv64_headers', hdrs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'asm.h', 'cpufunc.h', 'elf.h', 'endian.h', 'exec.h', 'md_var.h', 'metadata.h', 'param.h', 'psl.h', 'setjmp.h'], visibility = ["//stand/efi/loader_simp:__pkg__"])

bsd_source_headers(name = 'efi_loader_4th_riscv64_headers', hdrs = ['_inttypes.h', '_limits.h', '_stdint.h', '_types.h', 'asm.h', 'cpufunc.h', 'elf.h', 'endian.h', 'exec.h', 'md_var.h', 'metadata.h', 'param.h', 'psl.h', 'setjmp.h'], visibility = ["//stand/efi/loader_4th:__pkg__"])

load("//tools/build/bazel:bsd_public_headers.bzl", "public_header_installation")

# Public installed ABI headers follow include/Makefile source groups.
public_header_installation(name = "public_riscv_machine_install", directory = "machine",
    files = {header: header.split("/")[-1] for header in glob(["*.h"], allow_empty = False)}, enabled = "//tools/build/bazel/config:includes_enabled")
