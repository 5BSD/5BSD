load("//tools/build/bazel:amd64_generic_kernel.bzl", "amd64_generic_kernel_objects")

load("//tools/build/bazel:kernel_common.bzl", "KERNEL_BUILTIN_WARNING_FLAGS")

# Native amd64 GENERIC filesystem/RPC built-ins.
amd64_generic_kernel_objects(name = "generic_filesystems_rpc_xdr", srcs = ["xdr.c"],
    deps = ["//sys/rpc:filesystems_rpc_kernel_xdr_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_filesystems_rpc_xdr_array", srcs = ["xdr_array.c"],
    deps = ["//sys/rpc:filesystems_rpc_kernel_xdr_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_filesystems_rpc_xdr_mbuf", srcs = ["xdr_mbuf.c"],
    deps = ["//sys/rpc:filesystems_rpc_kernel_xdr_headers", "//sys/vm:filesystems_rpc_kernel_msdosfs_fat_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_filesystems_rpc_xdr_mem", srcs = ["xdr_mem.c"],
    deps = ["//sys/rpc:filesystems_rpc_kernel_xdr_headers", "//sys/vm:filesystems_rpc_kernel_msdosfs_fat_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_filesystems_rpc_xdr_reference", srcs = ["xdr_reference.c"],
    deps = ["//sys/rpc:filesystems_rpc_kernel_xdr_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)
amd64_generic_kernel_objects(name = "generic_filesystems_rpc_xdr_sizeof", srcs = ["xdr_sizeof.c"],
    deps = ["//sys/rpc:filesystems_rpc_kernel_xdr_headers"],
    warning_flags = KERNEL_BUILTIN_WARNING_FLAGS)

load("//tools/build/bazel:amd64_generic_module.bzl", "amd64_generic_module_objects")

load("//tools/build/bazel:kernel_amd64.bzl", "AMD64_KERNEL_WARNING_FLAGS")

amd64_generic_module_objects(name = "xdr_xdr_module", srcs = ["xdr.c", "xdr_array.c", "xdr_reference.c", "xdr_sizeof.c"],
    deps = ["//sys/rpc:openzfs_kernel_nvpair_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = [], header_overrides = [], preinclude_headers = [], textual_hdrs = [])

amd64_generic_module_objects(name = "xdr_xdr_mbuf_module", srcs = ["xdr_mbuf.c", "xdr_mem.c"],
    deps = ["//sys/vm:usb_net_usie_headers", "//sys/rpc:openzfs_kernel_nvpair_headers"],
    warning_flags = AMD64_KERNEL_WARNING_FLAGS + [], copts = [], local_defines = [], header_overrides = [], preinclude_headers = [], textual_hdrs = [])

load("//tools/build/bazel:cross_generic_module.bzl", "cross_generic_module_objects")

[cross_generic_module_objects(
    arch = arch,
    name = "xdr_xdr_module",
    srcs = ['xdr.c', 'xdr_array.c', 'xdr_reference.c', 'xdr_sizeof.c'],
    deps = ["//sys/rpc:openzfs_kernel_nvpair_headers"],
) for arch in ['arm64', 'riscv']]

[cross_generic_module_objects(
    arch = arch,
    name = "xdr_xdr_mbuf_module",
    srcs = ['xdr_mbuf.c', 'xdr_mem.c'],
    deps = ["//sys/rpc:openzfs_kernel_nvpair_headers", "//sys/vm:usb_net_usie_headers"],
) for arch in ['arm64', 'riscv']]
