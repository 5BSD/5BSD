# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(
    name = "zfs",
    srcs = ["//sys/contrib/openzfs:cmd/zfs/zfs_iter.c", "//sys/contrib/openzfs:cmd/zfs/zfs_main.c", "//sys/contrib/openzfs:cmd/zfs/zfs_project.c", "//sys/modules/zfs:zfs_config.h"],
    deps = ['//lib/libgeom:geom', '//cddl/lib/libnvpair:nvpair', '//cddl/lib/libzfs:zfs', '//cddl/lib/libzutil:zutil', '//cddl/lib/libavl:avl', '//cddl/lib/libspl:spl', '//cddl/lib/libzfs_core:zfs_core', '//lib/msun:m'] + ["//sys/contrib/openzfs:zfs_cli_headers", "//cddl/compat/opensolaris/include:headers", "//lib/libjail:jail", "//secure/lib/libcrypto:crypto"],
    dynamic_deps = ["//lib/libjail:jail_shared", "//secure/lib/libcrypto:crypto_shared", '//lib/libgeom:geom_shared', '//cddl/lib/libnvpair:nvpair_shared', '//cddl/lib/libzfs:zfs_shared', '//cddl/lib/libzutil:zutil_shared', '//cddl/lib/libavl:avl_shared', '//cddl/lib/libspl:spl_shared', '//cddl/lib/libzfs_core:zfs_core_shared', '//lib/msun:m_shared'],
    local_defines = ["IN_BASE", "HAVE_ISSETUGID", "NEED_SOLARIS_BOOLEAN", "HAVE_STRLCAT", "HAVE_STRLCPY"],
    copts = ["-fPIE", "-include", "sys/contrib/openzfs/include/os/freebsd/spl/sys/ccompile.h", "-include", "sys/modules/zfs/zfs_config.h"],
    linkopts = ["-pie", "-pthread"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
)

load(":installation.bzl", "zfs_installation")
zfs_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    visibility = ["//cddl/sbin:__pkg__"],
    name = "install_archive",
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
