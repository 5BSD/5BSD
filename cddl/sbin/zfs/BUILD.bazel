load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
_SOURCES = ["//sys/contrib/openzfs:cmd/zfs/zfs_iter.c", "//sys/contrib/openzfs:cmd/zfs/zfs_main.c", "//sys/contrib/openzfs:cmd/zfs/zfs_project.c", "//sys/modules/zfs:zfs_config.h"]
cc_binary(
    name = "zfs",
    srcs = _SOURCES,
    deps = ['//lib/libgeom:geom', '//cddl/lib/libnvpair:nvpair', '//cddl/lib/libzfs:zfs', '//cddl/lib/libzutil:zutil', '//cddl/lib/libavl:avl', '//cddl/lib/libspl:spl', '//cddl/lib/libzfs_core:zfs_core', '//lib/msun:m'] + ["//sys/contrib/openzfs:zfs_cli_headers", "//cddl/compat/opensolaris/include:headers", "//lib/libjail:jail", "//secure/lib/libcrypto:crypto"],
    dynamic_deps = ["//lib/libjail:jail_shared", "//secure/lib/libcrypto:crypto_shared", '//lib/libgeom:geom_shared', '//cddl/lib/libnvpair:nvpair_shared', '//cddl/lib/libzfs:zfs_shared', '//cddl/lib/libzutil:zutil_shared', '//cddl/lib/libavl:avl_shared', '//cddl/lib/libspl:spl_shared', '//cddl/lib/libzfs_core:zfs_core_shared', '//lib/msun:m_shared'],
    local_defines = ["IN_BASE", "HAVE_ISSETUGID", "NEED_SOLARIS_BOOLEAN", "HAVE_STRLCAT", "HAVE_STRLCPY"],
    copts = ["-fPIE", "-include", "sys/contrib/openzfs/include/os/freebsd/spl/sys/ccompile.h", "-include", "sys/modules/zfs/zfs_config.h"],
    linkopts = ["-pie", "-pthread"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
)

load(":installation.bzl", "zfs_installation")
zfs_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    visibility = ["//cddl/sbin:__pkg__"],
    name = "install_archive",
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

load("//tools/build/bazel:bsd_rescue_application.bzl", "rescue_application")
# Original nested rescue compiler policy, including parent Makefile.inc flags.
_RESCUE_COPTS = ['-pipe', '-fno-common', '-Isys/contrib/openzfs/include', '-Isys/contrib/openzfs/include/os/freebsd', '-Isys/contrib/openzfs/lib/libspl/include', '-Isys/contrib/openzfs/lib/libspl/include/os/freebsd', '-Isys', '-Icddl/compat/opensolaris/include', '-Isys/contrib/openzfs/module/icp/include', '-include', 'sys/contrib/openzfs/include/os/freebsd/spl/sys/ccompile.h', '-include', 'sys/modules/zfs/zfs_config.h', '-Isys/modules/zfs', '-std=gnu17', '-Wno-format-zero-length', '-Wsystem-headers', '-Werror', '-Wall', '-Wno-format-y2k', '-Wno-uninitialized', '-Wno-pointer-sign', '-Wdate-time', '-Wno-unknown-pragmas', '-Wno-empty-body', '-Wno-string-plus-int', '-Wno-unused-const-variable', '-Wno-error=unused-but-set-parameter', '-Wno-error=cast-function-type-mismatch', '-Wno-tautological-compare', '-Wno-unused-value', '-Wno-parentheses-equality', '-Wno-unused-function', '-Wno-enum-conversion', '-Wno-unused-local-typedef', '-Wno-address-of-packed-member', '-Wno-switch', '-Wno-switch-enum', '-Wno-knr-promoted-parameter', '-Qunused-arguments']
_RESCUE_DEFINES = ['IN_BASE', 'HAVE_ISSETUGID', 'NEED_SOLARIS_BOOLEAN', 'HAVE_STRLCAT', 'HAVE_STRLCPY']
_RESCUE_DEPS = ['//sys/contrib/openzfs:spl_headers', '//sys/sys:kernel_headers', '//cddl/compat/opensolaris/include:headers', '//sys/contrib/openzfs:zfs_cli_headers']
# zfs_main.c alone has this extra source warning option in the maintained build.
cc_library(name = "rescue_main_objects", srcs = [s for s in _SOURCES if s.endswith("zfs_main.c") or s.endswith(".h")],
    deps = _RESCUE_DEPS, local_defines = ["RESCUE"] + _RESCUE_DEFINES,
    copts = _RESCUE_COPTS + ["-Wno-unused-variable"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
rescue_application(srcs = [s for s in _SOURCES if not s.endswith("zfs_main.c")], ordered_sources = _SOURCES,
    deps = _RESCUE_DEPS, defines = _RESCUE_DEFINES, compiler_options = _RESCUE_COPTS, components = [":rescue_main_objects"],
    archives = ['//lib/libbe:static_archive', '//cddl/lib/libzpool:static_archive', '//cddl/lib/libzfs:static_archive', '//cddl/lib/libzutil:static_archive', '//cddl/lib/libzfs_core:static_archive', '//cddl/lib/libzfsbootenv:static_archive', '//cddl/lib/libicp_rescue:static_archive', '//cddl/lib/libnvpair:static_archive'])
