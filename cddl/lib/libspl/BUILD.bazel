load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load(":sources.bzl", "SPL_SOURCES")
cc_library(name = "spl", srcs = SPL_SOURCES,
    hdrs = ["//sys/modules/zfs:zfs_config.h"],
    deps = ["//lib/libthr:thr"],
    implementation_deps = ["//sys/contrib/openzfs:spl_headers", "//cddl/compat/opensolaris/include:headers", "//sys/contrib/openzfs:spl_private_headers"],
    local_defines = ["IN_BASE", "HAVE_ISSETUGID"],
    copts = ["-std=c99", "-include", "sys/contrib/openzfs/include/os/freebsd/spl/sys/ccompile.h",
        "-include", "sys/modules/zfs/zfs_config.h"],
    linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":spl"], visibility = ["//visibility:public"])
cc_shared_library(name = "spl_shared", deps = [":spl"], dynamic_deps = ["//lib/libthr:thr_shared"], shared_lib_name = "libspl.so.2",
    user_link_flags = ["-Wl,-soname,libspl.so.2", "-Wl,--fatal-warnings,--warn-shared-textrel"], visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_import", "cc_test")
cc_import(name = "archive_link", static_library = ":static_archive")
[
    cc_test(name = "functional_" + variant, srcs = ["functional_test.c", "//sys/modules/zfs:zfs_config.h"],
        deps = ["//sys/contrib/openzfs:spl_headers", "//cddl/compat/opensolaris/include:headers"] + ([":archive_link", "//lib/libthr:thr"] if variant == "static" else [":spl"]),
        dynamic_deps = [] if variant == "static" else [":spl_shared"],
        features = [] if variant == "static" else ["bsd_test_runtime_paths"],
        linkstatic = variant == "static", linkopts = ["-pthread"] + (["-static"] if variant == "static" else []),
        local_defines = ["IN_BASE", "HAVE_ISSETUGID"],
        copts = ["-include", "sys/contrib/openzfs/include/os/freebsd/spl/sys/ccompile.h", "-include", "sys/modules/zfs/zfs_config.h"],
        size = "small", target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
    for variant in ["static", "shared"]
]

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    visibility = ["//cddl/lib:__pkg__"],
    name = "install_archive",
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
