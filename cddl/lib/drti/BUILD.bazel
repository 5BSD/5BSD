load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_object")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest")
cc_library(
    name = "runtime",
    srcs = ["//cddl/contrib/opensolaris:lib/libdtrace/common/drti.c"],
    deps = ["//cddl/contrib/opensolaris:dtrace_headers", "//contrib/elftoolchain:elf_headers", "//sys/sys:kernel_headers"],
    # cddl/Makefile.inc adds NEED_SOLARIS_BOOLEAN, HAVE_STRLCAT and HAVE_STRLCPY.
    local_defines = ["IN_BASE", "SKIP_SPL_SYS_CONDVAR_H", "HAVE_ISSETUGID", "PIC", "NEED_SOLARIS_BOOLEAN", "HAVE_STRLCAT", "HAVE_STRLCPY"],
    copts = ["-include", "sys/contrib/openzfs/include/os/freebsd/spl/sys/ccompile.h"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
)
bsd_component_object(name = "drti", group = ":runtime", pic = True, out = "drti.o",
    visibility = ["//visibility:public"])
bsd_install_file(name = "runtime_install", src = ":drti", destination = "/usr/lib/dtrace/drti.o",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=dtrace"])
bsd_install_manifest(name = "install_manifest", entries = [":runtime_install"], visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    visibility = ["//cddl/lib:__pkg__"],
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {"/usr/lib/dtrace": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=dtrace"]}'},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
