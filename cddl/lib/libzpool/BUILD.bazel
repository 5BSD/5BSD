load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load(":objects.bzl", "zpool_objects")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
_LIBS = ['//lib/libmd:md_link', '//lib/libz:z', '//cddl/lib/libspl:spl', '//cddl/lib/libicp:icp', '//cddl/lib/libnvpair:nvpair', '//cddl/lib/libavl:avl', '//cddl/lib/libumem:umem']
zpool_objects(name = "objects", srcs = ["//sys/contrib/openzfs:zpool_build_sources"], deps = _LIBS)
zpool_objects(name = "compression_objects", srcs = ["//sys/contrib/openzfs:zpool_compression_sources"], deps = _LIBS,
    extra_copts = ["-fno-tree-vectorize", "-Wno-bitwise-instead-of-logical"])
cc_library(name = "zpool", deps = [":objects", ":compression_objects"], linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":objects", ":compression_objects"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_shared_library(name = "zpool_shared", deps = [":zpool"], dynamic_deps = ['//lib/libmd:md_shared', '//lib/libz:z_shared', '//cddl/lib/libspl:spl_shared', '//cddl/lib/libicp:icp_shared', '//cddl/lib/libnvpair:nvpair_shared', '//cddl/lib/libavl:avl_shared', '//cddl/lib/libumem:umem_shared'], shared_lib_name = "libzpool.so.2",
    user_link_flags = ["-Wl,-soname,libzpool.so.2", "-Wl,--fatal-warnings,--warn-shared-textrel"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
