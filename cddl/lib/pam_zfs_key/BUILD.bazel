load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "module", srcs = ["//sys/contrib/openzfs:contrib/pam_zfs_key/pam_zfs_key.c"], hdrs = ["//sys/modules/zfs:zfs_config.h"],
    deps = ['//cddl/lib/libzfs:zfs', '//cddl/lib/libzfs_core:zfs_core', '//cddl/lib/libnvpair:nvpair', '//secure/lib/libcrypto:crypto', '//lib/libpam/libpam:pam'] + ["//sys/contrib/openzfs:pam_zfs_headers"],
    local_defines = ["IN_BASE", "HAVE_ISSETUGID", "NEED_SOLARIS_BOOLEAN", "HAVE_STRLCAT", "HAVE_STRLCPY", "OPENPAM_DEBUG", 'RUNSTATEDIR=\\"/var/run\\"'],
    copts = ["-std=c99", "-include", "sys/contrib/openzfs/include/os/freebsd/spl/sys/ccompile.h", "-include", "sys/modules/zfs/zfs_config.h"],
    linkstatic = True, target_compatible_with = _PLATFORM)
cc_shared_library(name = "pam_zfs_key", deps = [":module"], dynamic_deps = ['//cddl/lib/libzfs:zfs_shared', '//cddl/lib/libzfs_core:zfs_core_shared', '//cddl/lib/libnvpair:nvpair_shared', '//secure/lib/libcrypto:crypto_shared', '//lib/libpam/libpam:pam_shared'], shared_lib_name = "pam_zfs_key.so.6",
    user_link_flags = ["-Wl,-soname,pam_zfs_key.so.6", "-Wl,--fatal-warnings,--warn-shared-textrel"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
