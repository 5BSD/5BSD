# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "zfsbootenv", srcs = ["//sys/contrib/openzfs:lib/libzfsbootenv/lzbe_device.c", "//sys/contrib/openzfs:lib/libzfsbootenv/lzbe_util.c", "//sys/contrib/openzfs:lib/libzfsbootenv/lzbe_pair.c"],
    hdrs = ["//sys/modules/zfs:zfs_config.h"],
    deps = ["//sys/contrib/openzfs:zfsbootenv_headers", "//cddl/lib/libnvpair:nvpair", "//cddl/lib/libzfs:zfs"],
    implementation_deps = ["//cddl/compat/opensolaris/include:headers"],
    local_defines = ["IN_BASE", "HAVE_ISSETUGID", "NEED_SOLARIS_BOOLEAN", "HAVE_STRLCAT", "HAVE_STRLCPY"],
    copts = ["-std=c99", "-include", "sys/contrib/openzfs/include/os/freebsd/spl/sys/ccompile.h", "-include", "sys/modules/zfs/zfs_config.h"],
    linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":zfsbootenv"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_shared_library(name = "zfsbootenv_shared", deps = [":zfsbootenv"], dynamic_deps = ["//cddl/lib/libnvpair:nvpair_shared", "//cddl/lib/libzfs:zfs_shared"],
    shared_lib_name = "libzfsbootenv.so.1", user_link_flags = ["-Wl,-soname,libzfsbootenv.so.1", "-Wl,--fatal-warnings,--warn-shared-textrel"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    visibility = ["//cddl/lib:__pkg__"],
    name = "install_archive",
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
