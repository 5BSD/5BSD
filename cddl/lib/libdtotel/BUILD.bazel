# libdtotel, DTrace's OpenTelemetry output (cddl/lib/libdtotel/Makefile):
# INTERNALLIB, WARNS 3, the libdtrace include set, -I lib/libotelexport,
# LIBADD dtrace jail m otelexport; libdtotel.a and libdtotel_pie.a, nothing
# installed.  dtrace(1) links it, so its closure stays free of the
# DTrace-instrumented native libthr.
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
cc_library(name = "headers", hdrs = ["dtotel.h", "dtotel_session.h"], strip_include_prefix = ".",
    deps = ["//cddl/lib/libdtrace:public_headers", "//lib/libotelexport:headers"], visibility = ["//visibility:public"])
cc_library(name = "private_headers", hdrs = ["dtotel_impl.h"], strip_include_prefix = ".", visibility = ["//cddl/lib/libdtotel/tests:__pkg__"])
[cc_library(name = "dtotel" + suffix, srcs = ["dtotel.c", "dtotel_agg.c", "dtotel_prof.c", "dtotel_session.c"],
    deps = [":headers", "//cddl/lib/libdtrace:dtrace", "//lib/libjail:jail", "//lib/msun:m", "//lib/libotelexport:otelexport" + suffix],
    implementation_deps = [":private_headers", "//cddl/contrib/opensolaris:dtrace_headers", "//cddl/compat/opensolaris/include:headers", "//sys/sys:kernel_headers"],
    local_defines = ["IN_BASE", "SKIP_SPL_SYS_CONDVAR_H", "HAVE_ISSETUGID", "NEED_SOLARIS_BOOLEAN", "HAVE_STRLCAT", "HAVE_STRLCPY"],
    copts = copts, linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
 for suffix, copts in [("", []), ("_pie", ["-fpie"])]]
bsd_component_archive(name = "static_archive", groups = [":dtotel"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "pie_archive", groups = [":dtotel_pie"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

# The INTERNALLIB installs nothing itself; with tests enabled Make installs
# dtotel_test (package libotelexport-tests).
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_manifest(name = "install_manifest", entries = [], visibility = ["//visibility:public"])
bsd_install_archive(name = "install_archive",
    manifests = [":install_manifest"] + select({"//tools/build/bazel/config:tests_enabled": ["//cddl/lib/libdtotel/tests:install_manifest"], "//conditions:default": []}),
    directories = select({"//tools/build/bazel/config:tests_enabled": {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libotelexport-tests","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/tests", "/usr/lib/debug/usr/tests/cddl", "/usr/lib/debug/usr/tests/cddl/lib", "/usr/lib/debug/usr/tests/cddl/lib/libdtotel"]} |
        {"/usr/tests/cddl/lib/libdtotel": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=libotelexport-tests"]}'}, "//conditions:default": {}}),
    mtree_specs = {"//etc/mtree:BSD.tests.dist": "/usr/tests", "//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"], visibility = ["//visibility:public"])
