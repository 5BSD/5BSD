load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test", "cc_binary")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load(":sources.bzl", "CTF_SOURCES")
cc_library(name = "ctf", srcs = CTF_SOURCES,
    # Make's compatibility include paths are implementation details, not an API.
    # Propagating them shadows ordinary errno/math/string headers in C++ clients.
    implementation_deps = ["//cddl/contrib/opensolaris:ctf_library_headers", "//cddl/lib/libspl:spl", "//lib/libz:z"],
    local_defines = ["CTF_OLD_VERSIONS", "IN_BASE", "HAVE_ISSETUGID"],
    copts = ["-include", "sys/contrib/openzfs/include/os/freebsd/spl/sys/ccompile.h"],
    linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":ctf"], visibility = ["//visibility:public"])
cc_shared_library(name = "ctf_shared", deps = [":ctf"], dynamic_deps = ["//cddl/lib/libspl:spl_shared", "//lib/libz:z_shared"],
    shared_lib_name = "libctf.so.2", user_link_flags = ["-Wl,-soname,libctf.so.2", "-Wl,--fatal-warnings,--warn-shared-textrel"], visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_import", "cc_test")
cc_import(name = "archive_link", static_library = ":static_archive")
[
    cc_test(name = "functional_" + variant, srcs = ["functional_test.c"],
        deps = ["//cddl/contrib/opensolaris:ctf_library_headers"] + ([":archive_link", "//cddl/lib/libspl:spl", "//lib/libz:z"] if variant == "static" else [":ctf"]),
        dynamic_deps = [] if variant == "static" else [":ctf_shared", "//cddl/lib/libspl:spl_shared", "//lib/libz:z_shared"],
        features = [] if variant == "static" else ["bsd_test_runtime_paths"], linkstatic = variant == "static",
        # Static libthr requires static libc: protected thread tables cannot
        # be copy-relocated from a shared libc into a non-PIC static archive.
        linkopts = ["-pthread"] + (["-static"] if variant == "static" else []),
        local_defines = ["IN_BASE", "HAVE_ISSETUGID"],
        copts = ["-include", "sys/contrib/openzfs/include/os/freebsd/spl/sys/ccompile.h"],
        size = "small", target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
    for variant in ["static", "shared"]
]

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

filegroup(name = "package_abi", srcs = [":install_manifest_stripped"], visibility = ["//packages/ctf:__pkg__"])

# An ordinary C++ link consumer must not inherit Solaris compatibility headers.
cc_binary(name = "public_cpp_consumer", srcs = ["public_cpp_consumer_test.cc"],
    deps = [":ctf", "//lib/libc++:cxx", "//lib/libcxxrt:cxxrt", "//lib/msun:m"],
    dynamic_deps = [":ctf_shared", "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared"],
    copts = ["-nostdinc++", "-std=c++17"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
load("//tools/build/bazel:bsd_program_test.bzl", "bsd_program_test")
bsd_program_test(name = "public_cpp_consumer_test", program = ":public_cpp_consumer",
    runner = "//tools/build/bazel:program_test_runner", interface = "plain",
    runtime_lib = [":ctf_shared", "//cddl/lib/libspl:spl_shared", "//lib/libz:z_shared",
        "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared", "//lib/msun:m_shared",
        "//lib/libthr:thr_shared", "//lib/libc:c_shared", "//lib/libsys:sys_shared", "//lib/libgcc_s:gcc_s_shared"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], size = "small")
