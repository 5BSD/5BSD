    dynamic_deps = ['//lib/libgeom:geom_shared', '//lib/msun:m_shared', '//cddl/lib/libnvpair:nvpair_shared', '//cddl/lib/libumem:umem_shared', '//cddl/lib/libavl:avl_shared', '//cddl/lib/libspl:spl_shared', '//cddl/lib/libzfs_core:zfs_core_shared', '//cddl/lib/libzfs:zfs_shared', '//cddl/lib/libzutil:zutil_shared', '//cddl/lib/libzpool:zpool_shared', '//cddl/lib/libicp:icp_shared'],
