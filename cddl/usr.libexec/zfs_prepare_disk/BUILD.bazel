load("//tools/build/bazel:bsd_template.bzl", "bsd_template")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_compress")

bsd_template(
    name = "manual",
    template = "//sys/contrib/openzfs:man/man8/zfs_prepare_disk.8.in",
    output = "zfs_prepare_disk.8",
    substitutions = {"@zfsexecdir@": "/usr/libexec/zfs"},
)
bsd_compress(
    name = "manual_gz", src = ":manual", output = "zfs_prepare_disk.8.gz",
    arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip",
    redirect = "@bsd_sdk//toolchain:stdout_redirect",
    runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"],
)
bsd_install_file(
    name = "script_install", src = "//sys/contrib/openzfs:scripts/zfs_prepare_disk",
    destination = "/usr/libexec/zfs/zfs_prepare_disk", owner = "root", group = "wheel",
    mode = "0555", install_tags = ["package=zfs"],
)
bsd_install_file(
    name = "manual_install", src = ":manual_gz",
    destination = "/usr/share/man/man8/zfs_prepare_disk.8.gz", owner = "root", group = "wheel",
    mode = "0444", install_tags = select({
        "//tools/build/bazel/config:split_manpages_enabled": ["package=zfs-man"],
        "//conditions:default": ["package=zfs"],
    }),
)
bsd_install_manifest(name = "install_manifest", entries = [":script_install", ":manual_install"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
