load("//cddl:production.bzl", "production_archives")
_FAMILIES = ["//cddl/lib", "//cddl/sbin", "//cddl/share", "//cddl/usr.bin", "//cddl/usr.libexec", "//cddl/usr.sbin"]
production_archives([family + ":production_installation_archives" for family in _FAMILIES],
    candidates = [family + ":installation_candidates" for family in _FAMILIES])
filegroup(name = "production_products", srcs = [":production_installation_archives", "//cddl/lib:production_libraries"], visibility = ["//visibility:public"])
