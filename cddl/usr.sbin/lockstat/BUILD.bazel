load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(
    name = "lockstat",
    srcs = ["//cddl/contrib/opensolaris:cmd/lockstat/lockstat.c", "//cddl/contrib/opensolaris:cmd/lockstat/sym.c"],
    deps = ["//sys/contrib/openzfs:spl_headers", "//cddl/compat/opensolaris/include:headers", "//sys/cddl/compat/opensolaris:headers", "//sys/sys:kernel_headers",
        "//lib/libelf:elf", "//cddl/lib/libdtrace:dtrace", "//lib/librt:rt"],
    dynamic_deps = ["//lib/libelf:elf_shared", "//cddl/lib/libdtrace:dtrace_shared", "//lib/librt:rt_shared"],
    local_defines = ["IN_BASE", "SKIP_SPL_SYS_CONDVAR_H", "HAVE_ISSETUGID", "NEED_ERRLOC", "NEED_SOLARIS_BOOLEAN", "HAVE_STRLCAT", "HAVE_STRLCPY"],
    copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
)
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation", "utility_debug_directories")
utility_installation(name = "install_manifest", program = "lockstat", manual = "//cddl/contrib/opensolaris:cmd/lockstat/lockstat.1", package = "dtrace", bindir = "/usr/sbin")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    visibility = ["//cddl/usr.sbin:__pkg__"],
    name = "install_archive",
    directories = utility_debug_directories("dtrace", "/usr/sbin"),
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
