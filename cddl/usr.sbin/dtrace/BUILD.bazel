load("@rules_cc//cc:defs.bzl", "cc_binary")
# cddl/usr.sbin/dtrace/Makefile: -I usr.sbin/dtraced, -I cddl/lib/libdtotel
# -I lib/libotelexport (OpenTelemetry output, -x otel=...), cddl/Makefile.inc
# defines; LIBADD dtotel dtrace ctf elf proc spl xo pthread crypto otelexport
# jail z ssl.  Dynamic dependencies follow Make's NEEDED order.  Provider
# generation uses ":bootstrap" (no instrumentation of its own closure), so
# this program may link the native, instrumented libthr.
DTRACE_RUNTIME = ["//cddl/lib/libdtrace:dtrace_shared", "//lib/libjail:jail_shared", "//lib/msun:m_shared", "//lib/libz:z_shared",
    "//secure/lib/libssl:ssl_shared", "//secure/lib/libcrypto:crypto_shared", "//lib/libucl:ucl_shared", "//lib/libnghttp2:nghttp2_shared",
    "//cddl/lib/libctf:ctf_shared", "//lib/libelf:elf_shared", "//lib/libproc:proc_shared", "//cddl/lib/libspl:spl_shared", "//lib/libxo/libxo:xo_shared",
    "//lib/libthr:thr_shared"]
cc_binary(name = "dtrace", srcs = ["//cddl/contrib/opensolaris:cmd/dtrace/dtrace.c", "//cddl/contrib/opensolaris:cmd/dtrace/dtrace_identifiers.h",
        "//cddl/contrib/opensolaris:cmd/dtrace/hypertrace_frame.h"],
    deps = ["//cddl/compat/opensolaris/include:proc_headers", "//cddl/contrib/opensolaris:dtrace_headers", "//usr.sbin/dtraced:headers", "//sys/dev/vmm:param_header", "//sys/sys:kernel_headers",
        "//cddl/lib/libdtotel:headers", "//cddl/lib/libdtotel:dtotel_pie", "//lib/libotelexport:otelexport_pie",
        # Make's first-appearance (NEEDED) order of the shared libraries.
        "//cddl/lib/libdtrace:dtrace", "//lib/libjail:jail", "//lib/msun:m", "//lib/libz:z", "//secure/lib/libssl:ssl", "//secure/lib/libcrypto:crypto",
        "//lib/libucl:ucl", "//lib/libnghttp2:nghttp2", "//cddl/lib/libctf:ctf", "//lib/libelf:elf", "//lib/libproc:proc", "//cddl/lib/libspl:spl",
        "//lib/libxo/libxo:xo", "//lib/libthr:thr"],
    dynamic_deps = DTRACE_RUNTIME,
    local_defines = ["IN_BASE", "SKIP_SPL_SYS_CONDVAR_H", "HAVE_ISSETUGID", "NEED_SOLARIS_BOOLEAN", "HAVE_STRLCAT", "HAVE_STRLCPY"],
    copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "dtrace",
    manual = "//cddl/contrib/opensolaris:cmd/dtrace/dtrace.1",
    package = "dtrace", bindir = "/usr/sbin")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=dtrace","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/sbin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

load("//tools/build/bazel:bsd_dtrace_bootstrap.bzl", "bsd_dtrace_bootstrap")
# Transitive runtime closure of the generator (libdtrace's C++ runtime,
# libproc's libutil/libprocstat/librtld_db/libkvm).  libthr stays the
# execution host's, paired with its libc: the source libthr needs the
# matching libc (for example __uexterr_set_ue@FBSDprivate_1.0).
bsd_dtrace_bootstrap(name = "bootstrap", binary = ":dtrace", runtime_libraries = [library for library in DTRACE_RUNTIME if library != "//lib/libthr:thr_shared"] + ["//lib/libutil:util_shared",
    "//lib/libprocstat:procstat_shared", "//lib/librtld_db:rtld_db_shared", "//lib/libc++:cxx_shared", "//lib/libcxxrt:cxxrt_shared",
    "//lib/libkvm:kvm_shared"], visibility = ["//visibility:public"])
filegroup(name = "bootstrap_runtime", srcs = [":bootstrap"], output_group = "runtime_libraries", visibility = ["//visibility:public"])
