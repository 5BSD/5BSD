# SPDX-License-Identifier: BSD-2-Clause
exports_files(["master.passwd", "group", "shells"])

load("//tools/build/bazel:bsd_accounts.bzl", "bsd_account_databases")
bsd_account_databases(
    name = "account_databases",
    src = "master.passwd",
    shells = "shells",
    pwd_mkdb = "//usr.sbin/pwd_mkdb:pwd_mkdb",
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
)

load(":account_installation.bzl", "account_installation")
account_installation()

load(":distribution.bzl", "etc_distribution")
etc_distribution()

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive_set")
# afterinstall databases require manuals from the other world roots.
bsd_install_archive_set(name = "pre_database_installation_archives",
    archives = ["//etc/termcap:install_archive", ":distribution_archives"], visibility = ["//visibility:public"])
