def book_sources():
    found = native.glob(["src/**"], allow_empty = False)
    expected = ["src/" + path for path in BOOK_FILES]
    missing = sorted([path for path in expected if path not in found])
    unlisted = sorted([path for path in found if path not in expected])
    if missing or unlisted:
        fail("book inventory differs from source tree: missing=%s unlisted=%s" % (missing, unlisted))
    native.exports_files(expected, visibility = ["//share/doc/5bsd:__pkg__", "//usr.sbin/bsdinstall/tests:__pkg__"])
    native.filegroup(name = "sources", srcs = expected, visibility = ["//usr.sbin/bsdinstall/tests:__pkg__"])
