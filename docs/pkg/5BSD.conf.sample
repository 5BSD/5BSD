# Optional override for a custom location or unqualified pkg updates.
# A standard /usr/src build needs no override: the shipped /etc/pkg/5BSD.conf
# already points here, and pkg update/upgrade -r 5BSD-base selects it even
# while disabled. Copy this file to /usr/local/etc/pkg/repos/5BSD.conf only
# if you want to change the URL or include base in ordinary pkg updates.
# Keep the same repository name; adjust the URL to the published catalogue.
# Keep FreeBSD-base and FreeBSD-ports-kmods disabled.
5BSD-base: {
  url: "file:///usr/obj/usr/src/repo/${ABI}/latest",
  enabled: yes,
  priority: 100
}
