# Disable the upstream FreeBSD-base repository so that pkg upgrade
# never replaces locally built 5BSD base packages with upstream ones.
#
# Copy this file to /usr/local/etc/pkg/repos/FreeBSD.conf.
#
# Applications continue to use FreeBSD-ports. Kernel modules must come
# from the matching 5BSD-hardware collection, not FreeBSD-ports-kmods.

FreeBSD-base: { enabled: no }
FreeBSD-ports-kmods: { enabled: no }
