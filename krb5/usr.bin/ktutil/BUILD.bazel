load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")
cc_binary(name = "ktutil",
    srcs = ["//crypto/krb5/src/kadmin/ktutil:ktutil.c", "//krb5/lib/kadmin_common:ktutil_table", "//crypto/krb5/src/kadmin/ktutil:ktutil_funcs.c", "//crypto/krb5/src/kadmin/ktutil:ktutil.h"],
    deps = ["//crypto/krb5/src/include:server_headers", "//crypto/krb5/src/util/ss:headers"] + ['//krb5/lib/krb5:krb5', '//krb5/lib/crypto:k5crypto', '//krb5/util/et:com_err', '//krb5/util/profile:krb5profile_pie', '//krb5/util/support:krb5support', '//krb5/util/ss:krb5ss_pie', '//lib/libsys:sys'],
    dynamic_deps = ['//krb5/lib/krb5:krb5_shared', '//krb5/lib/crypto:k5crypto_shared', '//krb5/util/et:com_err_shared', '//krb5/util/support:krb5support_shared', '//lib/libsys:sys_shared', '//lib/libedit:edit_shared'],
    copts = ["-fPIE"], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "ktutil", manual = "//crypto/krb5/src/man:ktutil.man", package = "kerberos")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//krb5:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=kerberos","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/bin"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

_RUNTIME = ["//krb5/lib/krb5:krb5_shared", "//krb5/lib/crypto:k5crypto_shared", "//krb5/util/et:com_err_shared", "//krb5/util/support:krb5support_shared", "//lib/libedit:edit_shared", "//lib/ncurses/tinfo:tinfo_shared", "//lib/libsys:sys_shared", "//secure/lib/libcrypto:crypto_shared"] + [
    "@bsd_sdk//toolchain:sysroot/" + f for f in ["lib/libc.so.7", "lib/libthr.so.3", "lib/libm.so.5"]]
cc_test(name = "runtime_test", srcs = ["runtime_test.c"], data = [":ktutil", "//krb5/usr.bin/klist:klist"] + _RUNTIME,
    args = ["$(location :ktutil)", "$(location //krb5/usr.bin/klist:klist)"] + ["$(location " + lib + ")" for lib in _RUNTIME],
    linkstatic = True, linkopts = ["-static"], size = "small")
