load("//tools/build/bazel:bsd_template.bzl", "bsd_template")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_compress")

# Target-system paths match krb5/Makefile.inc and util/compile_et/Makefile.
# Generation itself uses Bazel template expansion, without invoking target tools.
bsd_template(name = "script", template = "//crypto/krb5/src/util/et:compile_et.sh",
    output = "compile_et", substitutions = {"@DIR@": "/usr/share/et", "@AWK@": "/usr/bin/awk", "@SED@": "/usr/bin/sed"})
bsd_install_file(name = "install_script", src = ":script", destination = "/usr/bin/compile_et",
    owner = "root", group = "wheel", mode = "0555", install_tags = ["package=kerberos", "dev"])
bsd_compress(name = "manual", src = "//crypto/krb5/src/util/et:compile_et.1",
    output = "compile_et.1.gz", arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip",
    redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(manual = True, name = "install_manual", src = ":manual", destination = "/usr/share/man/man1/compile_et.1.gz",
    owner = "root", group = "wheel", mode = "0444",
    install_tags = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=kerberos-man"], "//conditions:default": ["package=kerberos"]}))
bsd_install_manifest(name = "install_manifest", entries = [":install_script", ":install_manual"], visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//krb5:__pkg__"],
    manifests = [":install_manifest"],
    directories = {"/usr/bin": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=kerberos","dev"]}'},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
