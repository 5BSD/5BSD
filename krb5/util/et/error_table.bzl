"""MIT error tables generated by declared vendor AWK programs."""
def _error_table(ctx):
    if ctx.attr.localedir and not ctx.attr.textdomain:
        fail("localedir requires textdomain, matching compile_et")
    outputs = []
    for extension, generator in [("c", ctx.file.c_generator), ("h", ctx.file.h_generator)]:
        output = ctx.actions.declare_file(ctx.attr.basename + "." + extension)
        ctx.actions.run(
            executable = ctx.executable.awk,
            arguments = ["-f", generator.path, "outfile=" + output.path,
                         "textdomain=" + ctx.attr.textdomain, "localedir=" + ctx.attr.localedir, ctx.file.src.path],
            inputs = [generator, ctx.file.src], tools = ctx.files.runtime,
            outputs = [output], env = {"LC_ALL": "C"},
            use_default_shell_env = False, mnemonic = "MITErrorTable",
        )
        outputs.append(output)
    return [DefaultInfo(files = depset(outputs)),
            OutputGroupInfo(source = depset([outputs[0]]), header = depset([outputs[1]]))]

mit_error_table = rule(implementation = _error_table, attrs = {
    "src": attr.label(allow_single_file = [".et"], mandatory = True),
    "basename": attr.string(mandatory = True),
    "textdomain": attr.string(), "localedir": attr.string(),
    "c_generator": attr.label(allow_single_file = True, default = "//crypto/krb5/src/util/et:et_c.awk"),
    "h_generator": attr.label(allow_single_file = True, default = "//crypto/krb5/src/util/et:et_h.awk"),
    "awk": attr.label(executable = True, cfg = "exec", allow_single_file = True, mandatory = True),
    "runtime": attr.label_list(allow_files = True, cfg = "exec"),
})
