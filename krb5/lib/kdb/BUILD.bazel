load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_import", "cc_test")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load("//krb5/util/et:error_table.bzl", "mit_error_table")
mit_error_table(name = "errors", src = "//crypto/krb5/src/lib/kdb:adb_err.et", basename = "adb_err",
    textdomain = "mit-krb5", awk = "@bsd_sdk//toolchain:awk", runtime = ["@bsd_sdk//toolchain:awk_runtime"])
filegroup(name = "error_source", srcs = [":errors"], output_group = "source")
filegroup(name = "error_header", srcs = [":errors"], output_group = "header")
# Make places the internal profile archive before libkrb5. Preserve that
# private static binding rather than substituting libkrb5's exported profile API.
# The maintained profile target compiles its ordinary archive with -fPIC.
cc_import(name = "private_profile", static_library = "//krb5/util/profile:static_archive")
_DEPS = [':private_profile', '//krb5/lib/rpc:gssrpc', '//krb5/lib/krb5:krb5', '//krb5/lib/crypto:k5crypto', '//krb5/util/et:com_err', '//krb5/util/support:krb5support', '//krb5/lib/gssapi:gssapi_krb5']
cc_library(name = "kdb5",
    srcs = ["//crypto/krb5/src/lib/kdb:" + f for f in ['decrypt_key.c', 'encrypt_key.c', 'iprop_xdr.c', 'kdb5.c', 'kdb_convert.c', 'kdb_cpw.c', 'kdb_default.c', 'kdb_log.c', 'keytab.c']] + [":error_source"],
    hdrs = [":error_header"], includes = ["."],
    deps = ["//crypto/krb5/src/lib/kdb:headers"] + _DEPS,
    local_defines = ["KDB5_USE_LIB_KDB_DB2"],
    linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = [":kdb5"], visibility = ["//visibility:public"])
cc_shared_library(name = "kdb5_shared", deps = [":kdb5"],
    dynamic_deps = ['//krb5/lib/rpc:gssrpc_shared', '//krb5/lib/krb5:krb5_shared', '//krb5/lib/crypto:k5crypto_shared', '//krb5/util/et:com_err_shared', '//krb5/util/support:krb5support_shared', '//krb5/lib/gssapi:gssapi_krb5_shared'],
    shared_lib_name = "libkdb5.so.122", additional_linker_inputs = ["version.map"],
    user_link_flags = ["-Wl,--version-script=$(location version.map)", "-Wl,-z,defs", "-Wl,-soname,libkdb5.so.122"], visibility = ["//visibility:public"])
cc_import(name = "archive_link", static_library = ":static_archive")
cc_test(name = "t_stringattr", srcs = ["//crypto/krb5/src/lib/kdb:t_stringattr.c"],
    deps = [":archive_link", "//crypto/krb5/src/lib/kdb:headers"] + _DEPS,
    dynamic_deps = ["//secure/lib/libcrypto:crypto_shared"], features = ["bsd_test_runtime_paths"],
    env = {"KRB5_CONFIG": "/dev/null", "KRB5_KDC_PROFILE": "/dev/null"},
    copts = ["-UNDEBUG"], size = "small")

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//krb5:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=kerberos","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
