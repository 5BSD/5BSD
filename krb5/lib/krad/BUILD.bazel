load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_import", "cc_test")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
_DEPS = ['//krb5/lib/krb5:krb5', '//krb5/lib/crypto:k5crypto', '//krb5/util/et:com_err', '//krb5/util/profile:krb5profile', '//krb5/util/support:krb5support', '//krb5/util/verto:verto']
cc_library(
    name = "krad",
    srcs = ["//crypto/krb5/src/lib/krad:" + f for f in ["attr.c", "attrset.c", "client.c", "code.c", "packet.c", "remote.c"]],
    deps = ["//crypto/krb5/src/lib/krad:headers"] + _DEPS,
    linkstatic = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
)
bsd_component_archive(name = "static_archive", groups = [":krad"], visibility = ["//visibility:public"])
cc_shared_library(
    name = "krad_shared",
    deps = [":krad"],
    dynamic_deps = ['//krb5/lib/krb5:krb5_shared', '//krb5/lib/crypto:k5crypto_shared', '//krb5/util/et:com_err_shared', '//krb5/util/support:krb5support_shared', '//krb5/util/verto:verto_shared'],
    shared_lib_name = "libkrad.so.122",
    additional_linker_inputs = ["version.map"],
    user_link_flags = ["-Wl,--version-script=$(location version.map)", "-Wl,-z,defs", "-Wl,-soname,libkrad.so.122"],
    visibility = ["//visibility:public"],
)
cc_import(name = "archive_link", static_library = ":static_archive")
[cc_test(
    name = "t_" + case,
    srcs = ["//crypto/krb5/src/lib/krad:t_" + case + ".c", "//crypto/krb5/src/lib/krad:t_test.c"],
    deps = [":archive_link", "//crypto/krb5/src/lib/krad:test_headers"] + _DEPS,
    dynamic_deps = ["//secure/lib/libcrypto:crypto_shared"],
    features = ["bsd_test_runtime_paths"],
    copts = ["-UNDEBUG"],
    size = "small",
) for case in ["attr", "attrset", "code"]]

load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=kerberos","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
