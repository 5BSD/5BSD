cc_shared_library(name = "k5crypto_shared", deps = [":k5crypto"],
    dynamic_deps = ["//krb5/util/et:com_err_shared", "//krb5/util/support:krb5support_shared", "//secure/lib/libcrypto:crypto_shared"],
    shared_lib_name = "libk5crypto.so.122", additional_linker_inputs = ["version.map"],
