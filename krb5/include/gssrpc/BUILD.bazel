load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(
    name = "types",
    hdrs = ["types.h"],
    strip_include_prefix = ".",
    include_prefix = "gssrpc",
    visibility = ["//visibility:public"],
)

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest")
_HEADERS = ['auth.h', 'auth_gss.h', 'auth_gssapi.h', 'auth_unix.h', 'clnt.h', 'netdb.h', 'pmap_clnt.h', 'pmap_prot.h', 'pmap_rmt.h', 'rename.h', 'rpc_msg.h', 'rpc.h', 'svc_auth.h', 'svc.h', 'xdr.h']
[bsd_install_file(
    name = "install_" + h,
    src = "//crypto/krb5/src/include/gssrpc:" + h,
    destination = "/usr/include/gssrpc/" + h,
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=kerberos", "dev"],
) for h in _HEADERS]
bsd_install_file(name = "install_types", src = "types.h", destination = "/usr/include/gssrpc/types.h",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=kerberos", "dev"])
bsd_install_manifest(name = "install_manifest", entries = [":install_" + h for h in _HEADERS] + [":install_types"], visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
