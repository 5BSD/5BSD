load("@rules_cc//cc:defs.bzl", "cc_library")
load("//krb5/util/et:error_table.bzl", "mit_error_table")
load(":header.bzl", "krb5_header")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest")
CORE_ERRORS = ['krb5_err', 'k5e1_err', 'kdb5_err', 'kv5m_err', 'krb524_err', 'asn1_err']
PLUGINS = ['ccselect_plugin.h', 'certauth_plugin.h', 'clpreauth_plugin.h', 'hostrealm_plugin.h', 'kadm5_auth_plugin.h', 'kadm5_hook_plugin.h', 'kdcpolicy_plugin.h', 'kdcpreauth_plugin.h', 'localauth_plugin.h', 'locate_plugin.h', 'plugin.h', 'preauth_plugin.h', 'pwqual_plugin.h']
[
    mit_error_table(name = table, src = "//crypto/krb5/src/lib/krb5/error_tables:" + table + ".et", basename = table,
        textdomain = "mit-krb5", awk = "@bsd_sdk//toolchain:awk", runtime = ["@bsd_sdk//toolchain:awk_runtime"], visibility = ["//krb5:__subpackages__", "//crypto/krb5/src/include:__pkg__"])
    for table in CORE_ERRORS
]
[
    mit_error_table(name = "gssapi_err_" + kind, src = "//crypto/krb5/src/lib/gssapi/" + kind + ":gssapi_err_" + kind + ".et", basename = "gssapi_err_" + kind,
        textdomain = "mit-krb5", awk = "@bsd_sdk//toolchain:awk", runtime = ["@bsd_sdk//toolchain:awk_runtime"])
    for kind in ["generic", "krb5"]
]
[filegroup(name = table + "_header", srcs = [":" + table], output_group = "header") for table in CORE_ERRORS + ["gssapi_err_generic", "gssapi_err_krb5"]]
krb5_header(name = "public_header", interface = "//crypto/krb5/src/include/krb5:krb5.hin",
    error_headers = [":" + table + "_header" for table in CORE_ERRORS],
    cat = "@bsd_sdk//toolchain:cat", redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:cat_runtime"])
cc_library(name = "headers", hdrs = [":public_header"],
    strip_include_prefix = ".", include_prefix = "krb5", deps = ["//crypto/krb5/src/include:support_headers", "//crypto/krb5/src/include/krb5:plugin_headers", "//crypto/krb5/src/util/et:headers"], visibility = ["//krb5:__subpackages__", "//crypto/krb5/src/include:__pkg__"])
_FILES = {h: "//crypto/krb5/src/include/krb5:" + h for h in PLUGINS}
_FILES.update({"krb5.h": ":public_header", "gssapi_err_generic.h": ":gssapi_err_generic_header", "gssapi_err_krb5.h": ":gssapi_err_krb5_header"})
[bsd_install_file(name = "install_" + h, src = src, destination = "/usr/include/krb5/" + h,
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=kerberos", "dev"]) for h, src in _FILES.items()]
bsd_install_manifest(name = "install_manifest", entries = [":install_" + h for h in _FILES], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
