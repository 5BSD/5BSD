load("@rules_cc//cc:defs.bzl", "cc_binary")
cc_binary(name = "krb5kdc",
    srcs = ["//crypto/krb5/src/kdc:" + f for f in ['authind.c', 'cammac.c', 'dispatch.c', 'do_as_req.c', 'do_tgs_req.c', 'extern.c', 'fast_util.c', 'kdc_audit.c', 'kdc_authdata.c', 'kdc_log.c', 'kdc_preauth.c', 'kdc_preauth_ec.c', 'kdc_preauth_encts.c', 'kdc_transit.c', 'kdc_util.c', 'main.c', 'ndr.c', 'policy.c', 'replay.c', 'tgs_policy.c', 'kdc_audit.h', 'extern.h', 'realm_data.h', 'reqstate.h', 'policy.h', 'kdc_util.h']],
    deps = ["//crypto/krb5/src/include/krb5:kdc_internal_plugin_headers", "//crypto/krb5/src/include:server_headers", "//crypto/krb5/src/include:database_headers", "//crypto/krb5/src/lib/kadm5:headers"] + ['//krb5/lib/kadm5srv:kadm5srv_mit', '//krb5/lib/rpc:gssrpc', '//krb5/lib/gssapi:gssapi_krb5', '//krb5/lib/krb5:krb5', '//krb5/lib/kdb:kdb5', '//krb5/lib/crypto:k5crypto', '//krb5/util/et:com_err', '//krb5/util/support:krb5support', '//krb5/lib/apputils:apputils_pie', '//krb5/util/verto:verto', '//krb5/util/profile:krb5profile', '//lib/msun:m', '//lib/libsys:sys'],
    dynamic_deps = ['//krb5/lib/kadm5srv:kadm5srv_mit_shared', '//krb5/lib/rpc:gssrpc_shared', '//krb5/lib/gssapi:gssapi_krb5_shared', '//krb5/lib/krb5:krb5_shared', '//krb5/lib/kdb:kdb5_shared', '//krb5/lib/crypto:k5crypto_shared', '//krb5/util/et:com_err_shared', '//krb5/util/support:krb5support_shared', '//krb5/util/verto:verto_shared', '//lib/msun:m_shared', '//lib/libsys:sys_shared'],
    copts = ["-fPIE"], local_defines = ['LIBDIR="/usr/lib"'], linkopts = ["-pie"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
utility_installation(name = "install_manifest", program = "krb5kdc", manual = "//crypto/krb5/src/man:krb5kdc.man", man_section = "8", package = "kerberos-kdc", bindir = "/usr/libexec")

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    visibility = ["//krb5:__pkg__"],
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=kerberos-kdc","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/libexec"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
