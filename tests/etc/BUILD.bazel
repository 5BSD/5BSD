load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest")
load("//tools/build/bazel:bsd_test_installation.bzl", "bsd_test_install_archive")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive_set")
# Make selects the maintained auto-discovery Kyuafile through its .PATH.
bsd_install_file(name = "kyuafile_install", src = "//tests:Kyuafile", destination = "/usr/tests/etc/Kyuafile",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=tests"])
bsd_install_manifest(name = "install_manifest", entries = [":kyuafile_install"])
bsd_test_install_archive(name = "install_archive", directory = "/usr/tests/etc", manifests = [":install_manifest"])
bsd_install_archive_set(name = "installation_archives", archives = [":install_archive", "//tests/etc/rc.d:install_archive"],
    visibility = ["//tests:__pkg__"])
