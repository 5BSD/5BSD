load("//tests/sys/fs:suite.bzl", "filesystem_test_suite")
load("//tools/build/bazel:bsd_sed_output.bzl", "bsd_sed_output")
bsd_sed_output(name = 'misc_body', template = '//contrib/pjdfstest:tests/misc.sh', output = 'misc_body.out',
    arguments = ['-e', '\\,maindir=,s,maindir=.*,maindir=`dirname $0`/../,'], sed = "@bsd_sdk//toolchain:sed", redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:sed_runtime"])

filesystem_test_suite(directory = '/usr/tests/sys/pjdfstest',
    files = {'conf': 'conf', 'misc.sh': ':misc_body'},
    subdirectories = ['chflags', 'chmod', 'chown', 'ftruncate', 'granular', 'link', 'mkdir', 'mkfifo', 'mknod', 'open', 'rename', 'rmdir', 'symlink', 'truncate', 'unlink', 'utimensat'],
    child_archives = ['//tests/sys/pjdfstest/tests/chflags:installation_archives', '//tests/sys/pjdfstest/tests/chmod:installation_archives', '//tests/sys/pjdfstest/tests/chown:installation_archives', '//tests/sys/pjdfstest/tests/ftruncate:installation_archives', '//tests/sys/pjdfstest/tests/granular:installation_archives', '//tests/sys/pjdfstest/tests/link:installation_archives', '//tests/sys/pjdfstest/tests/mkdir:installation_archives', '//tests/sys/pjdfstest/tests/mkfifo:installation_archives', '//tests/sys/pjdfstest/tests/mknod:installation_archives', '//tests/sys/pjdfstest/tests/open:installation_archives', '//tests/sys/pjdfstest/tests/rename:installation_archives', '//tests/sys/pjdfstest/tests/rmdir:installation_archives', '//tests/sys/pjdfstest/tests/symlink:installation_archives', '//tests/sys/pjdfstest/tests/truncate:installation_archives', '//tests/sys/pjdfstest/tests/unlink:installation_archives', '//tests/sys/pjdfstest/tests/utimensat:installation_archives'],
    symlinks = {"tests": "."},
)
