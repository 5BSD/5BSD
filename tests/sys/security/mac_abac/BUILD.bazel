# SPDX-License-Identifier: BSD-2-Clause
# Build/install only: these tests alter mandatory policy and run in a VM.
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_script_wrapper")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest", "bsd_kyuafile")
load("//tools/build/bazel:bsd_test_installation.bzl", "bsd_test_install_archive")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")

_PLATFORM = ["@platforms//os:freebsd"] + select({
    "@platforms//cpu:x86_64": [], "@platforms//cpu:aarch64": [],
    "//conditions:default": ["@platforms//:incompatible"],
})
_PROGRAMS = ["parser_test", "kernel_test", "mprotect_test", "signal_context_test"]
_DIRECTORY = "/usr/tests/sys/security/mac_abac"

[cc_binary(name = program,
    srcs = [program + ".c"] + (["//usr.sbin/mac_abacd:parse_line.c"] if program == "parser_test" else []),
    deps = ["//sys/security/mac_abac:abi_headers", "//lib/atf/libatf-c:atf_c"] +
        (["//usr.sbin/mac_abacd:parser_headers"] if program == "parser_test" else []),
    dynamic_deps = ["//lib/atf/libatf-c:atf_c_shared"],
    copts = ["-fPIE"], linkopts = ["-pie"], linkstatic = True,
    target_compatible_with = _PLATFORM) for program in _PROGRAMS]
[utility_installation(name = program + "_install", program = program, manual = None,
    package = "mac-abac-tests", bindir = _DIRECTORY) for program in _PROGRAMS]

bsd_script_wrapper(name = "smoke_test", body = "smoke_test.sh", interpreter = "/usr/libexec/atf-sh",
    cat = "@bsd_sdk//toolchain:cat", cat_runtime = ["@bsd_sdk//toolchain:cat_runtime"],
    redirect = "@bsd_sdk//toolchain:stdout_redirect")
bsd_install_file(name = "script_install", src = ":smoke_test", destination = _DIRECTORY + "/smoke_test",
    owner = "root", group = "wheel", mode = "0555", install_tags = ["package=mac-abac-tests"])
bsd_kyuafile(name = "kyuafile", suite = "FreeBSD", names = sorted(_PROGRAMS + ["smoke_test"]),
    interfaces = {program: "atf" for program in _PROGRAMS + ["smoke_test"]},
    metadata = {program: json.encode({"required_user": "root", "required_kmods": "mac_abac", "is_exclusive": "true"})
        for program in ["smoke_test", "kernel_test", "mprotect_test", "signal_context_test"]})
bsd_install_file(name = "kyuafile_install", src = ":kyuafile", destination = _DIRECTORY + "/Kyuafile",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=mac-abac-tests"])
bsd_install_manifest(name = "install_manifest", entries = [":script_install", ":kyuafile_install"],
    manifests = [":" + program + "_install" for program in _PROGRAMS])
bsd_test_install_archive(name = "install_archive", directory = _DIRECTORY,
    manifests = [":install_manifest"], debug = True, package = "mac-abac-tests",
    visibility = ["//tests/sys/security:__pkg__"])
