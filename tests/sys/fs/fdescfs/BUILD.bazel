load("//tests/sys/fs:suite.bzl", "filesystem_test_suite")
load("//tools/build/bazel:bsd_sed_output.bzl", "bsd_sed_output")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
_PLATFORM = ["@platforms//os:freebsd"] + select({
    "@platforms//cpu:x86_64": [], "@platforms//cpu:aarch64": [],
    "//conditions:default": ["@platforms//:incompatible"],
})
cc_binary(name = 'fdescfs_test', srcs = ['fdescfs_test.c'],
    deps = ['//lib/atf/libatf-c:atf_c', '//lib/libutil:util'], dynamic_deps = ['//lib/atf/libatf-c:atf_c_shared', '//lib/libutil:util_shared'],
    copts = ['-fPIE'], local_defines = [],
    linkopts = ["-pie"], linkstatic = True, target_compatible_with = _PLATFORM)
utility_installation(name = 'fdescfs_test_install', program = 'fdescfs_test', manual = None, package = "tests", bindir = '/usr/tests/sys/fs/fdescfs')
cc_binary(name = 'fdpath_test', srcs = ['fdpath_test.c'],
    deps = ['//lib/atf/libatf-c:atf_c', '//lib/libutil:util'], dynamic_deps = ['//lib/atf/libatf-c:atf_c_shared', '//lib/libutil:util_shared'],
    copts = ['-fPIE'], local_defines = [],
    linkopts = ["-pie"], linkstatic = True, target_compatible_with = _PLATFORM)
utility_installation(name = 'fdpath_test_install', program = 'fdpath_test', manual = None, package = "tests", bindir = '/usr/tests/sys/fs/fdescfs')

filesystem_test_suite(directory = '/usr/tests/sys/fs/fdescfs',
    interfaces = {'fdescfs_test': 'atf', 'fdpath_test': 'atf'}, metadata = {'fdescfs_test': {}, 'fdpath_test': {}},
    extra_manifests = [':fdescfs_test_install', ':fdpath_test_install'], debug = True,
)
