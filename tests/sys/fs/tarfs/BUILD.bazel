load("//tests/sys/fs:suite.bzl", "filesystem_test_suite")
load("//tools/build/bazel:bsd_sed_output.bzl", "bsd_sed_output")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
_PLATFORM = ["@platforms//os:freebsd"] + select({
    "@platforms//cpu:x86_64": [], "@platforms//cpu:aarch64": [],
    "//conditions:default": ["@platforms//:incompatible"],
})
cc_binary(name = 'mktar', srcs = ['mktar.c'],
    deps = [], dynamic_deps = [],
    copts = ['-fPIE'], local_defines = [],
    linkopts = ["-pie"], linkstatic = True, target_compatible_with = _PLATFORM)
utility_installation(name = 'mktar_install', program = 'mktar', manual = None, package = "tests", bindir = '/usr/tests/sys/fs/tarfs')
cc_binary(name = 'tarsum', srcs = ['tarsum.c'],
    deps = [], dynamic_deps = [],
    copts = ['-fPIE'], local_defines = [],
    linkopts = ["-pie"], linkstatic = True, target_compatible_with = _PLATFORM)
utility_installation(name = 'tarsum_install', program = 'tarsum', manual = None, package = "tests", bindir = '/usr/tests/sys/fs/tarfs')

filesystem_test_suite(directory = '/usr/tests/sys/fs/tarfs',
    scripts = {'tarfs_test': 'tarfs_test.sh'}, atf_shell = {'tarfs_test': True},
    interfaces = {'tarfs_test': 'atf'}, metadata = {'tarfs_test': {}},
    extra_manifests = [':mktar_install', ':tarsum_install'], debug = True,
)
