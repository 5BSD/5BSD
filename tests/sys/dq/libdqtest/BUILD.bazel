#
# The queue access checks of the dq test support library, for the native
# libdq tests (lib/libdq/tests).  libdqtest.a itself and tests/sys/dq are
# built by make only.
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "access", srcs = ["dqt_access.c"], hdrs = ["dq_test.h"],
    deps = ["//lib/libdq:headers", "//lib/atf/libatf-c:atf_c"],
    strip_include_prefix = ".", linkstatic = True,
    visibility = ["//lib/libdq/tests:__pkg__"])
