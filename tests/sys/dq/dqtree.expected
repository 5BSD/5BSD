# Expected differences between a test suite run in a served root
# (dqtree: dq_serve_tree() serving a directory as the root and cwd, stage
# 1c-iii-c) and the same run in chroot(8) of that directory (plan 10
# iii-c).  One extended regular expression per line, matched against
# "suite/program:case result"; dqpass.expected's rows apply too.  Each
# group names the rule that makes the difference, and every entry ends in
# its owner, "# ux-N[ D###]: cause" or "# by-design D###: reason";
# dq_tree_suites_test fails on an entry without one and counts the
# differences each owner still holds.

# Q11: dq_serve_tree checks a requester's access to parent directories
# with its effective uid and gid only; supplementary groups are not seen.
# Q13: a path stat(2) of a served object can show set-id bits and device
# numbers that fstat(2) of its descriptor does not.  No case of the
# default suites differs for either (getgroups, setid and st_rdev cases
# agree); entries are added by name when one does.

# D201: statfs(2) of a served name presents f_mntonname against the served
# root ("/dev" for the tree's devfs), while fstatfs(2) of the device, FIFO
# or pts master descriptor dqtree passes through is the real vnode's and
# keeps chroot(8)'s raw name (kern_do_statfs is untouched).  chroot shows
# the raw name both ways.
^fstatfs_test:(devfs_node|fifo|pts_master_ptmx)[[:space:]]  # ux-7 D201: a served name's f_mntonname is presented, a passed-through descriptor's is raw

# D166: no vnode MAC hooks for served objects.
^fsetattr_test:fchmod_fchown_mac_first[[:space:]]  # by-design D166: a served file is checked by mac_file_check_setattr, not the vnode hooks the case counts
^fsetattr_test:times_none_mac[[:space:]]  # by-design D166: a served file is checked by mac_file_check_setattr, not the vnode hooks the case counts

# The sys/file differences still owned by a sub-series of the Unix-
# illusion plan (stage 1c-iii-c, run 58; owners from the plan's 0z rows
# D244-D250), one per line, tagged "case  # ux-N D###: cause" or
# "case  # by-design D###: reason".  dq_tree_suites_test counts the
# differences each tag still owns.  Paths are relative to the tree.

# dq_serve_lock emulates flock and POSIX locks with OFD locks on a
# per-owner reopen of the backing file (lib/libdq/libdq_serve.c).
^advlock_fd_test:directory[[:space:]]  # ux-0 D247: flock(LOCK_EX) on a served directory: an OFD write lock on the read-only reopen of a directory (libdq_serve.c), base allows
^flock_test:main[[:space:]]  # ux-0 D247: lock events on flock_helper's open-unlinked temp file answer EIO (owner reopen libdq_serve.c, dq_serve_map EIO); test 2's parent then blocks reading its own pipe (flock_helper.c), a test-side wait, not a kernel hang

# A kernel consumer's relative path from a served cwd (nmount's fspath).
^fsetattr_test:fdescfs_(fifo|kqueue|mac_target|no_attributes|opath|ptmx_direct|ptmx_nonowner|regular_file|shm)[[:space:]]  # by-design D175: mount(2) "fspath" from a served cwd is a class-2 path, EXDEV (kern_dqres.c)
^fsetattr_test:fdesc_setattr_atomic[[:space:]]  # by-design D175: the case mounts fdescfs the same way

# Requester credentials (ux-6, items 3 and N1).
^path_test:path_directory_not_root[[:space:]]  # ux-6: the directory the unprivileged requester made is owned by the controller (N1), chmod needs DQ_SAPRIV_ADMIN (kern_dqres.c): EPERM
^path_test:path_empty_not_root[[:space:]]  # ux-1 D249: chflagsat(/dev/null O_PATH, "", AT_EMPTY_PATH) EACCES from dq_serve_tree (likely its F_ROOT outside rule, libdq_tree.c) before base's privilege EPERM

# A REAL-answered (backing) descriptor used as an AT_EMPTY_PATH start
# under a served root is consulted as a real-start name.
^path_test:path_unix[[:space:]]  # ux-1 D249: fstatat(O_PATH socket, "", AT_EMPTY_PATH) EACCES (likely dq_tree_outside, libdq_tree.c)
^path_test:path_capsicum_empty[[:space:]]  # ux-1 D250: openat(O_PATH served dir, "", O_EMPTY_PATH) in capability mode refused: D164's reopen is a consultation under STRICTREL

# linkat(2) of a served descriptor (D203).
^path_test:path_empty_root[[:space:]]  # ux-8: linkat(served O_PATH, "", AT_EMPTY_PATH) EXDEV (vfs_syscalls.c), item 14 (D203)

# kqueue and identity on served objects (ux-5).
^path_test:path_event[[:space:]]  # ux-5: no NOTE_DELETE on a served object after funlinkat (plan 6, D198); kevent with no timeout (path_test.c) waits forever, a test-side wait
^path_test:path_unlinked[[:space:]]  # ux-5: the served identity keeps st_nlink 1 after unlink: no SETIDENT push from dq_serve_tree (plan 6)

# SCM_RIGHTS of a served descriptor (plan 12: excluded until series iv).
^path_test:path_rights[[:space:]]  # by-design D159: served descriptors are installed CAP_XFER_NONE until stage 1c-iv (I6; kern_dqres.c), sendmsg ENOTCAPABLE

# lib/libc/gen (run 59).  The unprivileged tests' own chmod(2) of a file
# or directory they created fails EPERM: dq_serve_tree creates it with
# the controller's credential (N1), so dq_setattr_check's VADMIN test
# (sys/dev/dq/dq_file.c) refuses a requester that is not its owner;
# and the tree applies no requester DAC (item 3), so a mode that should
# lock the requester out does not.
^fts_regress_test:read_no_exec_dir[[:space:]]  # ux-6 N1: chmod("dir", 0400) EPERM, the controller owns "dir" (dq_file.c)
^fts_regress_test:readdir_error_detected[[:space:]]  # ux-6 N1: chmod("dir", 0100) EPERM, the controller owns "dir" (dq_file.c)
^glob2_test:glob_callback[[:space:]]  # ux-6 N1: chmod("test", 0) EPERM, the controller owns "test" (dq_file.c)
^glob_blocks_test:glob_b_callback[[:space:]]  # ux-6 N1: chmod("test", 0) EPERM, the controller owns "test" (dq_file.c)
^realpath2_test:realpath_partial[[:space:]]  # ux-6 N1: chmod("foo", 000) EPERM, the controller owns "foo" (dq_file.c)
^posix_spawn_test:posix_spawnp_eacces[[:space:]]  # ux-6 N1: the unchecked chmod("unsearchable", 0444) fails EPERM, so the directory stays searchable and the spawn succeeds
^fts_misc_test:fts_unrdir(_nochdir)?[[:space:]]  # ux-6: mkdir("dir/unr", 0100) by an unprivileged requester; dq_serve_tree reads it with the controller's credential (no requester DAC, item 3), so FTS_DP where FTS_DNR
^fts_misc_test:xdev[[:space:]]  # by-design D175: nmount(2) "fspath" from a served cwd is a class-2 path, EXDEV (kern_dqres.c); the test skips

# bin/ls (run 60).  ls_tests runs unprivileged; its own mkdir -m (and
# childerr's chmod 0) of a directory it created is EPERM: the identity is
# the controller's (N1).  All 28 cases fail there, before any ls(1) run.
^ls_tests:(1_flag|A_flag|C_flag|F_flag|H_flag|I_flag|R_flag|S_flag|T_flag|a_flag|childerr|d_flag|f_flag|h_flag|i_flag|k_flag|lcomma_flag|m_flag|o_flag|p_flag|q_flag_and_w_flag|r_flag|s_flag|t_flag|u_flag|v_flag|x_flag|y_flag)[[:space:]]  # ux-6 N1: mkdir -m chmods the new directory; the identity is the controller's (dq_file.c)

# usr.bin/find (run 61).  setextattr(8) of a name in the served tree is
# refused EOPNOTSUPP: dq_serve_tree answers every XATTR consultation so
# (lib/libdq/libdq_tree.c), and served objects carry no extended
# attributes until ux-9 (DQ_OP_EXTATTR); the tests skip.  The entries
# name the case, so they match its lines on both sides of the diff.
^find_test:find_xattr[[:space:]]  # ux-9: setextattr EOPNOTSUPP from dq_serve_tree (libdq_tree.c), the test skips
^find_test:find_xattrname[[:space:]]  # ux-9: setextattr EOPNOTSUPP from dq_serve_tree (libdq_tree.c), the test skips
