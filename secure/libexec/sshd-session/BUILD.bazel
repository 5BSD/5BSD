# SPDX-License-Identifier: BSD-2-Clause
load("//tools/build/bazel:bsd_nis.bzl", "nis_runtime_deps", "nis_runtime_linkopts")
load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_import")
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_header", "bsd_dtrace_cc_objects")
load("//tools/build/bazel:bsd_utility_installation.bzl", "utility_installation")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
config_setting(name = "heimdal_flags", flag_values = {"//tools/build/bazel/config:crypt": "true", "//tools/build/bazel/config:openssl": "true", "//tools/build/bazel/config:mitkrb5": "false"})
selects.config_setting_group(name = "heimdal", match_all = [":heimdal_flags", "//tools/build/bazel/config:kerberos_support_enabled"])
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"] + select({":heimdal": ["@platforms//:incompatible"], "//conditions:default": []})
# Keep PAM before SSH, as in the maintained static-link dependency order.
_DEPS = ["//lib/libpam/libpam:pam", "//secure/lib/libssh:ssh", "//lib/libutil:util"] + select({
    "//tools/build/bazel/config:audit_enabled": ["//lib/libbsm:bsm"], "//conditions:default": [],
}) + select({
    "//tools/build/bazel/config:blocklist_support_enabled": ["//lib/libblocklist:blocklist"], "//conditions:default": [],
}) + select({
    "//tools/build/bazel/config:kerberos_support_enabled": ["//krb5/lib/gssapi:gssapi_krb5", "//krb5/lib/krb5:krb5"], "//conditions:default": [],
}) + select({
    "//tools/build/bazel/config:tcp_wrappers_enabled": ["//lib/libwrap:wrap"], "//conditions:default": [],
}) + ["//secure/lib/libcrypto:crypto"]
_DYNAMIC = ["//lib/libpam/libpam:pam_shared", "//secure/lib/libssh:ssh_shared", "//lib/libutil:util_shared"] + select({
    "//tools/build/bazel/config:audit_enabled": ["//lib/libbsm:bsm_shared"], "//conditions:default": [],
}) + select({
    "//tools/build/bazel/config:blocklist_support_enabled": ["//lib/libblocklist:blocklist_shared"], "//conditions:default": [],
}) + select({
    "//tools/build/bazel/config:kerberos_support_enabled": ["//krb5/lib/gssapi:gssapi_krb5_shared", "//krb5/lib/krb5:krb5_shared"], "//conditions:default": [],
}) + select({
    "//tools/build/bazel/config:tcp_wrappers_enabled": ["//lib/libwrap:wrap_shared"], "//conditions:default": [],
}) + ["//secure/lib/libcrypto:crypto_shared"]
bsd_dtrace_header(
    name = "provider", source = "//crypto/openssh:sshauth_provider.d", output = "sshauth_provider.h",
    flags = ["-C", "-x", "nolibs"], object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:bootstrap", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti",
    runtime_libraries = ["//cddl/usr.sbin/dtrace:bootstrap_runtime"],
    tool_inputs = [ "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"], static_anchor = True,
)
cc_library(name = "provider_headers", hdrs = [":provider"], strip_include_prefix = ".")
cc_library(
    name = "objects",
    srcs = ['//crypto/openssh:sshd-session.c', '//crypto/openssh:auth-rhosts.c', '//crypto/openssh:auth-passwd.c', '//crypto/openssh:audit.c', '//crypto/openssh:audit-bsm.c', '//crypto/openssh:audit-linux.c', '//crypto/openssh:platform.c', '//crypto/openssh:sshpty.c', '//crypto/openssh:sshlogin.c', '//crypto/openssh:servconf.c', '//crypto/openssh:serverloop.c', '//crypto/openssh:auth.c', '//crypto/openssh:auth2.c', '//crypto/openssh:auth2-methods.c', '//crypto/openssh:auth-options.c', '//crypto/openssh:session.c', '//crypto/openssh:auth2-chall.c', '//crypto/openssh:groupaccess.c', '//crypto/openssh:auth-bsdauth.c', '//crypto/openssh:auth2-hostbased.c', '//crypto/openssh:auth2-kbdint.c', '//crypto/openssh:auth2-none.c', '//crypto/openssh:auth2-passwd.c', '//crypto/openssh:auth2-pubkey.c', '//crypto/openssh:auth2-pubkeyfile.c', '//crypto/openssh:monitor.c', '//crypto/openssh:monitor_wrap.c', '//crypto/openssh:auth-krb5.c', '//crypto/openssh:auth2-gss.c', '//crypto/openssh:gss-serv.c', '//crypto/openssh:gss-serv-krb5.c', '//crypto/openssh:loginrec.c', '//crypto/openssh:auth-pam.c', '//crypto/openssh:auth-shadow.c', '//crypto/openssh:auth-sia.c', '//crypto/openssh:sftp-server.c', '//crypto/openssh:sftp-common.c', '//crypto/openssh:uidswap.c', '//crypto/openssh:platform-listen.c', '//crypto/openssh:ssh-sk-client.c', '//crypto/openssh:gss-genr.c'] + select({"//tools/build/bazel/config:blocklist_support_enabled": ["//crypto/openssh:blocklist.c"], "//conditions:default": []}),
    deps = _DEPS,
    implementation_deps = select({_TRACE: [":provider_headers"], "//conditions:default": []}),
    additional_compiler_inputs = ["//secure/lib/libssh:ssh_build_config"],
    copts = ["-fPIE", "-include", "$(location //secure/lib/libssh:ssh_build_config)"],
    local_defines = ["OPENSSL_API_COMPAT=0x10100000L"] + select({
        "//tools/build/bazel/config:ldns_enabled": ["HAVE_LDNS=1"], "//conditions:default": [],
    }) + select({
        "//tools/build/bazel/config:tcp_wrappers_enabled": ["LIBWRAP=1"], "//conditions:default": [],
    }) + select({
        "//tools/build/bazel/config:audit_enabled": ["USE_BSM_AUDIT=1", "HAVE_GETAUDIT_ADDR=1"], "//conditions:default": [],
    }) + select({
        "//tools/build/bazel/config:blocklist_support_enabled": ["USE_BLOCKLIST=1"], "//conditions:default": [],
    }) + select({_TRACE: ["WITH_COVERAGE_DTRACE"], "//conditions:default": []}),
    # Make links every program object directly, including callbacks used by DSOs.
    alwayslink = True,
    linkstatic = True,
    target_compatible_with = _PLATFORM,
)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider", provider_object = "sshauth_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group) for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", alwayslink = True, objects = [":regular_objects"], pic_objects = [":pic_objects"], deps = [":provider_link"] + _DEPS)
cc_binary(name = "sshd-session", deps = select({_TRACE: [":traced"], "//conditions:default": [":objects"]}) + nis_runtime_deps(), dynamic_deps = _DYNAMIC, linkopts = ["-pie"] + nis_runtime_linkopts(), target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
utility_installation(name = "install_manifest", program = "sshd-session", manual = None, package = "ssh", bindir = "/usr/libexec")
bsd_install_archive(name = "install_archive", manifests = [":install_manifest"],
    directories = {d: json.encode({"owner": "root", "group": "wheel", "mode": "0755", "tags": ["package=ssh", "dbg"]}) for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/libexec"]},
    mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr", "//etc/mtree:BSD.include.dist": "/usr/include", "//etc/mtree:BSD.debug.dist": "/usr/lib"},
    passwd = "//etc:master.passwd", group = "//etc:group", mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])
