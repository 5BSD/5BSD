load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
load("//tools/build/bazel:bsd_nis.bzl", "nis_runtime_libraries")
cc_binary(name = "native_sftp_test", srcs = ["native_sftp_test.c"],
    deps = ["//lib/atf/libatf-c:atf_c"], dynamic_deps = ["//lib/atf/libatf-c:atf_c_shared"],
    copts = ["-fPIE"], linkopts = ["-pie"], testonly = True,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"])
[bsd_atf_test(name = "sftp_" + case, case_name = case, body = ":native_sftp_test", interface = "program",
    config_files = {"//secure/usr.bin/sftp:sftp": "sftp", "//secure/libexec/sftp-server:sftp-server": "server"},
    runtime_lib = ["//secure/lib/libssh:ssh_shared", "//secure/lib/libssl:ssl_shared", "//secure/lib/libcrypto:crypto_shared",
        "//lib/libcrypt:crypt_shared", "//lib/libmd:md_shared", "//lib/libz:z_shared", "//lib/libedit:edit_shared",
        "//lib/ncurses/tinfo:tinfo_shared", "//lib/atf/libatf-c:atf_c_shared",
        "@bsd_sdk//toolchain:sysroot/lib/libthr.so.3"] + nis_runtime_libraries() + select({"//tools/build/bazel/config:ldns_enabled": ["//lib/libldns:ldns_shared"], "//conditions:default": []}),
    runner = "//tools/build/bazel:atf_runner", size = "small") for case in ["transfer", "readonly"]]
test_suite(name = "sftp_tests", tests = [":sftp_transfer", ":sftp_readonly"], visibility = ["//visibility:public"])
