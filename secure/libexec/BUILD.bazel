_ARCHIVES = select({"//tools/build/bazel/config:openssh_enabled": ["//secure/libexec/sftp-server:install_archive", "//secure/libexec/ssh-keysign:install_archive", "//secure/libexec/ssh-pkcs11-helper:install_archive", "//secure/libexec/sshd-session:install_archive", "//secure/libexec/sshd-auth:install_archive"], "//conditions:default": []}) + select({":ssh_usb": ["//secure/libexec/ssh-sk-helper:install_archive"], "//conditions:default": []})
production_archives(_ARCHIVES)
