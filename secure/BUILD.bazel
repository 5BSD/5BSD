exports_files(["ssh_program.bzl"], visibility = ["//secure:__subpackages__"])

load(":production.bzl", "production_archives")
_FAMILIES = ["//secure/lib", "//secure/libexec", "//secure/usr.bin", "//secure/usr.sbin"]
_CAROOT = select({"//tools/build/bazel/config:caroot_enabled": ["//secure/caroot:production_install_archive"], "//conditions:default": []})
production_archives([family + ":production_installation_archives" for family in _FAMILIES] + _CAROOT,
    candidates = [family + ":installation_candidates" for family in _FAMILIES] + _CAROOT)
filegroup(name = "production_products", srcs = [":production_installation_archives", "//secure/lib:production_libraries"], visibility = ["//visibility:public"])
