load("@bazel_skylib//lib:selects.bzl", "selects")
load("//secure:ssh_program.bzl", "ssh_program")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_compress")
config_setting(name = "heimdal_flags", flag_values = {"//tools/build/bazel/config:crypt": "true", "//tools/build/bazel/config:openssl": "true", "//tools/build/bazel/config:mitkrb5": "false"})
selects.config_setting_group(name = "heimdal", match_all = [":heimdal_flags", "//tools/build/bazel/config:kerberos_support_enabled"])
bsd_install_file(name = "client_config", src = "//crypto/openssh:ssh_config", destination = "/etc/ssh/ssh_config", owner = "root", group = "wheel", mode = "0644", install_tags = ["package=ssh", "config"])
bsd_compress(name = "config_manual", src = "//crypto/openssh:ssh_config.5", output = "manuals/ssh_config.5.gz", arguments = ["-cn"], compressor = "@bsd_sdk//toolchain:extra_gzip", redirect = "@bsd_sdk//toolchain:stdout_redirect", runtime = ["@bsd_sdk//toolchain:extra_gzip_runtime"])
bsd_install_file(name = "config_manual_file", src = ":config_manual", destination = "/usr/share/man/man5/ssh_config.5.gz", owner = "root", group = "wheel", mode = "0444", install_tags = select({"//tools/build/bazel/config:split_manpages_enabled": ["package=ssh-man"], "//conditions:default": ["package=ssh"]}))
ssh_program(
    name = "ssh",
    srcs = ["//crypto/openssh:ssh.c", "//crypto/openssh:readconf.c", "//crypto/openssh:clientloop.c", "//crypto/openssh:sshtty.c", "//crypto/openssh:sshconnect.c", "//crypto/openssh:sshconnect2.c", "//crypto/openssh:mux.c", "//crypto/openssh:gss-genr.c"],
    deps = ["//secure/lib/libcrypto:crypto"] + select({"//tools/build/bazel/config:kerberos_support_enabled": ["//krb5/lib/gssapi:gssapi_krb5"], "//conditions:default": []}),
    dynamic_deps = ["//secure/lib/libcrypto:crypto_shared"] + select({"//tools/build/bazel/config:kerberos_support_enabled": ["//krb5/lib/gssapi:gssapi_krb5_shared"], "//conditions:default": []}),
    aliases = ["slogin"],
    extra_entries = [":client_config", ":config_manual_file"],
    extra_directories = {"/etc/ssh": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=utilities"]}'},
    # The native MIT graph is available; Heimdal remains an explicit open migration.
    target_compatible_with = select({":heimdal": ["@platforms//:incompatible"], "//conditions:default": []}),
)
