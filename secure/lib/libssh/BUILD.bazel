load("@rules_cc//cc:defs.bzl", "cc_library", "cc_import", "cc_shared_library")
load("//tools/build/bazel:bsd_dtrace.bzl", "bsd_dtrace_header", "bsd_dtrace_cc_objects")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load("//crypto/openssh:sources.bzl", "SSH_SOURCES")
load(":configuration.bzl", "ssh_configuration")
_TRACE = "//tools/build/bazel/config:dtrace_enabled"
_PLATFORM = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"]
_DEPS = ["//crypto/openssh:headers", "//secure/lib/libcrypto:crypto", "//lib/libcrypt:crypt", "//lib/libz:z"] + select({"//tools/build/bazel/config:ldns_enabled": ["//lib/libldns:ldns"], "//conditions:default": []})
ssh_configuration(name = "ssh_build_config", visibility = ["//secure:__subpackages__"], kerberos = "//tools/build/bazel/config:kerberos_support", mit = "//tools/build/bazel/config:mitkrb5", usb = "//tools/build/bazel/config:usb", xauth = "//tools/build/bazel/config:ssh_xauth_path", askpass = "//tools/build/bazel/config:ssh_askpass_path")
bsd_dtrace_header(
    name = "provider", source = "sshkeys_provider.d", output = "sshkeys_provider.h",
    flags = ["-C", "-x", "nolibs"], object_path_mode = "relative",
    dtrace = "//cddl/usr.sbin/dtrace:dtrace", cpp = "@bsd_sdk//toolchain:bin/cpp",
    linker = "@bsd_sdk//toolchain:bin/ld.lld", objcopy = "@bsd_sdk//toolchain:bin/llvm-objcopy",
    drti = "//cddl/lib/drti:drti",
    runtime_libraries = ['//cddl/lib/libdtrace:dtrace_shared', '//cddl/lib/libctf:ctf_shared', '//lib/libelf:elf_shared', '//lib/libproc:proc_shared', '//cddl/lib/libspl:spl_shared', '//lib/libxo/libxo:xo_shared', '//lib/libutil:util_shared', '//lib/libprocstat:procstat_shared', '//lib/librtld_db:rtld_db_shared', '//lib/libcxxrt:cxxrt_shared', '//lib/libz:z_shared', '//lib/libkvm:kvm_shared'],
    tool_inputs = [ "@bsd_sdk//toolchain:compile_inputs",
        "@bsd_sdk//toolchain:link_inputs", "@bsd_sdk//toolchain:objcopy_inputs"], static_anchor = True,
)
cc_library(name = "provider_headers", hdrs = [":provider"], strip_include_prefix = ".")
cc_library(name = "objects", srcs = SSH_SOURCES + select({"//tools/build/bazel/config:ldns_enabled": ["//crypto/openssh:openbsd-compat/getrrsetbyname-ldns.c"], "//conditions:default": ["//crypto/openssh:openbsd-compat/getrrsetbyname.c"]}),
    hdrs = [":ssh_build_config"], additional_compiler_inputs = [":ssh_build_config"], deps = _DEPS,
    implementation_deps = select({_TRACE: [":provider_headers"], "//conditions:default": []}),
    copts = ["-include", "$(location :ssh_build_config)"],
    local_defines = ["OPENSSL_API_COMPAT=0x10100000L"] + select({_TRACE: ["WITH_COVERAGE_DTRACE"], "//conditions:default": []}) + select({"//tools/build/bazel/config:ldns_enabled": ["HAVE_LDNS=1"], "//conditions:default": []}) + select({"//tools/build/bazel/config:tcp_wrappers_enabled": ["LIBWRAP=1"], "//conditions:default": []}),
    linkstatic = True, target_compatible_with = _PLATFORM)
bsd_dtrace_cc_objects(name = "traced_objects", library = ":objects", provider = ":provider", provider_object = "sshkeys_provider", copy_runner = "//tools/build/bazel:dtrace_copy_runner")
[filegroup(name = group, srcs = [":traced_objects"], output_group = group) for group in ["regular_objects", "pic_objects", "regular_provider", "pic_provider"]]
cc_import(name = "provider_link", objects = [":regular_provider"], pic_objects = [":pic_provider"], alwayslink = True)
cc_import(name = "traced", objects = [":regular_objects"], pic_objects = [":pic_objects"], deps = [":provider_link"])
cc_library(name = "ssh", deps = _DEPS + select({_TRACE: [":traced"], "//conditions:default": [":objects"]}), linkstatic = True, target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
bsd_component_archive(name = "static_archive", groups = select({_TRACE: [":traced", ":provider_link"], "//conditions:default": [":objects"]}), visibility = ["//visibility:public"])
cc_shared_library(name = "ssh_shared", deps = [":ssh"], dynamic_deps = ["//secure/lib/libcrypto:crypto_shared", "//lib/libcrypt:crypt_shared", "//lib/libz:z_shared"] + select({"//tools/build/bazel/config:ldns_enabled": ["//lib/libldns:ldns_shared"], "//conditions:default": []}), shared_lib_name = "libprivatessh.so.5",
    user_link_flags = ["-Wl,-soname,libprivatessh.so.5", "-Wl,--fatal-warnings,--warn-shared-textrel"], target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
load(":installation.bzl", "library_installation")
library_installation(name = "install_manifest")
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {d: '{"owner":"root","group":"wheel","mode":"0755","tags":["package=ssh","dbg"]}' for d in ["/usr/lib/debug/usr", "/usr/lib/debug/usr/lib"]},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
