load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library", "cc_shared_library", "cc_test")
load(":buildinfo.bzl", "openssl_buildinfo")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//crypto/openssl:crypto_sources_amd64.bzl", "AMD64_CRYPTO_SOURCES", "AMD64_ASM_SOURCES")
load("//crypto/openssl:crypto_sources_selected.bzl", "AMD64_CORE_SOURCE_ORDER", "AARCH64_CORE_SOURCE_ORDER", "RISCV64_CORE_SOURCE_ORDER")
load("//crypto/openssl:build_config_selected.bzl", "AMD64_CORE_COPTS", "AARCH64_CORE_COPTS", "RISCV64_CORE_COPTS", "AMD64_CORE_ASM_COPTS", "AARCH64_CORE_ASM_COPTS")

config_setting(name = "target_amd64", constraint_values = ["@platforms//cpu:x86_64"])
config_setting(name = "target_aarch64", constraint_values = ["@platforms//cpu:aarch64"])
config_setting(name = "target_riscv64", constraint_values = ["@platforms//cpu:riscv64"])
_PLATFORM = select({
    ":target_amd64": ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    ":target_aarch64": ["@platforms//os:freebsd", "@platforms//cpu:aarch64"],
    ":target_riscv64": ["@platforms//os:freebsd", "@platforms//cpu:riscv64"],
    "//conditions:default": ["@platforms//:incompatible"],
})
_SOURCES = {":target_amd64": AMD64_CORE_SOURCE_ORDER,
    ":target_aarch64": AARCH64_CORE_SOURCE_ORDER, ":target_riscv64": RISCV64_CORE_SOURCE_ORDER}
_ORDINARY_ORDER = {arch: [label.rsplit("/", 1)[-1].rsplit(":", 1)[-1].rsplit(".", 1)[0] + ".o" for label in labels]
    for arch, labels in _SOURCES.items()}
_NIST = "//crypto/openssl:crypto/bn/bn_nist.c"
_ARM_CRYPTO = ["//sys/crypto/openssl/aarch64:" + name + ".S"
    for name in ["arm64cpuid", "aesv8-armx", "ghashv8-armx"]]
_COPTS = select({":target_amd64": AMD64_CORE_COPTS,
    ":target_aarch64": AARCH64_CORE_COPTS, ":target_riscv64": RISCV64_CORE_COPTS})
_ASM_COPTS = select({":target_amd64": AMD64_CORE_ASM_COPTS,
    ":target_aarch64": AARCH64_CORE_ASM_COPTS, ":target_riscv64": []})
_KTLS = select({"//tools/build/bazel/config:openssl_ktls_enabled": [],
    "//conditions:default": ["-DOPENSSL_NO_KTLS"]})
_GROUPS = select({
    ":target_amd64": [":crypto_objects", ":nist_objects", ":asm_objects"],
    ":target_aarch64": [":crypto_objects", ":nist_objects", ":asm_objects", ":arm_crypto_objects"],
    ":target_riscv64": [":crypto_objects", ":nist_objects"],
})

# Existing source inventory label remains explicitly amd64-only.
filegroup(name = "amd64_sources", srcs = AMD64_CRYPTO_SOURCES + AMD64_ASM_SOURCES,
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"])
openssl_buildinfo(name = "buildinfo", target_compatible_with = _PLATFORM,
    visibility = ["//visibility:public"])
cc_library(name = "buildinfo_headers", hdrs = [":buildinfo"],
    strip_include_prefix = "/secure/lib/libcrypto",
    visibility = ["//secure/lib/libssl:__pkg__", "//secure/usr.bin/openssl:__pkg__"])
[
    cc_library(name = name, srcs = sources, linkstatic = True,
        implementation_deps = ["//crypto/openssl:core_compilation_headers", ":buildinfo_headers"],
        copts = flags + _KTLS, features = ["bsd_openssl_pic"],
        target_compatible_with = _PLATFORM)
    for name, sources, flags in [
        ("crypto_objects", select({arch: [label for label in labels if label.endswith(".c") and label != _NIST]
            for arch, labels in _SOURCES.items()}), _COPTS),
        ("nist_objects", [_NIST], _COPTS + ["-fno-strict-aliasing"]),
        ("asm_objects", select({arch: [label for label in labels if label.endswith(".S") and label not in _ARM_CRYPTO]
            for arch, labels in _SOURCES.items()}), _ASM_COPTS),
    ]
]
cc_library(name = "arm_crypto_objects", srcs = _ARM_CRYPTO, linkstatic = True,
    implementation_deps = ["//crypto/openssl:core_compilation_headers", ":buildinfo_headers"],
    copts = AARCH64_CORE_ASM_COPTS + ["-march=armv8-a+crypto"] + _KTLS,
    features = ["bsd_openssl_pic"],
    target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:aarch64"])
bsd_component_archive(name = "static_archive", groups = _GROUPS,
    object_order = select(_ORDINARY_ORDER), target_compatible_with = _PLATFORM,
    visibility = ["//visibility:public"])
bsd_component_archive(name = "pic_archive", groups = _GROUPS, pic = True,
    object_order = select({arch: [name[:-2] + ".pic.o" for name in order]
        for arch, order in _ORDINARY_ORDER.items()}), target_compatible_with = _PLATFORM)
cc_import(name = "archive_link", static_library = ":static_archive", pic_static_library = ":pic_archive",
    visibility = ["//secure/lib/libssl:__pkg__"])
# Static consumers retain pthread; SDK-header consumers need no source API roots.
cc_library(name = "crypto_link", deps = [":archive_link"], linkopts = ["-lpthread"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_library(name = "crypto", deps = [":crypto_link", "//crypto/openssl:headers"],
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])
cc_shared_library(name = "crypto_shared", deps = [":crypto_link"],
    exports_filter = ["//secure/lib/libcrypto:crypto_link", "//secure/lib/libcrypto:archive_link"],
    shared_lib_name = "libcrypto.so.35", additional_linker_inputs = ["Version.map"],
    user_link_flags = ["-fstack-protector-strong", "-Wl,-x", "-Wl,-soname,libcrypto.so.35",
        "-Wl,--fatal-warnings,--warn-shared-textrel",
        "-Wl,--version-script=$(location Version.map),--no-undefined-version", "-lpthread"] +
        select({":target_aarch64": ["-Wl,--fix-cortex-a53-843419"], "//conditions:default": []}),
    target_compatible_with = _PLATFORM, visibility = ["//visibility:public"])

# Existing real source-API tests: only native profiles execute these programs;
# foreign profiles inspect their target artifacts through the host test below.
cc_test(name = "smoke_static", srcs = ["tests/native_smoke.c"], deps = [":crypto"],
    linkstatic = True, size = "small", target_compatible_with = _PLATFORM)
cc_test(name = "smoke_shared", srcs = ["tests/native_smoke.c"], deps = [":crypto"],
    dynamic_deps = [":crypto_shared"], features = ["bsd_test_runtime_paths"],
    size = "small", target_compatible_with = _PLATFORM)
load(":installation.bzl", "crypto_installation")
crypto_installation(name = "install_manifest")

load("//tools/build/bazel:bsd_python_test.bzl", "bsd_host_artifact_test")
write_file(name = "core_member_order", out = "core_member_order.json",
    content = select({arch: [json.encode(order)] for arch, order in _ORDINARY_ORDER.items()}))
bsd_host_artifact_test(name = "archive_contract_test", src = "archive-contract-test.py",
    data = [":static_archive", ":pic_archive", ":crypto_shared", ":smoke_static", ":smoke_shared", ":core_member_order",
        "@bsd_sdk//toolchain:bin/llvm-ar", "@bsd_sdk//toolchain:bin/llvm-nm"],
    args = ["--archive", "$(location :static_archive)", "--pic-archive", "$(location :pic_archive)",
        "--shared", "$(location :crypto_shared)", "--static-consumer", "$(location :smoke_static)",
        "--shared-consumer", "$(location :smoke_shared)", "--ar", "$(location @bsd_sdk//toolchain:bin/llvm-ar)",
        "--nm", "$(location @bsd_sdk//toolchain:bin/llvm-nm)", "--machine"] + select({
            ":target_amd64": ["62"], ":target_aarch64": ["183"], ":target_riscv64": ["243"]}) +
        ["--member-order", "$(location :core_member_order)"],
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:llvm-ar_runtime",
        "@bsd_sdk//toolchain:llvm-nm_runtime"], size = "small")
