"""Reproducible OpenSSL identity from the selected C++ compiler target."""
load("@rules_cc//cc:find_cc_toolchain.bzl", "find_cc_toolchain", "use_cc_toolchain")
load("@rules_cc//cc/common:cc_common.bzl", "cc_common")

_ARCHITECTURES = {"x86_64": "amd64", "aarch64": "aarch64", "riscv64": "riscv64"}

def _impl(ctx):
    toolchain = find_cc_toolchain(ctx)
    features = cc_common.configure_features(ctx = ctx, cc_toolchain = toolchain,
        requested_features = ctx.features + ["bsd_openssl_pic"],
        unsupported_features = ctx.disabled_features)
    if not cc_common.is_enabled(feature_configuration = features, feature_name = "bsd_openssl_pic"):
        fail("OpenSSL requires the selected SDK bsd_openssl_pic feature")
    triple = toolchain.target_gnu_system_name
    parts = triple.split("-")
    if len(parts) < 3 or parts[0] not in _ARCHITECTURES or not parts[-1].startswith("freebsd"):
        fail("unsupported OpenSSL core compiler target: " + triple)
    cpu = parts[0]
    if not ctx.target_platform_has_constraint(getattr(ctx.attr, "cpu_" + cpu)[platform_common.ConstraintValueInfo]):
        fail("OpenSSL compiler target and platform constraints disagree: " + triple)
    output = ctx.actions.declare_file("buildinf.h")
    ctx.actions.write(output, "/* Generated by the native OpenSSL build graph. */\n" +
        "#define PLATFORM " + json.encode("platform: FreeBSD-" + _ARCHITECTURES[cpu]) + "\n" +
        '#define DATE "built on: reproducible build, date unspecified"\n' +
        "static const char compiler_flags[] = " + json.encode("compiler: " + toolchain.compiler) + ";\n")
    return [DefaultInfo(files = depset([output]))]

openssl_buildinfo = rule(implementation = _impl,
    attrs = {"cpu_" + cpu: attr.label(default = "@platforms//cpu:" + cpu,
        providers = [platform_common.ConstraintValueInfo]) for cpu in _ARCHITECTURES},
    toolchains = use_cc_toolchain(), fragments = ["cpp"])
