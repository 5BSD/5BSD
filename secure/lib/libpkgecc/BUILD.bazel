# Make replaces CFLAGS and supplies no optimization option for this library.
[cc_library(name = name, srcs = _SOURCES, deps = ["//crypto/libecc:headers", "//crypto/libecc:internal_headers"],
    local_defines = _DEFINES, copts = ["-O0", "-fno-builtin"] + flags,
    linkstatic = True, visibility = ["//usr.sbin/pkg:__pkg__"])
