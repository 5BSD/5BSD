load("//tools/build/bazel:bsd_atf.bzl", "bsd_atf_test")
[bsd_atf_test(
    name = "native_" + case,
    case_name = case,
    body = "sshd_config_test.sh",
    subr = "//libexec/atf/atf-sh:shell_library",
    config_files = {"//secure/usr.sbin/sshd:sshd": "sshd", "//secure/libexec/sshd-session:sshd-session": "session", "//secure/libexec/sshd-auth:sshd-auth": "auth", "//secure/usr.bin/ssh-keygen:ssh-keygen": "keygen"},
    runtime_bin = ["//usr.bin/dirname:dirname", "//usr.bin/tr:tr", "//bin/sh:sh", "//libexec/atf/atf-sh:atf-sh", "//libexec/atf/atf-check:atf-check"],
    runtime_lib = ['//lib/atf/libatf-c:atf_c_shared', '//lib/atf/libatf-c++:atf_cxx_shared', '//lib/libc++:cxx_shared', '//lib/libcxxrt:cxxrt_shared', '//lib/msun:m_shared', '@bsd_sdk//toolchain:sysroot/lib/libgcc_s.so.1', '@bsd_sdk//toolchain:sysroot/lib/libc.so.7', '@bsd_sdk//toolchain:sysroot/lib/libsys.so.7', '//lib/libthr:thr_shared', '//secure/lib/libcrypto:crypto_shared', '//secure/lib/libssl:ssl_shared', '//secure/lib/libssh:ssh_shared', '//lib/libutil:util_shared', '//lib/libcrypt:crypt_shared', '//lib/libmd:md_shared', '//lib/libz:z_shared', '//lib/libldns:ldns_shared', '//lib/libpam/libpam:pam_shared', '//lib/libbsm:bsm_shared', '//lib/libblocklist:blocklist_shared', '//lib/libwrap:wrap_shared', '//krb5/lib/krb5:krb5_shared', '//krb5/lib/gssapi:gssapi_krb5_shared', '//krb5/lib/crypto:k5crypto_shared', '//krb5/util/et:com_err_shared', '//krb5/util/support:krb5support_shared'],
    runner = "//tools/build/bazel:atf_runner",
    size = "small",
) for case in ["versions", "effective_config", "invalid_config"]]
test_suite(name = "startup_tests", tests = [":native_" + case for case in ["versions", "effective_config", "invalid_config"]], visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_artifacts.bzl", "bsd_script_wrapper")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest")
bsd_script_wrapper(name = "sshd_config_test", body = "sshd_config_test.sh",
    interpreter = "/usr/libexec/atf-sh", cat = "@bsd_sdk//toolchain:cat",
    cat_runtime = ["@bsd_sdk//toolchain:cat_runtime"], redirect = "@bsd_sdk//toolchain:stdout_redirect")
# Share the maintained discovery file with Make, including descendant suites.
filegroup(name = "kyuafile", srcs = ["Kyuafile"])
bsd_install_file(name = "install_shell", src = ":sshd_config_test",
    destination = "/usr/tests/secure/usr.sbin/sshd_config_test", owner = "root", group = "wheel",
    mode = "0555", install_tags = ["package=tests"])
bsd_install_file(name = "install_kyuafile", src = ":kyuafile",
    destination = "/usr/tests/secure/usr.sbin/Kyuafile", owner = "root", group = "wheel",
    mode = "0444", install_tags = ["package=tests"])
bsd_install_manifest(name = "install_manifest", entries = [":install_shell", ":install_kyuafile"], visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive",
    manifests = [":install_manifest"],
    directories = {"/usr/tests/secure/usr.sbin": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=tests"]}'},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.tests.dist": "/usr/tests",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
