# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library")
exports_files(["asctime.c", "difftime.c", "localtime.c"], visibility = ["//lib/libc/stdtime:__pkg__"])
cc_library(name = "headers", hdrs = ["tzconfig.h", "private.h", "tzdir.h", "tzfile.h"], strip_include_prefix = ".", visibility = ["//lib/libc/stdtime:__pkg__"])

cc_library(name = "tzdir_header", hdrs = ["tzdir.h"], strip_include_prefix = ".", visibility = ["//lib/libc/gen:__pkg__", "//lib/libc/tests/stdtime:__pkg__"])

# Maintained manual sources consumed by libc installation.
[filegroup(name = name, srcs = [source], visibility = ["//lib/libc:__pkg__"])
 for name, source in [
    ('libc_manual_time2posix.3', 'time2posix.3'),
    ('libc_manual_tzfile.5', 'tzfile.5'),
]]

# Native operator tools share upstream configuration and version inputs.
exports_files(["zic.c", "zic.8"], visibility = ["//usr.sbin/zic:__pkg__"])
exports_files(["zdump.c", "zdump.8"], visibility = ["//usr.sbin/zdump:__pkg__"])
cc_library(name = "tool_headers", hdrs = ["tzconfig.h", "private.h", "tzdir.h", "tzfile.h", "version.h"], strip_include_prefix = ".", visibility = ["//usr.sbin/zic:__pkg__", "//usr.sbin/zdump:__pkg__"])
