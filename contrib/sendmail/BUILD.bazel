load("//tools/build/bazel:bsd_install.bzl", "bsd_install_directory", "bsd_install_file", "bsd_install_manifest")
load("@rules_cc//cc:defs.bzl", "cc_library")
exports_files(glob(["libsm/*.c"]) + ["include/sm/os/sm_os_freebsd.h", "rmail/rmail.c", "rmail/rmail.8"], visibility = ["//lib/libsm:__pkg__", "//bin/rmail:__pkg__", "//lib/libsmdb:__pkg__", "//lib/libsmutil:__pkg__", "//lib/libmilter:__pkg__"])
cc_library(name = "headers", hdrs = glob(["include/**/*.h", "src/*.h", "libsm/*.h"]), includes = ["include", "src"],
    visibility = ["//lib/libsm:__pkg__", "//bin/rmail:__pkg__", "//lib/libsmdb:__pkg__", "//lib/libsmutil:__pkg__", "//lib/libmilter:__pkg__"])

exports_files(["mail.local/mail.local.c", "mail.local/mail.local.8"], visibility = ["//libexec/mail.local:__pkg__"])
exports_files(["smrsh/smrsh.c", "smrsh/smrsh.8"], visibility = ["//libexec/smrsh:__pkg__"])

exports_files(glob(["libsmdb/*.c", "libsmutil/*.c"]), visibility = ["//lib/libsmdb:__pkg__", "//lib/libsmutil:__pkg__", "//lib/libmilter:__pkg__"])

exports_files(glob(["libmilter/*.c"]) + ["include/libmilter/mfapi.h", "include/libmilter/mfdef.h"], visibility = ["//lib/libmilter:__pkg__"])
cc_library(name = "milter_private_headers", hdrs = glob(["libmilter/*.h"]), visibility = ["//lib/libmilter:__pkg__"])

exports_files(["vacation/vacation.c", "vacation/vacation.1"], visibility = ["//usr.bin/vacation:__pkg__"])

exports_files(['src/alias.c', 'src/arpadate.c', 'src/bf.c', 'src/collect.c', 'src/conf.c', 'src/control.c', 'src/convtime.c', 'src/daemon.c', 'src/deliver.c', 'src/domain.c', 'src/envelope.c', 'src/err.c', 'src/headers.c', 'src/macro.c', 'src/main.c', 'src/map.c', 'src/mci.c', 'src/milter.c', 'src/mime.c', 'src/parseaddr.c', 'src/queue.c', 'src/ratectrl.c', 'src/readcf.c', 'src/recipient.c', 'src/savemail.c', 'src/sasl.c', 'src/sched.c', 'src/sfsasl.c', 'src/shmticklib.c', 'src/sm_resolve.c', 'src/srvrsmtp.c', 'src/stab.c', 'src/stats.c', 'src/sysexits.c', 'src/timers.c', 'src/tlsh.c', 'src/tls.c', 'src/trace.c', 'src/udb.c', 'src/usersmtp.c', 'src/util.c', 'src/version.c', 'src/mailq.1', 'src/newaliases.1', 'src/aliases.5', 'src/sendmail.8', 'editmap/editmap.c', 'editmap/editmap.8', 'mailstats/mailstats.c', 'mailstats/mailstats.8', 'makemap/makemap.c', 'makemap/makemap.8', 'praliases/praliases.c', 'praliases/praliases.8'], visibility = ["//usr.sbin/editmap:__pkg__", "//usr.sbin/mailstats:__pkg__", "//usr.sbin/makemap:__pkg__", "//usr.sbin/praliases:__pkg__", "//usr.sbin/sendmail:__pkg__"])

# Install the maintained cf source subtree as data, matching share/sendmail.
# Source globs track vendor additions without a captured filename inventory.
_CF_EXCLUDES = ["cf/**/CVS", "cf/**/CVS/**", "cf/**/.svn", "cf/**/.svn/**"]
_CF_FILES = glob(["cf/**"], exclude = _CF_EXCLUDES)
_CF_PATHS = glob(["cf", "cf/**"], exclude = _CF_EXCLUDES, exclude_directories = 0)
_CF_DIRECTORIES = [path for path in _CF_PATHS if path not in _CF_FILES]
[bsd_install_file(name = "cf_file_" + str(index), src = path,
    destination = "/usr/share/sendmail/" + path, owner = "root", group = "wheel",
    mode = "0444", install_tags = ["package=sendmail"])
 for index, path in enumerate(_CF_FILES)]
[bsd_install_directory(name = "cf_directory_" + str(index),
    destination = "/usr/share/sendmail/" + path, owner = "root", group = "wheel",
    mode = "0755", install_tags = ["package=sendmail"])
 for index, path in enumerate(_CF_DIRECTORIES)]
bsd_install_manifest(name = "cf_install_manifest",
    entries = [":cf_file_" + str(index) for index in range(len(_CF_FILES))] +
        [":cf_directory_" + str(index) for index in range(len(_CF_DIRECTORIES))],
    visibility = ["//share/sendmail:__pkg__"])
