load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
# Native component of libclang; not an additional installed library.
cc_library(name = "lex", srcs = ["DependencyDirectivesScanner.cpp", "HeaderMap.cpp", "HeaderSearch.cpp", "InitHeaderSearch.cpp", "LexHLSLRootSignature.cpp", "Lexer.cpp", "LiteralSupport.cpp", "MacroArgs.cpp", "MacroInfo.cpp", "ModuleMap.cpp", "ModuleMapFile.cpp", "PPCaching.cpp", "PPCallbacks.cpp", "PPConditionalDirectiveRecord.cpp", "PPDirectives.cpp", "PPExpressions.cpp", "PPLexerChange.cpp", "PPMacroExpansion.cpp", "Pragma.cpp", "PreprocessingRecord.cpp", "Preprocessor.cpp", "PreprocessorLexer.cpp", "ScratchBuffer.cpp", "TokenConcatenation.cpp", "TokenLexer.cpp"], hdrs = ["UnicodeCharSets.h"],
    deps = ["//contrib/llvm-project/clang/include:headers", "//contrib/llvm-project/libcxx/include:headers"],
    copts = ["-std=c++17", "-nostdinc++", "-fno-exceptions", "-fno-rtti", "-fvisibility-inlines-hidden", "-ffunction-sections", "-fdata-sections", "-UPIC"] + select({"//tools/build/bazel/config:llvm_full_debuginfo_enabled": ["-g"], "//conditions:default": ["-gline-tables-only"]}),
    local_defines = ["__STDC_CONSTANT_MACROS", "__STDC_FORMAT_MACROS", "__STDC_LIMIT_MACROS", "HAVE_VCS_VERSION_INC"] + select({"//tools/build/bazel/config:llvm_assertions_enabled": [], "//conditions:default": ["NDEBUG"]}) + select({"//tools/build/bazel/config:clang_full_enabled": ["CLANG_ENABLE_STATIC_ANALYZER"], "//conditions:default": []}),
    linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"], visibility = ["//visibility:public"])
bsd_component_archive(name = "pic_archive", groups = [":lex"], pic = True, visibility = ["//visibility:public"])
