load("@rules_cc//cc:defs.bzl", "cc_library")

# Original upstream TableGen sources; generated LLDB headers are owned by liblldb.
exports_files([
    "utils/TableGen/LLDBOptionDefEmitter.cpp",
    "utils/TableGen/LLDBPropertyDefEmitter.cpp",
    "utils/TableGen/LLDBTableGen.cpp",
    "utils/TableGen/LLDBTableGenUtils.cpp",
], visibility = ["//usr.bin/clang/lldb-tblgen:__pkg__"])
cc_library(
    name = "tablegen_headers",
    hdrs = ["utils/TableGen/LLDBTableGenBackends.h", "utils/TableGen/LLDBTableGenUtils.h"],
    visibility = ["//usr.bin/clang/lldb-tblgen:__pkg__"],
)
exports_files(["include/lldb/Core/PropertiesBase.td"] + glob(["source/**/*.td"]), visibility = ["//lib/clang/liblldb:__pkg__"])
