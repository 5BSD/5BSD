load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(
    name = "headers",
    hdrs = glob(["llvm/**/*.h", "llvm-c/*.h", "llvm/**/*.def", "llvm/**/*.inc"]),
    includes = ["."],
    deps = ["//contrib/llvm-project/llvm/include/llvm/Demangle:headers", "//lib/clang/include:headers"],
    visibility = ["//visibility:public"],
)

exports_files(["llvm/CodeGen/ValueTypes.td"], visibility = ["//usr.bin/clang/llvm-min-tblgen:__pkg__"])

exports_files(["llvm/IR/Attributes.td", "llvm/IR/Intrinsics.td"], visibility = ["//usr.bin/clang/llvm-tblgen:__pkg__"])
filegroup(name = "intrinsic_definitions", srcs = glob(["llvm/IR/Intrinsics*.td"]) + ["llvm/CodeGen/ValueTypes.td", "llvm/CodeGen/SDNodeProperties.td"], visibility = ["//usr.bin/clang/llvm-tblgen:__pkg__"])

exports_files(["llvm/Option/OptParser.td"], visibility = ["//lib/clang/libclang:__pkg__"])
