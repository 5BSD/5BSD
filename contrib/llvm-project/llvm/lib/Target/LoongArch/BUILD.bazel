    "LoongArchExpandPseudoInsts.cpp",
    "LoongArchFrameLowering.cpp",
    "LoongArchISelDAGToDAG.cpp",
    "LoongArchISelLowering.cpp",
    "LoongArchInstrInfo.cpp",
    "LoongArchMCInstLower.cpp",
    "LoongArchMergeBaseOffset.cpp",
    "LoongArchOptWInstrs.cpp",
    "LoongArchRegisterInfo.cpp",
    "LoongArchSubtarget.cpp",
    "LoongArchTargetMachine.cpp",
    "LoongArchTargetTransformInfo.cpp",
    "MCTargetDesc/LoongArchAsmBackend.cpp",
    "MCTargetDesc/LoongArchBaseInfo.cpp",
    "MCTargetDesc/LoongArchELFObjectWriter.cpp",
    "MCTargetDesc/LoongArchELFStreamer.cpp",
    "MCTargetDesc/LoongArchInstPrinter.cpp",
    "MCTargetDesc/LoongArchMCAsmInfo.cpp",
    "MCTargetDesc/LoongArchMCCodeEmitter.cpp",
