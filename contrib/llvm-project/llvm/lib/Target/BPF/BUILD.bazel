# SPDX-License-Identifier: BSD-2-Clause
exports_files(["BPF.td"], visibility = ["//lib/clang/libllvm:__pkg__"])
filegroup(name = "definitions", srcs = [
    "BPF.td",
    "BPFCallingConv.td",
    "BPFInstrFormats.td",
    "BPFInstrInfo.td",
    "BPFRegisterInfo.td",
    "GISel/BPFRegisterBanks.td"
], visibility = ["//lib/clang/libllvm:__pkg__"])

# SPDX-License-Identifier: BSD-2-Clause
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_archive")
# Native component of libllvm; not an additional installed library.
cc_library(name = "bpf", srcs = [
    "AsmParser/BPFAsmParser.cpp",
    "BPFASpaceCastSimplifyPass.cpp",
    "BPFAbstractMemberAccess.cpp",
    "BPFAdjustOpt.cpp",
    "BPFAsmPrinter.cpp",
    "BPFCheckAndAdjustIR.cpp",
    "BPFFrameLowering.cpp",
    "BPFIRPeephole.cpp",
    "BPFISelDAGToDAG.cpp",
    "BPFISelLowering.cpp",
    "BPFInstrInfo.cpp",
    "BPFMCInstLower.cpp",
    "BPFMIChecking.cpp",
    "BPFMIPeephole.cpp",
    "BPFMISimplifyPatchable.cpp",
    "BPFPreserveDIType.cpp",
    "BPFPreserveStaticOffset.cpp",
    "BPFRegisterInfo.cpp",
    "BPFSelectionDAGInfo.cpp",
    "BPFSubtarget.cpp",
    "BPFTargetMachine.cpp",
    "BTFDebug.cpp",
    "Disassembler/BPFDisassembler.cpp",
    "GISel/BPFCallLowering.cpp",
    "GISel/BPFInstructionSelector.cpp",
    "GISel/BPFLegalizerInfo.cpp",
    "GISel/BPFRegisterBankInfo.cpp",
    "MCTargetDesc/BPFAsmBackend.cpp",
    "MCTargetDesc/BPFELFObjectWriter.cpp",
    "MCTargetDesc/BPFInstPrinter.cpp",
    "MCTargetDesc/BPFMCCodeEmitter.cpp",
    "MCTargetDesc/BPFMCTargetDesc.cpp",
    "TargetInfo/BPFTargetInfo.cpp"
], hdrs = glob(["**/*.h", "**/*.def"]), includes = ["."],
    deps = ["//lib/clang/libllvm:bpf_generated_headers","//usr.bin/clang/llvm-min-tblgen:value_type_headers", "//lib/clang/libllvm:intrinsic_headers", "//lib/clang/libllvm:ir_generated_headers", "//lib/clang/libllvm:target_definition_headers", "//lib/clang/libllvm:directive_headers", "//contrib/llvm-project/llvm/include:headers", "//contrib/llvm-project/libcxx/include:headers"],
    copts = ["-fvisibility=hidden", "-std=c++17", "-nostdinc++", "-fno-exceptions", "-fno-rtti", "-fvisibility-inlines-hidden", "-ffunction-sections", "-fdata-sections", "-UPIC"] + select({"//tools/build/bazel/config:llvm_full_debuginfo_enabled": ["-g"], "//conditions:default": ["-gline-tables-only"]}),
    local_defines = ["__STDC_CONSTANT_MACROS", "__STDC_FORMAT_MACROS", "__STDC_LIMIT_MACROS", "HAVE_VCS_VERSION_INC", "LLVM_BUILD_LLVM_DYLIB"] + select({"//tools/build/bazel/config:llvm_assertions_enabled": [], "//conditions:default": ["NDEBUG"]}),
    linkstatic = True, target_compatible_with = ["@platforms//os:freebsd", "@platforms//cpu:x86_64"] + select({"//tools/build/bazel/config:llvm_target_bpf_enabled": [], "//conditions:default": ["@platforms//:incompatible"]}), visibility = ["//visibility:public"])
bsd_component_archive(name = "pic_archive", groups = [":bpf"], pic = True, visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_objects")
bsd_component_objects(name = "pic_objects", group = ":bpf", pic = True, visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_component_archive.bzl", "bsd_component_sources")
bsd_component_sources(name = "source_inventory", groups = [":bpf"], visibility = ["//visibility:public"])
