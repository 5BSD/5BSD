load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(name = "profile_headers", hdrs = glob(["profile/*.h", "profile/*.inc"]), includes = ["."], visibility = ["//visibility:public"])
exports_files(["profile/InstrProfData.inc", "profile/MemProfData.inc"], visibility = ["//lib/libclang_rt/profile:__pkg__"])

cc_library(name = "sanitizer_headers", hdrs = glob(["sanitizer/*.h"]), includes = ["."],
    visibility = ["//visibility:public"])
exports_files(glob(["sanitizer/*.h"]), visibility = ["//lib/libclang_rt/include:__pkg__"])

exports_files(["fuzzer/FuzzedDataProvider.h"], visibility = ["//lib/libclang_rt/fuzzer:__pkg__"])
