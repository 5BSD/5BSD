exports_files(["ubsan_init.cpp"], visibility = ["//lib/libclang_rt:__subpackages__"])
exports_files(["ubsan_monitor.cpp"], visibility = ["//lib/libclang_rt:__subpackages__"])
exports_files(["ubsan_value.cpp"], visibility = ["//lib/libclang_rt:__subpackages__"])
