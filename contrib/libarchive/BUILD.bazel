load(":sources.bzl", "ARCHIVE_SOURCES")
load("@rules_cc//cc:defs.bzl", "cc_library")
exports_files([label.split(":", 1)[1] for label in ARCHIVE_SOURCES], visibility = ["//lib/libarchive:__pkg__"])
cc_library(name = "headers", hdrs = ["libarchive/archive.h", "libarchive/archive_entry.h"],
    strip_include_prefix = "libarchive", visibility = ["//visibility:public"])
cc_library(name = "internal_headers", hdrs = glob(["libarchive/*.h", "libarchive_fe/*.h"],
    exclude = ["libarchive/archive.h", "libarchive/archive_entry.h"]),
    includes = ["libarchive", "libarchive_fe"], visibility = ["//lib/libarchive:__pkg__", "//usr.bin/tar/tests:__pkg__", "//usr.bin/unzip/tests:__pkg__", "//usr.bin/cpio/tests:__pkg__"])

load("//lib/libarchive:installation_data.bzl", "MANUALS", "FORMAT_MANUALS")
exports_files(["libarchive/" + name for name in MANUALS + FORMAT_MANUALS + ["archive.h", "archive_entry.h"]], visibility = ["//lib/libarchive:__pkg__"])

exports_files(["cpio/cpio.c", "cpio/cmdline.c", "libarchive_fe/lafe_err.c", "libarchive_fe/line_reader.c", "libarchive_fe/passphrase.c"], visibility = ["//usr.bin/unzip:__pkg__", "//usr.bin/cpio:__pkg__", "//usr.bin/unzip/tests:__pkg__", "//usr.bin/cpio/tests:__pkg__", "//usr.bin/tar:__pkg__", "//usr.bin/tar/tests:__pkg__"])
cc_library(name = "cpio_headers", hdrs = glob(["cpio/*.h", "libarchive_fe/*.h"]),
    includes = ["cpio", "libarchive_fe"], visibility = ["//usr.bin/unzip:__pkg__", "//usr.bin/cpio:__pkg__", "//usr.bin/unzip/tests:__pkg__", "//usr.bin/cpio/tests:__pkg__", "//usr.bin/tar:__pkg__", "//usr.bin/tar/tests:__pkg__"])

exports_files(["tar/" + source for source in ["bsdtar.c", "cmdline.c", "creation_set.c", "read.c", "subst.c", "util.c", "write.c"]], visibility = ["//usr.bin/tar:__pkg__", "//usr.bin/tar/tests:__pkg__"])
cc_library(name = "tar_headers", hdrs = glob(["tar/*.h", "libarchive_fe/*.h"]),
    includes = ["tar", "libarchive_fe"], visibility = ["//usr.bin/tar:__pkg__", "//usr.bin/tar/tests:__pkg__"])

exports_files(["tar/bsdtar.1"], visibility = ["//usr.bin/tar:__pkg__", "//usr.bin/tar/tests:__pkg__"])

exports_files(["cpio/bsdcpio.1"], visibility = ["//usr.bin/unzip:__pkg__", "//usr.bin/cpio:__pkg__", "//usr.bin/unzip/tests:__pkg__", "//usr.bin/cpio/tests:__pkg__"])

exports_files(["test_list.py", "test_utils/test_main.c", "test_utils/test_utils.c"], visibility = ["//usr.bin/tar/tests:__pkg__", "//usr.bin/unzip/tests:__pkg__", "//usr.bin/cpio/tests:__pkg__"])

load("//usr.bin/tar/tests:sources.bzl", TAR_TEST_SOURCES = "TEST_SOURCES", TAR_REFERENCE_FILES = "REFERENCE_FILES")
exports_files([x.split(":", 1)[1] for x in TAR_TEST_SOURCES + TAR_REFERENCE_FILES], visibility = ["//usr.bin/tar/tests:__pkg__"])
cc_library(name = "tar_test_headers", hdrs = glob(["tar/test/*.h", "test_utils/*.h", "libarchive_fe/*.h", "tar/*.h"]), includes = ["tar/test", "test_utils", "libarchive_fe", "tar"], visibility = ["//usr.bin/tar/tests:__pkg__"])

load("//usr.bin/cpio/tests:sources.bzl", CPIO_TEST_SOURCES = "TEST_SOURCES", CPIO_REFERENCE_FILES = "REFERENCE_FILES")
exports_files([x.split(":", 1)[1] for x in CPIO_TEST_SOURCES + CPIO_REFERENCE_FILES], visibility = ["//usr.bin/unzip/tests:__pkg__", "//usr.bin/cpio/tests:__pkg__"])
cc_library(name = "cpio_test_headers", hdrs = glob(["cpio/test/*.h", "test_utils/*.h", "libarchive_fe/*.h", "cpio/*.h"]), includes = ["cpio/test", "test_utils", "libarchive_fe", "cpio"], visibility = ["//usr.bin/unzip/tests:__pkg__", "//usr.bin/cpio/tests:__pkg__"])

exports_files(["unzip/bsdunzip.c", "unzip/cmdline.c", "libarchive_fe/lafe_getline.c", "unzip/bsdunzip.1"], visibility = ["//usr.bin/unzip:__pkg__"])
cc_library(name = "unzip_headers", hdrs = glob(["unzip/*.h", "libarchive_fe/*.h"]), includes = ["unzip", "libarchive_fe"], visibility = ["//usr.bin/unzip:__pkg__"])
load("//usr.bin/unzip/tests:sources.bzl", UNZIP_TEST_SOURCES = "TEST_SOURCES", UNZIP_REFERENCE_FILES = "REFERENCE_FILES")
exports_files([x.split(":", 1)[1] for x in UNZIP_TEST_SOURCES + UNZIP_REFERENCE_FILES], visibility = ["//usr.bin/unzip/tests:__pkg__"])
cc_library(name = "unzip_test_headers", hdrs = glob(["unzip/test/*.h", "test_utils/*.h", "libarchive_fe/*.h", "unzip/*.h"]), includes = ["unzip/test", "test_utils", "libarchive_fe", "unzip"], visibility = ["//usr.bin/unzip/tests:__pkg__"])
