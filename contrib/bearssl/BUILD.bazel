load("@rules_cc//cc:defs.bzl", "cc_library")
load("//lib/libbearssl:sources.bzl", "LOADER_SOURCES", "LIBRARY_SOURCES", "SSL_SOURCES", "PUBLIC_HEADERS")
exports_files(LOADER_SOURCES + LIBRARY_SOURCES + SSL_SOURCES + PUBLIC_HEADERS, visibility = ["//lib/libbearssl:__pkg__"])
cc_library(name = "headers", hdrs = PUBLIC_HEADERS, strip_include_prefix = "inc", visibility = ["//visibility:public"])
cc_library(name = "internal_headers", hdrs = ["src/config.h", "src/inner.h"], strip_include_prefix = "src", visibility = ["//lib/libbearssl:__pkg__"])
cc_library(name = "tool_headers", hdrs = ["tools/brssl.h"], strip_include_prefix = "tools", visibility = ["//lib/libbearssl:__pkg__", "//lib/libsecureboot:__pkg__"])

exports_files(["test/test_crypto.c"], visibility = ["//lib/libbearssl:__pkg__"])

exports_files(["tools/xmem.c", "tools/vector.c"], visibility = ["//lib/libsecureboot:__pkg__"])
