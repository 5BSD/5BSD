#![allow(non_snake_case)]

use fidl_next_test_zxtypes as _;
use fidl_test_zxtypes as _;

pub fn result_enum_from_rust_next(
    value: fidl_next_test_zxtypes::ResultEnum,
) -> fidl_test_zxtypes::ResultEnum {
    match value {
        fidl_next_test_zxtypes::ResultEnum::Ok => fidl_test_zxtypes::ResultEnum::Ok,

        fidl_next_test_zxtypes::ResultEnum::UnknownOrdinal_(unknown_ordinal) => {
            fidl_test_zxtypes::ResultEnum::__SourceBreaking { unknown_ordinal }
        }
    }
}

