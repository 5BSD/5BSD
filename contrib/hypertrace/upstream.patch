diff --git a/cddl/contrib/opensolaris/cmd/dtrace/test/tst/hypertrace/vars/tst.ucaller.ksh b/cddl/contrib/opensolaris/cmd/dtrace/test/tst/hypertrace/vars/tst.ucaller.ksh
