+void
+HyperTraceELFParser::setErrorMessage(const char *fmt, ...)
+{
+	va_list va, va_cp;
+	va_start(va, fmt);
+	va_copy(va_cp, va);
+	auto len = vsnprintf(nullptr, 0, fmt, va);
+	if (len < 0)
+		abort();
+	if (len > 0) {
+		errorMessage.resize(len);
+		vsnprintf(&errorMessage[0], len + 1, fmt, va_cp);
+	}
+	va_end(va_cp);
+	va_end(va);
+}
