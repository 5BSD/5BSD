+			ors = DIF_INSTR_RS(ibase);
+			orv = DIF_INSTR_R2(ibase);
+			otype = DIF_INSTR_TYPE(ibase);
+
+			nrs = DIF_INSTR_RS(inew);
+			nrv = DIF_INSTR_R2(inew);
+			ntype = DIF_INSTR_TYPE(inew);
