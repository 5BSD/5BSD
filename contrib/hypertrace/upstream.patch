diff --git a/cddl/contrib/opensolaris/cmd/dtrace/test/tst/hypertrace/aggs/tst.aggpackbanner.ksh b/cddl/contrib/opensolaris/cmd/dtrace/test/tst/hypertrace/aggs/tst.aggpackbanner.ksh
