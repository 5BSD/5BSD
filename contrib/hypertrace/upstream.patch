+	printf("ip:::receive - %s\n", ipreceive >= 3 ? "yes" : "no");
+	printf("sctp:::send - %s\n", sctpsend >= 4 ? "yes" : "no");
+	printf("sctp:::receive - %s\n", sctpreceive >= 3 ? "yes" : "no");
+}
+EODTRACE
+
+status=$?
+
+cd /
+/bin/rm -rf $DIR
+
+exit $status
