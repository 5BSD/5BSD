+		auto *eop = (_dt_elf_eopt_t *)malloc(len);
+		if (eop == NULL) {
+			setErrorMessage("malloc for eop failed: %s",
+			    strerror(errno));
+			return (makeError(nullptr, E_HYPERTRACE_SYS));
+		}
+
+		auto l = strlcpy(eop->eo_name, op->dteo_name, sizeof(eop->eo_name));
+		if (l >= sizeof(eop->eo_name)) {
