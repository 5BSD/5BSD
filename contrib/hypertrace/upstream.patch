diff --git a/cddl/contrib/opensolaris/cmd/dtrace/test/tst/hypertrace/uctf/tst.chasestrings.c b/cddl/contrib/opensolaris/cmd/dtrace/test/tst/hypertrace/uctf/tst.chasestrings.c
