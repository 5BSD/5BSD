diff --git a/cddl/contrib/opensolaris/cmd/dtrace/test/tst/hypertrace/syscall/tst.openret.ksh b/cddl/contrib/opensolaris/cmd/dtrace/test/tst/hypertrace/syscall/tst.openret.ksh
