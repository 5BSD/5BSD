+#ifndef _DTRACED_STATE_H_
+#define _DTRACED_STATE_H_
+
+#include <sys/types.h>
+#include <sys/param.h>
+#include <sys/event.h>
+
+#include <semaphore.h>
+
+#include "_dtraced_connection.h"
