+#include <err.h>
+#include <libgen.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <syslog.h>
+#include <unistd.h>
+
+#include "dtraced_errmsg.h"
+#include "dtraced_misc.h"
+
+#include <mutex>
+
+#define DTRACED_SYSLOG
+
+static int quiet;
+static std::mutex io_mtx;
+
+void
+be_quiet(void)
+{
+
+	quiet = 1;
+}
+
+void
+dump_errmsg(const char *file, int line, const char *msg, ...)
+{
+	va_list ap;
+	if (msg) {
+		{
+			std::lock_guard lk(io_mtx);
+			fprintf(stderr, "ERROR: %s:%d ", file, line);
+			va_start(ap, msg);
+			vfprintf(stderr, msg, ap);
+			va_end(ap);
+			fprintf(stderr, "\n");
+		}
+#ifdef DTRACED_SYSLOG
+		va_start(ap, msg);
+		vsyslog(LOG_ERR, msg, ap);
+		va_end(ap);
+#endif /* DTRACED_SYSLOG */
+	}
+}
+
+void
+dump_warnmsg(const char *file, int line, const char *msg, ...)
+{
+	va_list ap;
+
+	if (quiet)
+		return;
+
+	if (msg) {
+		{
+			std::lock_guard lk(io_mtx);
+			fprintf(stderr, "WARNING: %s:%d ", file, line);
+			va_start(ap, msg);
+			vfprintf(stderr, msg, ap);
+			va_end(ap);
+			fprintf(stderr, "\n");
+		}
+#ifdef DTRACED_SYSLOG
+		va_start(ap, msg);
+		vsyslog(LOG_WARNING, msg, ap);
+		va_end(ap);
+#endif /* DTRACED_SYSLOG */
+	}
+}
+
+#ifdef DTRACED_DEBUG
+void
+dump_debugmsg(const char *file, int line, const char *msg, ...)
+{
+	va_list ap;
+
+	if (quiet)
+		return;
+
+	if (msg) {
+		{
+			std::lock_guard lk(io_mtx);
+			fprintf(stdout, "DEBUG: %s:%d ", file, line);
+			va_start(ap, msg);
+			vfprintf(stdout, msg, ap);
+			va_end(ap);
+			fprintf(stdout, "\n");
+		}
+#ifdef DTRACED_SYSLOG
+		va_start(ap, msg);
+		vsyslog(LOG_DEBUG, msg, ap);
+		va_end(ap);
+#endif /* DTRACED_SYSLOG */
+	}
+}
+#endif /* DTRACED_DEBUG */
+
+void
+dump_logmsg(const char *file, int line, const char *msg, ...)
+{
+	va_list ap;
+	if (msg) {
+		{
+			std::lock_guard lk(io_mtx);
+			fprintf(stdout, "LOG: %s:%d ", file, line);
+			va_start(ap, msg);
+			vfprintf(stdout, msg, ap);
+			va_end(ap);
+			fprintf(stdout, "\n");
+		}
+#ifdef DTRACED_SYSLOG
+		va_start(ap, msg);
+		vsyslog(LOG_INFO, msg, ap);
+		va_end(ap);
+#endif /* DTRACED_SYSLOG */
+	}
+}
