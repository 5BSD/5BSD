+			if (l >= sizeof(eop->eo_option)) {
+				setErrorMessage("%s is too long to be copied",
+				    op->dteo_arg);
+				return (
+				    makeError(nullptr, E_HYPERTRACE_ELFCREATE));
+			}
+		} else
+			eop->eo_option = op->dteo_option;
+
