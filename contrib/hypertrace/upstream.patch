diff --git a/cddl/contrib/opensolaris/cmd/dtrace/test/tst/hypertrace/uctf/err.user64mode.ksh b/cddl/contrib/opensolaris/cmd/dtrace/test/tst/hypertrace/uctf/err.user64mode.ksh
