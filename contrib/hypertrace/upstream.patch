index 0000000000000000000000000000000000000000..64be078e35f230fe86f72ea9e921aa727fd0983f
--- /dev/null
+++ b/cddl/contrib/opensolaris/cmd/dtrace/test/tst/hypertrace/privs/tst.providers.ksh
@@ -0,0 +1,126 @@
+#
