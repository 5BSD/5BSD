diff --git a/cddl/contrib/opensolaris/cmd/dtrace/test/tst/hypertrace/pragma/tst.temporal.ksh b/cddl/contrib/opensolaris/cmd/dtrace/test/tst/hypertrace/pragma/tst.temporal.ksh
