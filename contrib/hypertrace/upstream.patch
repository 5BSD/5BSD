+	const DFGNode *getR0Node() const { return (r0node); }
+	Typefile *getTypenameChecked(DFGNode *, Vec<Typefile *> &, char *,
+	    size_t, const String &);
+	dtrace_difv_t *getVarFromVarVec(uint16_t, int, int);
+};
