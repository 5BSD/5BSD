+static void *
+handle_signals(void *arg __unused)
+{
+	sigset_t sigset;
+	int err, sig = 0, nsigs = 2;
+
+	(void) sigfillset(&sigset);
+	err = pthread_sigmask(SIG_BLOCK, &sigset, NULL);
+	if (err)
+		fatal("failed to apply sigmask to signal handler thread: %s\n",
+		    sigset, strerror(err));
