+#
+# The only thing we can be sure of is that some module named "unix" (or
+# "genunix") did some work -- so that's all we'll check.
+#
+script | tee /dev/fd/2 | grep kernel > /dev/null
+status=$? 
+
+kill $child
+exit $status
