diff --git a/usr.sbin/dtraced/dtraced_events.h b/usr.sbin/dtraced/dtraced_events.h
new file mode 100644
--- /dev/null
+++ b/usr.sbin/dtraced/dtraced_events.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#ifndef DTRACED_EVENTS_H
+#define DTRACED_EVENTS_H
+#include <cerrno>
+#include <cstdint>
+#include <mutex>
+#include <unordered_map>
+#include "dtraced_connection.h"
+namespace dtraced {
+/* Kqueue carries non-reused tokens, never pointers to reclaimable clients. */
+class event_registry {
+    std::mutex mutex;
+    uintptr_t next = 1;
+    std::unordered_map<uintptr_t, client_fd *> clients;
+public:
+    ~event_registry() {
+        for (auto &entry : clients)
+            entry.second->release();
+    }
+    uintptr_t add(client_fd *client) {
+        std::lock_guard lock(mutex);
+        if (next == 0) { errno = EOVERFLOW; return 0; }
+        uintptr_t token = next++;
+        clients.emplace(token, client);
+        client->acquire();
+        return token;
+    }
+    /* The returned reference must be released after handling the event. */
+    client_fd *lookup(uintptr_t token, int fd) {
+        std::lock_guard lock(mutex);
+        auto found = clients.find(token);
+        if (found == clients.end() || found->second->get_fd() != fd ||
+            found->second->retired.load())
+            return nullptr;
+        found->second->acquire();
+        return found->second;
+    }
+    void remove(uintptr_t token) {
+        std::lock_guard lock(mutex);
+        auto found = clients.find(token);
+        if (found != clients.end()) {
+            found->second->release();
+            clients.erase(found);
+        }
+    }
+};
+}
+#endif
diff --git a/usr.sbin/dtraced/dtraced_io.h b/usr.sbin/dtraced/dtraced_io.h
new file mode 100644
--- /dev/null
+++ b/usr.sbin/dtraced/dtraced_io.h
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#ifndef DTRACED_IO_H
+#define DTRACED_IO_H
+#include <sys/socket.h>
+#include <errno.h>
+#include <poll.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <time.h>
+
+static inline int64_t
+dtraced_io_milliseconds(void)
+{
+	struct timespec now;
+	if (clock_gettime(CLOCK_MONOTONIC, &now) != 0)
+		return (-1);
+	return ((int64_t)now.tv_sec * 1000 + now.tv_nsec / 1000000);
+}
+
+/* The caller shares one absolute deadline across the complete frame. */
+static inline int
+dtraced_io_transfer(int fd, void *data, size_t length, bool writing, int64_t deadline,
+    size_t *transferred)
+{
+	unsigned char *p = (unsigned char *)data;
+	struct pollfd event = { fd, (short)(writing ? POLLOUT : POLLIN), 0 };
+	ssize_t n;
+	int64_t now, left;
+	int status;
+
+	*transferred = 0;
+	while (*transferred < length) {
+		now = dtraced_io_milliseconds();
+		if (now < 0)
+			return (-1);
+		left = deadline - now;
+		if (left <= 0) {
+			errno = ETIMEDOUT;
+			return (-1);
+		}
+		n = writing ? send(fd, p + *transferred, length - *transferred,
+		    MSG_DONTWAIT | MSG_NOSIGNAL) : recv(fd, p + *transferred,
+		    length - *transferred, MSG_DONTWAIT);
+		if (n > 0) {
+			*transferred += n;
+			continue;
+		}
+		if (n == 0) {
+			errno = writing ? EPIPE : ECONNRESET;
+			return (-1);
+		}
+		if (errno == EINTR)
+			continue;
+		if (errno != EAGAIN && errno != EWOULDBLOCK)
+			return (-1);
+		status = poll(&event, 1, left > INT32_MAX ? INT32_MAX : (int)left);
+		if (status < 0 && errno != EINTR)
+			return (-1);
+		if (status > 0 && (event.revents & POLLNVAL) != 0) {
+			errno = EBADF;
+			return (-1);
+		}
+	}
+	return (0);
+}
+#endif
