--- /dev/null
+++ b/usr.sbin/dtraced/dtraced_protocol.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#ifndef DTRACED_PROTOCOL_H
+#define DTRACED_PROTOCOL_H
+#include <cstddef>
+#include <cstring>
+#include <string>
+#include <vector>
+namespace dtraced {
+/* Bound the native-ABI local control protocol before allocating. */
+constexpr size_t max_request_bytes = 64 * 1024 * 1024;
+constexpr size_t max_cleanup_entries = 4096;
+constexpr size_t max_cleanup_name = 4096;
+inline bool
+parse_cleanup(const unsigned char *p, size_t size, size_t count,
+    std::vector<std::string> &out)
+{
+    if (count > max_cleanup_entries || count > size / (sizeof(size_t) + 1))
+        return false;
+    std::vector<std::string> entries;
+    entries.reserve(count);
+    for (size_t i = 0; i < count; ++i) {
+        size_t len;
+        if (size < sizeof(len)) return false;
+        std::memcpy(&len, p, sizeof(len));
+        p += sizeof(len); size -= sizeof(len);
+        if (len == 0 || len > max_cleanup_name || len > size ||
+            p[len - 1] != 0 || std::memchr(p, 0, len - 1) != nullptr)
+            return false;
+        entries.emplace_back(reinterpret_cast<const char *>(p), len - 1);
+        p += len; size -= len;
+    }
+    if (size != 0) return false;
+    out.swap(entries);
+    return true;
+}
+}
+#endif
