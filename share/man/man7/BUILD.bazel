load("//tools/build/bazel:bsd_manual_installation.bzl", "manual_entries")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_manifest")
load("//tools/build/bazel:bsd_script_installation.bzl", "script_install_archive")

_man_pages = [
    'arch.7',
    'ascii.7',
    'bsd.snmpmod.mk.7',
    'build.7',
    'c.7',
    'd.7',
    'clocks.7',
    'component.7',
    'crypto.7',
    'development.7',
    'environ.7',
    'firewall.7',
    'groups.7',
    'growfs.7',
    'growfs_postboot.7',
    'hier.7',
    'hostname.7',
    'intro.7',
    'maclabel.7',
    'memory_model.7',
    'mitigations.7',
    'named_attribute.7',
    'operator.7',
    'orders.7',
    'freebsd-base.7',
    'ports.7',
    'release.7',
    'sdoc.7',
    'security.7',
    'simd.7',
    'sizeof.7',
    'sprog.7',
    'stats.7',
    'stdint.7',
    'sticky.7',
    'tracing.7',
    'tuning.7',
]
_man_aliases = [
    ('intro.7', 'miscellaneous.7'),
    ('growfs.7', 'growfs_fstab.7'),
    ('freebsd-base.7', 'pkgbase.7'),
    ('security.7', 'securelevel.7'),
    ('c.7', 'c78.7'),
    ('c.7', 'c89.7'),
    ('c.7', 'c90.7'),
    ('c.7', 'c95.7'),
    ('c.7', 'c99.7'),
    ('c.7', 'c11.7'),
    ('c.7', 'c17.7'),
    ('c.7', 'c23.7'),
    ('c.7', 'c2y.7'),
    ('groups.7', 'wheel.7'),
]
_man = manual_entries(name = 'man', pages = _man_pages, aliases = _man_aliases, package = 'utilities', split = True)

_network_pages = [
    'networking.7',
]
_network_aliases = [
    ('networking.7', 'wifi.7'),
]
_network = manual_entries(name = 'network', pages = _network_pages, aliases = _network_aliases, package = 'utilities', split = True)

_fidl_pages = [
    'fidl.7',
]
_fidl_aliases = [
]
_fidl = manual_entries(name = 'fidl', pages = _fidl_pages, aliases = _fidl_aliases, package = 'runtime', split = True)

_tests_pages = [
    'tests.7',
]
_tests_aliases = [
]
_tests = manual_entries(name = 'tests', pages = _tests_pages, aliases = _tests_aliases, package = 'tests', split = False)

_atf_pages = [
    'atf-test-case.7',
]
_atf_aliases = [
]
_atf = manual_entries(name = 'atf', pages = _atf_pages, aliases = _atf_aliases, package = 'atf', split = False, sources = {'atf-test-case.7': '//contrib/atf:doc/atf-test-case.7'})

load("@bazel_skylib//lib:selects.bzl", "selects")
selects.config_setting_group(name = "man_inet_enabled", match_all = ["//tools/build/bazel/config:man_enabled", "//tools/build/bazel/config:inet_enabled"])
selects.config_setting_group(name = "man_tests_enabled", match_all = ["//tools/build/bazel/config:man_enabled", "//tools/build/bazel/config:tests_enabled"])

bsd_install_manifest(name = "install_manifest", entries = select({"//tools/build/bazel/config:man_enabled": _man, "//conditions:default": []}) +
    select({":man_inet_enabled": _network, "//conditions:default": []}) +
    select({"//tools/build/bazel/config:man_enabled": _fidl, "//conditions:default": []}) +
    select({":man_tests_enabled": _tests, "//conditions:default": []}) +
    select({":man_tests_enabled": _atf, "//conditions:default": []}),
    visibility = ["//visibility:public"])
script_install_archive(name = "install_archive")
