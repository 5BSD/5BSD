{
    "mode": "permissive",
    "rules": [
        {
            "action": "deny",
            "operations": ["exec"],
            "object": { "type": "untrusted" }
        },
        {
            "action": "allow",
            "operations": ["read", "write", "open", "stat", "mmap"],
            "subject": { "domain": "web" },
            "object": { "domain": "web" }
        },
        {
            "action": "allow",
            "operations": ["read", "write", "open", "stat"],
            "subject": { "domain": "database" },
            "object": { "domain": "database" }
        },
        {
            "action": "allow",
            "operations": ["exec"],
            "subject": { "type": "admin" },
            "object": { "type": "admin-tool" },
            "subj_ctx": { "jail": "host" }
        },
        {
            "action": "deny",
            "operations": ["exec"],
            "object": { "type": "admin-tool" },
            "subj_ctx": { "jail": "any" }
        },
        {
            "action": "allow",
            "operations": ["read", "write"],
            "subject": "*",
            "object": { "level": "sandbox-only" },
            "subj_ctx": { "sandboxed": true }
        },
        {
            "action": "deny",
            "operations": ["read", "write", "exec"],
            "object": { "level": "sandbox-only" },
            "subj_ctx": { "sandboxed": false }
        },
        {
            "action": "allow",
            "operations": ["debug", "signal", "sched"],
            "subject": { "type": "supervisor" },
            "object": { "type": "worker" }
        },
        {
            "action": "deny",
            "operations": ["debug"],
            "subject": "*",
            "object": "*",
            "obj_ctx": { "sandboxed": true }
        },
        {
            "action": "deny",
            "operations": ["exec"],
            "subject": { "type": "restricted" },
            "object": { "type": "trusted", "negate": true }
        },
        {
            "action": "allow",
            "operations": ["all"],
            "subject": { "type": "trusted" },
            "object": "*"
        },
        {
            "action": "allow",
            "operations": ["all"],
            "subject": { "domain": "system" },
            "object": "*"
        },
        {
            "action": "allow",
            "operations": ["all"],
            "subject": "*",
            "object": "*",
            "subj_ctx": { "uid": 0 }
        },
        {
            "action": "deny",
            "operations": ["all"],
            "subject": "*",
            "object": "*"
        }
    ]
}
