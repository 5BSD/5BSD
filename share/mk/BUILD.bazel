    "bsd.cpu.mk",
    "bsd.crunchgen.mk",
    "bsd.debug.mk",
    "bsd.dep.mk",
    "bsd.dirs.mk",
    "bsd.doc.mk",
    "bsd.dtb.mk",
    "bsd.endian.mk",
    "bsd.files.mk",
    "bsd.incs.mk",
    "bsd.info.mk",
    "bsd.init.mk",
    "bsd.kmod.mk",
    "bsd.lib.mk",
    "bsd.libnames.mk",
    "bsd.linker.mk",
    "bsd.links.mk",
    "bsd.man.mk",
    "bsd.mkopt.mk",
    "bsd.nls.mk",
    "bsd.obj.mk",
    "bsd.opts.mk",
    "bsd.own.mk",
    "bsd.port.mk",
    "bsd.port.options.mk",
    "bsd.port.post.mk",
    "bsd.port.pre.mk",
    "bsd.port.subdir.mk",
    "bsd.prog.mk",
    "bsd.capimage.mk",
    "capimage.awk",
    "bsd.progs.mk",
    "bsd.snmpmod.mk",
    "bsd.subdir.mk",
    "bsd.suffixes-extra.mk",
    "bsd.suffixes-posix.mk",
    "bsd.suffixes.mk",
    "bsd.symver.mk",
    "bsd.sys.mk",
    "bsd.sysdir.mk",
    "bsd.test.mk",
    "dirdeps.mk",
    "dirdeps-options.mk",
    "dirdeps-targets.mk",
    "gendirdeps.mk",
    "host-target.mk",
    "host.test.mk",
    "install-new.mk",
    "jobs.mk",
    "meta.autodep.mk",
    "meta.stage.mk",
    "meta.subdir.mk",
    "meta.sys.mk",
    "meta2deps.py",
    "meta2deps.sh",
    "stage-install.sh",
    "sys.mk",
    "sys.dependfile.mk",
    "sys.dirdeps.mk",
    "version_gen.awk",
]
_VENDOR_FILES = {"newlog.sh": "//contrib/bmake/mk:newlog.sh", "posix.mk": "//contrib/bmake/mk:posix.mk",
    "setopts.sh": "//contrib/bmake/mk:setopts.sh"}
_TEST_FILES = ["atf.test.mk", "googletest.test.inc.mk", "googletest.test.mk", "plain.test.mk", "suite.test.mk", "tap.test.mk"]
[bsd_install_file(name = "file_" + file, src = file,
    destination = "/usr/share/mk/" + file, owner = "root", group = "wheel",
    mode = "0555" if (file.endswith(".sh") or file.endswith(".py")) else "0444",
    install_tags = ["package=bmake"]) for file in _FILES + _TEST_FILES]
[bsd_install_file(name = "file_" + file, src = source,
    destination = "/usr/share/mk/" + file, owner = "root", group = "wheel",
    mode = "0555" if file.endswith(".sh") else "0444",
    install_tags = ["package=bmake"]) for file, source in _VENDOR_FILES.items()]
bsd_install_manifest(name = "install_manifest", entries = [":file_" + file for file in _FILES] +
    [":file_" + file for file in _VENDOR_FILES] + select({
        "//tools/build/bazel/config:tests_enabled": [":file_" + file for file in _TEST_FILES],
        "//conditions:default": [],
    }), visibility = ["//visibility:public"])
script_install_archive(name = "install_archive",
    directories = {"/usr/share/mk": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=bmake"]}'})
