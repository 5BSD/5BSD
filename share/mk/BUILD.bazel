load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest")
load("//tools/build/bazel:bsd_script_installation.bzl", "script_install_archive")
# Source-owned installed Make interface remains available to ports and third parties.
_FILES = [
    "auto.obj.mk",
    "bsd.README",
    "bsd.arch.inc.mk",
    "bsd.clang-analyze.mk",
    "bsd.compiler.mk",
    "bsd.compat.mk",
