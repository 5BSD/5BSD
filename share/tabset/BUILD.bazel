load("//tools/build/bazel:bsd_fixture.bzl", "bsd_uu_decode")
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest")
_FILES = ['3101', '9837', 'aa', 'aed512', 'beehive', 'diablo', 'dtc382', 'hp700-wy', 'ibm3101', 'std', 'stdcrt', 'tandem653', 'teleray', 'vt100', 'vt100-w', 'wyse-adds', 'xerox1720', 'xerox1730', 'xerox1730-lm', 'zenith29']
[bsd_uu_decode(name = "decode_" + name, src = name + ".uu", output = name,
    python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib"]) for name in _FILES]
[bsd_install_file(name = "install_" + name, src = ":decode_" + name,
    destination = "/usr/share/tabset/" + name, owner = "root", group = "wheel", mode = "0444",
    install_tags = ["package=ncurses-lib"]) for name in _FILES]
bsd_install_manifest(name = "install_manifest", entries = [":install_" + name for name in _FILES], visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")
bsd_install_archive(
    name = "install_archive", visibility = ["//share:__pkg__"],
    manifests = [":install_manifest"],
    directories = {"/usr/share/tabset": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=ncurses-lib"]}'},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)
