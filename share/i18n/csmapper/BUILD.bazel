# SPDX-License-Identifier: BSD-2-Clause
load(":maps.bzl", "MAP_SOURCES")
load("//tools/build/bazel:bsd_citrus_database.bzl", "citrus_database")
[citrus_database(
    name = source[:-4] + "_database",
    src = source,
    output = source[:-4] + ".mps",
    tool = "//usr.bin/mkcsmapper:mkcsmapper_tool",
) for source in MAP_SOURCES]
filegroup(name = "binary_maps", srcs = [source[:-4] + "_database" for source in MAP_SOURCES],
    visibility = ["//visibility:public"])

load(":index_policy.bzl", "INDEX_SOURCES", "MAPPER_FAMILIES")
load("//tools/build/bazel:bsd_citrus_mapper_index.bzl", "citrus_mapper_index")
citrus_mapper_index(name = "indexes", families = json.encode(MAPPER_FAMILIES),
    srcs = INDEX_SOURCES, script = "mapper_indexes.py",
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib"])
filegroup(name = "directory", srcs = [":indexes"], output_group = "directory")
filegroup(name = "pivot", srcs = [":indexes"], output_group = "pivot")
citrus_database(name = "directory_database", src = ":directory", output = "mapper.dir.db",
    mode = "lookup", tool = "//usr.bin/mkcsmapper:mkcsmapper_tool")
citrus_database(name = "pivot_database", src = ":pivot", output = "charset.pivot.pvdb",
    mode = "pivot", tool = "//usr.bin/mkcsmapper:mkcsmapper_tool")
filegroup(name = "mapper_indexes", srcs = [":indexes", ":directory_database", ":pivot_database"],
    visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest")
load(":static_data.bzl", "STATIC_MAPS")
_INSTALL_FILES = [(":" + source[:-4] + "_database", source[:-4] + ".mps") for source in MAP_SOURCES] + [(source, source) for source in STATIC_MAPS] + [(":directory", "mapper.dir"), (":pivot", "charset.pivot"), (":directory_database", "mapper.dir.db"), (":pivot_database", "charset.pivot.pvdb")]
[bsd_install_file(name = "install_" + destination, src = source,
    destination = "/usr/share/i18n/csmapper/" + destination,
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=utilities"])
 for source, destination in _INSTALL_FILES]
bsd_install_manifest(name = "install_manifest", entries = [":install_" + destination for _, destination in _INSTALL_FILES],
    visibility = ["//visibility:public"])
