load(":encodings.bzl", "ENCODINGS")
load("//tools/build/bazel:bsd_citrus_database.bzl", "citrus_database")
load("//tools/build/bazel:bsd_template.bzl", "bsd_template")
load("//tools/build/bazel:bsd_citrus_encoding.bzl", "citrus_encoding")
[bsd_template(name = stem + "_source", template = source,
    output = stem + ".src", substitutions = substitutions)
 for stem, source, substitutions in ENCODINGS if substitutions and source != "BIG5/Big5.src"]
[citrus_encoding(name = stem + "_source", template = source, variables = "BIG5/Big5.variable",
    key = substitutions["encoding"][5:], encoding = substitutions["encoding"],
    output = stem + ".src", script = "expand_variable.awk", awk = "//usr.bin/awk:awk")
 for stem, source, substitutions in ENCODINGS if source == "BIG5/Big5.src"]
[citrus_database(name = stem + "_database",
    src = ":" + stem + "_source" if substitutions else source,
    output = stem + ".esdb", tool = "//usr.bin/mkesdb:mkesdb_tool")
 for stem, source, substitutions in ENCODINGS]
filegroup(name = "encoding_databases", srcs = [":" + stem + "_database" for stem, _, _ in ENCODINGS],
    visibility = ["//visibility:public"])
filegroup(name = "expanded_sources", srcs = [":" + stem + "_source" for stem, _, substitutions in ENCODINGS if substitutions])

load(":indexes.bzl", "ENCODING_FAMILIES")
load("//tools/build/bazel:bsd_citrus_index.bzl", "citrus_index")
# Validate index membership against the generated database inventory.
load(":index_policy.bzl", "encoding_index_layout")
citrus_index(name = "indexes", layout = encoding_index_layout(ENCODINGS, ENCODING_FAMILIES),
    aliases = [directory + "/" + code + ".alias" for directory, code, _, _ in ENCODING_FAMILIES],
    script = "encoding_indexes.awk", awk = "//usr.bin/awk:awk")
filegroup(name = "directory", srcs = [":indexes"], output_group = "directory")
filegroup(name = "aliases", srcs = [":indexes"], output_group = "aliases")
citrus_database(name = "directory_database", src = ":directory", output = "esdb.dir.db",
    mode = "lookup", tool = "//usr.bin/mkesdb:mkesdb_tool")
citrus_database(name = "alias_database", src = ":aliases", output = "esdb.alias.db",
    mode = "lookup", tool = "//usr.bin/mkesdb:mkesdb_tool")
filegroup(name = "encoding_indexes", srcs = [":indexes", ":directory_database", ":alias_database"],
    visibility = ["//visibility:public"])

load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest")
_INSTALL_FILES = [(":" + stem + "_database", stem + ".esdb") for stem, _, _ in ENCODINGS] + [(":directory", "esdb.dir"), (":aliases", "esdb.alias"), (":directory_database", "esdb.dir.db"), (":alias_database", "esdb.alias.db")]
[bsd_install_file(name = "install_" + destination, src = source,
    destination = "/usr/share/i18n/esdb/" + destination,
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=utilities"])
 for source, destination in _INSTALL_FILES]
bsd_install_manifest(name = "install_manifest", entries = [":install_" + destination for _, destination in _INSTALL_FILES],
    visibility = ["//visibility:public"])
