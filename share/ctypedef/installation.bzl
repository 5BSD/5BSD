def ctype_installation():
    optional = []
    directories = {}
    for locale in LOCALES:
        name = "install_" + locale
        bsd_install_file(name = name, src = ":" + locale,
            destination = "/usr/share/locale/" + locale + "/LC_CTYPE",
            owner = "root", group = "wheel", mode = "0444",
            install_tags = ["package=runtime" if locale == "C.UTF-8" else "package=locales"])
        if locale != "C.UTF-8":
            optional.append(":" + name)
            directories["/usr/share/locale/" + locale] = json.encode(dict(owner = "root", group = "wheel", mode = "0755", tags = ["package=locales"]))
    for source, alias in ALIASES:
        name = "alias_" + alias
        bsd_install_link(name = name,
            destination = "/usr/share/locale/" + alias + "/LC_CTYPE",
            target = "../" + source + "/LC_CTYPE", kind = "symlink",
            owner = "root", group = "wheel", mode = "0755", install_tags = ["package=locales"])
        optional.append(":" + name)
        directories["/usr/share/locale/" + alias] = json.encode(dict(owner = "root", group = "wheel", mode = "0755", tags = ["package=locales"]))
    bsd_install_manifest(name = "install_manifest", entries = [":install_C.UTF-8"] + select({
        "//tools/build/bazel/config:locales_enabled": optional, "//conditions:default": [],
    }))
    # Preserve Make's directory ownership tag; the C.UTF-8 file itself is runtime.
    always = {"/usr/share": json.encode(dict(owner = "root", group = "wheel", mode = "0755", tags = ["package=utilities"])), "/usr/share/locale/C.UTF-8": json.encode(dict(owner = "root", group = "wheel", mode = "0755", tags = ["package=utilities"]))}
    bsd_install_archive(name = "install_archive", manifests = [":install_manifest"],
        directories = select({"//tools/build/bazel/config:locales_enabled": dict(always.items() + directories.items()), "//conditions:default": always}),
        mtree_specs = {"//etc/mtree:BSD.root.dist": "/", "//etc/mtree:BSD.usr.dist": "/usr"},
        passwd = "//etc:master.passwd", group = "//etc:group",
        mtree = "@bsd_sdk//toolchain:extra_mtree", epoch = 0,
        python = "@bsd_sdk//toolchain:extra_python", python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
        runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"])
