load("//tools/build/bazel:bsd_capdb.bzl", "bsd_capability_database")
# Explicit byte-order artifacts support qualification before platform selection.
[bsd_capability_database(name = "database_" + endian, srcs = ["termcap"],
    output = endian + "/termcap.db", endian = endian,
    compiler = "//usr.bin/cap_mkdb:cap_mkdb_bootstrap",
    runtime_libraries = ["@bsd_sdk//toolchain:sysroot/lib/libc.so.7",
        "@bsd_sdk//toolchain:sysroot/lib/libsys.so.7"],
    visibility = ["//visibility:public"]) for endian in ["little", "big"]]

config_setting(name = "amd64", constraint_values = ["@platforms//cpu:x86_64"])
alias(name = "database", actual = select({":amd64": ":database_little"},
    no_match_error = "termcap installation needs an explicit target byte-order mapping"))
load("//tools/build/bazel:bsd_install.bzl", "bsd_install_file", "bsd_install_manifest")
bsd_install_file(name = "install_source", src = "termcap", destination = "/usr/share/misc/termcap",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=ncurses-lib"])
bsd_install_file(name = "install_database", src = ":database", destination = "/usr/share/misc/termcap.db",
    owner = "root", group = "wheel", mode = "0444", install_tags = ["package=ncurses-lib"])
load("//tools/build/bazel:bsd_manual_installation.bzl", "manual_entries")
# Explicit MANPACKAGE=ncurses overrides the split-manpage subpackage.
_MANUALS = manual_entries("manual", ["termcap.5"], package = "ncurses", split = False)
bsd_install_manifest(name = "install_manifest", entries = [":install_source", ":install_database"] + select({
    "//tools/build/bazel/config:man_enabled": _MANUALS, "//conditions:default": [],
}), visibility = ["//visibility:public"])
load("//tools/build/bazel:bsd_install_archive.bzl", "bsd_install_archive")

# Aggregate installation candidate; pkgbase subpackage construction is separate.
bsd_install_archive(
    name = "install_archive", visibility = ["//share:__pkg__"],
    manifests = [":install_manifest"],
    directories = {"/usr/share/misc": '{"owner":"root","group":"wheel","mode":"0755","tags":["package=ncurses-lib"]}'},
    mtree_specs = {
        "//etc/mtree:BSD.root.dist": "/",
        "//etc/mtree:BSD.usr.dist": "/usr",
        "//etc/mtree:BSD.include.dist": "/usr/include",
        "//etc/mtree:BSD.debug.dist": "/usr/lib",
    },
    passwd = "//etc:master.passwd",
    group = "//etc:group",
    mtree = "@bsd_sdk//toolchain:extra_mtree",
    epoch = 0,
    python = "@bsd_sdk//toolchain:extra_python",
    python_home = "@bsd_sdk//toolchain:python-home/runtime.json",
    runtime = ["@bsd_sdk//toolchain:python_stdlib", "@bsd_sdk//toolchain:extra_mtree_runtime"],
)

exports_files(["termcap"], visibility = ["//etc/termcap:__pkg__"])
