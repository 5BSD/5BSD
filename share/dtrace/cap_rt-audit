#!/usr/sbin/dtrace -s
/*
 * SPDX-License-Identifier: BSD-2-Clause
 *
 * cap_rt-audit -- unified CAP_RT capability audit stream.
 */

#pragma D option quiet

dtrace:::BEGIN
{
	printf("%-6s %-6s %-6s %-18s %-14s %-16s %-10s %-10s %s\n",
	    "PID", "UID", "GID", "NONCE", "EVENT", "SERVICE", "BADGE",
	    "ARG", "DETAIL");
}

cap_rt:::fd-install,
cap_rt:::fd-receive,
cap_rt:::fd-close,
cap_rt:::control,
cap_rt:::rights-change
{
	printf("%-6d %-6d %-6d 0x%016x %-14s %-16s %-10d %-10d jail=%d\n",
	    arg3, ((struct ucred *)arg4)->cr_uid,
	    ((struct ucred *)arg4)->cr_gid, arg5, probename,
	    copyinstr(arg0), arg1, arg2,
	    ((struct ucred *)arg4)->cr_prison->pr_id);
	@events[probename] = count();
}

cap_rt:::ioctl-deny,
cap_rt:::instance-finalize,
cap_rt:::instance-lastclose
{
	printf("%-6d %-6d %-6d 0x%016x %-14s %-16s %-10d %-10d jail=%d\n",
	    arg3, ((struct ucred *)arg4)->cr_uid,
	    ((struct ucred *)arg4)->cr_gid, arg5, probename,
	    copyinstr(arg0), arg1, arg2,
	    ((struct ucred *)arg4)->cr_prison->pr_id);
	@events[probename] = count();
}

cap_rt:::error
{
	printf("%-6d %-6s %-6s 0x%016x %-14s %-16s %-10d cmd=%-6d errno=%d\n",
	    arg3, "-", "-", arg4, "error", copyinstr(arg0), arg1,
	    arg2, arg5);
	@errors[copyinstr(arg0), arg2, arg5] = count();
}

cap_rt:::state
{
	printf("%-6d %-6s %-6s 0x%016x %-14s %-16s %-10d flags=0x%x restricted=0x%x\n",
	    arg4, "-", "-", arg5, "state", copyinstr(arg0), arg1,
	    arg2, arg3);
	@state[copyinstr(arg0), arg2, arg3] = count();
}

cap_rt:::queue-pressure
{
	printf("%-6s %-6s %-6s %-18s %-14s %-16s %-10d queue=%s cur=%d limit=%d\n",
	    "-", "-", "-", "-", "pressure", copyinstr(arg0), arg1,
	    copyinstr(arg2), arg3, arg4);
	@events["queue-pressure"] = count();
}

cap_rt:::service-create
{
	printf("%-6s %-6s %-6s %-18s %-14s %-16s %-10s flags=0x%x q=%d tx=%d limit=%d\n",
	    "-", "-", "-", "-", "service-up", copyinstr(arg0), "-",
	    arg1, arg2, arg3, arg4);
	@events["service-create"] = count();
}

cap_rt:::service-destroy
{
	printf("%-6s %-6s %-6s %-18s %-14s %-16s %-10s flags=0x%x\n",
	    "-", "-", "-", "-", "service-down", copyinstr(arg0), "-",
	    arg1);
	@events["service-destroy"] = count();
}

cap_rt_capprotect:::state,
cap_rt_system:::state,
cap_rt_isolation:::state
{
	printf("%-6d %-6s %-6s %-18s %-14s %-16s %-10d owner=0x%016x accessor=0x%016x state_arg=%d err=%d\n",
	    pid, "-", "-", "-", copyinstr(arg0), probemod, arg2,
	    arg1, arg2, arg4, arg5);
	@subsys[probemod, copyinstr(arg0)] = count();
}

cap_rt_capprotect:::deny,
cap_rt_system:::deny,
cap_rt_isolation:::deny
{
	printf("%-6d %-6s %-6s %-18s %-14s %-16s %-10s owner=0x%016x accessor=0x%016x\n",
	    pid, "-", "-", "-", "deny", probemod, copyinstr(arg0),
	    arg1, arg2);
	@denies[probemod, copyinstr(arg0)] = count();
}

cap_rt_capprotect:::allow,
cap_rt_system:::allow
{
	printf("%-6d %-6s %-6s %-18s %-14s %-16s %-10s owner=0x%016x accessor=0x%016x\n",
	    pid, "-", "-", "-", "allow", probemod, copyinstr(arg0),
	    arg1, arg2);
	@allows[probemod, copyinstr(arg0)] = count();
}

cap_rt_isolation:::allow-action
{
	printf("%-6d %-6s %-6s %-18s %-14s %-16s %-10s owner=0x%016x accessor=0x%016x\n",
	    pid, "-", "-", "-", "allow", "isolation", copyinstr(arg0),
	    arg1, arg2);
	@allows["isolation", copyinstr(arg0)] = count();
}

cap_rt_node:::call-done
{
	printf("%-6d %-6s %-6s %-18s %-14s %-16s %-10d op=%-6d status=%-6d errno=%d\n",
	    arg2, "-", "-", "-", "node-call", "node", arg1,
	    arg0, arg3, arg4);
	@events["node-call"] = count();
}

cap_rt_node:::deny
{
	printf("%-6d %-6s %-6s %-18s %-14s %-16s %-10s target=%d caller=%d\n",
	    pid, "-", "-", "-", "deny", "node", copyinstr(arg0),
	    arg1, arg2);
	@denies["node", copyinstr(arg0)] = count();
}

cap_rt_mount:::state
{
	printf("%-6d %-6s %-6s %-18s %-14s %-16s %-10s fstype=%s path=%s status=%d\n",
	    arg4, "-", "-", "-", copyinstr(arg0), "mount", "-",
	    copyinstr(arg1), copyinstr(arg2), arg3);
	@events[copyinstr(arg0)] = count();
}

cap_rt_mount:::deny
{
	printf("%-6d %-6s %-6s %-18s %-14s %-16s %-10s fstype=%s path=%s\n",
	    pid, "-", "-", "-", "deny", "mount", copyinstr(arg0),
	    copyinstr(arg1), copyinstr(arg2));
	@denies["mount", copyinstr(arg0)] = count();
}

cap_rt_acct:::state
{
	printf("%-6d %-6s %-6s %-18s %-14s %-16s %-10d resource=%-6d amount=%d status=%d\n",
	    arg4, "-", "-", "-", copyinstr(arg0), "accounting", arg1,
	    arg1, arg2, arg3);
	@events[copyinstr(arg0)] = count();
}

cap_rt_acct:::deny
{
	printf("%-6d %-6s %-6s %-18s %-14s %-16s %-10s uid=%d errno=%d\n",
	    pid, "-", "-", "-", "deny", "accounting", copyinstr(arg0),
	    arg1, arg2);
	@denies["accounting", copyinstr(arg0)] = count();
}

cap_rt_channel:::state
{
	printf("%-6d %-6s %-6s %-18s %-14s %-16s %-10s op=%d badge=%d err=%d\n",
	    pid, "-", "-", "-", copyinstr(arg0), "channel", "-",
	    arg1, arg2, arg3);
	@subsys["channel", copyinstr(arg0)] = count();
}

cap_rt_channel:::create
{
	printf("%-6d %-6s %-6s %-18s %-14s %-16s %-10d peer=%d\n",
	    pid, "-", "-", "-", "channel-create", "channel", arg0, arg1);
	@events["channel-create"] = count();
}

cap_rt_channel:::forward
{
	printf("%-6d %-6s %-6s %-18s %-14s %-16s %-10d dst=%d len=%d\n",
	    pid, "-", "-", "-", "channel-fwd", "channel", arg0, arg1, arg2);
	@events["channel-forward"] = count();
}

cap_rt_coalition:::deny
{
	printf("%-6d %-6s %-6s %-18s %-14s %-16s %-10s errno=%d\n",
	    arg2, "-", "-", "-", "deny", "coalition", copyinstr(arg0),
	    arg1);
	@denies["coalition", copyinstr(arg0)] = count();
}

dtrace:::END
{
	printf("\n--- CAP_RT events ---\n");
	printa("%-24s %@d\n", @events);

	printf("\n--- CAP_RT errors by service/cmd/errno ---\n");
	printa("%-16s cmd=%-10d errno=%-6d %@d\n", @errors);

	printf("\n--- Subsystem state transitions ---\n");
	printa("%-20s %-16s %@d\n", @subsys);

	printf("\n--- Denials ---\n");
	printa("%-20s %-16s %@d\n", @denies);

	printf("\n--- Allows ---\n");
	printa("%-20s %-16s %@d\n", @allows);
}
