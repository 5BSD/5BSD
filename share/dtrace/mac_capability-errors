 *
 * mac_capability-errors -- trace MAC_CAPABILITY ioctl failures.
 *
 * Fires on every failed MAC_CAPABILITY ioctl and shows the errno, command,
 * and calling process.  Useful for diagnosing capability access
 * denials, queue full conditions, and terminated instances.
 *
 * Usage: mac_capability-errors
 */

#pragma D option quiet

dtrace:::BEGIN
{
	printf("%-6s %-16s %-10s %-6s %s\n",
	    "PID", "COMM", "IOCTL", "ERRNO", "TIME");
}

fbt::mac_capability_instance_ioctl:return
/arg1 != 0/
{
	printf("%-6d %-16s %-10s %-6d %Y\n",
	    pid, execname, "instance", arg1, walltimestamp);
	@errs[arg1] = count();
}

fbt::mac_capability_cdev_ioctl:return
/arg1 != 0/
{
	printf("%-6d %-16s %-10s %-6d %Y\n",
	    pid, execname, "connect", arg1, walltimestamp);
	@errs[arg1] = count();
}

dtrace:::END
{
	printf("\n--- Error counts by errno ---\n");
	printa("errno %-6@d: %@d\n", @errs);
}
