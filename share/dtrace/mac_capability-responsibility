#!/usr/sbin/dtrace -s
/*
 * Copyright (c) 2026 Kory Heard
 *
 * SPDX-License-Identifier: BSD-2-Clause
 *
 * mac_capability-responsibility -- who caused what to run, and what was
 * killed on whose behalf.
 *
 * The process tree cannot answer either question: the switchboard is the
 * parent of everything it launches.  Coalitions can.  Every unit and every
 * login session is a coalition with a permanent id, and each one records
 * the party it exists on behalf of.  This script follows both halves at
 * once: the launcher's decisions (who a unit answers to, a session getting
 * its coalition, a session's units being withdrawn, a launch constraint
 * refusing an activation) and the kernel's outcomes (coalitions created
 * and torn down, members signalled or released, memory pressure).
 *
 * The line to watch when a process disappears is member-kill: it names the
 * coalition, the coalition responsible for it, the pid and the signal.  A
 * signal of 0 is a release, not a kill -- an attribution-only coalition
 * such as a login session lets its members go.
 *
 * See ps(1) -o coal,rcoal,rpid, procstat(1) coalition, and
 * "switchboardctl tree" for the same relation at rest.
 *
 * Usage: mac_capability-responsibility
 */

#pragma D option quiet
#pragma D option switchrate=10hz

dtrace:::BEGIN
{
	printf("Tracing responsibility... Ctrl-C for summary.\n\n");
	printf("%-12s %-18s %-26s %s\n", "TIME", "EVENT", "SUBJECT", "DETAIL");
}

/* ---- The launcher's decisions ---- */

switchboard*:::responsible
{
	printf("%-12Y %-18s %-26s coalition=%llu responsible=%llu (%s)\n",
	    walltimestamp, "launch", copyinstr(arg0),
	    (unsigned long long)arg2, (unsigned long long)arg3,
	    copyinstr(arg1));
	@events["unit launched"] = count();
	@by[copyinstr(arg1)] = count();
}

switchboard*:::session-coalition
/arg1 != 0/
{
	printf("%-12Y %-18s %-26s coalition=%llu\n", walltimestamp,
	    "session begin", strjoin("uid=", lltostr((long long)arg0)),
	    (unsigned long long)arg1);
	@events["session begin"] = count();
}

switchboard*:::session-coalition
/arg1 == 0/
{
	printf("%-12Y %-18s %-26s unattributed, error=%d\n", walltimestamp,
	    "session begin", strjoin("uid=", lltostr((long long)arg0)), arg2);
	@events["session unattributed"] = count();
}

switchboard*:::session-end
{
	printf("%-12Y %-18s %-26s session uid=%d ended\n", walltimestamp,
	    "withdraw", copyinstr(arg0), arg1);
	@events["unit withdrawn"] = count();
}

switchboard*:::on-demand-deny
{
	printf("%-12Y %-18s %-26s refused: %s may not cause it\n",
	    walltimestamp, "constraint", copyinstr(arg1), copyinstr(arg2));
	@events["launch refused"] = count();
	@refused[copyinstr(arg1)] = count();
}

/* ---- The kernel's outcomes ---- */

mac_capability_coalition:::create
{
	printf("%-12Y %-18s %-26s badge=%llu\n", walltimestamp, "coalition new",
	    strjoin("coalition=", lltostr((long long)arg0)),
	    (unsigned long long)arg1);
	@events["coalition created"] = count();
}

mac_capability_coalition:::responsible-set
/arg2 == 0/
{
	printf("%-12Y %-18s %-26s responsible=%llu\n", walltimestamp,
	    "edge recorded", strjoin("coalition=", lltostr((long long)arg0)),
	    (unsigned long long)arg1);
	@events["edge recorded"] = count();
}

mac_capability_coalition:::responsible-set
/arg2 != 0/
{
	printf("%-12Y %-18s %-26s refused, error=%d\n", walltimestamp,
	    "edge refused", strjoin("coalition=", lltostr((long long)arg0)),
	    arg2);
	@events["edge refused"] = count();
}

mac_capability_coalition:::member-kill
{
	printf("%-12Y %-18s %-26s pid=%d responsible=%llu%s\n", walltimestamp,
	    arg3 == 0 ? "member released" : "member killed",
	    strjoin("coalition=", lltostr((long long)arg0)), arg2,
	    (unsigned long long)arg1,
	    arg3 == 0 ? "" : strjoin(" signal=", lltostr((long long)arg3)));
	@events[arg3 == 0 ? "members released" : "members killed"] = count();
	@killed[(unsigned long long)arg0] = count();
}

mac_capability_coalition:::rehome
{
	printf("%-12Y %-18s %-26s pid=%d\n", walltimestamp, "member rehomed",
	    strjoin("from coalition=", lltostr((long long)arg1)), arg0);
	@events["members rehomed"] = count();
}

mac_capability_coalition:::close
{
	@events["coalitions closed"] = count();
}

mac_capability_coalition:::pressure
{
	printf("%-12Y %-18s %-26s %u of %u coalitions told\n", walltimestamp,
	    "memory pressure", "system", arg1, arg0);
	@events["pressure passes"] = count();
}

dtrace:::END
{
	printf("\nEvents:\n");
	printa("  %-24s %@d\n", @events);
	printf("\nUnits launched, by responsible party:\n");
	printa("  %-32s %@d\n", @by);
	printf("\nActivations refused by a launch constraint:\n");
	printa("  %-32s %@d\n", @refused);
	printf("\nMembers signalled or released, by coalition:\n");
	printa("  coalition %-22llu %@d\n", @killed);
}
