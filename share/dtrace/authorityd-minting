 * SPDX-License-Identifier: BSD-2-Clause
 *
 * authorityd-minting -- trace capability token minting requests.
 *
 * Shows each token mint request from serviced with the resource
 * being minted and the result (0=success, errno=failure).
 *
 * Usage: authorityd-minting
 */

#pragma D option quiet

dtrace:::BEGIN
{
	printf("Tracing authorityd token minting... Ctrl-C for summary.\n\n");
	printf("%-20s %-8s %-8s %s\n",
	    "TIME", "TYPE", "RESULT", "RESOURCE");
}

authorityd*:::mint-path
{
	printf("%-20Y %-8s %-8s %s\n", walltimestamp,
	    "path", arg1 == 0 ? "OK" : "DENIED",
	    copyinstr(arg0));
	@by_result[arg1 == 0 ? "path:ok" : "path:denied"] = count();
}

authorityd*:::mint-file
{
	printf("%-20Y %-8s %-8s %s actions=0x%x\n", walltimestamp,
	    "file", arg2 == 0 ? "OK" : "DENIED", copyinstr(arg0),
	    (uint64_t)arg1);
	@by_result[arg2 == 0 ? "file:ok" : "file:denied"] = count();
}

authorityd*:::mint-net
/arg0 == arg1/
{
	printf("%-20Y %-8s %-8s port %d/%s\n", walltimestamp,
	    "net", arg3 == 0 ? "OK" : "DENIED",
	    arg0, arg2 == 6 ? "tcp" : arg2 == 17 ? "udp" : "?");
	@by_result[arg3 == 0 ? "net:ok" : "net:denied"] = count();
}

authorityd*:::mint-net
/arg0 != arg1/
{
	printf("%-20Y %-8s %-8s port %d-%d/%s\n", walltimestamp,
	    "net", arg3 == 0 ? "OK" : "DENIED",
	    arg0, arg1, arg2 == 6 ? "tcp" : arg2 == 17 ? "udp" : "?");
	@by_result[arg3 == 0 ? "net:ok" : "net:denied"] = count();
}

authorityd*:::mint-jail
{
	printf("%-20Y %-8s %-8s jid=%d name=%s actions=0x%x\n",
	    walltimestamp, "jail", arg3 == 0 ? "OK" : "DENIED",
	    arg0, copyinstr(arg1), arg2);
	@by_result[arg3 == 0 ? "jail:ok" : "jail:denied"] = count();
}

authorityd*:::mint-system
{
	printf("%-20Y %-8s %-8s gates=0x%x\n", walltimestamp,
	    "system", arg1 == 0 ? "OK" : "DENIED", arg0);
	@by_result[arg1 == 0 ? "system:ok" : "system:denied"] = count();
}

authorityd*:::mint-vsock
{
	printf("%-20Y %-8s %-8s cid=%u ports=%u-%u\n", walltimestamp,
	    "vsock", arg3 == 0 ? "OK" : "DENIED", arg0, arg1, arg2);
	@by_result[arg3 == 0 ? "vsock:ok" : "vsock:denied"] = count();
}

authorityd*:::create-jail
{
	printf("%-20Y %-8s %-8s %s\n", walltimestamp,
	    "jailnew", arg1 == 0 ? "OK" : "FAIL", copyinstr(arg0));
	@by_result[arg1 == 0 ? "jail-create:ok" : "jail-create:fail"] = count();
}

authorityd*:::channel-create
{
	printf("%-20Y %-8s %-8s\n", walltimestamp,
	    "channel", arg0 == 0 ? "OK" : "FAIL");
	@by_result[arg0 == 0 ? "channel:ok" : "channel:fail"] = count();
}

authorityd*:::coalition-create
{
	printf("%-20Y %-8s %-8s\n", walltimestamp,
	    "coalit", arg0 == 0 ? "OK" : "FAIL");
	@by_result[arg0 == 0 ? "coalition:ok" : "coalition:fail"] = count();
}

authorityd*:::kmod-ensure
{
	printf("%-20Y %-8s %-8s %s\n", walltimestamp,
	    "kmod", arg1 == 0 ? "OK" : "FAIL", copyinstr(arg0));
	@by_result[arg1 == 0 ? "kmod:ok" : "kmod:fail"] = count();
}

authorityd*:::service-delegate
{
	printf("%-20Y %-8s %-8s %s\n", walltimestamp,
	    "service", arg1 == 0 ? "OK" : "FAIL", copyinstr(arg0));
	@by_result[arg1 == 0 ? "service:ok" : "service:fail"] = count();
}

dtrace:::END
{
	printf("\n--- Minting summary ---\n");
	printa("  %-24s %@d\n", @by_result);
}
