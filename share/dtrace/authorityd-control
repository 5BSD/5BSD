 *
 * authorityd-control -- trace control socket commands.
 *
 * Shows each command received on the control socket with the
 * requesting UID and operation code.
 *
 * Usage: authorityd-control
 */

#pragma D option quiet

inline string ctl_op[uint32_t op] =
	op == 1 ? "shutdown" :
	op == 2 ? "status" :
	op == 3 ? "reload" :
	op == 4 ? "kldload" :
	op == 5 ? "kldunload" :
	op == 6 ? "reboot" :
	"unknown";

dtrace:::BEGIN
{
	printf("Tracing authorityd control commands... Ctrl-C to stop.\n\n");
	printf("%-20s %-6s %-6s %-12s\n",
	    "TIME", "PID", "UID", "COMMAND");
}

authorityd*:::ctl-cmd
{
	printf("%-20Y %-6d %-6d %-12s\n",
	    walltimestamp, pid, arg1, ctl_op[arg0]);
	@cmds[ctl_op[arg0]] = count();
}

authorityd*:::ctl-deny
{
	printf("%-20Y %-6d %-6d %-12s (DENIED)\n",
	    walltimestamp, pid, arg1, ctl_op[arg0]);
	@denied[ctl_op[arg0]] = count();
}

dtrace:::END
{
	printf("\n--- Command counts ---\n");
	printa("  %-12s %@d\n", @cmds);
	printf("\n--- Denied counts ---\n");
	printa("  %-12s %@d\n", @denied);
}
