 *
 * mac_capability-calls -- trace MAC_CAPABILITY_CALL latency per service.
 *
 * Shows each sync call with service name, request size, and
 * elapsed time.  On exit (Ctrl-C), prints a latency histogram
 * per service.
 *
 * Usage: mac_capability-calls
 */

#pragma D option quiet

dtrace:::BEGIN
{
	printf("%-6s %-16s %-8s %-10s\n",
	    "PID", "SERVICE", "REQLEN", "LATENCY");
}

mac_capability:::call
{
	self->ts = timestamp;
	self->svc = copyinstr(arg0);
	self->reqlen = arg2;
}

mac_capability:::call-done
/self->ts/
{
	this->delta = (timestamp - self->ts) / 1000;
	printf("%-6d %-16s %-8d %d us\n",
	    pid, self->svc, self->reqlen, this->delta);
	@lat[self->svc] = quantize(this->delta);
	self->ts = 0;
	self->svc = 0;
}

/* Fallback: if call-done doesn't fire, clear on revoke */
mac_capability:::revoke
/self->ts/
{
	self->ts = 0;
	self->svc = 0;
}

dtrace:::END
{
	printf("\n--- Call latency (us) by service ---\n");
	printa(@lat);
}
