 *
 * SPDX-License-Identifier: BSD-2-Clause
 *
 * capsicum-changes -- trace Capsicum authority narrowing.
 *
 * Shows cap_enter(), capability limit operations, and one-shot
 * descriptor propagation consumption with credentials and final errno.
 *
 * Usage: capsicum-changes
 */

#pragma D option quiet

dtrace:::BEGIN
{
	printf("%-6s %-6s %-6s %-8s %-16s %-8s %-8s %s\n",
	    "PID", "UID", "GID", "FD", "EVENT", "TYPE", "ERRNO",
	    "DETAIL");
}

capsicum:::mode-enter
{
	printf("%-6d %-6d %-6d %-8s %-16s %-8s %-8d %s\n",
	    arg0, ((struct ucred *)arg1)->cr_uid,
	    ((struct ucred *)arg1)->cr_gid, "-", "MODE-ENTER",
	    "-", arg2, "");
}

capsicum:::rights-limit
{
	printf("%-6d %-6d %-6d %-8d %-16s %-8d %-8d rightsp=%p\n",
	    arg1, ((struct ucred *)arg2)->cr_uid,
	    ((struct ucred *)arg2)->cr_gid, arg0, "RIGHTS-LIMIT",
	    arg5, arg4, arg3);
}

capsicum:::ioctls-limit
{
	printf("%-6d %-6d %-6d %-8d %-16s %-8s %-8d ncmds=%d cmds=%p\n",
	    arg1, ((struct ucred *)arg2)->cr_uid,
	    ((struct ucred *)arg2)->cr_gid, arg0, "IOCTLS-LIMIT",
	    "-", arg5, arg4, arg3);
}

capsicum:::fcntls-limit
{
	printf("%-6d %-6d %-6d %-8d %-16s %-8d %-8d rights=0x%x\n",
	    arg1, ((struct ucred *)arg2)->cr_uid,
	    ((struct ucred *)arg2)->cr_gid, arg0, "FCNTLS-LIMIT",
	    arg5, arg4, arg3);
}

capsicum:::xfer-limit,
capsicum:::cloexec-limit,
capsicum:::clofork-limit
{
	printf("%-6d %-6d %-6d %-8d %-16s %-8s %-8d state=%d old=%d\n",
	    arg1, ((struct ucred *)arg2)->cr_uid,
	    ((struct ucred *)arg2)->cr_gid, arg0, probename,
	    "-", arg4, arg3, arg5);
}

/*
 * cloexec consume: file*, fd, pid, ucred, f_type, new state.
 */
fd:::cloexec-consume
{
	printf("%-6d %-6d %-6d %-8d %-16s %-8d %-8s new_state=%d\n",
	    arg2, ((struct ucred *)arg3)->cr_uid,
	    ((struct ucred *)arg3)->cr_gid, arg1, "CLOEXEC-ONCE",
	    arg4, "-", arg5);
}

/*
 * clofork consume: file*, fd, parent pid, child pid, ucred, f_type.
 */
fd:::clofork-consume
{
	printf("%-6d %-6d %-6d %-8d %-16s %-8d %-8s child=%d\n",
	    arg2, ((struct ucred *)arg4)->cr_uid,
	    ((struct ucred *)arg4)->cr_gid, arg1, "CLOFORK-ONCE",
	    arg5, "-", arg3);
}

capsicum:::ioctl-deny
{
	printf("%-6d %-6d %-6d %-8d %-16s %-8d %-8d cmd=%d\n",
	    arg1, ((struct ucred *)arg2)->cr_uid,
	    ((struct ucred *)arg2)->cr_gid, arg0, "IOCTL-DENY",
	    arg4, arg5, arg3);
}

capsicum:::fcntl-deny
{
	printf("%-6d %-6d %-6d %-8d %-16s %-8d %-8d cmd=%d\n",
	    arg1, ((struct ucred *)arg2)->cr_uid,
	    ((struct ucred *)arg2)->cr_gid, arg0, "FCNTL-DENY",
	    arg4, arg5, arg3);
}

capsicum:::check-deny
{
	printf("%-6d %-6d %-6d %-8s %-16s %-8s %-8d type=%d have=%p need=%p\n",
	    arg2, ((struct ucred *)arg3)->cr_uid,
	    ((struct ucred *)arg3)->cr_gid, "-", "CHECK-DENY",
	    "-", arg5, arg4, arg0, arg1);
}

capsicum:::rights-get
{
	printf("%-6d %-6d %-6d %-8d %-16s %-8d %-8d rightsp=%p\n",
	    arg1, ((struct ucred *)arg2)->cr_uid,
	    ((struct ucred *)arg2)->cr_gid, arg0, "RIGHTS-GET",
	    arg5, arg4, arg3);
}

capsicum:::ioctls-get
{
	printf("%-6d %-6d %-6d %-8d %-16s %-8s %-8d max=%d count=%d\n",
	    arg1, ((struct ucred *)arg2)->cr_uid,
	    ((struct ucred *)arg2)->cr_gid, arg0, "IOCTLS-GET",
	    "-", arg5, arg3, arg4);
}

capsicum:::fcntls-get
{
	printf("%-6d %-6d %-6d %-8d %-16s %-8d %-8d rights=0x%x\n",
	    arg1, ((struct ucred *)arg2)->cr_uid,
	    ((struct ucred *)arg2)->cr_gid, arg0, "FCNTLS-GET",
	    arg5, arg4, arg3);
}
