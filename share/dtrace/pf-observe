#!/usr/sbin/dtrace -s
/* SPDX-License-Identifier: BSD-2-Clause
 * PF (OpenBSD PF on 5BSD) performance and functional summary.
 * Usage: pf-observe (Ctrl-C prints summary)
 *        dtrace -s /usr/share/dtrace/pf-observe -c 'sleep 30'
 * Uses the pf SDT provider documented in dtrace_pf(4).  Latencies are
 * inclusive elapsed nanoseconds.  Nested pf_test() calls (route-to,
 * af-to) are tracked with a per-thread depth.  No payloads are printed.
 */
#pragma D option quiet
#pragma D option dynvarsize=16m

BEGIN { printf("PF observation started; Ctrl-C for summary.\n"); }

pf:ip:test:entry
{
	self->depth++;
	started[tid, self->depth] = timestamp;
}
pf:ip:test:finish
/self->depth > 0 && started[tid, self->depth] != 0/
{
	/* arg0 action (PF_PASS 0, PF_DROP 1), arg1 direction */
	@packet_ns[arg1, arg0] = quantize(timestamp - started[tid, self->depth]);
	@actions[arg1 == 1 ? "in" : arg1 == 2 ? "out" : "fwd",
	    arg0 == 0 ? "pass" : arg0 == 1 ? "drop" : "other"] = count();
	started[tid, self->depth] = 0;
	self->depth--;
}
pf::reason:set
{
	@reasons[arg0, stringof(arg1), arg2] = count();
}
pf:state:state:insert	{ @state["insert"] = count(); }
pf:state:state:remove	{ @state["remove"] = count(); }
pf:state:state:free	{ @state["free"] = count(); }
pf:state:purge:run	{ @state["purge-pass"] = count(); }
pf:frag:reassemble:entry, pf:frag:reassemble6:entry
{
	@frag[probefunc] = count();
}
pf:nat:transaddr:entry	{ @nat["translate"] = count(); }
pf:nat:af_to:translate	{ @nat["af-to"] = count(); }
pf:table:addr:match	{ @tables["lookup"] = count(); }
pf:log:pflog:packet	{ @logged = count(); }
pf:pfsync:packet:send	{ @pfsync["send"] = count(); }
pf:pfsync:packet:input	{ @pfsync["input"] = count(); }
pf:pflow:flow:export	{ @pflow = count(); }
pf:ioctl:ioctl:return
/arg2 != 0/
{
	@ioctl_errors[arg0, arg2] = count();
}

END
{
	printf("\n--- pf_test() latency (ns) by direction, action ---\n");
	printa(@packet_ns);
	printf("\n--- packets by direction and action ---\n");
	printa("  %-4s %-6s %@d\n", @actions);
	printf("\n--- drop/match reasons (PFRES, file, line) ---\n");
	printa("  reason %-3d %s:%d %@d\n", @reasons);
	printf("\n--- state lifecycle ---\n");
	printa("  %-12s %@d\n", @state);
	printf("\n--- fragments, NAT, tables ---\n");
	printa("  %-24s %@d\n", @frag);
	printa("  %-24s %@d\n", @nat);
	printa("  %-24s %@d\n", @tables);
	printf("\n--- logging and export ---\n");
	printa("  pflog packets %@d\n", @logged);
	printa("  pfsync %-6s %@d\n", @pfsync);
	printa("  pflow exports %@d\n", @pflow);
	printf("\n--- ioctl errors (cmd, errno) ---\n");
	printa("  0x%x %d %@d\n", @ioctl_errors);
}
