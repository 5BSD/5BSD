 *
 * oracled-bootstrap -- trace serviced lifecycle from oracled's perspective.
 *
 * Shows serviced start, exit, and restart events with backoff delays.
 *
 * Usage: oracled-bootstrap
 */

#pragma D option quiet

dtrace:::BEGIN
{
	printf("Tracing serviced bootstrap lifecycle... Ctrl-C for summary.\n\n");
	printf("%-20s %-8s %s\n", "TIME", "EVENT", "DETAIL");
}

oracled*:::bootstrap-start
{
	printf("%-20Y %-8s pid %d\n", walltimestamp, "START", arg0);
	@events["start"] = count();
}

oracled*:::bootstrap-exit
{
	printf("%-20Y %-8s pid %d status 0x%x\n", walltimestamp,
	    "EXIT", arg0, arg1);
	@events["exit"] = count();
}

oracled*:::bootstrap-restart
{
	printf("%-20Y %-8s count=%d delay=%ds\n", walltimestamp,
	    "RESTART", arg0, arg1);
	@events["restart"] = count();
}

oracled*:::error
/copyinstr(arg0) == "bootstrap"/
{
	printf("%-20Y %-8s %s\n", walltimestamp, "ERROR",
	    copyinstr(arg1));
	@events["error"] = count();
}

dtrace:::END
{
	printf("\n--- Bootstrap event counts ---\n");
	printa("  %-12s %@d\n", @events);
}
