 *
 * SPDX-License-Identifier: BSD-2-Clause
 *
 * cap_rt-summary -- aggregate CAP_RT activity over time.
 *
 * Run for a period, then Ctrl-C to see totals.  Shows connects,
 * messages, calls, and revokes per service, plus per-process
 * breakdowns.
 *
 * Usage: cap_rt-summary    (Ctrl-C to print report)
 */

#pragma D option quiet

cap_rt:::connect  { @conn[copyinstr(arg0)] = count(); }
cap_rt:::send     { @msgs[copyinstr(arg0)] = count(); }
cap_rt:::call     { @calls[copyinstr(arg0)] = count(); }
cap_rt:::revoke   { @revokes[copyinstr(arg0)] = count(); }
cap_rt:::close    { @closes[copyinstr(arg0)] = count(); }

cap_rt:::connect  { @byproc[pid, execname] = count(); }

dtrace:::END
{
	printf("--- Connects by service ---\n");
	printa("  %-20s %@d\n", @conn);

	printf("\n--- Messages by service ---\n");
	printa("  %-20s %@d\n", @msgs);

	printf("\n--- Calls by service ---\n");
	printa("  %-20s %@d\n", @calls);

	printf("\n--- Revokes by service ---\n");
	printa("  %-20s %@d\n", @revokes);

	printf("\n--- Closes by service ---\n");
	printa("  %-20s %@d\n", @closes);

	printf("\n--- Activity by process ---\n");
	printa("  pid=%-6d %-16s %@d events\n", @byproc);
}
