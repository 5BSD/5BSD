#!/usr/sbin/dtrace -s
/*
 * Copyright (c) 2026 The FreeBSD Foundation
 *
 * SPDX-License-Identifier: BSD-2-Clause
 *
 * cap_rt-summary -- aggregate CAP_RT activity over time.
 *
 * Run for a period, then Ctrl-C to see totals.  Shows connects,
 * messages, calls, and revokes per service, plus per-process
 * breakdowns.
 *
 * Usage: cap_rt-summary    (Ctrl-C to print report)
 */

#pragma D option quiet

cap_rt:::connect  { @conn[copyinstr(arg0)] = count(); }
cap_rt:::send     { @msgs[copyinstr(arg0)] = count(); }
cap_rt:::call     { @calls[copyinstr(arg0)] = count(); }
cap_rt:::revoke   { @revokes[copyinstr(arg0)] = count(); }
cap_rt:::close    { @closes[copyinstr(arg0)] = count(); }
cap_rt:::fd-install { @fdinst[copyinstr(arg0)] = count(); }
cap_rt:::fd-receive { @fdrecv[copyinstr(arg0)] = count(); }
cap_rt:::fd-close { @fdclose[copyinstr(arg0)] = count(); }
cap_rt:::control  { @controls[copyinstr(arg0), arg2] = count(); }
cap_rt:::ioctl-deny { @rtdenies[copyinstr(arg0), arg2, arg5] = count(); }
cap_rt:::error { @rterrors[copyinstr(arg0), arg2, arg5] = count(); }
cap_rt:::state { @rtstates[copyinstr(arg0), arg2, arg3] = count(); }
cap_rt:::instance-create { @instcreate[copyinstr(arg0)] = count(); }
cap_rt:::instance-finalize { @instfinal[copyinstr(arg0), arg2] = count(); }
cap_rt:::instance-lastclose { @instclose[copyinstr(arg0)] = count(); }
cap_rt:::fd-mint { @fdmint[copyinstr(arg0)] = count(); }
cap_rt:::service-create { @svccreate[copyinstr(arg0)] = count(); }
cap_rt:::service-destroy { @svcdestroy[copyinstr(arg0)] = count(); }
cap_rt_capprotect:::state { @cpstate[copyinstr(arg0)] = count(); }
cap_rt_system:::state { @sysstate[copyinstr(arg0)] = count(); }
cap_rt_isolation:::state { @fistate[copyinstr(arg0)] = count(); }
cap_rt_node:::call-done { @nodeops[arg0] = count(); }
cap_rt_node:::deny { @nodedeny[copyinstr(arg0)] = count(); }
cap_rt_channel:::state { @channelstate[copyinstr(arg0)] = count(); }
cap_rt_mount:::state { @mountstate[copyinstr(arg0), copyinstr(arg1)] = count(); }
cap_rt_mount:::deny { @mountdeny[copyinstr(arg0), copyinstr(arg1)] = count(); }
cap_rt_acct:::state { @acctstate[copyinstr(arg0), arg1] = count(); }
cap_rt_coalition:::deny { @codeny[copyinstr(arg0), arg1] = count(); }
cap_rt:::queue-pressure { @pressure[copyinstr(arg0), copyinstr(arg2)] = count(); }

cap_rt:::connect  { @byproc[pid, execname] = count(); }
cap_rt:::fd-install { @bynonce[arg5] = count(); }
cap_rt:::fd-receive { @bynonce[arg5] = count(); }
cap_rt:::control  { @bynonce[arg5] = count(); }
cap_rt:::state { @bynonce[arg5] = count(); }

cap_rt_capprotect:::allow { @cpallow[copyinstr(arg0)] = count(); }
cap_rt_system:::allow { @sysallow[copyinstr(arg0)] = count(); }
cap_rt_isolation:::allow-action { @fiallow[copyinstr(arg0)] = count(); }
cap_rt_isolation:::allow-net { @fiallow["net"] = count(); }
cap_rt_isolation:::allow-jail { @fiallow["jail"] = count(); }
cap_rt_channel:::create { @channelstate["create"] = count(); }
cap_rt_channel:::forward { @channelstate["forward"] = count(); }
cap_rt_coalition:::signal-set { @costate["signal-set"] = count(); }
cap_rt_coalition:::deadline-set { @costate["deadline-set"] = count(); }
cap_rt_coalition:::watchdog-set { @costate["watchdog-set"] = count(); }
cap_rt_coalition:::heartbeat { @costate["heartbeat"] = count(); }
cap_rt_coalition:::deadline-expire { @costate["deadline-expire"] = count(); }
cap_rt_coalition:::watchdog-expire { @costate["watchdog-expire"] = count(); }
cap_rt_coalition:::graceful { @costate["graceful"] = count(); }

dtrace:::END
{
	printf("--- Connects by service ---\n");
	printa("  %-20s %@d\n", @conn);

	printf("\n--- Messages by service ---\n");
	printa("  %-20s %@d\n", @msgs);

	printf("\n--- Calls by service ---\n");
	printa("  %-20s %@d\n", @calls);

	printf("\n--- Revokes by service ---\n");
	printa("  %-20s %@d\n", @revokes);

	printf("\n--- Closes by service ---\n");
	printa("  %-20s %@d\n", @closes);

	printf("\n--- FD lifecycle by service ---\n");
	printa("  install %-20s %@d\n", @fdinst);
	printa("  receive %-20s %@d\n", @fdrecv);
	printa("  fdclose %-20s %@d\n", @fdclose);

	printf("\n--- Control ioctls by service/cmd ---\n");
	printa("  %-20s cmd=%-10d %@d\n", @controls);

	printf("\n--- cap_rt ioctl denials by service/cmd/nonce ---\n");
	printa("  %-20s cmd=%-10d nonce=0x%016x %@d\n", @rtdenies);

	printf("\n--- cap_rt errors by service/cmd/errno ---\n");
	printa("  %-20s cmd=%-10d errno=%-6d %@d\n", @rterrors);

	printf("\n--- Instance lifecycle ---\n");
	printa("  create   %-20s %@d\n", @instcreate);
	printa("  mint     %-20s %@d\n", @fdmint);
	printa("  finalize %-20s reason=%-6d %@d\n", @instfinal);
	printa("  close    %-20s %@d\n", @instclose);

	printf("\n--- cap_rt state flags/restrictions ---\n");
	printa("  %-20s flags=0x%x restricted=0x%x %@d\n", @rtstates);

	printf("\n--- Service lifecycle ---\n");
	printa("  create  %-20s %@d\n", @svccreate);
	printa("  destroy %-20s %@d\n", @svcdestroy);

	printf("\n--- Protection subsystem state ---\n");
	printa("  capprotect %-20s %@d\n", @cpstate);
	printa("  system     %-20s %@d\n", @sysstate);
	printa("  isolation  %-20s %@d\n", @fistate);

	printf("\n--- Node service calls by op ---\n");
	printa("  op=%-6d %@d\n", @nodeops);

	printf("\n--- Node denials ---\n");
	printa("  %-16s %@d\n", @nodedeny);

	printf("\n--- Channel state ---\n");
	printa("  %-16s %@d\n", @channelstate);

	printf("\n--- Mount service ---\n");
	printa("  %-10s %-20s %@d\n", @mountstate);
	printa("  deny %-10s %-20s %@d\n", @mountdeny);

	printf("\n--- Accounting service ---\n");
	printa("  %-12s resource=%-6d %@d\n", @acctstate);

	printf("\n--- Coalition denials ---\n");
	printa("  %-16s errno=%-6d %@d\n", @codeny);

	printf("\n--- Authorized access ---\n");
	printa("  capprotect %-20s %@d\n", @cpallow);
	printa("  system     %-20s %@d\n", @sysallow);
	printa("  isolation  %-20s %@d\n", @fiallow);

	printf("\n--- Coalition operations ---\n");
	printa("  %-20s %@d\n", @costate);

	printf("\n--- Queue pressure ---\n");
	printa("  %-16s %-20s %@d\n", @pressure);

	printf("\n--- Activity by process ---\n");
	printa("  pid=%-6d %-16s %@d events\n", @byproc);

	printf("\n--- Activity by nonce ---\n");
	printa("  nonce=0x%016x %@d events\n", @bynonce);
}
