 *
 * switchboard-timeouts -- trace timer arm and fire events.
 *
 * Shows restart backoff timers and stop-kill escalation timers.
 * Useful for understanding service restart behavior and shutdown
 * timing under load.
 *
 * Usage: switchboard-timeouts
 */

#pragma D option quiet

dtrace:::BEGIN
{
	printf("Tracing switchboard timers... Ctrl-C for summary.\n\n");
	printf("%-20s %-20s %-10s %-8s %s\n",
	    "TIME", "SERVICE", "TYPE", "EVENT", "DETAIL");
}

switchboard*:::timeout-arm
{
	printf("%-20Y %-20s %-10s %-8s %d seconds\n", walltimestamp,
	    copyinstr(arg0), copyinstr(arg1), "ARM", arg2);
	@armed[copyinstr(arg1)] = count();
}

switchboard*:::timeout-fire
{
	printf("%-20Y %-20s %-10s %-8s\n", walltimestamp,
	    copyinstr(arg0), copyinstr(arg1), "FIRE");
	@fired[copyinstr(arg1)] = count();
}

dtrace:::END
{
	printf("\n--- Timers armed ---\n");
	printa("  %-12s %@d\n", @armed);
	printf("\n--- Timers fired ---\n");
	printa("  %-12s %@d\n", @fired);
}
