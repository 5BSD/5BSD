 *
 * cmi-messages -- trace async message flow.
 *
 * Shows send, dispatch, reply, recv, and notify events for
 * async services.  On exit, prints message counts per service.
 *
 * Usage: cmi-messages
 */

#pragma D option quiet

dtrace:::BEGIN
{
	printf("%-6s %-8s %-16s %-8s %-8s\n",
	    "PID", "EVENT", "SERVICE", "BADGE", "BYTES");
}

cmi:::send
{
	printf("%-6d %-8s %-16s %-8d %-8d\n",
	    pid, "SEND", copyinstr(arg0), arg1, arg2);
	@sends[copyinstr(arg0)] = count();
}

cmi:::dispatch
{
	printf("%-6d %-8s %-16s %-8d\n",
	    pid, "DISPATCH", copyinstr(arg0), arg1);
}

cmi:::reply
{
	printf("%-6d %-8s %-16s %-8d %-8d\n",
	    pid, "REPLY", copyinstr(arg0), arg1, arg2);
	@replies[copyinstr(arg0)] = count();
}

cmi:::recv
{
	printf("%-6d %-8s %-16s %-8d %-8d\n",
	    pid, "RECV", copyinstr(arg0), arg1, arg2);
}

cmi:::notify
{
	printf("%-6d %-8s %-16s %-8d %-8d\n",
	    pid, "NOTIFY", copyinstr(arg0), arg1, arg2);
	@notifies[copyinstr(arg0)] = count();
}

dtrace:::END
{
	printf("\n--- Message counts by service ---\n");
	printf("%-16s %-10s %-10s %-10s\n",
	    "SERVICE", "SENDS", "REPLIES", "NOTIFIES");
	printa("%-16s %-@10d\n", @sends);
	printa("%-16s %-10s %-@10d\n", @replies);
	printa("%-16s %-10s %-10s %-@10d\n", @notifies);
}
