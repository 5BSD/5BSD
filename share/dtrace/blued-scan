 *
 * Usage: blued-scan
 */

blued*:::scan-start  { printf("%-20Y SCAN %s\n", walltimestamp, copyinstr(arg0)); }
blued*:::scan-result { printf("%-20Y FOUND %s rssi=%d\n", walltimestamp, copyinstr(arg0), arg1); }
