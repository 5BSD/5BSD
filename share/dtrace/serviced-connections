 *
 * serviced-connections -- trace control socket connections.
 *
 * Shows connection accept/close events with the current connection
 * count.  Tracks high-water mark and connection rates.
 *
 * Usage: serviced-connections
 */

#pragma D option quiet

dtrace:::BEGIN
{
	printf("Tracing control socket connections... Ctrl-C for summary.\n\n");
	printf("%-20s %-8s %-6s %-6s %s\n",
	    "TIME", "DAEMON", "EVENT", "CONNS", "DETAIL");
	sctl_hwm = 0;
	ctl_hwm = 0;
}

serviced*:::conn-accept
{
	printf("%-20Y %-8s %-6s %-6d uid=%d\n", walltimestamp,
	    "sctl", "OPEN", arg1, arg0);
	sctl_hwm = arg1 > sctl_hwm ? arg1 : sctl_hwm;
	@sctl_rate["accept"] = count();
}

serviced*:::conn-close
{
	printf("%-20Y %-8s %-6s %-6d\n", walltimestamp,
	    "sctl", "CLOSE", arg0);
	@sctl_rate["close"] = count();
}

authorityd*:::conn-count
{
	printf("%-20Y %-8s %-6s %-6d\n", walltimestamp,
	    "ctl", "COUNT", arg0);
	ctl_hwm = arg0 > ctl_hwm ? arg0 : ctl_hwm;
	@ctl_rate["change"] = count();
}

serviced*:::authority-disconnected
{
	printf("%-20Y %-8s %-6s %-6d\n", walltimestamp,
	    "authority", "DISCON", 0);
	@sctl_rate["authority-dc"] = count();
}

dtrace:::END
{
	printf("\n--- serviced control socket ---\n");
	printa("  %-8s %@d\n", @sctl_rate);
	printf("  high-water: %d\n", sctl_hwm);
	printf("\n--- authorityd control socket ---\n");
	printa("  %-8s %@d\n", @ctl_rate);
	printf("  high-water: %d\n", ctl_hwm);
}
