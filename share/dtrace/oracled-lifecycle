 *
 * oracled-lifecycle -- trace daemon startup and shutdown events.
 *
 * Shows the complete lifecycle: config load, claims, integrity
 * activation, and shutdown with reason.
 *
 * Usage: oracled-lifecycle
 */

#pragma D option quiet

dtrace:::BEGIN
{
	printf("Tracing oracled lifecycle... Ctrl-C to stop.\n\n");
}

oracled*:::config-load
{
	printf("[%Y] config loaded: %s\n", walltimestamp,
	    copyinstr(arg0));
}

oracled*:::claim-path
{
	printf("[%Y] claimed path: %s\n", walltimestamp,
	    copyinstr(arg0));
}

oracled*:::claim-net
{
	printf("[%Y] claimed port: %d/%s\n", walltimestamp,
	    arg0, arg1 == 6 ? "tcp" : arg1 == 17 ? "udp" : "?");
}

oracled*:::integrity
{
	printf("[%Y] integrity flags: 0x%x\n", walltimestamp, arg0);
}

oracled*:::startup
{
	printf("[%Y] *** oracled started ***\n", walltimestamp);
}

oracled*:::shutdown
{
	printf("[%Y] *** oracled shutdown (reason=%d) ***\n",
	    walltimestamp, arg0);
}

oracled*:::error
{
	printf("[%Y] ERROR %s: %s\n", walltimestamp,
	    copyinstr(arg0), copyinstr(arg1));
}
