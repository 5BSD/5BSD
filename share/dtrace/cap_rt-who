 *
 * cap_rt-who -- trace CAP_RT capability lifecycle in real time.
 *
 * Shows connect, revoke, and close events with service name,
 * badge, and pid.
 *
 * Usage: cap_rt-who
 */

#pragma D option quiet

dtrace:::BEGIN
{
	printf("%-6s %-8s %-16s %-8s %s\n",
	    "PID", "EVENT", "SERVICE", "BADGE", "TIME");
}

cap_rt:::connect
{
	printf("%-6d %-8s %-16s %-8d %Y\n",
	    pid, "CONNECT", copyinstr(arg0), arg1, walltimestamp);
}

cap_rt:::revoke
{
	printf("%-6d %-8s %-16s %-8d %Y\n",
	    pid, "REVOKE", copyinstr(arg0), arg1, walltimestamp);
}

cap_rt:::close
{
	printf("%-6d %-8s %-16s %-8d %Y\n",
	    pid, "CLOSE", copyinstr(arg0), arg1, walltimestamp);
}
