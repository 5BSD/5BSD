 *
 * oracled-ipc -- trace oracle protocol messages on the pair channel.
 *
 * Shows each request received from serviced and the reply status.
 *
 * Usage: oracled-ipc
 */

#pragma D option quiet

inline string oracle_op[uint32_t op] =
	op == 1 ? "MINT_PATH" :
	op == 2 ? "MINT_NET" :
	op == 3 ? "MINT_SYSTEM" :
	op == 4 ? "CREATE_PAIR" :
	op == 5 ? "CREATE_COALITION" :
	op == 6 ? "READY" :
	op == 7 ? "PING" :
	"UNKNOWN";

dtrace:::BEGIN
{
	printf("Tracing oracle protocol IPC... Ctrl-C for summary.\n\n");
	printf("%-20s %-6s %-18s\n", "TIME", "PID", "OPERATION");
}

oracled*:::ipc-recv
{
	printf("%-20Y %-6d %-18s\n", walltimestamp, pid,
	    oracle_op[arg0]);
	@ops[oracle_op[arg0]] = count();
}

dtrace:::END
{
	printf("\n--- Message counts ---\n");
	printa("  %-18s %@d\n", @ops);
}
